def core_halt(child):
    """停掉 cca _core run 起的内核（它是自己进程组的头）：SIGTERM，3 秒还没退出就 SIGKILL"""
    import signal, subprocess
    for sig, wait in ((signal.SIGTERM, 3), (signal.SIGKILL, 3)):
        try:
            os.killpg(child.pid, sig)
        except OSError:
            pass
        try:
            child.wait(timeout=wait)
            return
        except subprocess.TimeoutExpired:
            pass


def cmd_core_keep():
    """cca _core-keep（Linux）：没有界面 App 时，照 App 的 CoreHost 托管内置代理的内核。运行 cca _core run（生成配置后 exec 内核）；
    退出了就隔一会儿重启：1、2、4…秒，最多 60 秒，跑够 60 秒才退出的从 1 秒重新算，等的时候配置文件变了（cca 碰了一下）马上重启。
    不再要了（core_wanted）就停掉内核、自己退出，被 SIGTERM 时也先停内核。同时只有一个（core/keep.lock）。内核的输出追加进
    core/core.log，每次启动前超过 1 MB 就清空。自己一个会话：终端的 Ctrl-C、退出登录都碰不到它"""
    import signal, subprocess
    try:
        os.setsid()
    except OSError:
        pass   # 已经是会话的头（bash 经 POSIX::setsid 起的）
    if not core_wanted():
        return
    core_dir()
    lock = open(os.path.join(CORE_DIR, 'keep.lock'), 'a')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return   # 已经有一个在托管：它会看到配置文件变了

    class Stop(Exception):
        pass

    def on_term(*_):
        raise Stop()
    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    env = {k: v for k, v in os.environ.items()
           if k not in ('CCA_EVENTS', 'CCA_GRANT', 'CCA_RO', 'CCA_PROMPT', 'CCA_TTY', 'CCA_YES', 'CCA_TOOL')}
    child, backoff = None, 1
    try:
        while core_wanted():
            try:
                if os.path.getsize(CORE_LOG) > 1048576:
                    os.remove(CORE_LOG)
            except OSError:
                pass
            fd = os.open(CORE_LOG, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
            started = time.monotonic()
            try:
                child = subprocess.Popen([SELF_PATH, '_core', 'run'], stdin=subprocess.DEVNULL, stdout=fd, stderr=fd,
                                         close_fds=True, start_new_session=True, env=env)
            finally:
                os.close(fd)
            while True:
                try:
                    child.wait(timeout=2)
                    break
                except subprocess.TimeoutExpired:
                    if not core_wanted():
                        core_halt(child)
                        return
            child = None
            if time.monotonic() - started >= 60:
                backoff = 1
            mark, until = core_config_mtime(), time.monotonic() + backoff
            while time.monotonic() < until and core_wanted() and core_config_mtime() == mark:
                time.sleep(0.5)
            backoff = min(backoff * 2, 60)
    except Stop:
        pass
    finally:
        if child is not None and child.poll() is None:
            core_halt(child)


def write_text(path, text):
    """原子替换文本文件，保留原来的权限（客户端随时可能来读）"""
    try:
        mode = os.stat(path).st_mode & 0o777
    except FileNotFoundError:
        mode = 0o644
    tmp = '%s.cca-%d.tmp' % (path, os.getpid())
    with open(tmp, 'w', encoding='utf-8') as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def cmd_local_script(path, action='install'):
