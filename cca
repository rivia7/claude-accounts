def core_pick(px, names):
    """节点定义 px 里，names 要的节点和它们（一层层）经 dialer-proxy 用到的节点。dialer-proxy 指向的不是节点（策略组、找不到、
    绕成圈）的不要：内置代理里没有那些组，带上它整份配置都加载不了。顺序照 px，同名的留第一个"""
    by = {}
    for p in px:
        if isinstance(p, dict) and isinstance(p.get('name'), str):
            by.setdefault(p['name'], p)
    keep = {}

    def need(n, path):
        if n in keep:
            return keep[n]
        p = by.get(n)
        if p is None or n in path:
            return False
        dp = p.get('dialer-proxy')
        keep[n] = dp is None or (isinstance(dp, str) and need(dp, path | {n}))
        return keep[n]

    for n in names:
        need(n, frozenset())
    return [p for n, p in by.items() if keep.get(n)]


