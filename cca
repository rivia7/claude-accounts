def browser_profile(key, prepare):
    """Chrome 关闭时写账号专属偏好；运行时只检查，避免和 Chrome 的原子保存竞争。"""
    root = profile_path(key, 'browser')
    names = {'Default'}
    for name in os.listdir(root):
        if os.path.isfile(os.path.join(root, name, 'Preferences')):
            names.add(name)
    for name in sorted(names):
        folder = os.path.join(root, name)
        path = os.path.join(folder, 'Preferences')
        if os.path.islink(folder) or not private_file(path):
            die('浏览器偏好不能通过链接共享：%s' % path)
        data = load_json(path, {})
        if not isinstance(data, dict) or not isinstance(data.get('webrtc', {}), dict):
            die('无法读取浏览器 WebRTC 偏好：%s' % path)
        webrtc = data.setdefault('webrtc', {})
        wanted = {'ip_handling_policy': 'disable_non_proxied_udp', 'ip_handling_url': [], 'local_ips_allowed_urls': []}
        if prepare:
            os.makedirs(folder, mode=0o700, exist_ok=True)
            webrtc.update(wanted)
            save_json(path, data, 0o600, follow_symlinks=False)
        elif any(webrtc.get(k) != v for k, v in wanted.items()):
            die('浏览器 WebRTC 偏好已变化或有 URL 例外，请退出该账号的 Chrome 后重开')


