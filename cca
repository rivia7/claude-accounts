def cmd_sync_state(quiet=''):
    """sync_if_changed 开头要的一次给（几乎每条命令都走这里，原来要起四次 python：validate、secrets-forget、digest、
    get synced）。账号表有错就返回 1，错误写 stderr；quiet 时校验这一步的 stderr 全不要（和 py validate 2>/dev/null 一样）。
    没错就清掉已经不在账号表里的 key（secrets-forget），再打印「账号表 + 路由器端代码（stdin）的摘要<TAB>上次同步的摘要」"""
    if quiet:
        sys.stderr.flush()
        saved, null = os.dup(2), os.open(os.devnull, os.O_WRONLY)
        os.dup2(null, 2)
    try:
        errs = ctx()[2]
        for e in errs:
            sys.stderr.write('! %s\n' % e)
    except Exception:
        if not quiet:
            raise
        errs = [None]   # quiet：出了意外也只返回 1（同样不说），交给不带 quiet 的那次说清楚
    finally:
        if quiet:
            sys.stderr.flush()
            os.dup2(saved, 2)
            os.close(saved)
            os.close(null)
    if errs:
        sys.exit(1)
    cmd_secrets_forget()
    c = ctx()[0]
    print('%s\t%s' % (sync_digest(c, sys.stdin.read()), c.get('synced') or ''))


