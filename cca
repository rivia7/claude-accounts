def subprocess_quiet(*a):
    import subprocess
    try:
        subprocess.run(a, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
    except (OSError, subprocess.SubprocessError):
        pass
LAUNCHER_SH = r"""#!/bin/bash
# cca 生成的 Claude App 启动器：用账号 %(label)s 专属的资料目录和出口打开 Claude App。
# 账号改名或删除时 cca 会自动更新或删掉它，不用手改。
export PATH="${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin"
CCA="$HOME/.local/bin/cca"
[ -x "$CCA" ] || CCA=%(cca)s
out=$(CCA_GUI=1 "$CCA" app %(key)s 2>&1 </dev/null) && exit 0
osascript - %(title)s "$(printf '%%s\n' "$out" | tail -n 8)" <<'OSA' >/dev/null 2>&1
on run argv
	display alert (item 1 of argv) message (item 2 of argv) as critical
end run
OSA
exit 1
"""


def launcher_names(t):
    """启动器的名字："Claude 别名"；没有别名用邮箱 @ 前面的部分，和别的账号重名时改用完整邮箱"""
    short = {}
    for k in t:
        a, e = parse_key(k)
        short[k] = a or e.split('@')[0] or k
    count = {}
    for n in short.values():
        count[n] = count.get(n, 0) + 1
    out = {}
    for k, n in short.items():
        if count[n] > 1 and not parse_key(k)[0]:
            n = parse_key(k)[1] or k
        out[k] = 'Claude ' + re.sub(r'[/:]', '-', n)
    return out


def put(path, data, mode=0o644):
    """内容没变就不写（不打扰 Spotlight / 启动台）；返回是否写了"""
    try:
        with open(path, 'rb') as f:
            if f.read() == data:
                return False
    except FileNotFoundError:
        pass
    with open(path, 'wb') as f:
        f.write(data)
    os.chmod(path, mode)
    return True


BADGE_VERSION = 2
BADGE_COLORS = ['#0A84FF', '#30A46C', '#8E4EC6', '#12A594', '#D6409F', '#3E63DD', '#E5484D', '#B2610B']
# 在 Claude 图标右下角画账号标识（AppKit，经 osascript 的 JavaScript 运行；输出 PNG）。
# 标识必须整个落在原图标的圆角方形里：轮廓一变，macOS 26 起会把整个图标缩小、关进灰色底框
BADGE_JS = r"""ObjC.import('AppKit');
function run(argv) {
  var src = argv[0], out = argv[1], label = argv[2], hex = argv[3], S = 1024;
  var base = $.NSImage.alloc.initWithContentsOfFile(src);
  if (base.isNil()) throw new Error('no base icon');
  var img = $.NSImage.alloc.initWithSize($.NSMakeSize(S, S)), all = $.NSMakeRect(0, 0, S, S), zero = $.NSMakeRect(0, 0, 0, 0);
  img.lockFocus;
  base.drawInRectFromRectOperationFraction(all, zero, 2, 1.0);
  // 苹果图标网格里圆角方形离画布边 0.0977·S，标识再往里缩 0.022·S（e 是标识外沿离画布边的距离）
  var e = S * (0.0977 + 0.022), w = S * 0.02, d = S * 0.40 - w, x = S - e - d - w / 2, y = e + w / 2;
  var c = parseInt(hex.slice(1), 16);
  var o = $.NSBezierPath.bezierPathWithOvalInRect($.NSMakeRect(x, y, d, d));
  $.NSColor.colorWithSRGBRedGreenBlueAlpha((c >> 16 & 255) / 255, (c >> 8 & 255) / 255, (c & 255) / 255, 1).setFill;
  o.fill;
  o.setLineWidth(w);
  $.NSColor.whiteColor.setStroke;
  o.stroke;
  var font = $.NSFont.boldSystemFontOfSize(d * (label.length > 1 ? 0.36 : 0.52));
  var attrs = $.NSMutableDictionary.dictionary;
  attrs.setObjectForKey(font, 'NSFont');
  attrs.setObjectForKey($.NSColor.whiteColor, 'NSColor');
  var s = $.NSString.alloc.initWithUTF8String(label);
  var ts = s.sizeWithAttributes(attrs);
  s.drawAtPointWithAttributes($.NSMakePoint(x + (d - ts.width) / 2, y + (d - ts.height) / 2), attrs);
  base.drawInRectFromRectOperationFraction(all, zero, 7, 1.0);   // DestinationIn：按原图标的透明度再裁一遍，轮廓分毫不差
  img.unlockFocus;
  var rep = $.NSBitmapImageRep.imageRepWithData(img.TIFFRepresentation);
  var png = rep.representationUsingTypeProperties(4, $.NSDictionary.dictionary);
  if (!png.writeToFileAtomically(out, true)) throw new Error('write failed');
}"""


def launcher_badges(t, names):
    """图标右下角的账号标识：中文名取头两个字，其它取首字母大写；颜色按账号固定，尽量不和别的账号重复"""
    out, used = {}, set()
    for k in t:
        n = names[k][len('Claude '):] or '?'
        wide = ''.join(ch for ch in n[:2] if char_w(ch) == 2)
        label = wide if char_w(n[0]) == 2 else n[0].upper()
        i = int(hashlib.sha1(acct_id(k).encode('utf-8')).hexdigest(), 16)
        free = [c for c in BADGE_COLORS if c not in used] or BADGE_COLORS
        color = free[i % len(free)]
        used.add(color)
        out[k] = (label, color)
    return out


def render_icon(src, label, color):
    """返回画好标识的 .icns 内容：osascript 画 1024 的 PNG，sips 缩成各个尺寸，iconutil 打包"""
    import subprocess, tempfile
    def run(*a):
        subprocess.run(a, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True, timeout=60)
    with tempfile.TemporaryDirectory() as d:
        js, png, iset = os.path.join(d, 'badge.js'), os.path.join(d, 'icon.png'), os.path.join(d, 'AppIcon.iconset')
        with open(js, 'w', encoding='utf-8') as f:
            f.write(BADGE_JS)
        run('osascript', '-l', 'JavaScript', js, src, png, label, color)
        os.mkdir(iset)
        for n in (16, 32, 128, 256, 512):
            run('sips', '-z', str(n), str(n), png, '--out', os.path.join(iset, 'icon_%dx%d.png' % (n, n)))
            run('sips', '-z', str(2 * n), str(2 * n), png, '--out', os.path.join(iset, 'icon_%dx%d@2x.png' % (n, n)))
        run('iconutil', '-c', 'icns', iset, '-o', os.path.join(d, 'AppIcon.icns'))
        with open(os.path.join(d, 'AppIcon.icns'), 'rb') as f:
            return f.read()


def write_launcher(b, key, cca, app, name, badge):
    import plistlib
    res = os.path.join(b, 'Contents', 'Resources')
    os.makedirs(os.path.join(b, 'Contents', 'MacOS'), exist_ok=True)
    os.makedirs(res, exist_ok=True)
    info = {'CFBundleName': name, 'CFBundleDisplayName': name, 'CFBundleIdentifier': 'local.cca.launcher.' + acct_id(key),
            'CFBundleExecutable': 'cca-launcher', 'CFBundleIconFile': 'AppIcon', 'CFBundlePackageType': 'APPL',
            'CFBundleShortVersionString': '1.0', 'CFBundleVersion': '1', 'LSUIElement': True,
            'NSHighResolutionCapable': True}
    put(os.path.join(b, 'Contents', 'Info.plist'), plistlib.dumps(info))
    sh_ = LAUNCHER_SH % {'label': label_of(key), 'cca': shlex.quote(cca), 'key': shlex.quote(key),
                         'title': shlex.quote('%s 没有打开' % name)}
    put(os.path.join(b, 'Contents', 'MacOS', 'cca-launcher'), sh_.encode('utf-8'), 0o755)
    mark_path, icns = os.path.join(res, LAUNCHER_MARK), os.path.join(res, 'AppIcon.icns')
    mark = {'id': acct_id(key), 'key': key, 'badge': list(badge)}
    try:   # 图标：本机 Claude App 的图标，右下角加账号标识；原图标或标识变了才重画
        with open(os.path.join(app, 'Contents', 'Info.plist'), 'rb') as f:
            icon = plistlib.load(f).get('CFBundleIconFile') or ''
        icon = os.path.join(app, 'Contents', 'Resources', icon if icon.endswith('.icns') else icon + '.icns')
        with open(icon, 'rb') as f:
            src = f.read()
        mark['icon'] = hashlib.sha1(src + ('|%s|%s|%d' % (badge[0], badge[1], BADGE_VERSION)).encode('utf-8')).hexdigest()
        try:
            with open(mark_path, encoding='utf-8') as f:
                old = json.load(f)
        except (OSError, ValueError):
            old = {}
        if old.get('icon') != mark['icon'] or not os.path.exists(icns):
            try:
                data = render_icon(icon, *badge)
            except Exception:   # 画不出来就用原图标，启动器照常能用
                data = src
            if put(icns, data):
                os.utime(b)   # 让 Finder、启动台换掉缓存里的旧图标
                subprocess_quiet(LSREGISTER, '-f', b)
    except (OSError, ValueError):
        pass
    put(mark_path, json.dumps(mark, ensure_ascii=False).encode('utf-8'))


def cmd_launchers(ldir, cca, app='', mode=''):
    """~/Applications 里每个账号一个"Claude 别名"启动器：按账号表新建、改名、删除。
    只动带 cca 标记的 .app；没装 Claude App（app 为空）或 mode=remove-all 时只删不建。
    输出：+ 新建、- 删除、! 同名但不是 cca 生成的（跳过）。第三方 API 账号用不了 Claude App，没有启动器"""
    t = {k: v for k, v in table_load().items() if not is_api(v)}
    names = launcher_names(t)
    badges = launcher_badges(t, names)
    want = {} if mode == 'remove-all' or not app else {os.path.join(ldir, names[k] + '.app'): k for k in t}
    if os.path.isdir(ldir):
        for n in sorted(os.listdir(ldir)):
            p = os.path.join(ldir, n)
            if n.endswith('.app') and p not in want and os.path.isfile(os.path.join(p, 'Contents', 'Resources', LAUNCHER_MARK)):
                shutil.rmtree(p)
                print('-\t' + n[:-4])
    for p, k in want.items():
        new = not os.path.exists(p)
        if not new and not os.path.isfile(os.path.join(p, 'Contents', 'Resources', LAUNCHER_MARK)):
            print('!\t' + os.path.basename(p)[:-4])
            continue
        os.makedirs(ldir, exist_ok=True)
        write_launcher(p, k, cca, app, names[k], badges[k])
        if new:
            print('+\t' + os.path.basename(p)[:-4])


