class using:
    """with using(工具)：暂时换成另一个工具（账号目录、登录状态、套餐都按 T 读）；按键缓存的 .claude.json 跟着清掉
    （同一个邮箱可以既是 Claude 账号又是 Codex 账号）"""
    def __init__(self, tool):
        self.tool = tool

    def __enter__(self):
        global T
        self.old, T = T, self.tool
        ACCT_JSON.clear()

    def __exit__(self, *exc):
        global T
        T = self.old
        ACCT_JSON.clear()


