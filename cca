def sh(**kv):
    for k, v in kv.items():
        print('%s=%s' % (k, shlex.quote(str(v))))


def sh_arrays(**kv):
    """bash 数组：NAME=(项 …)，eval 之后 "${NAME[@]}" 原样还原每一项"""
    for k, v in kv.items():
        print('%s=(%s)' % (k, ' '.join(shlex.quote(str(x)) for x in v)))


