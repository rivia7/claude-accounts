# --- 节点改名跟随：节点按「类型 + 服务器 + 端口 + TLS 域名」认，名字只是叫法 -----------------
# 路由器（OpenClash / ShellCrash）上给节点改了名，旧名字一找不到，账号的端口就只能 REJECT（宁可断开也不换出口）。
# cca 记下每个可选节点的摘要（config.json 的 node_ids，只存摘要，不存服务器地址），名字对不上时按摘要认出新名字，
# 可选节点和各工具的账号表跟着改；本机 Clash Verge 里叫法不同时按摘要换算（不改账号表，见 local_names）。
# TLS 域名（servername / sni）也算进去：走 CDN 的节点常常共用同一个服务器地址和端口，靠它分出是哪一个
def node_fp(kind='', server='', port='', sni=''):
    server = str(server or '').strip().lower().rstrip('.')
    if not server:
        return ''
    s = '%s|%s|%s|%s' % (str(kind or '').strip().lower(), server, str(port or '').strip(),
                         str(sni or '').strip().lower().rstrip('.'))
    return hashlib.sha256(s.encode('utf-8')).hexdigest()[:16]


def node_ids(c):
    return c.get('node_ids') if isinstance(c.get('node_ids'), dict) else {}


def parse_node_list(text):
    """路由器上 cca-router.sh nodes 的输出 → [(名字, 摘要)]；只给名字的（读不到地址）摘要是空的"""
    out = []
    for line in text.split('\n'):
        f = line.split('\t')
        if f[0] == 'P' and len(f) > 1 and f[1]:
            out.append((f[1], node_fp(*f[2:6])))
    return out


def node_match(n, f, have):
    """可选节点 n（记下的摘要 f）在节点列表 have=[(名字, 摘要)] 里现在叫什么：地址对上一个节点就是它（名字改没改都算，
    两个节点互换名字也认得出），对上好几个时同名的优先；地址对不上（换了服务器，或者以前没记摘要）再按名字。找不到返回空"""
    cand = [m for m, g in have if f and g == f]
    if n in cand:
        return n
    if len(cand) == 1:
        return cand[0]
    return n if any(m == n for m, _ in have) else ''


def nodes_rename(c, ren, alias=True):
    """把改名 {旧名: 新名} 用到可选节点和各工具的账号表上（第三方 API 账号的 node 也改）。alias：按地址认出的改名，
    记下来（维护者的映射里还写着旧名字时靠它换算，见 node_alias）；用户自己选的代替节点不记，映射照样要求旧节点。
    返回 {旧名: [受影响的账号]}"""
    hit = {o: [] for o in ren}
    for tool in TOOLS:
        t = load_quiet(tool.table) if os.path.exists(tool.table) else None
        if not isinstance(t, dict):
            continue
        changed = False
        for k, v in t.items():
            n = node_of(v)
            if n not in ren:
                continue
            if is_api(v):
                v['node'] = ren[n]
            else:
                t[k] = ren[n]
            hit[n].append(shown(tool, k))
            changed = True
        if changed:
            save_json(tool.table, t, 0o600)
    c['nodes'] = list(dict.fromkeys(ren.get(n, n) for n in c['nodes']))
    if alias:
        r = dict(c.get('node_renames') if isinstance(c.get('node_renames'), dict) else {})
        for o, n in ren.items():
            r.pop(n, None)   # 新名字以前是别的节点的旧名字：那条换算作废
            r[o] = n
        c['node_renames'] = dict(list(r.items())[-50:])
    return hit


def nodes_record(c, have):
    """记下各可选节点现在的摘要；暂时找不到的保留以前记的（它回来了、或者改了名都还认得出）"""
    fp = {n: f for n, f in have if f}
    old = node_ids(c)
    ids = {n: fp.get(n) or old.get(n) for n in c['nodes'] if fp.get(n) or old.get(n)}
    if ids:
        c['node_ids'] = ids
    else:
        c.pop('node_ids', None)


