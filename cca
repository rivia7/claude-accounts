# --- .claude.json 三方合并 --------------------------------------------------
def eq(a, b):
    if a is MISSING or b is MISSING:
        return a is b
    return a == b


def merge3(base, ours, theirs):
    """ours=账号副本，theirs=~/.claude.json。只有一边改过取改过的一边；两边都改过的字典逐键合并，
    其余冲突以 ~/.claude.json 为准。"""
    if eq(ours, theirs):
        return ours
    if eq(ours, base):
        return theirs
    if eq(theirs, base):
        return ours
    if isinstance(ours, dict) and isinstance(theirs, dict):
        b = base if isinstance(base, dict) else {}
        out = {}
        for k in list(theirs) + [k for k in ours if k not in theirs]:
            v = merge3(b.get(k, MISSING), ours.get(k, MISSING), theirs.get(k, MISSING))
            if v is not MISSING:
                out[k] = v
        return out
    return theirs


def cmd_sync(key):
    cd = cdir(key)
    aj, bj = os.path.join(cd, '.claude.json'), os.path.join(cd, '.cca-sync-base.json')
    with Lock():
        m = load_json(MASTER_JSON, {}) or {}
        a = load_json(aj, {}) or {}
        b = load_json(bj, {}) or {}
        base, ch_a, ch_m = {}, False, False
        for k in SHARED_KEYS:
            v = merge3(b.get(k, MISSING), a.get(k, MISSING), m.get(k, MISSING))
            if v is MISSING:
                ch_a |= a.pop(k, MISSING) is not MISSING
                ch_m |= m.pop(k, MISSING) is not MISSING
                continue
            base[k] = v
            if not eq(a.get(k, MISSING), v):
                a[k], ch_a = v, True
            if not eq(m.get(k, MISSING), v):
                m[k], ch_m = v, True
        if ch_a or not os.path.exists(aj):
            save_json(aj, a, 0o600)
        if ch_m:
            save_json(MASTER_JSON, m)
        save_json(bj, base, 0o600)


# --- 共享目录链接 -----------------------------------------------------------
def aside(src, key):
    d = os.path.join(CCA_HOME, 'conflicts', acct_id(key))
    os.makedirs(d, exist_ok=True)
    dst = os.path.join(d, '%s.%d' % (os.path.basename(src), int(time.time())))
    shutil.move(src, dst)
    sys.stderr.write('cca: %s 与 ~/.claude 中的同名条目类型不同，已移到 %s\n' % (os.path.basename(src), dst))


def copy_over(src, dst):
    real = os.path.realpath(dst)
    tmp = '%s.cca-%d.tmp' % (real, os.getpid())
    shutil.copy2(src, tmp)
    os.replace(tmp, real)


def merge_lines(src, dst):
    with open(dst, 'rb') as f:
        have = f.read()
    seen = set(have.splitlines())
    with open(src, 'rb') as f:
        extra = [l for l in f.read().splitlines() if l not in seen]
    if extra:
        with open(os.path.realpath(dst), 'ab') as f:
            f.write((b'\n' if have and not have.endswith(b'\n') else b'') + b'\n'.join(extra) + b'\n')


def merge_file(src, dst):
    if src.endswith('.jsonl'):
        merge_lines(src, dst)
    elif not filecmp.cmp(src, dst, shallow=False) and os.path.getmtime(src) > os.path.getmtime(dst):
        copy_over(src, dst)


def merge_tree(src, dst):
    for root, dirs, files in os.walk(src):
        rel = os.path.relpath(root, src)
        troot = dst if rel == '.' else os.path.join(dst, rel)
        os.makedirs(troot, exist_ok=True)
        for n in [d for d in dirs if os.path.islink(os.path.join(root, d))] + files:
            sp, tp = os.path.join(root, n), os.path.join(troot, n)
            if os.path.islink(sp):
                if not os.path.lexists(tp):
                    os.symlink(os.readlink(sp), tp)
            elif not os.path.lexists(tp):
                shutil.copy2(sp, tp)
            elif os.path.isfile(tp):
                merge_file(sp, tp)
        dirs[:] = [d for d in dirs if not os.path.islink(os.path.join(root, d))]


def adopt(src, dst, key):
    """会话里新建的、或被原子写替换掉链接的真实条目：并回 ~/.claude 后改回链接。"""
    if not os.path.lexists(dst):
        shutil.move(src, dst)
    elif os.path.isdir(src):
        if not os.path.isdir(dst):
            return aside(src, key)
        merge_tree(src, dst)
        shutil.rmtree(src)
    elif os.path.isdir(dst):
        return aside(src, key)
    else:
        merge_file(src, dst)
        os.unlink(src)


def cmd_link(key):
    cd = cdir(key)
    os.makedirs(cd, exist_ok=True)
    for d in PRECREATE:
        os.makedirs(os.path.join(MASTER, d), exist_ok=True)
    with Lock():
        for n in sorted(os.listdir(cd)):
            if is_per_account(n):
                continue
            p, t = os.path.join(cd, n), os.path.join(MASTER, n)
            if os.path.islink(p):
                if os.readlink(p) != t:
                    os.unlink(p)
                continue
            adopt(p, t, key)
        for n in sorted(os.listdir(MASTER)):
            p = os.path.join(cd, n)
            if not is_per_account(n) and not os.path.lexists(p):
                os.symlink(os.path.join(MASTER, n), p)


