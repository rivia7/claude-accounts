def runtime_snapshot(key, kind, pid, profile, app, proxy, route, bypass, no_proxy):
    """记录可核对的启动条件；不读取进程环境、Cookie 或凭证，不声称验证客户端所有请求。"""
    c, table, _ = ctx()
    need(table, key)
    pid = int(pid)
    started = proc_starts([pid]).get(pid)
    if not started or not proxy:
        die('无法核验客户端进程或账号代理')
    expected = profile_path(key, kind)
    if os.path.realpath(profile) != expected:
        die('客户端资料目录与账号不符')
    commands = ps_rows(['-ww', '-o', 'pid=,command=', '-p', str(pid)], 5)
    command = next((s for p, s in commands if p == pid), '')
    flags = {'user-data-dir': profile, 'proxy-server': proxy}
    if kind == 'app':
        flags['proxy-bypass-list'] = bypass
    else:
        flags['webrtc-ip-handling-policy'] = 'disable_non_proxied_udp'
        browser_profile(key, False)
    for flag, value in flags.items():
        if (len(re.findall(r'(?:^|\s)--' + flag + r'(?:=|\s)', command)) != 1 or
                not re.search(r'(?:^|\s)--' + flag + '=' + re.escape(value) + r'(?:\s|$)', command)):
            die('客户端启动参数无法核验：--%s；请退出该实例后重新打开' % flag)
    app = os.path.realpath(app)
    try:
        import plistlib
        plist = os.path.join(app, 'Contents', 'Info.plist')
        with open(plist, 'rb') as f:
            executable = plistlib.load(f).get('CFBundleExecutable')
        if not isinstance(executable, str) or os.path.basename(executable) != executable or executable in ('', '.', '..'):
            raise ValueError('invalid executable')
        binary = os.path.join(app, 'Contents', 'MacOS', executable)
        if not command.startswith(binary + ' '):
            die('客户端进程不属于当前选择的程序，请退出旧实例后重开')
        st, binary_st = os.stat(plist), os.stat(binary)
    except (OSError, ValueError, TypeError, AttributeError):
        die('无法核验客户端程序版本')
    return {'v': 1, 'tool': T.name, 'id': acct_id(key), 'kind': kind, 'pid': pid, 'started': started,
            'profile': expected, 'config': os.path.realpath(cdir(key)), 'app': app,
            'app_version': [st.st_size, st.st_mtime_ns, binary_st.st_size, binary_st.st_mtime_ns], 'proxy': proxy, 'route': route,
            'node': node_of(table[key]), 'bypass': bypass, 'no_proxy': no_proxy,
            'launch_policy': 1}


