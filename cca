	p=$(uci -q get openclash.config.config_path 2>/dev/null)
	if [ -n "$p" ]; then echo "$R/etc/openclash/${p##*/}"; return; fi
	ls -t "$R"/etc/openclash/*.yaml "$R"/etc/openclash/*.yml 2>/dev/null | head -n 1
}
source_config() {   # 运行配置由它生成：OpenClash 自己的配置；ShellCrash 订阅下来的 yamls/config.yaml（启动时拿它拼出运行配置）
	if [ "$BK" = sc ]; then p="$SC/yamls/config.yaml"
	else p=$(uci -q get openclash.config.config_path 2>/dev/null); [ -n "$p" ] && p="$R$p"; fi
	[ -n "$p" ] && [ -f "$p" ] && echo "$p"
}
in_source() {   # in_source "节点<TAB>节点…"：这些节点生成运行配置的那份配置里都有（参考节点也写在这里，重启后都用得上）
	src=$(source_config) || return 1
	printf '%s' "$1" | ruby -E UTF-8 -ryaml -e "$YL"'
		have = ((yl(ARGV[0]) || {})["proxies"] || []).map { |p| p["name"].to_s if p.is_a?(Hash) }
		exit($stdin.read.split("\t").reject(&:empty?).all? { |n| have.include?(n) } ? 0 : 1)' "$src" 2>/dev/null
}
in_group() {   # in_group 配置 策略组 节点：这份配置里这个策略组的成员有这个节点
	[ -n "$1" ] && [ -f "$1" ] || return 1
	ruby -E UTF-8 -ryaml -e "$YL"'
		g = ((yl(ARGV[0]) || {})["proxy-groups"] || []).find { |x| x.is_a?(Hash) && x["name"].to_s == ARGV[1].dup.force_encoding("UTF-8") }
		exit(g && g["proxies"].is_a?(Array) && g["proxies"].map(&:to_s).include?(ARGV[2].dup.force_encoding("UTF-8")) ? 0 : 1)' "$1" "$2" "$3" </dev/null 2>/dev/null
}
core_bin() {   # 优先用实际在跑的那份内核
	if [ "$BK" = sc ]; then   # ShellCrash 保守模式启动后会删掉 /tmp 里的内核文件，在跑的进程经 /proc 还找得到
		for c in "$SCT/CrashCore" "/proc/$(pidof CrashCore | awk '{print $1}')/exe"; do [ -x "$c" ] && { echo "$c"; return 0; }; done
		return 1
	fi
	for c in "$R/etc/openclash/clash" "$R/etc/openclash/core/clash_meta" "$R/tmp/etc/openclash/core/clash_meta"; do
		[ -x "$c" ] && { echo "$c"; return 0; }
	done
	return 1
}
running() { if [ "$BK" = sc ]; then pidof CrashCore >/dev/null 2>&1; else pidof clash >/dev/null 2>&1; fi; }
safe_paths() {   # 和 OpenClash 启动内核时的 SAFE_PATHS 保持一致，否则 -t 会拒绝 external-ui 等路径
	sp=$({ tr '\0' '\n' < "/proc/$(pidof clash | awk '{print $1}')/environ"; } 2>/dev/null | sed -n 's/^SAFE_PATHS=//p')
	echo "${sp:-/usr/share/openclash:/etc/ssl}"
}
core_test() {   # core_test 配置：内核自己的 -t 校验（主目录和启动时一样；找不到内核时跳过），输出在 $out
	out=""
	c=$(core_bin) || return 0
	if [ "$BK" = sc ]; then out=$("$c" -t -d "$SCB" -f "$1" 2>&1)
	else out=$(SAFE_PATHS="$(safe_paths)" "$c" -t -d "$R/etc/openclash" -f "$1" 2>&1); fi
}

# 维护者参考配置里的节点：直接写进生成运行配置的那份配置文件（OpenClash 选用的配置、ShellCrash 的订阅配置），
# OpenClash / ShellCrash 下次启动（重启）时就和用户自己的节点一样用上。每一版先在这台路由器的内核上校验（别处的节点这里的
# 内核不一定认，认不出的话 OpenClash / ShellCrash 整个起不来），通过了才写，记下 id 以后不再校验
fill_has() { grep -qs '"fill": {' "$ACC"; }   # 账号表（JSON）里有参考节点
fill_id() { ruby -E UTF-8 -ryaml -e "$YL"'; f = (yl(ARGV[0]) || {})["fill"]; print f["id"] if f.is_a?(Hash)' "$ACC" 2>/dev/null; }
fill_waiting() { [ -f "$FILLPEND" ] && running; }   # 配置文件里新写了参考节点，在跑的还没用上
sum_in() {   # stdin 的摘要（只用来认有没有变）：OpenWrt 默认的 busybox 不带 cksum（真实路由器上遇到过），md5sum、sha256sum 一般都有
	if command -v md5sum >/dev/null 2>&1; then md5sum
	elif command -v sha256sum >/dev/null 2>&1; then sha256sum
	elif command -v cksum >/dev/null 2>&1; then cksum
	else ruby -e 'h = 14695981039346656037; $stdin.each_byte { |b| h = ((h ^ b) * 1099511628211) & 0xffffffffffffffff }; print h'
	fi
}
fill_sig() {   # fill_sig 配置文件：账号表 + 配置文件 + 内核（大小和修改时间：升级了内核，没通过校验的再试一次）的摘要
	{ cat "$ACC" "$1"; fsg_c=$(core_bin) && ls -lnL "$fsg_c" 2>/dev/null | awk '{ print $5, $6, $7, $8 }'; } | sum_in
}
fmsg() { log "$*"; [ -n "${FQUIET:-}" ] || echo "$*"; }   # 钩子里只记日志（ShellCrash 的钩子靠 stdout 拿配置的路径）
fill_fail() { echo "$*" > "$FILLWHY"; fmsg "$*"; }
fill_source() {   # fill_source [配置文件]：参考节点缺的写进配置文件、cca 写过的跟着参考配置更新，写了时 FILLWROTE=1。
	               # 说明写到 stdout（Mac 上能看到）。配置文件、参考节点、内核都没变时不再读一遍（${FILLSEEN}；同步时 FILLFORCE 照读）
	FILLWROTE=""
	if ! fill_has; then rm -f "$FILLPEND" "$FILLSEEN" "$FILLWHY"; return 0; fi
	fs_src="${1:-$(source_config)}"
	[ -n "$fs_src" ] && [ -f "$fs_src" ] || return 0
	fs_sig=$(fill_sig "$fs_src")
	[ -z "${FILLFORCE:-}" ] && [ -n "$fs_sig" ] && [ "$fs_sig" = "$(cat "$FILLSEEN" 2>/dev/null)" ] && return 0   # 算不出摘要时不当成没变
	fs_o="$R/tmp/cca.src.$$.yaml"; fs_v="$R/tmp/cca.fill.$$.yaml"
	fs_tb=$(runtime_config); [ -n "$fs_tb" ] && [ -f "$fs_tb" ] || fs_tb="$fs_src"   # 拿正在用的运行配置加上这些节点给内核校验（它本来就校验得过）
	set -- --fill-source "$fs_o" --test "$fs_tb" --test-out "$fs_v"
	[ "$BK" = sc ] && set -- "$@" --custom "$SC/yamls/proxies.yaml"   # 不占用 ShellCrash 自定义节点的名字
	fs_what=$(ruby -E UTF-8 "$D/apply.rb" "$@" "$fs_src" "$ACC" 2>"$fs_o.err"); fs_rc=$?
	fs_why=$(sed -n 's/^cca: 参考节点没能写进配置文件（\(.*\)）$/\1/p; s/^cca: 读取配置失败：//p' "$fs_o.err" | tail -n 1)
	[ -n "${FQUIET:-}" ] || sed -n 's/^cca: \(参考节点「.*没有写\)$/\1/p' "$fs_o.err"   # 哪些没写、为什么
	cat "$fs_o.err" >> "$LOG"; rm -f "$fs_o.err"
	if [ $fs_rc -eq 2 ]; then rm -f "$fs_o" "$fs_v" "$FILLWHY"; echo "$fs_sig" > "$FILLSEEN"; return 0; fi
	if [ $fs_rc -eq 3 ]; then   # 只是把 cca 以前写成一行的节点改成块写法：内容没变，不用校验，也不用重启
		rm -f "$fs_v" "$FILLWHY"
		cp -f "$fs_src" "$SRCBAK"
		if rewrite "$fs_src" "$fs_o" 2>/dev/null; then fill_sig "$fs_src" > "$FILLSEEN"; log "参考节点：${fs_what}"; else rm -f "$fs_o"; fi
		return 0
	fi
	if [ $fs_rc -ne 0 ]; then   # 配置文件改了（或参考节点换了）再试
		rm -f "$fs_o" "$fs_v"; echo "$fs_sig" > "$FILLSEEN"
		fill_fail "维护者参考配置里的节点没能写进 ${NAME} 的配置文件 ${fs_src}${fs_why:+（${fs_why}）}"
		return 1
	fi
	fs_id=$(fill_id)
	if [ "$(cat "$FILLOK" 2>/dev/null)" != "$fs_id" ]; then
		if ! core_bin >/dev/null; then   # 内核找到了再试
			rm -f "$fs_o" "$fs_v"
			fill_fail "找不到 ${NAME} 的内核，没法先校验维护者参考配置里的节点，没有写进配置文件"
			return 1
		fi
		if ! core_test "$fs_v"; then   # 内核升级了（或参考节点换了）再试
			rm -f "$fs_o" "$fs_v"; echo "$fs_sig" > "$FILLSEEN"
			fill_fail "维护者参考配置里的节点没通过 ${NAME} 内核的校验，没有写进配置文件：$(printf '%s\n' "$out" | tail -n 1)"
			return 1
		fi
		echo "$fs_id" > "$FILLOK"
	fi
	rm -f "$fs_v" "$FILLWHY"
	cp -f "$fs_src" "$SRCBAK"
	if ! rewrite "$fs_src" "$fs_o" 2>/dev/null; then   # 原地覆盖：属主、权限不变。写不了的同步时再试
		rm -f "$fs_o"; echo "$fs_sig" > "$FILLSEEN"
		fill_fail "写不了 ${NAME} 的配置文件 ${fs_src}，维护者参考配置里的节点没有写进去"
		return 1
	fi
	fill_sig "$fs_src" > "$FILLSEEN"
	FILLWROTE=1
	fmsg "已把维护者参考配置里的节点写进 ${NAME} 的配置文件 ${fs_src}：${fs_what}（行尾带 # cca；改之前的在 ${SRCBAK}）"
}
listening() { netstat -lnt 2>/dev/null | awk '{print $4}' | grep -q "[:.]$1\$"; }
missing_ports() {
	m=""
	if [ -s "$PORTS" ]; then
		while read -r p; do
			[ -n "$p" ] && ! listening "$p" && m="$m $p"
		done < "$PORTS"
	fi
	echo "$m"
}

# --- mihomo 控制接口 ---------------------------------------------------------
ctl_init() {   # 控制接口的端口和密钥：从运行配置读；运行配置不见了时用 OpenClash / ShellCrash 的设置（生成运行配置时就是写的这两项）
	[ -n "$CPORT" ] && return 0
	cf=$(runtime_config)
	if out=$(ruby -ryaml -e "$YL"'; c = yl(ARGV[0]) || {}; puts c["external-controller"].to_s.split(":").last; puts c["secret"].to_s' "$cf" 2>/dev/null); then
		CPORT=$(printf '%s\n' "$out" | sed -n 1p)
		CSEC=$(printf '%s\n' "$out" | sed -n 2p)
	elif [ "$BK" = sc ]; then
		CPORT=$(sc_cfg db_port 9999)
		CSEC=$(sc_cfg secret)
	else
		CPORT=$(uci -q get openclash.config.cn_port 2>/dev/null)
		CSEC=$(uci -q get openclash.config.dashboard_password 2>/dev/null)
	fi
	CPORT="${CPORT:-9090}"
}
ctl() {   # ctl 方法 路径 [JSON]：响应体在 ${CTLOUT}，状态码在 $CODE
	ctl_init
	if [ -n "$3" ]; then
		CODE=$(curl -q --noproxy '*' -s -m "${CTL_TIMEOUT:-10}" -o "$CTLOUT" -w '%{http_code}' -X "$1" -H "Authorization: Bearer $CSEC" \
			-H 'Content-Type: application/json' --data "$3" "http://127.0.0.1:$CPORT$2")
	else
		CODE=$(curl -q --noproxy '*' -s -m "${CTL_TIMEOUT:-10}" -o "$CTLOUT" -w '%{http_code}' -X "$1" -H "Authorization: Bearer $CSEC" \
			"http://127.0.0.1:$CPORT$2")
	fi
}
json_str() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
now_of() { sed -n 's/.*"now":"\([^"]*\)".*/\1/p' "$CTLOUT" 2>/dev/null; }

# 按 ${SEL}（"CCA-n<TAB>节点"）把每个槽位切到账号的节点；节点不可用时切到 REJECT（宁可断开也不换出口）。
# select_all [运行配置]：给了运行配置时，内核不让切（400：它的这个组里没有这个节点）、而这份配置里的组有这个节点的，
# 是内核落后于配置文件（文件重新生成过，内核还没重新加载；真实路由器上遇到过），和组不在内核里一样，重载一次就好。
# 返回 0 全部就绪；2 有策略组不在运行中的内核里、或内核的组里缺了配置文件里有的节点（需要重载）；1 其它失败（切不过去的节点记在 FAILED，TAB 分隔）
select_all() {
	FAILED=""
	[ -s "$SEL" ] || return 0
	rc=0
	while IFS="$TAB" read -r g node; do
		[ -n "$g" ] || continue
		ctl GET "/proxies/$g"
		if [ "$CODE" != 200 ]; then
			if [ "$CODE" = 404 ]; then rc=2; elif [ $rc -eq 0 ]; then rc=1; fi
			echo "无法核实 ${g} 当前节点（HTTP ${CODE}）"
			continue
		fi
		[ "$(now_of)" = "$node" ] && continue
		ctl PUT "/proxies/$g" "{\"name\":\"$(json_str "$node")\"}"
		sa_put=$CODE
		case "$CODE" in 2??) ctl GET "/proxies/$g" ;; esac
		if [ "$CODE" = 200 ] && [ "$(now_of)" = "$node" ]; then
			echo "${g} → ${node}"
		elif [ "$sa_put" = 400 ] && in_group "${1:-}" "$g" "$node"; then
			echo "${g} 切换到 ${node} 失败：运行配置文件里的 ${g} 有这个节点，在跑的内核里还没有（内核还没重新加载这份配置），先改为 REJECT"
			FAILED="${FAILED}${node}${TAB}"
			ctl PUT "/proxies/$g" '{"name":"REJECT"}'
			rc=2
		else
			echo "${g} 切换到 ${node} 失败（HTTP ${CODE}，未能核实目标节点），改为 REJECT"
			FAILED="${FAILED}${node}${TAB}"
			ctl PUT "/proxies/$g" '{"name":"REJECT"}'
			[ $rc -eq 0 ] && rc=1
		fi
	done < "$SEL"
	rm -f "$CTLOUT"
	return $rc
}

install_hook() {   # 装了哪套就给哪套装钩子（两套都装了就都装上）
	[ -n "$SC" ] && sc_install_hook
	[ -d "$R/etc/openclash" ] || return 0
	if [ ! -f "$OW" ]; then
		mkdir -p "${OW%/*}"
		printf '#!/bin/sh\nCONFIG_FILE="$1"\n\nexit 0\n' > "$OW"
	fi
	grep -qxF "$MB" "$OW" && return 0
	b="$D/hook.block"
	{
		echo "$MB"
		echo "# 由 Mac 上的 cca 管理（Claude 多账号端口分流）；移除请运行 cca router uninstall 或 cca restore"
		echo "[ -x $D/cca-router.sh ] && $D/cca-router.sh hook \"\${CONFIG_FILE:-\$1}\""
		echo "$ME"
	} > "$b"
	n=$(grep -n -E '^[[:space:]]*exit[[:space:]]+0[[:space:]]*$' "$OW" | tail -n 1 | cut -d: -f1)
	t="$OW.cca.$$"
	if [ -n "$n" ]; then
		{ head -n $((n - 1)) "$OW"; cat "$b"; tail -n +"$n" "$OW"; } > "$t"
	else
		{ cat "$OW"; [ -n "$(tail -c 1 "$OW")" ] && echo; cat "$b"; } > "$t"
	fi
	rewrite "$OW" "$t"
	chmod 755 "$OW"
	log "已在 ${OW} 安装钩子"
}
remove_hook() {   # 用 head/tail 拼回，其余字节原样保留（包括文件末尾有没有换行）
	[ -n "$SC" ] && sc_remove_hook
	[ -f "$OW" ] || return 0
	s=$(grep -n -x -F "$MB" "$OW" | head -n 1 | cut -d: -f1)
	e=$(grep -n -x -F "$ME" "$OW" | head -n 1 | cut -d: -f1)
	[ -n "$s" ] && [ -n "$e" ] && [ "$e" -ge "$s" ] || return 0
	{ head -n $((s - 1)) "$OW"; tail -n +$((e + 1)) "$OW"; } > "$OW.cca.$$"
	rewrite "$OW" "$OW.cca.$$"
	log "已移除钩子"
}
# ShellCrash 启动时（starts/bfstart.sh）先 source 启动前的任务文件，再拿 $core_config 拼运行配置：这一行把它换成插好端口池的副本
sc_install_hook() {
	f=$(sc_task)
	# 另一处（换过版本留下的）有 cca 这一行就删掉：升级时 ShellCrash 会拿旧位置的文件 mv -f 盖掉新位置的，用户的任务就没了
	for x in "$SC/task/bfstart" "$SC/configs/task/bfstart"; do [ "$x" = "$f" ] || sc_unhook "$x"; done
	grep -qF "$SCHOOK" "$f" 2>/dev/null && return 0
	mkdir -p "${f%/*}"
	[ -s "$f" ] && [ -n "$(tail -c 1 "$f")" ] && echo >> "$f"
	echo "cca_cfg=\$($D/$SCHOOK \"\$core_config\" 2>/dev/null) && [ -s \"\$cca_cfg\" ] && core_config=\"\$cca_cfg\"" >> "$f"
	log "已在 ${f} 安装钩子"
}
sc_remove_hook() { sc_unhook "$SC/task/bfstart"; sc_unhook "$SC/configs/task/bfstart"; }
sc_unhook() {   # sc_unhook 任务文件：只删 cca 那一行；文件里只剩它（是 cca 建的）就整个删掉
	grep -qF "$SCHOOK" "$1" 2>/dev/null || return 0
	grep -vF "$SCHOOK" "$1" > "$1.cca.$$"
	if [ -s "$1.cca.$$" ]; then rewrite "$1" "$1.cca.$$"; else rm -f "$1" "$1.cca.$$"; fi
	log "已从 ${1} 移除钩子"
}
install_cron() {
	mkdir -p "${CRON%/*}"
	touch "$CRON"
	grep -qF "$D/cca-router.sh ensure" "$CRON" && return 0
	echo "*/2 * * * * $D/cca-router.sh ensure >/dev/null 2>&1" >> "$CRON"
	"$R/etc/init.d/cron" restart >/dev/null 2>&1
	log "已安装自愈 cron"
}
remove_cron() {
	[ -f "$CRON" ] && grep -qF "$D/cca-router.sh ensure" "$CRON" || return 0
	grep -vF "$D/cca-router.sh ensure" "$CRON" > "$CRON.cca.$$"
	rewrite "$CRON" "$CRON.cca.$$"
	"$R/etc/init.d/cron" restart >/dev/null 2>&1
}
install_keep() {   # 刷固件(sysupgrade)时保留 /etc/cca
	touch "$SYSUP"
	grep -qxF /etc/cca/ "$SYSUP" || echo /etc/cca/ >> "$SYSUP"
}
remove_keep() {
	[ -f "$SYSUP" ] && grep -qxF /etc/cca/ "$SYSUP" || return 0
	grep -vxF /etc/cca/ "$SYSUP" > "$SYSUP.cca.$$"
	rewrite "$SYSUP" "$SYSUP.cca.$$"
}

# OpenClash 生成配置时调用（启动时本来就会加载配置，不额外重载）。任何失败都保留原配置
hook() {
	f="$1"; FQUIET=1
	# 参考节点：OpenClash 自己的配置（订阅更新会整个换掉）里缺了就写回去。这次的运行配置已经按写之前的那份生成好了，
	# 生成端口池时照配置文件把这些节点也写进它（--mirror，和下次按配置文件生成的一样），不用为这个再重启一次
	fill_source
	rm -f "$FILLPEND"   # 这次的运行配置是按写好的配置文件生成的
	mir=""
	if [ -n "$FILLWROTE" ]; then
		mir=$(source_config)
		echo "$(date '+%Y-%m-%d %H:%M:%S') 【cca】已把维护者参考配置里的节点写进配置文件 ${mir}" >> "$R/tmp/openclash.log"
	fi
	[ -f "$f" ] && { [ -s "$PORTS" ] || [ -n "$mir" ]; } || return 0   # 没有账号端口（也不用写参考节点）就完全不碰配置
	cp -f "$f" "$f.cca.bak"
	ruby -E UTF-8 "$D/apply.rb" ${mir:+--mirror "$mir"} "$f" "$ACC" >> "$LOG" 2>&1; hk_rc=$?
	case $hk_rc in
		0|3)
			[ $hk_rc -eq 3 ] && : > "$FILLPEND"
			rm -f "$f.cca.bak"
			[ -s "$PORTS" ] && echo "$(date '+%Y-%m-%d %H:%M:%S') 【cca】已注入 Claude 账号端口池: $(tr '\n' ' ' < "$PORTS")" >> "$R/tmp/openclash.log" ;;
		*)
			mv -f "$f.cca.bak" "$f"
			[ -n "$mir" ] && : > "$FILLPEND"   # 参考节点没写进这次的运行配置：重启后才用上
			log "hook: apply.rb 失败，配置保持原样" ;;
	esac
}

# ShellCrash 启动时由它启动前的任务文件调用（它拼运行配置之前）：订阅配置复制一份、只插入端口池的几行，输出这份的路径，
# ShellCrash 接着就拿它拼出运行配置（启动时本来就会加载配置，不额外重载）。没有账号端口、不支持、出了问题都输出原来的路径
sc_hook() {
	f="$1"; o="$R/tmp/cca.shellcrash.yaml"; FQUIET=1
	if [ -n "$SC" ] && [ -f "$f" ] && sc_meta; then
		fill_source "$f"   # 参考节点：在 ShellCrash 读订阅配置之前写进去（订阅更新会整个换掉），这次启动就用上
		rm -f "$FILLPEND"
	fi
	if [ -n "$SC" ] && [ -s "$PORTS" ] && [ -f "$f" ]; then
		if ! sc_meta; then
			log "sc-hook: ShellCrash 用的不是 mihomo（Meta）内核，没有注入端口池"
		elif grep -qs '^listeners:' "$SC/yamls/user.yaml" "$SC/yamls/others.yaml"; then
			log "sc-hook: ShellCrash 的 yamls/user.yaml 或 others.yaml 里自己写了 listeners，和端口池的会重复，启动时没有注入（在 Mac 上运行 cca router sync，问过再热加载）"
		else
			if ruby -E UTF-8 "$D/apply.rb" --insert "$o" --ports "$(sc_ports)" "$f" "$ACC" >> "$LOG" 2>&1; then
				sc_unsave
				echo "$(date '+%Y-%m-%d_%H:%M:%S')~【cca】已注入 Claude 账号端口池: $(tr '\n' ' ' < "$PORTS")" >> "$SCT/ShellCrash.log"
				echo "$o"
				return 0
			fi
			log "sc-hook: 生成端口池失败，ShellCrash 照原样启动"
		fi
	fi
	echo "$f"
}
sc_ports() {   # ShellCrash 自己要占的端口（默认值和它的 libs/get_config.sh 一样）：端口池避开它们
	( for x in ShellCrash.cfg gateway.cfg; do [ -f "$SC/configs/$x" ] && . "$SC/configs/$x" >/dev/null 2>&1; done   # . 一个不存在的文件会让 sh 直接退出
	  echo "${mix_port:-7890} ${redir_port:-7892} ${tproxy_port:-7893} ${db_port:-9999} ${dns_port:-1053} ${vms_port:-} ${sss_port:-}" )
}
sc_unsave() {   # ShellCrash 停止时把面板上改过的选中项存进 configs/web_save、启动后还原：CCA-n 的不让它还原（cca 自己按账号表切）
	w="$SC/configs/web_save"
	grep -q '^CCA-[0-9]*,' "$w" 2>/dev/null || return 0
	grep -v '^CCA-[0-9]*,' "$w" > "$w.cca.$$"
	rewrite "$w" "$w.cca.$$"
}

structure() {   # 端口池的"结构"：cca- 入站和 CCA- 策略组的成员（不含选中哪个），结构变了才需要重载
	ruby -E UTF-8 -ryaml -e "$YL"'
		c = yl(ARGV[0]) || {}
		(c["listeners"] || []).each { |l| puts "L|#{l["name"]}|#{l["port"]}|#{l["proxy"]}" if l.is_a?(Hash) && l["name"].to_s.start_with?("cca-") }
		(c["proxy-groups"] || []).each { |g| puts "G|#{g["name"]}|#{(g["proxies"] || []).map(&:to_s).sort.join(",")}" if g.is_a?(Hash) && g["name"].to_s.start_with?("CCA-") }' "$1" 2>/dev/null | sort
}
cca_ports() {
	ruby -E UTF-8 -ryaml -e "$YL"'; puts((yl(ARGV[0]) || {})["listeners"].to_a.select { |l| l.is_a?(Hash) && l["name"].to_s.start_with?("cca-") }.map { |l| l["port"].to_i })' "$1" 2>/dev/null
}

# 通过 mihomo API 重载配置（不带 force：只补丁 listeners，不重建 OpenClash / ShellCrash 自己的 7890 等入站）。
# 整套重载要二十多秒才返回，超时给足 90 秒；拿不到响应（000）时以端口实际状态为准。
reload() {
	ctl_init
	p="$1"
	if [ "$BK" = sc ]; then   # mihomo 只肯重载它主目录（-d）里的文件：ShellCrash 的运行配置在 /tmp，经它在主目录里放的链接 config.yaml
		[ -L "$SCB/config.yaml" ] || [ ! -e "$SCB/config.yaml" ] && ! [ "$SCB/config.yaml" -ef "$1" ] && ln -sf "$1" "$SCB/config.yaml"
		[ "$SCB/config.yaml" -ef "$1" ] && p="$SCB/config.yaml"
	fi
	RELOAD_CODE=$(curl -q --noproxy '*' -s -m 90 -o /dev/null -w '%{http_code}' -X PUT -H "Authorization: Bearer $CSEC" \
		-H 'Content-Type: application/json' --data "{\"path\":\"$p\"}" "http://127.0.0.1:$CPORT/configs")
	case "$RELOAD_CODE" in 2??|000|"") return 0 ;; esac
	echo "mihomo 拒绝了新配置（HTTP ${RELOAD_CODE}）"
	return 1
}
reload_wait() {   # 拿到 2xx 时入站已经补丁完，只需确认一下；拿不到响应时多等一会
	case "$RELOAD_CODE" in 2??) wait_ports "$1" "$2" 4 ;; *) wait_ports "$1" "$2" ;; esac
}
wait_ports() {   # wait_ports "应监听的端口" "应关闭的端口" [最多等几秒，默认 CCA_WAIT 或 60]
	n=$(( ${3:-${CCA_WAIT:-60}} / 2 ))
	while :; do
		ok=1
		for p in $1; do listening "$p" || ok=0; done
		for p in $2; do listening "$p" && ok=0; done
		[ $ok = 1 ] && return 0
		[ $n -gt 0 ] || return 1
		n=$((n - 1))
		sleep 2
	done
}

restart_now() {   # restart_now 为什么要重启：重启 OpenClash / ShellCrash（和重载一样要 Mac 端征得同意，Mac 端按"只能重启一次"认出
	               # 问的是重启）。用在运行配置不见了、要调整端口池时，和配置文件里新写了参考节点时。返回值同 apply_now
	if [ "${CCA_ALLOW_RELOAD:-}" != 1 ]; then
		echo "${1}只能重启一次 ${NAME}：约 20 秒，期间局域网的连接都会中断"
		return 3
	fi
	echo "正在重启 ${NAME}（约 20 秒）…"
	log "重启 ${NAME}：${1}"
	if [ "$BK" = sc ]; then sv="$SC/start.sh"; else sv="$R/etc/init.d/openclash"; fi
	( trap '' HUP; "$sv" restart ) >/dev/null 2>&1   # SSH 中途断了也要重启完（不然停在一半）
	CPORT=""   # 重启后重新读控制接口的端口和密钥
	if wait_ports "$(tr '\n' ' ' < "$PORTS")" "" && select_all >/dev/null; then
		echo "已重启 ${NAME}，账号端口池已就绪"
		return 0
	fi
	echo "重启 ${NAME} 后账号端口池没有就绪：看一下 ${NAME} 的日志"
	return 1
}

# 把 accounts.yaml 落到正在运行的 OpenClash / ShellCrash：结构没变只切节点；结构变了且获准才重载（运行配置不见了时是重启）。
# 有参考节点时先写进配置文件，新写了的要重启一次才用上（获准才重启）。返回 0 成功；3 需要重载（重启）但没获准；1 失败
apply_now() {
	if [ "$BK" = sc ] && ! sc_meta; then
		echo "ShellCrash 现在用的不是 mihomo（Meta）内核：cca 的端口池只支持 Meta 内核（ShellCrash 的菜单里可以换内核）"
		return 1
	fi
	fill_source   # 参考节点先写进配置文件：在跑的要重启才用上（下面 fill_waiting）
	[ -n "$FILLWROTE" ] && running && : > "$FILLPEND"
	cf=$(runtime_config)
	if [ -z "$cf" ] || [ ! -f "$cf" ]; then
		if ! running; then
			echo "还没有 ${NAME} 运行配置：端口池会在 ${NAME} 启动时由钩子注入"
			return 0
		fi
		# 在运行，运行配置文件却不见了（被删掉了）：各槽位切得过去就不用动它；要建立或调整端口池，
		# 没有运行配置就没法热加载，只能重启一次（重新生成运行配置，启动时由钩子注入端口池）
		if [ -z "$(missing_ports)" ]; then
			select_all
			case $? in
				0) return 0 ;;
				1) in_source "$FAILED" || return 1 ;;   # 切不过去的节点生成运行配置的那份配置里也没有：重启也没用
			esac
		fi
		restart_now "${NAME} 的运行配置文件不见了，要建立或调整账号端口池"
		return $?
	fi
	if ! running; then
		echo "${NAME} 未运行：端口池会在它下次启动时由钩子注入"
		return 0
	fi
	if fill_waiting; then   # 重启时按写好的配置文件重新生成运行配置，钩子照常注入端口池：端口池要调整也一起了
		restart_now "${NAME} 的配置文件里新写了维护者参考配置里的节点，要用上"
		return $?
	fi
	t="$R/tmp/cca.apply.$$.yaml"
	cp -f "$cf" "$t"
	# ShellCrash：节点只用订阅配置里也有的（它的自定义节点启动时才拼进来，钩子用不上），和启动时注入的一致
	if [ "$BK" = sc ] && src=$(source_config); then set -- --base "$src"; else set --; fi
	if ! ruby -E UTF-8 "$D/apply.rb" "$@" "$t" "$ACC"; then
		rm -f "$t"
		echo "生成配置失败，运行配置未改动"
		return 1
	fi
	if [ "$(structure "$cf")" = "$(structure "$t")" ] && [ -z "$(missing_ports)" ]; then
		put_runtime "$cf" "$t"   # 只有默认选中顺序可能不同，写回文件让下次启动一致
		select_all "$cf"
		case $? in
			0) echo "账号端口已就绪（切换节点走 API，无需重载）"; return 0 ;;
			1) return 1 ;;
		esac
		echo "运行中的内核里缺少账号策略组或组里的节点（和运行配置文件不一致）"   # 落到下面的重载
		cp -f "$cf" "$t"
	fi
	if [ "${CCA_ALLOW_RELOAD:-}" != 1 ]; then
		rm -f "$t"
		echo "需要让 ${NAME} 重载一次配置，用来建立或调整账号端口池：约 20 秒，期间局域网的新连接会中断"
		return 3
	fi
	if ! core_test "$t"; then
		rm -f "$t"
		echo "mihomo 校验未通过，运行配置未改动："
		echo "$out" | tail -n 3
		return 1
	fi
	newp=$(cca_ports "$t" | tr '\n' ' ')
	gonep=""
	for p in $(cca_ports "$cf"); do
		case " $newp " in *" $p "*) ;; *) gonep="$gonep $p" ;; esac
	done
	cp -f "$cf" "$D/runtime.bak.yaml"
	put_runtime "$cf" "$t"
	echo "正在重载 ${NAME} 配置（约 20 秒）…"
	if reload "$cf"; then
		ok=0
		if reload_wait "$newp" "$gonep"; then
			ok=1
		else
			# 端口还被名字不同的旧入站占着时，内核先起新入站（绑定失败）再关旧入站。端口此时已释放，再重载一次就能绑上
			echo "有端口刚被旧的入站释放，再重载一次（约 20 秒）…"
			reload "$cf" && reload_wait "$newp" "$gonep" && ok=1
		fi
		if [ $ok = 1 ]; then
			select_all || { echo "重载后账号节点未能核实，停止使用端口池"; return 1; }
			echo "已重载并建立账号端口池（未重启 ${NAME}）"
			return 0
		fi
	fi
	cp -f "$D/runtime.bak.yaml" "$cf"
	echo "重载后端口没有按预期变化，运行配置已还原。可以手动重启一次 ${NAME}：钩子会在启动时注入端口池"
	return 1
}

ensure() {   # cron：补钩子、纠正被改掉的选中节点；端口池缺失时只记录，不自动重载（避免打断局域网）
	[ -s "$PORTS" ] || return 0
	install_hook
	running || return 0
	if [ -n "$(missing_ports)" ]; then
		[ -f "$R/tmp/cca.missing" ] || { log "账号端口池不在运行中的 ${NAME} 里：等它下次启动由钩子注入，或在 Mac 上运行 cca router sync"; : > "$R/tmp/cca.missing"; }
		return 0
	fi
	rm -f "$R/tmp/cca.missing"
	out=$(select_all)
	[ -n "$out" ] && log "纠正选中节点：$(echo $out)"
	return 0
}
ensure_now() {   # Mac 启动前调用：端口池在就只纠正选中节点（快）；不在则交给 apply_now（需要重载时返回 3）。
	              # 参考节点也核对一遍（配置文件和参考节点都没变时只算一下校验和）：配置文件里新写了的要重启才用上，也交给 apply_now 问
	install_hook
	fill_source
	[ -n "$FILLWROTE" ] && running && : > "$FILLPEND"
	if [ -z "$(missing_ports)" ]; then
		ctl_init   # 控制接口的端口和密钥先读好（select_all 在子 shell 里跑，读了也带不回来）
		en_out=$(select_all "$(runtime_config)"); en_rc=$?
		case $en_rc in
			0|1) [ -z "$en_out" ] || printf '%s\n' "$en_out"; fill_waiting || return $en_rc ;;
		esac
		# 2（组不在运行中的内核里，或内核落后于运行配置文件）：交给 apply_now，它会再核实一遍、说清楚，问过再重载，这里不重复说
	fi
	apply_now
}

hook_ok() {   # 在用的那套装着 cca 的钩子
	if [ "$BK" = sc ]; then grep -qF "$SCHOOK" "$(sc_task)" 2>/dev/null; else grep -qxF "$MB" "$OW" 2>/dev/null; fi
}
fill_status() {   # 参考节点在配置文件里齐不齐，写进去的用上了没有
	fill_has || return 0
	fst_src=$(source_config)
	if [ -z "$fst_src" ] || [ ! -f "$fst_src" ]; then echo "参考节点：找不到 ${NAME} 的配置文件，没地方写"; return 0; fi
	set -- --fill-source -
	[ "$BK" = sc ] && set -- "$@" --custom "$SC/yamls/proxies.yaml"
	fst_r=$(ruby -E UTF-8 "$D/apply.rb" "$@" "$fst_src" "$ACC" 2>/dev/null); fst_rc=$?
	fst_line="参考节点：维护者参考配置里$(printf '%s\n' "$fst_r" | sed -n 1p)，"
	case $fst_rc in
		2) fst_line="${fst_line}${NAME} 的配置文件里都有$(printf '%s\n' "$fst_r" | sed -n 3p)" ;;
		0) fst_line="${fst_line}${NAME} 的配置文件里还要$(printf '%s\n' "$fst_r" | sed -n 2p)"
		   [ "$(cat "$FILLOK" 2>/dev/null)" = "$(fill_id)" ] || fst_line="${fst_line}（这一版还没在这台路由器的内核上校验过）" ;;
		*) echo "参考节点：读不了 ${NAME} 的配置文件 ${fst_src}"; return 0 ;;
	esac
	[ -f "$FILLPEND" ] && fst_line="${fst_line}（新写进去的要等 ${NAME} 重启后才用上）"
	echo "$fst_line"
	[ $fst_rc -eq 0 ] && [ -s "$FILLWHY" ] && echo "  上次没写成：$(cat "$FILLWHY")"
	return 0
}
status() {
	if running; then echo "${NAME}：运行中"; else echo "${NAME}：未运行"; fi
	[ "$BK" = sc ] && ! sc_meta && echo "ShellCrash 用的不是 mihomo（Meta）内核：cca 的端口池用不了"
	cf=$(runtime_config)
	if [ -f "$cf" ]; then echo "运行配置：${cf}"
	elif running; then echo "运行配置：${cf}（文件不见了：切换节点照常，建立或调整端口池要重启一次 ${NAME}）"
	else echo "运行配置：${cf}（还没有，${NAME} 启动时生成）"; fi
	if hook_ok; then echo "钩子：已安装"; else echo "钩子：未安装"; fi
	if grep -qF "$D/cca-router.sh ensure" "$CRON" 2>/dev/null; then echo "自愈 cron：已安装"; else echo "自愈 cron：未安装"; fi
	fill_status
	if [ -s "$SEL" ] && running; then
		i=0
		while IFS="$TAB" read -r g node; do
			[ -n "$g" ] || continue
			i=$((i + 1))
			p=$(sed -n "${i}p" "$PORTS")
			ctl GET "/proxies/$g"
			now=$(now_of)
			if listening "$p"; then st="监听中"; else st="未监听"; fi
			if [ "$CODE" != 200 ]; then now="（内核里没有）"; fi
			echo "槽位 ${g} :${p} ${st} → ${now:-?}$([ "$now" != "$node" ] && echo "（应为 ${node}）")"
		done < "$SEL"
		rm -f "$CTLOUT"
	fi
	if [ -f "$LOG" ]; then echo "最近日志："; tail -n 5 "$LOG"; fi
	return 0
}
nodes_cf() {   # nodes / defs 读哪份配置（设好 cf），ShellCrash 的自定义节点在哪（设好 cust）
	cust=""
	if [ "$BK" = sc ]; then
		# ShellCrash 只列订阅配置里的：它的自定义节点、策略组启动时才拼进来（自定义配置出错时又会去掉），钩子用不上
		sc_meta || { echo "ShellCrash 用的不是 mihomo（Meta）内核：cca 只支持 Meta 内核" >&2; return 1; }
		cf=$(source_config)
		cust="$SC/yamls/proxies.yaml"
	else
		cf=$(runtime_config)
		[ -n "$cf" ] && [ -f "$cf" ] || cf=$(source_config)   # 运行配置不见了：OpenClash 自己的配置里节点一样
	fi
	[ -n "$cf" ] && [ -f "$cf" ] || { echo "找不到 ${NAME} 的配置" >&2; return 1; }
}
defs() {   # 节点的完整定义（JSON 的 {"proxies": […]}，带密钥）：在家时拷一份给内置代理（只留可选节点，在拷的那台机器上挑）。
	       # 读的配置和 nodes 一样。JSON 在这里写好：拷的那台机器（Linux 服务器）不一定有 ruby，OpenWrt 的 ruby 也不一定带 json 库
	       # （OpenClash 只依赖 ruby、ruby-yaml），所以自己写；字符串里的引号、反斜杠、控制字符写成 \u 转义，不合法的 UTF-8 换掉。
	       # 日期这类读出来不是字符串的值照字符串写（to_s），NaN、无穷大写 null。最后一行是结束标记：没读到它的不要
	nodes_cf || return 1
	ruby -E UTF-8 -ryaml -e "$YL"'
		j = lambda do |v|
		  case v
		  when Hash then "{" + v.map { |k, x| j.(k.to_s) + ":" + j.(x) }.join(",") + "}"
		  when Array then "[" + v.map { |x| j.(x) }.join(",") + "]"
		  when true, false, Integer then v.to_s
		  when nil then "null"
		  when Float then v.finite? ? v.to_s : "null"
		  else "\"" + v.to_s.dup.force_encoding("UTF-8").scrub("?").gsub(/[\\"\x00-\x1f]/) { |ch| "\\u%04x" % ch.ord } + "\""
		  end
		end
		c = yl(ARGV[0]) || {}
		print j.({"proxies" => (c["proxies"] || []).select { |p| p.is_a?(Hash) }})
		print "\n# cca-defs-end\n"' "$cf"
}
nodes() {   # P<TAB>节点<TAB>类型<TAB>服务器<TAB>端口<TAB>TLS 域名（Mac 端按后四项认出改了名的节点，只存摘要）；G<TAB>策略组<TAB>类型；
	         # ShellCrash 的自定义节点 C<TAB>名字（不能当出口，Mac 端补参考节点时不占用它们的名字）
	nodes_cf || return 1
	ruby -E UTF-8 -ryaml -e "$YL"'
		c = yl(ARGV[0]) || {}
		f = lambda { |v| v.to_s.tr("\t\n", "  ") }
		(c["proxies"] || []).each { |p| puts ["P", p["name"], p["type"], p["server"], p["port"], p["servername"] || p["sni"]].map(&f).join("\t") if p.is_a?(Hash) }
		(c["proxy-groups"] || []).each { |g| puts "G\t#{g["name"]}\t#{g["type"]}" if g.is_a?(Hash) && !g["name"].to_s.start_with?("CCA-") }
		if ARGV[1] && File.file?(ARGV[1])
		  File.foreach(ARGV[1], encoding: "UTF-8") do |l|
		    m = l =~ /\A\s*#/ ? nil : l.match(/\bname:\s*("(?:[^"\\]|\\.)*"|\x27(?:[^\x27]|\x27\x27)*\x27|[^,}#]+)/)
		    puts "C\t#{f.call(m[1].strip.sub(/\A["\x27](.*)["\x27]\z/, "\\1"))}" if m
		  end
		end' "$cf" ${cust:+"$cust"}
}
uninstall() {   # stdin 可传入要删除的 SSH 公钥；CCA_ALLOW_RELOAD=1 时立即移除端口池，否则等 OpenClash / ShellCrash 下次重启
	key=""
	[ -t 0 ] || key=$(cat)
	remove_hook
	remove_cron
	remove_keep
	if [ -f "$ACC" ]; then
		echo '{"base": 0, "slots": 0, "nodes": [], "accounts": []}' > "$ACC"
		: > "$PORTS"
		: > "$SEL"
		apply_now || echo "端口池会在 ${NAME} 下次重启后消失（钩子已移除）"
	fi
	if [ -n "$key" ]; then
		for f in "$R/etc/dropbear/authorized_keys" "$HOME/.ssh/authorized_keys"; do
			[ -f "$f" ] && grep -qxF "$key" "$f" || continue
			grep -vxF "$key" "$f" > "$f.cca.$$"
			rewrite "$f" "$f.cca.$$"
		done
	fi
	rm -rf "$D" "$R/tmp/cca.missing"
	echo "路由器上的 cca 已移除"
	src=$(source_config) && grep -qs ' # cca' "$src" &&
		echo "${NAME} 的配置文件 ${src} 里 cca 写进去的维护者参考节点（行尾带 # cca）留着，不要的话自己删"
	return 0
}

backend
case "$1" in
	hook) hook "$2"; exit 0 ;;
	sc-hook) sc_hook "$2"; exit 0 ;;
	install) install_hook && install_cron && install_keep ;;
	apply) FILLFORCE=1; apply_now ;;   # 同步时参考节点照读一遍配置文件（内核升级了、上次没写成的也再试）
	ensure) ensure ;;
	ensure-now) ensure_now ;;
	status) status ;;
	nodes) nodes ;;
	defs) defs ;;
	uninstall) uninstall ;;
	*) echo "用法: $0 hook <配置>|sc-hook <配置>|install|apply|ensure|ensure-now|status|nodes|defs|uninstall" >&2; exit 2 ;;
esac
SH
}

router_rb() {
	cat <<'RB'
# cca：在 mihomo 配置里生成账号端口池。槽位 n = mixed 入站 cca-n（端口 base+n，不认证）→ select 策略组 CCA-n，
# 组成员是可选节点 + REJECT；分到账号的槽位把它的节点排第一（内核启动后默认就选中它），空槽位默认 REJECT。
#   ruby apply.rb [--base 订阅配置 | --mirror 配置文件] 配置 账号表
#     改写配置：OpenClash 的运行配置；ShellCrash 热加载前的运行配置（节点只用订阅配置里也有的，和它启动时一样）。
#     --mirror：OpenClash 启动时参考节点刚写进它自己的配置，这次的运行配置里也照样写上（见下面）
#   ruby apply.rb --insert 输出 --ports "端口 …" 订阅配置 账号表
#     ShellCrash 启动前用：订阅配置原样复制到输出，只插入端口池的几行。ShellCrash 按文本把订阅配置拆成几段、
#     再和它自己的设置拼起来，整份重排的话它自己追加的入站缩进会对不上；--ports 是它自己要占的端口
#   ruby apply.rb --fill-source 输出 [--custom 自定义节点] [--test 配置 --test-out 输出] 配置文件 账号表
#     把账号表里维护者参考配置的节点（fill）直接写进用户的配置文件（见下面「参考节点」）：写好的新内容放到输出（输出是 -
#     时只看不写：第一行是参考节点的概况，第二行是还要做什么，第三行是改不了的），做了什么打印到 stdout；退出码 0 有改动，
#     3 只是把 cca 以前写成一行的节点改成了块写法（内容没变），2 不用改，1 改不了。
#     --custom：ShellCrash 的自定义节点（yamls/proxies.yaml，它随后才接进来），参考节点不占用它们的名字；
#     --test：另写一份「这份配置 + 要写的节点」到 --test-out，给内核 -t 校验（别处的节点这里的内核不一定认）
require 'yaml'
opt = {}
while ARGV[0].to_s.start_with?('--')
  k = ARGV.shift
  opt[k] = ARGV.shift
end
cfg_file, acc_file = ARGV
yparse = lambda do |s|   # 订阅配置里常有锚点：新版 Psych 要 aliases: true 才肯读，旧版不认这个参数
  begin
    YAML.load(s, aliases: true)
  rescue ArgumentError
    YAML.load(s)
  end
end
yload = lambda { |f| yparse.call(File.read(f, encoding: 'UTF-8')) }
begin
  cfg = yload.call(cfg_file) || {}
  acc = (File.exist?(acc_file) && YAML.load_file(acc_file)) || {}
  base = opt['--base'] && (yload.call(opt['--base']) || {})
  raise '顶层不是映射' unless cfg.is_a?(Hash) && acc.is_a?(Hash) && (base.nil? || base.is_a?(Hash))
rescue StandardError, Psych::SyntaxError => e
  $stderr.puts "cca: 读取配置失败：#{e.message.lines.first.to_s.strip}"
  exit 1
end
list = lambda { |v| v.is_a?(Array) ? v : [] }
ours = lambda { |x, prefix| x.is_a?(Hash) && x['name'].to_s.start_with?(prefix) }
names = lambda do |c|   # 节点和（cca 以外的）策略组的名字
  list.call(c['proxies']).select { |p| p.is_a?(Hash) }.map { |p| p['name'].to_s } +
    list.call(c['proxy-groups']).select { |g| g.is_a?(Hash) && !ours.call(g, 'CCA-') }.map { |g| g['name'].to_s }
end
q = lambda { |s| '"' + s.to_s.gsub(/["\\]/) { |c| "\\#{c}" }.gsub(/[\x00-\x1f\x7f]/) { |c| format('\x%02x', c.ord) } + '"' }
insert_lines = lambda do |text, key, make|   # 段落 key 开头插入几项：make.call(缩进, 换行) 给出要插的行（和这一段原有的项对齐）。
  lines = text.lines                          # 段落的认法和 ShellCrash 一样：顶格的 "key:" 开始，到下一个顶格的小写字母开头的行为止
  heads = lines.each_index.select { |i| lines[i].start_with?("#{key}:") }
  raise "#{key} 出现了不止一次" if heads.size > 1
  if heads.empty?   # 没有这一段：加在最后，缩进和 ShellCrash 自己追加入站时一样（两个空格）
    text += "\n" unless text.empty? || text.end_with?("\n")
    return text + "#{key}:\n" + make.call('  ', "\n").join
  end
  i = heads[0]
  nl = lines[i].end_with?("\r\n") ? "\r\n" : "\n"
  lines[i] = "#{key}:#{nl}" if lines[i] =~ /\A#{Regexp.escape(key)}:[ \t]*(\[\]|null|~)[ \t]*\r?\n?\z/   # 空列表写成一行的
  raise "#{key} 不是一行一项的列表" unless lines[i] =~ /\A#{Regexp.escape(key)}:[ \t]*(#.*)?\r?\n?\z/
  j = (i + 1...lines.size).find { |n| lines[n] =~ /\A[a-z]/ } || lines.size
  first = lines[i + 1...j].find { |l| l =~ /\A *- / }
  ind = first ? first[/\A */] : '  '
  lines[i] += nl unless lines[i].end_with?("\n")
  lines[i + 1, 0] = make.call(ind, nl)
  lines.join
end
insert = lambda do |text, key, items|   # 一项一行的
  items.empty? ? text : insert_lines.call(text, key, ->(ind, nl) { items.map { |s| "#{ind}- #{s}#{nl}" } })
end
fkey = lambda { |k| s = k.to_s; s =~ /\A[A-Za-z_][A-Za-z0-9_-]*\z/ && s !~ /\A(y|yes|n|no|true|false|on|off|null)\z/i ? s : q.call(s) }
flow = lambda do |v|   # 写成一行（YAML 的流式写法）：写进配置文件的节点一个一行
  case v
  when Hash then '{' + v.map { |k, x| "#{fkey.call(k)}: #{flow.call(x)}" }.join(', ') + '}'
  when Array then '[' + v.map { |x| flow.call(x) }.join(', ') + ']'
  when nil then 'null'
  when true, false, Integer, Float then v.to_s
  else q.call(v)
  end
end
scalar = lambda do |v|   # 块写法里的一个值：能不加引号就不加（交给 Psych 判断），有换行的写成双引号
  case v
  when nil then 'null'
  when true, false, Integer, Float then v.to_s
  else
    s = v.to_s
    d = s =~ /[\r\n]/ ? "\n" : YAML.dump(s, line_width: -1).sub(/\A--- /, '').sub(/\n(\.\.\.\n)?\z/, '')
    d.include?("\n") ? q.call(s) : d
  end
end
emit = lambda do |h, ind, out|   # 映射的块写法：一键一行，子映射、列表往里缩两格（和手写的 Clash 配置一样）
  h.each do |k, v|
    if v.is_a?(Hash) && !v.empty?
      out << "#{ind}#{fkey.call(k)}:"
      emit.call(v, ind + '  ', out)
    elsif v.is_a?(Array) && !v.empty?
      out << "#{ind}#{fkey.call(k)}:"
      v.each do |x|
        if x.is_a?(Hash) && !x.empty?
          sub = emit.call(x, ind + '    ', [])
          sub[0] = "#{ind}  - #{sub[0].lstrip}"
          out.concat(sub)
        else
          out << "#{ind}  - #{x.is_a?(Hash) || x.is_a?(Array) ? flow.call(x) : scalar.call(x)}"
        end
      end
    else
      out << "#{ind}#{fkey.call(k)}: #{v.is_a?(Hash) || v.is_a?(Array) ? flow.call(v) : scalar.call(v)}"
    end
  end
  out
end
add_members = lambda do |text, gname, items, suffix|   # 策略组 gname 的 proxies 列表末尾接上 items：只认一行一项的块写法
  lines = text.lines                                     # （ShellCrash 往组里加自定义节点也只认这种）
  heads = lines.each_index.select { |i| lines[i].start_with?('proxy-groups:') }
  raise 'proxy-groups 出现了不止一次' if heads.size > 1
  raise '没有 proxy-groups 这一段' if heads.empty?
  i = heads[0]
  j = (i + 1...lines.size).find { |n| lines[n] =~ /\A[a-z]/ } || lines.size
  first = (i + 1...j).find { |n| lines[n] =~ /\A *- / }
  raise '一个策略组都没有' unless first
  ind = lines[first][/\A */]
  starts = (i + 1...j).select { |n| lines[n].start_with?("#{ind}- ") }
  s = e = nil
  starts.each_with_index do |a, k|
    b = starts[k + 1] || j
    y = (yparse.call(lines[a...b].join) rescue nil)
    next unless y.is_a?(Array) && y.size == 1 && y[0].is_a?(Hash) && y[0]['name'].to_s == gname
    s = a
    e = b
    break
  end
  raise "找不到策略组 #{gname}" unless s
  ki = ' ' * lines[s][/\A *- */].size
  pk = (s + 1...e).find { |n| lines[n] =~ /\A#{ki}proxies:[ \t]*(#.*)?\r?\n?\z/ }
  raise "策略组 #{gname} 的 proxies 不是一行一项的列表" unless pk
  m = pk + 1
  li = nil
  while m < e && (md = lines[m].match(/\A( *)- /)) && md[1].size >= ki.size && (li.nil? || md[1] == li)
    li ||= md[1]
    m += 1
  end
  li ||= ki + '  '
  nl = lines[pk].end_with?("\r\n") ? "\r\n" : "\n"
  lines[m - 1] += nl unless lines[m - 1].end_with?("\n")
  last = m - 1 > pk ? lines[m - 1] : ''   # 和组里原有的成员一样：带双引号、单引号，还是不带
  one = if last =~ /\A *- "/ then q
        elsif last =~ /\A *- '/ then ->(n) { "'" + n.to_s.gsub("'", "''") + "'" }
        else scalar
        end
  lines[m, 0] = items.map { |n| "#{li}- #{one.call(n)}#{suffix}#{nl}" }
  lines.join
end

# --- 参考节点：账号表的 fill（Mac 上的 cca 从维护者的映射仓库拉下来、验过签的）= 维护者配置里的一个策略组和它引用的节点。
# 直接写进用户的配置文件（OpenClash 选用的那份、ShellCrash 的订阅配置、Clash Verge 当前的配置）：缺的节点按块写法（和手写的
# 节点一样一键一行）插在 proxies 开头，name 那一行行尾带「# cca」；名字接在同名策略组的 proxies 后面（照组里原有的引号写法），
# 行尾也带「# cca」。维护者改了节点，带记号的那一项整个换掉；以前写成一行的（2.8.0-beta.5～7）改成块写法。这些不写：
# 同名的是用户自己的节点（只补进组）；名字被策略组、内置的出站、ShellCrash 的自定义节点占了；用户已经有同一个节点（类型、
# 服务器、端口和 TLS 域名一样）、只是叫法不同（补进组的是他的名字）；要经别的节点连接（dialer-proxy）而那个节点没有。
# 和 Mac 上 cca 的 fill_plan 是同一套规则。原文的其余部分一个字节不动，写好的读一遍核对
if opt.key?('--fill-source')
  fill = acc['fill'].is_a?(Hash) ? acc['fill'] : nil
  exit 2 unless fill
  text = File.read(cfg_file, mode: 'rb').force_encoding('UTF-8')
  mark = ' # cca'
  custom = []   # ShellCrash 的自定义节点：一行一个 "- {name: 节点, …} #策略组"
  if opt['--custom'] && File.file?(opt['--custom'])
    File.foreach(opt['--custom'], encoding: 'UTF-8') do |l|
      m = l =~ /\A\s*#/ ? nil : l.match(/\bname:\s*("(?:[^"\\]|\\.)*"|'(?:[^']|'')*'|[^,}#]+)/)
      next unless m
      v = m[1].strip
      v = (yparse.call(v) rescue v) if v.start_with?('"', "'")
      custom << v.to_s.strip
    end
  end
  lines = text.lines
  marked = {}   # cca 以前写进来的节点（第一行行尾带记号）：名字 → [行号, 是不是写成了一行]（2.8.0-beta.5～7 写的是一行）
  ph = lines.index { |l| l.start_with?('proxies:') }
  if ph
    pe = (ph + 1...lines.size).find { |n| lines[n] =~ /\A[a-z]/ } || lines.size
    (ph + 1...pe).each do |n|
      m = lines[n].match(/\A *- (.*?)[ \t]+# cca[ \t]*\r?\n?\z/) or next
      y = (yparse.call(m[1]) rescue nil)
      marked[y['name'].to_s] = [n, m[1].start_with?('{')] if y.is_a?(Hash) && !y['name'].to_s.empty?
    end
  end
  span_end = lambda do |ls, n|   # 列表里从第 n 行起的这一项到哪一行为止（不含）：缩进更深的行都算它的，末尾的空行不算
    ind = ls[n][/\A */].size
    last = n
    e = n + 1
    while e < ls.size
      unless ls[e].strip.empty?
        break if ls[e][/\A */].size <= ind
        last = e
      end
      e += 1
    end
    last + 1
  end
  node_lines = lambda do |p, ind, nl|   # 节点写成列表里的一项（块写法，name 排第一，那一行行尾带记号）
    sub = emit.call({ 'name' => p['name'] }.merge(p), ind + '  ', [])
    sub[0] = "#{ind}- #{sub[0].lstrip}#{mark}"
    sub.map { |l| l + nl }
  end
  key = lambda do |p|   # 和 Mac 上的 cca 认节点一样：类型、服务器、端口、TLS 域名
    s = p['server'].to_s.strip.downcase.sub(/\.+\z/, '')
    s.empty? ? nil : [p['type'].to_s.strip.downcase, s, p['port'].to_s.strip, (p['servername'] || p['sni']).to_s.strip.downcase.sub(/\.+\z/, '')].join('|')
  end
  mine = list.call(cfg['proxies']).select { |p| p.is_a?(Hash) }
  have = {}
  mine.each { |p| have[p['name'].to_s] ||= p }
  taken = {}
  (names.call(cfg) + %w[DIRECT REJECT REJECT-DROP PASS COMPATIBLE GLOBAL] + custom).each { |n| taken[n] = true }
  by = {}   # 用户自己的节点按摘要认（cca 写进来的不算：维护者给节点改了名时按新名字写）
  mine.each { |p| k = key.call(p); by[k] ||= p['name'].to_s if k && !marked[p['name'].to_s] }
  cand = list.call(fill['proxies']).select { |p| p.is_a?(Hash) && !p['name'].to_s.empty? }
  okn = {}
  cand.each { |p| okn[p['name'].to_s] = true unless taken[p['name'].to_s] || by[key.call(p)] }
  add = []   # 要插进去的节点
  upd = []   # cca 以前写进来、参考配置又改过的节点
  fmt = []   # cca 以前写成一行的（内容没变）
  mem = []   # 要在策略组里的名字
  cand.each do |p|
    n = p['name'].to_s
    k = key.call(p)
    dp = p['dialer-proxy']
    if have[n]
      upd << p if marked[n] && have[n] != p
      fmt << p if marked[n] && marked[n][1] && have[n] == p   # 以前写成一行的：改成和别的节点一样的块写法
      mem << n
    elsif taken[n]
      $stderr.puts "cca: 参考节点「#{n}」和这里的策略组（或内置出站、ShellCrash 的自定义节点）重名，没有写"
    elsif k && by[k]
      mem << by[k]
    elsif dp && (!dp.is_a?(String) || (!taken[dp] && !okn[dp]))
      $stderr.puts "cca: 参考节点「#{n}」要经「#{dp}」连接，这里没有它，没有写"
    else
      add << p
      mem << n
    end
  end
  g = list.call(cfg['proxy-groups']).find { |x| x.is_a?(Hash) && x['name'].to_s == fill['group'].to_s }
  g = nil if g && (g['type'].to_s == 'relay' || g['include-all'] == true || g['include-all-proxies'] == true)   # 这样的组不动
  gname = g ? g['name'].to_s : ''
  more = g ? mem.uniq - list.call(g['proxies']).map(&:to_s) : []
  gnote = nil
  unless more.empty?   # 组写成一行（{name: …, proxies: [...]}）之类改不了的：只写节点
    begin
      add_members.call(text, gname, more, mark)
    rescue StandardError
      gnote = "（策略组 #{gname} 不是一行一项的写法，没往组里加 #{more.join('、')}）"
      $stderr.puts "cca: 策略组 #{gname} 不是一行一项的写法，参考节点没往组里加"
      more = []
    end
  end
  said = lambda do |m|
    d = []
    d << "补上节点 #{add.map { |p| p['name'] }.join('、')}" unless add.empty?
    d << "按参考配置更新了节点 #{upd.map { |p| p['name'] }.join('、')}" unless upd.empty?
    d << "策略组 #{gname} 里加上 #{m.join('、')}" unless m.empty?
    d.join('；')
  end
  if opt['--fill-source'] == '-'
    puts "策略组 #{fill['group']} 的 #{cand.size} 个节点"
    puts said.call(more)
    puts gnote.to_s
    exit(add.empty? && upd.empty? && more.empty? ? 2 : 0)
  end
  exit 2 if add.empty? && upd.empty? && more.empty? && fmt.empty?
  rest = lambda do |c, an, m|   # 去掉写进去的之后的样子：写好的读出来，这部分要和原来一模一样
    c.merge('proxies' => list.call(c['proxies']).reject { |p| p.is_a?(Hash) && an.include?(p['name'].to_s) },
            'proxy-groups' => list.call(c['proxy-groups']).map { |x|
              x.is_a?(Hash) && x['name'].to_s == gname ? x.merge('proxies' => list.call(x['proxies']).reject { |n| m.include?(n.to_s) }) : x })
  end
  got = lambda do |c, nodes, m|   # 写进去的节点一个不差（定义原样），名字都在组里
    want = {}
    nodes.each { |p| want[p['name'].to_s] = p }
    px = list.call(c['proxies']).select { |p| p.is_a?(Hash) && want.key?(p['name'].to_s) }
    gm = list.call((list.call(c['proxy-groups']).find { |x| x.is_a?(Hash) && x['name'].to_s == gname } || {})['proxies']).map(&:to_s)
    px.size == want.size && px.all? { |p| want[p['name'].to_s] == p } && (m - gm).empty?
  end
  an = (add + upd + fmt).map { |p| p['name'].to_s }
  tries = [more]
  tries << [] unless more.empty? || (add + upd).empty?   # 策略组改不了时退一步：只写节点
  tries.each_with_index do |m, i|
    begin
      ls = text.lines
      (upd + fmt).sort_by { |p| -marked[p['name'].to_s][0] }.each do |p|   # 从后往前换，前面的行号不变
        n = marked[p['name'].to_s][0]
        ls[n...span_end.call(ls, n)] = node_lines.call(p, ls[n][/\A */], ls[n][/\r?\n\z/] || "\n")
      end
      out = add.empty? ? ls.join : insert_lines.call(ls.join, 'proxies', ->(ind, nl) { add.flat_map { |p| node_lines.call(p, ind, nl) } })
      out = add_members.call(out, gname, m, mark) unless m.empty?
      chk = yparse.call(out)
      raise '写好后读出来和预期的不一样' unless chk.is_a?(Hash) && rest.call(chk, an, m) == rest.call(cfg, an, m) && got.call(chk, add + upd + fmt, m)
      File.open(opt['--fill-source'], 'wb') { |f| f.write(out) }
      if opt['--test'] && opt['--test-out']   # 给内核校验的：拿来校验的那份配置里换上（或加上）要写的节点
        if File.expand_path(opt['--test']) == File.expand_path(cfg_file)
          File.open(opt['--test-out'], 'wb') { |f| f.write(out) }
        else
          t = yload.call(opt['--test'])
          t = {} unless t.is_a?(Hash)
          px = list.call(t['proxies']).dup
          (add + upd).each do |p|
            j = px.index { |x| x.is_a?(Hash) && x['name'].to_s == p['name'].to_s }
            if j then px[j] = p else px << p end
          end
          t['proxies'] = px
          File.open(opt['--test-out'], 'w') { |f| f.write(YAML.dump(t)) }
        end
      end
      if add.empty? && upd.empty? && m.empty?   # 只是改了写法：内容没变，不用校验，也不用重启
        puts "把 cca 以前写成一行的节点 #{fmt.map { |p| p['name'] }.join('、')} 改成了和别的节点一样的写法"
        exit 3
      end
      puts said.call(m) + (m == more ? gnote.to_s : "（策略组 #{gname} 没能改，没往组里加 #{more.join('、')}）")
      exit 0
    rescue StandardError => e
      $stderr.puts "cca: 参考节点没能写进配置文件（#{e.message.lines.first.to_s.strip}）#{i + 1 < tries.size ? '，改成只写节点、不动策略组' : ''}"
    end
  end
  exit 1
end

# --mirror 配置文件：OpenClash 启动时钩子刚把参考节点写回它自己的配置（订阅更新整个换掉了），这次的运行配置是按写之前的
# 那份生成的：参考节点照配置文件里的定义换上（或加上），策略组里配置文件有、这里还没有的名字接上，和下次按配置文件生成的一样。
# 读不了配置文件时照常生成端口池，退出码 3（钩子记下要重启才用上）
mirror_failed = false
if opt['--mirror'] && acc['fill'].is_a?(Hash)
  begin
    src = yload.call(opt['--mirror'])
    raise '顶层不是映射' unless src.is_a?(Hash)
    fn = list.call(acc['fill']['proxies']).select { |p| p.is_a?(Hash) }.map { |p| p['name'].to_s }
    px = list.call(cfg['proxies']).dup
    list.call(src['proxies']).each do |p|
      next unless p.is_a?(Hash) && fn.include?(p['name'].to_s)
      i = px.index { |x| x.is_a?(Hash) && x['name'].to_s == p['name'].to_s }
      if i then px[i] = p else px << p end
    end
    cfg['proxies'] = px
    gn = acc['fill']['group'].to_s
    sg = list.call(src['proxy-groups']).find { |x| x.is_a?(Hash) && x['name'].to_s == gn }
    rg = list.call(cfg['proxy-groups']).find { |x| x.is_a?(Hash) && x['name'].to_s == gn }
    if sg && rg
      more = list.call(sg['proxies']).map(&:to_s) - list.call(rg['proxies']).map(&:to_s)
      rg['proxies'] = list.call(rg['proxies']) + more unless more.empty?
    end
  rescue StandardError => e
    $stderr.puts "cca: 读不了 #{opt['--mirror']}（#{e.message.lines.first.to_s.strip}），参考节点这次没写进运行配置"
    mirror_failed = true
  end
end

# --- 端口池 ---
listeners = list.call(cfg['listeners']).reject { |l| ours.call(l, 'cca-') }
groups = list.call(cfg['proxy-groups']).reject { |g| ours.call(g, 'CCA-') }
known = { 'DIRECT' => true, 'REJECT' => true }
names.call(cfg).each { |n| known[n] = true }
if base
  in_base = {}
  names.call(base).each { |n| in_base[n] = true }
  known.keep_if { |n, _| n == 'DIRECT' || n == 'REJECT' || in_base[n] }
end
wanted = list.call(acc['nodes']).map(&:to_s)
members = wanted.select { |n| known[n] }
(wanted - members).each { |n| $stderr.puts "cca: 路由器上没有节点「#{n}」，已从可选列表里跳过" }
assign = {}
list.call(acc['accounts']).each { |a| assign[a['slot'].to_i] = a['node'].to_s }
port_of = lambda { |v| v.to_s.split(':').last.to_i }
if opt['--insert']   # ShellCrash 不用订阅配置里的 port 这些设置，用它自己的（--ports）
  used = opt['--ports'].to_s.split.map(&:to_i)
else
  used = %w[port socks-port mixed-port redir-port tproxy-port].map { |k| cfg[k].to_i }
  used << port_of.call(cfg['external-controller']) << port_of.call((cfg['dns'].is_a?(Hash) ? cfg['dns'] : {})['listen'])
end
listeners.each { |l| used << l['port'].to_i if l.is_a?(Hash) }
slots = []
(1..acc['slots'].to_i).each do |k|
  port = acc['base'].to_i + k
  if used.include?(port)
    $stderr.puts "cca: 端口 #{port} 已被占用，槽位 #{k} 跳过"
    next
  end
  node = assign[k]
  if node && !members.include?(node)
    $stderr.puts "cca: 槽位 #{k} 的节点「#{node}」不可用，该端口改为 REJECT（宁可断开也不换出口）"
    node = nil
  end
  first = node || 'REJECT'
  slots << [k, port, [first] + (members - [first]) + (first == 'REJECT' ? [] : ['REJECT'])]
  used << port
end
new_groups = slots.map { |k, _, order| { 'name' => "CCA-#{k}", 'type' => 'select', 'proxies' => order } }
unless opt['--insert']
  groups.concat(new_groups)
  slots.each do |k, port, _|
    listeners << { 'name' => "cca-#{k}", 'type' => 'mixed', 'port' => port.to_s,
                   'listen' => '0.0.0.0', 'users' => [], 'proxy' => "CCA-#{k}" }
  end
  cfg['proxy-groups'] = groups unless groups.empty? && cfg['proxy-groups'].nil?
  if listeners.empty? then cfg.delete('listeners') else cfg['listeners'] = listeners end
  tmp = "#{cfg_file}.cca.tmp"
  File.open(tmp, 'w') { |f| f.write(YAML.dump(cfg)) }
  File.rename(tmp, cfg_file)
  exit(mirror_failed ? 3 : 0)
end

# --- ShellCrash：订阅配置一个字节不改地复制，只在 proxy-groups、listeners 两段的开头插入端口池（一项一行）---
begin
  if groups.size != list.call(cfg['proxy-groups']).size || listeners.size != list.call(cfg['listeners']).size
    raise '里面已经有 cca 的端口池（CCA- 策略组或 cca- 入站）'
  end
  text = File.read(cfg_file, mode: 'rb').force_encoding('UTF-8')
  new_listeners = slots.map do |k, port, _|
    { 'name' => "cca-#{k}", 'type' => 'mixed', 'port' => port, 'listen' => '0.0.0.0', 'users' => [], 'proxy' => "CCA-#{k}" }
  end
  # 写成 {name: "…"} 的样子：ShellCrash 往策略组里加自定义节点时按 "- name: 组名" 找组，碰不到这几行
  g_lines = new_groups.map { |g| "{name: #{q.call(g['name'])}, type: select, proxies: [#{g['proxies'].map { |m| q.call(m) }.join(', ')}]}" }
  l_lines = new_listeners.map { |l| "{name: #{q.call(l['name'])}, type: mixed, port: #{l['port']}, listen: \"0.0.0.0\", users: [], proxy: #{q.call(l['proxy'])}}" }
  out = insert.call(insert.call(text, 'proxy-groups', g_lines), 'listeners', l_lines)
  tmp = "#{opt['--insert']}.tmp"
  File.open(tmp, 'wb') { |f| f.write(out) }
  # 插好的再读一遍：端口池一项不差、其余的和原来完全一样，才交给 ShellCrash
  chk = yload.call(tmp)
  strip = lambda { |c| c.merge('proxy-groups' => list.call(c['proxy-groups']).reject { |g| ours.call(g, 'CCA-') }, 'listeners' => list.call(c['listeners']).reject { |l| ours.call(l, 'cca-') }) }
  unless chk.is_a?(Hash) && list.call(chk['proxy-groups']).select { |g| ours.call(g, 'CCA-') } == new_groups &&
         list.call(chk['listeners']).select { |l| ours.call(l, 'cca-') } == new_listeners && strip.call(chk) == strip.call(cfg)
    raise '插好后读出来和预期的不一样'
  end
  File.rename(tmp, opt['--insert'])
rescue StandardError => e
  File.delete(tmp) if tmp && File.exist?(tmp)
  $stderr.puts "cca: 没能在订阅配置里插入端口池（#{e.message.lines.first.to_s.strip}）"
  exit 1
end
RB
}

# 一次 SSH 会话完成部署：写入脚本和账号表、装钩子/cron、热加载
router_bundle() {
	local acc
	acc=$(py accounts-json) || return 1
	echo 'set -e'
	echo 'R="${CCA_ROOT:-}"'
	echo 'for c in netstat curl; do command -v "$c" >/dev/null 2>&1 || { echo "路由器缺少命令: $c"; exit 1; }; done'
	echo '[ -d "$R/etc/openclash" ] || [ -f "$R/etc/ShellCrash/start.sh" ] || grep -q "^export CRASHDIR=" "$R/etc/profile" 2>/dev/null || { echo "路由器上没有 OpenClash，也没有 ShellCrash"; exit 1; }'
	# OpenClash 自带 ruby；只装了 ShellCrash 的路由器要先装上
	echo 'ruby -ryaml -e 1 >/dev/null 2>&1 || { echo "路由器上没有 ruby（或缺它的 YAML 库）：在路由器上运行 opkg update && opkg install ruby ruby-yaml"; exit 1; }'
	echo 'mkdir -p "$R/etc/cca"'
	echo "cat > \"\$R/etc/cca/cca-router.sh.new\" <<'CCA_EOF_SH'"; router_sh; echo 'CCA_EOF_SH'
	echo 'chmod 755 "$R/etc/cca/cca-router.sh.new" && mv -f "$R/etc/cca/cca-router.sh.new" "$R/etc/cca/cca-router.sh"'
	echo "cat > \"\$R/etc/cca/apply.rb\" <<'CCA_EOF_RB'"; router_rb; echo 'CCA_EOF_RB'
	echo "cat > \"\$R/etc/cca/accounts.yaml\" <<'CCA_EOF_ACC'"; printf '%s\n' "$acc"; echo 'CCA_EOF_ACC'
	echo "cat > \"\$R/etc/cca/ports\" <<'CCA_EOF_PORTS'"; py ports; echo 'CCA_EOF_PORTS'
	echo "cat > \"\$R/etc/cca/select\" <<'CCA_EOF_SEL'"; py select-lines; echo 'CCA_EOF_SEL'
	echo '"$R/etc/cca/cca-router.sh" install'
	echo '"$R/etc/cca/cca-router.sh" apply'
}
digest() { { router_sh; router_rb; } | py digest; }   # 账号表 + 路由器端代码的摘要（见 cmd_digest）

clash_name() {   # clash_name 路由器的输出：说的是 OpenClash 还是 ShellCrash（路由器端按在用的那套写）
	case "${1:-}" in *ShellCrash*) echo ShellCrash ;; *) echo OpenClash ;; esac
}
# 路由器说"需要重载"（返回 3）时征求同意：重载期间局域网新连接会失败约 20 秒。allow_reload [路由器的说明]：
# 运行配置不见了、配置文件里新写了参考节点时路由器要的是重启 OpenClash / ShellCrash（连接都会断开），问的时候说清楚。
# 这一次运行里说过不的，不再问（同步完启动前还会核对一次）
allow_reload() {
	local name
	[ -n "${CCA_YES:-}" ] && return 0
	[ -z "${RELOAD_NO:-}" ] || return 1
	name=$(clash_name "${1:-}")
	case "${1:-}" in   # 图形界面：记一条 consent 事件（说明是路由器的最后几行），同意后带着 CCA_GRANT 重新运行
		*"只能重启一次 "*) consent router_restart "$name" "需要重启 ${name}" "现在重启 ${name} 吗？" "$(printf '%s\n' "$1" | tail -n 5)" y ;;
		*) consent router_reload "$name" "需要重载 ${name}" "现在重载吗？" "$(printf '%s\n' "${1:-}" | tail -n 5)" y ;;
	esac || { RELOAD_NO=1; return 1; }
}
router_reload() {   # 获准后在路由器上执行带重载的 apply（运行配置不见了时是重启 OpenClash / ShellCrash）
	local out rc
	out=$(rsh "CCA_ALLOW_RELOAD=1 $RDIR/cca-router.sh apply" </dev/null 2>&1); rc=$?
	[ -n "$out" ] && printf '%s\n' "$out" | LC_ALL=C sed 's/^/  │ /' >&2
	return $rc
}

# ---------------------------------------------------------------------------
# 路由器 SSH
# ---------------------------------------------------------------------------
load_router() {   # config.json 里路由器的设置。一条命令里要读好几次：config.json 没换过（同一个文件、大小和修改时间都没变）就不再起 python
	local k out
	if [ "${OSTYPE#darwin}" != "$OSTYPE" ]; then k=$(stat -L -f '%i:%z:%Fm' "$CFG" 2>/dev/null)
	else k=$(stat -L -c '%i:%s:%Y' "$CFG" 2>/dev/null); fi   # GNU / busybox 的 stat（每次保存都是原子替换，inode 必变）
	[ -n "$k" ] && [ "$k" = "${ROUTER_SEEN:-}" ] && return 0
	out=$(py router-env) && ROUTER_SEEN=$k || ROUTER_SEEN=""   # 没读成功的不记
	eval "$out"
}
router_ready() { load_router; [ -n "$ROUTER_HOST" ] && [ -f "$ROUTER_KEY" ]; }
short_host() {   # 这台机器的短名字（密钥的备注里用）：有的 Linux 容器里没有 hostname 命令
	local h
	h=$(hostname -s 2>/dev/null || uname -n 2>/dev/null); h="${h%%.*}"
	printf '%s' "${h:-mac}"
}
SSH_COMMON=(-o StrictHostKeyChecking=accept-new -o LogLevel=ERROR -o ConnectTimeout=6)
rsh() {
	ssh -i "$ROUTER_KEY" -p "$ROUTER_PORT" "${SSH_COMMON[@]}" -o UserKnownHostsFile="$CCA_HOME/known_hosts" \
		-o IdentitiesOnly=yes -o BatchMode=yes -o ServerAliveInterval=15 \
		-o ControlMaster=auto -o ControlPath="$CCA_HOME/cm-%C" -o ControlPersist=60 \
		"$ROUTER_USER@$ROUTER_HOST" "$@"
}
rsh_close() {   # 关掉复用的 SSH 主连接
	ssh -O exit -o ControlPath="$CCA_HOME/cm-%C" -p "$ROUTER_PORT" "$ROUTER_USER@$ROUTER_HOST" >/dev/null 2>&1
}
port_open() {
	if [ "$(uname)" = Darwin ]; then nc -z -G 3 "$1" "$2" >/dev/null 2>&1; else nc -z -w 3 "$1" "$2" >/dev/null 2>&1; fi
}

# 首次用密码登录一次，把公钥写进 dropbear / OpenSSH 的 authorized_keys
REMOTE_ADD_KEY='k=$(cat); add() { mkdir -p "${1%/*}"; touch "$1"; chmod 600 "$1"; grep -qxF "$k" "$1" || echo "$k" >> "$1"; }; [ -d /etc/dropbear ] && add /etc/dropbear/authorized_keys; add "$HOME/.ssh/authorized_keys"; chmod 700 "$HOME/.ssh"; echo ok'

cmd_router_setup() {
	need_tty
	load_router
	local host="" user port key i list="" nd bad="" msg
	if [ -n "$PROMPT_GUI" ]; then
		router_form || return 1
		host=$F_host user=$F_user port=$F_port
	elif [ -n "$ROUTER_HOST" ]; then
		host=$(ask "路由器地址 [${ROUTER_HOST}]: " "$ROUTER_HOST")
	else
		for i in 1 2 3; do
			host=$(ask "装了 OpenClash 或 ShellCrash 的路由器地址（例如 192.168.1.2）: " "")
			[ -n "$host" ] && break
		done
		[ -n "$host" ] || die "需要路由器地址"
	fi
	if [ -z "$PROMPT_GUI" ]; then
		user=$(ask "SSH 用户 [${ROUTER_USER:-root}]: " "${ROUTER_USER:-root}")
		port=$(ask "SSH 端口 [${ROUTER_PORT:-22}]: " "${ROUTER_PORT:-22}")
	fi
	key="$CCA_HOME/router_ed25519"
	[ -f "$key" ] || ssh-keygen -q -t ed25519 -N '' -C "cca@$(short_host)" -f "$key" || die "生成 SSH 密钥失败"
	ROUTER_HOST=$host ROUTER_USER=$user ROUTER_PORT=$port ROUTER_KEY=$key   # 先在内存里换上试连，登录成功才写进 config.json：配错了不盖掉原来能用的
	if rsh true 2>/dev/null; then
		info "已能用密钥登录 $user@$host"
	else
		info "需要输入一次 $user@$host 的密码来安装 SSH 公钥（密码不会被保存）"
		router_key_install "$user" "$host" "$port" "$key" || return 1
		rsh true || die "公钥已写入，但密钥登录仍然失败"
		info "密钥登录成功，之后免密"
	fi
	py router-set "$host" "$port" "$user" "$key" || die "保存路由器配置失败"
	ROUTER_SEEN=""
	load_router
	# 账号表现在有错误时先别同步（同步前会校验，过不去就走不到下面）：例如维护者的映射要的节点不在可选节点里，
	# cca edit 改不了，只能在这里重新选可选节点。只是路由器上的节点改了名的话，先跟上就好了
	py validate all >/dev/null 2>&1 || nodes_follow || true
	if py validate all >/dev/null 2>&1; then
		router_sync
		case $? in
			0|3) ;;
			*) gui_fail sync_failed "同步路由器没有成功（详情里有路由器说的原因）"; return 1 ;;
		esac
	else
		bad=1
	fi
	while IFS= read -r nd; do list="${list:+${list}、}${nd}"; done < <(py nodes-allowed | cut -f1)
	if [ -n "$PROMPT_GUI" ]; then   # App 里直接显示可选节点（现在的预先选好），不用先问一句要不要重新选
		msg=""
		[ -z "$bad" ] || msg="账号表现在有错误，先重新选可选节点：$(py validate all 2>&1 | head -n 3 | tr '\n' ' ')"
		pick_allowed_nodes "$msg" || return 1
		nd=""
		while IFS= read -r i; do nd="${nd:+${nd}、}${i}"; done < <(py nodes-allowed | cut -f1)
		if { [ "$nd" != "$list" ] || [ -n "$bad" ]; } && [ -n "$list" ] && [ -n "$(py keys)" ]; then
			router_sync
			case $? in
				0|3) ;;
				*) fail_warn sync_failed "可选节点已经保存，同步路由器没有成功：修好后运行 cca router sync" ;;
			esac
		fi
		gui_done router_ready "路由器配置好了：${user}@${host}，可选节点 ${nd}"
		return 0
	fi
	if [ -z "$list" ]; then
		pick_allowed_nodes || return 1
	elif [ -n "$bad" ] || confirm "账号可选的出口节点：${list}。要重新选吗？" n; then
		[ -z "$bad" ] || { py validate all; warn "账号表现在有错误（见上面），先重新选可选节点：账号可选的出口节点现在是 ${list}"; }
		pick_allowed_nodes || return 1
		[ -z "$(py keys)" ] || router_sync   # 可选节点变了要重建端口池（需要重载，会先问）
	fi
	return 0
}

router_form() {   # 提问会话：地址、用户、端口一页，连不上的带着原因重问。结果在 F_host F_user F_port
	local err=""
	F_host=$ROUTER_HOST F_user=${ROUTER_USER:-root} F_port=${ROUTER_PORT:-22}
	while :; do
		ask_fields router.basic "配置路由器" "${ROUTER_FORM_WHY:-装了 OpenClash 或 ShellCrash 的路由器。cca 经 SSH 把账号的端口池同步上去。}" \
			"host|text|host||路由器地址|例如 192.168.1.2|${F_host}|${err}" \
			"user|text|sshuser||SSH 用户||${F_user}" \
			"port|text|port||SSH 端口||${F_port}" || return 1
		port_open "$F_host" "$F_port" && return 0
		err="连不上 ${F_host}:${F_port}：路由器开着吗？地址和端口对吗？（不在家里的网络时也连不上）"
	done
}

router_key_install() {   # router_key_install 用户 地址 端口 密钥路径：用密码登录一次，把公钥装到路由器上。终端里 ssh 自己问密码；App 里在表单里输入
	local user="$1" host="$2" port="$3" key="$4" pw err="" out
	if [ -z "$PROMPT_GUI" ]; then
		ssh -p "$port" "${SSH_COMMON[@]}" -o UserKnownHostsFile="$CCA_HOME/known_hosts" \
			-o PubkeyAuthentication=no -o PreferredAuthentications=keyboard-interactive,password \
			"$user@$host" "$REMOTE_ADD_KEY" < "$key.pub" >/dev/null || die "安装公钥失败"
		return 0
	fi
	while :; do
		pw=$(ask_secret "${user}@${host} 的密码" q=router.password "title=登录路由器" \
			"message=用密码登录一次，把 cca 的 SSH 公钥装到 ${host} 上，之后就不用密码了。密码只用这一次，不保存。" label=密码 "error=$err") || return 1
		if out=$(router_ssh_password "$user" "$host" "$port" "$key" "$pw"); then pw=""; return 0; fi
		pw=""
		case "$out" in
			*"Permission denied"*) err="密码不对，再试一次" ;;
			*) FAIL_CODE=sync_failed die "安装公钥失败：$(printf '%s' "$out" | tail -n 1)" ;;
		esac
	done
}

# 用 App 里输入的密码跑一次 ssh。密码不进命令行和环境变量：ssh 经 SSH_ASKPASS 取，取的是私有目录（700）里的一个 FIFO，
# 写的一方是 bash 内建的 printf（子 shell，没有新的进程映像）。askpass 读完就删掉 FIFO，ssh 再问时读不到东西，不会卡住。stdout：ssh 的报错
router_ssh_password() {
	local user="$1" host="$2" port="$3" key="$4" pw="$5" d w out rc
	d=$(mktemp -d "${TMPDIR:-/tmp}/cca-askpass.XXXXXX") || return 1
	if ! mkfifo -m 600 "$d/pw"; then rm -rf "$d"; return 1; fi
	cat > "$d/ask" <<'ASK'
#!/bin/sh
f="${0%/*}/pw"
[ -p "$f" ] || exit 1
cat "$f"
rm -f "$f"
ASK
	chmod 700 "$d/ask"
	( printf '%s\n' "$pw" > "$d/pw" ) 2>/dev/null &
	w=$!
	pw=""
	out=$(SSH_ASKPASS="$d/ask" SSH_ASKPASS_REQUIRE=force ssh -p "$port" "${SSH_COMMON[@]}" -o UserKnownHostsFile="$CCA_HOME/known_hosts" \
		-o PubkeyAuthentication=no -o PreferredAuthentications=keyboard-interactive,password -o NumberOfPasswordPrompts=1 \
		"$user@$host" "$REMOTE_ADD_KEY" < "$key.pub" 2>&1 >/dev/null); rc=$?
	kill "$w" 2>/dev/null
	wait "$w" 2>/dev/null
	rm -rf "$d"
	printf '%s' "$out"
	return $rc
}

pick_allowed_nodes() {   # 从路由器的节点里选出账号可以用的出口，存进 config.json 的 nodes（同时记下各节点的服务器地址摘要）。
	                      # pick_allowed_nodes [给图形界面的说明]
	local -a all picked
	local n=0 i nd sel w tries=0 list="" raw
	raw=$(router_node_list 2>/dev/null)
	while IFS= read -r nd; do [ -n "$nd" ] && { all[n]="$nd"; n=$((n + 1)); }; done < <(printf '%s\n' "$raw" | awk -F '\t' '$1 == "P" { print $2 }')
	[ $n -gt 0 ] || { fail_warn node_missing "没从路由器读到节点（路由器上的 OpenClash / ShellCrash 导入过配置了吗？）"; return 1; }
	if [ -n "$PROMPT_GUI" ]; then
		pick_nodes_form "${1:-}" || return 1
		for nd in "${picked[@]}"; do list="${list:+${list}、}${nd}"; done
		okay "账号可选的出口节点：${list}"
		return 0
	fi
	say ""
	say "  选出允许账号使用的出口节点（之后每个账号从这些里面挑一个）："
	say ""
	for ((i = 0; i < n; i++)); do say "    $((i + 1)). ${all[i]}"; done
	say ""
	while [ $tries -lt 5 ]; do
		tries=$((tries + 1))
		sel=$(ask "  输入编号，用空格分隔（例如 1 3 4）：" "" | sed 's/,/ /g; s/，/ /g; s/、/ /g')
		picked=()
		for w in $sel; do
			case "$w" in *[!0-9]*) warn "「${w}」不是编号"; continue 2 ;; esac
			if [ "$w" -lt 1 ] || [ "$w" -gt $n ]; then warn "没有编号 ${w}"; continue 2; fi
			picked[${#picked[@]}]="${all[w - 1]}"
		done
		[ ${#picked[@]} -gt 0 ] || { warn "至少选一个"; continue; }
		py set-nodes "${picked[@]}" || return 1
		printf '%s\n' "$raw" | py nodes-follow >/dev/null   # 记下各可选节点的摘要：以后在路由器上改了名也认得出
		for nd in "${picked[@]}"; do list="${list:+${list}、}${nd}"; done
		okay "账号可选的出口节点：${list}"
		return 0
	done
	return 1
}

pick_nodes_form() {   # pick_allowed_nodes 在提问会话里的那一页（用它的 all、n、raw、picked）：现在的预先选好，还有账号在用的不能去掉
	local msg="${1:-之后每个账号从这些节点里挑一个出口，最好一个账号一个节点。}" cur err="" sel w i lost
	local -a opts
	for ((i = 0; i < n; i++)); do opts[i]="opt=$((i + 1))"$'\t'"${all[i]}"$'\t'; done
	cur=$(py nodes-preselect "${all[@]}")
	while :; do
		sel=$(gui_ask multi "可选的出口节点" "$cur" q=router.nodes "title=选择账号可用的出口节点" "message=$msg" label=出口节点 min=1 "error=$err" "${opts[@]}") || return 1
		picked=()
		for w in $sel; do
			case "$w" in *[!0-9]*) continue ;; esac
			[ "$w" -ge 1 ] && [ "$w" -le $n ] && picked[${#picked[@]}]="${all[w - 1]}"
		done
		if [ ${#picked[@]} -eq 0 ]; then err="至少选一个"; continue; fi
		lost=$(py nodes-lost "${picked[@]}")
		[ -z "$lost" ] && break
		err="这些节点还有账号在用，不能去掉：${lost}。先在账号表里给它们换个节点"
		cur=$sel
	done
	py set-nodes "${picked[@]}" || return 1
	printf '%s\n' "$raw" | py nodes-follow >/dev/null   # 记下各可选节点的摘要：以后在路由器上改了名也认得出
}

router_node_list() {   # 路由器上的节点（P<TAB>名字<TAB>类型<TAB>服务器<TAB>端口）：拿这一版的路由器脚本现跑，不依赖路由器上部署的版本。
	                    # 后面接上维护者参考配置里、路由器上还没有的节点（同步时补上，先就能选）
	local out
	out=$(router_sh | rsh 'sh -s nodes') || return 1
	printf '%s\n' "$out" | py nodes-fill
}
nodes_follow() {   # 路由器上的节点改了名：按服务器地址认出来，可选节点和各工具的账号表跟着改；认不出、又有账号在用的，
	                # 交互时让用户从路由器上的节点里选一个代替。有改动返回 0
	local list out kind old who changed=1 i
	local -a lost=() users=()
	router_ready || return 1
	list=$(router_node_list 2>/dev/null) || return 1
	out=$(printf '%s\n' "$list" | py nodes-follow) || return 1
	while IFS=$'\t' read -r kind old who; do
		case "$kind" in
			R) changed=0 ;;
			L) lost[${#lost[@]}]="$old"; users[${#users[@]}]="$who" ;;
		esac
	done <<< "$out"
	# 认不出的到循环外面再问：循环里 fd 0 是 here-string，interactive 会把真实的终端也当成非交互
	for ((i = 0; i < ${#lost[@]}; i++)); do
		node_replace "$list" "${lost[i]}" "${users[i]}" && changed=0
	done
	return $changed
}
node_replace() {   # node_replace 节点列表 旧节点 用它的账号：旧节点在路由器上找不到了（也认不出改成了哪个），交互时选一个代替
	local list="$1" old="$2" who="$3" n=0 i w nd tries
	local -a all opts
	if ! interactive; then
		warn "路由器上找不到节点「${old}」了（也认不出它改成了哪个）：${who} 暂时用不了。在终端里运行 cca router sync 选一个节点代替它"
		TOOL=claude gui_terminal router_sync "路由器上找不到节点「${old}」了：在终端里运行 cca router sync 选一个节点代替它" router sync
		return 1
	fi
	while IFS= read -r nd; do [ -n "$nd" ] && { all[n]="$nd"; n=$((n + 1)); }; done < <(printf '%s\n' "$list" | awk -F '\t' '$1 == "P" { print $2 }')
	[ $n -gt 0 ] || return 1
	if [ -n "$PROMPT_GUI" ]; then
		for ((i = 0; i < n; i++)); do opts[i]="opt=$((i + 1))"$'\t'"${all[i]}"$'\t'; done
		w=$(gui_ask choice "换成哪个节点" "" q=node.replace "title=节点不见了" "label=换成" optional=1 "skip=先不换，这些账号暂时用不了" \
			"message=路由器上找不到节点「${old}」了（也认不出它改成了哪个），${who} 在用它。" "${opts[@]}") || return 1
		case "$w" in ''|*[!0-9]*) return 1 ;; esac
		[ "$w" -ge 1 ] && [ "$w" -le $n ] || return 1
	else
		say ""
		say "  路由器上找不到节点「${old}」了（也认不出它改成了哪个），${who} 在用它。换成哪个节点？"
		for ((i = 0; i < n; i++)); do say "    $((i + 1)). ${all[i]}"; done
		say ""
		for tries in 1 2 3 4 5; do
			w=$(ask "  输入编号（直接回车先不换，这些账号暂时用不了）：" "")
			[ -n "$w" ] || return 1
			case "$w" in *[!0-9]*) warn "「${w}」不是编号"; w=""; continue ;; esac
			[ "$w" -ge 1 ] && [ "$w" -le $n ] && break
			warn "没有编号 ${w}"
			w=""
		done
		[ -n "$w" ] || return 1
	fi
	nd="${all[w - 1]}"
	printf '%s\n' "$list" | py nodes-rename "$old" "$nd" || return 1
	okay "「${old}」换成了「${nd}」：${who} 改走它"
	return 0
}

router_sync() {   # 先跟上路由器上节点的改名，再同步。0 成功；3 需要重载但没获同意（账号表已上传，端口池等下次）；1 失败
	router_ready || { warn "还没配置路由器（cca router setup）"; return 1; }
	nodes_follow
	router_push
}
edit_hint() {   # 各工具改账号表的命令（用着 Antigravity 时才提它）
	printf 'Claude 账号用 cca edit，Codex 账号用 cca codex edit'
	[ ! -f "$CCA_HOME/agy.json" ] || printf '，Antigravity 账号用 cca agy edit'
}
router_push() {   # 把账号表和路由器端脚本部署到路由器（返回值同 router_sync）
	local out rc bundle
	router_ready || { warn "还没配置路由器（cca router setup）"; return 1; }
	py validate all || { warn "账号表有错误，先修正（$(edit_hint)）"; return 1; }
	bundle=$(router_bundle) || { warn "生成路由器部署内容失败"; return 1; }
	info "正在同步账号到路由器 ${ROUTER_HOST} …"
	out=$(printf '%s\n' "$bundle" | rsh 'sh -s' 2>&1); rc=$?
	[ -n "$out" ] && printf '%s\n' "$out" | LC_ALL=C sed 's/^/  │ /' >&2
	if [ $rc -eq 3 ]; then
		if allow_reload "$out"; then
			router_reload; rc=$?
		else
			case "$out" in *"只能重启一次 "*) warn "没有重启：这次的改动要等 $(clash_name "$out") 下次重启（或再运行 cca router sync）才生效" ;;
				*) warn "没有重载：这次的改动要等 $(clash_name "$out") 下次重启（或再运行 cca router sync）才生效" ;; esac
			return 3
		fi
	fi
	[ $rc -eq 0 ] || { warn "路由器端执行失败"; return 1; }
	py set synced "$(digest)"
	verify_ports "" all
}

verify_ports() {   # verify_ports [127.0.0.1] [all]：各账号的出口端口通不通（默认看路由器上的，给了 127.0.0.1 看本机 Clash 的；
	                  # all 时不分工具，否则只看当前工具的账号）
	local k p rc=0 host="${1:-}" what="出口端口"
	if [ -n "$host" ]; then what="本机端口"; else load_router; host="$PROXY_HOST"; fi
	while IFS=$'\t' read -r k p; do
		[ -n "$p" ] || continue
		if port_open "$host" "$p"; then okay "${k} 的${what} ${p} 已就绪"; else warn "${k} 的${what} ${p} 不通"; rc=1; fi
	done < <(py ports named "${2:-}")
	return $rc
}

router_sync_soon() {   # 增删改账号后同步到路由器；在外面连不上路由器时，等回家后的下次启动（摘要对不上会自动补同步）
	# 没配置路由器、只用本机的客户端（服务器上 cca 内置的代理）：没有路由器要同步（和 sync_if_changed 一样），本机的端口池启动时配好
	if ! router_ready && [ -n "$LOCAL_SET" ]; then return 0; fi
	if router_ready && ! at_home; then
		info "现在连不上路由器 ${ROUTER_HOST}：回到家里的网络后，下次启动 cca 时会自动同步"
		return 0
	fi
	router_sync
}

cmd_router() {
	case "${1:-status}" in
		setup) cmd_router_setup ;;
		sync) [ "${2:-}" = -y ] && CCA_YES=1; router_sync ;;
		status) router_ready || die "还没配置路由器（cca router setup）"; rsh "$RDIR/cca-router.sh status" ;;
		nodes) router_ready || die "还没配置路由器（cca router setup）"; router_node_list | awk -F '\t' '$1 != "C" { print $2 }' ;;   # C 是 ShellCrash 的自定义节点，不能当出口
		log) router_ready || die "还没配置路由器（cca router setup）"; rsh 'tail -n 50 "${CCA_ROOT:-}/tmp/cca-router.log"' ;;
		ssh)
			router_ready || die "还没配置路由器（cca router setup）"
			exec ssh -t -i "$ROUTER_KEY" -p "$ROUTER_PORT" "${SSH_COMMON[@]}" -o UserKnownHostsFile="$CCA_HOME/known_hosts" \
				-o IdentitiesOnly=yes "$ROUTER_USER@$ROUTER_HOST" ;;
		uninstall)
			router_ready || die "还没配置路由器（cca router setup）"
			need_tty
			confirm "从路由器移除 cca（钩子、cron、端口池、/etc/cca、SSH 公钥）？立即移除端口池要让 OpenClash / ShellCrash 重载一次（约 20 秒）" n || return 0
			rsh "CCA_ALLOW_RELOAD=1 $RDIR/cca-router.sh uninstall" < "$ROUTER_KEY.pub" ;;
		*) die "用法: cca router setup|sync|status|nodes|log|ssh|uninstall" ;;
	esac
}

