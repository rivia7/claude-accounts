def login_hint_url(key, url):
    """打开的登录地址（OAuth authorize）没带 login_hint 时补上账号邮箱，登录页就会预填它。claude auth login --email
    自己会带，会话里执行 /login 时不带；codex、agy 生成的登录网址都不带（OpenAI 的登录页不认的话只是忽略它；Google 的
    登录页按它选好账号）。"""
    from urllib.parse import urlsplit, urlunsplit, parse_qsl, urlencode
    e = parse_key(key)[1]
    u = urlsplit(url)
    if (e and u.scheme == 'https' and u.path.endswith(tuple(T.login_paths))
            and u.hostname in T.login_hosts
            and 'login_hint' not in dict(parse_qsl(u.query, keep_blank_values=True))):
        url = urlunsplit(u._replace(query=(u.query + '&' if u.query else '') + urlencode({'login_hint': e})))
    return url


