def api_host(v):
    """接口地址的域名：菜单里显示它；钥匙串里的 key 也按它存取（换了服务商，旧 key 不会被发过去）"""
    from urllib.parse import urlsplit
    u = api_url(v)
    try:
        return urlsplit(u).hostname or u
    except ValueError:
        return u


def secret_ok(s):
    return isinstance(s, str) and bool(SECRET_RE.match(s))


REF_ACCT = 'reference'   # 官方账号记下备查的 API key 在钥匙串里的账户名（服务名是 T.kc_ref_prefix + 账号目录名）


def key_hint(s):
    """给人看的 key 掩码（App 里默认显示它，config.json 的 key_hints 里存的也是它）：开头 8 个字符里最后一个 - 以前的前缀
    （sk-ant-、sk-proj-）+ … + 最后 4 个字符；短于 24 个字符的不给（露出的比例太大），是空字符串"""
    if not secret_ok(s) or len(s) < 24:
        return ''
    return s[:s[:8].rfind('-') + 1] + '…' + s[-4:]


def model_ok(m):
    return isinstance(m, str) and bool(MODEL_RE.match(m))


def parse_key(key):
    """账号表的键 → (别名, 邮箱)。键可以是「别名(邮箱)」、只写邮箱，或只写别名（登录页不预填邮箱）"""
    m = PAIR_RE.match(key)
    if m and EMAIL_RE.match(m.group(2)):
        return m.group(1), m.group(2)
    return ('', key) if EMAIL_RE.match(key) else (key, '')


def name_of(key):
    """菜单和提示里的短名字：有别名用别名，否则用邮箱"""
    a, e = parse_key(key)
    return a or e


def label_of(key):
    a, e = parse_key(key)
    return '%s（%s）' % (a, e) if a and e else a or e


def ident(k):
    s = re.sub(r'[^a-z0-9]+', '-', k.lower()).strip('-')[:20].strip('-') or 'acct'
    return '%s-%s' % (s, hashlib.sha1(k.encode('utf-8')).hexdigest()[:6])


def acct_id(key, tool=None):
    # 有邮箱就按邮箱认账号：改别名不换账号目录，登录和浏览器资料都还在；第三方 API 账号按 id 认。
    # 各工具的账号目录在不同的地方（sroot），同一个邮箱的 Claude 账号和 Codex 账号不会撞
    return ident(parse_key(key)[1] or (tool or T).ids.get(key) or key)


def adir(key):
    return os.path.join(T.sroot, 'accounts', acct_id(key))


def cdir(key):
    return os.path.join(adir(key), T.sub)


def url_problem(u, tool=None):
    """第三方 API 的地址有什么问题；没问题返回空字符串"""
    ex = (tool or T).url_example
    from urllib.parse import urlsplit
    import ipaddress
    if not u or re.search(r'[\s\x22\x27\\]', u):
        return 'base_url 不能为空，也不能有空格或引号'
    try:
        p = urlsplit(u)
        host = p.hostname or ''
        p.port   # 端口写错时这里抛 ValueError
    except ValueError:
        return 'base_url 不像网址（例如 %s）' % ex
    if p.scheme not in ('http', 'https') or not host:
        return 'base_url 要以 https:// 开头（例如 %s）' % ex
    if p.username or p.password or p.query or p.fragment:
        return 'base_url 里不能带用户名、密码、? 参数或 # 片段'
    if p.scheme == 'http':
        try:
            ip = ipaddress.ip_address(host)
            local = ip.is_private or ip.is_loopback
        except ValueError:
            local = host == 'localhost' or host.endswith('.local')
        if not local:
            return 'base_url 要用 https（http 只能用于本机、局域网地址或 .local，免得 key 明文传出去）'
    return ''


def api_problems(c, k, v, tool=None):
    """第三方 API 账号这一项的问题（不带账号名的前缀，不回显 key 的值）"""
    tool = tool or T
    if not tool.has_api:   # agy：只有 Google 账号
        return ['%s 没有第三方 API 账号：值只能写节点名' % tool.label]
    errs = []
    if parse_key(k)[1] or ALIAS_BAD.search(k):
        errs.append('第三方 API 账号的键只写别名（不能有邮箱、括号、空格、引号或 @）')
    bad = [f for f in v if f not in tool.api_fields]
    if bad:
        errs.append('不认识的字段 %s（能用的有 %s）' % ('、'.join(bad), '、'.join(tool.api_fields)))
    u = v.get('base_url')
    p = url_problem(u, tool) if isinstance(u, str) else '缺少 base_url（第三方 API 的地址）'
    if p:
        errs.append(p)
    if v.get('model') is not None and not model_ok(v['model']):
        errs.append('model：' + MODEL_MSG)
    node = v.get('node')
    if node not in (None, ''):
        if not isinstance(node, str):
            errs.append('node 应该是节点名，直连写空字符串')
        elif c['nodes'] and node not in c['nodes']:
            errs.append('节点「%s」不在可选列表（%s）' % (node, '、'.join(c['nodes'])))
    env = v.get('env') if 'env' in tool.api_fields else None   # 没有 env 字段的工具：上面已经报过不认识
    if env is not None and not isinstance(env, dict):
        errs.append('env 应该是 {"变量名": "值"} 形式')
    for x, val in (env.items() if isinstance(env, dict) else []):
        if not ENV_NAME_RE.match(x):
            errs.append('env 里的变量名「%s」不合法' % x)
        elif ENV_RESERVED.match(x):
            errs.append('env 里不能设 %s（由 cca 管：地址写 base_url，key 存钥匙串或写 key 字段）' % x)
        elif ENV_SECRETISH.search(x):
            errs.append('env 里不要放密钥（%s）：env 的内容会出现在 claude 的命令行里；key 写 key 字段或存钥匙串' % x)
        if isinstance(val, bool) or not isinstance(val, (str, int, float)) or re.search(r'[\x00\r\n]', str(val)):
            errs.append('env 里 %s 的值应该是一行文字或数字' % x)
    if v.get('key') is not None and not secret_ok(v['key']):
        errs.append(SECRET_MSG)
    i = v.get('id')
    if i is not None and not (isinstance(i, str) and KEY_RE.match(i) and '@' not in i):
        errs.append('id 应该是不含空格、引号和 @ 的一串文字（改别名时别动它）')
    return errs


POLICY_FILE = os.path.join(CCA_HOME, 'policy', 'policy.json')   # 维护者的账号 → 节点映射（bash 的 policy_fetch 验签后才放进来）
POLICY_POLL_INTERVAL = 3600   # App 多久拉一次映射（App 不重算，看 state 的 next_check_epoch）；命令行还是启动时一天一次


def policy_raw(tool):
    """维护者的映射里这个工具的官方账号：{邮箱（小写）: 映射里写的节点}。没配置、读不了、格式不对都当作没有"""
    j = load_quiet(POLICY_FILE)
    s = j.get(tool.name) if isinstance(j, dict) else None
    if not isinstance(s, dict):
        return {}
    return {e.lower(): n for e, n in s.items() if isinstance(e, str) and isinstance(n, str) and n}


def policy_map(tool, c=None):
    """policy_raw，节点换成现在的名字：映射里写的是路由器上改名前的旧名字（cca 跟着改过名，维护者还没更新映射）时
    按记下的改名换算（node_alias），免得账号表被改回旧名字、整张表因为节点不在可选列表而用不了"""
    if c is None:
        c = load_quiet(CFG)
    return {e: node_alias(c, n) for e, n in policy_raw(tool).items()}


def node_alias(c, n):
    """节点名 n 不在可选节点里、又是 cca 跟着改过名的旧名字时，换成现在的名字（可能改过不止一次）"""
    if not isinstance(c, dict):
        return n
    nodes = c.get('nodes') or []
    ren = c.get('node_renames') if isinstance(c.get('node_renames'), dict) else {}
    seen = set()
    while n not in nodes and isinstance(ren.get(n), str) and n not in seen:
        seen.add(n)
        n = ren[n]
    return n


def alias_ok(a):
    return isinstance(a, str) and bool(a) and not ALIAS_BAD.search(a) and dw(a) <= 24


def policy_names():
    """映射里给账号起的别名（可选的 aliases 一节，{"邮箱": "别名"}，各工具通用）：{邮箱（小写）: 别名}。不合规的不用。
    旧版本的 cca 不认识这一节、照样忽略它：加了别名，旧版本也照常拉得到映射"""
    j = load_quiet(POLICY_FILE)
    s = j.get('aliases') if isinstance(j, dict) else None
    if not isinstance(s, dict):
        return {}
    return {e.lower(): a for e, a in s.items() if isinstance(e, str) and alias_ok(a)}


def policy_in_use(tool):
    """这台机器用着这个工具吗：当前的工具，或者已经有它的账号表。映射里的 Codex 账号要到第一次用 cca codex 时
    才加进来，免得不用 Codex 的机器白占路由器上的端口"""
    return tool is T or os.path.exists(tool.table)


def policy_missing(c, t, tool):
    """映射里有、这台机器的账号表里没有的官方账号 [(邮箱, 节点, 不加的原因)]；原因是空的，下一次 ctx 就把它加进来"""
    have = {parse_key(k)[1].lower() for k, v in t.items() if not is_api(v)}
    skip = set(tool.state(c).get('policy_skip') or [])
    out = []
    for e, n in policy_map(tool, c).items():
        if e in have:
            continue
        if not policy_in_use(tool):
            why = '第一次用 %s 时加进来' % tool.cmd
        elif e in skip:
            why = '这台机器上删掉过（要加回来：%s add）' % tool.cmd
        elif not c.get('nodes'):
            why = '这台机器还没有可选节点（运行 cca router setup）'
        elif n not in c['nodes']:
            why = '节点 %s 不在这台机器的可选节点里（运行 cca router setup 选上它）' % n
        elif not KEY_RE.match(e):
            why = '邮箱太长，账号表里放不下'
        else:
            why = ''
        out.append((e, n, why))
    return out


def policy_merge(c, t, tool):
    """维护者的映射和这台机器的账号表合并：映射里有、这台机器上还没有的官方账号加进账号表，返回加进来的键。
    别名用映射里 aliases 写的（和这台机器上别的账号重名时只写邮箱）。这台机器自己的账号（映射里没有的）、
    这台机器上改过的别名都不动；不加的见 policy_missing 的原因（cca policy 里列出来）"""
    names, added = policy_names(), []
    for e, n, why in policy_missing(c, t, tool):
        if why:
            continue
        a = names.get(e, '')
        k = '%s(%s)' % (a, e) if a else e
        if a and (alias_problem(t, a) or not KEY_RE.match(k)):
            k = e
        t[k] = n
        added.append(k)
    return added


def policy_alias_fill(t, tool):
    """映射里的账号在这台机器上还没有别名（键只是邮箱）、映射里给它起了别名：补上，返回 [(旧键, 新键)]。比如先按没写
    别名的映射加进来的账号，维护者后来在 aliases 里补了别名。这台机器上起过别名的不改，别名和这台机器上别的账号重名的
    不补。只改键：账号目录、端口和上次使用都按邮箱认，跟着走（reconcile 里随后的端口分配按 acct_id 找回原来的端口）"""
    pm, names = policy_raw(tool), policy_names()
    ren, used = {}, set()
    for k, v in t.items():
        a, e = parse_key(k)
        al = names.get(e.lower(), '') if e else ''
        if is_api(v) or a or not al or e.lower() not in pm or al in used:
            continue
        new = '%s(%s)' % (al, e)
        if alias_problem(t, al) or not KEY_RE.match(new):
            continue
        ren[k] = new
        used.add(al)
    if ren:   # 原地改（t 是 TABS 里的那张表），顺序不变
        items = [(ren.get(k, k), v) for k, v in t.items()]
        t.clear()
        t.update(items)
    return list(ren.items())


def policy_skip_add(tool, emails):
    """这台机器上删掉的映射里的账号记进 policy_skip：以后不再自动加回来（cca add 加回来时清掉）"""
    c = cfg_load()
    st = tool.state(c, create=True)
    st['policy_skip'] = sorted(set(st.get('policy_skip') or []) | set(emails))
    cfg_save(c)


def table_emails(t):
    """账号表里官方账号的邮箱（小写）"""
    return {parse_key(k)[1].lower() for k, v in t.items() if not is_api(v)} - {''}


def policy_problems(j, strict=False):
    """映射文件的问题：{"version": 1, "claude": {"邮箱": "节点"}, "codex": {…}, "aliases": {"邮箱": "别名"}, "install_node": "节点"}。
    strict（维护者发布前查）时不认识的字段、aliases 里的问题也算：客户端照样忽略它们（不合规的别名不用），免得以后
    加了新东西，旧版本的 cca 就整个不认、拉不到新的节点"""
    if not isinstance(j, dict):
        return ['应该是 JSON 对象，例如 {"version": 1, "claude": {"name@example.com": "节点"}, "codex": {}}']
    names = [tool.name for tool in TOOLS]
    errs = [] if j.get('version') == 1 else ['version 应该是 1']
    for n in names:
        s = j.get(n, {})
        if not isinstance(s, dict):
            errs.append('%s 应该是 {"邮箱": "节点"} 形式的对象' % n)
            continue
        seen = set()
        for e, node in s.items():
            if not EMAIL_RE.match(e):
                errs.append('%s：「%s」不像邮箱' % (n, e))
            if e.lower() in seen:
                errs.append('%s：%s 写了不止一次（邮箱不分大小写）' % (n, e))
            seen.add(e.lower())
            if not isinstance(node, str) or not node.strip():
                errs.append('%s：%s 的节点应该是非空字符串' % (n, e))
    if strict:
        errs += alias_problems(j, names)
        if 'presence' in j:   # 设备统计的服务器（客户端只在完全合格时启用，不合格就当没有）
            errs += presence_problems(j['presence'])
        if 'install_node' in j and not (fill_name_ok(j['install_node']) and j['install_node'] not in FILL_BUILTIN):
            errs.append('install_node 应该是节点的名字（辅助安装直连不通时经内置代理走的节点）')
        errs += ['不认识的字段 %s（只能有 version、%s、aliases、presence、install_node）' % (k, '、'.join(names))
                 for k in j if k not in ('version', 'aliases', 'presence', 'install_node') and k not in names]
    return errs


def alias_problems(j, names):
    """映射里 aliases 一节的问题（维护者发布前查）：邮箱要在映射里，别名要合规，同一个工具里的两个账号不能同名"""
    al = j.get('aliases', {})
    if not isinstance(al, dict):
        return ['aliases 应该是 {"邮箱": "别名"} 形式的对象']
    errs, low = [], {}
    mapped = {e.lower() for n in names if isinstance(j.get(n), dict) for e in j[n]}
    for e, a in al.items():
        if e.lower() not in mapped:
            errs.append('aliases：%s 不在映射里（%s 里都没有这个邮箱）' % (e, '、'.join(names)))
        if e.lower() in low:
            errs.append('aliases：%s 写了不止一次（邮箱不分大小写）' % e)
        low.setdefault(e.lower(), a)
        if not alias_ok(a):
            errs.append('aliases：%s 的别名「%s」不行：不能是空的，不能有空格、引号、括号、反斜杠或 @，最多 12 个汉字或 24 个字母' % (e, a))
    for n in names:
        seen = {}
        for e in (j.get(n) if isinstance(j.get(n), dict) else {}):
            a = low.get(e.lower())
            if alias_ok(a) and a in seen:
                errs.append('aliases：%s 里的 %s 和 %s 起了同一个别名「%s」' % (n, seen[a], e, a))
            elif alias_ok(a):
                seen[a] = e
    return errs


def cmd_policy_request(key):
    """cca [codex] policy request 账号（key 是 bash 经 resolve 找好的）：写一行维护者直接运行的命令（在 cca 的仓库里），把这个账号
    现在的节点锁进映射。不能请求时 stdout 是原因、退出码 2"""
    import shlex
    c, t, _ = ctx()
    e = parse_key(key)[1]
    pinned = policy_map(T, c).get(e.lower()) if e else None
    why = None
    if is_api(t[key]) or not e:
        why = '%s 是第三方 API 账号：映射只管官方账号' % label_of(key)
    elif not c.get('policy'):
        why = '这台机器还没配置维护者的映射：先运行 cca policy setup'
    elif pinned:
        why = '%s 已经按维护者的映射固定在 %s 上了' % (label_of(key), pinned)
    if why:
        print(why)
        sys.exit(2)
    print('./policy.sh lock %s %s %s' % (T.name, shlex.quote(e.lower()), shlex.quote(node_of(t[key]))))


def cmd_policy_lock(action='', path='', tool='', email='', node=''):
    """维护者把账号锁到节点（policy.sh lock）：plan 说明会改什么，apply 写进 policy.json。退出码：0 有要改的（apply 时已改好，
    stdout 是提交说明）；3 已经是这样了；1 参数或映射有问题（原因在 stdout）。命令多半是别人发来的：控制字符、不合规的值不收，
    也不原样显示，免得搅乱维护者的终端"""
    if action not in ('plan', 'apply') or not path:
        die('用法: cca _policy-lock plan|apply policy.json 工具 邮箱 节点')
    names, errs = {tool_.name: tool_.label for tool_ in TOOLS}, []
    if tool not in names:
        errs.append('工具应该是 %s 或 %s' % ('、'.join(list(names)[:-1]), list(names)[-1]))
    if re.search(r'[\x00-\x1f\x7f]', email) or not EMAIL_RE.match(email):
        errs.append('邮箱不对')
    if not fill_name_ok(node):
        errs.append('节点名不对（不能是空的，首尾不能有空格，不能有控制字符，不能以 CCA- 开头）')
    j = load_quiet(path)
    if not errs and (not isinstance(j, dict) or policy_problems(j)):
        errs.append('%s 读不出来，或者格式不对' % path)
    if errs:
        print('\n'.join(errs))
        sys.exit(1)
    s, email = j.setdefault(tool, {}), email.lower()
    key = next((k for k in s if k.lower() == email), email)
    old, head = s.get(key), '  %s  %s' % (names[tool], key)
    if old == node:
        print('%s → %s（已经是这样）' % (head, node))
        sys.exit(3)
    s[key] = node
    lines = ['%s → %s（新加）' % (head, node) if old is None else '%s：%s → %s（换节点）' % (head, old, node)]
    fill = load_quiet(os.path.join(os.path.dirname(path), 'nodes.json'))
    known = {p.get('name') for p in fill.get('proxies') or [] if isinstance(p, dict)} if isinstance(fill, dict) else set()
    if known and node not in known:
        lines.append('  ! 节点 %s 不在参考节点（nodes.json）里：路由器上没有这个节点的机器，这个账号会用不了' % node)
    errs = policy_problems(j, strict=True)
    if errs:
        print('\n'.join(['写进去之后映射的检查不通过：'] + errs))
        sys.exit(1)
    if action == 'plan':
        print('\n'.join(lines))
    else:
        save_json(path, j)
        print('按请求锁定账号的节点：%s → %s' % (key, node))


# --- 维护者参考配置里的节点（映射仓库里的 nodes.json，./policy.sh 从维护者的 custom.yaml 抽出一个策略组和它引用的节点）：
# 直接写进路由器（OpenClash 选用的配置、ShellCrash 的订阅配置）和本机 Clash Verge 当前选用的配置文件，缺的补进 proxies、
# 名字补进同名策略组。两处做法一样：路由器端 apply.rb 的 --fill-source（写配置文件，Clash Verge 的也是拿它在 Mac 上跑）、
# 这里的 fill_plan（合并路由器的节点列表、认 Clash Verge 里的节点时把会写进去的算上）
FILL_FILE = os.path.join(CCA_HOME, 'policy', 'nodes.json')   # bash 的 policy_fetch 验签后才放进来
FILL_BUILTIN = ('DIRECT', 'REJECT', 'REJECT-DROP', 'PASS', 'COMPATIBLE', 'GLOBAL')


def fill_name_ok(n):
    """策略组、节点的名字：不能是空的，首尾不能有空格，不能有控制字符（路由器上按 TAB 分列），不能以 CCA- 开头（cca 自己的组）"""
    return (isinstance(n, str) and 0 < len(n) <= 128 and n == n.strip() and not re.search(r'[\x00-\x1f\x7f]', n)
            and not n.startswith('CCA-'))


def fill_problems(j):
    """参考节点文件的问题：{"version": 1, "group": "策略组", "proxies": [节点定义, …]}（节点定义和 Clash 配置里的一样）。
    客户端和维护者发布前查的是同一套：文件是签过名的，有问题就整个不用"""
    if not isinstance(j, dict):
        return ['应该是 JSON 对象，例如 {"version": 1, "group": "OpenAi", "proxies": [{"name": "节点", "type": "vless", …}]}']
    errs = [] if j.get('version') == 1 else ['version 应该是 1']
    if not fill_name_ok(j.get('group')):
        errs.append('group 应该是策略组的名字（不能是空的，不能有控制字符，不能以 CCA- 开头）')
    px = j.get('proxies')
    if not isinstance(px, list) or not px:
        return errs + ['proxies 应该是节点定义的列表（至少一个）']
    seen = set()
    for i, p in enumerate(px, 1):
        n = p.get('name') if isinstance(p, dict) else None
        where = '第 %d 个节点%s' % (i, '「%s」' % n if isinstance(n, str) else '')
        if not isinstance(p, dict):
            errs.append('%s应该是对象' % where)
            continue
        if not fill_name_ok(n) or n in FILL_BUILTIN:
            errs.append('%s：name 不能是空的，首尾不能有空格，不能有控制字符，不能以 CCA- 开头，也不能是 DIRECT、REJECT 这些内置的名字' % where)
        elif n in seen:
            errs.append('%s：名字重复了' % where)
        seen.add(n)
        if not (isinstance(p.get('type'), str) and re.match(r'^[A-Za-z0-9_-]{1,32}$', p['type'])):
            errs.append('%s：type 不对' % where)
        if not (isinstance(p.get('server'), str) and re.match(r'^[^\s\x00-\x1f\x7f]{1,255}$', p['server'])):
            errs.append('%s：server 不对' % where)
        port = p.get('port')
        if isinstance(port, str) and re.match(r'^\d{1,5}$', port):
            port = int(port)
        if isinstance(port, bool) or not isinstance(port, int) or not 0 < port < 65536:
            errs.append('%s：port 应该是 1–65535' % where)
    return errs


def policy_fill():
    """维护者的参考节点：{'id': 摘要, 'group': 策略组, 'proxies': [节点定义…]}；没有、读不了、格式不对都是 None。
    id 随内容变：路由器按它认这一版有没有在自己的内核上校验过"""
    j = load_quiet(FILL_FILE)
    if fill_problems(j):
        return None
    s = json.dumps([j['group'], j['proxies']], ensure_ascii=False, sort_keys=True)
    return {'id': hashlib.sha256(s.encode('utf-8')).hexdigest()[:16], 'group': j['group'], 'proxies': j['proxies']}


def fill_fp(p):
    return node_fp(p.get('type'), p.get('server'), p.get('port'), p.get('servername') or p.get('sni'))


def fill_plan(have, names, f=MISSING):
    """参考节点怎么补进一份配置：have 是配置里的节点 [(名字, 摘要)]，names 是节点和策略组的全部名字。返回
    (要加的节点定义, 要补进策略组的名字, 策略组名)。同名的节点是用户自己的（只补进组），名字被策略组占了的不补，
    用户已经有同一个节点（摘要一样）只是叫法不同的用他的名字，要经别的节点连接（dialer-proxy）而那个节点没有的不补"""
    f = policy_fill() if f is MISSING else f
    if not f:
        return [], [], ''
    px = {n for n, _ in have}
    by = {}
    for n, g in have:
        if g:
            by.setdefault(g, n)
    taken = set(names) | px | set(FILL_BUILTIN)
    ok = {p['name'] for p in f['proxies'] if p['name'] not in taken and not by.get(fill_fp(p))}
    add, members = [], []
    for p in f['proxies']:
        n, g, dp = p['name'], fill_fp(p), p.get('dialer-proxy')
        if n in px:
            members.append(n)
        elif n in taken:
            continue
        elif g and g in by:
            members.append(by[g])
        elif dp and (not isinstance(dp, str) or (dp not in taken and dp not in ok)):
            continue
        else:
            add.append(p)
            members.append(n)
    return add, list(dict.fromkeys(members)), f['group']


def reconcile(c, t, tool, reserved=()):
    """校验一个工具的账号表；给走节点的账号分配固定端口（直连的第三方 API 账号不占端口），回收已删除账号的端口。
    reserved 是别的工具占着的端口（大家共用一个端口池），不分给这张表。返回错误列表。
    只改了别名的账号按邮箱（第三方 API 账号按 id）认出来：端口和"上次使用"跟着走。
    维护者的映射里有的官方账号，节点和映射不一致时改回映射的节点（写回账号表，说一声）；映射里有、这台机器上还没有的
    加进来（policy_merge，这台机器自己的账号不动），还没有别名的按映射补上别名（policy_alias_fill）：每条命令都经过
    这里，添加、cca edit、启动、同步前都管得到"""
    st = tool.state(c, create=True)
    added = policy_merge(c, t, tool)
    for k in added:
        notice('policy_added', '• 按维护者的映射添加了 %s 账号 %s，出口 %s' % (tool.label, label_of(k), t[k]),
               tool=tool.name, key=k, node=t[k])
    renamed = policy_alias_fill(t, tool)
    for k, new in renamed:
        notice('policy_alias', '• 按维护者的映射给 %s 账号 %s 起了别名 %s' % (tool.label, k, parse_key(new)[0]),
               tool=tool.name, key=new, old_key=k)
    pm = policy_map(tool, c)
    fixed = [k for k, v in t.items() if not is_api(v) and pm.get(parse_key(k)[1].lower(), v) != v]
    for k in fixed:
        want = pm[parse_key(k)[1].lower()]
        notice('policy_pinned', '! %s 的出口按维护者的映射固定为 %s（账号表里写的是 %s，已改回）' % (label_of(k), want, t[k]),
               tool=tool.name, key=k, node=want, old_node=t[k])
        t[k] = want
    if (fixed or added or renamed) and not RO:
        save_json(tool.table, t, 0o600)
    errs = table_problems(c, t, tool, pm)
    # 第三方 API 账号的键 → 账号目录名，记在 config.json：改过不止一次别名也认得出旧的端口和"上次使用"
    known = st.get('api_ids') if isinstance(st.get('api_ids'), dict) else {}
    old = st['ports']
    by_id = {known.get(k) or acct_id(k, tool): p for k, p in old.items()}
    wanted = [k for k, v in t.items() if node_of(v)]
    ports, used = {}, set(reserved)
    for k in wanted:
        p = old.get(k) or by_id.get(acct_id(k, tool))
        if isinstance(p, int) and p not in used:
            ports[k] = p
            used.add(p)
    for k in wanted:
        if k not in ports:
            p = FIRST_PORT
            while p in used:
                p += 1
            ports[k] = p
            used.add(p)
    st['ports'] = ports
    if st.get('last') not in t:
        lid = (known.get(st['last']) or acct_id(st['last'], tool)) if st.get('last') else ''
        st['last'] = next((k for k in t if acct_id(k, tool) == lid), '')
    now = {k: acct_id(k, tool) for k, v in t.items() if is_api(v)}
    if now or known:
        st['api_ids'] = now
    return errs


def table_problems(c, t, tool, pm):
    """账号表的问题（只看，不改）：reconcile、表单都用它"""
    errs, emails, aliases, ids = [], {}, {}, {}
    if not c['nodes'] and any(node_of(v) or not is_api(v) for v in t.values()):
        errs.append('config.json 里还没有可选节点（nodes）：运行 cca router setup 从路由器的节点里选')
    for k, v in t.items():
        if not KEY_RE.match(k):
            errs.append('「%s」：不能含空格、引号或反斜杠，最长 100 个字符' % k)
        a, e = parse_key(k)
        if not e and re.search('[()（）]', k):
            errs.append('「%s」：括号里应该是登录邮箱，例如 主号(name@example.com)' % k)
        if e:
            if e.lower() in emails:
                errs.append('邮箱 %s 同时出现在「%s」和「%s」里' % (e, emails[e.lower()], k))
            emails.setdefault(e.lower(), k)
        if a:
            if a in aliases:
                errs.append('别名「%s」同时用在「%s」和「%s」上' % (a, aliases[a], k))
            aliases.setdefault(a, k)
        if is_api(v):
            errs += ['「%s」：%s' % (k, m) for m in api_problems(c, k, v, tool)]
        elif not isinstance(v, str) or not v:
            errs.append('%s：节点必须是非空字符串' % k)
        elif c['nodes'] and v not in c['nodes']:
            errs.append(('%s：维护者的映射要求它走「%s」，可这个节点不在可选列表（%s）。cca edit 改不了它：'
                          '运行 cca router setup 重新选可选节点（路由器上也没有这个节点的话，请联系维护者）'
                         if e and e.lower() in pm else '%s：节点「%s」不在可选列表（%s）') % (k, v, '、'.join(c['nodes'])))
        i = acct_id(k, tool)
        if i in ids and (is_api(v) or is_api(t[ids[i]])):   # 官方账号的邮箱重复上面已经报过
            errs.append('「%s」和「%s」会用同一个账号目录（id 或邮箱重复了）' % (ids[i], k))
        ids.setdefault(i, k)
    return errs


def policy_nodes_fill(c):
    """维护者的映射要用、还不在可选节点里的节点，是维护者参考配置里的（同步时 cca 把它写进路由器的配置）：自动加进
    可选节点、记下摘要，说一声，映射里的账号随后就能加进来。还没有可选节点（没配置路由器）、这台机器删掉过的账号不算"""
    f = policy_fill()
    if not f or not c.get('nodes'):
        return
    fp = {p['name']: fill_fp(p) for p in f['proxies']}
    want = {}
    for tool in TOOLS:
        if not policy_in_use(tool):
            continue
        skip = set(tool.state(c).get('policy_skip') or [])
        for e, n in policy_map(tool, c).items():
            if n in fp and n not in c['nodes'] and e not in skip:
                want.setdefault(n, []).append(e)
    for n, who in want.items():
        c['nodes'] = c['nodes'] + [n]
        if fp[n]:
            ids = dict(node_ids(c))
            ids[n] = fp[n]
            c['node_ids'] = ids
        notice('nodes_filled', '• 维护者的映射要 %s 走节点 %s：它在维护者的参考配置里（同步时写进路由器的配置），已加进可选节点'
               % ('、'.join(who), n), node=n)


def reconcile_all(c):
    """各工具的账号表一起对账（大家共用一个端口池）：各自已有的端口不动，新端口避开别的工具占着的。
    账号表读不了的工具不对账，它记着的端口照样留着。映射要的参考节点先加进可选节点（policy_nodes_fill）"""
    ERRS.clear()
    policy_nodes_fill(c)
    for tool in TOOLS:
        if tool.name in TABS:
            reserved = {p for o in TOOLS if o is not tool for p in (o.state(c).get('ports') or {}).values()}
            ERRS[tool.name] = reconcile(c, TABS[tool.name], tool, reserved)


def ctx():
    c = cfg_load()
    tables_load()
    reconcile_all(c)
    cfg_clean(c)
    if not RO and c != load_json(CFG, None):
        cfg_save(c)
    return c, TABS[T.name], ERRS.get(T.name, [])


def cfg_clean(c):
    """没有 Codex 账号时不在 config.json 里留下空的 codex 一节：只有 Claude 账号时 config.json 和以前一样"""
    for tool in TOOLS:
        s = c.get(tool.state_key) if tool.state_key else None
        if isinstance(s, dict) and not any(s.get(k) for k in ('ports', 'last', 'api_ids', 'api_keys', 'ref_keys', 'key_hints', 'policy_skip')):
            del c[tool.state_key]


def cfg_save(c):
    cfg_clean(c)
    save_json(CFG, c, 0o600)


ACCT_JSON = {}


def acct_json(key):
    """账号目录里的 .claude.json（一次进程里只读一次）。只读（CCA_RO）时读不了不退出：当作没登录，记进 RO_BAD 给图形界面报"""
    if key not in ACCT_JSON:
        path = os.path.join(cdir(key), '.claude.json')
        if RO:
            j = load_quiet(path)
            if j is None and os.path.exists(path):
                RO_BAD.append((T.name, path))
        else:
            j = load_json(path, {})
        ACCT_JSON[key] = j if isinstance(j, dict) else {}
    return ACCT_JSON[key]


def oauth_of(key):
    oa = acct_json(key).get('oauthAccount')
    return oa if isinstance(oa, dict) else {}


def email_of(key):
    return T.email(key)


POOL_STEP = 8   # 路由器上的端口池按 8 个槽位一档；槽位够用时增删账号、换节点都不用重载 OpenClash / ShellCrash


def pool_size(c):
    slots = [p - FIRST_PORT + 1 for _, _, _, p in pool(c)]
    return max(POOL_STEP, -(-max(slots) // POOL_STEP) * POOL_STEP) if slots else 0


def slot_nodes(c):
    """每个槽位应选中的节点：分给账号的用账号的节点，空槽位用 REJECT"""
    m = {p - FIRST_PORT + 1: node_of(v) for _, _, v, p in pool(c)}
    return [m.get(s, 'REJECT') for s in range(1, pool_size(c) + 1)]


def char_w(ch):
    import unicodedata
    return 2 if unicodedata.east_asian_width(ch) in 'WF' else 1


def dw(s):
    return sum(char_w(ch) for ch in s)


def fit(s, w, pad=True):
    """按终端显示宽度截断/补齐（中文、全角字符算 2 格）；超长时以 … 结尾"""
    total = sum(char_w(ch) for ch in s)
    if total <= w:
        return s + (' ' * (w - total) if pad else '')
    out, n = '', 0
    for ch in s:
        if n + char_w(ch) > w - 1:
            break
        out += ch
        n += char_w(ch)
    return out + '…' + (' ' * (w - n - 1) if pad else '')


def login_code(key):
    """登录状态（只读账号目录，不联网）：logged_in / logged_out / email_mismatch（登录的不是这个账号）"""
    e = email_of(key)
    if not e:
        return 'logged_out'
    want = parse_key(key)[1]
    return 'email_mismatch' if want and e.lower() != want.lower() else 'logged_in'


def short_state(key):
    return {'logged_out': '未登录', 'email_mismatch': '邮箱不符'}.get(login_code(key), '已登录')


def cmd_rows(cols='80'):
    """菜单里每个账号一行：别名、邮箱（第三方 API 账号写接口的域名）、状态、出口节点，官方账号再附上最近一次的
    用量（只读缓存，不联网）；按显示宽度对齐（没有别名的账号别名列留空）"""
    c, t, _ = ctx()
    if not t:
        return
    width = max(int(cols) if str(cols).isdigit() else 80, 40) - 6
    now, rows = time.time(), []
    for k, v in t.items():
        a, e = parse_key(k)
        if is_api(v):
            rows.append((k, a, api_host(v), 'API', node_of(v) or '直连', ''))
        else:
            st = short_state(k)
            rows.append((k, a, e, st, node_of(v), usage_cell(k, now) if st == '已登录' else ''))
    aw = min(max(dw(r[1]) for r in rows), 16)
    ew = min(max(dw(r[2]) for r in rows), 32)
    nw = max(dw(r[4]) for r in rows)
    for k, a, e, state, node, used in rows:
        cells = ([fit(a, aw)] if aw else []) + ([fit(e, ew)] if ew else []) + [fit(state, 8), fit(node, nw)]
        line = '   '.join(cells + ([used] if used else [])).rstrip()
        if k == T.state(c).get('last'):
            line += '   · 上次使用'
        print(fit(line, width, pad=False))


def node_users(t, n):
    """账号表 t 里用这个节点的账号。选节点只看当前工具的：每个账号最好用不同的出口，是免得同一家服务商把几个账号
    关联起来，Claude 账号和 Codex 账号是两家的，共用一个出口不要紧"""
    return [name_of(k) for k, v in t.items() if node_of(v) == n]


def cmd_node_rows(onrouter='', cols='80'):
    """选节点菜单：每个可选节点一行，注明已被当前工具的哪些账号使用、路由器上是否存在"""
    c, t, _ = ctx()
    have = set(onrouter.split('\n')) if onrouter else None
    width = max(int(cols) if str(cols).isdigit() else 80, 40) - 6
    nw = max([dw(n) for n in c['nodes']] + [8])
    for n in c['nodes']:
        notes = []
        users = node_users(t, n)
        if users:
            notes.append('已被 %s 使用' % '、'.join(users))
        if have is not None and n not in have:
            notes.append('路由器上没有这个节点')
        print(fit('%s   %s' % (fit(n, nw), '；'.join(notes)), width, pad=False).rstrip())


def cmd_node_default():
    """默认选中第一个还没被当前工具的账号用的节点（别的工具的账号不算，见 node_users）"""
    c, t, _ = ctx()
    used = {node_of(v) for v in t.values()}
    print(next((i for i, n in enumerate(c['nodes']) if n not in used), 0))


def router_accounts(c):
    """路由器端口池的内容：各工具走节点的账号（直连的第三方 API 账号不占槽位）。有维护者的参考节点时带上 fill：
    路由器生成运行配置时把缺的补上（没有参考节点时和以前逐字节一样）"""
    out = {'base': FIRST_PORT - 1, 'slots': pool_size(c), 'nodes': c['nodes'],
           'accounts': [{'slot': p - FIRST_PORT + 1, 'name': tool.pool_prefix + acct_id(k, tool), 'node': node_of(v)}
                        for tool, k, v, p in pool(c)]}
    f = policy_fill()
    if f:
        out['fill'] = f
    return out


# --- 账号设备标识：先于登录准备，重新登录和改别名都不换 -------------------------
UUID_FIELDS = ('installation_id', 'installation_uuid')   # 写成 UUID 文本的设备标识（Codex、agy）


def device_fields():
    return ('installation_id',) if T is CODEX else UUID_FIELDS if T is AGY else ('userID', 'machineID')


def device_value(name, value):
    import uuid
    if not isinstance(value, str):
        return None
    if name in UUID_FIELDS:
        try:
            return str(uuid.UUID(value.strip()))
        except ValueError:
            return None
    return value if re.fullmatch(r'[0-9a-f]{64}', value) else None


AGY_STATE_ID = lazy_re(r'(?m)^installation_uuid:[ \t]*\x22([^\x22\n]*)\x22[ \t]*$')   # jetski_state.pbtxt 顶层的那一项


def agy_device_files(cd):
    return os.path.join(cd, 'antigravity-cli', 'installation_id'), os.path.join(cd, 'antigravity-cli', 'jetski_state.pbtxt')


def device_native(cd):
    if T is CLAUDE:
        j = load_quiet(os.path.join(cd, '.claude.json'))
        return j if isinstance(j, dict) else {}
    if T is AGY:
        out = {}
        ids, state = agy_device_files(cd)
        try:
            with open(ids, encoding='utf-8') as f:
                out['installation_id'] = f.read().strip()
            with open(state, encoding='utf-8') as f:
                m = AGY_STATE_ID.search(f.read())
            if m:
                out['installation_uuid'] = m.group(1)
        except (OSError, UnicodeError):
            pass
        return out
    try:
        with open(os.path.join(cd, 'installation_id'), encoding='utf-8') as f:
            return {'installation_id': f.read().strip()}
    except (OSError, UnicodeError):
        return {}


def private_file(path):
    # 旧配置可能把设备文件链到共享目录；不能沿用共享值，更不能写穿链接。
    return not os.path.islink(path) and (not os.path.exists(path) or os.stat(path).st_nlink == 1)


def device_identity(key, native):
    """调用方持有 Lock。device.json 是账号的固定标识；首次接管保留合法、独立的客户端旧值。"""
    import uuid
    account = adir(key)
    path = os.path.join(account, 'device.json')
    saved = load_json(path, {})
    if not isinstance(saved, dict) or saved.get('version', 1) != 1:
        die('无法读取账号设备标识：%s' % path)
    own = saved if private_file(path) else {}
    fields = device_fields()
    used = {n: set() for n in fields}
    legacy = {n: set() for n in fields}
    master = load_quiet(MASTER_JSON) if T is CLAUDE else device_native(T.master)
    for n in fields:
        value = device_value(n, master.get(n)) if isinstance(master, dict) else None
        if value:
            used[n].add(value)
    root = os.path.join(T.sroot, 'accounts')
    for name in os.listdir(root):
        other = os.path.join(root, name)
        if other == account or os.path.islink(other) or not os.path.isdir(other):
            continue
        old = device_native(os.path.join(other, T.sub))
        record = os.path.join(other, 'device.json')
        fixed = load_quiet(record)
        isolated = private_file(record)
        # 已由 cca 接管的账号以固定记录为准，客户端暂时删改了字段也不影响其它账号。
        for n in fields:
            value = device_value(n, fixed.get(n)) if isinstance(fixed, dict) else None
            if value and isolated:
                used[n].add(value)
            else:
                if value:
                    legacy[n].add(value)   # 共享记录断开硬链接后会变成普通文件，迁移时就要计入去重
                value = device_value(n, old.get(n))
                if value:
                    legacy[n].add(value)
    identity = {'version': 1}
    for n in fields:
        fixed = device_value(n, own.get(n))
        value = fixed or device_value(n, native.get(n))
        # 未迁移的副本不能迫使已有固定标识的账号换设备；轮到副本首次启动时再为它分配。
        if not value or value in used[n] or (not fixed and value in legacy[n]):
            value = str(uuid.uuid4()) if n in UUID_FIELDS else os.urandom(32).hex()
            while value in used[n] or value in legacy[n]:
                value = str(uuid.uuid4()) if n in UUID_FIELDS else os.urandom(32).hex()
        identity[n] = value
    if identity != saved or not private_file(path):
        save_json(path, identity, 0o600, follow_symlinks=False)
    return identity


def prepare_device(key):
    """调用方持有 Lock；只修复设备字段，保留客户端的登录和其它配置。"""
    cd = cdir(key)
    if os.path.islink(adir(key)) or os.path.islink(cd):
        die('账号目录不能是符号链接，无法隔离设备标识：%s' % cd)
    os.makedirs(cd, exist_ok=True)
    if T is CLAUDE:
        path = os.path.join(cd, '.claude.json')
        native = load_json(path, {})
        if not isinstance(native, dict):
            die('账号配置必须是 JSON 对象：%s' % path)
        paths = [path]
    elif T is AGY:
        paths = list(agy_device_files(cd))
        native = device_native(cd)
    else:
        path = os.path.join(cd, 'installation_id')
        native = device_native(cd)
        paths = [path]
    private = all(private_file(p) for p in paths)
    identity = device_identity(key, native if private else {})
    if not private or any(native.get(n) != identity[n] for n in device_fields()):
        if T is CLAUDE:
            native.update({n: identity[n] for n in device_fields()})
            save_json(path, native, 0o600, follow_symlinks=False)
        elif T is AGY:
            agy_device_write(cd, identity)
        else:
            tmp = '%s.cca-%d.tmp' % (path, os.getpid())
            with open(tmp, 'w', encoding='utf-8') as f:
                f.write(identity['installation_id'] + '\n')
            os.chmod(tmp, 0o600)
            os.replace(tmp, path)


def write_private(path, text):
    """原子替换成只有自己能读写的普通文件（原来是链接、硬链接时不写穿）"""
    tmp = '%s.cca-%d.tmp' % (path, os.getpid())
    with open(tmp, 'w', encoding='utf-8') as f:
        f.write(text)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def agy_device_write(cd, identity):
    """agy 的两份设备标识：installation_id 只能是 36 个字符（带换行它认不出，会换成新的，1.5.5 实测）；jetski_state.pbtxt
    只换（没有就加上）顶层的 installation_uuid 那一行，别的原样留着（没有这个文件时只写这一行，agy 照样读、补上别的）"""
    ids, state = agy_device_files(cd)
    os.makedirs(os.path.dirname(ids), exist_ok=True)
    write_private(ids, identity['installation_id'])
    try:
        with open(state, encoding='utf-8') as f:
            text = f.read()
    except FileNotFoundError:
        text = ''
    line = 'installation_uuid:  \x22%s\x22' % identity['installation_uuid']
    if AGY_STATE_ID.search(text):
        text = AGY_STATE_ID.sub(lambda m: line, text, count=1)
    else:
        text += ('' if not text or text.endswith('\n') else '\n') + line + '\n'
    write_private(state, text)


