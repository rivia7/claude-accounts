def cmd_local_script(path, action='install'):
    """Clash Verge 全局扩展脚本里 cca 的那一段：install 写入或更新，remove 删掉（删后和原文件逐字节一致）。
    内容没变就不写。main 是 const/let 定义的（包不住）时返回 3"""
    try:
        with open(path, encoding='utf-8') as f:
            old = f.read()
    except FileNotFoundError:
        old = ''
    base = LOCAL_BLOCK.sub('', old)
    new = base
    if action == 'install':
        if re.search(r'\b(?:const|let)\s+main\b', base):
            sys.exit(3)
        bk = os.path.join(CCA_HOME, 'backup', 'clash-verge-Script.js')
        if old and old == base and not os.path.exists(bk):   # 第一次加之前留一份原样
            os.makedirs(os.path.dirname(bk), exist_ok=True)
            shutil.copyfile(path, bk)
        if not base.strip():
            base = VERGE_SCRIPT
        c, t, _ = ctx()
        pool = json.dumps([list(x) for x in slot_orders(c, t)], ensure_ascii=False)
        new = base + ('' if base.endswith('\n') else '\n') + '\n' + LOCAL_JS.replace('@POOL@', pool) + '\n'
    if new != old:
        write_text(path, new)


YAML_KEY = re.compile(r'^([A-Za-z0-9_][A-Za-z0-9_.-]*):(?:[ \t]+(.*?))?[ \t]*$')


def yaml_sections(lines):
    """顶层键 → [起始行, 结束行)。只认 serde_yaml 那样的块写法：顶层键顶格写，列表条目也从第 0 列的 "- " 开始"""
    secs, cur = {}, None
    for i, line in enumerate(lines):
        if YAML_KEY.match(line):
            if cur:
                secs[cur][1] = i
            cur = YAML_KEY.match(line).group(1)
            secs[cur] = [i, len(lines)]
    return secs


def yaml_unquote(v):
    # 引号写成 \x22 / \x27：这段 Python 嵌在 bash 的 $(…) 里，macOS 的 bash 3.2 会数引号，落单的引号会让它认错结尾
    v = v.strip()
    if v.startswith('\x22'):
        try:
            return json.loads(v)
        except ValueError:
            return v.strip('\x22')
    if v.startswith('\x27'):
        return v[1:-1].replace('\x27\x27', '\x27')
    return v


def yaml_items(lines, sec):
    """块列表里的条目 [[起, 止, name]]：`- name: X` 加缩进的续行，或一行的 `- {name: X, …}`"""
    items = []
    for i in range(sec[0] + 1, sec[1]):
        if lines[i].startswith('- ') or lines[i] == '-':
            items.append([i, i + 1, None])
        elif items and (lines[i].startswith(' ') or not lines[i].strip()):
            items[-1][1] = i + 1
    for it in items:
        first = lines[it[0]][2:].strip()
        if first.startswith('{'):
            m = re.search(r'(?:^|[{,])\s*[\x22\x27]?name[\x22\x27]?\s*:\s*(\x22(?:[^\x22\\]|\\.)*\x22|\x27(?:[^\x27]|\x27\x27)*\x27|[^,}]*)', first)
            it[2] = yaml_unquote(m.group(1)) if m else None
            continue
        for j in range(it[0], it[1]):   # 条目自己的键：第一行 "- " 后面，或正好缩进两格的续行
            line = lines[j]
            if j == it[0] or (line.startswith('  ') and line[2:3] not in (' ', '-')):
                m = re.match(r'name:\s*(.*)$', line[2:])
                if m:
                    it[2] = yaml_unquote(m.group(1))
                    break
    return items


def yaml_names(lines, secs):
    return {n for k in ('proxies', 'proxy-groups') if k in secs for _, _, n in yaml_items(lines, secs[k]) if n}


def cmd_local_patch(path, mode='install'):
    """给 PUT /configs 用的 JSON：Clash Verge 当前的运行配置加上端口池（mode=remove 时去掉）。
    只动 proxy-groups 和 listeners 里 cca 的条目，其余逐字保留；看不懂格式时返回 1"""
    c, t, _ = ctx()
    try:
        with open(path, encoding='utf-8') as f:
            lines = f.read().split('\n')
    except OSError:
        sys.exit(1)
    secs = yaml_sections(lines)
    if 'proxies' not in secs and 'proxy-providers' not in secs:
        sys.exit(1)
    have = yaml_names(lines, secs)
    add = {'proxy-groups': [], 'listeners': []}
    if mode != 'remove':
        for g, p, order in slot_orders(c, t):
            add['proxy-groups'].append('- ' + json.dumps({'name': g, 'type': 'select', 'proxies': local_members(order, have)},
                                                         ensure_ascii=False))
            add['listeners'].append('- ' + json.dumps({'name': g.lower(), 'type': 'mixed', 'listen': '127.0.0.1', 'port': p,
                                                       'users': [], 'proxy': g}))
    ours = {'proxy-groups': re.compile(r'CCA-\d+$'), 'listeners': re.compile(r'cca-\d+$')}
    tail = []
    for key in sorted(ours, key=lambda k: -secs.get(k, [-1])[0]):   # 从后往前改，前面段落的行号不受影响
        if key not in secs:
            tail += [key + ':'] + add[key] if add[key] else []
            continue
        s, e = secs[key]
        if (YAML_KEY.match(lines[s]).group(2) or '') not in ('', '[]', 'null', '~'):
            sys.exit(1)   # 行内写法的非空列表，不去改它
        # 重建这一段：去掉 cca 原来的条目，新的接在最后（和全局扩展脚本 push 到末尾一致），段尾的空行留在最后
        starts = {a: (b, n) for a, b, n in yaml_items(lines, secs[key])}
        new, i = [key + ':'], s + 1
        while i < e:
            if i in starts:
                b, n = starts[i]
                if not (n and ours[key].match(n)):
                    new += lines[i:b]
                i = b
            else:
                new.append(lines[i])
                i += 1
        blank = []
        while len(new) > 1 and not new[-1].strip():
            blank.append(new.pop())
        lines[s:e] = new + add[key] + blank
    if tail:
        while lines and not lines[-1].strip():
            lines.pop()
        lines += tail + ['']
    print(json.dumps({'payload': '\n'.join(lines)}))


