restore_teams() {   # restore_teams plan | apply：卸载时的 Team。plan 说会怎样（成员：退出；管理员：根密钥跟着删掉），apply 各个都退出
	local rows id name role host rest out
	rows=$(py team-list 2>/dev/null) || return 0
	[ -n "$rows" ] || return 0
	while IFS=$'\t' read -r id name role host rest; do
		if [ "$1" = plan ]; then
			if [ "$role" = admin ] && [ "$host" != - ]; then
				say "  · Team「${name}」：这台设备是它的管理员，根密钥跟着删掉（备份里不带它：没有另存的话，这个 Team 再没有谁管得了）；它的同步服务器（${host}）不卸：要一起卸掉的话，先运行 cca team leave ${id:0:8}"
			elif [ "$role" = admin ]; then
				say "  · Team「${name}」：这台设备是它的管理员，根密钥跟着删掉（备份里不带它：没有另存的话，这个 Team 再没有谁管得了）"
			else
				say "  · Team「${name}」：退出，服务器上移除这台设备"
			fi
		else
			out=$(py team-leave apply "$id" 2>/dev/null) || continue
			out=$(printf '%s\n' "$out" | sed -n 3p)
			[ -z "$out" ] || warn "Team「${name}」：${out}"
		fi
	done <<< "$rows"
}

team_fail() {   # team_fail 辅助程序的输出 默认的说法：py team-… 没成时 stdout 是 "原因码\t原因"，FAIL_CODE 是 team_ 加上原因码
	case "$1" in
		*$'\t'*) FAIL_CODE="team_${1%%$'\t'*}" die "${1#*$'\t'}" ;;
		*) die "${1:-$2}" ;;
	esac
}

cmd_team() {
	[ -f "$CFG" ] || die "还没安装：请先运行 $SELF install"
	local sub="${1:-ls}" out
	[ $# -eq 0 ] || shift
	case "$sub" in
		ls|list) team_ls "$@" ;;
		join) team_join "$@" ;;
		sync) team_sync "$@" ;;
		leave) team_leave "$@" ;;
		new) team_new "$@" ;;
		deploy) team_deploy "$@" ;;
		hosted) team_hosted "$@" ;;
		attach) team_attach "$@" ;;
		invite) team_invite "$@" ;;
		devices) team_devices "$@" ;;
		revoke) team_revoke "$@" ;;
		admin) team_admin "$@" ;;
		grant)
			out=$(py team-grant "$@") || team_fail "$out" "没改成"
			okay "改好了：现在给这台设备的是${out}" ;;
		name)
			[ $# -eq 2 ] || die "用法: cca team name Team 新名字"
			out=$(py team-name "$@") || team_fail "$out" "没改成"
			{ local nm_old nm_new nm_stored; IFS= read -r nm_old; IFS= read -r nm_new; IFS= read -r nm_stored; } <<< "$out"
			okay "改好了：「${nm_old}」现在叫「${nm_new}」；$(team_stored "$nm_stored")"
			say "  各台设备下次同步配置时跟着改；服务器上手机网页端的标题下次部署时换（cca team deploy ${nm_new} …）" ;;
		rename)
			[ $# -eq 3 ] || die "用法: cca team rename Team 设备 新名字"
			out=$(py team-rename "$@") || team_fail "$out" "没改成"
			{ local rn_old rn_new rn_why; IFS= read -r rn_old; IFS= read -r rn_new; IFS= read -r rn_why; } <<< "$out"
			if [ -z "$rn_why" ]; then
				okay "改好了：「${rn_old}」现在叫「${rn_new}」（它下次同步配置时跟着改）"
			else
				okay "改好了：「${rn_old}」现在叫「${rn_new}」。${rn_why}"
			fi ;;
		import) team_import "$@" ;;
		export) team_export "$@" ;;
		edit) team_edit "$@" ;;
		map)
			out=$(py team-map "$@") || team_fail "$out" "没改成"
			okay "改好了；$(team_stored "$out")"
			team_settle ;;
		alias)
			case "$#:${2:-}" in
				2:--lock|2:--unlock) team_alias_lock "$@"; return ;;
				3:*) ;;
				*) die "用法: cca team alias Team 账号 新别名 | cca team alias Team --lock|--unlock" ;;
			esac
			out=$(py team-alias "$@") || team_fail "$out" "没改成"
			{ local al_old al_stored al_was=""; IFS= read -r al_old; IFS= read -r al_stored; } <<< "$out"
			[ -z "$al_old" ] || al_was="（原来是「${al_old}」）"
			okay "改好了：${2} 在这个 Team 里叫「${3}」${al_was}；$(team_stored "$al_stored")"
			say "  各台设备上照 Team 给的名字用着的，下次同步配置时跟着改；自己改过名字的不动"
			team_settle ;;
		publish)
			out=$(py team-publish "$@") || team_fail "$out" "没发布成"
			okay "$(team_stored "$(printf '%s\n' "$out" | sed -n 1p)")"
			out=$(printf '%s\n' "$out" | sed -n 2p)
			[ -z "$out" ] || team_forward_warn "$out"
			team_settle ;;
		node) team_node "$@" ;;
		*) die "$TEAM_USAGE" ;;
	esac
}

team_import() {   # team_import Team 文件 | Team --mine
	local out n nodes stored
	case "$#:${2:-}" in
		2:--mine)
			out=$(py team-import "$@") || team_fail "$out" "没导入成"
			{ IFS= read -r n; IFS= read -r nodes; IFS= read -r stored; } <<< "$out"
			okay "导入了 ${n} 个账号、${nodes} 个节点；$(team_stored "$stored")"
			team_settle ;;
		2:-*) FAIL_CODE=team_usage die "用法: cca team import Team 文件 | cca team import Team --mine" ;;
		2:*) team_config_apply "$1" "$2" ;;
		*) FAIL_CODE=team_usage die "用法: cca team import Team 文件 | cca team import Team --mine" ;;
	esac
}

team_export() {   # team_export Team 文件 [--force]：把这个 Team 的配置写成 JSON 文件（600；辅助程序的 team-config export）
	local out file tid name n nodes
	case "$#:${3:-}" in
		2:|3:--force) ;;
		*) FAIL_CODE=team_usage die "用法: cca team export Team 文件 [--force]" ;;
	esac
	case "$2" in -*) FAIL_CODE=team_usage die "用法: cca team export Team 文件 [--force]" ;; esac
	out=$(py team-config export "$@") || team_fail "$out" "没导出成"
	{ IFS= read -r file; IFS= read -r tid; IFS= read -r name; IFS= read -r n; IFS= read -r nodes; } <<< "$out"
	okay "导出了「${name}」的配置（${n} 个账号、${nodes} 个节点）：${file}"
	[ "$nodes" = 0 ] || warn "文件里有节点的密钥（密码、uuid）：只给自己读写，和密码一样保管，别发给不该看的人"
	say "  改好以后导入回去（先说会改什么、问过你再换）：cca team import ${tid:0:8} 文件"
	gui_done team_exported "导出了「${name}」的配置（${n} 个账号、${nodes} 个节点）"
}

team_edit() {   # team_edit Team：导出到这个 Team 的目录里（edit.json：只给自己读写，备份不带它）→ 编辑器 → 照它换（team_config_apply）；用完删掉
	local out f tid name n nodes base before rc
	[ $# -eq 1 ] || FAIL_CODE=team_usage die "用法: cca team edit Team"
	need_tty
	if [ -n "$PROMPT_GUI" ]; then
		gui_terminal team_edit "Team 的配置要在终端里用编辑器改" team edit "$1"
		die "Team 的配置要在终端里用编辑器改：cca team edit $1"
	fi
	out=$(py team-config export "$1" --edit) || team_fail "$out" "没打开"
	{ IFS= read -r f; IFS= read -r tid; IFS= read -r name; IFS= read -r n; IFS= read -r nodes; IFS= read -r base; } <<< "$out"
	before=$(sha256_of "$f")
	while :; do
		${EDITOR:-vi} "$f" <&3 3<&-
		if [ "$(sha256_of "$f")" = "$before" ]; then rm -f "$f"; info "没有改动"; return 0; fi
		rc=0
		out=$(py team-config check "$tid" "$f" --base "$base") || rc=$?
		[ $rc -eq 0 ] && break
		case "$out" in file$'\t'*) ;; *) rm -f "$f"; team_fail "$out" "没改成" ;; esac
		warn "${out#*$'\t'}"
		confirm "重新编辑？（不改了就答 n）" y || { rm -f "$f"; say "已取消"; return 1; }
	done
	# 在子 shell 里换：中途 die 了也照样删掉那份（里面有节点的密钥）
	( team_config_apply "$tid" "$f" "$base" ); rc=$?
	rm -f "$f"
	[ $rc -eq 0 ] || exit $rc
}

team_config_apply() {   # team_config_apply Team 文件 [打开时的摘要]：照文件整份换掉这个 Team 的配置。先说会改什么（py team-config check），新加、改了的
	                      # 节点定义拿内核校验，问过同意（consent team_config，范围是 Team 的编号和文件的摘要：App 里同意以后文件又改过的话对不上、
	                      # 照新的内容重问；去掉账号的默认答「不」）再换、发布，然后照新的配置对一遍账号表。
	                      # 摘要：cca team edit 打开时的（这中间在别处改过的话提醒一句）。一样的不问、不换
	local team="$1" f="$2" out tid name count removed sha defs summary l detail="" warns="" def=y
	out=$(py team-config check "$team" "$f" ${3:+--base "$3"}) || team_fail "$out" "没导入成"
	{ IFS= read -r tid; IFS= read -r name; IFS= read -r count; IFS= read -r removed; IFS= read -r sha; IFS= read -r defs; summary=$(cat); } <<< "$out"
	if [ "$count" = 0 ]; then
		okay "「${name}」的配置和这份一样，没有要改的"
		gui_done team_imported "「${name}」的配置和这份一样，没有要改的"
		return 0
	fi
	[ "$defs" = 0 ] || team_config_validate "$f"
	# 给同意的说明：一项一句，提醒放在最后（事件里的换行会变成空格：不能一行一项）
	while IFS= read -r l; do
		case "$l" in "") ;; "! "*) warns="${warns}${l#! }。" ;; *) detail="${detail}${l}。" ;; esac
	done <<< "$summary"
	[ -z "$warns" ] || detail="${detail}注意：${warns}"
	if [ -z "$PROMPT_GUI" ]; then
		say "照这份换掉「${name}」的配置会："
		while IFS= read -r l; do
			case "$l" in "") ;; "! "*) warn "${l#! }" ;; *) say "  · ${l}" ;; esac
		done <<< "$summary"
	fi
	[ "$removed" = 0 ] || def=n
	consent team_config "${tid}:${sha:0:16}" "导入 Team 的配置" "照这份换掉「${name}」的配置吗？" "$detail" "$def"
	case $? in
		0) ;;
		1) say "已取消"; gui_cancelled; return 1 ;;
		*) die "要先同意：在终端里运行 cca team import（会先问你）" ;;
	esac
	out=$(py team-config apply "$team" "$f" --sha "$sha") || team_fail "$out" "没换成"
	okay "换好了「${name}」的配置；$(team_stored "$out")"
	gui_done team_imported "换好了「${name}」的配置；$(team_stored "$out")"
	team_settle
}

team_config_validate() {   # team_config_validate 文件：文件里全部的节点定义拼成一份配置，拿内核 -t 校验（和 cca team node add 一样；dialer-proxy 连着的一起）
	local dir out
	node_custom_ok || FAIL_CODE=team_file die "这份配置里有新的节点定义，要用内置代理的内核校验，这台机器用不了（内置代理的内核没有 $(uname -m) 这个架构）"
	core_fetch || FAIL_CODE=team_file die "下载内置代理的内核失败，没法校验这份配置里的节点：${FETCH_ERR}"
	dir=$(mktemp -d "${TMPDIR:-/tmp}/cca-nodet.XXXXXX") || die "建临时目录失败"
	if ! py team-config testconfig "$1" > "$dir/config.yaml" 2>/dev/null; then rm -rf "$dir"; die "生成校验配置失败"; fi
	chmod 600 "$dir/config.yaml" 2>/dev/null
	info "正在用内核校验这份配置里的节点…"
	if out=$("$(core_bin)" -t -d "$dir" -f "$dir/config.yaml" 2>&1); then rm -rf "$dir"; return 0; fi
	rm -rf "$dir"
	FAIL_CODE=team_file die "这份配置里有内核认不出的节点，校验没通过：$(printf '%s' "$out" | tail -n 1)"
}

team_settle() {   # Team 的配置变了以后（加入、同步到新的一版、退出、管理员发布）：账号表下一条命令就照它改，这里马上做完——没配置过路由器的
                  # 把配置带的节点导入可选节点，对一遍账号表（加了、收起了哪些账号辅助程序会说），同步到路由器，改启动器
	local added n list=""
	load_router
	if [ -z "$ROUTER_HOST" ]; then
		added=$(py nodes-import 2>/dev/null) || added=""
		while IFS= read -r n; do [ -z "$n" ] || list="${list:+${list}、}${n}"; done <<< "$added"
		[ -z "$list" ] || okay "已导入 Team 的配置带的节点：${list}（这台机器的可选节点）"
	fi
	py team-apply || return 0
	if [ "$(digest)" != "$(py get synced)" ] && router_needed; then
		router_sync_soon || warn "路由器同步没完成：修好后运行 cca router sync"
	else
		core_follow   # 路由器那边没有要同步的（router_sync_soon 里先做这一步）：Team 的配置带的节点变了时本机的端口池照样跟上
	fi
	launchers_all
}

team_alias_lock() {   # cca team alias Team --lock|--unlock：锁定（解开）这个 Team 里账号的别名，再发布
	local on=on out name stored
	[ "$2" = --lock ] || on=off
	out=$(py team-alias-lock "$1" "$on") || team_fail "$out" "没改成"
	{ IFS= read -r name; IFS= read -r stored; } <<< "$out"
	if [ "$on" = on ]; then
		okay "已锁定「${name}」里账号的别名；$(team_stored "$stored")"
		say "  各台设备下次同步配置时换成 Team 给的别名（自己改过的也换回来），之后在设备上改不了；这台设备的账号表不动"
	else
		okay "已解开「${name}」里账号的别名；$(team_stored "$stored")"
		say "  各台设备上又能自己改别名了（现在用着的不变）"
	fi
	team_settle
}

TEAM_NODE_USAGE="用法: cca team node Team [ls [--json] | add [链接] | copy 模板 新名字 [--port 端口] | rm 节点 | test [节点…] [--tool claude|codex|agy] [--json] | install 节点|-]"

team_node() {   # cca team node Team [子命令 …]：管理员管这个 Team 的节点定义（加、复制、去掉、列出，实测出口，指定安装客户端用的；见 docs/dev/team.md「Team 的节点」）。
	              # 给各台设备的配置只带它的账号用得着的节点：加了没人用的节点，哪台设备的配置都不变
	[ $# -ge 1 ] || die "$TEAM_NODE_USAGE"
	local team="$1" sub="${2:-ls}" out name stored any="" type server port dialer users install extra note=""
	shift
	[ $# -eq 0 ] || shift
	case "$sub" in
		ls|list)
			case "$#:${1:-}" in
				0:) ;;
				1:--json) out=$(py team-node-ls "$team" --json) || team_fail "$out" "没列出来"; printf '%s\n' "$out"; return ;;
				*) die "$TEAM_NODE_USAGE" ;;
			esac
			out=$(py team-node-ls "$team") || team_fail "$out" "没列出来"
			while IFS=$'\t' read -r name type server port dialer users install; do   # 没有的栏是 -
				[ -n "$name" ] || continue
				any=1 extra=""
				[ "$dialer" = - ] || extra="，经 ${dialer} 连出去"
				[ "$install" != 1 ] || extra="${extra}，各台设备经内置代理安装客户端用它"
				if [ "$users" = - ]; then say "    ${name}（${type} ${server}:${port}${extra}）"
				else say "    ${name}（${type} ${server}:${port}${extra}）  ——  ${users//,/、} 在用"; fi
			done <<< "$out"
			if [ -n "$any" ]; then
				say ""
				info "给账号换节点：cca team map ${team} 工具 邮箱 节点；加一个：cca team node ${team} add；实测出口：cca team node ${team} test 节点…"
			else
				info "这个 Team 还没有节点的定义：cca team node ${team} add 粘贴一条代理链接或一段 Clash 节点配置"
			fi ;;
		add)
			[ $# -le 1 ] || die "$TEAM_NODE_USAGE"
			team_node_add "$team" "${1:-}" ;;
		copy|cp)
			[ $# -eq 2 ] || { [ $# -eq 4 ] && [ "$3" = --port ]; } || die "$TEAM_NODE_USAGE"
			out=$(py team-node-copy "$team" "$@") || team_fail "$out" "没复制成"
			{ IFS= read -r name; IFS= read -r stored; } <<< "$out"
			[ $# -ne 4 ] || note="，端口换成 ${4}"
			okay "照「${1}」复制了节点「${name}」${note}；$(team_stored "$stored")"
			say "  先实测出口：cca team node ${team} test ${name}；给账号用它：cca team map ${team} 工具 邮箱 ${name}"
			team_settle ;;
		rm|remove)
			[ $# -eq 1 ] || die "$TEAM_NODE_USAGE"
			out=$(py team-node-rm "$team" "$1") || team_fail "$out" "没去掉"
			okay "去掉了节点「${1}」；$(team_stored "$out")"
			team_settle ;;
		test) team_node_test "$team" "$@" ;;
		install)   # 各台设备直连拿不到安装脚本时（install-cli）经内置代理的哪个节点装：Team 的配置的 install_node
			[ $# -eq 1 ] || die "$TEAM_NODE_USAGE"
			out=$(py team-node-install "$team" "$1") || team_fail "$out" "没改成"
			{ IFS= read -r name; IFS= read -r stored; } <<< "$out"   # name 是原来的（没有是空的）
			[ -z "$name" ] || [ "$name" = "$1" ] || note="（原来是「${name}」）"
			if [ "$1" != - ]; then
				okay "改好了：各台设备经内置代理安装客户端用「${1}」${note}；$(team_stored "$stored")"
				say "  各台设备直连拿不到安装脚本时（cca install-cli）经它装，不用在终端里现选"
			elif [ -n "$name" ]; then
				okay "不再指定安装客户端用的节点${note}；$(team_stored "$stored")"
				say "  各台设备直连拿不到安装脚本时在终端里现选一个节点"
			else
				okay "本来就没有指定安装客户端用的节点；$(team_stored "$stored")"
			fi
			team_settle ;;
		*) die "$TEAM_NODE_USAGE" ;;
	esac
}

team_node_add() {   # team_node_add Team [链接]：解析（写法和 cca node add 一样）→ 拿内核校验 → 加进这个 Team 的节点
	local team="$1" text proxy out name stored n
	local -a taken=()
	node_custom_ok || die "加节点要用内置代理的内核校验，这台机器用不了（内置代理的内核没有 $(uname -m) 这个架构）"
	if [ -n "${2:-}" ]; then
		text="$2"
	else
		say "  粘贴一条代理链接（${CUSTOM_FORMATS}），或一段 Clash 节点配置。"
		say "  贴完单独一行写一个点（.）回车结束："
		text=$(node_read_block) || die "没有输入"
	fi
	out=$(py team-node-ls "$team") || team_fail "$out" "没加上"
	while IFS=$'\t' read -r n _; do [ -n "$n" ] && taken[${#taken[@]}]="$n"; done <<< "$out"   # 这个 Team 里已经有的名字也要避开
	proxy=$(printf '%s' "$text" | py node-check "${taken[@]}") || return 1
	info "正在用内核校验这个节点…"
	node_validate "$proxy" || return 1
	out=$(printf '%s' "$proxy" | py team-node-add "$team") || team_fail "$out" "没加上"
	{ IFS= read -r name; IFS= read -r stored; } <<< "$out"
	okay "加上了节点「${name}」；$(team_stored "$stored")"
	say "  先实测出口：cca team node ${team} test ${name}；给账号用它：cca team map ${team} 工具 邮箱 ${name}"
	team_settle
}

team_trace() {   # team_trace 本机端口 网站：经临时内核的这个入站取网站的 /cdn-cgi/trace（试两次）。取到了打印它，没取到打印 error=原因
	local out rc i
	for i in 1 2; do
		out=$(curl -q --noproxy '' -sS --connect-timeout 10 -m 20 -x "http://127.0.0.1:$1" "https://$2/cdn-cgi/trace" 2>&1); rc=$?
		if [ $rc -eq 0 ] && printf '%s\n' "$out" | grep -q '^ip='; then printf '%s\n' "$out"; return 0; fi
		[ "$i" = 2 ] || sleep "${CCA_RETRY_WAIT:-1}"
	done
	out=$(printf '%s\n' "$out" | sed '/^[[:space:]]*$/d' | tail -n 1 | tr -d '\t' | cut -c1-160)
	printf 'error=%s\n' "${out:-curl 退出码 ${rc}}"
}

team_node_test() {   # team_node_test Team [节点…] [--tool 工具] [--json]：起一个临时内核（cca 的 mihomo，只在 127.0.0.1 上、每个节点一个端口；不碰
	                   # 在跑的内置代理和路由器），经每个节点取账号要用的服务和 www.cloudflare.com（服务器自己的出口）的出口，照 py team-node-verdict
	                   # 说每个节点通不通、出口对不对。不写节点是这个 Team 的全部节点。临时内核的配置有节点密钥：放在只有自己能读的临时目录里，
	                   # 用完删掉。退出码同 team-node-verdict：0 都好，1 有节点不通，2 全都不通（多半是这台机器的网络），3 都通了、有要提醒的
	local team="$1" json="" a
	local -a args=()
	shift
	for a in "$@"; do
		case "$a" in --json) json=1 ;; *) args[${#args[@]}]="$a" ;; esac
	done
	core_fetch || die "内置代理的内核没装上，测不了：${FETCH_ERR}"
	(
		tmp="" pid=""
		trap '[ -z "$pid" ] || { kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null; }; [ -z "$tmp" ] || rm -rf "$tmp"' EXIT
		trap 'exit 130' INT TERM HUP
		tmp=$(mktemp -d "${TMPDIR:-/tmp}/cca-nodetest.XXXXXX") || die "建临时目录失败"
		chmod 700 "$tmp"
		plan=$(py team-node-testconfig "$team" "$tmp/test.json" ${args[@]+"${args[@]}"}) || team_fail "$plan" "没测成"
		mkdir -p "$tmp/core"
		"$(core_bin)" -d "$tmp/core" -f "$tmp/test.json" >"$tmp/core.log" 2>&1 </dev/null &
		pid=$!
		local hosts name port server sport i h n=0 ok="" trace ip loc colo err got lines out rc state text
		local -a names=() ports=() servers=() sports=() jobs=()
		{
			IFS= read -r hosts
			while IFS=$'\t' read -r name port server sport; do
				[ -n "$name" ] || continue
				names[n]="$name" ports[n]="$port" servers[n]="$server" sports[n]="$sport"
				n=$((n + 1))
			done
		} <<< "$plan"
		for ((i = 0; i < 80; i++)); do   # 最多等 20 秒：入站都开了才测
			ok=1
			for port in "${ports[@]}"; do port_open 127.0.0.1 "$port" || { ok=""; break; }; done
			[ -z "$ok" ] || break
			kill -0 "$pid" 2>/dev/null || break
			sleep 0.25
		done
		if [ -z "$ok" ]; then
			err=$(tail -n 1 "$tmp/core.log" 2>/dev/null | cut -c1-200)
			die "测出口用的临时内核没起来${err:+：${err}}"
		fi
		[ -n "$json" ] || info "经 ${n} 个节点测 ${hosts// /、} 看到的出口…"
		for ((i = 0; i < n; i++)); do   # 每个节点、每个网站一个 curl，一起跑
			for h in $hosts; do
				team_trace "${ports[i]}" "$h" > "$tmp/r.$i.$h" &
				jobs[${#jobs[@]}]=$!
			done
		done
		wait "${jobs[@]}" 2>/dev/null
		lines="$hosts"
		for ((i = 0; i < n; i++)); do
			got=""
			for h in $hosts; do
				trace=$(cat "$tmp/r.$i.$h" 2>/dev/null)
				ip=$(printf '%s\n' "$trace" | sed -n 's/^ip=//p' | head -n 1)
				if [ -n "$ip" ]; then
					got=1
					loc=$(printf '%s\n' "$trace" | sed -n 's/^loc=//p' | head -n 1)
					colo=$(printf '%s\n' "$trace" | sed -n 's/^colo=//p' | head -n 1)
					lines="${lines}"$'\n'"${names[i]}"$'\t'"${h}"$'\t'"${ip}"$'\t'"${loc:--}"$'\t'"${colo:--}"
				else
					err=$(printf '%s\n' "$trace" | sed -n 's/^error=//p' | head -n 1)
					lines="${lines}"$'\n'"${names[i]}"$'\t'"${h}"$'\t-\t'"${err:-没取到出口}"
				fi
			done
			if [ -z "$got" ]; then   # 哪个网站都没取到：直连它的服务器端口，分清是没开入站，还是入站的参数不对
				if port_open "${servers[i]}" "${sports[i]}"; then lines="${lines}"$'\n'"${names[i]}"$'\ttcp\topen'
				else lines="${lines}"$'\n'"${names[i]}"$'\ttcp\tclosed'; fi
			fi
		done
		if [ -n "$json" ]; then
			printf '%s\n' "$lines" | py team-node-verdict --json
			exit $?
		fi
		out=$(printf '%s\n' "$lines" | py team-node-verdict); rc=$?
		while IFS=$'\t' read -r state name text; do
			case "$state" in
				ok) okay "${name}：${text}" ;;
				flag) say "  ${name}：${text}" ;;
				down) warn "${name}：${text}" ;;
				'!') warn "  ${name}：${text}" ;;
			esac
		done <<< "$out"
		case $rc in
			0) okay "都通，出口没有问题" ;;
			1) warn "有节点不通：先别给账号用它（服务器上开好入站、参数对上了再测）" ;;
			2) warn "全都不通：多半是这台机器现在连不出去，先看看网络" ;;
			3) warn "都通了，但出口有要注意的（见上面）" ;;
		esac
		exit $rc
	)
}

team_stored() {   # team_stored 存上了几台的配置：说成一句话
	case "$1" in
		0) printf '各台设备的配置没有变' ;;
		*) printf '%s 台设备的配置发布了新的一版' "$1" ;;
	esac
}

team_state_say() {   # team_state_say 状态：给人看的说法
	case "$1" in
		ok) printf '已同步' ;;
		pending) printf '还没同步过配置' ;;
		local) printf '还没接上服务器' ;;
		removed) printf '被管理员移除了' ;;
		lost) printf '等管理员登记回去' ;;
		*) printf '没同步成' ;;
	esac
}

team_role_say() {   # team_role_say 角色：给人看的角色（py team-list 的 admin | coadmin | member）
	case "$1" in
		admin) printf '管理员' ;;
		coadmin) printf '管理员（建 Team 的设备授予的）' ;;
		*) printf '成员' ;;
	esac
}

team_ls() {   # cca team [ls] [--json]：这台设备在哪些 Team 里（只看本机记着的，不联网）
	local out id name role host state seq n why upd
	case "$*" in
		'') ;;
		--json) py team-list --json; return ;;
		*) die "用法: cca team ls [--json]" ;;
	esac
	out=$(py team-list) || exit 1
	if [ -z "$out" ]; then
		say "这台设备还不在任何 Team 里。有管理员给的邀请链接时运行 cca team join；自己建一个是 cca team new 名字"
		return 0
	fi
	while IFS=$'\t' read -r id name role host state seq n why upd; do   # 没有的栏是 -（空的栏按制表符读会被并掉）
		[ "$host" != - ] || host=没有服务器
		[ "$seq" != - ] || seq=""
		[ "$n" != - ] || n=0
		[ "$why" != - ] || why=""
		say "${name}（${id:0:8}）：$(team_role_say "$role")，${host}，$(team_state_say "$state")${seq:+，这台设备能用 ${n} 个账号}${why:+
    ${why}}"
		# 服务器比这一版 cca 要的旧（上次同步时问到的）：建 Team 的设备能更新，别的设备只能请它更新
		if [ -n "$upd" ] && [ "$upd" != - ]; then
			if [ "$role" = admin ]; then warn "「${name}」的服务器要更新：${upd}。在 cca App 的「共享与同步」里点「更新服务器…」，或者运行 cca team deploy ${id:0:8} 用户@主机"
			else warn "「${name}」的服务器要更新：${upd}。请建这个 Team 的管理员更新服务器"; fi
		fi
	done <<< "$out"
}

team_join() {   # cca team join [--stdin] [--name 名字]：问邀请链接（输入不显示；App 里是提问会话的 team.join，链接不对、过期了、用过了时带着原因重问），
	              # 或者 --stdin 从标准输入读。邀请是凭证、只能用一次：不写在命令行上。
	              # TEAM_JOIN_OPTIONAL=1 team_join（配置向导）：这一页可以留空，留空是先不加入（返回 0，什么都不记）
	local stdin="" name="" link out rc err="" tname host device members tid state detail optional="${TEAM_JOIN_OPTIONAL:-}"
	while [ $# -gt 0 ]; do
		case "$1" in
			--stdin) stdin=1 ;;
			--name) [ $# -ge 2 ] || die "$TEAM_USAGE"; name=$2; shift ;;
			*) die "用法: cca team join [--stdin] [--name 名字]（邀请链接不写在命令行上：会问你，或者用 --stdin 从标准输入读）" ;;
		esac
		shift
	done
	[ -n "$stdin" ] || need_tty
	while :; do
		if [ -n "$stdin" ]; then
			link=$(cat)
		else
			link=$(ask_secret "邀请链接（cca-team1. 开头，输入不显示${optional:+；留空是先不加入}）: " q=team.join "title=加入 Team" "label=邀请链接" \
				"hint=Team 的管理员发给这台设备的那一行（一个邀请只能加入一台设备）${optional:+。先不加入的话留空，点继续}" ${optional:+optional=1} "error=$err")
		fi
		if [ -n "$optional" ] && [ -z "${link//[[:space:]]/}" ]; then
			if [ -n "$PROMPT_GUI" ]; then say "  先不加入 Team：以后在 App 的「共享与同步」里加入"; else say "  先不加入 Team：以后运行 cca team join 加入"; fi
			return 0
		fi
		out=$(printf '%s' "$link" | py team-join ${name:+--name "$name"}); rc=$?
		link=""
		[ $rc -ne 0 ] || break
		case "${out%%$'\t'*}" in   # App 里链接本身不对、服务器不认它：带着原因重问；别的原因（连不上……）照旧停下
			link|denied|expired|used) if [ -n "$PROMPT_GUI" ] && [ -z "$stdin" ]; then err="${out#*$'\t'}${optional:+（先不加入的话留空，点继续）}"; continue; fi ;;   # --stdin 读过一次就没了：不重问
		esac
		team_fail "$out" "没有加入成"
	done
	{ IFS= read -r tname; IFS= read -r host; IFS= read -r device; IFS= read -r members; IFS= read -r tid; IFS= read -r state; IFS= read -r detail; } <<< "$out"
	okay "已加入「${tname}」（${host}）：这台设备叫 ${device}${members:+，现在有 ${members} 台设备}"
	if [ "$state" = ok ]; then
		say "  管理员给了这台设备 ${detail} 个账号：账号表照它改（节点由它定；这台机器上已经有的账号只改节点）"
		team_settle
	else
		fail_warn team_sync "加入了，配置还没同步下来：${detail}（稍后运行 cca team sync 再同步）"
	fi
	gui_done team_joined "已加入「${tname}」"
}

team_sync() {   # cca team sync [Team]：同步一次配置，说每个 Team 的结果
	[ $# -le 1 ] || die "用法: cca team sync [Team]"
	local out id name state seq why bad=0
	out=$(py team-sync "$@") || team_fail "$out" "没同步成"
	[ -n "$out" ] || { say "没有要同步配置的 Team"; return 0; }
	while IFS=$'\t' read -r id name state seq why; do
		if [ "$state" = ok ]; then
			okay "${name}：配置已同步"
		else
			warn "${name}：${why}"; bad=1
		fi
	done <<< "$out"
	team_settle
	return $bad
}

TEAM_LEAVE_USAGE="用法: cca team leave [Team [[用户@]主机]] [-p SSH 端口] [-i 私钥] [--dir 目录] [--keep-server]
      管理员的设备上是删除这个 Team：先经 SSH 卸掉它的同步服务器（cca team deploy 装到的那台，用部署时写的 -i 私钥登录；没记下的照部署的默认猜：
      root@服务器的地址、/opt/cca-team-<编号的前 8 位>）。写了服务器、-p、-i、--dir 的照写的卸（写的就是记下的那台时，没写的 -p、-i 照记下的）；
      --keep-server 不卸（服务器留着，自己卸载）"
team_leave() {   # cca team leave [Team …]：退出。成员：服务器上移除这台设备。管理员：删除这个 Team——先卸掉它的同步服务器（team_undeploy；
	               # 卸不成时问要不要照样删、服务器留着），这台设备上的根密钥跟着没了。先问同意
	local sel="" target="" given="" port="" ident="" dir="" keep="" uport="" udir="" rc gone="" left="" how="" done_msg
	local out tid name role host ptarget pport pdir saved pident via why item title question note
	while [ $# -gt 0 ]; do
		case "$1" in
			-p|-i|--dir)
				[ $# -ge 2 ] || FAIL_CODE=team_usage die "$TEAM_LEAVE_USAGE"
				case "$1" in -p) uport=$2 ;; -i) ident=$2 ;; *) udir=$2 ;; esac
				shift ;;
			--keep-server) keep=1 ;;
			-*) FAIL_CODE=team_usage die "$TEAM_LEAVE_USAGE" ;;
			*)
				if [ -z "$sel" ]; then sel=$1
				elif [ -z "$target" ]; then target=$1 given=1
				else FAIL_CODE=team_usage die "$TEAM_LEAVE_USAGE"; fi ;;
		esac
		shift
	done
	out=$(py team-leave plan ${sel:+"$sel"}) || team_fail "$out" "没有这个 Team"
	# 按 \037 分：中间的项可能是空的（没接上服务器的地址、没写的 SSH 端口），tab 是 IFS 的空白，连着的会并成一个。
	# 最后一项是部署时写的私钥（-i，绝对路径；没写、文件不在了就没有这一项）
	IFS=$'\037' read -r tid name role host ptarget pport pdir saved pident <<< "${out//$'\t'/$'\037'}"
	if [ "$role" != admin ]; then
		[ -z "${target}${keep}${uport}${ident}${udir}" ] ||
			FAIL_CODE=team_usage die "这台设备不是「${name}」的管理员：退出时不碰服务器（服务器、-p、-i、--dir、--keep-server 只在管理员删除 Team 时用）"
		item=team_leave title="退出 Team" question="退出「${name}」吗？"
		why="${host:+${host} 上的}服务器移除这台设备，这台设备上「${name}」的配置都删掉。以后要再加入，要管理员重新发邀请"
	else
		item=team_delete title="删除 Team" question="删掉「${name}」吗？"
		[ -z "$keep" ] || [ -z "${target}${uport}${ident}${udir}" ] ||
			FAIL_CODE=team_usage die "--keep-server 是不卸载服务器：不用再写服务器、-p、-i、--dir"
		if [ -z "$keep" ]; then
			[ -n "$given" ] || target=$ptarget
			# 没写服务器、写的就是记下的那台（App 交给终端的 cca team leave 编号 目标 -p 端口 也是）：没写的 -p、-i 照记下的（部署时写的私钥：
			# App 里没法写 -i）。写了别的服务器的只照写的
			if [ "$target" = "$ptarget" ]; then port=${uport:-$pport} ident=${ident:-$pident}
			else port=$uport; fi
			dir=${udir:-$pdir}
			[ -n "$target" ] || keep=none   # 没接上服务器（也没记下部署到了哪），或者不是安装脚本装的：只有这台设备上的
		fi
		why="这台设备是「${name}」的管理员：删掉以后这台设备上就没有它的根密钥了，这个 Team 再没有谁能邀请设备、移除设备、改配置"
		case "$keep" in
			"")
				via=${port:+端口 ${port}}
				[ -z "$ident" ] || via="${via:+${via}，}私钥 ${ident}"
				why="这台设备是「${name}」的管理员：删掉它就是经 SSH 登录 ${target}${via:+（${via}）}，卸掉它的同步服务器（停掉服务，删掉 ${dir:-/opt/cca-team-${tid:0:8}} 里的程序、证书和数据），再删掉这台设备上的根密钥。别的设备从此同步不到它的配置：手里的照旧能用，各自用 cca team leave 退出"
				[ -n "$given" ] || [ "$saved" = 1 ] ||
					why="${why}。没记下服务器是怎么装的，照部署的默认猜的；不对的话写清楚：cca team leave ${tid:0:8} 用户@服务器 [-p 端口] [-i 私钥] [--dir 目录]" ;;
			1) [ -z "${host}${ptarget}" ] ||
				why="${why}。它的同步服务器${host:+（${host}）}留着不卸，要自己卸载${pdir:+（在服务器上运行 sudo sh cca-hub-install.sh --uninstall --dir ${pdir}）}" ;;
			*) [ -z "$host" ] || why="${why}。它的同步服务器（${host}）不是 cca team deploy 装的（托管平台、自己配的）：要自己到那里删掉" ;;
		esac
		[ -z "$keep" ] || why="${why}。别的设备照旧用着手里的配置"
	fi
	[ -n "$PROMPT_GUI" ] || say "  ${why}"
	consent "$item" "$tid" "$title" "$question" "$why" n
	case $? in
		0) ;;
		1) say "已取消"; gui_cancelled; return 1 ;;
		*) die "要先同意：在终端里运行 cca team leave（会先问你）" ;;
	esac
	if [ "$role" = admin ] && [ -z "$keep" ]; then
		team_undeploy; rc=$?
		case $rc in
			0) gone=1 ;;
			1) say "已取消：「${name}」还在"; gui_cancelled; return 1 ;;
			*)
				interactive || FAIL_CODE=${DEPLOY_CODE:-team_install} die "没卸掉 ${target} 上「${name}」的同步服务器：${DEPLOY_WHY}。「${name}」就没删；确定只删这台设备上的（服务器留着，自己卸载）：cca team leave ${tid:0:8} --keep-server"
				how="在服务器上运行 sudo sh cca-hub-install.sh --uninstall --dir ${dir:-/opt/cca-team-${tid:0:8}}"
				if [ -z "$PROMPT_GUI" ]; then
					warn "没卸掉 ${target} 上「${name}」的同步服务器：${DEPLOY_WHY}"
					say "  仍然删掉的话，这台设备上的根密钥删掉，服务器上的服务留着，要自己卸载（${how}）"
				fi
				confirm "仍然删掉「${name}」吗？服务器上的服务留着" n q=team.keep_server "title=删除 Team" severity=warn \
					"detail=没卸掉 ${target} 上的同步服务器：${DEPLOY_WHY}。仍然删掉的话，这台设备上的根密钥删掉，服务器上的服务留着，要自己卸载（${how}）" ||
					{ say "已取消：「${name}」还在"; gui_cancelled; return 1; }
				left=$target ;;
		esac
	fi
	out=$(py team-leave apply "$tid" ${gone:+--server-gone}) || team_fail "$out" "没有退出成"
	note=$(printf '%s\n' "$out" | sed -n 3p)
	[ -z "$note" ] || warn "$note"   # 服务器那边没移除成（连不上）：本机照样退出了
	if [ "$role" != admin ]; then done_msg="已退出「${name}」"
	elif [ -n "$gone" ]; then done_msg="已删除「${name}」，卸掉了 ${target} 上的同步服务器（${dir}）"
	elif [ -n "$left" ]; then done_msg="已删除「${name}」：${left} 上的同步服务器没卸掉，要自己卸载（${how}）"
	else done_msg="已删除「${name}」"; fi
	okay "$done_msg"
	team_settle   # 它给的账号收起来
	gui_done team_left "${done_msg}${note:+。${note}}"
}

team_undeploy() {   # 删除 Team 时卸掉它的同步服务器（变量是 team_leave 的：tid name target port ident dir）。终端里直接运行（ssh 自己问密码、私钥的
	                  # 密码、要不要认这台主机）；App 里和部署时一样先查登录得上不（ident 是部署时写的私钥时照它查），要密码时问（hub.password），只认
	                  # 密钥时给出加公钥那一行（hub.pubkey；照写的私钥登录不了的不给，算没卸成）：hub_login。返回 0 卸好了（dir 是卸掉的目录）；1 取消了；
	                  # 2 没卸成（原因码在 DEPLOY_CODE，原因在 DEPLOY_WHY）
	local a=() pw="" out
	DEPLOY_PY=(team-undeploy "$tid") DEPLOY_WORDS=(team leave "${tid:0:8}") DEPLOY_WHAT="「${name}」的同步服务器" DEPLOY_VERB=卸载 DEPLOY_SOFT=1
	[ -z "$port" ] || a+=(--ssh-port "$port")
	[ -z "$ident" ] || a+=(--identity "$ident")
	[ -z "$dir" ] || a+=(--dir "$dir")
	if [ -n "$PROMPT_GUI" ]; then
		hub_target_set "$target" "$port" "$ident"
		hub_login || return
	fi
	if [ -n "$PROMPT_GUI" ] || ! (: </dev/tty) 2>/dev/null; then a+=(--batch); fi
	info "卸载 ${target} 上「${name}」的同步服务器…"
	if hub_deploy_run "$target" ${a[@]+"${a[@]}"}; then
		dir=$out
		return 0
	fi
	case "$out" in
		*$'\t'*) DEPLOY_CODE="team_${out%%$'\t'*}" DEPLOY_WHY=${out#*$'\t'} ;;
		*) DEPLOY_CODE=team_install DEPLOY_WHY=${out:-服务器上没卸载完} ;;
	esac
	return 2
}

TEAM_NEW_USAGE="用法: cca team new 名字 [--device 这台设备的名字] [--accounts all|none|工具:邮箱,…]"
team_new() {   # cca team new 名字 [--device 这台设备的名字] [--accounts all|none|工具:邮箱,…]：建一个 Team（只在这台设备上：还没有服务器），
	             # 说下一步。没写 --accounts 时问这台设备上哪些账号连同节点、别名放进去（team_new_pick；没有终端的不问、一个都不放）。
	             # App 里不写名字：先问名字（team.new）
	local out tid root n name spec="" asked=""
	local -a args=()
	if [ $# -eq 0 ] && [ -n "$PROMPT_GUI" ]; then
		ask_fields team.new "新建 Team" "一个 Team 是一组设备加一份配置（哪些账号、各走哪个节点）。建在这台 Mac 上：它是管理员，Team 的根密钥只在它上面。建好以后部署这个 Team 的同步服务器，再给别的设备发邀请。" \
			"name|text|teamname||Team 的名字|比如 我的设备、设计组|" || return 1
		set -- "$F_name"
	fi
	[ $# -ge 1 ] || die "$TEAM_NEW_USAGE"
	name=$1
	shift
	while [ $# -gt 0 ]; do
		case "$1" in
			--device) [ $# -ge 2 ] || die "$TEAM_NEW_USAGE"; args+=(--device "$2"); shift ;;
			--accounts) [ $# -ge 2 ] || die "$TEAM_NEW_USAGE"; spec=$2; asked=1; shift ;;
			*) die "$TEAM_NEW_USAGE" ;;
		esac
		shift
	done
	if [ -z "$asked" ] && interactive && [ -n "${name//[[:space:]]/}" ]; then   # 名字是空的：不问，下面辅助程序说名字不对
		[ -n "$PROMPT_GUI" ] || out=$(py check teamname "$name") || FAIL_CODE=team_name die "$out"   # 名字不对的话先说，别等选完账号
		team_new_pick "$name" || return 1
	fi
	[ -z "$spec" ] || args+=(--accounts "$spec")
	out=$(py team-new "$name" ${args[@]+"${args[@]}"}) || team_fail "$out" "没建成"
	{ IFS= read -r tid; IFS= read -r root; IFS= read -r n; } <<< "$out"
	[ -n "$n" ] && [ "$n" != 0 ] || n=""
	okay "建好了「${name}」（${tid:0:8}）：这台设备是它的管理员${n:+，放进了 ${n} 个账号（连同现在走的节点、别名）}"
	say "  下一步：部署它的同步服务器（服务器上只放这把公开的根公钥，没有要保密的东西）"
	say "    有自己的 Linux 服务器：cca team deploy ${tid:0:8} root@服务器"
	say "    没有服务器：cca team hosted ${tid:0:8}（部署到托管平台 Railway）"
	say "    自己运行服务端的：--mode team --team-root '${root}'，然后 cca team attach ${tid:0:8} https://服务器:端口 [证书公钥的指纹]"
	[ -n "$n" ] || say "  往里放账号：cca team map ${tid:0:8} 工具 邮箱 节点（这台设备上自己加的账号一次都放进去：cca team import ${tid:0:8} --mine）"
	warn "根密钥只在这台设备上（~/.cca/teams/${tid}/）：它丢了这个 Team 就得重建。cca restore 的备份不带它，要自己留一份"
	gui_done team_created "建好了「${name}」${n:+，放进了 ${n} 个账号}：接着部署它的同步服务器"
}

team_new_pick() {   # team_new_pick Team 的名字：问这台设备上哪些账号放进新建的 Team（py team-candidates 列出的：自己加的，和这台设备当管理员的
	                  # 别的 Team 里的），结果放进调用者的 spec（工具:邮箱,…；一个都不放是 none）。自己加的预先选上（App 里勾好，终端里直接回车
	                  # 就是它们），已经在别的 Team 里的不选。一个能放的都没有时不问。App 里是一页多选（team.accounts，可以都不勾）
	local rows tool label email alias from node n=0 i w def="" all="" sel tip bad tries=0
	local -a keys texts notes opts
	rows=$(py team-candidates 2>/dev/null) || rows=""
	while IFS=$'\t' read -r tool label email alias from node; do   # 没有的栏是 -
		[ -n "$tool" ] || continue
		[ "$alias" != - ] || alias=""
		[ "$from" != - ] || from=""
		keys[n]="${tool}:${email}"
		texts[n]="${label}：${alias:+${alias}（}${email}${alias:+）}"
		notes[n]="走 ${node}${from:+，已在「${from}」里}"
		n=$((n + 1))
		all="${all:+${all} }${n}"
		[ -n "$from" ] || def="${def:+${def} }${n}"
	done <<< "$rows"
	[ $n -gt 0 ] || return 0
	if [ -n "$PROMPT_GUI" ]; then
		for ((i = 0; i < n; i++)); do opts[i]="opt=$((i + 1))"$'\t'"${texts[i]}"$'\t'"${notes[i]}"; done
		# 预先勾上的写在 value 里，不写成默认值：都不勾时答案是空的，gui_ask 会拿默认值顶上
		sel=$(gui_ask multi "放进「${1}」的账号" "" q=team.accounts "title=新建 Team" label=这台设备上的账号 optional=1 min=0 "value=${def}" submit=新建 \
			"message=勾上的账号连同现在走的节点、别名放进「${1}」。别的设备加入以后拿到这些账号，在各自的设备上登录。已经在别的 Team 里的也能放，这台设备上照旧用原来那个 Team 的节点。" \
			"hint=都不勾就先建一个空的 Team" "${opts[@]}") || return 1
	else
		say ""
		say "  这台设备上的这些账号能放进「${1}」（连同现在走的节点、别名）："
		for ((i = 0; i < n; i++)); do say "    $((i + 1)). ${texts[i]}  ${C_D}${notes[i]}${C_0}"; done
		say ""
		tip="直接回车是自己加的 ${def// /、}"
		[ -n "$def" ] || tip="直接回车是一个都不放"
		[ "$def" != "$all" ] || tip="直接回车是全部"
		while :; do
			tries=$((tries + 1))
			[ $tries -le 5 ] || return 1
			sel=$(ask "  放进哪几个（编号用空格分隔；全部写 a，一个都不放写 0；${tip}）：" "${def:-0}" | sed 's/,/ /g; s/，/ /g; s/、/ /g')
			case "$sel" in
				a|A|all) sel=$all ;;
			esac
			bad=""
			for w in $sel; do
				case "$w" in *[!0-9]*) warn "「${w}」不是编号"; bad=1; break ;; esac
				if [ "$w" -gt $n ]; then warn "没有编号 ${w}"; bad=1; break; fi
			done
			[ -n "$bad" ] || break
		done
	fi
	spec=""
	for w in $sel; do
		case "$w" in *[!0-9]*) continue ;; esac
		[ "$w" -ge 1 ] && [ "$w" -le $n ] || continue   # 0 是一个都不放
		case ",${spec}," in *",${keys[w - 1]},"*) ;; *) spec="${spec:+${spec},}${keys[w - 1]}" ;; esac
	done
	[ -n "$spec" ] || spec=none
}

TEAM_DEPLOY_USAGE="用法: cca team deploy Team [用户@]主机 [-p SSH 端口] [-i 私钥] [--port 端口] [--host 公网地址] [--web-port 端口 | --no-web]
                       [--docker | --systemd] [--dir 目录] [--push 网关 --push-pin 公钥 | --no-push]
      再部署（更新）时写的就是上次部署到的那台：没写的 -p、-i、--dir 照上次的
      cca team deploy --script   只把安装脚本打到 stdout：在服务器上自己运行 sudo sh 脚本 --team-root '根公钥'（cca team new 给的那一行）"
team_deploy() {   # cca team deploy Team [用户@]主机 [选项]：经 SSH 把这个 Team 的同步服务器装到自己的服务器上（一台服务器上每个 Team 一个服务：
	                # 再运行是更新），装好了接上。App 里不写服务器，在提问会话里问（hub.deploy）。部署时记下的那台（目标、SSH 端口、-i 的私钥、
	                # 目录）：问服务器时预填它，写的（问到的）就是它时没写的 -p、-i、--dir 照记下的（App 里没法写 -i），部署好了接着记着。
	                # 服务器上只有 Team 的根公钥（公开的）：docs/dev/team.md「部署」
	local sel="" target="" args=() pw="" out rc tid name role at how sport="" ident="" udir="" ptarget pport pdir saved pident
	local mode="" state="" port="" relay="" dir="" lan="" host="" device="" members="" stored="" note="" svc="" web="" web_cert="" web_off="" push=""
	local wport webmsg=""
	if [ "${1:-}" = --script ]; then
		[ $# -eq 1 ] || FAIL_CODE=team_usage die "$TEAM_DEPLOY_USAGE"
		py hub-installer
		return
	fi
	[ $# -ge 1 ] || FAIL_CODE=team_usage die "$TEAM_DEPLOY_USAGE"
	sel=$1; shift
	while [ $# -gt 0 ]; do
		case "$1" in
			-p|-i|--port|--host|--dir|--web-port|--push|--push-pin)
				[ $# -ge 2 ] || FAIL_CODE=team_usage die "$TEAM_DEPLOY_USAGE"
				case "$1" in -p) sport=$2 ;; -i) ident=$2 ;; --dir) udir=$2 ;; *) args+=("$1" "$2") ;; esac
				shift ;;
			--no-web|--no-push) args+=("$1") ;;
			--docker|--systemd) args+=(--mode "${1#--}") ;;
			-*) FAIL_CODE=team_usage die "$TEAM_DEPLOY_USAGE" ;;
			*) [ -z "$target" ] || FAIL_CODE=team_usage die "$TEAM_DEPLOY_USAGE"; target=$1 ;;
		esac
		shift
	done
	out=$(py team-leave plan "$sel") || team_fail "$out" "没有这个 Team"   # 是哪个 Team、这台设备是不是管理员、现在接着哪台
	# 按 \037 分：没接上服务器时地址是空的；后面几栏是卸载时去哪（见 team_leave）
	IFS=$'\037' read -r tid name role at ptarget pport pdir saved pident <<< "${out//$'\t'/$'\037'}"
	[ "$role" = admin ] || FAIL_CODE=team_not_admin die "这台设备不是「${name}」的管理员：部署它的同步服务器要在管理员的设备上"
	DEPLOY_PY=(team-deploy "$tid") DEPLOY_WORDS=(team deploy "${tid:0:8}") DEPLOY_WHAT="「${name}」的同步服务器" DEPLOY_FAIL=team_fail
	# 部署时记下的那台（目标、SSH 端口、私钥：只认记下的，照部署的默认猜的不算）：hub_deploy_ask、hub_deploy_where 预填它、照它的私钥查登录
	if [ "$saved" = 1 ]; then DEPLOY_REC=$ptarget DEPLOY_REC_PORT=$pport DEPLOY_REC_ID=$pident DEPLOY_REC_DIR=$pdir
	else DEPLOY_REC="" DEPLOY_REC_PORT="" DEPLOY_REC_ID="" DEPLOY_REC_DIR=""; fi
	DEPLOY_AT=${at%:*}
	DEPLOY_AT=${DEPLOY_AT#[}; DEPLOY_AT=${DEPLOY_AT%]}
	if [ -n "$at" ]; then
		DEPLOY_MSG="「${name}」现在接着 ${at}：经 SSH 把服务器上的程序换成这一版 cca 带的（数据不变）；填别的服务器就是搬过去，各台设备同步到新的配置以后自己换过来。要用 root 登录，或者能免密码 sudo 的用户。"
	else
		DEPLOY_MSG="经 SSH 在你自己的 Linux 服务器上装好「${name}」的同步服务器（有 Docker 用 Docker，没有用 systemd），装好了自动接上。一台服务器上可以装几个 Team，各是一个服务、各用一个端口（从 18445 起找空着的）：云服务商的安全组里要放行它。要用 root 登录，或者能免密码 sudo 的用户。"
	fi
	if [ -z "$target" ] && [ -n "$PROMPT_GUI" ]; then
		hub_deploy_ask || return 1
		target=$(hub_target) sport=$F_port
	elif [ -z "$target" ]; then
		interactive || FAIL_CODE=team_usage die "$TEAM_DEPLOY_USAGE"
		hub_deploy_where || return 1
		target=$(hub_target) sport=$F_port
	fi
	# 写的（问到的）就是部署时记下的那台：没写的 -p、-i、--dir 照记下的（App 里没法写 -i；私钥文件不在了 plan 就不给），这一次部署又记下它们
	if [ "$target" = "$DEPLOY_REC" ]; then sport=${sport:-$DEPLOY_REC_PORT} ident=${ident:-$DEPLOY_REC_ID} udir=${udir:-$DEPLOY_REC_DIR}; fi
	[ -z "$sport" ] || args+=(--ssh-port "$sport")
	[ -z "$ident" ] || args+=(--identity "$ident")
	[ -z "$udir" ] || args+=(--dir "$udir")
	if [ -n "$PROMPT_GUI" ] || ! (: </dev/tty) 2>/dev/null; then args+=(--batch); fi
	info "部署「${name}」的同步服务器到 ${target}（${ident:+用私钥 ${ident} 登录；}要把服务端程序（约 10 MB）传过去，网慢时要一会儿）…"
	hub_deploy_run "$target" ${args[@]+"${args[@]}"}; rc=$?
	[ $rc -eq 0 ] || team_fail "$out" "没有部署成"
	eval "$out"   # mode state port relay dir lan host device members stored note svc web web_cert web_off push（辅助程序的 sh：键=值）
	case "$mode" in docker) how="Docker compose" ;; *) how="systemd" ;; esac
	if [ "$state" = update ]; then okay "已更新 ${target} 上「${name}」的同步服务器（${dir}，${how}，端口 ${port}，服务名 ${svc}）：数据没变，照旧接着"
	else okay "已部署「${name}」的同步服务器到 ${target}（${dir}，${how}，端口 ${port}，服务名 ${svc}），接上了：这台设备叫 ${device}，现在有 ${members} 台设备；$(team_stored "$stored")"; fi
	[ "$state" = update ] || say "  给别的设备发邀请：cca team invite ${tid:0:8} 名字（或者 App 的「共享与同步」里）"
	# 这个 Team 的账号的远程会话（cca remote）经它中转：数据端口是另一个；手机的网页端又是一个，证书机构验证时连 80 端口。云服务商的安全组里都要放行
	wport=${web%/}; wport=${wport##*:}
	if [ -n "$web" ]; then
		say "  「${name}」的账号的远程会话经这台服务器中转（数据端口 ${relay}，iPhone 上的 cca App 也走它），以前配的手机在浏览器里接入用网页端（端口 ${wport}）：云服务商的安全组里要放行 TCP ${port}、${relay}、${wport} 和 80（证书机构验证用）"
	elif [ -n "${relay:-}" ]; then
		say "  「${name}」的账号的远程会话经这台服务器中转（数据端口 ${relay}，iPhone 上的 cca App 也走它）：云服务商的安全组里要放行 TCP ${port} 和 ${relay}"
	fi
	[ -z "$push" ] || say "  推送：iPhone 上的 cca App 登记了的，会话里的通知经推送网关 ${push} 推到手机上（只有手机解得开）"
	if [ -n "$web" ] && [ "$web_cert" = ok ]; then
		say "  手机的网页端：${web}（证书是 Let's Encrypt 签的，到期前自己续；以前配的手机用它。新配手机用 iPhone 上的 cca App：cca remote pair --web）"
		webmsg="；手机的网页端：${web}"
	elif [ -n "$web" ]; then
		warn "手机的网页端（${web}）的证书还没拿到：证书机构要从公网连这台服务器的 80 端口（安全组里放行 TCP 80）；服务器上的证书助手过一会儿自己再试，拿到了就能用"
		webmsg="；手机的网页端的证书还没拿到（安全组里放行 TCP 80）"
	else
		case "$web_off" in
			port80) warn "手机的网页端没开：服务器上 80 端口被别的程序占着（证书助手要用它向 Let's Encrypt 要证书）。腾出来以后再部署一次"
				webmsg="；手机的网页端没开：服务器上 80 端口被占着" ;;
			acme_old) warn "手机的网页端没开：服务器上 80 端口被另一个 Team 的证书助手占着（那个 Team 是用以前的 cca 部署的，上面说了是哪个）。先用这一版 cca 重新部署那个 Team（它会改用这台服务器上几个 Team 共用的证书助手），再部署这一个"
				webmsg="；手机的网页端没开：服务器上 80 端口被另一个 Team 以前的证书助手占着" ;;
			lan) warn "手机的网页端没开：${host%:*} 是内网地址，证书机构连不过来" ;;
			host) warn "手机的网页端没开：认不出服务器的公网地址（加上 --host 公网地址 再部署一次）" ;;
			web_port) warn "手机的网页端没开：服务器上网页端的端口被别的程序占着（换一个：--web-port 端口）" ;;
		esac
	fi
	[ -z "$note" ] || team_forward_warn "$note"
	[ -z "$lan" ] || fail_warn team_lan "${host%:*} 是内网地址：别的设备不在这个网络里时连不上（有公网地址的话：cca team deploy ${tid:0:8} ${target} --host 公网地址）"
	team_settle
	gui_done team_deployed "「${name}」的同步服务器$([ "$state" = update ] && printf 已更新 || printf 已部署)（${host}）${webmsg}"
}

team_hosted() {   # cca team hosted Team [railway] [--dir 目录]：没有服务器时把 Team 的同步服务器部署到托管平台（只有 Railway，不写就是它）。
	                # 生成部署文件，打出步骤（照着在平台上做），最后把平台给的公网地址交给 cca team attach。只在终端里（App 里还没有这一页）
	local sel platform=railway args=() out a dir="" steps="" tid="" name="" svc=""
	[ $# -ge 1 ] || FAIL_CODE=team_usage die "用法: cca team hosted Team [railway] [--dir 目录]"
	sel=$1; shift
	while [ $# -gt 0 ]; do
		case "$1" in
			--dir) [ $# -ge 2 ] || FAIL_CODE=team_usage die "用法: cca team hosted Team [railway] [--dir 目录]"; args+=(--dir "$2"); shift ;;
			railway|sealos) platform=$1 ;;   # sealos 照样交给辅助程序：它说不再支持、换成什么（team_usage）
			*) FAIL_CODE=team_usage die "用法: cca team hosted Team [railway] [--dir 目录]" ;;
		esac
		shift
	done
	out=$(py team-hosted "$sel" "$platform" ${args[@]+"${args[@]}"}) || team_fail "$out" "没生成成部署文件"
	eval "$out"   # dir steps tid name svc
	okay "「${name}」的同步服务器的部署文件生成在 ${dir}（说明在里面的 README.md）。照下面做："
	printf '%s\n' "$steps" | sed 's/^/    /' >&2
	say "  部署好以后，把平台给的公网地址（https://…）接上："
	say "    cca team attach ${tid:0:8} https://平台给的地址"
	say "  新版 cca 带着新版的服务端程序：再运行一次 cca team hosted ${tid:0:8}，照 README.md 的「更新」做"
}

team_attach() {   # cca team attach Team https://服务器:端口 [证书公钥的指纹…]
	local out host device members stored note
	[ $# -ge 2 ] || die "用法: cca team attach Team https://服务器:端口 [证书公钥的指纹…]"
	out=$(py team-attach "$@") || team_fail "$out" "没接上"
	{ IFS= read -r host; IFS= read -r device; IFS= read -r members; IFS= read -r stored; IFS= read -r note; } <<< "$out"
	okay "接上了 ${host}：这台设备叫 ${device}，现在有 ${members} 台设备；$(team_stored "$stored")"
	[ -z "$note" ] || team_forward_warn "$note"
	team_settle
}

team_forward_warn() {   # 换了服务器，原来那台上没收尾成（$1 是辅助程序说的原因）
	fail_warn team_forward "原来那台服务器上没收尾成（${1}）：还连着它的设备找不到新的服务器，要重新邀请；那台上还没用掉的邀请也没撤回"
}

team_invite() {   # cca team invite Team 名字 [--accounts …] [--ttl 秒]：邀请链接打到 stdout（只这一次）。它是凭证：在 Claude Code 的会话里不给
	local out link dev problem
	[ $# -ge 2 ] || die "用法: cca team invite Team 给这台设备起的名字 [--accounts all|工具:邮箱,…] [--ttl 秒]"
	if [ -n "${CLAUDECODE:-}" ] && [ -z "${CCA_EVENTS:-}" ]; then
		die "在 Claude Code 里不显示邀请链接（会进对话记录）：请在终端里运行"
	fi
	out=$(py team-invite "$@") || team_fail "$out" "没发成"
	{ IFS= read -r link; IFS= read -r dev; IFS= read -r problem; } <<< "$out"
	[ -z "$problem" ] || fail_warn team_publish "邀请发了，给它的配置还没存上（${problem}）：解决以后 cca team publish"
	say "给「${2}」的邀请（只显示这一次；只能加入一台设备，默认 7 天过期。它就是那台设备的密钥：当密码传，别贴到群里）："
	printf '%s\n' "$link"
	say "对方运行 cca team join，贴上这一行。"
}

team_devices() {   # cca team devices Team [--json]：先和服务器对一遍，再列出来
	local out lock dev label state grants seq have problem cfg
	case "$#:${2:-}" in
		1:) ;;
		2:--json) out=$(py team-devices "$1" --json) || team_fail "$out" "没问到"; printf '%s\n' "$out"; return ;;
		*) die "用法: cca team devices Team [--json]" ;;
	esac
	out=$(py team-devices "$1") || team_fail "$out" "没问到"
	{
		IFS= read -r lock   # 第一行：账号的别名锁定着没有（1 | 0）
		while IFS=$'\t' read -r dev label state grants seq have problem role; do   # 没有的栏是 -
			cfg=""
			case "$state" in   # 配置是不是最新的：只说还在的设备（不说第几版：序号只是用来比新旧的）
				local|invited|joined)
					case "$seq:$have" in
						-:*|0:*) cfg="配置还没发布" ;;
						*:-) cfg="配置发布了" ;;
						*) if [ "$have" -ge "$seq" ] 2>/dev/null; then cfg="配置是最新的"; else cfg="还没同步到最新的配置"; fi ;;
					esac ;;
			esac
			case "$role" in owner) role="，建 Team 的设备" ;; admin) role="，管理员" ;; *) role="" ;; esac
			say "${label}（${dev:0:8}）：${state}${role}，${grants}${cfg:+，${cfg}}"
			[ "$problem" = - ] || warn "${label}：${problem}"
		done
	} <<< "$out"
	[ "$lock" != 1 ] || say "账号的别名锁定着：各台设备上不能自己改（cca team alias ${1} --unlock 解开）"
}

team_admin() {   # cca team admin Team [ls] | add 设备 | remove 设备：几位管理员（docs/dev/team.md「几位管理员」）。add、remove 先问同意
	local out tid dev label role why item title question n
	case "$#:${2:-ls}" in
		1:ls|2:ls)
			out=$(py team-admin ls "$1") || team_fail "$out" "没问到"
			while IFS=$'\t' read -r dev label role; do
				[ -n "$dev" ] || continue
				case "$role" in owner) say "${label}（${dev:0:8}）：建 Team 的设备（拿着根密钥）" ;; *) say "${label}（${dev:0:8}）：管理员" ;; esac
			done <<< "$out"
			return ;;
		3:add|3:remove) ;;
		*) FAIL_CODE=team_usage die "用法: cca team admin Team [ls] | add 设备 | remove 设备" ;;
	esac
	out=$(py team-admin plan "$2" "$1" "$3") || team_fail "$out" "没改成"
	IFS=$'\t' read -r tid dev label <<< "$out"
	if [ "$2" = add ]; then
		item=team_admin_add title="授予管理员身份" question="让「${label}」也成为这个 Team 的管理员吗？"
		why="它会拿到这个 Team 的全部设置：主密钥（能算出每台设备的配置的密钥）、所有账号走哪个节点、节点的密码。它能邀请、移除设备，改账号、节点并发布给各台设备；不能删除 Team、换服务器，也不能再授予别人。以后收回，它已经看过的收不回来。各台设备要更新到 3.6.15 以后，才认它发布的配置"
	else
		item=team_admin_remove title="收回管理员身份" question="收回「${label}」的管理员身份吗？"
		why="服务器就此不认它的管理员操作，管理员的密钥换一把、各台设备的配置重新发布。它已经看过的主密钥和节点的密码收不回来：要紧的话换掉节点的密码，必要时移除它、给各台设备重新发邀请"
	fi
	[ -n "$PROMPT_GUI" ] || say "  ${why}"
	consent "$item" "$dev" "$title" "$question" "$why" n
	case $? in
		0) ;;
		1) say "已取消"; gui_cancelled; return 1 ;;
		*) die "要先同意：在终端里运行 cca team admin（会先问你）" ;;
	esac
	out=$(py team-admin "$2" "$1" "$3") || team_fail "$out" "没改成"
	n=$(team_stored "$out")
	if [ "$2" = add ]; then
		okay "「${label}」现在是管理员了；${n}（它下次同步配置时拿到管理员的身份）"
		gui_done team_admin_added "「${label}」现在是管理员了"
	else
		okay "收回了「${label}」的管理员身份；${n}"
		gui_done team_admin_removed "收回了「${label}」的管理员身份"
	fi
}

team_revoke() {   # cca team revoke Team 设备：移除一台设备（或者撤回还没用掉的邀请）。先问
	[ $# -eq 2 ] || die "用法: cca team revoke Team 设备"
	local out tid dev label state why
	out=$(py team-revoke plan "$1" "$2") || team_fail "$out" "没有这台设备"
	IFS=$'\t' read -r tid dev label state <<< "$out"
	why="服务器就此不认「${label}」的密钥，给它的配置、它同步过的折合金额都删掉，这里也不再列出它。它已经拿到的节点凭证收不回来：要紧的话换掉那些节点的凭证"
	[ -n "$PROMPT_GUI" ] || say "  ${why}"
	consent team_revoke "$dev" "移除设备" "从 Team 里移除「${label}」吗？" "$why" n
	case $? in
		0) ;;
		1) say "已取消"; gui_cancelled; return 1 ;;
		*) die "要先同意：在终端里运行 cca team revoke（会先问你）" ;;
	esac
	out=$(py team-revoke apply "$tid" "$dev") || team_fail "$out" "没移除成"
	okay "已移除「${label}」"
	gui_done team_revoked "已移除「${label}」"
}

# 部署 Team 的同步服务器（cca team deploy）、删除 Team 时卸载它（cca team leave）时问服务器、查登录、问密码、给出加公钥那一行的几段
# （docs/dev/team.md「部署」「删除 Team」）。名字、题号里的 hub（hub.deploy、hub.password、hub.pubkey，原因码 hub_ssh、
# 交给终端的 hub_deploy）是原来部署自己的同步服务器时起的，照旧（PROTOCOL 4.1、4.6）。是哪个 Team、部署还是卸载由这几项说
# （team_deploy、team_undeploy 设好）
# ---------------------------------------------------------------------------
DEPLOY_PY=(team-deploy)       # 辅助程序的子命令，后面跟着 Team 的编号
DEPLOY_WORDS=(team deploy)    # cca 后面的那几个词：给人看的、交给终端的命令
DEPLOY_WHAT="Team 的同步服务器"  # 说话时怎么叫它
DEPLOY_FAIL=team_fail         # 没成时照它给原因码（team_…）
DEPLOY_AT=""                  # 预填的服务器地址（这个 Team 现在接着的那一台）
DEPLOY_MSG=""                 # 表单上面的说明
DEPLOY_VERB=部署              # 说给人听的那个词：部署 | 卸载（「在终端里部署」「密码只用在这一次部署」）
DEPLOY_SOFT=""                # 卸载时：登录不上不 die，原因码、原因放进 DEPLOY_CODE、DEPLOY_WHY（hub_ask_fail），调用的接着问要不要照样删
DEPLOY_CODE="" DEPLOY_WHY=""
DEPLOY_REC="" DEPLOY_REC_PORT="" DEPLOY_REC_ID="" DEPLOY_REC_DIR=""   # 部署时记下的那台：目标、SSH 端口、私钥（文件还在的）、目录（team_deploy 设好）

hub_target_set() { case "$1" in *@*) F_user=${1%@*} F_host=${1##*@} ;; *) F_user="" F_host=$1 ;; esac; F_port=${2:-}; F_ident=${3:-}; }   # [用户@]主机 [端口] [私钥] 拆进 F_user F_host F_port F_ident
hub_target() { printf '%s' "${F_user:+${F_user}@}${F_host}"; }   # F_user F_host 拼回 [用户@]主机（没写用户是空的：照 ssh 的配置）

hub_ask_fail() {   # hub_ask_fail 原因码 原因 | hub_ask_fail - 辅助程序的输出 默认的说法：登录不上、问不下去了。部署时 die（- 是照 DEPLOY_FAIL 给
	                 # 原因码：team_…）；卸载（DEPLOY_SOFT）时不 die：原因码、原因放进 DEPLOY_CODE、DEPLOY_WHY，返回 2
	if [ "$1" = - ]; then
		[ -n "$DEPLOY_SOFT" ] || "$DEPLOY_FAIL" "$2" "$3"
		case "$2" in
			*$'\t'*) set -- "team_${2%%$'\t'*}" "${2#*$'\t'}" ;;
			*) set -- "" "${2:-$3}" ;;
		esac
	fi
	[ -n "$DEPLOY_SOFT" ] || FAIL_CODE=$1 die "$2"
	DEPLOY_CODE=$1 DEPLOY_WHY=$2
	return 2
}

hub_deploy_ask() {   # App 里 cca team deploy 不写服务器（提问会话）：地址、SSH 用户、端口一页（hub.deploy；部署时记下的那台预填它——记下的没写用户
	                   # 的用户是空的，照 ssh 的配置；没记下、接着服务器的预填它的地址、root、22），结果在 F_host F_user F_port。填的就是记下的那台时照
	                   # 部署时写的私钥（F_ident：App 里没法写 -i）。接着查登录得上不（辅助程序的 --check，什么都不动）：连不上的带着原因重问，
	                   # 登录不了的照 hub_login_more（问密码、给出加公钥那一行）。终端里不问：服务器写在命令行上，ssh 自己问密码、问要不要认这台主机
	local err="" out msg=$DEPLOY_MSG
	F_host=$DEPLOY_AT F_user=root F_port=22
	[ -z "$DEPLOY_REC" ] || hub_target_set "$DEPLOY_REC" "${DEPLOY_REC_PORT:-22}"
	[ -z "$DEPLOY_REC_ID" ] || msg="${msg}登录 ${DEPLOY_REC} 照部署时写的私钥（${DEPLOY_REC_ID}）。"
	while :; do
		ask_fields hub.deploy "部署${DEPLOY_WHAT}" "$msg" \
			"host|text|host||服务器地址|IP 或者域名，例如 203.0.113.7|${F_host}|${err}" \
			"user|text?|sshuser||SSH 用户|root，或者能免密码 sudo 的用户；空着照 ssh 的配置（~/.ssh/config）|${F_user}" \
			"port|text|port||SSH 端口||${F_port}" || return 1
		F_ident=""
		[ "$(hub_target)" != "$DEPLOY_REC" ] || F_ident=$DEPLOY_REC_ID
		out=$(py "${DEPLOY_PY[@]}" "$(hub_target)" --ssh-port "$F_port" ${F_ident:+--identity "$F_ident"} --batch --check) && return 0
		case "${out%%$'\t'*}" in
			ssh) err=${out#*$'\t'} ;;   # 连不上：地址、端口写错了？带着原因重问
			*) hub_login_more "$out"; return ;;
		esac
	done
}

hub_login() {   # 服务器已经定了（F_host F_user F_port，F_ident 是部署时写的私钥：删除 Team 时卸载它的同步服务器）的提问会话：查登录得上不，
	              # 登录不了的照 hub_login_more；连不上不重问地址（hub_ask_fail）。返回同 hub_login_more
	local out
	out=$(py "${DEPLOY_PY[@]}" "$(hub_target)" ${F_port:+--ssh-port "$F_port"} ${F_ident:+--identity "$F_ident"} --batch --check) && return 0
	hub_login_more "$out"
}

hub_login_more() {   # hub_login_more 辅助程序的输出：提问会话里 --batch --check 没登录上以后。这台设备的密钥登录不了、服务器认密码：问密码
	                   # （hub.password，错了重问，最多三次），放进调用者的 pw（部署、卸载时经 SSH_ASKPASS 给 ssh，见 askpass_run）；只认密钥、不认
	                   # 这台设备的：说怎么把公钥加到服务器上（hub_pubkey_ask）；别的（主机密钥和记下的不一样、连不上）照 hub_ask_fail。
	                   # 返回 0 登录得上；1 取消了；2 登录不上（DEPLOY_SOFT 时）
	local out=$1 perr="" tries=0 hint="" rc who="这台 Mac 的 SSH 密钥"
	[ -z "${F_ident:-}" ] || who="私钥 ${F_ident} "
	case "${out%%$'\t'*}" in
		ssh_auth) ;;
		# 照部署时写的私钥（F_ident）登录不了、服务器只认密钥：这台设备默认的那把加到服务器上也没用（ssh 只试写的那把），私钥有密码的话
		# App 里也没法输——不问加公钥那一页，算登录不上（原因里说是哪把私钥、在终端里怎么做）
		ssh_keyonly) [ -z "${F_ident:-}" ] || { hub_ask_fail hub_ssh "${out#*$'\t'}"; return; }
			hub_pubkey_ask; rc=$?; [ $rc -eq 3 ] || return $rc ;;   # 加好了登录上了（0）；这回认密码了（3）：接着问密码
		ssh*) hub_ask_fail hub_ssh "${out#*$'\t'}"; return ;;
		*) hub_ask_fail - "$out" "没登录上 ${F_host}"; return ;;
	esac
	# 很多系统默认不让 root 用密码登录（PermitRootLogin prohibit-password），服务器还是照样问密码：密码对了也说不对，从这边分不出来
	if [ "$F_user" = root ] && [ -n "$DEPLOY_SOFT" ]; then
		hint="服务器多半不让 root 用密码登录：在终端里用能免密码 sudo 的用户${DEPLOY_VERB}（cca ${DEPLOY_WORDS[*]} 用户@${F_host}）"
	elif [ "$F_user" = root ]; then
		hint="服务器多半不让 root 用密码登录，SSH 用户换成能免密码 sudo 的那个再${DEPLOY_VERB}"
	fi
	while :; do
		pw=$(ask_secret "$(hub_target) 的密码" q=hub.password "title=登录服务器" \
			"message=${who}登录不了 ${F_host}，用密码登录：密码只用在这一次${DEPLOY_VERB}，不保存，也不在服务器上留下公钥。" \
			label=密码 "error=$perr") || return 1
		out=$(askpass_run "$pw" py "${DEPLOY_PY[@]}" "$(hub_target)" ${F_port:+--ssh-port "$F_port"} --askpass --check) && return 0
		case "${out%%$'\t'*}" in
			ssh_denied)   # 密码不对：重问，最多三次（错得太多，服务器上的 fail2ban 这类会封这个地址）
				tries=$((tries + 1))
				[ "$tries" -lt 3 ] || { hub_ask_fail hub_ssh "试了 3 次都没用密码登录上 $(hub_target)${hint:+：密码没错的话，${hint}}"; return; }
				perr="密码不对，再试一次${hint:+（密码没错也这样的话：${hint}）}" ;;
			ssh*) hub_ask_fail hub_ssh "${out#*$'\t'}"; return ;;
			*) hub_ask_fail - "$out" "没登录上 ${F_host}"; return ;;
		esac
	done
}

hub_deploy_where() {   # 终端里 cca team deploy 不写服务器：问地址、SSH 用户、端口（部署时记下的那台预填它的；没记下的预填接着的服务器的地址、root、
	                     # 22），结果在 F_host F_user F_port；地址留空是取消。登录交给 ssh 自己问（密码、私钥的密码、要不要认这台主机）
	local def=$DEPLOY_AT duser=root dport=22 v out
	if [ -n "$DEPLOY_REC" ]; then
		hub_target_set "$DEPLOY_REC" "${DEPLOY_REC_PORT:-22}"
		def=$F_host duser=$F_user dport=$F_port   # 记下的没写用户：留空，照 ssh 的配置
	fi
	say "部署${DEPLOY_WHAT}：经 SSH 装到你自己的 Linux 服务器上（要用 root 登录，或者能免密码 sudo 的用户；云服务商的安全组里要放行它的端口，默认 TCP 18445）"
	while :; do
		v=$(ask "服务器地址（IP 或者域名）${def:+ [${def}]}: " "$def")
		[ -n "$v" ] || { say "  已取消"; return 1; }
		out=$(py check host "$v") && { F_host=$out; break; }
		warn "$out"
	done
	while :; do
		v=$(ask "SSH 用户 [${duser:-照 ssh 的配置}]: " "$duser")
		out=$(py check sshuser "$v") && { F_user=$out; break; }
		warn "$out"
	done
	while :; do
		v=$(ask "SSH 端口 [${dport}]: " "$dport")
		out=$(py check port "$v") && { F_port=$out; break; }
		warn "$out"
	done
}

hub_key_file() {   # 这台设备给 ssh 用的密钥（ssh 默认会试的那几把里第一把有公钥文件的，ed25519 优先）：打出私钥的路径；没有返回 1
	local f
	for f in id_ed25519 id_ecdsa id_rsa; do
		[ -f "$HOME/.ssh/$f" ] && [ -f "$HOME/.ssh/$f.pub" ] && { printf '%s' "$HOME/.ssh/$f"; return 0; }
	done
	return 1
}

hub_pubkey_spec() {   # hub_pubkey_ask 的那一页（hub.pubkey，给 py prompt-emit；变量是 hub_pubkey_ask 的）。单独一个函数：bash 3.2 在 $(…) 里解析不了 case 的右括号
	local t pass="选「在终端里${DEPLOY_VERB}」：在那里输私钥的密码"
	t=$(hub_target)
	if [ -n "$key" ]; then
		gui_kv "q=hub.pubkey" "title=把这台 Mac 的公钥加到服务器上" \
			"message=${F_host} 不认这台 Mac 的 SSH 密钥，也不让用密码登录。用云服务商网页上的远程登录（控制台里的「登录」「VNC」这类）登进服务器，以 ${F_user:-你登录的用户} 运行下面这一行（把这台 Mac 的公钥 ~/.ssh/${key##*/}.pub 加进 ~/.ssh/authorized_keys），再回来选「加好了，再试」"
		gui_kv field=cmd kind=code "label=在服务器上运行" "hint=点复制，粘贴进服务器的终端" "error=$err"
		printf 'code=%s\n' "$line"
		gui_kv field=next kind=choice "label=加好了以后" default=retry \
			"opt=retry"$'\t'"加好了，再试"$'\t'"再查一次登录得上不，登录上了接着${DEPLOY_VERB}" \
			"opt=terminal"$'\t'"在终端里${DEPLOY_VERB}"$'\t'"这把私钥有密码、App 里用不了时：在终端里运行 cca ${DEPLOY_WORDS[*]} ${t}，在那里输私钥的密码"
	else
		gui_kv "q=hub.pubkey" "title=这台 Mac 还没有 SSH 密钥" \
			"message=${F_host} 只认 SSH 密钥、不让用密码登录，这台 Mac 上还没有密钥（~/.ssh/id_ed25519 这类）。生成一把以后，下一页给出把它加到服务器上的那一行。别的地方有能登录这台服务器的私钥的话，${pass}（ssh 的配置里写好 IdentityFile，或者 cca ${DEPLOY_WORDS[*]} ${t} -i 私钥）"
		gui_kv field=next kind=choice "label=怎么办" default=keygen "error=$err" \
			"opt=keygen"$'\t'"生成一把密钥"$'\t'"~/.ssh/id_ed25519（ed25519，没有密码），只在这台 Mac 上" \
			"opt=terminal"$'\t'"在终端里${DEPLOY_VERB}"$'\t'"用别的私钥：在终端里运行 cca ${DEPLOY_WORDS[*]} ${t}"
	fi
}

hub_pubkey_ask() {   # App 里部署（卸载）时服务器只认密钥、不认这台设备的（ssh_keyonly）：一页（hub.pubkey）给出在服务器上运行的那一行（把这台设备的
	                   # 公钥加进 authorized_keys），选「加好了，再试」再查登录得上不，还不行带着原因重问；这台设备还没有密钥的先问要不要生成一把（ed25519，
	                   # 没有密码）；私钥有密码（App 里没法输）、要用别的私钥的选「在终端里部署（卸载）」：terminal 事件带上服务器（cca team deploy Team
	                   # 目标 -p 端口；卸载是 cca team leave Team 目标 -p 端口），退出码非 0，App 交给终端。登录得上返回 0；服务器这回认密码了返回 3（接着问
	                   # 密码）；别的登录不上照 hub_ask_fail（卸载时返回 2）。变量是 hub_login_more 的（F_host F_user F_port、out）
	local key line seq err=""
	while :; do
		key=$(hub_key_file) || key=""
		line=""
		[ -z "$key" ] || line="mkdir -p ~/.ssh && chmod 700 ~/.ssh && echo $(shq "$(head -n 1 "$key.pub")") >> ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys"
		seq=$(hub_pubkey_spec | py prompt-emit) || gui_abort
		gui_answer "$seq" next
		case "$ANSWER" in
			terminal)
				gui_terminal hub_deploy "${F_host} 只认 SSH 密钥：在终端里${DEPLOY_VERB}（私钥有密码的话在那里输）" "${DEPLOY_WORDS[@]}" "$(hub_target)" ${F_port:+-p "$F_port"}
				FAIL_CODE=hub_ssh die "在终端里运行 cca ${DEPLOY_WORDS[*]} $(hub_target)${F_port:+ -p ${F_port}}" ;;
			keygen)
				err=""
				if [ -e "$HOME/.ssh/id_ed25519" ]; then err="~/.ssh/id_ed25519 已经有了，但旁边没有它的公钥文件（id_ed25519.pub）：在终端里运行 ssh-keygen -y -f ~/.ssh/id_ed25519 > ~/.ssh/id_ed25519.pub 补上"; continue; fi
				mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh" \
					&& ssh-keygen -q -t ed25519 -N '' -f "$HOME/.ssh/id_ed25519" </dev/null >/dev/null 2>&1 \
					|| err="没生成成密钥（ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519 没成）"
				continue ;;
			retry) ;;
			*) gui_abort ;;
		esac
		out=$(py "${DEPLOY_PY[@]}" "$(hub_target)" ${F_port:+--ssh-port "$F_port"} --batch --check) && return 0
		case "${out%%$'\t'*}" in
			ssh_keyonly) err="还是登录不了：服务器还不认这把公钥（加给了 ${F_user:-登录的用户} 吗？authorized_keys 和 ~/.ssh 的权限对吗？）" ;;
			ssh_auth) return 3 ;;   # 这回认密码了（服务器改了设置）：回去问密码
			ssh*) hub_ask_fail hub_ssh "${out#*$'\t'}"; return ;;
			*) hub_ask_fail - "$out" "没登录上 ${F_host}"; return ;;
		esac
	done
}

hub_leftovers() {   # 3.5.3 去掉了自己的同步服务器（cca hub）：以前加入过、部署过的设备上留下的加入信息、这台设备在它上面的密钥、部署到
	                 # 托管平台时记着的口令、经它同步的状态都删掉（服务器上这台设备的记录不管：那台服务器用不着了）。main 看到 hub/、
	                 # hub-hosted.json 或者 hub-removed.json（被移除了时只剩它）还在时调
	rm -rf "$CCA_HOME/hub" 2>/dev/null
	rm -f "$CCA_HOME/hub-hosted.json" "$CCA_HOME/hub-removed.json" "$CCA_HOME"/presence/own.* "$CCA_HOME"/cost/own.* 2>/dev/null
	return 0
}

policy_leftovers() {   # 3.6.0 去掉了维护者的映射（维护者私有仓库里的账号 → 节点映射、每台机器一把 deploy key；改用 Team）：以前打开过共享的设备上
	                    # 留下的映射、参考节点、deploy key、拉取的记录，经维护者的服务器同步的状态（没有 team.<编号>. 前缀的设备统计、记下的
	                    # API key、折合金额），映射里的 Team 邀请（teams/adopt.*），config.json 里的开关（py policy-retire）都删掉。映射里的账号
	                    # 照旧留在账号表里，出口不再受映射约束（迁到了 Team 的设备，Team 照旧给这些账号）；共享开着、又没加入任何 Team 的设备
	                    # 说一声怎么加入。main 看到 policy/ 还在时调；config.json 没改成（只读、读不了、写不进去）就留着 policy/，下一条命令再来（别的命令拿着
	                    # sync.lock 时等它放开）
	local alone
	alone=$(py policy-retire 2>/dev/null) || return 0
	rm -rf "$CCA_HOME/policy" 2>/dev/null
	rm -f "$CCA_HOME/presence/status.json" "$CCA_HOME/presence/keys.json" "$CCA_HOME/presence/keys.lock" "$CCA_HOME/presence/keys-sync.lock" \
		"$CCA_HOME/cost/sync.json" "$CCA_HOME/cost/remote.json" "$CCA_HOME/teams/adopt.json" "$CCA_HOME/teams/adopt.lock" 2>/dev/null
	[ -z "$alone" ] || warn "维护者共享的账号（cca policy）3.6.0 起去掉了，改用 Team：这台设备还没加入 Team，向管理员要一个邀请链接，运行 cca team join 加入（账号表里的账号照旧能用）"
	return 0
}

hub_deploy_run() {   # hub_deploy_run 目标 参数…：部署一次，辅助程序的输出放进 out；App 里问过密码的（team_deploy 的 pw）经 SSH_ASKPASS 给 ssh
	if [ -n "$pw" ]; then out=$(askpass_run "$pw" py "${DEPLOY_PY[@]}" "$@" --askpass)
	else out=$(py "${DEPLOY_PY[@]}" "$@"); fi
}

cmd_policy() {   # cca [codex] policy …：维护者共享的账号 3.6.0 起去掉了（改用 Team），只说一声。界面 App 不再调它：_gui state 的 config.policy
	               # 总是关着的样子（PROTOCOL 2.2）
	die "维护者共享的账号（cca policy）3.6.0 起去掉了，改用 Team：向 Team 的管理员要一个邀请链接，运行 cca team join 加入；自己的几台设备之间同步：cca team new"
}

pkg_hint() {   # pkg_hint 命令…：Linux 上装这些命令的那一行（认出包管理器时，前面带「：」）。和 install.sh 里的一样
	local pm p c out="" s=""
	on_linux || return 0
	# 包管理器可能在 sbin 里（Alpine 的 apk 在 /sbin），不在 PATH 里也认
	for pm in apt-get dnf yum zypper pacman apk ""; do
		[ -z "$pm" ] || command -v "$pm" >/dev/null 2>&1 || [ -x "/sbin/$pm" ] || [ -x "/usr/sbin/$pm" ] && break
	done
	for c in "$@"; do
		case "$pm:$c" in
			apt-get:ssh*) p=openssh-client ;;
			dnf:ssh*|yum:ssh*|zypper:ssh*) p=openssh-clients ;;
			pacman:ssh*) p=openssh ;;
			apk:ssh) p=openssh-client-default ;;
			apk:ssh-keygen) p=openssh-keygen ;;
			dnf:nc|yum:nc) p=nmap-ncat ;;
			pacman:nc) p=openbsd-netcat ;;
			*:nc) p=netcat-openbsd ;;
			*:gunzip) p=gzip ;;
			*:base64) p=coreutils ;;
			*:find) p=findutils ;;
			*) p=$c ;;
		esac
		case " $out " in *" $p "*) ;; *) out="${out:+$out }$p" ;; esac
	done
	[ "$(id -u)" = 0 ] || s="sudo "
	case "$pm" in
		apt-get) printf '：%sapt install %s' "$s" "$out" ;;
		dnf|yum|zypper) printf '：%s%s install %s' "$s" "$pm" "$out" ;;
		pacman) printf '：%spacman -S %s' "$s" "$out" ;;
		apk) printf '：%sapk add %s' "$s" "$out" ;;
	esac
}
need_deps() {   # 安装时查依赖：install.sh 下载之前查的是同一份（命令和 OpenSSH 的版本），两边一起改
	local c miss="" v
	# find：自动更新多久没查过、Team 的配置多久没同步过，清掉上次异常退出留下的锁（Amazon Linux、openSUSE 的最小安装没有它）
	for c in ssh ssh-keygen nc curl perl gunzip base64 find; do command -v "$c" >/dev/null 2>&1 || miss="${miss:+$miss }$c"; done
	[ -z "$miss" ] || die "缺少命令 ${miss// /、}，先装上再运行 cca install$(pkg_hint $miss)"
	# 校验更新的签名用 ssh-keygen -Y，OpenSSH 8.1 才有（RHEL / Rocky 8 是 8.0）；认不出版本（不是 OpenSSH）时不拦
	v=$(ssh -V 2>&1 | sed -n 's/^OpenSSH_\([0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | head -n 1)
	case "$v" in [1-7].*|8.0) die "OpenSSH 太旧（${v}）：cca 校验更新的签名要 8.1 或更新（ssh-keygen -Y）" ;; esac
	if on_linux; then warn "Linux 上能用的是命令行：账号的网络（路由器的端口池、cca 内置的代理）、登录（登录页在 Mac 上用账号专属的 Chrome 打开）、API key（存成权限 600 的文件）；桌面 App、网页版、图形界面这些只在 macOS 上"
	elif [ "$(uname)" != Darwin ]; then warn "本脚本按 macOS 编写（钥匙串、open、Chrome 路径），其它系统需自行调整"; fi
}

path_hint() {   # ~/.local/bin 不在 PATH 里：征得同意后写进 shell 的启动文件。macOS 的终端开的是登录 shell，bash 读 ~/.bash_profile；
	# Linux 上 bash 写 ~/.bashrc（Ubuntu、Debian 的 ~/.profile，Fedora、RHEL、Arch 的 ~/.bash_profile 都会读它；新建一个
	# ~/.bash_profile 反而会让 Ubuntu、Debian 的登录 shell 不再读 ~/.profile），sh、ash（Alpine）这些写 ~/.profile
	local bin="$1" rc="$HOME/.zshrc" again="打开一个新的终端标签"
	case "${SHELL:-}" in
		*/zsh) ;;
		*/bash) if on_linux; then rc="$HOME/.bashrc"; else rc="$HOME/.bash_profile"; fi ;;
		*) on_linux && rc="$HOME/.profile" ;;
	esac
	on_linux && again="重新登录（或者运行 . ~/${rc##*/}）后"
	if grep -qs '\.local/bin' "$rc"; then
		warn "${bin} 已经写在 ${rc} 里，只是当前终端还没生效：${again}再用 cca"
	elif confirm "把 ${bin} 加进 PATH（写入 ${rc}），以后直接输入 cca 就能用？" y; then
		printf '\n%s\n%s\n' "$PATH_MARK" "$PATH_LINE" >> "$rc" || return 1
		info "已写入 ${rc}"
		CCA_PATH_ADDED="$again"
	else
		warn "${bin} 不在 PATH 里：可以用 ${bin}/cca 运行，或者自己把它加进 PATH"
	fi
}
# path_hint 写进启动文件的那两行（前面还有一个空行）。path_unhint 照这两行原样找：改了这里，以前写下的就认不出来了
PATH_MARK='# cca（Claude Code 多账号）'
PATH_LINE='export PATH="$HOME/.local/bin:$PATH"'
path_unhint() {   # 卸载时把 path_hint 写下的那两行（连同前面那个空行）去掉。只认一字不差、挨在一起的两行：用户改过的不动。
	# ~/.local/bin 里还有别的命令时留着（claude、codex 的官方安装器也装在那：去掉了它们就不在 PATH 里了）；
	# 启动文件是链接（dotfiles 管着的）时不改，说一声。四个文件都看：装的时候用的 shell 和现在的可能不一样
	local bin="$HOME/.local/bin" rc tmp line n i hit from bad kept=""
	local -a L
	rmdir "$bin" 2>/dev/null   # 空了（只放过 cca、cxa、aga）就删掉；里面还有东西时删不掉，正好
	[ -z "$(ls -A "$bin" 2>/dev/null)" ] || kept=1
	for rc in "$HOME/.zshrc" "$HOME/.bash_profile" "$HOME/.bashrc" "$HOME/.profile"; do
		[ -f "$rc" ] || continue
		L=(); n=0; hit=""
		while IFS= read -r line || [ -n "$line" ]; do L[n]="$line"; n=$((n + 1)); done < "$rc"
		i=0
		while [ "$i" -lt $((n - 1)) ]; do
			if [ "${L[i]}" = "$PATH_MARK" ] && [ "${L[i + 1]}" = "$PATH_LINE" ]; then hit=$i; break; fi
			i=$((i + 1))
		done
		[ -n "$hit" ] || continue
		if [ -n "$kept" ]; then info "${rc} 里把 ~/.local/bin 加进 PATH 的那两行留着：那个目录里还有别的命令。不要了自己删"; continue; fi
		if [ -L "$rc" ]; then warn "${rc} 是个链接，没有改：里面 cca 加的那两行（「${PATH_MARK}」和它下面一行）自己删掉"; continue; fi
		from=$hit
		[ "$hit" -eq 0 ] || [ -n "${L[hit - 1]}" ] || from=$((hit - 1))
		tmp="$rc.cca.$$"; bad=""   # 先拷一份（权限跟着），内容写好了再换上去：写到一半出错不会把原来的弄坏
		cp -p "$rc" "$tmp" 2>/dev/null || bad=1
		if [ -z "$bad" ]; then
			i=0
			while [ "$i" -lt "$n" ]; do
				if [ "$i" -lt "$from" ] || [ "$i" -gt $((hit + 1)) ]; then printf '%s\n' "${L[i]}" || { bad=1; break; }; fi
				i=$((i + 1))
			done > "$tmp" || bad=1
		fi
		if [ -z "$bad" ] && mv -f "$tmp" "$rc"; then
			info "已从 ${rc} 去掉 cca 加的那两行"
		else
			rm -f "$tmp"
			warn "没能改 ${rc}：里面 cca 加的那两行（「${PATH_MARK}」和它下面一行）自己删掉"
		fi
	done
	return 0
}

tool_alias_ensure() {   # tool_alias_ensure codex|agy [账号名] [quiet]：没有就建这个工具的简写 ~/.local/bin/cxa、aga（指向同目录 cca 的
	                      # 相对链接，cca 指向哪它就跟到哪）；那里已经有别的文件、或者 PATH 里已经有别的同名命令时不建，提示一句。
	                      # quiet 是平时每次运行时的检查：那里有东西（不管是不是 cca 建的）就不动，建不了也不说，免得每次都提示。总是返回 0
	local bin="$HOME/.local/bin" other quiet="${3:-}" name more=""
	case "$1" in
		codex) name=$CODEX_ALIAS more="，${CODEX_ALIAS} usage 查用量" ;;
		agy) name=$AGY_ALIAS more="，${AGY_ALIAS} usage 查额度" ;;
		*) return 0 ;;
	esac
	if [ -n "$quiet" ]; then { [ -e "$bin/$name" ] || [ -L "$bin/$name" ]; } && return 0; fi
	[ "$(readlink "$bin/$name" 2>/dev/null)" = cca ] && return 0
	[ -e "$bin/cca" ] || return 0   # cca 没装在 ~/.local/bin 里（直接运行的这份脚本）：不建
	if [ -e "$bin/$name" ] || [ -L "$bin/$name" ]; then
		warn "${bin}/${name} 已经存在，不是 cca 建的：没有建 ${name} 这个简写（照样可以用 cca ${1}）"
		return 0
	fi
	other=$(type -P "$name" 2>/dev/null)
	if [ -n "$other" ]; then
		[ -n "$quiet" ] || warn "已经有别的 ${name} 命令（${other}）：没有建 ${name} 这个简写（照样可以用 cca ${1}）"
		return 0
	fi
	ln -s cca "$bin/$name" 2>/dev/null || { [ -n "$quiet" ] || warn "没能建 ${bin}/${name}（照样可以用 cca ${1}）"; return 0; }
	info "以后可以直接用 ${name} 代替 cca ${1}：${name} @${2:-别名} 直接启动${more}"
}

# ---------------------------------------------------------------------------
# 服务器上不用路由器（Linux；CCA_REMOTE_LOGIN=1 时 macOS 上也这样，测试用）：从没配置过路由器、直连不通（连不上，或者出口在受限地区）时，
# cca install、cca add 不问路由器，直接用内置代理。节点有两种来源（已经有可选节点时不问）：
#   · 先问一句有没有 Team 的邀请链接（默认没有）。有：加入 Team，节点用它的配置带的（加入时导入）；到了那一步留空是先不加入
#   · 没有：粘贴一条你自己的代理（分享链接，cca node add 那一套），当这台机器的可选节点
# 有了节点就配置好内置代理，再经它装 Claude Code
# ---------------------------------------------------------------------------
direct_probe() {   # 不经代理能用当前工具的服务吗：直连 TRACE_HOST 的 /cdn-cgi/trace 拿得到出口、出口不在受限地区。不能时返回 1，原因在 DIRECT_WHY
	local trace loc i name
	DIRECT_WHY=""
	for i in 1 2; do   # 有的网络会丢新连接：再试一次
		trace=$(curl -q --proxy '' --noproxy '*' -s --connect-timeout 5 -m 8 "https://${TRACE_HOST}/cdn-cgi/trace" 2>/dev/null)
		loc=$(printf '%s\n' "$trace" | sed -n 's/^loc=//p')
		[ -z "$loc" ] || break
	done
	if [ -z "$loc" ]; then DIRECT_WHY="直连 ${TRACE_HOST} 不通"; return 1; fi
	name=$(py restricted "$loc") || return 0
	DIRECT_WHY="直连 ${TRACE_HOST} 的出口在${name}，不能用"
	return 1
}
server_builtin() {   # 服务器上要不要直接用内置代理（不问路由器）：Linux（login_remote）、从没配置过路由器（没有地址）、本机客户端没配置或者
	                  # 就是内置代理、直连不通。要测一次直连（几秒）
	login_remote || return 1
	load_router
	[ -z "$ROUTER_HOST" ] || return 1
	case "$LOCAL_SET" in ''|builtin) ;; *) return 1 ;; esac
	info "正在检测这台机器能不能直连 ${TRACE_HOST}…"
	direct_probe || return 0
	okay "这台机器能直连 ${TRACE_HOST}"
	return 1
}
builtin_onboard() {   # builtin_onboard 接着配置的命令：服务器上直连不通、没配置过路由器时不配置路由器，改用 cca 内置的代理。
	                    # 先问一句有没有 Team 的邀请链接（默认没有；已经有可选节点时不问）：有就加入、导入 Team 的配置带的节点（builtin_team），
	                    # 没有就粘贴一条自己的代理（builtin_own）。有了节点就配置好内置代理、返回 0（内置代理没就绪只说一声：
	                    # 启动账号时还会再试）；没有（先跳过了、用不了）时说明之后再运行哪条命令接着配置
	local again="$1"
	say ""
	say "  ${C_B}${DIRECT_WHY:-直连不通}：这台机器不用配置路由器，改用 cca 内置的代理${C_0}"
	if ! core_possible; then
		warn "内置代理的内核只有 x86-64 和 arm64 的 Linux 版，这台是 $(uname -m)：用不了内置代理"
		return 1
	fi
	if [ -z "$(py nodes-allowed)" ]; then
		if confirm "有没有 Team 的邀请链接？" n "q=install.team" "title=节点从哪来" \
			"detail=有的话节点、账号由 Team 的管理员定；没有就粘贴一条你自己的代理当出口。"; then
			builtin_team "$again" || return 1
		else
			builtin_own "$again" || return 1
		fi
	fi
	core_setup || warn "内置代理还没就绪（原因见上面）：之后运行 cca local setup 再试，启动账号时 cca 也会再试"
	return 0
}
builtin_team() {   # builtin_team 接着配置的命令：加入 Team（邀请链接可以留空：先不加入），导入它的配置带的节点（加入时 team_settle 导入的）。
	                 # 有了可选节点返回 0
	( TEAM_JOIN_OPTIONAL=1 team_join ) || true   # 没加入成：原因已经说了
	[ -n "$(py nodes-allowed)" ] && return 0
	if [ -n "$(py team-list)" ]; then
		info "Team 的配置里还没有这台机器能用的节点（配置还没同步下来，或者管理员没给节点）：同步下来以后再运行 ${1} 接着配置（cca team sync 马上同步）"
	else
		info "加入 Team 以后再运行 ${1}，节点就用 Team 的配置带的；也可以现在粘贴一条自己的代理"
		builtin_own "$1" && return 0
	fi
	return 1
}
builtin_own() {   # builtin_own 接着配置的命令：没有 Team，粘贴一条自己的代理当这台机器的可选节点（内置代理经它出去）。加上了返回 0
	say "  节点用你自己的代理：粘贴一条代理链接，cca 内置的代理经它出去（之后还能用 cca node add 再加）"
	if ! node_add; then
		info "没加上节点：之后运行 cca node add 粘贴自己的代理，再运行 ${1} 接着配置"
		return 1
	fi
	okay "已加上你的代理：${ADDED_NODE}（这台机器的可选节点）"
}

# ---- 配置向导（cca _onboard，App 首次运行的引导）：① 加入 Team → ② 网络出口 → ③ 添加账号 ----
onboard_builtin() {   # 向导第 2 步选了「没有路由器（内置代理）」：本机的客户端用 cca 内置的代理（mihomo；macOS 26 起内核在界面 App 里跑）。
	                    # 节点是 Team 的配置带的（加入时导入了），或者第 3 步加账号时粘贴的自定义代理。用不了返回 1
	if ! core_possible; then gui_fail local_unavailable "这台机器用不了 cca 内置的代理（内核没有 $(uname -m) 的版本）：配置一个路由器"; return 1; fi
	py local-set client builtin >/dev/null || { gui_fail local_unavailable "配置内置代理失败"; return 1; }
	LOCAL_SET=builtin
	core_setup || true   # 自己发 gui_done local_ready / fail；端口池还空（没有账号）时不起内核
	return 0
}

ONB_TOOL=claude
onboard_add_one() {   # 向导第 3 步添加一个账号：这台 Mac 上装了 codex / agy 命令时先问加哪种（onboard.tool，默认 Claude Code；没装的不列），
	                   # 选了 Codex / Antigravity 就在子 shell 里切到那个工具（use_tool；还没有它的账号表时 py init 建出来，Team 给的随即加进来）
	                   # 再走 cmd_add。记下选的是哪种（ONB_TOOL：别的工具的账号不在 py keys 里，向导结束时照它判断要不要同步路由器）
	local opts=()
	ONB_TOOL=claude
	if [ -n "$CODEX_BIN" ] || [ -n "$AGY_BIN" ]; then
		opts=("opt=claude"$'\t'"Claude Code"$'\t'"Anthropic 的账号（Claude Pro、Max 这些套餐）")
		[ -z "$CODEX_BIN" ] || opts+=("opt=codex"$'\t'"Codex"$'\t'"OpenAI 的账号（ChatGPT Plus、Pro 这些套餐）")
		[ -z "$AGY_BIN" ] || opts+=("opt=agy"$'\t'"Antigravity"$'\t'"Google 账号（Google AI Pro、Ultra 这些套餐）")
		ONB_TOOL=$(gui_ask choice "添加哪种账号？" claude "q=onboard.tool" "title=${ONB_TITLE}" \
			"message=先加一个，别的工具的账号以后在侧栏里切到那个工具再添加。" "${opts[@]}") || return 1
	fi
	case "$ONB_TOOL" in
		codex|agy) ( use_tool "$ONB_TOOL"; [ -f "$TABLE" ] || py init; cmd_add ) ;;
		*) ONB_TOOL=claude; cmd_add ;;
	esac
}

onboard_title() {   # onboard_title 这一步的名字：向导的页标题 ONB_TITLE（第几步、共几步；只有一步时不写）。n 和要问哪几步（ask…）是 cmd_onboard 的
	local total=0 s
	n=$((n + 1))
	for s in "$askteam" "$asknet" "$askadd"; do [ -z "$s" ] || total=$((total + 1)); done
	if [ "$total" -gt 1 ]; then ONB_TITLE="第 ${n} 步（共 ${total} 步）：$1"; else ONB_TITLE="$1"; fi
}

cmd_onboard() {   # cca _onboard [--skip]：图形界面的配置向导（App 启动的提问会话，PROMPT_GUI 下跑），三步：
	                # ① 加入 Team（onboard.team：有没有 Team 的邀请链接，默认没有；答了有走 team join，那一页可以留空：先不加入。已经在 Team 里的
	                #   不问）；
	                # ② 网络出口（onboard.net：路由器 / 内置代理 / 先跳过；路由器、本机的客户端已经配好时不问）；
	                # ③ 添加账号（不要求配置了路由器：没有可选节点时选节点那步可以粘贴自定义代理）。
	                # 做完记下 onboarded（以后 App 不再弹向导）。--skip：不配置、只记下。取消（答案管道关掉）走 gui_abort：不记 onboarded，下次还能再来
	local mode team="" askteam="" asknet="" askadd="" keys0 keys1 k added="" n=0 det net_default net_msg
	if [ "${1:-}" = --skip ]; then py onboard-done; return 0; fi
	if [ -z "$PROMPT_GUI" ]; then info "配置向导在 cca App 里使用（或运行 ${SELF} install 在终端里配置）"; return 0; fi
	keys0=$(py keys)
	# 先定下要问哪几步（页标题写第几步、共几步，onboard_title 照它们数）：已经在 Team 里的不问 Team；路由器、本机的客户端配好了的不问网络出口
	[ -n "$(py team-list)" ] || askteam=1
	if ! router_ready && [ -z "$LOCAL_SET" ]; then asknet=1; fi
	# 添加账号：开始时还没有账号才问（那时加入的 Team 给了账号的，问还要不要再加一个自己的）；已经有账号的不问
	[ -n "$keys0" ] || askadd=1
	if [ -n "$askteam" ]; then   # ① 加入 Team
		onboard_title "加入 Team"
		if confirm "有没有 Team 的邀请链接？" n "q=onboard.team" "title=${ONB_TITLE}" \
			"detail=Team 的管理员定好账号和出口节点，给每台设备发一个邀请链接：加入以后账号自动加进来，各台设备的设备统计、折合金额、记下的 API key 经 Team 的服务器合在一起（服务器上只有密文）。没有就选「否」：自己的账号照常添加，以后也能在「共享与同步」里加入，或者自己建一个 Team。"; then
			( TEAM_JOIN_OPTIONAL=1 team_join ) || true   # 留空是先不加入；没加入成（链接不对以外的原因，失败已经报给 App）：向导照样往下走
		fi
	fi
	[ -z "$(py team-list)" ] || team=1
	if [ -n "$asknet" ]; then   # ② 网络出口
		onboard_title "网络出口"
		det=$(detect_router)   # 自动模式：先探局域网里有没有装了 Clash 的路由器，探到就默认选路由器、地址填好；探不到就默认内置代理（要能用）
		net_msg="给每个账号分配独立的网络出口，启动前 cca 会先检查。之后随时能在设置里改。"
		if [ -n "$det" ]; then
			net_default=router; ROUTER_HINT_HOST="$det"
			net_msg="检测到你的网络里可能有路由器（${det}），已默认选「路由器」；不对的话改选别的。${net_msg}"
		elif core_possible; then net_default=builtin
		else net_default=router
		fi
		[ -z "$team" ] || net_msg="加入了 Team：网络出口配好后，Team 给的账号自动加进来。${net_msg}"
		mode=$(gui_ask choice "这台 Mac 怎么给账号联网？" "$net_default" \
			"q=onboard.net" "title=${ONB_TITLE}" "message=${net_msg}" \
			"opt=router"$'\t'"路由器（OpenClash / ShellCrash）"$'\t'"家里/办公室有改好的路由器，按端口给每个账号分流" \
			"opt=builtin"$'\t'"没有路由器（用 cca 内置的代理）"$'\t'"加账号时粘贴一条自己的代理当出口（Team 给的账号用 Team 的配置带的节点）；内核由 cca 运行" \
			"opt=skip"$'\t'"先跳过，以后再配置"$'\t'"接着添加账号；启动账号时 cca 会再问怎么联网") || return 1
		case "$mode" in
			router) cmd_router_setup || return 1 ;;   # 取消时 gui_abort 已经杀掉进程；软失败就把失败交给 App，不记 onboarded
			builtin) onboard_builtin || return 1 ;;
			*) ;;   # 先跳过：加账号时能选 Team 的配置带的节点、粘贴自定义代理，启动时 cca 再问怎么联网
		esac
	fi
	if [ -n "$askadd" ]; then   # ③ 添加账号
		onboard_title "添加账号"
		keys1=$(py keys)
		if [ -z "$keys1" ]; then
			if confirm "现在添加第一个账号？" y "q=onboard.add" "title=${ONB_TITLE}" \
				"detail=填登录邮箱、选一个出口节点；第一次使用时会在它专属的浏览器窗口里登录。"; then
				onboard_add_one || true
			fi
		else   # Team 给的账号这次加进来了（开始时一个都没有）：问要不要再加一个自己的
			while IFS= read -r k; do [ -z "$k" ] || added="${added:+${added}、}${k%%(*}"; done <<< "$keys1"
			if confirm "还要再添加一个账号吗？" n "q=onboard.add" "title=${ONB_TITLE}" "message=已按 Team 的配置添加了 ${added}。" \
				"detail=Team 里没有的账号在这里添加：填登录邮箱、选一个出口节点。"; then
				onboard_add_one || true
			fi
		fi
	fi
	# Team 给的账号这次加进来了、还没同步到路由器（刚配好路由器时还没有账号，配置路由器那一步不同步）：现在同步，要重载时当场问
	if { [ "$(py keys)" != "$keys0" ] || [ "$ONB_TOOL" != claude ]; } && router_ready && [ "$(digest)" != "$(py get synced)" ]; then
		router_sync_soon
		case $? in 0|3) ;; *) fail_warn sync_failed "账号还没同步到路由器：修好后在节点分流页点「同步」（或者运行 cca router sync）" ;; esac
	fi
	py onboard-done
	gui_done onboarded "配置完成！在总览里打开账号使用，或继续添加更多账号。"
}

cmd_install() {
	local gui=""   # --gui（install.sh 在 macOS 上传）：基础安装后装好并打开图形界面 App，配置在 App 的引导向导里走；老 macOS、失败时自动回退到终端
	[ "${1:-}" = --gui ] && gui=1
	need_deps
	need_tty
	mkdir -p "$CCA_HOME/accounts" "$CCA_HOME/bin" "$CCA_HOME/backup" || die "无法创建 $CCA_HOME"
	chmod 700 "$CCA_HOME"
	py init || die "初始化配置失败"
	if [ -f "$HOME/.claude.json" ] && [ -z "$(ls -A "$CCA_HOME/backup" 2>/dev/null)" ]; then
		cp -p "$HOME/.claude.json" "$CCA_HOME/backup/claude.json.$(date +%Y%m%d-%H%M%S)"
	fi
	local target="$SELF" bin="$HOME/.local/bin"
	if ! dev_mode && [ "$SELF" != "$CCA_HOME/bin/cca" ]; then   # 发布版复制到 ~/.cca/bin/cca，自动更新替换的是这一份
		# 换下来的是别的版本（例如装测试版时换下的正式版）：留着，可以 cca update --rollback 退回
		# 比摘要，不用 cmp：Arch、openSUSE 的最小安装没有 cmp（diffutils），! cmp 恒为真，重装同一版本也会留一份"旧版"
		if [ -f "$CCA_HOME/bin/cca" ] && [ "$(sha256_of "$SELF")" != "$(sha256_of "$CCA_HOME/bin/cca")" ]; then
			mkdir -p "$UPD" && cp -p "$CCA_HOME/bin/cca" "$UPD/cca.prev" && ver_of "$CCA_HOME/bin/cca" > "$UPD/cca.prev.version"
		fi
		{ cp "$SELF" "$CCA_HOME/bin/cca.new.$$" && chmod 755 "$CCA_HOME/bin/cca.new.$$" &&
			mv -f "$CCA_HOME/bin/cca.new.$$" "$CCA_HOME/bin/cca"; } || die "复制到 $CCA_HOME/bin/cca 失败"
		target="$CCA_HOME/bin/cca"
	fi
	printf '#!/bin/sh\nexec %q _browser "$@"\n' "$target" > "$CCA_HOME/bin/open-url"
	chmod 755 "$CCA_HOME/bin/open-url"
	mkdir -p "$bin"
	if [ "$(readlink "$bin/cca" 2>/dev/null)" != "$target" ]; then
		[ -e "$bin/cca" ] && [ ! -L "$bin/cca" ] && die "$bin/cca 已存在且不是本脚本，请先处理"
		ln -sf "$target" "$bin/cca"
	fi
	case ":$PATH:" in *":$bin:"*) ;; *) path_hint "$bin" ;; esac
	info "已安装：$bin/cca → $target"
	tool_alias_ensure codex
	tool_alias_ensure agy
	# 3.6.0 以前一键安装时能带上维护者的映射仓库（curl … | CCA_POLICY_REPO=仓库 bash）：映射去掉了，改用 Team
	[ -z "${CCA_POLICY_REPO:-}" ] || warn "维护者的映射 3.6.0 起去掉了（CCA_POLICY_REPO 不再起作用）：向 Team 的管理员要一个邀请链接，装好后运行 cca team join 加入"
	if dev_mode; then info "开发模式：直接用 git 仓库里的这份脚本，不自动更新"
	else info "自动更新已开启：每天检查一次，新版本在下次启动时安装（cca update off 可关闭）"; fi
	info "账号表：${TABLE}；可选节点、纯净度阈值在 ${CFG}（nodes / min_trust）"
	if [ -n "$gui" ] && gui_os_ok; then   # 默认 GUI 安装：装好并打开 App，剩下的（上网方式、第一个账号）在 App 的引导向导里走
		say ""
		info "正在安装图形界面 cca App…"
		if ( cmd_gui ); then   # 子 shell：cmd_gui 自己的 EXIT trap 不影响这里
			say ""
			okay "基础安装完成。接下来在打开的 cca App 里按引导完成配置（加入 Team、选网络出口、添加账号）。"
			info "想在终端里配置就运行 cca install。"
			return 0
		fi
		warn "图形界面没能装上或打开，改在终端里配置。"
	fi
	local onboard=""   # 服务器上直连不通（见 builtin_onboard）：ok 配置好了内置代理；skip 没配置好（有了节点以后再运行 cca install）
	if server_builtin; then
		if builtin_onboard "cca install"; then onboard=ok; else onboard=skip; fi
	elif ! router_ready && confirm "现在配置路由器（OpenClash 或 ShellCrash；SSH 免密 + 按端口分流）？" y; then
		cmd_router_setup || warn "路由器配置没完成，稍后可运行 cca router setup"
	fi
	if [ -z "$CLAUDE_BIN" ]; then   # 辅助安装：直连不通时可以经内置代理装（要有节点定义：Team 的配置带的、自己粘贴的，或者在家时从路由器拷的）
		if [ "$onboard" = skip ]; then
			:   # 还没有节点：builtin_onboard 说了之后怎么接着配置
		elif [ "$onboard" = ok ]; then
			if confirm "没找到 Claude Code（claude 命令）。现在经内置代理用官方安装脚本装上吗？" y; then
				tool_install proxy || warn "Claude Code 没装上：稍后运行 cca install-cli 再装"
			else
				info "以后用 cca install-cli 装 Claude Code（只用 Codex、Antigravity 账号的话不需要它）"
			fi
		elif confirm "没找到 Claude Code（claude 命令）。现在用官方安装脚本装上吗？" y; then
			tool_install || warn "Claude Code 没装上：稍后运行 cca install-cli 再装"
		else
			info "以后用 cca install-cli 装 Claude Code（只用 Codex、Antigravity 账号的话不需要它）"
		fi
	fi
	if [ "$onboard" != skip ] && [ -z "$(py keys)" ] && confirm "现在新增第一个账号？" y; then
		cmd_add || true
	fi
	if [ -n "${CCA_PATH_ADDED:-}" ]; then info "完成。${CCA_PATH_ADDED}，输入 cca 就能用（cca help 查看全部命令）"
	else info "完成。以后输入 cca 启动 Claude Code（cca help 查看全部命令）"; fi
}

cmd_restore() {   # cca restore | cca uninstall [--no-backup]：同一件事的两个名字（确认时输入的就是用的那个名字）
	local word="${1:-restore}" title="一键还原" backup=1 key bk out rc pid running="" wt="" t a mail_user
	[ $# -eq 0 ] || shift
	while [ $# -gt 0 ]; do
		case "$1" in
			--no-backup) backup="" ;;
			*) die "用法: cca uninstall [--no-backup]（cca restore 是同一条命令）" ;;
		esac
		shift
	done
	[ "$word" != uninstall ] || title="卸载 cca"
	[ -d "$CCA_HOME" ] || { info "没有 ${CCA_HOME}，无需还原"; return 0; }
	need_tty
	for t in claude codex agy; do   # 账号的桌面 App 开着时删它的资料目录会出问题（agy 没有桌面 App）
		use_tool "$t"
		while IFS= read -r key; do
			[ -n "$key" ] || continue
			eval "$(py env "$key")"
			pid=$(tool app_pid "$ACC_DESKTOP_DIR"); rc=$?
			[ "$rc" -le 1 ] || die "无法查询 ${APP_LABEL} 进程，已停止还原；请稍后重试"
			[ -n "$pid" ] && running="${running:+${running}、}${ACC_NAME}（${APP_LABEL}）"
			# 账号专属的 Chrome 也一样：它的资料目录在 ~/.cca 里，删掉以后它还接着往里写，~/.cca 又长出来
			if [ -n "${ACC_CHROME_DIR:-}" ]; then
				pid=$(chrome_pid); rc=$?
				[ "$rc" -le 1 ] || die "无法查询 Chrome 进程，已停止还原；请稍后重试"
				[ -z "$pid" ] || running="${running:+${running}、}${ACC_NAME}（浏览器窗口）"
			fi
			[ "$t" = codex ] && has_worktrees && wt="${wt:+${wt}、}${ACC_NAME}"
		done < <(py keys)
	done
	use_tool claude
	gui_ours "$GUI_APP" && gui_running && running="${running:+${running}、}cca 的界面 App"
	[ -z "$running" ] || die "这些账号的桌面 App、浏览器窗口还开着：${running}。先退出它们再还原"
	# 会话宿主里还开着的会话（docs/dev/remote.md）：删掉 ~/.cca 以后它们照样在跑，却再也接不上、列不出来
	out=$(py remote-list --local 2>/dev/null)
	[ -z "$out" ] || die "还有开着的远程会话，先把它们结束再还原（cca remote list 看是哪些，cca remote end 编号 结束，或者 cca remote attach 接进去退出）"
	# 删 ~/.cca 之前要先打包备份（下面答应了的）：没有 tar 就什么都别动（有的 Linux 最小安装没有它）
	[ -z "$backup" ] || command -v tar >/dev/null 2>&1 || die "这台机器上没有 tar，没法先打包备份配置，什么都没改：装上 tar 再还原$(pkg_hint tar)；不要备份的话用 cca uninstall --no-backup"
	say "${C_B}${title}${C_0}：撤销 cca 做过的全部改动"
	say "  · 每个账号（Claude、Codex 和 Antigravity）：把会话里新产生的共享内容并回 ~/.claude、~/.codex、~/.gemini，然后退出登录、删除它的登录凭证"
	say "  · ${KEYSTORE}里 cca 存的 API key 全部删掉：第三方 API 账号的，和给官方账号记下备查的（删了找不回来，要留的先用 cca [codex] key 账号 --show 抄下来）"
	mail_user=$(py mail-get-user 2>/dev/null)
	[ -z "$mail_user" ] || say "  · 邮箱助手：删掉${KEYSTORE}里 ${mail_user} 的应用专用密码（Google 账号里的那个应用专用密码要你自己去撤销）"
	[ -z "$(py remote-peers 2>/dev/null)" ] || say "  · 远程会话：取消和别的机器的配对（那些机器不能再接入这台机器，这台也接不了它们），配对的密钥从${KEYSTORE}里删掉"
	restore_teams plan
	say "  · 路由器：移除钩子、cron、端口池（要让 OpenClash / ShellCrash 重载一次，约 20 秒，期间局域网新连接会失败）、/etc/cca 和 cca 的 SSH 公钥"
	say "  · 内置代理（用过的话）：停掉它的内核，删掉配置和拷来的节点"
	if ! on_linux; then udp_env; udp_present && say "  · 本机 UDP 走节点：删掉 root 的系统服务 ${UDP_LABEL}（要输管理员密码）"; fi
	if [ -n "$backup" ]; then a="先打包备份配置（不含浏览器资料、登录凭证和私钥），再删除"; else a="${C_Y}不留备份（--no-backup：账号表和配置删了找不回来）${C_0}，删除"; fi
	say "  · 本机：${a} ~/.local/bin 里的 cca、${CODEX_ALIAS}、${AGY_ALIAS}，${CCA_HOME} 和各账号的 App 启动器$(gui_ours "$GUI_APP" && printf '，还有图形界面 %s' "$GUI_APP")"
	say "  · cca 放在别处的也清掉：解出来的辅助程序和缓存$(on_linux || printf '、界面 App 的缓存和设置')、shell 启动文件里 cca 加的那两行（~/.local/bin 里还有别的命令时留着）"
	[ "$(py cost-hook status 2>/dev/null)" != on ] || say "  · ~/.claude/settings.json：去掉 cca cost hook 加的那条 hook（Claude App 里的会话记下账号），别的设置不动"
	say "  · ~/.claude、~/.claude.json、~/.codex 和 ~/.gemini 保持现状（共享主目录本来就是你的数据${backup:+；安装前的备份在打包里}）"
	[ -z "$wt" ] || say "  · ${C_Y}这些 Codex 账号建的 git 工作树（worktrees）会一起删掉：${wt}。还没提交的改动先处理好${C_0}"
	[ "$(ask "确认请输入 ${word}: " '')" = "$word" ] || { say "已取消"; return 0; }
	py unpark || warn "收起来的账号（Team 不再给的、以前关掉维护者的共享时收起来的）没能放回账号表：它们的登录凭证要自己删"
	for t in claude codex agy; do
		use_tool "$t"
		while IFS= read -r key; do
			[ -n "$key" ] || continue
			eval "$(py env "$key")"
			py link "$key" >/dev/null 2>&1
			py sync "$key" >/dev/null 2>&1
			logout_account
			info "已退出账号 ${ACC_LABEL}"
		done < <(py keys)
		py secrets-forget all   # 账号表里已经没有、钥匙串里还留着的 key（第三方 API 账号的、官方账号记下备查的）也删掉
		launchers_sync remove-all
	done
	use_tool claude
	py mail-forget 2>/dev/null   # 邮箱助手：钥匙串里的应用专用密码（没配置过也照样跑：什么都不删）
	py remote-forget 2>/dev/null   # 远程会话：和别的机器的配对都取消（告诉服务器），配对的密钥从钥匙串里删掉
	restore_teams apply   # Team：各个都退出（管理员的那些，根密钥跟着 ~/.cca 一起删掉）
	if router_ready; then
		out=$(router_uninstall 2>&1); rc=$?
		[ -n "$out" ] && printf '%s\n' "$out" | sed 's/^/  │ /' >&2
		if [ $rc -eq 0 ]; then
			info "路由器已还原"
		else
			warn "路由器还原失败（SSH 密钥还在，修好网络后可重新运行 cca restore）"
			confirm "仍然继续还原本机？之后需要 ssh 到路由器手动执行 /etc/cca/cca-router.sh uninstall </dev/null" n || return 1
		fi
		rsh_close
	fi
	load_local
	if local_ready; then local_remove; info "本机 ${LOCAL_NAME} 里 cca 的端口池已移除"; fi
	if ! on_linux && udp_present; then udp_uninstall || warn "本机 UDP 走节点的系统服务没删掉（原因见上面），接着还原别的"; fi
	core_stop_stale   # 内置代理的内核（界面 App 退出时会停掉它，这里是 App 崩溃后留下的）
	core_headless && core_boot off   # 开机起内核的那一行（Linux、macOS 26 以下才会加；上面关掉内置代理时已经删了，以前留下的也删）
	py presence-stop 2>/dev/null   # 设备统计的上报进程：先停掉（它告诉服务器这台机器停了；打包的时候也没人再往 ~/.cca 里写）
	py cost-stop 2>/dev/null       # 正在统计折合金额的后台进程也停掉
	# cca cost hook 加在 ~/.claude/settings.json 里的 hook（Claude App 里的会话记下账号）：cca 不在了它什么也不做，也去掉
	out=$(py cost-hook off 2>/dev/null); rc=$?
	if [ $rc -ne 0 ]; then
		warn "${out:-没能读取 ~/.claude/settings.json}：里面 cca 加的 hook 没去掉（cca 删掉以后它什么也不做），要的话自己删掉 hooks.SessionStart 里带 _session-start --desktop 的那一条"
	elif [ "$out" = changed ]; then
		info "已去掉 ~/.claude/settings.json 里 cca 加的 hook（Claude App 里的会话记下账号）"
	fi
	bk=""; [ -z "$backup" ] || bk="$HOME/cca-backup-$(date +%Y%m%d-%H%M%S).tar.gz"   # --no-backup：不打包，直接删
	# 只给自己读：账号表里可能写着第三方 API 的 key，config.json 里有本机 Clash 的密钥。节点密钥（内置代理拷来的节点；3.6.0 以前维护者的
	# 参考节点和拉取映射时的临时文件：升级以后第一条命令就删掉，policy_leftovers，还原是第一条命令时还在）、内置代理的配置和内核文件不打包（bsdtar 的 --exclude 不锚定开头，写具体的文件名，免得误伤别处叫 core、
	# policy 的目录）；备份目录（backup/）是用户自己的配置文件，照样打包。登录凭证（Codex 的 auth.json、Linux 上
	# Claude Code 的 .credentials.json、agy 的 antigravity-oauth-token）、密钥文件（secrets：上面按记账删过，没记上账的也不带）、
	# 去掉了的自己的同步服务器留下的加入信息（hub/hub.json：加入链接是凭证；hub-hosted.json：部署到托管平台时还没用上的口令和盐；升级以后
	# 第一条命令就删掉，hub_leftovers）和经它同步来的、Team 的凭证和经它同步来的不打包
	[ -z "$bk" ] || ( umask 077; tar -czf "$bk" -C "$CCA_HOME" --exclude 'core/nodes.json' --exclude 'core/custom-nodes.json' --exclude 'core/config.yaml' --exclude 'core/mihomo-v*' --exclude 'core/dl.*' \
		--exclude 'policy/nodes.json*' --exclude 'policy/tmp.*' --exclude 'hub/hub.json' --exclude 'hub-hosted.json' \
		--exclude 'teams/*/secret' --exclude 'teams/*/root_ed25519' --exclude 'teams/*/admin.json' --exclude 'teams/*/doc.json' \
		--exclude 'teams/*/*.tmp' --exclude 'teams/*/edit.json' --exclude 'teams/.new.*' \
		--exclude 'cost/scan.json' --exclude 'cost/remote.json' --exclude 'cost/own.remote.json' --exclude 'cost/team.*.remote.json' --exclude 'cost/worker.json' --exclude 'cost/last' --exclude 'cost/scanned' \
		--exclude '*/chrome' --exclude '*/desktop' --exclude 'cm-*' --exclude 'router_ed25519' --exclude 'id_ed25519' --exclude '*.lock' \
		--exclude 'auth.json' --exclude '.credentials.json' --exclude 'antigravity-oauth-token' --exclude 'secrets' \
		--exclude '*/worktrees' --exclude '*/.tmp' --exclude '*/log' --exclude '*/cache' . 2>/dev/null )
	# 看包能不能完整读出来，不看 tar 的退出码：GNU tar 遇到打包时正好被改了的文件也返回 1，包照样是好的；磁盘满了写到一半的包读不完
	if [ -z "$bk" ]; then
		info "没有留配置备份（--no-backup）"
	elif [ -s "$bk" ] && tar -tzf "$bk" >/dev/null 2>&1; then
		info "配置备份：$bk"
	else   # 没打成：不删 ~/.cca，免得没备份就删了
		rm -f "$bk"
		warn "配置没能打包备份（磁盘满了？）：${CCA_HOME} 留着没删，别的都已经还原。腾出空间后自己备份它，不要的话直接删掉（rm -rf ${CCA_HOME}）"
		return 1
	fi
	for a in "$CODEX_ALIAS" "$AGY_ALIAS"; do   # 只删 cca 建的
		[ "$(readlink "$HOME/.local/bin/$a" 2>/dev/null)" = cca ] && rm -f "$HOME/.local/bin/$a"
	done
	case "$(readlink "$HOME/.local/bin/cca" 2>/dev/null)" in "$SELF"|"$CCA_HOME/bin/cca") rm -f "$HOME/.local/bin/cca" ;; esac
	if gui_ours "$GUI_APP"; then rm -rf "$GUI_APP"; info "已删除界面 App ${GUI_APP}"; fi
	on_linux || gui_leftovers
	rm -rf "${CCA_HOME:?}"
	# 从这往下不能再调 py：解出来的辅助程序这就删掉，~/.cca 里的这一份 cca 也没有了（再解不出来）
	cache_leftovers
	path_unhint
	info "已还原。原来的 claude、codex、agy 命令和 ~/.claude、~/.codex、~/.gemini 不受影响"
}

gui_leftovers() {   # 界面 App 自己放在 ~/Library 和临时目录里的（内核日志、运行记录、窗口状态、设置）：按 bundle id 认，这些路径只有 cca App 用。
	# App 删掉了它们还留着；cca restore、cca gui remove 都调。设置先 defaults delete（让系统的设置进程也忘掉），它会留下一个空文件，再删。
	# 临时目录里 App 放事件文件的 cca-gui-events 不删：是个空目录，系统自己会清；还开着的另一份 App（开发时编的）正用着它
	local p
	for p in "Caches/$GUI_ID" "HTTPStorages/$GUI_ID" "HTTPStorages/$GUI_ID.binarycookies" "Saved Application State/$GUI_ID.savedState" "WebKit/$GUI_ID"; do
		rm -rf "${HOME:?}/Library/$p"
	done
	defaults delete "$GUI_ID" >/dev/null 2>&1
	rm -f "$HOME/Library/Preferences/$GUI_ID.plist"
	return 0
}

cache_leftovers() {   # cca 放在缓存目录里的（不在 ~/.cca 里，删了 ~/.cca 它们还在）：解出来的辅助程序（各个版本的都在 cca-helper 里）、程序坞整理的
	# 排队记录、内置代理控制接口的 socket，还有 3.5.0 以前的版本留下的 Python 字节码缓存（cca-py）。这几个名字只有 cca 用。
	# 仓库里的 cca 用的辅助程序在 cli/target 下，不在缓存目录里：那时不动 cca-helper
	local d
	case "$HELPER" in "${CACHE_DIR:?}/cca-helper/"*) rm -rf "$CACHE_DIR/cca-helper" ;; esac
	[ -z "$DOCK_DIR" ] || rm -rf "$DOCK_DIR"
	for d in "$CACHE_DIR" "${XDG_RUNTIME_DIR:-}"; do [ -z "$d" ] || rm -rf "${d%/}/cca-py"; done
	rm -f "$(core_sock)"
	return 0
}

