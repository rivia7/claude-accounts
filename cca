def slot_orders(c, local=False):
    """端口池每个槽位：(组名, 端口, 成员顺序)。和路由器上一样，分到账号的槽位把它的节点排第一（客户端重新加载后默认就选中它），
    空槽位 REJECT 排第一。local：给本机 Clash Verge 用，节点名换成它那边的叫法（local_names）"""
    m = local_names(c) if local else {}
    nodes = list(dict.fromkeys(m.get(n, n) for n in c['nodes']))
    out = []
    for s, node in enumerate(slot_nodes(c), 1):
        node = m.get(node, node)
        rest = [n for n in nodes if n != node]
        out.append(('CCA-%d' % s, FIRST_PORT - 1 + s, [node] + rest + ([] if node == 'REJECT' else ['REJECT'])))
    return out


def local_members(order, have):
    """和全局扩展脚本里的算法一样：只留客户端里有的节点；分到的节点不在时 REJECT 排第一"""
    m = [n for n in order if n == 'REJECT' or n in have]
    return m if m[0] == order[0] else ['REJECT'] + [n for n in m if n != 'REJECT']


def local_want(c):
    """端口池的结构（可选节点在客户端里的叫法 + 槽位数）：变了才需要让客户端重新加载；只换节点走控制接口。
    Clash Verge 里给节点改了名，换算出来的叫法变了，也要重新加载（端口池的组成员要换成新名字）"""
    m = local_names(c)
    want = [sorted(m.get(n, n) for n in c['nodes']), pool_size(c)]
    f = policy_fill()
    if (c.get('local') or {}).get('client') == 'builtin':   # 内置代理：节点定义变了（路由器上改了节点、参考节点更新）也要重新加载
        defs = core_pick(core_defs(), [m.get(n, n) for n in c['nodes']])
        want.append(hashlib.sha1(json.dumps(defs, ensure_ascii=False, sort_keys=True).encode('utf-8')).hexdigest())
    elif f and (c.get('local') or {}).get('fill') == f['id']:   # 参考节点写进了 Clash Verge 的配置：变了也要重新加载
        want.append(f['id'])                                     # （没有参考节点时摘要和以前一样）
    return hashlib.sha1(json.dumps(want).encode('utf-8')).hexdigest()


def local_names(c):
    """账号表里的节点名（路由器上的叫法）→ 本机 Clash Verge 运行配置里（内置代理：它的节点定义里）的叫法：按服务器地址认
    （node_match），对不上的不在结果里（照原名，客户端里没有就拒绝连接）。手动配置的客户端看不到它的配置、读不了运行配置时不换算"""
    client = (c.get('local') or {}).get('client')
    if client == 'builtin':
        return core_names(c)
    if client != 'clash-verge':
        return {}
    try:
        with open(os.path.join(VERGE_DIR, 'clash-verge.yaml'), encoding='utf-8') as f:
            lines = f.read().split('\n')
    except OSError:
        return {}
    secs = yaml_sections(lines)
    have = yaml_proxies(lines, secs)
    have += [(p['name'], fill_fp(p)) for p in fill_plan(have, yaml_names(lines, secs))[0]]   # cca 会补进去的参考节点也算有
    return names_in(c, have)


def names_in(c, have):
    """可选节点在节点列表 have=[(名字, 摘要)] 里的叫法（按服务器地址认，见 node_match）；认不出的不在结果里"""
    out = {}
    for n in c['nodes']:
        m = node_match(n, node_ids(c).get(n, ''), have)
        if m:
            out[n] = m
    return out


