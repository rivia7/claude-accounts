# 输出一律用 UTF-8：当前 locale 不是 UTF-8（如 zh_CN.GBK、GB18030）时，Python 等会按 GBK 编码输出，
# 在 UTF-8 终端里就是乱码。这里给本脚本及其子进程换成同语言的 UTF-8 locale。
case "$(locale charmap 2>/dev/null)" in
	UTF-8|utf8|UTF8) ;;
	*)
		_l="${LC_ALL:-${LC_CTYPE:-${LANG:-}}}"
		for _l in "${_l%%.*}.UTF-8" en_US.UTF-8 C.UTF-8; do
			if locale -a 2>/dev/null | grep -qx "$_l"; then export LC_ALL="$_l"; break; fi
		done
		unset _l ;;
esac

if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
	C_B=$'\033[1m' C_D=$'\033[2m' C_R=$'\033[31m' C_G=$'\033[32m' C_Y=$'\033[33m' C_0=$'\033[0m'
else
	C_B= C_D= C_R= C_G= C_Y= C_0=
fi
say()  { printf '%s\n' "$*" >&2; }
info() { printf '%s\n' "${C_G}•${C_0} $*" >&2; }
warn() { printf '%s\n' "${C_Y}!${C_0} $*" >&2; }
die()  { gui_fail "${FAIL_CODE:-error}" "$*"; printf '%s\n' "${C_R}✗${C_0} $*" >&2; exit 1; }   # FAIL_CODE=原因码 die …：告诉图形界面原因

# 交互输入统一从 fd 3 读：默认是终端；CCA_TTY=文件 时按行读取预置答案（脚本化/测试用）
# 提问会话（macos/PROTOCOL.md 4.6）：图形界面设了 CCA_PROMPT=1、事件文件，并把答案管道接在 fd 3 上时，
# 提问发成 ask 事件，答案从 fd 3 读。只有 App 开的封闭流程（添加账号之类）才这样运行
TTY_OK=0
PROMPT_GUI=""
if [ "${CCA_PROMPT:-}" = 1 ] && [ -n "${CCA_EVENTS:-}" ] && { : <&3; } 2>/dev/null; then
	TTY_OK=1
	PROMPT_GUI=1
elif [ -n "${CCA_TTY:-}" ]; then
	exec 3<"$CCA_TTY" && TTY_OK=1
elif { exec 3</dev/tty; } 2>/dev/null; then
	TTY_OK=1
fi
interactive() { [ "$TTY_OK" = 1 ] && { [ -t 0 ] || [ -n "${CCA_TTY:-}" ] || [ -n "$PROMPT_GUI" ]; }; }
need_tty() {   # 需要交互的命令：没有终端时（例如 Claude Code 里的 ! 前缀）直接说明，不要带着默认值乱跑
	interactive && return 0
	if [ -n "${CLAUDECODE:-}" ]; then
		die "这个命令需要交互：请在单独的终端标签里直接运行 cca（Claude Code 里的 ! 前缀不能交互）"
	fi
	die "这个命令需要在终端里交互运行"
}

# x=$(ask "提示: " 默认值)；提示走 stderr，没有终端时返回默认值。
# 真终端用 readline（read -e）：终端默认 -iutf8，普通 read 退格只删掉中文字符的一个字节，留下乱码
# 默认值后面可以跟给图形界面的 k=v（q= label= hint= …，见 gui_ask），终端里用不上
ask() {
	[ -z "$PROMPT_GUI" ] || { gui_ask text "$@"; return; }
	local v=""
	if [ "$TTY_OK" = 1 ]; then
		if [ -z "${CCA_TTY:-}" ] && [ -t 3 ]; then
			IFS= read -e -r -p "$1" v <&3 || v=""
		else
			printf '%s' "$1" >&2
			IFS= read -r v <&3 || v=""
		fi
	fi
	[ -n "$v" ] || v="$2"
	printf '%s' "$v"
}
confirm() {  # confirm "问题" [y|n] [给图形界面的 k=v…]
	local d="${2:-y}" hint="[Y/n]" a
	if [ -n "$PROMPT_GUI" ]; then
		a=$(gui_ask confirm "$1" "$d" "${@:3}") || return 1
	else
		[ "$d" = n ] && hint="[y/N]"
		a=$(ask "$1 $hint " "$d")
	fi
	case "$a" in [Yy]*) return 0 ;; *) return 1 ;; esac
}
# x=$(ask_secret "提示: ")：输入不回显（不用 readline，免得它回显）；CCA_TTY 答案文件时照常按行读
ask_secret() {
	[ -z "$PROMPT_GUI" ] || { gui_ask secret "$1" "" "${@:2}"; return; }
	local v=""
	if [ "$TTY_OK" = 1 ]; then
		printf '%s' "$1" >&2
		if [ -z "${CCA_TTY:-}" ] && [ -t 3 ]; then
			IFS= read -r -s v <&3 || v=""
			printf '\n' >&2
		else
			IFS= read -r v <&3 || v=""
		fi
	fi
	printf '%s' "$v"
}
okay() { printf '%s\n' "${C_G}✓${C_0} $*" >&2; }

# 图形界面（cca App）的事件：CCA_EVENTS 指向的文件里追加 JSON 行（consent / terminal / fail / result / step / ask，格式见
# macos/PROTOCOL.md）。不设就什么都不做（命令行、启动器都不设），设了也不改变退出码和 stderr。用文件不用变量：很多地方在 $(…) 里
jstr() {   # JSON 字符串（去掉控制字符，换行变空格）
	printf '"%s"' "$(printf '%s' "$1" | LC_ALL=C tr '\n\r\t' '   ' | LC_ALL=C tr -d '\000-\010\013\014\016-\037\177' | LC_ALL=C sed 's/\\/\\\\/g; s/"/\\"/g')"
}
jopt() { if [ -n "${1:-}" ]; then jstr "$1"; else printf null; fi; }   # 空的写成 null
jarr() { local s="[" f=1 a; for a in "$@"; do [ $f = 1 ] || s="$s,"; f=0; s="$s$(jstr "$a")"; done; printf '%s]' "$s"; }
shq() {   # shq 参数：能直接复制进终端的写法（只有字母数字和 @%+=:,./_- 的照写，别的加单引号）
	if [ -n "$1" ] && printf '%s' "$1" | LC_ALL=C grep -q '^[A-Za-z0-9@%+=:,./_-]*$'; then printf '%s' "$1"
	else printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; fi
}
gui_event() {   # gui_event 类型 '"键":值,…'
	[ -n "${CCA_EVENTS:-}" ] || return 0
	{ printf '{"v":1,"ev":"%s"%s}\n' "$1" "${2:+,$2}" >> "$CCA_EVENTS"; } 2>/dev/null   # 打不开文件时 bash 的报错也不能漏到 stderr
	return 0
}
gui_fail() { [ -n "${CCA_EVENTS:-}" ] || return 0; gui_event fail "\"code\":\"$1\",\"message\":$(jstr "$2")"; }   # gui_fail 原因码 说明
fail_warn() { gui_fail "$1" "$2"; warn "$2"; }   # fail_warn 原因码 说明：warn，并告诉图形界面失败的原因
gui_step() { gui_event step "\"code\":\"$1\""; }
gui_result() {   # gui_result opened|activated 说明（需要先 eval "$(py env 名称)"）
	[ -n "${CCA_EVENTS:-}" ] || return 0
	gui_event result "\"code\":\"$1\",\"route\":$(jopt "${ROUTE:-}"),\"node\":$(jopt "${ACC_NODE:-}"),\"port\":${ACC_PORT:-null},\"message\":$(jstr "$2")"
}
gui_terminal() {   # gui_terminal 代码 说明 参数…：这一步要在终端里运行 cca 参数…（Codex、Antigravity 账号自动加上 codex / agy）
	[ -n "${CCA_EVENTS:-}" ] || return 0
	local code="$1" msg="$2" cmd=cca a
	shift 2
	case "${TOOL:-claude}" in codex|agy) set -- "$TOOL" "$@" ;; esac
	for a in "$@"; do cmd="$cmd $(shq "$a")"; done
	gui_event terminal "\"code\":\"$code\",\"argv\":$(jarr "$@"),\"display\":$(jstr "$cmd"),\"message\":$(jstr "$msg")"
}
# 要用户同意的地方一律用 consent：consent 项 范围 标题 问题 说明 [默认 y|n]。返回 0 同意（终端里答了 y，或者图形界面
# 已经拿到用户的同意、带着 CCA_GRANT=项:范围 重新运行）；1 终端里答了 n；2 没法问（非交互）：记一条 consent 事件，
# 由图形界面弹窗问，同意后带上 CCA_GRANT 重新运行。授权必须带范围、原样匹配（重载 OpenClash 的同意不能拿去重载 ShellCrash）
consent_granted() { case ",${CCA_GRANT:-}," in *",$1,"*) return 0 ;; esac; return 1; }
consent() {
	local tok="$1${2:+:${2//,/_}}"
	consent_granted "$tok" && return 0
	if interactive; then confirm "$4" "${6:-y}" "q=consent.$1" "title=$3" "detail=$5" severity=warn && return 0; return 1; fi
	gui_event consent "\"item\":$(jstr "$1"),\"scope\":$(jstr "$2"),\"grant\":$(jstr "$tok"),\"title\":$(jstr "$3"),\"question\":$(jstr "$4"),\"detail\":$(jstr "$5"),\"severity\":\"warn\",\"default\":\"$([ "${6:-y}" = n ] && echo no || echo yes)\""
	return 2
}

# ---- 提问会话（macos/PROTOCOL.md 4.6）----
# 取消：App 关掉答案管道（读到 EOF）。绝不当成“回车取默认值”：默认 y 的确认会变成同意。提问常在 $(…) 里，exit 只退子 shell，所以杀主进程
gui_abort() { gui_fail cancelled "已取消"; kill -TERM "$$"; sleep 1; exit 130; }
# 一个问题（整页只有一个字段）：gui_ask 类型 提示 默认值 [k=v…]，打印答案。k=v：q=题号 label=名字 hint=说明 title=页标题 message=页说明
# detail= severity= optional=1 skip=“不选”的说法 opt=值<TAB>名字<TAB>注记（选项）。没写 label 时用提示语
gui_ask() {
	local kind="$1" prompt="$2" def="${3:-}" seq line v
	shift; shift; [ $# -eq 0 ] || shift
	seq=$(gui_kv field=v "kind=$kind" "prompt=$prompt" "default=$def" "$@" | py prompt-emit) || gui_abort
	while IFS= read -r line <&3; do
		case "$line" in
			"$seq v "*) v=${line#"$seq v "}; printf '%s' "${v:-$def}"; return 0 ;;
			"$seq "*) gui_abort ;;   # 字段对不上就停下，别把值放错地方
		esac
	done
	gui_abort
}
gui_kv() { local a nl=$'\n'; for a in "$@"; do printf '%s\n' "${a//$nl/ }"; done; }   # 给 py prompt-emit 的描述：一条一行，值里的换行变空格（路由器的说明常常有好几行）
# 一页多个字段：ask_fields 题号 页标题 页说明 字段…，结果放进 F_变量（所以不能在 $(…) 里调用）。
# 字段是“变量|类型|校验|终端提示|GUI 名字|GUI 说明|预填|错误”（后两项可以不写）：类型 text、secret，后面加 ? 是可选；校验 email、alias、url、model、host、sshuser、port、
# controller（cca 判断，密文默认校验 key 的格式，写 any 不校验）。类型 code 只显示、不用回答（GUI 专用：预填那一项写放着多行文字的变量名）。
# 终端里逐个问，和以前一样；图形界面里一页填完，不合格的带着原因重问（已填的带回去，密文不带）
ask_fields() {
	if [ -n "$PROMPT_GUI" ]; then gui_fields "$@"; return; fi
	local spec name kind check tip rest val
	shift 3
	for spec in "$@"; do
		IFS='|' read -r name kind check tip rest <<< "$spec"
		case "$kind" in
			secret*) val=$(api_key_ask "$tip") || { say "  已取消"; return 1; } ;;
			*\?) val=$(ask_valid "$check" "$tip" optional) ;;
			*) val=$(ask_valid "$check" "$tip") || return 1 ;;
		esac
		printf -v "F_$name" '%s' "$val"
	done
}
gui_fields_spec() {   # 这一页的描述（给 py prompt-emit；变量都是 gui_fields 的）。单独一个函数：bash 3.2 在 $(…) 里解析不了 case 的右括号
	local i l
	gui_kv "q=$q" "title=$title" "message=$msg"
	for ((i = 0; i < n; i++)); do
		gui_kv "field=${names[i]}" "kind=${kinds[i]%\?}" "label=${labels[i]}" "hint=${hints[i]}" "error=${errs[i]}"
		case "${kinds[i]}" in
			code) while IFS= read -r l; do printf 'code=%s\n' "$l"; done <<< "${vals[i]}" ;;   # 多行文字：一行一条
			secret*) ;;
			*) gui_kv "value=${vals[i]}" ;;
		esac
		case "${kinds[i]}" in *\?) echo optional=1 ;; esac
	done
}
gui_answer() {   # gui_answer 序号 字段：读这一页这个字段的答案，放进 ANSWER（不能在 $(…) 里调用）
	local line
	while :; do
		IFS= read -r line <&3 || gui_abort
		case "$line" in
			"$1 $2 "*) ANSWER=${line#"$1 $2 "}; return 0 ;;
			"$1 "*) gui_abort ;;   # 同一页的字段对不上就停下：别把值放错地方（可能是密钥）
		esac
	done
}
gui_fields() {
	local q="$1" title="$2" msg="$3" seq line i n=0 name kind check tip label hint def err v out bad
	local -a names kinds checks labels hints vals errs
	shift 3
	for line in "$@"; do
		IFS='|' read -r name kind check tip label hint def err <<< "$line"
		[ "$kind" != code ] || def=${!def}
		names[n]=$name kinds[n]=$kind checks[n]=$check labels[n]=$label hints[n]=$hint vals[n]=$def errs[n]=$err
		n=$((n + 1))
	done
	while :; do
		seq=$(gui_fields_spec | py prompt-emit) || gui_abort
		for ((i = 0; i < n; i++)); do
			[ "${kinds[i]}" != code ] || continue
			gui_answer "$seq" "${names[i]}"
			vals[i]=$ANSWER
		done
		ANSWER=""
		bad=""
		for ((i = 0; i < n; i++)); do
			errs[i]=""
			[ "${kinds[i]}" != code ] || continue
			v=${vals[i]}
			if [ -z "$v" ]; then
				case "${kinds[i]}" in *\?) ;; *) errs[i]="这一项要填"; bad=1 ;; esac
				continue
			fi
			case "${kinds[i]}" in
				secret*) if [ "${checks[i]}" != any ] && ! out=$(printf '%s' "$v" | py secret-check); then errs[i]=$out; bad=1; fi ;;
				*) [ -z "${checks[i]}" ] && continue
				   if out=$(py check "${checks[i]}" "$v"); then vals[i]=$out; else errs[i]=$out; bad=1; fi ;;
			esac
		done
		[ -n "$bad" ] || break
	done
	for ((i = 0; i < n; i++)); do printf -v "F_${names[i]}" '%s' "${vals[i]}"; done
}
gui_done() {   # gui_done 结果码 说明 [账号的键]：这条流程做完了（App 选中这个账号、显示这句话）
	[ -n "${CCA_EVENTS:-}" ] || return 0
	gui_event result "\"code\":\"$1\",\"tool\":$(jstr "${TOOL:-claude}"),\"key\":$(jopt "${3:-}"),\"message\":$(jstr "$2")"
}
gui_cancelled() { gui_fail cancelled "已取消"; return 1; }   # 提问会话里用户答了“不做”：按取消收场（不算失败）

# 能画方向键菜单的条件：有真终端（不是 CCA_TTY 预置答案）且终端支持光标控制
