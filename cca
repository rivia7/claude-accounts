# --- API key（下面叫 secret，免得和账号表的键混了），都存在钥匙串里：
# - 第三方 API 账号的：服务名 cca-api-账号目录名（Codex 账号是 cca-codex-api-账号目录名），账户名是接口地址的域名——地址换成
#   别的服务商，旧 key 就取不到，不会被发过去。账号表里写了 key 字段时用表里的。
# - 官方账号记下备查的（控制台里建的 API key；cca 绝不拿它登录或启动账号，那样会变成按量计费）：服务名 cca-ref-账号目录名
#   （Codex 是 cca-codex-ref-），账户名是 REF_ACCT。
# cca 存过 key 的账号记在 config.json 的 api_keys / ref_keys：删账号（包括在 cca edit 里删、直接改账号表删）后据此清掉钥匙串里的 key；
# key_hints 记着每个 key 的掩码（key_hint）和存的时候的域名：_gui state 照它显示，不读钥匙串
# 没有钥匙串的系统（Linux 服务器）把 key 存成文件：~/.cca/secrets/<服务名>（服务名和钥匙串里的一样），内容是
# {"host": 账户名, "key": key}；目录 700、文件 600，先写临时文件（建的时候就是 600）再原子替换。CCA_KEYSTORE=file 时 macOS
# 上也这样（测试用）。bash 的 keyfile_store 是同一个判断
SECRETS_DIR = os.path.join(CCA_HOME, 'secrets')


def keyfile_store():
    return sys.platform != 'darwin' or os.environ.get('CCA_KEYSTORE') == 'file'


def keystore_name():
    return '密钥文件' if keyfile_store() else '钥匙串'


def keyfile_read(host, svc):
    """(退出码, key)：退出码和 security find-generic-password 一样，没有是 44，读不了是 1"""
    try:
        with open(os.path.join(SECRETS_DIR, svc), encoding='utf-8') as f:
            d = json.load(f)
    except FileNotFoundError:
        return 44, ''
    except (OSError, ValueError):
        return 1, ''
    if not isinstance(d, dict) or d.get('host') != host or not isinstance(d.get('key'), str):
        return 44, ''
    return 0, d['key']


def keyfile_write(host, svc, s):
    os.makedirs(SECRETS_DIR, mode=0o700, exist_ok=True)
    os.chmod(SECRETS_DIR, 0o700)
    p = os.path.join(SECRETS_DIR, svc)
    tmp = '%s.cca-%d.tmp' % (p, os.getpid())
    try:
        os.unlink(tmp)
    except FileNotFoundError:
        pass
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, 'O_NOFOLLOW', 0), 0o600)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            json.dump({'v': 1, 'host': host, 'key': s}, f)
            f.write('\n')
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, p)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def keyfile_del(svc):
    try:
        os.unlink(os.path.join(SECRETS_DIR, svc))
    except FileNotFoundError:
        pass


def security(*args, data=None):
    """运行 security，返回 (退出码, stdout)；data 从 stdin 交给它（security -i）"""
    import subprocess
    try:
        r = subprocess.run(('security',) + args, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=30,
                           **({'input': data} if data is not None else {'stdin': subprocess.DEVNULL}))
    except (OSError, subprocess.SubprocessError):
        return 1, b''
    return r.returncode, r.stdout


def kc_svc(aid, ref=False):
    return (T.kc_ref_prefix if ref else T.kc_prefix) + aid


def kc_slot(v):
    """账号表的值 → (钥匙串里的账户名, ref)：第三方 API 账号的 key 按接口的域名存；官方账号记下备查的存在 reference 下"""
    return (api_host(v), False) if is_api(v) else (REF_ACCT, True)


def kc_list(ref):
    """config.json 里记着存过 key 的账号目录名的那一项"""
    return 'ref_keys' if ref else 'api_keys'


def kc_hints(st):
    h = st.get('key_hints')
    return h if isinstance(h, dict) else {}


def kc_read(aid, host, ref=False):
    """(security 的退出码, key)：钥匙串里这个账号、这个服务商的 key；没有（退出码 44）、读不了（锁着、超时）或不是可见的
    ASCII 时 key 是空字符串（没有钥匙串的系统读密钥文件）"""
    if keyfile_store():
        rc, s = keyfile_read(host, kc_svc(aid, ref))
    else:
        rc, out = security('find-generic-password', '-a', host, '-s', kc_svc(aid, ref), '-w')
        s = out.decode('utf-8', 'replace').strip()
    return rc, s if rc == 0 and SECRET_RE.match(s) else ''


def kc_get(aid, host, ref=False):
    return kc_read(aid, host, ref)[1]


def kc_book(aid, host, s, ref=False):
    """config.json 里记下（s 是 key）或者删掉（s 是 None）这个账号存过的 key：api_keys / ref_keys 和 key_hints（掩码、域名）"""
    c = cfg_load()
    st = T.state(c, create=True)
    lst = kc_list(ref)
    have = set(st.get(lst) or [])
    hints = kc_hints(st)
    if s is None:
        have.discard(aid)
        hints.pop(aid, None)
    else:   # 域名总是记下（换了服务商算没存）；短的 key 没有掩码，hint 是空字符串
        have.add(aid)
        hints[aid] = {'host': host, 'hint': key_hint(s)}
    if have or not ref:
        st[lst] = sorted(have)
    else:
        st.pop(lst, None)
    if hints:
        st['key_hints'] = hints
    else:
        st.pop('key_hints', None)
    cfg_save(c)


def kc_unbook(aid, ref=False):
    """钥匙串里已经没有这个账号的 key 了：config.json 里的记录也删掉"""
    if aid in (T.state(cfg_load()).get(kc_list(ref)) or []):
        kc_book(aid, '', None, ref)


def kc_backfill(aid, host, s, ref=False):
    """读到了 key、config.json 里却没有它的掩码和域名（旧版本存的）：补上，App 以后就能显示它"""
    st = T.state(cfg_load())
    if aid in (st.get(kc_list(ref)) or []) and kc_hints(st).get(aid) != {'host': host, 'hint': key_hint(s)}:
        kc_book(aid, host, s, ref)


def kc_put(aid, host, s, ref=False):
    """先删掉这个账号的旧 key（不管哪个服务商的），再存新的。命令和十六进制的 key 都从 stdin 交给 security -i，
    key 不出现在任何进程的命令行里；security -i 里的命令失败了它也返回 0，所以存完读回来比对"""
    if not host or re.search(r'\s', host):
        return False
    kc_del(aid, ref)
    if keyfile_store():
        try:
            keyfile_write(host, kc_svc(aid, ref), s)
        except OSError:
            return False
    else:
        security('-i', data=('add-generic-password -U -a %s -s %s -X %s\n' % (host, kc_svc(aid, ref), s.encode('ascii').hex())).encode('ascii'))
    if kc_get(aid, host, ref) != s:
        return False
    kc_book(aid, host, s, ref)
    return True


def kc_del(aid, ref=False):
    """删掉这个账号在钥匙串里的 key（每次删一条，不管哪个服务商的，删到没有为止；密钥文件一个服务名只有一份）"""
    if keyfile_store():
        keyfile_del(kc_svc(aid, ref))
    else:
        for _ in range(20):
            if security('delete-generic-password', '-s', kc_svc(aid, ref))[0] != 0:
                break
    kc_unbook(aid, ref)


def api_secret(k, v):
    s = v.get('key')
    return s if secret_ok(s) else kc_get(acct_id(k), api_host(v))


