def data_home():
    """Clash Verge（Rev）放数据的地方（它用的 dirs::data_dir()）：macOS 是 ~/Library/Application Support，Linux 是 $XDG_DATA_HOME
    （不是绝对路径的不算）或 ~/.local/share"""
    if sys.platform == 'darwin':
        return os.path.join(HOME, 'Library', 'Application Support')
    x = os.environ.get('XDG_DATA_HOME') or ''
    return x if os.path.isabs(x) else os.path.join(HOME, '.local', 'share')


