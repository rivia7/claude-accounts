def cmd_usage_query(claude, timeout='25'):
    """在账号的环境里（bash 的 child_env 已经设好 CLAUDE_CONFIG_DIR 和出口）无界面启动 claude，发 get_usage 控制
    请求取用量。--safe-mode 不加载 hooks、MCP、插件；不发消息、不耗额度；token 由 Claude Code 自己读取和刷新。
    拿到回应之前 stdin 一直开着（太早关掉请求可能被取消）。stdout 打印一行 JSON：
    {ok: true, usage: 回应} 或 {ok: false, why: unsupported|timeout|error, msg: 说明}"""
    import queue, subprocess, tempfile, threading
    cd = os.environ.get('CLAUDE_CONFIG_DIR') or ''
    err = tempfile.TemporaryFile()
    try:
        p = subprocess.Popen([claude, '-p', '--safe-mode', '--no-session-persistence', '--strict-mcp-config',
                              '--input-format', 'stream-json', '--output-format', 'stream-json', '--verbose'],
                             stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=err,
                             cwd=os.path.dirname(cd) if os.path.isdir(cd) else CCA_HOME)
    except OSError as e:
        print(json.dumps({'ok': False, 'why': 'error', 'msg': str(e)}, ensure_ascii=False))
        return
    q = queue.Queue()

    def pump():
        for line in p.stdout:
            q.put(line)
        q.put(None)
    threading.Thread(target=pump, daemon=True).start()
    req = {'type': 'control_request', 'request_id': USAGE_REQ, 'request': {'subtype': 'get_usage', 'skip_behaviors': True}}
    try:
        p.stdin.write((json.dumps(req) + '\n').encode('utf-8'))
        p.stdin.flush()
    except OSError:
        pass
    out, end = {'ok': False, 'why': 'timeout', 'msg': ''}, time.time() + float(timeout)
    while True:
        try:
            line = q.get(timeout=max(end - time.time(), 0.01))
        except queue.Empty:
            break
        if line is None:   # 没回应就退出了：多半是太老的版本（不认 --safe-mode 等参数）
            try:
                p.wait(timeout=3)
            except subprocess.TimeoutExpired:
                pass
            err.seek(0)
            tail = err.read()[-800:].decode('utf-8', 'replace').strip().splitlines()
            old = re.search(r'unknown option|nsupported', ' '.join(tail))
            out = {'ok': False, 'why': 'unsupported' if old else 'error',
                   'msg': tail[-1][:200] if tail else '没有回应就退出了（退出码 %s）' % p.returncode}
            break
        try:
            m = json.loads(line)
        except ValueError:
            continue
        r = m.get('response') if isinstance(m, dict) and m.get('type') == 'control_response' else None
        if not isinstance(r, dict) or r.get('request_id') != USAGE_REQ:
            continue
        if r.get('subtype') == 'success':
            u = r.get('response')
            out = {'ok': True, 'usage': u if isinstance(u, dict) else {}}
        else:
            e = str(r.get('error') or '')
            out = {'ok': False, 'why': 'unsupported' if 'nsupported' in e else 'error', 'msg': e[:200]}
        break
    if out.get('why') == 'timeout':
        p.kill()
    try:
        p.stdin.close()
    except OSError:
        pass
    try:
        p.wait(timeout=5)
    except subprocess.TimeoutExpired:
        p.kill()
    print(json.dumps(out, ensure_ascii=False))


def parse_ts(s):
    """ISO 时间（小数秒、Z、时区都行）或秒/毫秒数 → 秒；看不懂返回 None（Python 3.9 的 fromisoformat 认不了这些写法）"""
    if isinstance(s, bool):
        return None
    if isinstance(s, (int, float)):
        return s / 1000.0 if s > 1e11 else float(s)
    if not isinstance(s, str):
        return None
    m = re.match(r'^(\d{4})-(\d\d)-(\d\d)[T ](\d\d):(\d\d)(?::(\d\d)(\.\d+)?)?\s*(Z|[+-]\d\d:?\d\d)?$', s.strip())
    if not m:
        return None
    import calendar
    y, mo, d, h, mi, sec, frac, tz = m.groups()
    ts = calendar.timegm((int(y), int(mo), int(d), int(h), int(mi), int(sec or 0), 0, 0, 0)) + float(frac or 0)
    if tz and tz != 'Z':
        z = tz.replace(':', '')
        ts -= (1 if z[0] == '+' else -1) * (int(z[1:3]) * 3600 + int(z[3:5]) * 60)
    return ts


def iso(ts):
    return time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime(ts))


def win(w, now):
    """一个用量窗口 → {pct, at, reset}；at 是重置时间（秒），reset 表示重置时间已经过了（缓存里的数不算数了）"""
    if not isinstance(w, dict):
        return None
    p = w.get('utilization')
    if isinstance(p, bool) or not isinstance(p, (int, float)):
        return None
    at = parse_ts(w.get('resets_at'))
    return {'pct': p, 'at': at, 'reset': at is not None and at <= now}


def span(secs):
    """一段时长：不到 1 分钟 / 25 分钟 / 2 小时 13 分 / 3 天 4 小时"""
    m = int(max(secs, 0) // 60)
    if m < 1:
        return '不到 1 分钟'
    if m < 60:
        return '%d 分钟' % m
    h, m = divmod(m, 60)
    if h < 24:
        return '%d 小时 %d 分' % (h, m) if m else '%d 小时' % h
    d, h = divmod(h, 24)
    return '%d 天 %d 小时' % (d, h) if h else '%d 天' % d


def resets(at, now):
    """重置时间：一天以内写还有多久，再远写星期几、几点（本地时间）"""
    if at - now < 86400:
        return '%s后重置' % span(at - now)
    lt = time.localtime(at)
    return '周%s %02d:%02d 重置' % (WEEKDAYS[lt.tm_wday], lt.tm_hour, lt.tm_min)


def ago(secs):
    m = int(max(secs, 0) // 60)
    if m < 60:
        return '%d 分钟' % max(m, 1)
    if m < 1440:
        return '%d 小时' % (m // 60)
    return '%d 天' % (m // 1440)


def plan_label(oa, sub=None):
    """套餐：Pro、Max 5x、Max 20x、Team、Enterprise（看 oauthAccount，其次是查询结果里的 subscription_type）"""
    t = str(oa.get('organizationType') or '').lower()
    kind = t[len('claude_'):] if t.startswith('claude_') else str(sub or '').lower()
    name = {'pro': 'Pro', 'max': 'Max', 'team': 'Team', 'enterprise': 'Enterprise', 'free': 'Free'}.get(kind, kind.capitalize())
    m = re.search(r'(\d+)x\b', '%s %s' % (oa.get('organizationRateLimitTier') or '', oa.get('userRateLimitTier') or ''))
    if m and kind in ('max', 'team'):
        name += ' %sx' % m.group(1)
    return name or '—'


def usage_file(key):
    return os.path.join(adir(key), 'usage.json')


def usage_cached(key):
    """最近一次的用量：cca 存的 usage.json 和 Claude Code 的 cachedUsageUtilization 取新的那份；
    登录的已经不是存它的那个账号时不算。返回 {at: 秒, rl: 用量窗口} 或 None"""
    uuid, best = oauth_of(key).get('accountUuid'), None
    for x in (load_quiet(usage_file(key)), acct_json(key).get('cachedUsageUtilization')):
        if not isinstance(x, dict) or not isinstance(x.get('utilization'), dict):
            continue
        at = x.get('fetchedAtMs')
        if isinstance(at, bool) or not isinstance(at, (int, float)):
            continue
        if uuid and x.get('accountUuid') and x['accountUuid'] != uuid:
            continue
        if not best or at / 1000.0 > best['at']:
            best = {'at': at / 1000.0, 'rl': x['utilization']}
    return best


def usage_save(key, rl):
    try:
        save_json(usage_file(key), {'fetchedAtMs': int(time.time() * 1000), 'accountUuid': oauth_of(key).get('accountUuid'),
                                    'utilization': rl}, 0o600)
    except OSError:
        pass


def usage_cell(key, now):
    """菜单里的一格（只读缓存，不联网；只给登录着的账号）：5h 13% · 周 41%；数据旧了注明多久前，
    重置时间过了的窗口写已重置"""
    u = usage_cached(key)
    if not u:
        return ''
    cells = []
    for label, k in (('5h', 'five_hour'), ('周', 'seven_day')):
        w = win(u['rl'].get(k), now)
        if w:
            cells.append('%s %s' % (label, '已重置' if w['reset'] else '%d%%' % round(w['pct'])))
    if not cells:
        return ''
    return ' · '.join(cells) + ('（%s前）' % ago(now - u['at']) if now - u['at'] >= 600 else '')


def usage_result(tmp, i):
    """后台查询的结果：{ok: true, usage} 或 {ok: false, why, msg}（bash 跳过时把原因写在 i.skip）"""
    try:
        with open(os.path.join(tmp, '%d.skip' % i), encoding='utf-8') as f:
            why, _, msg = f.read().rstrip('\n').partition('\t')
        return {'ok': False, 'why': why, 'msg': msg}
    except OSError:
        pass
    try:
        with open(os.path.join(tmp, '%d.json' % i), encoding='utf-8') as f:
            r = json.loads(f.read().strip().splitlines()[-1])
        if isinstance(r, dict):
            return r
    except (OSError, ValueError, IndexError):
        pass
    return {'ok': False, 'why': 'error', 'msg': '没有拿到结果'}


def usage_why(r):
    return USAGE_WHY.get(r['why'], USAGE_WHY['error']).format(name=r['name'], msg=r['msg'] or '原因不明')


def usage_notes(rl, now):
    """表格的备注：分模型的每周额度、额外用量"""
    ms = rl.get('model_scoped')
    pairs = [('Opus', rl.get('seven_day_opus')), ('Sonnet', rl.get('seven_day_sonnet'))]
    pairs += [(m.get('display_name'), m) for m in (ms if isinstance(ms, list) else []) if isinstance(m, dict)]
    out, seen = [], set()
    for label, w in pairs:   # 没用过的（0%）不写，免得一排 0%；JSON 里照样都有
        x = win(w, now)
        if x and label and not x['reset'] and x['pct'] > 0 and str(label).lower() not in seen:
            seen.add(str(label).lower())
            out.append('%s 本周 %d%%' % (label, round(x['pct'])))
    e = rl.get('extra_usage')
    if isinstance(e, dict) and e.get('is_enabled'):
        p = e.get('utilization')
        out.append('额外用量 %d%%' % round(p) if isinstance(p, (int, float)) and not isinstance(p, bool) else '额外用量已开启')
    return out


def usage_json(rows, now, api):
    def w(x):
        v = win(x, now)
        return {'utilization': v['pct'], 'resets_at': x.get('resets_at'), 'reset': v['reset']} if v else None
    out = []
    for r in rows:
        rl = r['rl']
        a = {'account': r['name'], 'key': r['key'], 'email': r['email'] or None, 'plan': r['plan'], 'source': r['source'],
             'fetched_at': iso(r['at']) if r['at'] else None, 'age_seconds': int(now - r['at']) if r['at'] else None,
             'error': usage_why(r) if r['why'] else None}
        for k in ('five_hour', 'seven_day', 'seven_day_opus', 'seven_day_sonnet', 'seven_day_oauth_apps'):
            a[k] = w(rl.get(k))
        ms = rl.get('model_scoped')
        a['model_scoped'] = [dict(w(m) or {}, name=m.get('display_name')) for m in ms if isinstance(m, dict)] if isinstance(ms, list) else None
        a['extra_usage'] = rl.get('extra_usage') if isinstance(rl.get('extra_usage'), dict) else None
        out.append(a)
    return {'version': 1, 'generated_at': iso(now), 'accounts': out, 'skipped_api_accounts': api}


def usage_table(rows, now, cols, color, api):
    width = max(int(cols) if str(cols).isdigit() else 80, 40) - 2
    paint = (lambda s, code: '\033[%sm%s\033[0m' % (code, s) if code and s.strip() else s) if color else (lambda s, code: s)

    def cell(w):
        if not w:
            return '—', ''
        if w['reset']:
            return '已重置', ''
        p = round(w['pct'])
        return ('%3d%%  %s' % (p, resets(w['at'], now)) if w['at'] else '%3d%%' % p), ('31' if p >= 90 else '33' if p >= 70 else '')
    table = []
    for r in rows:
        five, week, notes = cell(win(r['rl'].get('five_hour'), now)), cell(win(r['rl'].get('seven_day'), now)), usage_notes(r['rl'], now)
        if r['source'] == 'none':
            five = week = ('—', '')
            notes = [usage_why(r)]
        elif r['source'] == 'cache':
            notes.insert(0, '缓存（%s前）%s' % (ago(now - r['at']), '：' + usage_why(r) if r['why'] else ''))
        table.append((r, five, week, '；'.join(notes)))
    hd = ('账号', '套餐', '5 小时', '本周')
    cw = [min(max([dw(hd[0])] + [dw(r['name']) for r in rows]), 20), max([dw(hd[1])] + [dw(r['plan']) for r in rows]),
         max([dw(hd[2])] + [dw(x[1][0]) for x in table]), max([dw(hd[3])] + [dw(x[2][0]) for x in table])]
    room = width - 2 - sum(cw) - 2 * len(cw)   # 同一行里留给备注的宽度；放不下就挪到下一行
    print(paint(('  ' + '  '.join(fit(h, cw[i]) for i, h in enumerate(hd)) + ('  备注' if room >= 12 else '')).rstrip(), '2'))
    for r, five, week, note in table:
        dim = '' if r['source'] == 'live' else '2'
        cells = [(r['name'], dim), (r['plan'], dim), (five[0], five[1] or dim), (week[0], week[1] or dim)]
        s = '  ' + '  '.join(paint(fit(text, cw[i]), code) for i, (text, code) in enumerate(cells))
        ncode = '2' if dim else ''
        if not note:
            print(s.rstrip())
        elif dw(note) <= room:
            print(s + '  ' + paint(note, ncode))
        else:
            print(s.rstrip())
            print(' ' * (4 + cw[0]) + paint(fit(note, max(width - 4 - cw[0], 20), pad=False), ncode))
    if api:
        print(paint('  第三方 API 账号没有订阅用量，不查：%s' % '、'.join(name_of(k) for k in api), '2'))


def cmd_usage_render(tmp, mode, cols, color, *keys):
    """把后台查询的结果整理成表格或 JSON（stdout）；查到的存进 usage.json，查不到的用缓存顶上（注明多久前）"""
    c, t, _ = ctx()
    now, rows = time.time(), []
    for i, k in enumerate(keys):
        r = usage_result(tmp, i)
        u = r.get('usage') if r.get('ok') else None
        if isinstance(u, dict) and not (u.get('rate_limits_available') and isinstance(u.get('rate_limits'), dict)):
            r, u = {'ok': False, 'why': 'nolimits', 'msg': ''}, None
        row = {'key': k, 'name': name_of(k), 'email': parse_key(k)[1] or email_of(k),
               'plan': plan_label(oauth_of(k), (u or {}).get('subscription_type')),
               'source': 'none', 'at': None, 'rl': {}, 'why': None if u else (r.get('why') or 'error'), 'msg': r.get('msg') or ''}
        if u:
            row.update(source='live', at=now, rl=u['rate_limits'])
            usage_save(k, u['rate_limits'])
        elif row['why'] not in ('login', 'mismatch'):
            x = usage_cached(k)
            if x:
                row.update(source='cache', at=x['at'], rl=x['rl'])
        rows.append(row)
    official = {k for k, v in t.items() if not is_api(v)}
    api = [k for k, v in t.items() if is_api(v)] if set(keys) == official else []
    if mode == 'json':
        print(json.dumps(usage_json(rows, now, api), ensure_ascii=False, indent=2))
    else:
        usage_table(rows, now, cols, color == '1', api)
    sys.exit(0 if any(r['source'] != 'none' for r in rows) else 1)


