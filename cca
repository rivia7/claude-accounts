def cmd_rename(key, alias):
    """改别名（cca rename，图形界面的“改别名…”也用它）：只换账号表里的键，值和顺序都不变。官方账号按邮箱认、
    第三方 API 账号按 id 认，账号目录、端口、“上次使用”、路由器的摘要都跟着走（acct_id 不变）。新别名写 - 去掉别名、只留邮箱。
    成功时打印新的键；不行时把原因打到 stdout、退出码 3（bash 把它报成 alias_invalid）"""
    c, t, _ = ctx()
    need(t, key)
    alias = alias.strip()
    if alias == '-':
        alias = ''
    email = parse_key(key)[1]
    api = is_api(t[key])

    def bad(msg):
        print(msg)
        sys.exit(3)

    if not api and not email:   # 只写了别名的官方账号：按别名认，换了别名就换了账号目录
        bad('%s 的键里没有邮箱：改名会换掉它的账号目录（登录、浏览器资料都在里面）。先用 %s edit 补上邮箱，写成「别名(邮箱)」'
            % (key, T.cmd))
    if not alias:
        if api:
            bad('第三方 API 账号必须有别名')
        new = email
    else:
        p = alias_problem({k: v for k, v in t.items() if k != key}, alias)
        if p:
            bad(p)
        new = alias if api else '%s(%s)' % (alias, email)
    if new != key:
        t2 = {(new if k == key else k): v for k, v in t.items()}
        save_json(T.table, t2, 0o600)
        T.set_ids(t2)   # 第三方 API 账号：新键 → id，对账时端口、“上次使用”按 id 跟着走
        ctx()
    print(new)


def cmd_reorder(*names):
    """cca reorder：按这个顺序排账号表（没写到的账号接在后面，先后不变）。图形界面调整账号顺序时用它。
    只改账号表里的先后；第一次调整之前先记下原来的顺序（base_order），端口池、摘要、颜色都不跟着变"""
    with Lock():
        c, t, _ = ctx()
        order = []
        for n in names:
            k = account_named(t, n)
            if k not in order:
                order.append(k)
        order += [k for k in t if k not in order]
        if order != list(t):
            T.state(c)['order_base'] = [acct_id(k) for k in base_order(c, t)]
            cfg_save(c)
            save_json(T.table, {k: t[k] for k in order}, 0o600)


