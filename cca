def read_answer(prompt):
    """从 fd 3 读一行答案（和 bash 的 ask 一样：终端，或 CCA_TTY 答案文件），提示写 stderr。一个字节一个字节地读，不多读：
    答案文件后面的行还要留给 bash。没有 fd 3、读到头是 None"""
    sys.stderr.write(prompt)
    sys.stderr.flush()
    buf = b''
    try:
        while True:
            ch = os.read(3, 1)
            if not ch:
                return buf.decode('utf-8', 'replace') if buf else None
            if ch == b'\n':
                return buf.decode('utf-8', 'replace')
            buf += ch
    except OSError:
        return None


def agy_code_problem(text, state):
    """贴回来的授权码有什么不对：整个网址时核对是不是这次登录的（state 对得上），登录页报错时说出来。没问题是空字符串"""
    from urllib.parse import urlsplit, parse_qsl
    if not re.match(r'^[\x21-\x7e]{1,8192}$', text):
        return '授权码应该是一行字母、数字和符号（不能有空格）'
    if not re.match(r'^https?://', text):
        return ''
    try:
        q = dict(parse_qsl(urlsplit(text).query, keep_blank_values=True))
    except ValueError:
        return '这个网址读不出来'
    if q.get('error'):
        return '登录页报错：%s' % re.sub(r'[^\x20-\x7e]', '', q['error'])[:80]
    if not q.get('code'):
        return '这个网址里没有授权码'
    if state and q.get('state') != state:
        return '这不是这次登录跳到的网址（state 对不上）：贴最后一次打开的登录页登录后显示的那一个'
    return ''


def cmd_agy_login(bin_, mode='local'):
    """agy 账号登录（在 bash 设好的账号环境里前台运行）：agy --gemini_dir=账号目录 acp --login 打出 Google 的登录网址，补上
    login_hint 后回调 cca _browser 在账号专属的 Chrome 里打开（mode=remote：服务器上，给出在 Mac 上运行的 login-page 那一行）。
    登录后 Google 跳到 antigravity.google 的页面上显示授权码：cca 照常从 fd 3 问（终端或答案文件），核对过再写给 agy 的 stdin
    （它自己从 stdin 读；直接回车取消）。agy 的英文提示换成中文，别的输出原样转到 stderr。登录成功时 agy 说的 Logged in as 邮箱
    记进账号目录的 agy-login.json（只有 token 文件读不出邮箱时 agy_claims 才用）。退出码是 agy 的"""
    import signal, subprocess
    key = os.environ.get('CCA_ACCOUNT') or die('cca(py): 没有账号')
    t = ctx()[1]
    need(t, key)

    def stop(*_):   # 和 Ctrl-C 一样：停掉 agy，不留下等授权码的进程
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, stop)
    p = subprocess.Popen([bin_, '--gemini_dir=' + cdir(key), 'acp', '--login'], stdin=subprocess.PIPE,
                         stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    buf, st = b'', {'opened': False, 'state': '', 'asked': 0, 'said': False}

    def cancel(msg):
        sys.stderr.write(msg + '\n')
        st['said'] = True
        raise KeyboardInterrupt

    def ask_code():
        while True:
            st['asked'] += 1
            if st['asked'] > 5:
                cancel('试了好几次都没成，已停止登录')
            code = read_answer('  授权码（登录后页面上显示的那一段，也可以贴整个网址；直接回车取消）：')
            code = (code or '').strip()
            if not code:
                cancel('已取消登录')
            why = agy_code_problem(code, st['state'])
            if not why:
                break
            sys.stderr.write('  %s\n' % why)
        try:
            p.stdin.write(code.encode() + b'\n')
            p.stdin.flush()
        except OSError:
            pass

    def show(text):
        m = AGY_LOGIN_URL.search(text)
        if m and not st['opened']:
            st['opened'] = True
            url = login_hint_url(key, m.group(0))
            st['state'] = agy_login_target(url) or ''
            if mode == 'remote':
                agy_remote_note(key, url)
            elif subprocess.run([SELF_PATH, '_browser', url], stdin=subprocess.DEVNULL).returncode != 0:
                cancel('没能在账号的浏览器里打开登录页，已停止登录')
            return
        m = AGY_LOGGED_IN.search(text)
        if m and EMAIL_RE.match(m.group(1)):
            save_json(os.path.join(adir(key), 'agy-login.json'), {'email': m.group(1), 'at': int(time.time())}, 0o600)
        elif AGY_CODE_PROMPT.search(text):
            ask_code()
        elif text.strip() and not text.lstrip().startswith('Open this link in a browser'):
            sys.stderr.write(text + '\n')
    try:
        fd = p.stdout.fileno()
        while True:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            buf += chunk
            while buf:
                if b'\n' in buf:
                    line, buf = buf.split(b'\n', 1)
                elif AGY_CODE_PROMPT.search(buf.decode('utf-8', 'replace')):   # 问授权码的那一句后面没有换行
                    line, buf = buf, b''
                else:
                    break
                show(line.decode('utf-8', 'replace').rstrip('\r'))
        if buf:
            show(buf.decode('utf-8', 'replace'))
        rc = p.wait()
    except KeyboardInterrupt:
        p.terminate()
        try:
            p.wait(5)
        except subprocess.TimeoutExpired:
            p.kill()
        if not st['said']:   # Ctrl-C、关掉终端
            sys.stderr.write('\n已取消登录\n')
        sys.exit(130)
    sys.exit(rc)


# --- 服务器上登录（bash 的 remote_login / cmd_login_page）：claude / codex 在服务器上跑登录、等本机的回调；登录页由 Mac 上的
# cca login-page 用账号专属的 Chrome、经同一个节点打开，Mac 接住跳回 localhost 的那一下，验证码（code#state）贴回服务器，
# 服务器核对 state 后转给本机的回调。换 token 的始终是服务器上的 claude / codex（PKCE：验证码离了它手里的 verifier 没用）
LOGIN_CODE_RE = lazy_re(r'^[\x21-\x22\x24-\x7e]{1,4096}$')   # 可见的 ASCII，不含 #（code#state 的分隔）


def login_target(url):
    """登录网址 → (回调的主机, 端口, 路径, state)；不是这个工具的登录页（T.login_hosts 里的 https 地址、/oauth/authorize、
    带 PKCE），或者回调不在本机的 http 端口上时返回 None"""
    from urllib.parse import urlsplit, parse_qsl
    if not isinstance(url, str) or not re.match(r'^https://[\x21-\x7e]{1,8192}$', url):
        return None
    try:
        u = urlsplit(url)
        q = dict(parse_qsl(u.query, keep_blank_values=True))
        r = urlsplit(q.get('redirect_uri', ''))
        port = r.port
    except ValueError:
        return None
    if (u.hostname not in T.login_hosts or not u.path.endswith('/oauth/authorize') or q.get('response_type') != 'code'
            or not q.get('code_challenge') or r.scheme != 'http' or r.hostname not in ('localhost', '127.0.0.1')
            or not port or not LOGIN_CODE_RE.match(q.get('state', ''))):
        return None
    return r.hostname, port, r.path or '/', q['state']


def cmd_login_check(url):
