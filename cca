router_sh() {
	cat <<'SH'
#!/bin/sh
# cca-router：由 Mac 上的 cca 部署和管理，请勿手改（会被覆盖）。
# 在路由器的 mihomo 里维护一个账号端口池：槽位 n = mixed 入站 cca-n（端口 base+n）+ select 策略组 CCA-n。
# 支持 OpenClash 和 ShellCrash，自动检测在用的是哪个；两个都装了时钩子都装上，换着用也不丢端口池。
# 账号分到哪个槽位、用哪个节点，只靠 API 切换 CCA-n 的选中项，不需要重载；
# 只有槽位数量或可选节点变化（即"结构"变化）才需要重载，且必须由 Mac 端征得同意（CCA_ALLOW_RELOAD=1）。
# 重载期间（本机约 20 秒）内核只处理内部连接，局域网的新连接会失败，所以 cron 自愈从不自动重载。
R="${CCA_ROOT:-}"
D="$R/etc/cca"
ACC="$D/accounts.yaml"
PORTS="$D/ports"
SEL="$D/select"
# 维护者参考配置里的节点（accounts.yaml 的 fill）直接写进 OpenClash / ShellCrash 的配置文件（见 fill_source）
FILLOK="$D/fill.ok"       # 这一版在这台路由器的内核上校验通过了，记着它的 id
FILLPEND="$D/fill.pending"   # 刚写进配置文件，在跑的 OpenClash / ShellCrash 还是按之前的配置生成的：重启后才用得上
FILLSEEN="$D/fill.seen"   # 上次核对时账号表、配置文件和内核的校验和：都没变就不用再读一遍配置文件（每次在家启动 cca 都核对）
FILLWHY="$D/fill.why"     # 上次没写成的原因（cca router status 里说）
SRCBAK="$D/source.bak.yaml"   # 写之前的配置文件
OW="$R/etc/openclash/custom/openclash_custom_overwrite.sh"
CRON="$R/etc/crontabs/root"
SYSUP="$R/etc/sysupgrade.conf"
LOG="$R/tmp/cca-router.log"
CTLOUT="$R/tmp/cca.ctl.$$"
TAB=$(printf '\t')
MB='# >>> cca >>>'
ME='# <<< cca <<<'
SCHOOK='cca-router.sh sc-hook'   # ShellCrash 的钩子是它启动前任务文件（sc_task）里不带 # 的一行：它的任务菜单"清空旧版任务"会删掉带 # 的行
# ruby 里读 YAML 用 yl：配置里可以有锚点（ShellCrash 的 others.yaml 就是写锚点的地方），新版 Psych 要 aliases: true 才肯读，旧版不认这个参数
YL='def yl(f); YAML.load(File.read(f), aliases: true); rescue ArgumentError; YAML.load_file(f); end'

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG"; }
rewrite() { cat "$2" > "$1" && rm -f "$2"; }   # 原地覆盖，保留属主和权限
put_runtime() {   # put_runtime 运行配置 新文件：原地覆盖；运行配置是链接时（ShellCrash 关了覆写，链到订阅配置）换成文件，不写穿过去
	[ -L "$1" ] && rm -f "$1"
	if [ -e "$1" ]; then rewrite "$1" "$2"; else mv -f "$2" "$1"; fi
}

# --- 在用的是哪套：OpenClash 还是 ShellCrash ----------------------------------------------
sc_find() {   # ShellCrash（juewuy/ShellCrash）的目录：和它自己的 init 脚本一样从 /etc/profile 的 CRASHDIR 读
	SC=""
	sd=$(sed -n 's/^export CRASHDIR="\(.*\)"$/\1/p' "$R/etc/profile" 2>/dev/null | tail -n 1)
	[ -n "$sd" ] && [ -f "$R$sd/start.sh" ] || sd=/etc/ShellCrash
	[ -f "$R$sd/start.sh" ] || return 1
	SC="$R$sd"
	# 运行目录：1.9.x 写在 configs/command.env，下一版起挪到 configs/directories.env。和它自己一样先读后者、再读前者（有就以前者为准）
	st=$(cat "$SC/configs/directories.env" "$SC/configs/command.env" 2>/dev/null | sed -n 's/^TMPDIR=//p' | tail -n 1 | tr -d "\"'")
	sb=$(cat "$SC/configs/directories.env" "$SC/configs/command.env" 2>/dev/null | sed -n 's/^BINDIR=//p' | tail -n 1 | tr -d "\"'")
	SCT="$R${st:-/tmp/ShellCrash}"   # 运行配置和内核在这里
	SCB="$R${sb:-$sd}"               # 内核的主目录（-d）
}
sc_task() {   # ShellCrash 启动前 source 的任务文件：1.9.x 是 task/bfstart，下一版起是 configs/task/bfstart（看它的启动脚本里写的是哪个；
	           # 目录在不在不算数：有的 1.9.4 上本来就有 configs/task/）
	if grep -qs 'TASKCFGDIR[}"]*/bfstart' "$SC/starts/bfstart.sh" "$SC/start.sh"; then echo "$SC/configs/task/bfstart"; else echo "$SC/task/bfstart"; fi
}
backend() {   # 在跑的优先（ShellCrash 的内核进程叫 CrashCore，OpenClash 的叫 clash）；都没在跑时看哪个开机自启，再看装了哪个
	sc_find
	if [ -n "$SC" ] && pidof CrashCore >/dev/null 2>&1; then BK=sc
	elif pidof clash >/dev/null 2>&1; then BK=oc
	elif [ -d "$R/etc/openclash" ] && [ "$(uci -q get openclash.config.enable 2>/dev/null)" = 1 ]; then BK=oc
	elif [ -n "$SC" ] && ls "$R"/etc/rc.d/S*shellcrash >/dev/null 2>&1; then BK=sc
	elif [ -n "$SC" ] && [ ! -d "$R/etc/openclash" ]; then BK=sc
	else BK=oc; fi
	if [ "$BK" = sc ]; then NAME=ShellCrash; else NAME=OpenClash; fi
}
sc_cfg() {   # sc_cfg 名字 [默认值]：ShellCrash 的设置（configs/ShellCrash.cfg，它自己也是 source 这个文件）
	( [ -f "$SC/configs/ShellCrash.cfg" ] && . "$SC/configs/ShellCrash.cfg" >/dev/null 2>&1; eval "printf '%s' \"\${$1:-$2}\"" )
}
sc_meta() {   # cca 只支持 ShellCrash 的 mihomo（Meta）内核：sing-box 的配置是另一套，原版 clash 没有 listeners
	[ "$(sc_cfg crashcore meta)" = meta ]
