# 先压缩源码快照，避免源码和用户环境一起超过 macOS 的 exec 参数上限；管道不读取调用者的 stdin。gzip、base64 用系统自带的那份
# （/usr/bin；没合并 /usr 的 Linux 发行版在 /bin）
_gz=/usr/bin/gzip; [ -x "$_gz" ] || _gz=/bin/gzip
_b64=/usr/bin/base64; [ -x "$_b64" ] || _b64=/bin/base64
PY_PACKED=$(set -o pipefail; printf '%s' "$PY_SRC" | "$_gz" -n -c | "$_b64") ||
	{ printf '%s\n' 'cca: 无法打包内嵌 Python' >&2; exit 1; }
unset PY_SRC _gz _b64
export -n PY_PACKED PY_BOOT
# 每次 py 都是新的 Python 进程：PY_BOOT 把编译好的源码按摘要存在 PYC_DIR 里（只有自己能读写，换了版本摘要就变），
# 下次直接载入，省掉每次 30 多毫秒的编译。目录不是自己的、别人能进、是链接，或者缓存读不了，就照常编译、不用缓存。
# 每个版本（和每个 Python 版本）一份，约 0.5 MB：写新的一份时顺手删掉 7 天前写的（旧版本的，还有没写完的临时文件），
# 不然越积越多（Linux 上没有 XDG_RUNTIME_DIR 时在 ~/.cache 里，系统不会清；比如 crontab 里开机起内核的那一行）。
# 只认缓存的文件名（十六进制的摘要-版本号），python3 那个文件等别的不动；平时只读缓存，不多一次系统调用
PY_BOOT='import sys, os, marshal, zlib, base64
d, packed = sys.argv.pop(1), sys.argv.pop(1)
if packed[:1] == "+":
    n = int(packed[1:])
    packed = "".join(sys.argv[1:1 + n])
    del sys.argv[1:1 + n]
src = zlib.decompress(base64.b64decode(packed), 31).decode("utf-8")
code = p = None
try:
    if d and not os.path.isdir(d):
        os.mkdir(d, 0o700)
    st = os.lstat(d)
    if os.path.isdir(d) and not os.path.islink(d) and st.st_uid == os.getuid() and not st.st_mode & 0o077:
        b = src.encode("utf-8")
        p = os.path.join(d, "%08x%08x%x-%x" % (zlib.crc32(b), zlib.adler32(b), len(b), sys.hexversion))
        with open(p, "rb") as f:
            code = marshal.load(f)
except Exception:
    code = None
if code is None:
    code = compile(src, "cca-py", "exec")
    if p:
        try:
            t = "%s.%d" % (p, os.getpid())
            with os.fdopen(os.open(t, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "wb") as f:
                marshal.dump(code, f)
            os.replace(t, p)
            old = os.stat(p).st_mtime - 7 * 86400
            for n in os.listdir(d):
                h, _, v = n.partition("-")
                if len(h) > 16 and v and not (h + v).strip("0123456789abcdef."):
                    try:
                        if os.lstat(os.path.join(d, n)).st_mtime < old:
                            os.unlink(os.path.join(d, n))
                    except OSError:
                        pass
        except OSError:
            pass
exec(code, {"__name__": "__main__"})'
case "$OSTYPE" in
	darwin*) PYRUN=("$PYTHON" -I -X utf8 -c "$PY_BOOT" "$PYC_DIR" "$PY_PACKED") ;;   # -X utf8：不管 locale 是什么都按 UTF-8 输出
	*)	# Linux 上 exec 的单个参数最多 128KB（MAX_ARG_STRLEN），打包好的源码一个参数放不下：拆成几段，前面加一个「+段数」，PY_BOOT 再拼起来
		# （base64 的 gzip 总是 H4sI 开头，不会和它混）。按字节切：bash 在 UTF-8 locale 下逐字数，这么长的字符串慢好几倍
		_lc=${LC_ALL-}; _lcs=${LC_ALL+1}; LC_ALL=C; _a=()
		while [ -n "$PY_PACKED" ]; do _a+=("${PY_PACKED:0:120000}"); PY_PACKED=${PY_PACKED:120000}; done
		if [ -n "$_lcs" ]; then LC_ALL=$_lc; else unset LC_ALL; fi
		PYRUN=("$PYTHON" -I -X utf8 -c "$PY_BOOT" "$PYC_DIR" "+${#_a[@]}" "${_a[@]}")
		unset _a _lc _lcs ;;
esac
unset PY_PACKED
py() { CCA_SELF="$SELF" CCA_TOOL="$TOOL" CCA_BIN="$TOOL_BIN" "${PYRUN[@]}" "$@"; }

use_tool() {   # use_tool codex|agy：这次命令管 Codex（账号表 codex.json、CODEX_HOME、codex 命令）或 agy 的账号；账号表、命令前缀、文案由 py 给
	TOOL="$1"
	case "$TOOL" in
