    slot = port - FIRST_PORT + 1 if port else None
    login = 'api' if api else login_code(k)
    usage = plan = x = None
    tier = ''
    if not api and login == 'logged_in':
        x = usage_cached(k)
        sub = (x['rl'].get('plan') if x else None) or None
        plan, tier = T.plan(k, sub), T.plan_tier(k, sub)
        if x:
            usage = usage_entry(usage_row(k, plan, source='cache', at=x['at'], rl=x['rl'],
                                          outdated_login_plan=T.outdated_login_plan(k)), now)
    pat = None if api or not T.app_proc else app_proc_re(T, os.path.join(adir(k), 'desktop'))
    pid = None if pat is None else next((p for p, cmd in procs if pat.search(cmd)), None)
    why = {}
