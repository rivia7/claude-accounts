def email_problem(t, email):
    if not EMAIL_RE.match(email):
        return '这不像邮箱地址（例如 name@example.com）'
    for k in t:
        if parse_key(k)[1].lower() == email.lower():
            return '这个邮箱已经添加过了：%s' % label_of(k)
    return ''


def alias_problem(t, alias):
    if ALIAS_BAD.search(alias):
        return '别名里不能有空格、引号、括号、反斜杠或 @'
    if dw(alias) > 24:
        return '别名太长了（最多 12 个汉字或 24 个字母）'
    for k in t:
        if parse_key(k)[0] == alias:
            return '别名「%s」已经用在 %s 上了' % (alias, label_of(k))
    return ''


def cmd_prompt_emit():
    """提问会话（PROTOCOL 4.6）：把一页提问写进事件文件，打印序号。描述从 stdin 读（k=v，一行一条；field= 开始一个字段）。
    序号 = 文件里已有的 ask 事件数 + 1：提问常在子 shell 里，变量带不出来"""
    path = os.environ.get('CCA_EVENTS') or die('cca(py): 没有事件文件')
    page = {'v': 1, 'ev': 'ask', 'seq': 0, 'q': '', 'title': '', 'message': '', 'fields': []}
    cur = None
    for line in sys.stdin:
        k, sep, v = line.rstrip('\n').partition('=')
        if not sep:
            continue
        if k in ('q', 'title', 'message', 'submit'):
            page[k] = v
        elif k == 'field':
            cur = {'id': v, 'kind': 'text', 'label': '', 'default': '', 'value': '', 'error': '', 'hint': '', 'optional': False}
            page['fields'].append(cur)
        elif cur is None:
            continue
        elif k == 'prompt':
            cur['label'] = cur['label'] or prompt_label(v)
        elif k == 'optional':
            cur[k] = v == '1'
        elif k == 'opt':
            value, label, note = (v.split('\t') + ['', ''])[:3]
            cur.setdefault('options', []).append({'value': value, 'label': label, 'note': note})
        elif k == 'min':
            cur[k] = int(v)
        elif k == 'code':   # 多行文字（kind 是 code 的字段）：一行一条
            cur['value'] = cur['value'] + '\n' + v if cur['value'] else v
        elif k in ('kind', 'label', 'default', 'value', 'error', 'hint', 'detail', 'severity', 'skip', 'section', 'style'):
            if v or k != 'label':
                cur[k] = v
    with open(path, 'rb') as f:
        page['seq'] = sum(1 for row in f if b'"ev":"ask"' in row) + 1
    with open(path, 'a', encoding='utf-8') as f:
        f.write(json.dumps(page, ensure_ascii=False, separators=(',', ':')) + '\n')
    print(page['seq'])


def prompt_label(p):
    """没有专门写名字时，用终端的提示语当名字（去掉前后的空白、冒号和方括号里的默认值）"""
    s = re.sub(r'\s*\[[^\]]*\]\s*[：:]?\s*$', '', p.strip())
    return s.rstrip('：: ')


def cmd_check(field, value):
    """新增账号时逐项校验：合格时打印规范化后的值（邮箱转小写），不合格时打印原因并返回 1"""
    value = value.strip()
    if field == 'email':
        value = value.lower()
    elif field == 'url':
        value = value.rstrip('/')
    if not value:
        p = ''
    elif field == 'url':
        p = url_problem(value)
    elif field == 'model':
        p = '' if model_ok(value) else MODEL_MSG
    elif field == 'host':
        p = '' if HOST_RE.match(value) else '地址写成 192.168.1.2 或者主机名（不带 http://、端口和空格）'
    elif field == 'sshuser':
        p = '' if SSH_USER_RE.match(value) else '用户名只能有字母、数字、点、下划线和连字符'
    elif field == 'port':
        p = '' if re.match(r'^[0-9]{1,5}$', value) and 1 <= int(value) <= 65535 else '端口是 1–65535 之间的数字'
    elif field == 'controller':
        p = '' if CONTROLLER_RE.match(value) else '写成 127.0.0.1:9090、http://地址:端口，Unix socket 写 unix:/路径'
    else:
        p = (email_problem if field == 'email' else alias_problem)(table_load(), value)
    print(p or value)
    sys.exit(1 if p else 0)


