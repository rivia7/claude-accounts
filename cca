def cmd_resolve(q=''):
    """按完整的键、编号、别名或邮箱找账号，其次按它们的唯一前缀"""
    if not q:
        die('需要指定账号（别名、邮箱、编号或唯一前缀）')
    t = ctx()[1]
    keys = list(t)
    if q in t:
        return print(q)
    if q.isdigit() and 1 <= int(q) <= len(keys):
        return print(keys[int(q) - 1])
    ql = q.lower()
    names = {k: [x.lower() for x in (k,) + parse_key(k) if x] for k in keys}
    for hit in (lambda x: x == ql, lambda x: x.startswith(ql)):
        hits = [k for k in keys if any(hit(x) for x in names[k])]
        if len(hits) == 1:
            return print(hits[0])
        if hits:
            die('「%s」匹配到多个账号: %s' % (q, '、'.join(label_of(k) for k in hits)))
    die('没有匹配的账号: %s' % q)


