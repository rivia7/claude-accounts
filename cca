        print('%s=%s' % (k, shlex.quote(str(v))))


# --- 配置与账号表 -----------------------------------------------------------
def cfg_load():
    c = load_json(CFG, None) or {}
    c.setdefault('version', 2)
    c.setdefault('router', {})
