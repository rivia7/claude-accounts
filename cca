def table_load():
    t = load_json(TABLE, {})
    if not isinstance(t, dict):
        die('%s 应该是 {"别名(邮箱)": "节点"} 形式的 JSON 对象' % TABLE)
    return t


def parse_key(key):
    """账号表的键 → (别名, 邮箱)。键可以是「别名(邮箱)」、只写邮箱，或只写别名（登录页不预填邮箱）"""
    m = PAIR_RE.match(key)
    if m and EMAIL_RE.match(m.group(2)):
        return m.group(1), m.group(2)
    return ('', key) if EMAIL_RE.match(key) else (key, '')


def name_of(key):
    """菜单和提示里的短名字：有别名用别名，否则用邮箱"""
    a, e = parse_key(key)
    return a or e


def label_of(key):
    a, e = parse_key(key)
    return '%s（%s）' % (a, e) if a and e else a or e


def acct_id(key):
    k = parse_key(key)[1] or key   # 有邮箱就按邮箱认账号：改别名不换账号目录，登录和浏览器资料都还在
    s = re.sub(r'[^a-z0-9]+', '-', k.lower()).strip('-')[:20].strip('-') or 'acct'
    return '%s-%s' % (s, hashlib.sha1(k.encode('utf-8')).hexdigest()[:6])


def adir(key):
    return os.path.join(CCA_HOME, 'accounts', acct_id(key))


def cdir(key):
    return os.path.join(adir(key), 'claude')


def reconcile(c, t):
    """校验账号表；给新账号分配固定端口，回收已删除账号的端口。返回错误列表。
    只改了别名的账号按邮箱认出来：端口和"上次使用"跟着走。"""
    errs, emails, aliases = [], {}, {}
    if t and not c['nodes']:
        errs.append('config.json 里还没有可选节点（nodes）：运行 cca router setup 从路由器的节点里选')
    for k, node in t.items():
        if not KEY_RE.match(k):
            errs.append('「%s」：不能含空格、引号或反斜杠，最长 100 个字符' % k)
        a, e = parse_key(k)
        if not e and re.search('[()（）]', k):
            errs.append('「%s」：括号里应该是登录邮箱，例如 主号(name@example.com)' % k)
        if e:
            if e.lower() in emails:
                errs.append('邮箱 %s 同时出现在「%s」和「%s」里' % (e, emails[e.lower()], k))
            emails.setdefault(e.lower(), k)
        if a:
            if a in aliases:
                errs.append('别名「%s」同时用在「%s」和「%s」上' % (a, aliases[a], k))
            aliases.setdefault(a, k)
        if not isinstance(node, str) or not node:
            errs.append('%s：节点必须是非空字符串' % k)
        elif c['nodes'] and node not in c['nodes']:
            errs.append('%s：节点「%s」不在可选列表（%s）' % (k, node, '、'.join(c['nodes'])))
    old = c['ports']
    by_id = {acct_id(k): p for k, p in old.items()}
    ports, used = {}, set()
    for k in t:
        p = old.get(k) or by_id.get(acct_id(k))
        if isinstance(p, int) and p not in used:
            ports[k] = p
            used.add(p)
    for k in t:
        if k not in ports:
            p = FIRST_PORT
            while p in used:
                p += 1
            ports[k] = p
            used.add(p)
    c['ports'] = ports
    if c.get('last') not in t:
        lid = acct_id(c['last']) if c.get('last') else ''
        c['last'] = next((k for k in t if acct_id(k) == lid), '')
    return errs


def ctx():
    c, t = cfg_load(), table_load()
    errs = reconcile(c, t)
    if c != load_json(CFG, None):
        cfg_save(c)
    return c, t, errs


def cfg_save(c):
