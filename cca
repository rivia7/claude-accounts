def verge_sock():
    """Clash Verge 运行配置里内核控制接口的 Unix socket（它默认只开这个，不开 HTTP）"""
    try:
        with open(os.path.join(VERGE_DIR, 'clash-verge.yaml'), encoding='utf-8') as f:
            for line in f:
                m = re.match(r'external-controller-unix:\s*[\x22\x27]?([^\x22\x27\s]+)', line)
                if m:
                    return m.group(1)
    except OSError:
        pass
    return ''


def verge_items(text):
    """profiles.yaml 里 items 的每一项：{键: 值}，只读每一项自己那一层、值是一行写完的键（serde_yaml 的写法）"""
    items, cur, inside = [], None, False
    for line in text.split('\n'):
        if re.match(r'items:\s*$', line):
            inside = True
            continue
        if not inside:
            continue
        if line and not line.startswith((' ', '-', '#')):   # 下一个顶层的键
            break
        if line.startswith('- '):
            cur = {}
            items.append(cur)
            line = '  ' + line[2:]
        m = re.match(r'  ([A-Za-z_][A-Za-z0-9_-]*):[ \t]*(.*?)[ \t]*$', line)
        if cur is not None and m and m.group(2):
            cur.setdefault(m.group(1), yaml_unquote(m.group(2)))
    return items


def verge_profile():
    """Clash Verge 当前选用的配置（订阅或本地配置）：(文件路径, 名字)；没选、选的不是这两种、文件不在时是 None"""
    try:
        with open(os.path.join(VERGE_DIR, 'profiles.yaml'), encoding='utf-8') as f:
            text = f.read()
    except OSError:
        return None
    m = re.search(r'^current:[ \t]*(\S.*?)[ \t]*$', text, re.M)
    cur = yaml_unquote(m.group(1)) if m else ''
    for it in verge_items(text):
        if cur and it.get('uid') == cur and it.get('type') in ('local', 'remote') and it.get('file'):
            path = os.path.join(VERGE_DIR, 'profiles', os.path.basename(it['file']))
            return (path, it.get('name') or it['file']) if os.path.isfile(path) else None
    return None


def fill_marked(path):
    """配置文件里 cca 写进去的（行尾带「# cca」的行）：(节点名的集合, 补进策略组的名字的列表)。节点在 proxies 段里（块写法的
    记号在 name 那一行），组成员在 proxy-groups 段里（都是补进参考节点的那个组的）"""
    try:
        with open(path, encoding='utf-8') as f:
            lines = f.read().split('\n')
    except OSError:
        return set(), []
    nodes, members, sec = set(), [], ''
    for line in lines:
        if re.match(r'[a-z]', line):
            sec = line.split(':', 1)[0]
            continue
        m = re.match(r' *- (.*?)[ \t]+# cca[ \t]*\r?$', line)
        if not m:
            continue
        if sec == 'proxies':   # 一项的第一行：块写法的 "- name: 节点"，或者以前写成一行的 "- {name: 节点, …}"
            if m.group(1).startswith('{'):
                n = flow_get(m.group(1), 'name')
            else:
                nm = re.match(r'name:\s*(.*)$', m.group(1))
                n = yaml_unquote(nm.group(1)) if nm else None
            if n:
                nodes.add(n)
        elif sec == 'proxy-groups' and not m.group(1).startswith('{'):
            members.append(yaml_unquote(m.group(1)))
    return nodes, members


