NODE_ID_RE = lazy_re(r'^[0-9a-f]{16}$')


def node_fp_here(c, n):
    """这台机器上节点 n（账号表里的叫法）的摘要：路由器同步时记下的（node_ids），没有就从内置代理拷来的节点定义、维护者的
    参考节点里按名字找。认不出是空的"""
    f = node_ids(c).get(n)
    if f:
        return f
    for p in core_defs() + list((policy_fill() or {}).get('proxies') or []):
        if isinstance(p, dict) and p.get('name') == n:
            return fill_fp(p)
    return ''


