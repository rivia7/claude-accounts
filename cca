  config.listeners = (config.listeners || []).filter(keep(/^cca-\d+$/));
  pool.forEach(function (s) {
    var m = s[2].filter(function (n) { return n === 'REJECT' || have[n]; });
    if (m[0] !== s[2][0]) m = ['REJECT'].concat(m.filter(function (n) { return n !== 'REJECT'; }));   // 分到的节点不在：宁可断开也不换出口
    config['proxy-groups'].push({ name: s[0], type: 'select', proxies: m });
    config.listeners.push({ name: s[0].toLowerCase(), type: 'mixed', listen: '127.0.0.1', port: s[1], users: [], proxy: s[0] });
