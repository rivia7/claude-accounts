# 命令行会话的登记（_gui state 的 cli）：run_account 启动 claude / codex 之前在账号目录写 cli-<cca 的进程号>.json，
# 工具一退出就删（bash 的 session_close）。记 cca 的进程号和它的启动时间：进程号会被重用，启动时间对得上才是同一个进程
CLI_MARK = lazy_re(r'^cli-([0-9]+)\.json$')


def lstart_epoch(s):
    """ps 的 lstart（C 语言环境的写法：Sat Nov  7 12:08:55 2026，本地时间）换成时间戳；读不懂返回 0"""
    try:
        return int(time.mktime(time.strptime(' '.join(s.split()), '%a %b %d %H:%M:%S %Y')))
    except (ValueError, OverflowError):
        return 0


def ps_rows(args, timeout, env=None):
    """跑一次 ps（args 里第一列是 pid），返回 [(pid, 其余)]；ps 跑不了就是 []"""
    import subprocess
    try:
        out = subprocess.run(['ps'] + args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                             timeout=timeout, env=env).stdout.decode('utf-8', 'replace')
    except (OSError, subprocess.SubprocessError):
        return []
    rows = []
    for l in out.splitlines():
        pid, _, rest = l.strip().partition(' ')
        if pid.isdigit():
            rows.append((int(pid), rest))
    return rows


def proc_scan(pids=None):
    """Linux：从 /proc 读进程 {pid: (ppid, 终端, CPU 秒数, 启动时间戳, 命令行)}（busybox 的 ps 不认 -p、-x、lstart；GNU 的 ps
    也不用，两边一个算法）。pids 不给就是全部进程，已经没有的不在结果里。不是 Linux 时是 None（照常问 ps）。
    启动时间是开机时刻（/proc/stat 的 btime）加上 stat 里的 starttime，和 ps 的 lstart 一样只到秒；终端照 ps 的写法（pts/3、tty1），
    没有是 ?"""
    if not sys.platform.startswith('linux'):
        return None
    try:
        with open('/proc/stat', 'rb') as f:
            boot = next((int(l.split()[1]) for l in f if l.startswith(b'btime ')), None)
        if pids is None:
            pids = [int(n) for n in os.listdir('/proc') if n.isdigit()]
    except (OSError, ValueError, IndexError):
        return None
    if boot is None:
        return None
    tck, out = os.sysconf('SC_CLK_TCK') or 100, {}
    for pid in pids:
        try:
            with open('/proc/%d/stat' % pid, 'rb') as f:
                st = f.read().decode('utf-8', 'replace')
            with open('/proc/%d/cmdline' % pid, 'rb') as f:
                cmd = f.read().replace(b'\0', b' ').decode('utf-8', 'replace').strip()
        except OSError:   # 刚退出
            continue
        f = st[st.rfind(')') + 2:].split()   # 进程名在括号里，里面可能有空格和括号
        try:
            ppid, nr, cpu, start = int(f[1]), int(f[4]), int(f[11]) + int(f[12]), int(f[19])
        except (IndexError, ValueError):
            continue
        major, minor = (nr >> 8) & 0xfff, (nr & 0xff) | ((nr >> 12) & 0xfff00)
        tty = ('pts/%d' % ((major - 136) * 256 + minor) if 136 <= major <= 143 else
               'tty%d' % minor if major == 4 and 0 < minor < 64 else '?')
        out[pid] = (ppid, tty, cpu / tck, int(boot + start / tck), cmd)
    return out


def proc_starts(pids):
    """{进程号: 启动时间戳}（一次 ps -p；Linux 上读 /proc）；已经没有的进程不在里面。lstart 的写法随 locale 变，固定成 C"""
    pids = sorted({p for p in pids if isinstance(p, int) and p > 0})
    if not pids:
        return {}
    lx = proc_scan(pids)
    if lx is not None:
        return {pid: p[3] for pid, p in lx.items()}
    rows = ps_rows(['-o', 'pid=,lstart=', '-p', ','.join(map(str, pids))], 5, env=dict(os.environ, LC_ALL='C', LANG='C'))
    return {pid: t for pid, t in ((pid, lstart_epoch(s)) for pid, s in rows) if t}


def profile_path(key, kind):
    if kind not in ('app', 'browser'):
        die('未知客户端资料类型')
    account = adir(key)
