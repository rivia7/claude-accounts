def claude_sync(key):
    cd = cdir(key)
    aj, bj = os.path.join(cd, '.claude.json'), os.path.join(cd, '.cca-sync-base.json')
    with Lock():
        prepare_device(key)
        m = load_json(MASTER_JSON, {}) or {}
        a = load_json(aj, {}) or {}
        b = load_json(bj, {}) or {}
        base, ch_a, ch_m, conflict = {}, False, False, False
        for k in SHARED_KEYS:
            v, collided = merge_config_json(b.get(k, MISSING), a.get(k, MISSING), m.get(k, MISSING))
            conflict |= collided
            if v is MISSING:
                ch_a |= a.pop(k, MISSING) is not MISSING
                ch_m |= m.pop(k, MISSING) is not MISSING
                continue
            base[k] = v
            if not eq(a.get(k, MISSING), v):
                a[k], ch_a = v, True
            if not eq(m.get(k, MISSING), v):
                m[k], ch_m = v, True
        if conflict:
            config_conflict(aj, key)
        if ch_a or not os.path.exists(aj):
            save_json(aj, a, 0o600, follow_symlinks=False)
        if ch_m:
            save_json(MASTER_JSON, m)
        save_json(bj, base, 0o600)


