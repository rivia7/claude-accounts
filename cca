def cmd_nodes_follow():
    """stdin 是路由器上的节点列表。可选节点改了名的（按服务器地址认），可选节点和各工具的账号表跟着改；记下各可选节点的摘要。
    stdout：每个改名一行 R<TAB>旧名<TAB>新名；找不到、又有账号在用的一行 L<TAB>旧名<TAB>用它的账号（顿号连起来）。
    没读到节点（路由器上的配置读不了）时什么都不改，返回 1。不经过 ctx：账号表这时可能正因为节点名对不上而校验不过"""
    have = parse_node_list(sys.stdin.read())
    if not have:
        sys.exit(1)
    c = cfg_load()
    before = json.dumps(c, sort_keys=True)
    ren, lost = {}, []
    for n in c['nodes']:
        m = node_match(n, node_ids(c).get(n, ''), have)
        if not m:
            lost.append(n)
        elif m != n:
            ren[n] = m
    # 不自动合并：认到的新名字同时是好几个旧名字的、或者是另一个还在用的可选节点（地址一样的两个节点没了一个）。
    # 这不是改名，自动改过去会让账号悄悄换到另一个节点上，交给用户选
    for o in [o for o, m in ren.items() if list(ren.values()).count(m) > 1 or (m in c['nodes'] and m not in ren)]:
        del ren[o]
        lost.append(o)
    hit = nodes_rename(c, ren) if ren else {}
    nodes_record(c, have)
    names = {n for n, _ in have}
    r = c.get('node_renames') if isinstance(c.get('node_renames'), dict) else {}
    for o in [o for o in r if o in names]:   # 旧名字在路由器上又出现了（给了新节点）：那条换算作废
        del r[o]
    if not r:
        c.pop('node_renames', None)
    if json.dumps(c, sort_keys=True) != before:
        cfg_save(c)
    for o, n in ren.items():
        sys.stderr.write('! 节点「%s」在路由器上改名为「%s」（服务器地址没变）：可选节点%s已跟着改\n'
                         % (o, n, '和 %s 的出口' % '、'.join(hit[o]) if hit[o] else ''))
        print('R\t%s\t%s' % (o, n))
    users = node_users_all()
    for o in lost:
        if users.get(o):
            print('L\t%s\t%s' % (o, '、'.join(users[o])))


