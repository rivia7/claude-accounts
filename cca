def codex_probe(bin_):
    """这个版本的 codex 认得哪些 cca 要用的参数：不认识的 --disable 开关、参数 codex 会直接报错退出，开关不存在了也就不会
    改走系统代理。按 codex 程序文件缓存（换了版本才重新问，问一次要一秒多）。问不出来时照样全加上（宁可启动失败）"""
    full = {'flags': list(CODEX_FLAGS), 'no_daemon': True, 'version': ''}
    if not bin_:
        return full
    import subprocess
    real = os.path.realpath(bin_)
    try:
        st = os.stat(real)
        sig = '%s|%d|%d' % (real, st.st_size, int(st.st_mtime))
    except OSError:
        return full
    if real.endswith('.js'):   # npm 装的：启动脚本的大小、时间不随版本变，版本号在包里的 package.json
        pj = load_quiet(os.path.join(os.path.dirname(os.path.dirname(real)), 'package.json'))
        sig += '|' + str(pj.get('version') if isinstance(pj, dict) else '')
    path = os.path.join(CODEX.sroot, 'probe.json')
    j = load_quiet(path)
    if isinstance(j, dict) and j.get('sig') == sig and isinstance(j.get('flags'), list):
        return j
    env = {k: v for k, v in os.environ.items() if not re.match(r'^(CODEX_|OPENAI_|CCA_(EVENTS|GRANT|RO)$)', k)}
    env['CODEX_HOME'] = CODEX.master
    os.makedirs(CODEX.master, exist_ok=True)

    def run(*a):
        try:
            r = subprocess.run([bin_] + list(a), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                               env=env, cwd=CODEX.master, timeout=30)
            return r.returncode, r.stdout.decode('utf-8', 'replace')
        except (OSError, subprocess.SubprocessError):
            return 1, ''
    rc, out = run('features', 'list')
    if rc != 0 or not out.strip():
        return full
    known = {l.split()[0] for l in out.splitlines() if l.strip()}
    flags = [x for f in CODEX_FLAGS[1::2] if f in known for x in ('--disable', f)]
    rc, help_ = run('--help')
    ver = run('--version')[1].strip().split()
    j = {'sig': sig, 'flags': flags, 'no_daemon': rc != 0 or '--no-daemon' in help_, 'version': ver[-1] if ver else ''}
    try:
        save_json(path, j, 0o600)
    except OSError:
        pass
    return j


class Rpc:
    """codex app-server：stdio 上一行一个 JSON 的 JSON-RPC（不带 jsonrpc 字段）。在 bash 设好的账号环境里启动
    （CODEX_HOME、出口都在环境变量里），加上 cca 的参数（不许改走系统代理）。报的客户端名和 codex login 一样"""

    def __init__(self, bin_):
        import queue, subprocess, tempfile, threading
        self.err, self.q, self.n, self.notes = tempfile.TemporaryFile(), queue.Queue(), 0, []
        self.probe = codex_probe(bin_)
        home = os.environ.get('CODEX_HOME') or ''
        self.p = subprocess.Popen([bin_] + self.probe['flags'] + ['app-server'], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                  stderr=self.err, cwd=os.path.dirname(home) if os.path.isdir(home) else CCA_HOME)
        threading.Thread(target=self.pump, daemon=True).start()

    def pump(self):
        for line in self.p.stdout:
            self.q.put(line)
        self.q.put(None)

    def send(self, msg):
        try:
            self.p.stdin.write((json.dumps(msg) + '\n').encode('utf-8'))
            self.p.stdin.flush()
            return True
        except (OSError, ValueError):
            return False

    def next(self, end):
        """读下一条消息，通知（有 method、没有 id）另外存进 notes；到时候了返回 None，app-server 退出了抛 EOFError"""
        import queue
        try:
            line = self.q.get(timeout=max(end - time.time(), 0.01))
        except queue.Empty:
            return None
        if line is None:
            raise EOFError
        try:
            m = json.loads(line)
        except ValueError:
            return {}
        if not isinstance(m, dict):
            return {}
        if 'method' in m and 'id' not in m:
            self.notes.append(m)
        return m

    def call(self, method, params, end):
        """发一个请求等回应：返回 (结果, 错误)；错误是 timeout（到时候了）、exit（没回应就退出了）或它的说明"""
        self.n += 1
        msg = {'id': self.n, 'method': method}
        if params is not None:
            msg['params'] = params
        if not self.send(msg):
            return None, 'exit'
        while True:
            try:
                m = self.next(end)
            except EOFError:
                return None, 'exit'
            if m is None:
                return None, 'timeout'
            if m.get('id') == msg['id'] and ('result' in m or 'error' in m):
                e = m.get('error')
                return m.get('result'), ((e.get('message') or json.dumps(e)) if isinstance(e, dict) else e and str(e))

    def wait(self, method, end, match=lambda p: True):
        """等一条通知（先看已经收到的）：返回它的 params；到时候了返回 None，app-server 退出了抛 EOFError"""
        while True:
            for m in self.notes:
                if m.get('method') == method and match(m.get('params') or {}):
                    self.notes.remove(m)
                    return m.get('params') or {}
            if self.next(end) is None:
                return None

    def failure(self, err):
        """call 的错误 → (原因, 说明)：unsupported（这个版本的 codex 没有这个接口）、auth（登录凭证失效了：token 刷新不了或者
        被服务器拒绝，比如改过密码、在别处退出过，要重新登录）、timeout 或 error"""
        msg = self.tail() if err in ('timeout', 'exit') else str(err or '')
        text = '%s %s' % (err, msg)
        if re.search(r'(?i)method not found|unknown (method|variant|request)|unrecognized subcommand|unexpected argument', text):
            return 'unsupported', msg[:300]
        if re.search(r'(?i)access token could not be refreshed|\b401 unauthorized\b', text):
            return 'auth', msg[:300]
        return ('timeout' if err == 'timeout' else 'error'), msg[:300]

    def start(self, end):
        """initialize + initialized；返回错误（没有就是 None）"""
        _, err = self.call('initialize', {'clientInfo': {'name': CODEX_CLIENT, 'title': None,
                                                         'version': self.probe.get('version') or '0.0.0'}}, end)
        if not err:
            self.send({'method': 'initialized'})
        return err

    def tail(self):
        self.err.seek(0)
        return ' '.join(self.err.read()[-800:].decode('utf-8', 'replace').split())

    def close(self, kill=False):
        if kill:
            self.p.kill()
        try:
            self.p.stdin.close()
        except OSError:
            pass
        try:
            self.p.wait(timeout=5)
        except Exception:
            self.p.kill()


def codex_windows(snap):
    """一组额度（primary 一般是 5 小时，secondary 是每周）→ 和 Claude 一样的窗口 {five_hour, seven_day}：按窗口长度认"""
    out = {}
    for i, w in enumerate((snap.get('primary'), snap.get('secondary'))):
        p = w.get('usedPercent') if isinstance(w, dict) else None
        if isinstance(p, bool) or not isinstance(p, (int, float)):
            continue
        mins = w.get('windowDurationMins')
        k = ('five_hour' if mins <= 24 * 60 else 'seven_day') if isinstance(mins, (int, float)) else ('five_hour', 'seven_day')[i]
        out.setdefault(k, {'utilization': p, 'resets_at': w.get('resetsAt')})
    return out


def codex_usage(res):
    """account/rateLimits/read 的回应 → 和 Claude 的查询一样的 {rate_limits_available, rate_limits, subscription_type}"""
    res = res if isinstance(res, dict) else {}
    main = res.get('rateLimits') if isinstance(res.get('rateLimits'), dict) else {}
    rl = codex_windows(main)
    extra = res.get('rateLimitsByLimitId') if isinstance(res.get('rateLimitsByLimitId'), dict) else {}
    ms = []
    for lid, snap in extra.items():   # 别的额度（某些模型单独计的）：只列每周的
        if isinstance(snap, dict) and lid != main.get('limitId'):
            w = codex_windows(snap).get('seven_day')
            if w:
                ms.append(dict(w, display_name=snap.get('limitName') or lid))
    if ms:
        rl['model_scoped'] = ms
    if isinstance(main.get('credits'), dict):
        rl['credits'] = main['credits']
    if isinstance(res.get('rateLimitResetCredits'), dict):   # 还能重置几次额度（codex 里 /usage 的 Redeem reset）和明细
        rl['reset_credits'] = res['rateLimitResetCredits']
    if main.get('planType'):
        rl['plan'] = main['planType']   # 存进缓存：查不到时显示上次查到的套餐（登录凭证里记的可能是旧的）
    return {'rate_limits_available': 'five_hour' in rl or 'seven_day' in rl, 'rate_limits': rl, 'subscription_type': main.get('planType')}


def codex_rpc_once(bin_, timeout, run):
    """在账号的环境里启动 codex app-server、initialize，run(r, 截止时间) 做这次要做的事，返回 (结果, 错误)；
    stdout 打印一行 JSON：结果，或者出错时的 {ok: false, why: unsupported|timeout|error, msg}"""
    end = time.time() + float(timeout)
    try:
        r = Rpc(bin_)
    except OSError as e:
        return print(json.dumps({'ok': False, 'why': 'error', 'msg': str(e)}, ensure_ascii=False))
    out, err = None, r.start(end)
    if not err:
        out, err = run(r, end)
    if err:
        why, msg = r.failure(err)
        out = {'ok': False, 'why': why, 'msg': msg}
    r.close(kill=bool(err))
    print(json.dumps(out, ensure_ascii=False))


def codex_usage_query(bin_, timeout='25'):
    """account/rateLimits/read 取用量（和 codex 里 /status 显示的一样）。只查用量，不发模型请求、不耗额度；token 由 codex 自己
    读取和刷新。打印的格式和 Claude 的查询一样：{ok: true, usage: {rate_limits_available, rate_limits, subscription_type}}"""
    def run(r, end):
        res, err = r.call('account/rateLimits/read', None, end)
        return {'ok': True, 'usage': codex_usage(res)}, err
    codex_rpc_once(bin_, timeout, run)


# codex 回的重置结果 → cca 的写法（macos/PROTOCOL.md 4.5：reset 重置了、already_redeemed 这一次早就重置过了、nothing_to_reset
# 用量还不需要重置（不扣次数）、no_credit 没有能用的重置机会了）
RESET_OUTCOMES = {'reset': 'reset', 'alreadyRedeemed': 'already_redeemed', 'nothingToReset': 'nothing_to_reset', 'noCredit': 'no_credit'}


def cmd_reset_consume(bin_, credit='', timeout='25'):
    """用掉一次重置机会（Codex 账号；和查用量一样经账号的出口）：account/rateLimitResetCredit/consume，creditId 是要用的那一次
    （空着由 OpenAI 挑），idempotencyKey 每次新生成；重置了就再读一次用量。打印 {ok: true, outcome, usage: 查用量的格式或 null}"""
    import uuid

    def run(r, end):
        params = {'idempotencyKey': str(uuid.uuid4())}
        if credit:
            params['creditId'] = credit
        res, err = r.call('account/rateLimitResetCredit/consume', params, end)
        if err:
            return None, err
        outcome = RESET_OUTCOMES.get(res.get('outcome') if isinstance(res, dict) else None)
        if not outcome:
            return {'ok': False, 'why': 'error', 'msg': 'codex 回的结果看不懂：%s' % json.dumps(res, ensure_ascii=False)[:200]}, None
        out = {'ok': True, 'outcome': outcome, 'usage': None}
        if outcome in ('reset', 'already_redeemed'):   # 重置了：再读一次用量（读不到不算失败，下次查用量时就有了）
            u, e2 = r.call('account/rateLimits/read', None, max(end, time.time() + 15))
            if not e2:
                out['usage'] = codex_usage(u)
        return out, None
    codex_rpc_once(bin_, timeout, run)


def cmd_login_flow(bin_, timeout='900'):
    """Codex 账号登录（在 bash 设好的账号环境里前台运行，Ctrl-C 会取消登录）：经 app-server 的 account/login/start 拿到
    登录网址，回调 cca _browser 在这个账号专属的 Chrome 里打开（走账号的出口；回调地址是本机 127.0.0.1:1455，Chrome
    不经代理），登录完成后 codex 自己把凭证写进这个账号的 auth.json。退出码：0 登录了；3 这个版本的 codex 不支持
    （bash 改用 codex login）；1 没登录成，原因打到 stderr"""
    import signal, subprocess
    end = time.time() + float(timeout)
    r, login, ok = None, None, False

    def stop(*_):   # 服务器上登录时它在后台跑，cca 取消登录用 SIGTERM：和 Ctrl-C 一样告诉 app-server 取消
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, stop)
    try:
        r = Rpc(bin_)
        err = r.start(time.time() + 30)
        res = None
        if not err:
            res, err = r.call('account/login/start', {'type': 'chatgpt'}, time.time() + 30)
        if err or not isinstance(res, dict) or not res.get('authUrl'):
            why, msg = r.failure(err) if err else ('unsupported', '')
            if why == 'unsupported':
                sys.exit(3)
            die(msg or '登录没能开始')
        login = res.get('loginId')
        subprocess.run([SELF_PATH, '_browser', res['authUrl']], stdin=subprocess.DEVNULL)
        p = r.wait('account/login/completed', end, lambda x: not login or x.get('loginId') in (None, login))
        if p is None:
            die('等了 %d 分钟还没登录完' % (int(float(timeout)) // 60))
        ok = bool(p.get('success'))
        if not ok:
            die(str(p.get('error') or '登录没有成功'))
    except EOFError:
        die(r.tail() or 'codex app-server 退出了')
    except KeyboardInterrupt:
        if r and login:
            r.send({'id': 0, 'method': 'account/login/cancel', 'params': {'loginId': login}})
        die('已取消登录')
    except OSError as e:
        die(str(e))
    finally:
        if r:
            r.close(kill=not ok)   # 登录成功时让它自己正常退出（凭证这时一定已经写完）


def codex_fix_rollouts():
    """Codex 的会话库（state_N.sqlite 的 threads 表）记着每个会话文件的路径，经由开它的那个账号目录（sessions 是指向
    ~/.codex/sessions 的链接）。账号删掉后这些路径就断了，会话会从 codex resume 的全部会话里消失（文件还在）。
    这里把它们改写成 ~/.codex 下的同一个文件：只改 rollout_path 这一列，只改确实有对应文件的。库被别的 codex 占着时
    跳过，下次再改"""
    import glob, sqlite3
    try:
        home = read_toml_config(os.path.join(CODEX.master, 'config.toml')).get('sqlite_home', '')
        if not isinstance(home, str):
            raise ConfigReadError('invalid_sqlite_home')
    except ConfigReadError:
        sys.stderr.write('cca: ~/.codex/config.toml 无效或不可读，已跳过会话路径修复；启动前配置校验将拒绝此配置\n')
        return
    home = os.path.expanduser(home) or CODEX.master
    pre = os.path.join(CODEX.sroot, 'accounts') + os.sep
    pat = re.compile(r'^%s[^/]+/%s/(sessions|archived_sessions)/' % (re.escape(pre), re.escape(CODEX.sub)))
    for db in sorted(glob.glob(os.path.join(home, 'state_*.sqlite'))):
        try:
            con = sqlite3.connect(db, timeout=2)
            try:
                if 'rollout_path' not in [r[1] for r in con.execute('PRAGMA table_info(threads)')]:
                    continue
                rows = con.execute('SELECT id, rollout_path FROM threads WHERE substr(rollout_path, 1, ?) = ?', (len(pre), pre)).fetchall()
                fix = []
                for i, old in rows:
                    new = pat.sub(lambda m: os.path.join(CODEX.master, m.group(1)) + os.sep, old)
                    if new != old and glob.glob(glob.escape(new) + '*'):
                        fix.append((new, i, old))
                if fix:
                    with con:
                        con.executemany('UPDATE threads SET rollout_path = ? WHERE id = ? AND rollout_path = ?', fix)
            finally:
                con.close()
        except sqlite3.Error:
            pass


