def gui_reach(host, ports):
    """这台 Mac 连不连得上这些端口：{端口: bool}（并行，每个最多 1 秒；用 PATH 里的 nc，和 probe 一样）"""
    import subprocess, threading
    out = {}

    def one(p):
        a = ['nc', '-z', '-G', '1', host, str(p)] if sys.platform == 'darwin' else ['nc', '-z', '-w', '1', host, str(p)]
        try:
            out[p] = subprocess.run(a, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                    timeout=5).returncode == 0
        except (OSError, subprocess.SubprocessError):
            out[p] = False
    th = [threading.Thread(target=one, args=(p,)) for p in ports]
    for x in th:
        x.start()
    for x in th:
        x.join()
    return out


def cmd_gui_live(route, host='', rc='0', at_home=''):
    """cca _gui live：端口池的实况（只读）。stdin 是 bash 收集的原始数据：在路由器上是这一版 router_sh 的 status 输出
    （rc 是 ssh 的退出码），在本机是控制接口的 V<TAB>状态码、逐组 G<TAB>组<TAB>状态码<TAB>选中的节点。
    应选的节点按这台 Mac 的账号表算（不看路由器上的应为），选中的不一样就是 drift，同步一次就好"""
    c, _, _ = ctx()
    text = sys.stdin.read()
    r = c.get('router') or {}
    router = {'configured': bool(r.get('host')), 'host': r.get('host') or None, 'reachable': at_home == 'yes', 'backend': None,
              'running': None, 'hook': None, 'cron': None, 'error': None}
    local = dict(local_info(c), running=None, error=None)
    lines = [l for l in text.splitlines() if l.strip()]
    sel, inkernel, listening = {}, {}, {}
    if route == 'router':
        if not router['configured']:
            router['error'] = {'code': 'not_configured', 'message': '还没配置路由器（cca router setup）'}
        elif at_home != 'yes':
            router['error'] = {'code': 'unreachable', 'message': '连不上路由器 %s' % r.get('host')}
        elif rc != '0':
            router['error'] = {'code': 'unreachable' if rc == '255' else 'status_failed', 'message': lines[-1] if lines else ''}
        else:
            for l in lines:
                m = re.match(r'^(OpenClash|ShellCrash)：(运行中|未运行)', l)
                if m:
                    router['backend'], router['running'] = m.group(1), m.group(2) == '运行中'
                elif l.startswith('钩子：'):
                    router['hook'] = l == '钩子：已安装'
                elif l.startswith('自愈 cron：'):
                    router['cron'] = l == '自愈 cron：已安装'
                else:
                    m = GUI_SLOT_RE.match(l)
                    if m:
                        g, now = m.group(1), m.group(4)
                        listening[g] = m.group(3) == '监听中'
                        inkernel[g] = now != '（内核里没有）'
                        sel[g] = now if inkernel[g] and now not in ('', '?') else None
            if router['running'] is False:
                router['error'] = {'code': 'not_running', 'message': '%s 没在运行' % router['backend']}
    elif route == 'local':
        if not local['configured']:
            local['error'] = {'code': 'not_configured', 'message': '还没配置本机 Clash（cca local setup）'}
        for l in lines:
            f = l.split('\t')
            if f[0] == 'V' and len(f) > 1:
                local['running'] = f[1] == '200'
            elif f[0] == 'G' and len(f) > 2:
                inkernel[f[1]] = f[2] == '200'
                now = f[3] if len(f) > 3 else ''
                sel[f[1]] = now if f[2] == '200' and now else None
        if local['configured'] and local['running'] is False:
            local['error'] = {'code': 'not_running', 'message': '%s 没在运行' % local['name']}
    who = {p: (tool.name, k) for tool, k, _, p in pool(c)}
    plan = slot_orders(c, local=route == 'local')
    reach = gui_reach(host, [p for _, p, _ in plan if p in who]) if host and route != 'none' else {}
    slots, summary = [], {'ok': 0, 'drift': 0, 'closed': 0, 'unknown': 0, 'empty': 0}
    for i, (g, p, order) in enumerate(plan, 1):
        tk = who.get(p)
        s = sel.get(g)
        if not tk:
            st = 'empty'
        elif route == 'none' or not host:
            st = 'unknown'
        elif not reach.get(p):
            st = 'closed'
        elif s is None:
            st = 'unknown'
        else:
            st = 'drift' if s != order[0] else 'ok'
        summary[st] += 1
        slots.append({'slot': i, 'group': g, 'port': p, 'tool': tk[0] if tk else None, 'key': tk[1] if tk else None,
                      'expected': order[0], 'selected': s, 'in_kernel': inkernel.get(g),
                      'listening': listening.get(g) if route == 'router' else (reach.get(p) if tk else None),
                      'reachable': reach.get(p) if tk else None, 'state': st})
    print(json.dumps({'version': 1, 'kind': 'live', 'generated_at': time.time(), 'route': route, 'route_pref': c.get('route') or 'auto',
                      'at_home': at_home == 'yes', 'proxy_host': host or None, 'router': router, 'local': local, 'slots': slots,
                      'summary': summary},
                     ensure_ascii=False, indent=2))


