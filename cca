def claude_usage_query(claude, timeout='25'):
    """在账号的环境里（bash 的 child_env 已经设好 CLAUDE_CONFIG_DIR 和出口）无界面启动 claude，发 get_usage 控制
    请求取用量。--safe-mode 不加载 hooks、MCP、插件；不发消息、不耗额度；token 由 Claude Code 自己读取和刷新。
    拿到回应之前 stdin 一直开着（太早关掉请求可能被取消）。stdout 打印一行 JSON：
    {ok: true, usage: 回应} 或 {ok: false, why: unsupported|timeout|error, msg: 说明}"""
    import queue, subprocess, tempfile, threading
    cd = os.environ.get('CLAUDE_CONFIG_DIR') or ''
    err = tempfile.TemporaryFile()
    try:
        p = subprocess.Popen([claude, '-p', '--safe-mode', '--no-session-persistence', '--strict-mcp-config',
                              '--input-format', 'stream-json', '--output-format', 'stream-json', '--verbose'],
                             stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=err,
                             cwd=os.path.dirname(cd) if os.path.isdir(cd) else CCA_HOME)
    except OSError as e:
        print(json.dumps({'ok': False, 'why': 'error', 'msg': str(e)}, ensure_ascii=False))
        return
    q = queue.Queue()

    def pump():
        for line in p.stdout:
            q.put(line)
        q.put(None)
    threading.Thread(target=pump, daemon=True).start()
    req = {'type': 'control_request', 'request_id': USAGE_REQ, 'request': {'subtype': 'get_usage', 'skip_behaviors': True}}
    try:
        p.stdin.write((json.dumps(req) + '\n').encode('utf-8'))
        p.stdin.flush()
    except OSError:
        pass
    out, end = {'ok': False, 'why': 'timeout', 'msg': ''}, time.time() + float(timeout)
    while True:
        try:
            line = q.get(timeout=max(end - time.time(), 0.01))
        except queue.Empty:
            break
        if line is None:   # 没回应就退出了：多半是太老的版本（不认 --safe-mode 等参数）
            try:
                p.wait(timeout=3)
            except subprocess.TimeoutExpired:
                pass
            err.seek(0)
            tail = err.read()[-800:].decode('utf-8', 'replace').strip().splitlines()
            old = re.search(r'unknown option|nsupported', ' '.join(tail))
            out = {'ok': False, 'why': 'unsupported' if old else 'error',
                   'msg': tail[-1][:200] if tail else '没有回应就退出了（退出码 %s）' % p.returncode}
            break
        try:
            m = json.loads(line)
        except ValueError:
            continue
        r = m.get('response') if isinstance(m, dict) and m.get('type') == 'control_response' else None
        if not isinstance(r, dict) or r.get('request_id') != USAGE_REQ:
            continue
        if r.get('subtype') == 'success':
            u = r.get('response')
            out = {'ok': True, 'usage': u if isinstance(u, dict) else {}}
        else:
            e = str(r.get('error') or '')
            out = {'ok': False, 'why': 'unsupported' if 'nsupported' in e else 'error', 'msg': e[:200]}
        break
    if out.get('why') == 'timeout':
        p.kill()
    try:
        p.stdin.close()
    except OSError:
        pass
    try:
        p.wait(timeout=5)
    except subprocess.TimeoutExpired:
        p.kill()
    print(json.dumps(out, ensure_ascii=False))


def parse_ts(s):
    """ISO 时间（小数秒、Z、时区都行）或秒/毫秒数 → 秒；看不懂返回 None（Python 3.9 的 fromisoformat 认不了这些写法）"""
    if isinstance(s, bool):
        return None
    if isinstance(s, (int, float)):
        return s / 1000.0 if s > 1e11 else float(s)
    if not isinstance(s, str):
        return None
    m = re.match(r'^(\d{4})-(\d\d)-(\d\d)[T ](\d\d):(\d\d)(?::(\d\d)(\.\d+)?)?\s*(Z|[+-]\d\d:?\d\d)?$', s.strip())
    if not m:
        return None
    import calendar
    y, mo, d, h, mi, sec, frac, tz = m.groups()
    ts = calendar.timegm((int(y), int(mo), int(d), int(h), int(mi), int(sec or 0), 0, 0, 0)) + float(frac or 0)
    if tz and tz != 'Z':
        z = tz.replace(':', '')
        ts -= (1 if z[0] == '+' else -1) * (int(z[1:3]) * 3600 + int(z[3:5]) * 60)
    return ts


def iso(ts):
    return time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime(ts))


def win(w, now):
    """一个用量窗口 → {pct, at, reset}；at 是重置时间（秒），reset 表示重置时间已经过了（缓存里的数不算数了）"""
    if not isinstance(w, dict):
        return None
    p = w.get('utilization')
    if isinstance(p, bool) or not isinstance(p, (int, float)):
        return None
    at = parse_ts(w.get('resets_at'))
    return {'pct': p, 'at': at, 'reset': at is not None and at <= now}


def span(secs):
    """一段时长：不到 1 分钟 / 25 分钟 / 2 小时 13 分 / 3 天 4 小时"""
    m = int(max(secs, 0) // 60)
    if m < 1:
        return '不到 1 分钟'
    if m < 60:
        return '%d 分钟' % m
    h, m = divmod(m, 60)
    if h < 24:
        return '%d 小时 %d 分' % (h, m) if m else '%d 小时' % h
    d, h = divmod(h, 24)
    return '%d 天 %d 小时' % (d, h) if h else '%d 天' % d


def weekday_clock(lt):
    """“周二 09:00”（lt 是 time.localtime 的结果）"""
    return '周%s %02d:%02d' % (WEEKDAYS[lt.tm_wday], lt.tm_hour, lt.tm_min)


def span_short(secs):
    """紧凑的时长（cca usage 的表格里，不加空格）：不到1分钟 / 25分钟 / 2小时13分 / 3天4小时"""
    return span(secs).replace(' ', '')


def day_gap(a, b):
    """b 那天比 a 那天晚几天（本地时间的日历日；跨夏令时也对）"""
    from datetime import date
    return (date.fromtimestamp(b) - date.fromtimestamp(a)).days


def reset_short(at, now, week=False):
    """表格里的重置时间（本地时间）：5 小时的窗口写还有多久（2小时13分后）；本周的一小时以内也写还有多久，
    再远写今天 / 明天 / 星期几和几点（周四 09:00）"""
    if not week or at - now < 3600:
        return span_short(at - now) + '后'
    lt, days = time.localtime(at), day_gap(now, at)
    day = '今天' if days == 0 else '明天' if days == 1 else '周' + WEEKDAYS[lt.tm_wday]
    return '%s %02d:%02d' % (day, lt.tm_hour, lt.tm_min)



def ago(secs):
    m = int(max(secs, 0) // 60)
    if m < 60:
        return '%d 分钟' % max(m, 1)
    if m < 1440:
        return '%d 小时' % (m // 60)
    return '%d 天' % (m // 1440)


# Claude Code 收 profile 接口给的套餐名（planDisplayName）的规矩：字母数字开头，中间可以有空格和 .+-，最长 40 个字
PLAN_NAME_RE = lazy_re(r'^[^\W_](?:(?:[^\W_]|[ .+-]){0,38}(?:[^\W_]|\+))?$')
# Claude 套餐种类（organizationType 去掉 claude_）的叫法，和 Claude Code 自己显示的一样（它写成 Claude Pro）
CLAUDE_KIND_NAMES = {'pro': 'Pro', 'max': 'Max', 'team': 'Team', 'enterprise': 'Enterprise', 'free': 'Free'}


def plan_label(oa, sub=None):
    """套餐，叫法和官网一样：Free、Pro、Max、Ultra、Team、Team Premium、Enterprise。
    先用 oauthAccount 里的 planDisplayName：profile 接口给的官方名字，新版 Claude Code 才存，它自己也显示这个，官方再改名
    也跟得上。没有的话按 organizationType 和额度档位推：原来的 Max 20x 现在叫 Ultra，Max 5x 就叫 Max；Team 的 5x 档位是
    Premium 席位（Claude Code 的 isTeamPremiumSubscriber）。都没有时看查询结果里的 subscription_type（分不出档位）"""
    n = oa.get('planDisplayName')
    if isinstance(n, str) and PLAN_NAME_RE.match(n):
        return n
    kind, x = claude_plan_parts(oa, sub)
    if kind == 'max' and x == 20:
        return 'Ultra'
    if kind == 'team' and x == 5:
        return 'Team Premium'
    return CLAUDE_KIND_NAMES.get(kind, kind.capitalize()) or '—'


def claude_plan_parts(oa, sub=None):
    """(种类, 额度倍数)：种类是 organizationType 去掉 claude_（没有时用查询结果里的 subscription_type），倍数是
    organizationRateLimitTier / userRateLimitTier 里的 Nx（没有是 0）。plan_label 和 claude_plan_tier 共用，免得各认各的"""
    t = str(oa.get('organizationType') or '').lower()
    kind = t[len('claude_'):] if t.startswith('claude_') else str(sub or '').lower()
    m = re.search(r'(\d+)x\b', '%s %s' % (oa.get('organizationRateLimitTier') or '', oa.get('userRateLimitTier') or ''))
    return kind, int(m.group(1)) if m else 0


# Claude 套餐档位的名字表（planDisplayName 小写、合并空格、去掉开头的 claude 之后查）：只在种类和倍数不够判断时兜底
CLAUDE_TIER_NAMES = {'free': 'entry', 'pro': 'standard', 'team': 'standard', 'enterprise': 'standard', 'max': 'advanced',
                     'max 5x': 'advanced', 'team premium': 'advanced', 'ultra': 'premium', 'max 20x': 'premium'}


def claude_plan_tier(oa, sub=None):
    """套餐档位（_gui state 的 plan_tier）：entry / standard / advanced / premium，认不出是 ''（不猜）。先看种类和额度倍数
    （官方改叫法不受影响，Claude Code 自己认 Max 20x、Team Premium 也靠它们），倍数缺失时才看 planDisplayName；
    两边冲突时种类和倍数赢。倍数用 >=：以后出了更高的倍数也不会掉档"""
    kind, x = claude_plan_parts(oa, sub)
    named = CLAUDE_TIER_NAMES.get(re.sub(r'^claude ', '', ' '.join(str(oa.get('planDisplayName') or '').lower().split())), '')
    if kind == 'free':
        return 'entry'
    if kind in ('pro', 'enterprise') or kind.startswith('edu'):
        return 'standard'
    if kind == 'max':
        return 'premium' if (x >= 20 if x else named == 'premium') else 'advanced'
    if kind == 'team':
        return 'advanced' if (x >= 5 if x else named == 'advanced') else 'standard'
    return named


# Claude Code 登录时把当时的套餐种类记进登录凭证（get_usage、claude auth status 回的 subscription_type 就是它），之后从官方读到的
# 新资料只更新 .claude.json 的 oauthAccount，凭证里这一项不改（2.1.322 核实：登录时记下的不拿资料覆盖，刷新 token 时资料齐全也不再读），
