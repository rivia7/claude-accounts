def routed(c, t):
    """走节点、有端口的账号 [(键, 值, 端口)]；直连的第三方 API 账号没有端口"""
    return [(k, v, c['ports'][k]) for k, v in t.items() if k in c['ports']]


def api_url(v):
    return str(v.get('base_url') or '').rstrip('/')


def api_host(v):
    """接口地址的域名：菜单里显示它；钥匙串里的 key 也按它存取（换了服务商，旧 key 不会被发过去）"""
    from urllib.parse import urlsplit
    u = api_url(v)
    try:
        return urlsplit(u).hostname or u
    except ValueError:
        return u


def secret_ok(s):
    return isinstance(s, str) and bool(SECRET_RE.match(s))


def model_ok(m):
    return isinstance(m, str) and bool(MODEL_RE.match(m))


def parse_key(key):
    """账号表的键 → (别名, 邮箱)。键可以是「别名(邮箱)」、只写邮箱，或只写别名（登录页不预填邮箱）"""
    m = PAIR_RE.match(key)
    if m and EMAIL_RE.match(m.group(2)):
        return m.group(1), m.group(2)
    return ('', key) if EMAIL_RE.match(key) else (key, '')


def name_of(key):
    """菜单和提示里的短名字：有别名用别名，否则用邮箱"""
    a, e = parse_key(key)
    return a or e


def label_of(key):
    a, e = parse_key(key)
