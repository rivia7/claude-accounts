YAML_KEY = lazy_re(r'^([A-Za-z0-9_][A-Za-z0-9_.-]*):(?:[ \t]+(.*?))?[ \t]*$')


def yaml_sections(lines):
    """顶层键 → [起始行, 结束行)。只认 serde_yaml 那样的块写法：顶层键顶格写，列表条目也从第 0 列的 "- " 开始"""
    secs, cur = {}, None
    for i, line in enumerate(lines):
        if YAML_KEY.match(line):
            if cur:
                secs[cur][1] = i
            cur = YAML_KEY.match(line).group(1)
            secs[cur] = [i, len(lines)]
    return secs


def yaml_unquote(v):
    # 引号写成 \x22 / \x27：这段 Python 嵌在 bash 的 $(…) 里，macOS 的 bash 3.2 会数引号，落单的引号会让它认错结尾
    v = v.strip()
    if v.startswith('\x22'):
        try:
            return json.loads(v)
        except ValueError:
            return v.strip('\x22')
    if v.startswith('\x27'):
        return v[1:-1].replace('\x27\x27', '\x27')
    return v


def yaml_items(lines, sec):
    """块列表里的条目 [[起, 止, name]]：`- name: X` 加缩进的续行，或一行的 `- {name: X, …}`"""
    items = []
    for i in range(sec[0] + 1, sec[1]):
        if lines[i].startswith('- ') or lines[i] == '-':
            items.append([i, i + 1, None])
        elif items and (lines[i].startswith(' ') or not lines[i].strip()):
            items[-1][1] = i + 1
    for it in items:
        first = lines[it[0]][2:].strip()
        if first.startswith('{'):
            it[2] = flow_get(first, 'name')
            continue
        for j in range(it[0], it[1]):   # 条目自己的键：第一行 "- " 后面，或正好缩进两格的续行
            line = lines[j]
            if j == it[0] or (line.startswith('  ') and line[2:3] not in (' ', '-')):
                m = re.match(r'name:\s*(.*)$', line[2:])
                if m:
                    it[2] = yaml_unquote(m.group(1))
                    break
    return items


def flow_get(text, key):
    """一行写完的条目 {name: X, type: ss, …} 里某个键的值；没有返回 None"""
    m = re.search(r'(?:^|[{,])\s*[\x22\x27]?%s[\x22\x27]?\s*:\s*(\x22(?:[^\x22\\]|\\.)*\x22|\x27(?:[^\x27]|\x27\x27)*\x27|[^,}]*)'
                  % re.escape(key), text)
    return yaml_unquote(m.group(1)) if m else None


def yaml_names(lines, secs):
    return {n for k in ('proxies', 'proxy-groups') if k in secs for _, _, n in yaml_items(lines, secs[k]) if n}


def yaml_proxies(lines, secs):
    """运行配置 proxies 里的节点：[(名字, 摘要)]，摘要和路由器那边一样按类型、服务器、端口、TLS 域名算（node_fp）"""
    keys = ('type', 'server', 'port', 'servername', 'sni')
    out = []
    for a, b, n in (yaml_items(lines, secs['proxies']) if 'proxies' in secs else []):
        if not n:
            continue
        first = lines[a][2:].strip()
        if first.startswith('{'):
            v = {k: flow_get(first, k) for k in keys}
        else:
            v = {}
            for j in range(a, b):   # 条目自己的键：第一行 "- " 后面，或正好缩进两格的续行（同 yaml_items）
                line = lines[j]
                if j == a or (line.startswith('  ') and line[2:3] not in (' ', '-')):
                    m = re.match(r'(%s):\s*(.*)$' % '|'.join(keys), line[2:])
                    if m:
                        v.setdefault(m.group(1), yaml_unquote(m.group(2)))
        out.append((n, node_fp(v.get('type'), v.get('server'), v.get('port'), v.get('servername') or v.get('sni'))))
    return out


def fill_members(item, names):
    """运行配置里一个策略组条目（serde_yaml 的块写法：键缩进两格，proxies 的成员一行一个 "  - 名字"）末尾补上 names 里
    还没有的。一行写完的条目、proxies 写成 […] 的、relay 和 include-all 的组不动（Clash Verge 下次按全局扩展脚本重新
    生成配置时会补上）"""
    if item[0][1:].lstrip().startswith('{'):
        return item
    keys = {}
    for j, line in enumerate(item):
        if j == 0 or (line.startswith('  ') and line[2:3] not in (' ', '-')):
            m = re.match(r'(?:- |  )([A-Za-z0-9_-]+):\s*(.*)$', line)
            if m:
                keys.setdefault(m.group(1), (j, yaml_unquote(m.group(2))))
    if (keys.get('type', (0, ''))[1] == 'relay' or 'true' in (keys.get('include-all', (0, ''))[1],
                                                               keys.get('include-all-proxies', (0, ''))[1])):
        return item
    if 'proxies' not in keys:
        end = len(item)
        while end > 1 and not item[end - 1].strip():
            end -= 1
        return item[:end] + ['  proxies:'] + ['  - ' + json.dumps(n, ensure_ascii=False) for n in names] + item[end:]
    j, v = keys['proxies']
    if v not in ('', '[]'):
        return item
    k, cur = j + 1, []
    while v == '' and k < len(item) and item[k].startswith('  - '):
        cur.append(yaml_unquote(item[k][4:]))
        k += 1
    more = [n for n in names if n not in cur]
    if not more:
        return item
    return item[:j] + ['  proxies:'] + item[j + 1:k] + ['  - ' + json.dumps(n, ensure_ascii=False) for n in more] + item[k:]


def cmd_local_patch(path, mode='install', fill_src=''):
    """给 PUT /configs 用的 JSON：Clash Verge 当前的运行配置加上端口池（mode=remove 时去掉）。fill_src 是写进了参考节点的
    配置文件（Clash Verge 当前的配置，或热加载成功后才换上去的新内容）：照它把参考节点补进运行配置，和 Clash Verge 下次按它
    重新生成的一样（cca 写的那几个按参考配置的定义换上，名字补进同名策略组）。只动这几处，其余逐字保留；看不懂格式时返回 1"""
    c, t, _ = ctx()
    try:
        with open(path, encoding='utf-8') as f:
            lines = f.read().split('\n')
    except OSError:
        sys.exit(1)
    secs = yaml_sections(lines)
    if 'proxies' not in secs and 'proxy-providers' not in secs:
        sys.exit(1)
    have = yaml_names(lines, secs)
    add = {'proxy-groups': [], 'listeners': [], 'proxies': []}
    fmem, fgrp = [], None
    managed = set()
    f = policy_fill() if mode != 'remove' and fill_src else None
    if f:   # 照配置文件里 cca 写的（行尾带 # cca 的）来：节点去掉运行配置里原来的、按参考配置的定义加上，组成员接上
        nodes, members = fill_marked(fill_src)
        managed = nodes & {p['name'] for p in f['proxies']}
        have |= managed
        fmem, fgrp = [n for n in members if n in have], f['group']
        add['proxies'] = ['- ' + json.dumps(p, ensure_ascii=False) for p in f['proxies'] if p['name'] in managed]
    if mode != 'remove':
        for g, p, order in slot_orders(c, local=True):
            add['proxy-groups'].append('- ' + json.dumps({'name': g, 'type': 'select', 'proxies': local_members(order, have)},
                                                         ensure_ascii=False))
            add['listeners'].append('- ' + json.dumps({'name': g.lower(), 'type': 'mixed', 'listen': '127.0.0.1', 'port': p,
                                                       'users': [], 'proxy': g}))
    ours = {'proxy-groups': re.compile(r'CCA-\d+$'), 'listeners': re.compile(r'cca-\d+$')}
    if add['proxies']:   # cca 写的那几个节点：去掉原来的，按参考配置的定义接在最后；别的节点一个不动
        ours['proxies'] = re.compile('(?:%s)$' % '|'.join(re.escape(n) for n in sorted(managed)))
    tail = []
    for key in sorted(ours, key=lambda k: -secs.get(k, [-1])[0]):   # 从后往前改，前面段落的行号不受影响
        if key not in secs:
            tail += [key + ':'] + add[key] if add[key] else []
            continue
        s, e = secs[key]
        if (YAML_KEY.match(lines[s]).group(2) or '') not in ('', '[]', 'null', '~'):
            sys.exit(1)   # 行内写法的非空列表，不去改它
        # 重建这一段：去掉 cca 原来的条目，新的接在最后（和全局扩展脚本 push 到末尾一致），段尾的空行留在最后
        starts = {a: (b, n) for a, b, n in yaml_items(lines, secs[key])}
        new, i = [key + ':'], s + 1
        while i < e:
            if i in starts:
                b, n = starts[i]
                if not (n and ours[key] and ours[key].match(n)):
                    new += fill_members(lines[i:b], fmem) if key == 'proxy-groups' and fmem and n == fgrp else lines[i:b]
                i = b
            else:
                new.append(lines[i])
                i += 1
        blank = []
        while len(new) > 1 and not new[-1].strip():
            blank.append(new.pop())
        lines[s:e] = new + add[key] + blank
    if tail:
        while lines and not lines[-1].strip():
            lines.pop()
        lines += tail + ['']
    print(json.dumps({'payload': '\n'.join(lines)}))


