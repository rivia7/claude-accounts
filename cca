pkg_hint() {   # pkg_hint 命令…：Linux 上装这些命令的那一行（认出包管理器时，前面带「：」）。和 install.sh 里的一样
	local pm p c out="" s=""
	on_linux || return 0
	# 包管理器可能在 sbin 里（Alpine 的 apk 在 /sbin），不在 PATH 里也认
	for pm in apt-get dnf yum zypper pacman apk ""; do
		[ -z "$pm" ] || command -v "$pm" >/dev/null 2>&1 || [ -x "/sbin/$pm" ] || [ -x "/usr/sbin/$pm" ] && break
	done
	for c in "$@"; do
		case "$pm:$c" in
			apt-get:ssh*) p=openssh-client ;;
			dnf:ssh*|yum:ssh*|zypper:ssh*) p=openssh-clients ;;
			pacman:ssh*) p=openssh ;;
			apk:ssh) p=openssh-client-default ;;
			apk:ssh-keygen) p=openssh-keygen ;;
			dnf:nc|yum:nc) p=nmap-ncat ;;
			pacman:nc) p=openbsd-netcat ;;
			*:nc) p=netcat-openbsd ;;
			pacman:python3) p=python ;;
			*:gunzip) p=gzip ;;
			*:find) p=findutils ;;
			*) p=$c ;;
		esac
		case " $out " in *" $p "*) ;; *) out="${out:+$out }$p" ;; esac
	done
	[ "$(id -u)" = 0 ] || s="sudo "
	case "$pm" in
		apt-get) printf '：%sapt install %s' "$s" "$out" ;;
		dnf|yum|zypper) printf '：%s%s install %s' "$s" "$pm" "$out" ;;
		pacman) printf '：%spacman -S %s' "$s" "$out" ;;
		apk) printf '：%sapk add %s' "$s" "$out" ;;
	esac
}
need_deps() {   # 安装时查依赖：install.sh 下载之前查的是同一份（命令、Python 和 OpenSSH 的版本），两边一起改
	local c miss="" v
	# find：自动更新、映射多久没查过，清掉上次异常退出留下的锁（Amazon Linux、openSUSE 的最小安装没有它）
	for c in ssh ssh-keygen nc curl perl gunzip find; do command -v "$c" >/dev/null 2>&1 || miss="${miss:+$miss }$c"; done
	[ -z "$miss" ] || die "缺少命令 ${miss// /、}，先装上再运行 cca install$(pkg_hint $miss)"
	# macOS 的 /usr/bin/python3 只是个占位，没装命令行工具时一运行就弹安装窗口
	if [ -z "$PYTHON" ] || { [ "$PYTHON" = /usr/bin/python3 ] && [ "$(uname)" = Darwin ] && ! xcode-select -p >/dev/null 2>&1; }; then
		die "需要 python3：先运行 xcode-select --install 装上苹果的命令行工具，装好后重新安装"
	fi
	v=$("$PYTHON" -I -c 'import sys; print("%d.%d" % sys.version_info[:2]); sys.exit(sys.version_info < (3, 8))' 2>/dev/null) ||
		die "cca 要 Python 3.8 或更新（${PYTHON} 是 ${v:-更早的版本}）"
	# 校验更新、映射的签名用 ssh-keygen -Y，OpenSSH 8.1 才有（RHEL / Rocky 8 是 8.0）；认不出版本（不是 OpenSSH）时不拦
	v=$(ssh -V 2>&1 | sed -n 's/^OpenSSH_\([0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | head -n 1)
	case "$v" in [1-7].*|8.0) die "OpenSSH 太旧（${v}）：cca 校验更新和映射的签名要 8.1 或更新（ssh-keygen -Y）" ;; esac
	if on_linux; then warn "Linux 上能用的是命令行：账号的网络（路由器的端口池、cca 内置的代理）、登录（登录页在 Mac 上用账号专属的 Chrome 打开）、API key（存成权限 600 的文件）；桌面 App、网页版、图形界面这些只在 macOS 上"
	elif [ "$(uname)" != Darwin ]; then warn "本脚本按 macOS 编写（钥匙串、open、Chrome 路径），其它系统需自行调整"; fi
}

path_hint() {   # ~/.local/bin 不在 PATH 里：征得同意后写进 shell 的启动文件。macOS 的终端开的是登录 shell，bash 读 ~/.bash_profile；
	# Linux 上 bash 写 ~/.bashrc（Ubuntu、Debian 的 ~/.profile，Fedora、RHEL、Arch 的 ~/.bash_profile 都会读它；新建一个
	# ~/.bash_profile 反而会让 Ubuntu、Debian 的登录 shell 不再读 ~/.profile），sh、ash（Alpine）这些写 ~/.profile
	local bin="$1" rc="$HOME/.zshrc" again="打开一个新的终端标签"
	case "${SHELL:-}" in
		*/zsh) ;;
		*/bash) if on_linux; then rc="$HOME/.bashrc"; else rc="$HOME/.bash_profile"; fi ;;
		*) on_linux && rc="$HOME/.profile" ;;
	esac
	on_linux && again="重新登录（或者运行 . ~/${rc##*/}）后"
	if grep -qs '\.local/bin' "$rc"; then
		warn "${bin} 已经写在 ${rc} 里，只是当前终端还没生效：${again}再用 cca"
	elif confirm "把 ${bin} 加进 PATH（写入 ${rc}），以后直接输入 cca 就能用？" y; then
		printf '\n# cca（Claude Code 多账号）\nexport PATH="$HOME/.local/bin:$PATH"\n' >> "$rc" || return 1
		info "已写入 ${rc}"
		CCA_PATH_ADDED="$again"
	else
		warn "${bin} 不在 PATH 里：可以用 ${bin}/cca 运行，或者自己把它加进 PATH"
	fi
}

codex_alias_ensure() {   # codex_alias_ensure [账号名] [quiet]：没有就建 ~/.local/bin/cxa（指向同目录 cca 的相对链接，cca 指向哪它就跟到哪）；
	                       # 那里已经有别的文件、或者 PATH 里已经有别的 cxa 时不建，提示一句。quiet 是平时每次运行时的检查：
	                       # 那里有东西（不管是不是 cca 建的）就不动，建不了也不说，免得每次都提示。总是返回 0
	local bin="$HOME/.local/bin" other quiet="${2:-}"
	if [ -n "$quiet" ]; then { [ -e "$bin/$CODEX_ALIAS" ] || [ -L "$bin/$CODEX_ALIAS" ]; } && return 0; fi
	[ "$(readlink "$bin/$CODEX_ALIAS" 2>/dev/null)" = cca ] && return 0
	[ -e "$bin/cca" ] || return 0   # cca 没装在 ~/.local/bin 里（直接运行的这份脚本）：不建
	if [ -e "$bin/$CODEX_ALIAS" ] || [ -L "$bin/$CODEX_ALIAS" ]; then
		warn "${bin}/${CODEX_ALIAS} 已经存在，不是 cca 建的：没有建 ${CODEX_ALIAS} 这个简写（照样可以用 cca codex）"
		return 0
	fi
	other=$(type -P "$CODEX_ALIAS" 2>/dev/null)
	if [ -n "$other" ]; then
		[ -n "$quiet" ] || warn "已经有别的 ${CODEX_ALIAS} 命令（${other}）：没有建 ${CODEX_ALIAS} 这个简写（照样可以用 cca codex）"
		return 0
	fi
	ln -s cca "$bin/$CODEX_ALIAS" 2>/dev/null || { [ -n "$quiet" ] || warn "没能建 ${bin}/${CODEX_ALIAS}（照样可以用 cca codex）"; return 0; }
	info "以后可以直接用 ${CODEX_ALIAS} 代替 cca codex：${CODEX_ALIAS} @${1:-别名} 直接启动，${CODEX_ALIAS} usage 查用量"
}

cmd_install() {
	need_deps
	need_tty
	mkdir -p "$CCA_HOME/accounts" "$CCA_HOME/bin" "$CCA_HOME/backup" || die "无法创建 $CCA_HOME"
	chmod 700 "$CCA_HOME"
	py init || die "初始化配置失败"
	if [ -f "$HOME/.claude.json" ] && [ -z "$(ls -A "$CCA_HOME/backup" 2>/dev/null)" ]; then
		cp -p "$HOME/.claude.json" "$CCA_HOME/backup/claude.json.$(date +%Y%m%d-%H%M%S)"
	fi
	local target="$SELF" bin="$HOME/.local/bin"
	if ! dev_mode && [ "$SELF" != "$CCA_HOME/bin/cca" ]; then   # 发布版复制到 ~/.cca/bin/cca，自动更新替换的是这一份
		# 换下来的是别的版本（例如装测试版时换下的正式版）：留着，可以 cca update --rollback 退回
		# 比摘要，不用 cmp：Arch、openSUSE 的最小安装没有 cmp（diffutils），! cmp 恒为真，重装同一版本也会留一份"旧版"
		if [ -f "$CCA_HOME/bin/cca" ] && [ "$(sha256_of "$SELF")" != "$(sha256_of "$CCA_HOME/bin/cca")" ]; then
			mkdir -p "$UPD" && cp -p "$CCA_HOME/bin/cca" "$UPD/cca.prev" && ver_of "$CCA_HOME/bin/cca" > "$UPD/cca.prev.version"
		fi
		{ cp "$SELF" "$CCA_HOME/bin/cca.new.$$" && chmod 755 "$CCA_HOME/bin/cca.new.$$" &&
			mv -f "$CCA_HOME/bin/cca.new.$$" "$CCA_HOME/bin/cca"; } || die "复制到 $CCA_HOME/bin/cca 失败"
		target="$CCA_HOME/bin/cca"
	fi
	printf '#!/bin/sh\nexec %q _browser "$@"\n' "$target" > "$CCA_HOME/bin/open-url"
	chmod 755 "$CCA_HOME/bin/open-url"
	mkdir -p "$bin"
	if [ "$(readlink "$bin/cca" 2>/dev/null)" != "$target" ]; then
		[ -e "$bin/cca" ] && [ ! -L "$bin/cca" ] && die "$bin/cca 已存在且不是本脚本，请先处理"
		ln -sf "$target" "$bin/cca"
	fi
	case ":$PATH:" in *":$bin:"*) ;; *) path_hint "$bin" ;; esac
	info "已安装：$bin/cca → $target"
	codex_alias_ensure
	if [ -n "${CCA_POLICY_REPO:-}" ]; then   # 一键安装时带上维护者的映射仓库：curl … | CCA_POLICY_REPO=仓库 bash
		( policy_setup "$CCA_POLICY_REPO" ) || warn "映射仓库没配置好：稍后运行 cca policy setup ${CCA_POLICY_REPO}"
	fi
	if dev_mode; then info "开发模式：直接用 git 仓库里的这份脚本，不自动更新"
	else info "自动更新已开启：每天检查一次，新版本在下次启动时安装（cca update off 可关闭）"; fi
	info "账号表：${TABLE}；可选节点、纯净度阈值在 ${CFG}（nodes / min_trust）"
	if ! router_ready && confirm "现在配置路由器（OpenClash 或 ShellCrash；SSH 免密 + 按端口分流）？" y; then
		cmd_router_setup || warn "路由器配置没完成，稍后可运行 cca router setup"
	fi
	if [ -z "$CLAUDE_BIN" ]; then   # 辅助安装：直连不通时可以经内置代理装（要有节点定义：映射的参考节点，或者在家时从路由器拷的）
		if confirm "没找到 Claude Code（claude 命令）。现在用官方安装脚本装上吗？" y; then
			tool_install || warn "Claude Code 没装上：稍后运行 cca install-cli 再装"
		else
			info "以后用 cca install-cli 装 Claude Code（只用 Codex、Antigravity 账号的话不需要它）"
		fi
	fi
	if [ -z "$(py keys)" ] && confirm "现在新增第一个账号？" y; then
		cmd_add || true
	fi
	if [ -n "${CCA_PATH_ADDED:-}" ]; then info "完成。${CCA_PATH_ADDED}，输入 cca 就能用（cca help 查看全部命令）"
	else info "完成。以后输入 cca 启动 Claude Code（cca help 查看全部命令）"; fi
}

cmd_restore() {
	local key bk out rc pid running="" wt="" t
	[ -d "$CCA_HOME" ] || { info "没有 ${CCA_HOME}，无需还原"; return 0; }
	need_tty
	for t in claude codex agy; do   # 账号的桌面 App 开着时删它的资料目录会出问题（agy 没有桌面 App）
		use_tool "$t"
		while IFS= read -r key; do
			[ -n "$key" ] || continue
			eval "$(py env "$key")"
			pid=$(tool app_pid "$ACC_DESKTOP_DIR"); rc=$?
			[ "$rc" -le 1 ] || die "无法查询 ${APP_LABEL} 进程，已停止还原；请稍后重试"
			[ -n "$pid" ] && running="${running:+${running}、}${ACC_NAME}（${APP_LABEL}）"
			[ "$t" = codex ] && has_worktrees && wt="${wt:+${wt}、}${ACC_NAME}"
		done < <(py keys)
	done
	use_tool claude
	gui_ours "$GUI_APP" && gui_running && running="${running:+${running}、}cca 的界面 App"
	[ -z "$running" ] || die "这些账号的桌面 App 还开着：${running}。先退出它们再还原"
	# 删 ~/.cca 之前要先打包备份（下面答应了的）：没有 tar 就什么都别动（有的 Linux 最小安装没有它）
	command -v tar >/dev/null 2>&1 || die "这台机器上没有 tar，没法先打包备份配置，什么都没改：装上 tar 再还原$(pkg_hint tar)"
	say "${C_B}一键还原${C_0}：撤销 cca 做过的全部改动"
	say "  · 每个账号（Claude、Codex 和 Antigravity）：把会话里新产生的共享内容并回 ~/.claude、~/.codex、~/.gemini，然后退出登录、删除它的登录凭证"
	say "  · ${KEYSTORE}里 cca 存的 API key 全部删掉：第三方 API 账号的，和给官方账号记下备查的（删了找不回来，要留的先用 cca [codex] key 账号 --show 抄下来）"
	say "  · 路由器：移除钩子、cron、端口池（要让 OpenClash / ShellCrash 重载一次，约 20 秒，期间局域网新连接会失败）、/etc/cca 和 cca 的 SSH 公钥"
	say "  · 本机 Clash Verge（配置过的话）：删掉全局扩展脚本里 cca 的那一段，移除本机端口池；内置代理（用过的话）：停掉它的内核"
	say "  · 本机：先打包备份配置（不含浏览器资料、登录凭证和私钥），再删除 ~/.local/bin 里的 cca、${CODEX_ALIAS}，${CCA_HOME} 和各账号的 App 启动器$(gui_ours "$GUI_APP" && printf '，还有图形界面 %s' "$GUI_APP")"
	say "  · ~/.claude、~/.claude.json、~/.codex 和 ~/.gemini 保持现状（共享主目录本来就是你的数据；安装前的备份在打包里）"
	[ -z "$wt" ] || say "  · ${C_Y}这些 Codex 账号建的 git 工作树（worktrees）会一起删掉：${wt}。还没提交的改动先处理好${C_0}"
	[ "$(ask '确认请输入 restore: ' '')" = restore ] || { say "已取消"; return 0; }
	for t in claude codex agy; do
		use_tool "$t"
		while IFS= read -r key; do
			[ -n "$key" ] || continue
			eval "$(py env "$key")"
			py link "$key" >/dev/null 2>&1
			py sync "$key" >/dev/null 2>&1
			logout_account
			info "已退出账号 ${ACC_LABEL}"
		done < <(py keys)
		py secrets-forget all   # 账号表里已经没有、钥匙串里还留着的 key（第三方 API 账号的、官方账号记下备查的）也删掉
		launchers_sync remove-all
	done
	use_tool claude
	if router_ready; then
		out=$(rsh "CCA_ALLOW_RELOAD=1 $RDIR/cca-router.sh uninstall" < "$ROUTER_KEY.pub" 2>&1); rc=$?
		[ -n "$out" ] && printf '%s\n' "$out" | sed 's/^/  │ /' >&2
		if [ $rc -eq 0 ]; then
			info "路由器已还原"
		else
			warn "路由器还原失败（SSH 密钥还在，修好网络后可重新运行 cca restore）"
			confirm "仍然继续还原本机？之后需要 ssh 到路由器手动执行 /etc/cca/cca-router.sh uninstall </dev/null" n || return 1
		fi
		rsh_close
	fi
	load_local
	if local_ready; then local_remove; info "本机 ${LOCAL_NAME} 里 cca 的端口池已移除"; fi
	core_stop_stale   # 内置代理的内核（界面 App 退出时会停掉它，这里是 App 崩溃后留下的）
	on_linux && core_boot off   # 开机起内核的那一行（上面换掉内置代理时已经删了；以前留下的也删）
	py presence-stop 2>/dev/null   # 设备统计的上报进程：先停掉（它告诉服务器这台机器停了；打包的时候也没人再往 ~/.cca 里写）
	bk="$HOME/cca-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
	# 只给自己读：账号表里可能写着第三方 API 的 key，config.json 里有本机 Clash 的密钥。节点密钥（内置代理拷来的节点、维护者的参考节点，
	# 连同拉取映射时的临时文件）、内置代理的配置和内核文件不打包（bsdtar 的 --exclude 不锚定开头，写具体的文件名，免得误伤别处叫 core、
	# policy 的目录）；Clash Verge 配置的备份（backup/）是用户自己的配置文件，照样打包。登录凭证（Codex 的 auth.json、Linux 上
	# Claude Code 的 .credentials.json、agy 的 antigravity-oauth-token）、密钥文件（secrets：上面按记账删过，没记上账的也不带）不打包
	( umask 077; tar -czf "$bk" -C "$CCA_HOME" --exclude 'core/nodes.json' --exclude 'core/config.yaml' --exclude 'core/mihomo-v*' --exclude 'core/dl.*' \
		--exclude 'policy/nodes.json*' --exclude 'policy/tmp.*' \
		--exclude '*/chrome' --exclude '*/desktop' --exclude 'cm-*' --exclude 'router_ed25519' --exclude 'id_ed25519' --exclude '*.lock' \
		--exclude 'auth.json' --exclude '.credentials.json' --exclude 'antigravity-oauth-token' --exclude 'secrets' \
		--exclude '*/worktrees' --exclude '*/.tmp' --exclude '*/log' --exclude '*/cache' . 2>/dev/null )
	# 看包能不能完整读出来，不看 tar 的退出码：GNU tar 遇到打包时正好被改了的文件也返回 1，包照样是好的；磁盘满了写到一半的包读不完
	if [ -s "$bk" ] && tar -tzf "$bk" >/dev/null 2>&1; then
		info "配置备份：$bk"
	else   # 没打成：不删 ~/.cca，免得没备份就删了
		rm -f "$bk"
		warn "配置没能打包备份（磁盘满了？）：${CCA_HOME} 留着没删，别的都已经还原。腾出空间后自己备份它，不要的话直接删掉（rm -rf ${CCA_HOME}）"
		return 1
	fi
	[ "$(readlink "$HOME/.local/bin/$CODEX_ALIAS" 2>/dev/null)" = cca ] && rm -f "$HOME/.local/bin/$CODEX_ALIAS"   # 只删 cca 建的
	case "$(readlink "$HOME/.local/bin/cca" 2>/dev/null)" in "$SELF"|"$CCA_HOME/bin/cca") rm -f "$HOME/.local/bin/cca" ;; esac
	if gui_ours "$GUI_APP"; then rm -rf "$GUI_APP"; defaults delete "$GUI_ID" >/dev/null 2>&1; info "已删除界面 App ${GUI_APP}"; fi
	rm -rf "${CCA_HOME:?}"
	info "已还原。原来的 claude、codex、agy 命令和 ~/.claude、~/.codex、~/.gemini 不受影响"
}

usage() {   # Linux（服务器）上不列只在 macOS 上的命令（网页版、桌面 App、图形界面），几处说法按平台换
	local mac=1 host="这台 Mac " away="在外面走本机 Clash" cxlogin="第一次启动时在它专属的浏览器窗口里登录" leaks="DNS / WebRTC 泄露"
	local aglogin="第一次启动时在它专属的浏览器窗口里登录，把页面上的授权码粘贴回终端"
	on_linux && mac="" host="这台机器" away="连不上路由器时走 cca 内置的代理" cxlogin="第一次启动时给出在 Mac 上运行的 login-page 那一行" leaks="DNS 泄露"
	on_linux && aglogin="第一次启动时给出在 Mac 上运行的 login-page 那一行，再把授权码贴回这里"
	cat >&2 <<EOF
cca $VERSION — Claude Code / Codex 多账号（账号独立登录，历史/记忆/配置共享；每个账号走路由器上 OpenClash / ShellCrash 的独立端口，${away}）

启动
  cca [claude 参数]          弹出账号菜单：↑↓ 选择、回车确认、数字键直接选、q 退出；
                             光标默认停在上次用的账号，菜单里也能直接添加新账号
  cca @<账号> [claude 参数]   跳过选择；账号可写别名、邮箱、编号或唯一前缀
                             启动前经该账号端口检测出口（claude.ai 看到的 IP + ip.net.coffee 纯净度）

用量
  cca usage [账号…] [--json]  查官方账号的订阅用量：5 小时、本周（含分模型）额度用了多少、什么时候重置；
                             经每个账号自己的出口、让 Claude Code 自己去查（不发消息、不耗额度），
                             查不到时显示上次的缓存。菜单和 cca ls 里也会附上最近一次的用量

账号表  $TABLE    {"别名(邮箱)": "节点"}，别名可省略（只写邮箱）；端口自动分配
  cca add                    新增账号：分两行填登录邮箱和别名（可选），再选出口节点；
                             登录时邮箱会预填在登录页里
  cca add api                新增第三方 API 账号（兼容 Anthropic 接口的地址 + key，模型可选）：
                             直连或走节点；key 存进${KEYSTORE}，经 apiKeyHelper 交给 Claude Code
                             表里写法：{"别名": {"base_url": "…", "model": "…", "node": "", "env": {…}}}
  cca key <账号>             第三方 API 账号：重新输入 key；官方账号：记一把 API key 备查（存进${KEYSTORE}，cca 不拿它启动）
  cca key <账号> --show      把 key 打出来（App 里的「显示」「复制」）；--forget 删掉官方账号记的 key
  cca edit                   用编辑器改账号表，保存后校验并同步（只改别名不影响登录和端口）
  cca rename <账号> <新别名>  改别名（写 - 去掉别名，只留邮箱）：登录、资料、端口都不变，启动器跟着改名
  cca reorder <账号>…        按这个顺序排账号表（没写到的接在后面）：菜单、编号跟着变，端口、路由器都不动
  cca ls                     列出账号、登录状态和端口
  cca rm <账号>              删除账号（退出登录，删${KEYSTORE_CRED}${mac:+和浏览器资料}）
EOF
	[ -z "$mac" ] || cat >&2 <<EOF
  cca web [账号] [网址]      用该账号的浏览器实例打开 claude.ai（或指定网址，如 https://ip.net.coffee/claude/）；
                             只用于官方账号
  cca billing [账号]         用该账号的浏览器实例打开控制台的账单页，看订阅附带的每月 API 额度和余额；只用于官方账号
  cca limit-resets [账号]    用该账号的浏览器实例打开 claude.ai 的用量页，看重置次数和到期日；只用于 Claude 的官方账号
  cca app [账号]             用该账号专属的资料目录和出口打开 Claude App（桌面版），已经开着就切到它；
                             每个账号在 ~/Applications 里有一个「Claude 别名」启动器（没有别名时用邮箱 @ 前面的
                             部分；cca app --launchers 重新生成）。只用于官方账号
EOF
	cat >&2 <<EOF
  cca check [账号…] [--json]  检测各账号出口 IP、地区、纯净度和 ${leaks}，提示共用出口；第三方 API 账号只检测接口连不连得上
EOF
	if [ -n "$mac" ]; then cat >&2 <<EOF
  cca login <账号>           退出这个账号现在的登录，在它专属的浏览器窗口里重新登录。在 Linux 服务器上：给出一行
                             cca login-page 命令，在 Mac 上运行它打开登录页，再把 Mac 上拿到的验证码贴回服务器
  cca login-page <账号> [--node 节点] <登录网址>
                             （在 Mac 上）服务器上登录时用：用这个账号专属的 Chrome、经同一个节点打开登录页，
                             接住登录后跳回来的验证码，复制到剪贴板。节点按地址认（两边叫法可以不同）；
                             这台 Mac 上还没有这个账号时，问要不要用同一个节点加上它
  cca gui                    打开图形界面（cca App：各账号的用量、节点分流，一键打开桌面 App、网页版）；没装就先下载
                             和 cca 同版本的 App 装进 ~/Applications（要 macOS 26 或更新）。cca gui update | remove
EOF
	else cat >&2 <<EOF
  cca login <账号>           退出这个账号现在的登录，重新登录：这台机器上没有账号专属的浏览器，给出一行在 Mac 上运行的
                             cca login-page 命令（用账号专属的 Chrome、经同一个节点打开登录页），再把拿到的验证码贴回这里
  网页版、桌面 App、图形界面（web、billing、limit-resets、app、gui）要用账号专属的 Chrome 或 App，只在 macOS 上
EOF
	fi
	cat >&2 <<EOF

Codex（账号表 ~/.cca/codex.json，和 Claude 账号分开记：同一个人的两种账号可以用同一个别名、同一个邮箱）
  cca codex [codex 参数]     弹出 Codex 账号菜单，选中后启动 codex；cca codex @<账号> [codex 参数] 跳过选择。
                             每个账号一个 CODEX_HOME，登录各自独立；~/.codex 里的 config.toml、AGENTS.md、会话、
                             技能、记忆等所有账号共用。启动前经该账号端口检测出口（chatgpt.com 看到的 IP）
  cxa [codex 参数]           等于 cca codex：cxa @<账号>、cxa usage、cxa add 等都一样（cca install 时和 cca
                             一起建在 ~/.local/bin；添加 Codex 账号时没有的话也会补上）
  cca codex add [api]        新增 Codex 账号（用 ChatGPT 登录，${cxlogin}）；
                             api：兼容 OpenAI Responses 接口的第三方服务（地址 + key，模型可选）
  cca codex usage [账号…] [--json]
                             查 Codex 账号的 5 小时、每周额度和剩余的重置次数：
                             经各自的出口让 codex 自己去查，不耗额度
  cca codex reset <账号> [--json]
                             用掉一次重置机会，把这个账号 5 小时和每周的用量清零（codex 里 /usage 的 Redeem reset）：
                             先经它自己的出口查还能重置几次、各在什么时候过期，问过你再用掉最早过期的那一次；
                             用量还不需要重置时不扣次数
  cca codex ls | edit | rm | key | login${mac:+ | web} | check
                             和上面同名的命令一样，作用于 Codex 账号${mac:+（web 打开 chatgpt.com）}
EOF
	[ -z "$mac" ] || cat >&2 <<EOF
  cca codex app [账号]       用该账号自己的资料目录、登录和出口打开 ChatGPT App（Codex 桌面版）；
                             启动器叫「ChatGPT 别名」（cca codex app --launchers 重新生成）。App 里要求登录时
                             别在 App 里登：关掉它，cca codex login 账号 登录后再打开
EOF
	cat >&2 <<EOF

Antigravity（Google 的 agy 命令行；账号表 ~/.cca/agy.json，和 Claude、Codex 账号分开记）
  cca agy [agy 参数]         弹出 Antigravity 账号菜单，选中后启动 agy；cca agy @<账号> [agy 参数] 跳过选择。
                             每个账号一个数据目录（--gemini_dir），登录各自独立；~/.gemini 里的会话、记忆、设置、
                             技能、MCP 等所有账号共用。启动前经该账号端口检测出口
  cca agy add                新增 Antigravity 账号（用 Google 账号登录，${aglogin}）
  cca agy ls | edit | rm | key | login${mac:+ | web} | check
                             和上面同名的命令一样，作用于 Antigravity 账号${mac:+（web 打开 antigravity.google）}；
                             没有查用量的接口，也没有第三方 API 账号和桌面 App
EOF
	cat >&2 <<EOF

路由器
  cca router setup           SSH 免密（只输一次密码）+ 部署分流；路由器上用 OpenClash 还是 ShellCrash 自动检测
                             （ShellCrash 要 Meta 内核，路由器上还要装 ruby：opkg install ruby ruby-yaml）
  cca router sync [-y]       同步账号到路由器：换节点、增删账号走 API 即时生效；只有端口池要扩容
                             或可选节点变了才需重载 OpenClash / ShellCrash（约 20 秒），会先问你（-y 直接同意）。
                             路由器上的节点改了名会跟着改（按服务器地址认，认不出的让你选）；
                             运行配置文件不见了时，重载换成重启 OpenClash / ShellCrash（同样先问）
  cca router status|nodes|log|ssh|uninstall

EOF
	if [ -n "$mac" ]; then cat >&2 <<EOF
出门在外（连不上路由器时改走本机的 Clash 客户端，例如 Clash Verge；没有的话用 cca 内置的代理）
  cca local [status]         现在走哪条路；本机端口池各端口的监听状态和选中的节点
  cca local setup            配置本机 Clash：Clash Verge 自动配置（全局扩展脚本里加一段，不用重启它）；
                             没装 Clash Verge 时默认用内置代理（mihomo 内核，在界面 App 里运行；节点在家时从路由器拷一份），
                             也可以按提示手动配置别的基于 mihomo 的客户端。在外面第一次启动时也会问
  cca local off              删掉 Clash Verge 全局扩展脚本里 cca 的那一段，移除本机端口池；内置代理则停掉内核、删掉拷来的节点
                             平时自动判断：连得上路由器走路由器，连不上走本机 Clash；
                             想固定一种，把 ${CFG} 的 route 改成 router 或 local
EOF
	else cat >&2 <<EOF
连不上路由器时（云服务器、不在家）改走本机的代理，默认是 cca 内置的代理
  cca local [status]         现在走哪条路；本机端口池各端口的监听状态和选中的节点
  cca local setup            配置本机的代理：Linux 桌面上装了 Clash Verge 就自动配置它（全局扩展脚本里加一段）；
                             没有时默认用内置代理（mihomo 内核，由 cca 在后台运行，不用 root；节点在家时从路由器拷一份，
                             连不到路由器的服务器上用维护者的参考节点），也可以按提示手动配置别的基于 mihomo 的客户端。
                             在外面第一次启动时也会问
  cca local off              停掉内置代理的内核、删掉拷来的节点（Clash Verge：删掉全局扩展脚本里 cca 的那一段；
                             手动配置的客户端：移除本机端口池）
                             平时自动判断：连得上路由器走路由器，连不上走本机的代理；
                             想固定一种，把 ${CFG} 的 route 改成 router 或 local
EOF
	fi
	cat >&2 <<EOF

维护者的账号 → 节点映射（可选）
  cca policy setup [仓库]    映射放在维护者的私有 GitHub 仓库里（不写就是 ${POLICY_REPO_DEFAULT:-维护者的仓库}）：给这台机器
                             生成只读的 deploy key，把公钥交给维护者加到仓库上。还没配置时，终端里启动账号会先引导
                             （可以跳过，也可以选不再问）；安装时带 CCA_POLICY_REPO=仓库 也会做这一步
  cca policy [pull]          看映射的状态 / 马上拉一次（平时每天自动拉，验签通过才用）。映射里的账号出口固定为
                             指定的节点，账号表里改成别的会被改回；映射里有、这台机器上还没有的账号自动加进来
                             （这台机器自己的账号不动；删掉的不再加回来，cca add 可以加回来）
  cca policy request <账号>  生成一条给维护者运行的命令（把这个账号现在的节点锁进映射）并复制到剪贴板（Codex 账号：cca codex policy request）
  cca devices [账号…] [--json]
                             映射里的账号现在连着哪些设备：在用、开着但闲置（10 分钟没动静）、没在用、离线，上次什么时候用
                             （维护者在映射里配置了设备统计的服务器时才有；Codex 账号：cca codex devices）。
                             映射里的账号经 cca 用的时候（命令行会话${mac:+、cca app 打开的 App}），${host}也会报告给那台服务器

其它
  cca install                安装或修复（链接到 ~/.local/bin/cca，还有等于 cca codex 的 cxa）
  cca install-cli            用官方安装脚本装 Claude Code（cca codex install-cli、cca agy install-cli 装 codex、agy 命令）：
                             先直连，拿不到时问过再经内置代理的一个节点装（维护者的映射指定，没指定时现选一个）；
                             用到没装的命令时，终端里也会先问要不要装
  cca update                 立即更新到最新版本；平时每天自动检查一次，新版本在下次启动时自动安装
  cca update <版本号>        手动装指定的版本，例如测试版 2.6.0-beta.1（测试版不会自动装，只能这样装）
  cca update --check [--json] | --rollback | auto | notify | off
                             只检查（装着测试版时也看更新的测试版；--json 给界面 App）/ 退回上一版 / 自动安装（默认）/
                             只提示 / 关闭
  cca clients status [--json] 查看桌面客户端和终端工具（Claude Code、Codex）的更新状态（与 cca 自身更新分开）
  cca clients check --force  从官方更新源检查、下载并验证，安装前必须确认
  cca clients mode auto|off  开启/关闭 GUI 的每日自动检查和准备
  cca clients install TOKEN 安装已验证的更新；凭据由 check 给出，须先退出对应的客户端
  cca restore                一键还原 cca 的全部改动
  配置 ${CFG}：nodes（可选节点）、min_trust（纯净度低于它要确认，默认 50）、
                             claude_add_dir（设成 false：cca 启动的 Claude Code 不再能直接读写账号自己在 ~/.cca/accounts 里的目录）、
                             leak_check（设成 false：启动前不测 ${leaks}）、
                             presence（设成 false：${host}不向维护者的服务器报告、也不查设备统计）${mac:+、}
EOF
	[ -z "$mac" ] || cat >&2 <<EOF
                             dock_tidy（设成 false：cca 打开的 Chrome、桌面 App、终端退出后，不去掉程序坞「最近使用的 App」里留下的图标）
EOF
}

main() {
	[ -n "$PYTHON" ] || die "需要 python3（3.8 或更新）$(pkg_hint python3)"
	# 用 cxa 调用：换成 cca codex …。参数里带着 codex，自动更新后用新版本重新执行（exec "$SELF" "$@"）才不会变成 cca …
	[ "${0##*/}" = "$CODEX_ALIAS" ] && set -- codex "$@"
	# 后台任务不往图形界面的事件文件里写（它们是从带着 CCA_EVENTS 的命令里分出来的，跑完时那个命令早就结束了）
	case "${1:-}" in _update-fetch|_policy-fetch|_gui-fetch|_core|_core-keep|_core-nodes|_presence-agent|_dock-tidy|_dock-wait) unset CCA_EVENTS CCA_GRANT CCA_RO CCA_PROMPT; PROMPT_GUI="" ;; esac
	[ "${1:-}" = _browser ] || unset CCA_LOGIN_URL_FILE   # 只给服务器上登录时 claude / codex 回调的 cca _browser
	case "${1:-}" in
		install) cmd_install ;;
		help|-h|--help) usage ;;
		version|--cca-version) echo "$VERSION" ;;
		_browser)   # 登录页的浏览器：Claude Code 经 BROWSER 调；Codex、agy 账号登录时 cca 自己调（带着 CCA_TOOL）
			shift
			case "${CCA_TOOL:-}" in codex|agy) use_tool "$CCA_TOOL" ;; esac
			cmd_browser "$@" ;;
		_api-key)   # 第三方 API 账号的 key：Claude Code 的 apiKeyHelper、codex 的 auth.command 回调，只打印 key
			shift
			if [ "${1:-}" = codex ]; then shift; use_tool codex; fi
			py api-key-out "${1:-}" ;;
		_update-fetch) cmd_update_fetch ;;
		_policy-fetch) cmd_policy_fetch ;;
		_policy-check) shift; py policy-check "${1:-}" strict ;;   # 维护者发布映射前检查（policy.sh 调用）
		_fill-check) shift; py fill-check "${1:-}" ;;   # 维护者发布参考节点前检查（policy.sh 调用）
		_policy-lock) shift; py policy-lock "$@" ;;   # 维护者把账号锁到节点（policy.sh lock 调用）
		_gui) shift; cmd_gui_api "$@" ;;   # 图形界面的只读接口（macos/PROTOCOL.md）
		_gui-fetch) cmd_gui_fetch ;;
		_core) shift; cmd_core "$@" ;;   # 界面 App 托管的内置代理（cca _core run，见"内置代理"一节）
		_core-nodes) shift; cmd_core_nodes "$@" ;;   # 后台：从路由器拷节点定义、下载内核给内置代理
		_core-keep) CCA_SELF="$SELF" exec "${PYRUN[@]}" core-keep ;;   # 后台（Linux）：没有界面 App 时托管内置代理的内核（见 py 的 cmd_core_keep）
		_presence-agent) CCA_SELF="$SELF" exec "${PYRUN[@]}" presence-agent ;;   # 后台：这台 Mac 的设备统计上报进程（见 py 的 presence 一节）
		_dock-tidy) shift; cmd_dock_tidy "$@" ;;   # 后台：cca 打开的 App 实例退出后整理程序坞（见 py 的程序坞一节；终端交接的脚本也调，PROTOCOL 6）
		_dock-wait) shift; cmd_dock_wait "$@" ;;   # 后台小 App 里：等 cca 打开的实例退出，再整理程序坞
		gui) shift; cmd_gui "$@" ;;
		clients) shift; cmd_clients "$@" ;;
		update) shift; cmd_update "$@" ;;
		restore) cmd_restore ;;
		*)
			if [ ! -f "$CFG" ]; then
				interactive || die "还没安装：请在终端里运行 $SELF install"
				info "第一次使用，先安装"
				cmd_install
				exit 0
			fi
			update_hook "$@"
			policy_hook
			gui_hook
			# 用着 Codex（有 Codex 的账号表，或者这次就是 cca codex …）而 cxa 不见了（以前装的 cca 升级上来、被删掉了）：补上
			if [ "${1:-}" = codex ] || [ -f "$CCA_HOME/codex.json" ]; then codex_alias_ensure "" quiet; fi
			if [ "${1:-}" = codex ] || [ "${1:-}" = agy ]; then   # cca codex|agy …：后面的子命令都作用于 Codex / agy 的账号
				use_tool "$1"
				shift
				[ -f "$TABLE" ] || [ "${1:-}" = install-cli ] || py init   # 只装命令不算用起这个工具（不建账号表，映射里的账号不加进来）
			fi
			dispatch "$@" ;;
	esac
}

dispatch() {   # 各工具共用的子命令（当前工具由 use_tool 选定，默认 Claude）
	case "${1:-}" in
		help|-h|--help) usage ;;
		add) shift; cmd_add "$@" ;;
		key) shift; cmd_key "$@" ;;
		login) shift; cmd_login "$@" ;;
		login-page) shift; cmd_login_page "$@" ;;
		usage) shift; cmd_usage "$@" ;;
		reset) shift; cmd_reset "$@" ;;
		edit) cmd_edit ;;
		rename) shift; cmd_rename "$@" ;;
		reorder) shift; cmd_reorder "$@" ;;
		ls|list) cmd_list ;;
		rm|remove) shift; cmd_rm "$@" ;;
		web) shift; cmd_web "$@" ;;
		billing) shift; cmd_billing "$@" ;;
		limit-resets) shift; cmd_limit_resets "$@" ;;
		app) shift; cmd_app "$@" ;;
		check) shift; cmd_check "$@" ;;
		router) shift; cmd_router "$@" ;;
		local) shift; cmd_local "$@" ;;
		policy) shift; cmd_policy "$@" ;;
		devices) shift; cmd_devices "$@" ;;
		install-cli) shift; cmd_install_cli "$@" ;;
		@*) OPT_ACCOUNT="${1#@}"; shift; [ "${1:-}" = "--" ] && shift; launch "$@" ;;
		--) shift; launch "$@" ;;
		*) launch "$@" ;;
	esac
}

main "$@"
