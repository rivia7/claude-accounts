def tomli_fallback():
    """加载包内固定版本；模块与用户安装的 tomli 隔离，所有导入均来自标准库。"""
    import base64, types, zlib
    name = '_cca_tomli'
    if name in sys.modules:
        return sys.modules[name]
    sources = json.loads(zlib.decompress(base64.b64decode(TOMLI_EMBEDDED)))
    package = types.ModuleType(name)
    package.__path__ = []
    package.__package__ = name
    sys.modules[name] = package
    try:
        for filename in ('_types.py', '_re.py', '_parser.py', '__init__.py'):
            module_name = name if filename == '__init__.py' else name + '.' + filename[:-3]
            module = package if module_name == name else types.ModuleType(module_name)
            module.__package__ = name
            sys.modules[module_name] = module
            exec(compile(sources[filename], '<cca:tomli:2.3.0:' + filename + '>', 'exec'), module.__dict__)
    except Exception:
        for module_name in tuple(sys.modules):
            if module_name == name or module_name.startswith(name + '.'):
                del sys.modules[module_name]
        raise
    return package


def toml_loads(content):
    try:
        import tomllib
    except ImportError:
        tomllib = tomli_fallback()
    return tomllib.loads(content)


def read_toml_config(path):
    content = config_text(path)
    if content is None:
        return {}
    try:
        return toml_loads(content)
    except (ValueError, RecursionError):
        raise ConfigReadError('invalid_toml') from None


def codex_config_problems(data, source, overrides=False, allow_base_fallback=False):
    """只按解析后的键层级检查，不把带点号的字面键误认成嵌套表。"""
    if not isinstance(data, dict):
        return [source + ':invalid_config']
    bad = [source + ':' + key for key in CODEX_BAD_KEYS if key in data]
    if 'profile' in data and not codex_profile_name(data['profile']):
        bad.append(source + ':profile:invalid_profile')
    for key, want in CODEX_MUST_BE.items():
        if key in data and (overrides or data[key] != want):
            bad.append(source + ':' + key)
    for key, value in CODEX_MUST_NOT.items():
        if key in data and (overrides or data[key] == value):
            bad.append(source + ':' + key)
    features = data.get('features', {})
    if not isinstance(features, dict):
        bad.append(source + ':features:invalid_config')
    else:
        for key in ('respect_system_proxy', 'system_proxy_fallback'):
            if key in features and (not isinstance(features[key], bool) or
                                    (features[key] and (overrides or key == 'respect_system_proxy' or not allow_base_fallback))):
                bad.append(source + ':features.' + key)
    providers = data.get('model_providers', {})
    if not isinstance(providers, dict):
        bad.append(source + ':model_providers:invalid_config')
    elif 'openai' in providers:
        # 不允许替换内置官方 provider 的地址或认证配置。
        bad.append(source + ':model_providers.openai')
    profiles = data.get('profiles', {})
    if not isinstance(profiles, dict):
        bad.append(source + ':profiles:invalid_config')
    else:
        for name, profile in profiles.items():
            bad.extend(codex_config_problems(profile, source + ':profiles.' + name, overrides))
    return bad


def codex_config_file_problems(path, source=None, allow_base_fallback=False):
    source = source or path
    try:
        return codex_config_problems(read_toml_config(path), source, allow_base_fallback=allow_base_fallback)
    except (ConfigReadError, RecursionError):
        return [source + ':invalid_or_unreadable_config']


def codex_settings_problems():
    files, bad = ['config.toml'], []
    try:
        files += sorted(name for name in os.listdir(CODEX.master) if codex_profile_file(name))
    except FileNotFoundError:
        if os.path.lexists(CODEX.master):
            bad.append('~/.codex:unreadable_config')
    except OSError:
        bad.append('~/.codex:unreadable_config')
    for name in files:
        bad.extend(codex_config_file_problems(os.path.join(CODEX.master, name), name, allow_base_fallback=name == 'config.toml'))
    try:
        content = config_text(os.path.join(CODEX.master, '.env'))
        for line in (content or '').splitlines():
            match = re.match(r'^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=', line)
            if match and CODEX_ENV_BAD.match(match.group(1)) and match.group(1) != 'CODEX_CA_CERTIFICATE':
                bad.append('.env:' + match.group(1))
    except ConfigReadError:
        bad.append('.env:invalid_or_unreadable_config')
    return bad


AGY_SETTINGS_BAD = ('gcp', 'gcp.project', 'gcp.location')   # 企业版许可的 Google Cloud 项目：共享的设置里写了，所有账号都记到这个项目上


def agy_settings_keys(j, source):
    if not isinstance(j, dict):
        return [source + ':unreadable']
    return ['%s:%s' % (source, k) for k in AGY_SETTINGS_BAD if k in j]


def agy_settings_problems():
    """共享的 agy 设置（~/.gemini/antigravity-cli/settings.json）里会把各账号换到同一个 Google Cloud 项目上的设置"""
    path = os.path.join(AGY.master, 'antigravity-cli', 'settings.json')
    try:
        with open(path, encoding='utf-8') as f:
            j = json.load(f)
    except FileNotFoundError:
        return []
    except (OSError, ValueError, UnicodeError, RecursionError):
        return ['antigravity-cli/settings.json:unreadable']
    return agy_settings_keys(j, 'antigravity-cli/settings.json')


def agy_session_settings_problems(value, cwd):
    """agy --settings：一段 JSON 或者文件路径（只给这次会话的设置），查法和共享的设置一样"""
    try:
        if value.lstrip().startswith('{'):
            return agy_settings_keys(json.loads(value), '--settings')
        with open(os.path.abspath(os.path.join(cwd, os.path.expanduser(value))), encoding='utf-8') as f:
            return agy_settings_keys(json.load(f), '--settings')
    except (OSError, ValueError, UnicodeError, RecursionError):
        return ['--settings:unreadable_config']


def project_settings_problems(cwd):
    """只检查当前目录及祖先；不扫描项目的无关子目录或相邻项目。"""
    bad, current = [], os.path.realpath(cwd)
    while True:
        if T is CLAUDE:
            for name in ('settings.json', 'settings.local.json'):
                path = os.path.join(current, '.claude', name)
                if path != os.path.realpath(os.path.join(CLAUDE.master, name)):
                    bad.extend(claude_config_file_problems(path))
        elif T is AGY:
            return bad   # agy 项目里的 .agents/ 只有规则、技能、MCP 这些，没有会换账号、出口的设置
        else:
            path = os.path.join(current, '.codex', 'config.toml')
            if path != os.path.realpath(os.path.join(CODEX.master, 'config.toml')):
                bad.extend(codex_config_file_problems(path))
        parent = os.path.dirname(current)
        if parent == current:
            return bad
        current = parent


def launch_settings_problems(args):
    bad, cwd, settings = [], os.getcwd(), []
    original_cwd = cwd
    args = list(args)
    # 必填参数值可能恰好是 -- 或 --settings，必须先消费，才能认出真正的选项边界。
    claude_values = ('--agent', '--agents', '--append-system-prompt', '--autocompact', '--debug-file',
                     '--effort', '--environment', '--fallback-model', '--input-format', '--json-schema',
                     '--max-budget-usd', '--model', '-n', '--name', '--output-format', '--permission-mode',
                     '--permission-prompts', '--plugin-dir', '--plugin-url', '--remote-control-session-name-prefix',
                     '--session-id', '--setting-sources', '--settings', '--system-prompt', '--system-prompt-snapshot',
                     '--system-prompt-file', '--append-system-prompt-file', '--add-dir', '--allowedTools',
                     '--allowed-tools', '--betas', '--disallowedTools', '--disallowed-tools', '--file',
                     '--mcp-config', '--tools')
    agy_values = ('--add-dir', '--agent', '--conversation', '--effort', '--input-format', '--json-schema', '--log-file',
                  '--mode', '--model', '--output-format', '--print-timeout', '--project', '--settings', '-p', '--print',
                  '--prompt', '-i', '--prompt-interactive', '--gemini_dir', '--gemini-dir')
    codex_values = ('-c', '--config', '-p', '--profile', '-C', '--cd', '--enable', '--disable',
                    '-m', '--model', '-s', '--sandbox', '-a', '--ask-for-approval', '-i', '--image',
                    '--local-provider', '--remote-auth-token-env', '--remote', '--output-schema',
                    '-o', '--output-last-message')
    i, positional_seen = 0, False
    while i < len(args):
        arg, value = args[i], None
        i += 1
        if arg == '--':
            break
        option = arg.split('=', 1)[0]
        if T is CODEX and len(arg) > 2 and arg[:2] in ('-c', '-p', '-C'):
            option, value = arg[:2], arg[2:]
            if value.startswith('='):
                value = value[1:]
        elif '=' in arg:
            value = arg.split('=', 1)[1]
        takes_value = codex_values if T is CODEX else agy_values if T is AGY else claude_values
        if option in takes_value and value is None:
            if i == len(args):
                bad.append(option + ':missing_value')
                continue
            value, i = args[i], i + 1
        if T is CLAUDE:
            if option == '--settings':
                settings.append(value)
            elif option == '--desktop':
                bad.append('--desktop:use_cca_app')
            continue
        if T is AGY:
            if option in ('--gemini_dir', '--gemini-dir'):
                bad.append(option + ':account_override')   # 换掉数据目录就换掉了登录和设备标识
            elif option == '--settings' and value is not None:
                bad.extend(agy_session_settings_problems(value, cwd))
            continue
        if not arg.startswith('-'):
            if not positional_seen and arg == 'app':
                bad.append('app:use_cca_codex_app')
            positional_seen = True
        if option in ('--remote', '--remote-auth-token-env', '--oss', '--local-provider'):
            bad.append(option + ':account_override')
        elif option in ('-C', '--cd') and value is not None:
            # root/exec 各自的 --cd 可同时出现；后者覆盖前者，均相对初始目录解析。
            cwd = os.path.abspath(os.path.join(original_cwd, os.path.expanduser(value)))
        elif option in ('-p', '--profile') and value is not None:
            if not codex_profile_name(value):
                bad.append(option + ':invalid_profile')
        elif option == '--enable' and value in ('system_proxy_fallback', 'respect_system_proxy'):
            bad.append(option + ':' + value)
        elif option in ('-c', '--config') and value is not None:
            if '=' not in value:
                bad.append(option + ':invalid_config')
                continue
            key, raw = value.split('=', 1)
            try:
                # Codex 接受未引号的字符串值；只对值应用同样的回退，键仍交完整 TOML 解析器。
                try:
                    parsed = toml_loads(value)
                except ValueError:
                    parsed = toml_loads(key + ' = ' + json.dumps(raw))
                bad.extend(codex_config_problems(parsed, option, overrides=True))
            except (ValueError, RecursionError):
                bad.append(option + ':invalid_config')
    for value in settings:
        source = '--settings'
        if value.lstrip().startswith('{'):
            try:
                bad.extend(claude_config_problems(json.loads(value), source))
            except (ValueError, RecursionError):
                bad.append(source + ':invalid_config')
        else:
            path = os.path.abspath(os.path.join(cwd, os.path.expanduser(value)))
            if not os.path.exists(path):
                bad.append(source + ':unreadable_config')
            else:
                bad.extend(claude_config_file_problems(path))
    bad.extend(T.settings_problems())
    bad.extend(project_settings_problems(cwd))
    return bad


def cmd_launch_check(*args):
    settings_check_result(launch_settings_problems(args))


def cmd_codex_fallback_off():
    """桌面 App 只能依赖共享配置；无效或不可读不能等同于已关闭回退。"""
    try:
        data = read_toml_config(os.path.join(CODEX.master, 'config.toml'))
        features = data.get('features', {})
        disabled = (isinstance(features, dict) and features.get('system_proxy_fallback') is False
                    and not codex_settings_problems())
    except ConfigReadError:
        disabled = False
    sys.exit(0 if disabled else 1)


def coffee_parse(min_trust, trace, risk):
    """解析 claude.ai（Codex 账号是 chatgpt.com）的 trace 与 ip.net.coffee /api/iprisk 结果 → dict：
    rc（0 正常，1 纯净度偏低，2 受限地区，3 拿不到出口 IP，4 没有评分数据）、line（给人看的一行）、note（补充说明），
    以及 ip、country、org、trust、trust_label、tags、restricted_region"""
    kv = dict(l.split('=', 1) for l in (trace or '').splitlines() if '=' in l)
    ip, loc = kv.get('ip', ''), kv.get('loc', '').upper()
    r = {'rc': 3, 'ip': ip or None, 'country': loc or None, 'org': None, 'trust': None, 'trust_label': None, 'tags': [],
         'restricted_region': None, 'line': '', 'note': ''}
    if not ip:
        r['line'] = '拿不到 %s 看到的出口 IP（端口或节点不通）' % T.trace_host
        return r
    try:
        d = json.loads(risk) if risk else {}
    except ValueError:
        d = {}
    if not isinstance(d, dict):
        d = {}
    cc = (d.get('countryCode') or loc or '').upper()
    score = d.get('trust_score') if isinstance(d.get('trust_score'), (int, float)) else None
    tags = []
    if d.get('isResidential') is True:
        tags.append('住宅IP')
    elif d.get('is_datacenter') is True:
        tags.append('机房IP')
    for f, name in (('is_vpn', 'VPN'), ('is_proxy', '代理'), ('is_tor', 'Tor'), ('is_abuser', '有滥用记录')):
        if d.get(f) is True:
            tags.append(name)
    if cc in RESTRICTED:
        score = 0
    label = None
    if score is None:
        level = '纯净度 无数据'
    else:
        label = ('极度纯净' if score >= 95 else '纯净' if score >= 80 else '良好' if score >= 50
                 else '中性' if score >= 25 else '可疑')
        level = '纯净度 %s（%s）' % (score, label)
    org = d.get('asOrganization') or d.get('company_name') or ''
    r.update(country=cc or None, org=org if isinstance(org, str) and org else None, trust=score, trust_label=label, tags=tags, rc=0,
             line=' · '.join(x for x in [ip, cc or '?', org, level] + tags if x))
    if cc in RESTRICTED:
        r.update(rc=2, restricted_region=RESTRICTED[cc], note='出口在%s：%s 不可用地区，会被严格风控' % (RESTRICTED[cc], T.region_name))
    elif score is None:
        r.update(rc=4, note='ip.net.coffee 没有返回评分（检测服务可能暂时不可用）')
    elif score < int(min_trust):
        r.update(rc=1, note='纯净度低于设定的 %s' % min_trust)
    return r


def cmd_coffee(min_trust, trace, risk):
    """出口检测给 bash 用：第一行是 line，有补充说明再一行；退出码是 rc"""
    r = coffee_parse(min_trust, trace, risk)
    print(r['line'])
    if r['note']:
        print(r['note'])
    if r['rc']:
        sys.exit(r['rc'])


# --- DNS / WebRTC 泄露检测（照 ip.net.coffee 的 DNS、WebRTC 检测页的做法）：和出口检测同时在后台跑，不拖慢启动 ------------------
# DNS：经账号的端口访问两个一次性的子域名（<token>-n.d.ip.net.coffee），由账号出口那边去解析，ip.net.coffee 的权威 DNS 记下是哪些
# 解析器来查的（/api/dns/result/<token>）；有中国大陆的解析器、出口又不在中国大陆就是泄露。要几秒，结果按 线路|节点 缓存。
# WebRTC：用本机 UDP 探测 STUN，检查绕过账号代理的风险；不在浏览器里执行，不能据此断言浏览器是否泄露
LEAK_FILE = os.path.join(CCA_HOME, 'leak.json')   # 缓存：DNS 的结果（按 线路|节点）、IP 归属地
LEAK_DNS_TTL = 6 * 3600   # DNS 怎么解析取决于节点和路由器的设置，不常变
LEAK_FAIL_TTL = 600       # 没测成的过 10 分钟再测
LEAK_GEO_TTL = 7 * 86400
LEAK_DEADLINE = 5         # 后台检测最多这么多秒（和出口检测同时跑）
LEAK_CHECK_DEADLINE = 20  # cca check（用户就在等检测结果）：慢的线路上一次 HTTPS 往返要三四秒（2026-11-11 一台 Linux 服务器上实测），
                          # 5 秒里问不到解析器，DNS 永远没测成。测成的缓存 6 小时，之后启动时也用得上
STUN_SERVERS = (('stun.cloudflare.com', 3478), ('stun.l.google.com', 19302))   # 和检测页用的一样
COFFEE = 'https://ip.net.coffee'
IP_TEXT = lazy_re(r'^[0-9A-Fa-f:.]{2,45}$')


def leak_curl(url, proxy='', timeout=4.0):
    """经 curl 取网址（测试里的假 curl 照样管得到）：proxy 是账号的端口，空的是直连。拿不到返回 None"""
    import subprocess
    timeout = max(float(timeout), 0.5)
    try:
        r = subprocess.run(['curl', '-q', '-s', '-m', '%.1f' % timeout] +
                           (['--noproxy', '', '-x', proxy] if proxy else ['--noproxy', '*']) + [url],
                           stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=timeout + 2)
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout.decode('utf-8', 'replace') if r.returncode == 0 else None


def leak_json(text):
    try:
        return json.loads(text) if text else None
    except ValueError:
        return None


def leak_cache():
    j = load_quiet(LEAK_FILE)
    return j if isinstance(j, dict) else {}


def ip_prefix(ip):
    """归属地按网段记：IPv4 的 /24、IPv6 的 /48（公共 DNS 的解析器常在几个网段里换着来，按 IP 记几乎每次都对不上）"""
    if ':' in ip:
        import ipaddress
        try:
            return str(ipaddress.ip_network(ip + '/48', strict=False))
        except ValueError:
            return ip
    p = ip.split('.')
    return '.'.join(p[:3]) + '.0/24' if len(p) == 4 else ip


def leak_geo(ips, proxy, known, timeout=0):
    """这些 IP 所在网段的归属地 {网段: {t, cc, country, isp}}：known 里有的不再查，别的每个网段挑一个 IP 同时查 ip.net.coffee 的 /api/geoip。
    timeout 不给时经代理 4 秒、直连 2 秒"""
    import threading
    want = {}
    for ip in ips:
        if IP_TEXT.match(ip):
            want.setdefault(ip_prefix(ip), ip)
    out = {k: known[k] for k in want if k in known}

    def one(k, ip):
        j = leak_json(leak_curl('%s/api/geoip/%s' % (COFFEE, ip), proxy, timeout or (4 if proxy else 2)))
        if isinstance(j, dict):
            out[k] = {'t': time.time(), 'cc': str(j.get('country_code') or '').lower(),
                      'country': str(j.get('country') or ''), 'isp': str(j.get('isp') or '')}
        else:   # 查不到也记下（一小时）：ip.net.coffee 连不上时别每次启动都等它
            out[k] = {'t': time.time(), 'cc': '', 'country': '', 'isp': '', 'miss': True}
    ts = [threading.Thread(target=one, args=(k, ip)) for k, ip in want.items() if k not in out]
    for t in ts:
        t.start()
    for t in ts:
        t.join()
    return out


def geo_fresh(g, now):
    return isinstance(g, dict) and now - g.get('t', 0) < (3600 if g.get('miss') else LEAK_GEO_TTL)


def leak_where(g):
    """归属地写成一句：国家 · ISP"""
    return ' · '.join(x for x in ((g or {}).get('country'), (g or {}).get('isp')) if x)


def stun_parse(data, tid):
    """STUN Binding 成功响应里的地址：XOR-MAPPED-ADDRESS 优先，旧服务器的 MAPPED-ADDRESS 也认"""
    import socket, struct
    if len(data) < 20 or data[8:20] != tid or struct.unpack('!HHI', data[:8])[::2] != (0x0101, 0x2112A442):
        return ''
    got, i, end = {}, 20, min(len(data), 20 + struct.unpack('!H', data[2:4])[0])
    while i + 4 <= end:
        kind, size = struct.unpack('!HH', data[i:i + 4])
        v = data[i + 4:i + 4 + size]
        if kind in (0x0001, 0x0020, 0x8020) and len(v) >= 8 and v[1] in (1, 2):
            n = 4 if v[1] == 1 else 16
            a = v[4:4 + n]
            if len(a) == n:
                if kind != 0x0001:   # 和魔数（IPv6 还要加上事务号）异或过
                    a = bytes(x ^ y for x, y in zip(a, data[4:8] + tid))
                got[kind] = socket.inet_ntop(socket.AF_INET if n == 4 else socket.AF_INET6, a)
        i += 4 + size + (-size % 4)
    return got.get(0x0020) or got.get(0x8020) or got.get(0x0001) or ''


def stun_probe(host, port, family, timeout):
    """本机直连发 STUN Binding 请求；错误、超时、没有这种地址都返回空，不能当成确认没有泄露"""
    import socket, struct
    try:
        af, _, _, _, addr = socket.getaddrinfo(host, port, family, socket.SOCK_DGRAM)[0]
    except (OSError, IndexError):
        return ''
    if af == socket.AF_INET6 and addr[0].lower().startswith('::ffff:'):
        return ''
    tid = os.urandom(12)
    s = socket.socket(af, socket.SOCK_DGRAM)
    try:   # connect 过的 UDP 套接字：端口不通时马上报错，不用干等
        s.settimeout(timeout)
        s.connect(addr)
        s.send(struct.pack('!HHI', 1, 0, 0x2112A442) + tid)
        end = time.time() + timeout
        while time.time() < end:
            s.settimeout(max(end - time.time(), 0.01))
            ip = stun_parse(s.recv(2048), tid)
            if ip:
                return ip
    except OSError:
        pass
    finally:
        s.close()
    return ''


def stun_ips(timeout=1.0):
    """本机 UDP 的出口（非浏览器实测）：同时问几个 STUN 服务器，IPv4、IPv6 都试；空结果表示没测成。CCA_STUN 换服务器（测试用）"""
    import socket, threading
    env = os.environ.get('CCA_STUN', '')
    servers = [(h, int(p)) for h, p in (x.rsplit(':', 1) for x in env.split(',') if re.match(r'^[^:,]+:\d+$', x))] if env else STUN_SERVERS
    got = []
    ts = [threading.Thread(target=lambda h=h, p=p, f=f: got.append(stun_probe(h, p, f, timeout)), daemon=True)
          for h, p in servers for f in (socket.AF_INET, socket.AF_INET6)]
    for t in ts:
        t.start()
    end = time.time() + timeout + 0.5   # STUN 服务器的域名解析卡住时也不等（getaddrinfo 自己没有超时）
    for t in ts:
        t.join(max(end - time.time(), 0))
    return sorted({ip for ip in list(got) if ip})


def leak_dns(proxy, deadline, patient=False):
    """经账号的端口解析两个一次性的子域名，再问 ip.net.coffee 是哪些解析器来查的：{ok, servers}。
    要的只是那边的解析器来查过：不等图片请求做完（HTTPS 往返要一两秒），最多一秒就开始问。patient（cca check）：每个请求多等一会儿"""
    import uuid
    import threading
    tok = uuid.uuid4().hex[:20]
    ts = [threading.Thread(target=leak_curl, daemon=True, args=('https://%s-%d.d.ip.net.coffee/pixel.gif' % (tok, i), proxy,
                                                                min(6 if patient else 2.5, deadline - time.time()))) for i in (1, 2)]
    for t in ts:
        t.start()
    end = min(time.time() + 1.0, deadline)
    for t in ts:
        t.join(max(end - time.time(), 0))
    ok, servers = False, []
    for n in range(4):   # 一般第一次就有；没有时稍等再问
        if deadline - time.time() < 0.5:
            break
        j = leak_json(leak_curl('%s/api/dns/result/%s' % (COFFEE, tok), proxy, min(8 if patient else 3, deadline - time.time())))
        if isinstance(j, dict) and isinstance(j.get('dns_servers'), list):
            servers = [s for s in j['dns_servers'] if isinstance(s, str) and IP_TEXT.match(s)]
            ok = bool(servers)
            if servers:
                break
        if n < 3:
            time.sleep(min(0.5, max(deadline - time.time() - 0.5, 0)))
    return {'ok': ok, 'servers': list(dict.fromkeys(servers))[:16]}


def leak_dns_fresh(d, since=0.0):
    """缓存的 DNS 结果还能用：没测成的 10 分钟、测成的 6 小时；since（cca check 开始的时间）之前测的不算"""
    if not isinstance(d, dict) or not isinstance(d.get('t'), (int, float)) or d['t'] < since:
        return False
    return time.time() - d['t'] < (LEAK_DNS_TTL if d.get('ok') else LEAK_FAIL_TTL)


def cmd_leak_probe(proxy, key, since='', webrtc='1'):
    """后台跑（和出口检测同时）：本机 STUN 直连检查潜在的 WebRTC 绕行风险；DNS 缓存不能用时经账号端口测一次。
    结果（JSON）打到 stdout，由 leak-verdict 汇总、写缓存。config.json 的 leak_check 设成 false 时什么都不测。
    webrtc 是 0 时不测 WebRTC（服务器上没有账号专属的浏览器和桌面 App）：结果里写明 webrtc: off，leak-verdict 不说它
    （只是没有 stun 的结果照旧算没测成：探测没做完、文件坏了都不能当作没问题）"""
    import threading
    c = load_quiet(CFG)
    if isinstance(c, dict) and c.get('leak_check') is False:
        print(json.dumps({'off': True}))
        return
    cache = leak_cache()
    patient = bool(since)   # cca check：给了开始时间
    deadline, res = time.time() + (LEAK_CHECK_DEADLINE if patient else LEAK_DEADLINE), {'stun': {'ips': []}} if webrtc != '0' else {'webrtc': 'off'}
    known = {k: g for k, g in (cache.get('geo') or {}).items() if geo_fresh(g, time.time())}

    def dns():
        r = leak_dns(proxy, deadline, patient)
        r['geo'] = leak_geo(r['servers'], proxy, known, 8 if patient else 0)
        res['dns'] = r

    def stun():
        res['stun'] = {'ips': stun_ips()}
    jobs = ([stun] if 'stun' in res else []) + ([] if leak_dns_fresh((cache.get('dns') or {}).get(key), float(since or 0)) else [dns])
    ts = [threading.Thread(target=j, daemon=True) for j in jobs]
    for t in ts:
        t.start()
    for t in ts:   # 到时间还没做完的不要了；汇总时没有结果按未验证处理
        t.join(max(deadline + 1 - time.time(), 0))
    print(json.dumps(dict(res)))


def cmd_leak_verdict(path, key, exit_ip, exit_cc, detail=''):
    """汇总 leak-probe 的结果（exit_ip / exit_cc 是这次出口检测拿到的）：第一行是给横幅的一句话，每个泄露再一行
    W<TAB>dns|webrtc<TAB>说明，只作提醒的一行 N<TAB>webrtc<TAB>说明，最后是机器看的状态 S<TAB>dns|webrtc<TAB>ok|leak|note|failed（出口检测结果里记下，见 health-save；
    leak_finish 只认 W、N、S 行）；把新结果写进缓存。detail（cca check）时一句话里多写点。本机 STUN IP 直连查归属地：
    别让账号的出口和它一起出现在别人那里"""
    p = load_quiet(path)
    if not isinstance(p, dict) or p.get('off'):
        return
    now, cache = time.time(), leak_cache()
    geo = {k: g for k, g in (cache.get('geo') or {}).items() if geo_fresh(g, now)}
    dns = {k: v for k, v in (cache.get('dns') or {}).items() if leak_dns_fresh(v)}
    if isinstance(p.get('dns'), dict):
        geo.update(p['dns'].get('geo') or {})
        dns[key] = {'t': now, 'ok': bool(p['dns'].get('ok')), 'servers': [s for s in p['dns'].get('servers') or [] if isinstance(s, str)]}
    rtc = p.get('webrtc') != 'off'   # 服务器上没测 WebRTC：不说它（没有 stun 的结果照旧算没测成）
    st = p.get('stun') if isinstance(p.get('stun'), dict) else {}
    ips = [ip for ip in st.get('ips') or [] if isinstance(ip, str)]
    leaked = [ip for ip in ips if ip != exit_ip]
    geo.update(leak_geo(leaked, '', geo))
    parts, warns, notes, state, d = [], [], [], {}, dns.get(key)
    if isinstance(d, dict):
        sv = d.get('servers') or []
        cn = [s for s in sv if (geo.get(ip_prefix(s)) or {}).get('cc') == 'cn']
        unknown = [s for s in sv if not re.fullmatch('[a-z]{2}', (geo.get(ip_prefix(s)) or {}).get('cc') or '')]
        if d.get('ok') and cn and exit_cc and exit_cc.upper() != 'CN':
            state['dns'] = 'leak'
            parts.append('DNS 泄露（%d 个解析器在中国大陆）' % len(cn))
            warns.append(('dns', 'DNS 泄露：经这个账号的端口访问网站时，域名是中国大陆的 DNS 服务器解析的（%s），网站的 DNS 服务'
                          '能看出查询来自中国大陆。检查路由器（在外面是本机 Clash）上的节点 %s：mihomo 把域名在本地解析好再交给节点时'
                          '（比如直连、WireGuard 这类节点），用的是它自己的 DNS' % ('、'.join(('%s %s' % (s, leak_where(geo.get(ip_prefix(s))))).strip()
                                                                       for s in cn[:3]), key.split('|', 1)[-1])))
        elif not d.get('ok') or not sv or unknown or not exit_cc:
            state['dns'] = 'failed'
            d['ok'] = False   # 未验证的旧缓存也只保留失败结果的短 TTL
            reason = '解析器归属地不完整' if sv and unknown else '未取得解析器' if not sv else '探测未完成'
            parts.append('DNS 没测成（%s）' % reason)
        else:
            state['dns'] = 'ok'
            cs = list(dict.fromkeys((geo.get(ip_prefix(s)) or {}).get('country') or '?' for s in sv))
            parts.append('DNS 未发现地区异常' + ('（%d 个解析器：%s%s；非浏览器实测）' %
                         (len(sv), '、'.join(cs[:3]), '等' if len(cs) > 3 else '') if detail else ''))
    else:
        state['dns'] = 'failed'
        parts.append('DNS 没测成（探测未完成）')
    if leaked:
        def cc_of(ip):
            return (geo.get(ip_prefix(ip)) or {}).get('cc') or ''
        cn = [ip for ip in leaked if cc_of(ip) == 'cn']
        shown = (cn or leaked)[0]
        w = leak_where(geo.get(ip_prefix(shown)))
        at = '%s（%s）' % (shown, w) if w else shown
        if cn:   # 只有中国大陆的地址才算风险
            state['webrtc'] = 'leak'
            parts.append('WebRTC 直连风险：%s' % at)
            warns.append(('webrtc', 'WebRTC 直连风险：本机 UDP 的 STUN 探测看到中国大陆的地址 %s，与账号的出口不同。这是本机网络探测，'
                          '尚未验证浏览器或 %s 是否会暴露该 IP；应在实际客户端验证 WebRTC 路由，并限制绕过账号代理的 UDP 流量' % (at, T.app_label)))
        elif all(re.fullmatch('[a-z]{2}', cc_of(ip)) for ip in leaked):   # 别的地区只作提醒
            state['webrtc'] = 'note'
            parts.append('WebRTC 备注：STUN 看到 %s，与账号的出口不同' % at)
            notes.append(('webrtc', '本机 STUN 探测看到 %s，与账号的出口不同，但不是中国大陆的地址，只作提醒。'
                          '尚未验证浏览器或 %s 是否会暴露该 IP' % (at, T.app_label)))
        else:   # 归属地查不到：说不清是不是中国大陆，也不能当作没问题
            state['webrtc'] = 'failed'
            parts.append('WebRTC 没测成（STUN 看到 %s，归属地没查到，浏览器状态未验证）' % shown)
            notes.append(('webrtc', '本机 UDP 的 STUN 探测看到 %s，与账号的出口不同，但归属地没查到，判断不了是不是中国大陆的地址' % shown))
    elif ips:
        state['webrtc'] = 'ok'
        parts.append('WebRTC：STUN 出口一致（浏览器状态未验证）')
    elif rtc:
        state['webrtc'] = 'failed'
        parts.append('WebRTC 没测成（STUN 探测未取得 IP，浏览器状态未验证）')
    keep = sorted(geo.items(), key=lambda x: -x[1].get('t', 0))[:300]
    cache.update({'dns': dns, 'geo': dict(keep)})
    try:
        save_json(LEAK_FILE, cache, 0o600)
    except OSError:
        pass
    if parts:   # 有横幅那一句才输出（它总在第一行）
        print(' · '.join(parts))
        for kind, msg in warns:
            print('W\t%s\t%s' % (kind, msg))
        for kind, msg in notes:
            print('N\t%s\t%s' % (kind, msg))
        for kind, v in state.items():
            print('S\t%s\t%s' % (kind, v))


