def cli_marks(key):
    """账号目录里登记的命令行会话（只读）；格式、工具、账号目录名、进程号和文件名对不上的不算"""
    d, aid, out = adir(key), acct_id(key), []
    try:
        names = sorted(os.listdir(d))
    except OSError:
        return out
    for n in names:
        m = CLI_MARK.match(n)
        j = load_quiet(os.path.join(d, n)) if m else None
        if (isinstance(j, dict) and j.get('v') == 1 and j.get('tool') == T.name and j.get('id') == aid
                and j.get('pid') == int(m.group(1)) and type(j.get('started')) is int
                and isinstance(j.get('since'), (int, float))):
            out.append(j)
    return out


def cli_alive(pid, started, starts):
    s = starts.get(pid)
    return s is not None and abs(s - started) <= 1   # lstart 只到秒


def cli_view(marks, starts):
    """_gui state 里账号的 cli：还在运行的会话有几个、最早那个从什么时候开始"""
    live = [m for m in marks if cli_alive(m['pid'], m['started'], starts)]
    return {'running': bool(live), 'sessions': len(live), 'since_epoch': min((m['since'] for m in live), default=None)}


def cmd_session_open(key, pid):
    """run_account 启动工具之前登记这次命令行会话：图形界面看到账号目录里的 cli-<进程号>.json 就知道这个账号在工作。
    顺手清掉这个账号对不上的旧登记（cca 被 kill -9、断电留下的；_gui state 只读，不删）。问不到 cca 自己的启动时间就
    不登记：宁可不显示，也不留核对不了的登记"""
    pid, d, old = int(pid), adir(key), {}
    try:
        for n in os.listdir(d):
            m = CLI_MARK.match(n)
            if m:
                old[int(m.group(1))] = os.path.join(d, n)
    except OSError:
        return
    starts = proc_starts(set(old) | {pid})
    if pid not in starts:
        return
    for p, path in old.items():
        j = load_quiet(path)
        if p == pid or not (isinstance(j, dict) and type(j.get('started')) is int and cli_alive(p, j['started'], starts)):
            try:
                os.unlink(path)
            except OSError:
                pass
    save_json(os.path.join(d, 'cli-%d.json' % pid),
              {'v': 1, 'tool': T.name, 'id': acct_id(key), 'pid': pid, 'started': starts[pid], 'since': time.time()}, 0o600)
    presence_wake(key)   # 映射里的账号：报告给维护者的服务器（上报进程在后台，不拖慢启动）


