            kc_del(aid, ref)
            if ref and scope != 'all':
                sys.stderr.write('已从%s删掉 %s 记下的 API key%s：账号表里已经没有这个账号了\n' % (keystore_name(), aid, '（%s）' % hint if hint else ''))


def cmd_key_show(key):
    """把这个账号的 key 原样打到 stdout（不换行；cca [codex] key 账号 --show，App 的「显示」「复制」经管道读它）：
    第三方 API 账号和启动时取的一样（账号表的 key 字段优先，再是钥匙串里这个服务商的）；官方账号是记下备查的。
    没有：退出码 3（钥匙串里的被删了时顺便把记录也删掉）；钥匙串读不了（锁着、超时）：退出码 4"""
    t = table_load()
    need(t, key)
    v, aid = t[key], acct_id(key)
    if is_api(v) and secret_ok(v.get('key')):
        sys.stdout.write(v['key'])
