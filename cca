def cmd_login_page_acct(who, node='', fid='', alias=''):
    """cca login-page（Mac 上）：服务器上的账号在这台 Mac 上是哪个、走的是不是同一个节点。节点按摘要（类型 + 服务器 + 端口 +
    TLS 域名）认，叫法可以不同；服务器没给摘要（旧版本），或者这边认不出这个节点的地址时按名字。输出给 bash eval：LP_KEY 是
    这台 Mac 上的账号；还没有这个账号时 LP_KEY 是空的，LP_NODE / LP_ALIAS 是加上它用的节点和别名（别名用不了就不要）。
    对不上就说清楚、退出 1"""
    c, t, _ = ctx()
    email = who.strip().lower()
    if fid and not NODE_ID_RE.match(fid):
        die('--node-id 不对：要用服务器上的 cca 给出的那一整行')
    if EMAIL_RE.match(email):   # 服务器给的是邮箱：只认这个邮箱（不按前缀猜）
        key = next((k for k in t if parse_key(k)[1].lower() == email), '')
    else:
        key = account_named(t, who)

    def same(n):   # 这台 Mac 上的节点 n 和服务器上的是不是同一个
        f = node_fp_here(c, n)
        return f == fid if fid and f else n == node
    if key:
        v = t[key]
        if is_api(v):
            die('%s 是第三方 API 账号，不用登录' % label_of(key))
        if node and not same(node_of(v)):
            die('%s 在服务器上走 %s，在这台 Mac 上走 %s：不是同一个节点，已停止（登录页和服务器换 token 要经同一个出口）。'
                '先把两边改成同一个节点' % (label_of(key), node, node_of(v)))
        sh(LP_KEY=key, LP_NODE=node_of(v), LP_ALIAS='')
        return
    if not node:
        die('这台 Mac 上没有 %s 这个账号：先用 %s add 加上它，再运行这一行' % (who, T.cmd))
    want = policy_map(T).get(email)
    hit = [n for n in ([want] if want else c['nodes']) if same(n)]
    n = node if node in hit else (hit[0] if hit else '')
    if want and not n:
        die('维护者的映射要 %s 走 %s，和服务器上的 %s 不是同一个节点：两边的映射可能不是同一版，先在两边各运行一次 cca policy pull'
            % (email, want, node))
    if not n or n not in c['nodes']:
        die('这台 Mac 的可选节点里没有服务器上的 %s（按地址也认不出）：先运行 cca router setup 把它加进可选节点，'
            '或者在服务器上给 %s 换一个两边都有的节点' % (want or node, email))
    a = alias.strip()
    sh(LP_KEY='', LP_NODE=n, LP_ALIAS='' if not a or alias_problem(t, a) else a)


def cmd_login_forward(urlfile):
    """服务器上：把贴回来的验证码转给本机正在等的登录回调。stdin 是用户贴的：Mac 上 cca login-page 给的 code#state，或者浏览器
    跳回 localhost 时地址栏里的整个网址。state 和这次的登录网址对不上就不转（Claude Code 收到对不上的 state 整个登录就失败了）。
    直接连本机的回调：不经代理，也不跟随跳转（Claude Code 回的是跳到成功页的 302，跟过去就直连了外网）。Codex 换好 token
    才回答，所以多等一会儿。退出码：0 转过去了；2 贴的不对（没转，可以重新贴）；1 转不过去，原因打到 stderr"""
    import http.client
    from urllib.parse import urlsplit, parse_qsl, quote
    try:
        with open(urlfile, encoding='utf-8') as f:
            tgt = login_target(f.read().strip())
    except OSError:
        tgt = None
    if not tgt:
        die('这次的登录网址不对，没法转交验证码')
    host, port, path, state = tgt
    text = sys.stdin.read().strip()
    code = got = err = None
    if re.match(r'^https?://', text):
        try:
            q = dict(parse_qsl(urlsplit(text).query, keep_blank_values=True))
        except ValueError:
            q = {}
        code, got, err = q.get('code'), q.get('state'), q.get('error')
    elif '#' in text:
        code, _, got = text.partition('#')
    if err and got == state:
        die('登录页说没有登录成功：%s' % re.sub(r'[^\x20-\x7e]', '?', (q.get('error_description') or err))[:200])
    if not code or not got or not LOGIN_CODE_RE.match(code) or not LOGIN_CODE_RE.match(got):
        sys.stderr.write('认不出验证码：粘贴 Mac 上 cca login-page 给的那一行（形如 xxxx#yyyy），或者浏览器跳回 localhost 时地址栏里的整个网址\n')
        sys.exit(2)
    if got != state:
        sys.stderr.write('这个验证码不是这一次登录的（state 对不上）：在 Mac 上运行上面这一次给出的命令，重新登录一遍\n')
        sys.exit(2)
    c = http.client.HTTPConnection(host, port, timeout=120)
    try:
        c.request('GET', '%s?code=%s&state=%s' % (path, quote(code, safe=''), quote(got, safe='')))
        r = c.getresponse()
        st = r.status
        r.read(65536)
    except (OSError, http.client.HTTPException) as e:
        die('连不上这台机器上等着的登录（%s:%d），它可能已经退出了：%s' % (host, port, e))
    finally:
        c.close()
    if st >= 400:
        die('登录没收下这个验证码（HTTP %d）' % st)


LOGIN_PAGE = '''<!doctype html><html lang=zh-CN><meta charset=utf-8><title>cca：%(title)s</title>
<style>body{font:15px/1.6 -apple-system,BlinkMacSystemFont,sans-serif;max-width:40em;margin:4em auto;padding:0 1.2em;color:#222}
pre{white-space:pre-wrap;word-break:break-all;background:#f2f2f2;padding:.7em .9em;border-radius:6px;font-size:13px}
@media (prefers-color-scheme:dark){body{background:#1e1e1e;color:#ddd}pre{background:#2c2c2c}}</style>
<h2>%(title)s</h2>%(body)s'''


def login_catch_reply(conn, status, title, body):
    import html
    page = (LOGIN_PAGE % {'title': html.escape(title), 'body': body}).encode('utf-8')
    head = 'HTTP/1.1 %s\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: %d\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n' % (status, len(page))
    try:
        conn.sendall(head.encode('ascii') + page)
    except OSError:
        pass


def login_catch_one(conn, path, state):
    """读一个请求：是这次登录的回调（路径、state 都对）时返回 (code, error)，别的请求（favicon、对不上的）回 404 / 400、返回 None"""
    from urllib.parse import urlsplit, parse_qsl
    conn.settimeout(10)
    data = b''
    try:
        while b'\r\n\r\n' not in data and len(data) < 16384:
            b = conn.recv(4096)
            if not b:
                break
            data += b
    except OSError:
        return None
    line = data.split(b'\r\n', 1)[0].decode('latin-1').split(' ')
    if len(line) < 2 or line[0] != 'GET':
        return None
    try:
        u = urlsplit(line[1])
        q = dict(parse_qsl(u.query, keep_blank_values=True))
    except ValueError:
        q, u = {}, None
    if u is None or u.path != path:
        login_catch_reply(conn, '404 Not Found', '找不到', '')
        return None
    if q.get('state') != state:
        login_catch_reply(conn, '400 Bad Request', '不是这一次的登录', '<p>这一页不是这一次登录跳回来的。回到终端看看 cca login-page 有没有在运行。</p>')
        return None
    if q.get('error') or not q.get('code'):
        return None, re.sub(r'[^\x20-\x7e]', '?', q.get('error_description') or q.get('error') or 'no code')[:200]
    return q['code'], None


def cmd_login_catch(url, timeout='900'):
    """cca login-page（Mac 上）：先占住登录网址里回调的端口（127.0.0.1，能占的话还有 ::1），再回调 cca _browser 在账号专属的
    Chrome 里打开登录页（走账号的出口；回调地址是本机，Chrome 不经代理），等浏览器带着 code、state 跳回来：放进剪贴板，给浏览器
    一页说明，把 code#state 打到 stdout。退出码：0 拿到了、复制好了；3 拿到了、没复制成；4 端口被别的程序占着（照样打开了登录页，
    stdout 是端口，bash 说登录后从地址栏复制整个网址贴回服务器）；1 没拿到，原因打到 stderr"""
    import html, select, socket, subprocess
    tgt = login_target(url)
    if not tgt:
        die('这不是 %s 的登录网址' % T.label)
    _, port, path, state = tgt
    socks = []
    for fam, addr in ((socket.AF_INET, '127.0.0.1'), (socket.AF_INET6, '::1')):
        try:
            s = socket.socket(fam, socket.SOCK_STREAM)
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            if fam == socket.AF_INET6:
                s.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)
            s.bind((addr, port))
            s.listen(8)
            socks.append(s)
        except OSError:
            if fam == socket.AF_INET:
                break
    if subprocess.run([SELF_PATH, '_browser', url], stdin=subprocess.DEVNULL).returncode != 0:
        die('没能在账号的浏览器里打开登录页')
    if not socks:   # bash 照这个端口说怎么办
        print(port)
        sys.exit(4)
    end = time.time() + float(timeout)
    got = None
    try:
        while got is None:
            left = end - time.time()
            if left <= 0:
                die('等了 %d 分钟还没登录完：要登录的话在服务器上重新开始' % (int(float(timeout)) // 60))
            ready = select.select(socks, [], [], min(left, 5))[0]
            for s in ready:
                try:
                    conn = s.accept()[0]
                except OSError:
                    continue
                try:
                    got = login_catch_one(conn, path, state)
                    if got is None:
                        continue
                    code, err = got
                    if err:
                        login_catch_reply(conn, '200 OK', '没有登录成功', '<p>登录页说：<code>%s</code></p><p>回到服务器的终端直接回车取消，再重新登录一遍。</p>' % html.escape(err))
                        die('登录页说没有登录成功：%s' % err)
                    text = '%s#%s' % (code, state)
                    try:
                        copied = subprocess.run(['pbcopy'], input=text.encode('ascii'), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10).returncode == 0
                    except (OSError, subprocess.SubprocessError):
                        copied = False
                    login_catch_reply(conn, '200 OK', '这边登录好了，还差一步',
                                      '<p>%s回到服务器的终端，粘贴、回车，服务器上就登录好了。之后可以关掉这一页。</p><pre>%s</pre>'
                                      % ('验证码已经复制到剪贴板（就是下面这一行）：' if copied else '复制下面这一行验证码，', html.escape(text)))
                    print(text)
                    sys.exit(0 if copied else 3)
                finally:
                    conn.close()
    except KeyboardInterrupt:
        die('已取消')
    finally:
        for s in socks:
            s.close()


