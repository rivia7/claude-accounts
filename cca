def email_of(key):
    j = load_json(os.path.join(cdir(key), '.claude.json'), {}) or {}
    return (j.get('oauthAccount') or {}).get('emailAddress') or ''


POOL_STEP = 8   # 路由器上的端口池按 8 个槽位一档；槽位够用时增删账号、换节点都不用重载 OpenClash


def pool_size(c, t):
    slots = [c['ports'][k] - FIRST_PORT + 1 for k in t]
    return max(POOL_STEP, -(-max(slots) // POOL_STEP) * POOL_STEP) if slots else 0


def slot_nodes(c, t):
    """每个槽位应选中的节点：分给账号的用账号的节点，空槽位用 REJECT"""
    m = {c['ports'][k] - FIRST_PORT + 1: n for k, n in t.items()}
    return [m.get(s, 'REJECT') for s in range(1, pool_size(c, t) + 1)]


def char_w(ch):
    return 2 if unicodedata.east_asian_width(ch) in 'WF' else 1


def dw(s):
    return sum(char_w(ch) for ch in s)


def fit(s, w, pad=True):
    """按终端显示宽度截断/补齐（中文、全角字符算 2 格）；超长时以 … 结尾"""
    total = sum(char_w(ch) for ch in s)
    if total <= w:
        return s + (' ' * (w - total) if pad else '')
    out, n = '', 0
    for ch in s:
        if n + char_w(ch) > w - 1:
            break
        out += ch
        n += char_w(ch)
    return out + '…' + (' ' * (w - n - 1) if pad else '')


def short_state(key):
    e = email_of(key)
    if not e:
        return '未登录'
    want = parse_key(key)[1]
    return '邮箱不符' if want and e.lower() != want.lower() else '已登录'


def cmd_rows(cols='80'):
    """菜单里每个账号一行：别名、邮箱、登录状态、出口节点，按显示宽度对齐（没有别名的账号别名列留空）"""
    c, t, _ = ctx()
    if not t:
        return
    width = max(int(cols) if str(cols).isdigit() else 80, 40) - 6
    parts = {k: parse_key(k) for k in t}
    aw = min(max(dw(a) for a, _ in parts.values()), 16)
    ew = min(max(dw(e) for _, e in parts.values()), 32)
    for k, node in t.items():
        a, e = parts[k]
        cells = ([fit(a, aw)] if aw else []) + ([fit(e, ew)] if ew else []) + [fit(short_state(k), 8), node]
        line = '   '.join(cells)
        if k == c.get('last'):
            line += '   · 上次使用'
        print(fit(line, width, pad=False))


def cmd_node_rows(onrouter='', cols='80'):
    """选节点菜单：每个可选节点一行，注明已被哪些账号使用、路由器上是否存在"""
    c, t, _ = ctx()
    have = set(onrouter.split('\n')) if onrouter else None
    width = max(int(cols) if str(cols).isdigit() else 80, 40) - 6
    nw = max([dw(n) for n in c['nodes']] + [8])
    for n in c['nodes']:
        notes = []
        users = [name_of(k) for k, v in t.items() if v == n]
        if users:
            notes.append('已被 %s 使用' % '、'.join(users))
        if have is not None and n not in have:
            notes.append('路由器上没有这个节点')
        print(fit('%s   %s' % (fit(n, nw), '；'.join(notes)), width, pad=False).rstrip())


def cmd_node_default():
