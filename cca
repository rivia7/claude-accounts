# /usr/bin/python3 是命令行工具的转发程序：每次先找开发者目录，每次调用多花约 50 毫秒。换成它转发到的真正的 python3
# （问一次，记在上面的缓存目录里；目录不是自己的、是链接就不用）。没装命令行工具时它一运行就弹安装窗口：先问 xcode-select，
# 没装就不问（照常用 /usr/bin/python3，need_deps 会说清楚要装什么）
if [ "$PYTHON" = /usr/bin/python3 ] && [ -n "$PYC_DIR" ]; then
	{ [ -d "$PYC_DIR" ] || mkdir -m 700 "$PYC_DIR"; } 2>/dev/null
	if [ -d "$PYC_DIR" ] && [ ! -L "$PYC_DIR" ] && [ -O "$PYC_DIR" ]; then
		_p=""; { read -r _p < "$PYC_DIR/python3"; } 2>/dev/null
		if [ -z "$_p" ] || [ ! -x "$_p" ]; then
			_p=""
			xcode-select -p >/dev/null 2>&1 && _p=$(/usr/bin/python3 -I -c 'import sys; print(sys.executable)' 2>/dev/null)
			[ -x "$_p" ] && printf '%s\n' "$_p" > "$PYC_DIR/python3"
		fi
		[ -x "$_p" ] && PYTHON="$_p"
		unset _p
	fi
fi
