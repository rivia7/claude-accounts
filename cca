def usage_notes(rl, now):
    """表格的备注：Codex 还能重置几次额度，分模型的每周额度、额外用量，Codex 的 credits"""
    out, seen = [], set()
    n = reset_count(rl)   # Codex：0 次也写；codex 没给（旧版本）就不写
    if n is not None:
        e = reset_credits_view(rl.get('reset_credits')).get('next_expires_epoch') if n else None
        lt = time.localtime(e) if is_num(e) and e > now else None
        out.append('剩余重置 %d 次' % n + ('（%s%d 月 %d 日过期）' % ('最早 ' if n > 1 else '', lt.tm_mon, lt.tm_mday) if lt else ''))
    pairs = [('Opus', rl.get('seven_day_opus')), ('Sonnet', rl.get('seven_day_sonnet'))]
    pairs += [(m.get('display_name'), m) for m in dicts(rl, 'model_scoped')]
    for label, w in pairs:   # 没用过的（0%）不写，免得一排 0%；JSON 里照样都有
        x = win(w, now)
        if x and label and not x['reset'] and x['pct'] > 0 and name_key(label) not in seen:
            seen.add(name_key(label))
            out.append('%s 本周 %d%%' % (label, round(x['pct'])))
    e = rl.get('extra_usage')
    if isinstance(e, dict) and e.get('is_enabled'):
        p = e.get('utilization')
        out.append('额外用量 %d%%' % round(p) if isinstance(p, (int, float)) and not isinstance(p, bool) else '额外用量已开启')
    cr = rl.get('credits')   # Codex 的 credits
    if isinstance(cr, dict) and cr.get('unlimited'):
        out.append('credits 不限')
    elif isinstance(cr, dict) and cr.get('hasCredits') and cr.get('balance'):
        out.append('credits 余额 %s' % cr['balance'])
    return out


def usage_row(key, plan, **kw):
    """cmd_usage_render / _gui state 里一个账号的用量行（usage_entry 读它）：source live|cache|none，at 取到数据的时间，
    rl 用量窗口，why 失败原因（USAGE_WHY 的键），msg 补充说明，outdated_login_plan Claude Code 记的过时的套餐（T.outdated_login_plan）"""
    a, e = parse_key(key)
    row = {'key': key, 'name': name_of(key), 'alias': a, 'email': e or email_of(key), 'plan': plan,
           'source': 'none', 'at': None, 'rl': {}, 'why': None, 'msg': '', 'outdated_login_plan': ''}
    row.update(kw)
    return row


def weekly_shares(rl):
    """Claude 分模型的每周额度（model_scoped，例如 Fable）各占本周总额度多少：{name_key(模型名): {used_percent_of_weekly（已用掉
    本周额度的百分之几）, allowance_percent_of_weekly（最多能用本周额度的百分之几）}}。weekly_scoped_shares 的 limit_index
    指 limits 里的那一项（kind 是 weekly_scoped，scope.model 是哪个模型）；没有 limits（Claude Code 存的缓存里没有）而
    分模型的额度、份额都只有一项时就是它俩，别的情况认不出就不写"""
    shares, ms = dicts(rl, 'weekly_scoped_shares'), dicts(rl, 'model_scoped')
    limits = rl.get('limits') if isinstance(rl.get('limits'), list) else []
    out = {}
    for s in shares:
        i, name = s.get('limit_index'), None
        if limits:
            lim = limits[int(i)] if is_num(i) and int(i) == i and 0 <= i < len(limits) else None
            scope = lim.get('scope') if isinstance(lim, dict) else None
            model = scope.get('model') if isinstance(scope, dict) else None
            name = model.get('display_name') if isinstance(model, dict) else None
        elif len(shares) == 1 and len(ms) == 1:
            name = ms[0].get('display_name')
        if isinstance(name, str) and name_key(name):
            out[name_key(name)] = {k: s.get(k) for k in ('used_percent_of_weekly', 'allowance_percent_of_weekly') if is_num(s.get(k))}
    return out


def reset_credits_view(rc):
    """Codex 还能重置几次额度（codex 原样给的 rateLimitResetCredits）。cca 另加（macos/PROTOCOL.md 3.1）：每一次的明细上
    Unix 秒的 expires_epoch（codex 给的 expiresAt 原样留着，不过期为 null），还能用的里面最早过期的那次的 next_expires_epoch"""
    if not isinstance(rc, dict):
        return None
    if isinstance(rc.get('credits'), list):
        rc = dict(rc, credits=[dict(c, expires_epoch=parse_ts(c.get('expiresAt'))) if isinstance(c, dict) else c
                               for c in rc['credits']])
    opens = reset_credits_open(rc)
    return dict(rc, next_expires_epoch=opens[0]['expires_epoch'] if opens else None)


def reset_credits_open(rc):
    """还能用的重置机会（reset_credits_view 看过的），最早过期的排前面（不过期的排最后；和 codex 里 /usage 的 Redeem reset 一样）"""
    cs = [c for c in dicts(rc, 'credits') if c.get('status') == 'available' and isinstance(c.get('id'), str) and c['id']]
    return sorted(cs, key=lambda c: c['expires_epoch'] if is_num(c.get('expires_epoch')) else float('inf'))


USE_FIRST_HOURS, USE_FIRST_LEFT = 24, 20   # 本周额度 24 小时内重置、还剩至少 20%：App 里建议先用这个账号
USE_FIRST_BAD = ('login', 'mismatch', 'route', 'port', 'trace', 'region', 'nolimits', 'auth')   # 这次查询说明账号现在用不了


def use_first(rl, now, why=None):
    """本周额度快重置了、还剩不少（macos/PROTOCOL.md 3.1）：{left_percent, from_epoch, until_epoch}，App 拿当前时间和
    [from_epoch, until_epoch) 比（快照可能放了好几分钟）；不该提示时是 None。剩余按四舍五入后的百分比算（和显示的一致；
    Python 的 round 是银行家舍入，所以不用它）。登录、线路、出口、5 小时的额度由 App 按各自的状态挡"""
    w = win(rl.get('seven_day'), now)
    if why in USE_FIRST_BAD or not w or w['at'] is None or w['reset']:
        return None
    left = 100 - min(max(int(w['pct'] + 0.5), 0), 100)
    if left < USE_FIRST_LEFT:
        return None
    return {'left_percent': left, 'from_epoch': w['at'] - USE_FIRST_HOURS * 3600, 'until_epoch': w['at']}


def usage_entry(r, now):
    """cca usage --json 里一个账号的条目（_gui state 里的 usage 也是它；格式见 macos/PROTOCOL.md，字段只加不删）。
    r 是 usage_row 构造的一行"""
    def w(x):
        v = win(x, now)
        return {'utilization': v['pct'], 'resets_at': x.get('resets_at'), 'resets_epoch': v['at'], 'reset': v['reset']} if v else None
    rl, at = r['rl'], r['at']
    a = {'account': r['name'], 'key': r['key'], 'email': r['email'] or None, 'plan': r['plan'], 'source': r['source'],
         'fetched_at': iso(at) if at else None, 'fetched_epoch': at or None, 'age_seconds': int(now - at) if at else None,
         'stale': bool(at) and now - at >= USAGE_STALE,
         'error': usage_why(r) if r['why'] else None, 'error_code': r['why'] or None, 'error_detail': (r['msg'] or None) if r['why'] else None}
    for k in T.usage_windows:   # 窗口原样给：没有 5 小时限制的套餐接口不给 five_hour，就是 null。别拿 limits 里的 is_active 判断（CLAUDE.md）
        a[k] = w(rl.get(k))
    shares = weekly_shares(rl)
    a['model_scoped'] = [dict(w(m) or {}, name=m.get('display_name'), **shares.get(name_key(m.get('display_name')), {}))
                         for m in dicts(rl, 'model_scoped')] if isinstance(rl.get('model_scoped'), list) else None
    a['extra_usage'] = rl.get('extra_usage') if isinstance(rl.get('extra_usage'), dict) else None
    a['use_first'] = use_first(rl, now, r['why'])
    if T is CLAUDE:   # Claude Code 登录时记的套餐和账号现在的对不上（重新登录才会更新）：记的那个的叫法；对得上、不知道是 null
        a['outdated_login_plan'] = r.get('outdated_login_plan') or None
    else:   # codex 原样给的：credits 余额；还能重置几次额度（availableCount）和每一次的明细
        a['credits'] = rl.get('credits') if isinstance(rl.get('credits'), dict) else None
        a['reset_credits'] = reset_credits_view(rl.get('reset_credits'))
    return a


def usage_has_windows(rl):
    """查到的用量里至少有一个认得出的窗口：都没有的（接口的格式变了）不算查到，免得把好好的缓存换成空的"""
    return isinstance(rl, dict) and any(win(rl.get(k), 0) for k in T.usage_windows)


def usage_take(r):
    """后台带回来的用量（usage_result 里查用量的格式）：至少认得出一个窗口的才算查到，返回它；没有、认不出返回 None"""
    u = r.get('usage') if r.get('ok') else None
    return u if isinstance(u, dict) and u.get('rate_limits_available') and usage_has_windows(u.get('rate_limits')) else None


def usage_json(rows, now, api):
    out = [usage_entry(r, now) for r in rows]
    j = {'version': 1, 'kind': 'usage', 'generated_at': iso(now), 'generated_epoch': now, 'accounts': out, 'skipped_api_accounts': api}
    if T is not CLAUDE:   # Claude 的输出和以前一样，不加这个字段
        j['tool'] = T.name
    return j


USAGE_NOTE_FLOOR = 20   # cca usage 的表格里备注至少留这么宽（放得下一项原因或额度）；不够时先收起别的列


def fit_note(parts, room):
    """表格的备注（按 ； 分项）放进 room 格：放得下几项放几项，后面的写成 ；…；第一项就放不下时先去掉括号里的补充，
    再不行按字截"""
    for n in range(len(parts), 0, -1):
        s = '；'.join(parts[:n]) + ('；…' if n < len(parts) else '')
        if dw(s) <= room:
            return s
    head = parts[0].split('（')[0]
    return head + '…' if head != parts[0] and dw(head) + 1 <= room else fit(parts[0], room, pad=False)


def usage_table(rows, now, cols, color, api):
    """cca usage 的表格：一个账号一行，整行不超过终端的宽度。放不下时依次收起有别名的账号的邮箱、套餐那一列、
    两个重置时间；备注至少留 USAGE_NOTE_FLOOR 格，按项取舍（fit_note）；查不到的行从 5 小时那一列起写原因"""
    W = max(int(cols) if str(cols).isdigit() else 80, 40) - 2   # 一行最多这么宽（留 2 格：… 和 — 在有的终端里占 2 格）
    paint = (lambda s, code: '\033[%sm%s\033[0m' % (code, s) if code and s.strip() else s) if color else (lambda s, code: s)

    def cell(w, week):
        """一个用量窗口：(百分比, 重置时间, 颜色)"""
        if not w:
            return '—', '', ''
        if w['reset']:
            return '已重置', '', ''
        p = round(w['pct'])
        return '%3d%%' % p, reset_short(w['at'], now, week) if w['at'] else '', '31' if p >= 90 else '33' if p >= 70 else ''
    data = []
    for r in rows:
        if r['source'] == 'none':
            data.append((r, None, None, [usage_why(r)]))
            continue
        notes = usage_notes(r['rl'], now)
        if r['source'] == 'cache':   # 原因在前（窄的终端里先保住它），再说是多久以前的数
            notes = ([usage_why(r)] if r['why'] else []) + ['缓存（%s前）' % ago(now - r['at'])] + notes
        data.append((r, cell(win(r['rl'].get('five_hour'), now), False), cell(win(r['rl'].get('seven_day'), now), True), notes))
    show = {'email': True, 'plan': True, 'r5': True, 'r7': True}
    aw = min(max(dw(r['alias']) for r in rows), 16)   # 账号一格：别名、邮箱各占一小列，和菜单一样（都没有别名就只写邮箱）
    ew = min(max(dw(r['email']) for r in rows), 32)

    def acct(r):
        if show['email']:
            return '  '.join(([fit(r['alias'], aw)] if aw else []) + ([fit(r['email'], ew)] if ew else []))
        return fit(r['alias'] or r['email'], 32, pad=False)

    def win_col(i, title, on):
        """一个窗口那一列：(表头, 宽)。重置时间收起来以后（on 是 False）只写百分比"""
        cells = [x[i] for x in data if x[i]]
        rw = max([dw(c[1]) for c in cells] + [0]) if on else 0
        head = title + '/重置' if rw else title
        return head, max([dw(head)] + [dw(c[0]) + (1 + rw if rw and c[1] else 0) for c in cells])

    def layout():
        """各列的宽：账号、套餐（收起来是 0）、5 小时、本周"""
        A = max([dw('账号')] + [dw(acct(r)) for r in rows])
        P = max([dw('套餐')] + [dw(r['plan']) for r in rows]) if show['plan'] else 0
        return A, P, win_col(1, '5 小时', show['r5'])[1], win_col(2, '本周', show['r7'])[1]

    def slack(A, P, F, K):
        """这样排时一行剩下给备注的宽（可能是负数）"""
        return W - (2 + A + (2 + P if P else 0) + 2 + F + 2 + K)
    firsts = [dw(notes[0]) for _, five, _, notes in data if five and notes]   # 查到了的行的第一项备注
    want = min(USAGE_NOTE_FLOOR, max(firsts)) + 2 if firsts else 0   # 备注那一列（连同前面的两格）想要的宽
    for k, need in (('email', want), ('plan', want), ('r5', 0), ('r7', 0)):   # 重置时间只在数据都放不下时才收
        if slack(*layout()) < need and (k != 'email' or any(r['alias'] and r['email'] for r in rows)):
            show[k] = False
    A, P, F, K = layout()
    if slack(A, P, F, K) < 0:   # 还是放不下：账号那一列截短（最少 10 格），再不行整行截断
        A = max(A + slack(A, P, F, K), 10)
    left = slack(A, P, F, K) - 2
    room = left if left >= 8 else 0   # 备注的宽；太窄就不写备注
    head = [fit('账号', A)] + ([fit('套餐', P)] if P else []) + [fit(win_col(1, '5 小时', show['r5'])[0], F),
                                                              fit(win_col(2, '本周', show['r7'])[0], K)]
    noted = room and firsts
    print(paint(fit(('  ' + '  '.join(head) + ('  备注' if noted else '')).rstrip(), W, pad=False), '2'))
    lost = False
    for r, five, week, notes in data:
        dim = '' if r['source'] == 'live' else '2'
        cells = [(fit(acct(r), A), dim)] + ([(fit(r['plan'], P), dim)] if P else [])
        if not five:   # 查不到：从 5 小时那一列起写原因
            start = 2 + A + 2 + (P + 2 if P else 0)
            print('  ' + '  '.join(paint(t, c) for t, c in cells) + '  ' + paint(fit(notes[0], max(W - start, 10), pad=False), '2'))
            continue
        for (pct, rt, code), width, on in ((five, F, show['r5']), (week, K, show['r7'])):
            cells.append((fit('%s %s' % (pct, rt) if on and rt else pct, width), code or dim))
        line = '  ' + '  '.join(paint(t, c) for t, c in cells)
        note = fit_note(notes, room) if notes and room else ''
        lost = lost or bool(notes and not room)
        print(line + '  ' + paint(note, '2' if dim else '') if note else line.rstrip())
    if lost:
        print(paint(fit('  （终端太窄，备注没显示：拉宽一点，或者用 %s usage --json 看全部）' % T.cmd, W, pad=False), '2'))
    for r in rows:   # Claude Code 记的套餐过时了：表格下面单独一行（太长就换短一点的说法，整行不超过终端的宽度）
        old = r['outdated_login_plan']
        if old:
            fix = '%s login %s' % (T.cmd, r['name'])
            says = ('  ! %s：%s' % (r['name'], login_plan_note(r['key'], old, r['plan'])),
                    '  ! %s：%s 里记的套餐还是 %s，现在是 %s，重新登录：%s' % (r['name'], T.product, old, r['plan'], fix),
                    '  ! 套餐过时（记的是 %s，现在是 %s）：%s' % (old, r['plan'], fix))
            print(paint(fit(next((s for s in says if dw(s) <= W), says[-1]), W, pad=False), '33'))
    if api:
        print(paint(fit('  第三方 API 账号没有订阅用量，不查：%s' % '、'.join(name_of(k) for k in api), W, pad=False), '2'))


def cmd_usage_render(tmp, mode, cols, color, *keys):
    """把后台查询的结果整理成表格或 JSON（stdout）；查到的存进 usage.json，查不到的用缓存顶上（注明多久前）"""
    c, t, _ = ctx()
    now, rows = time.time(), []
    for i, k in enumerate(keys):
        r = usage_result(tmp, i)
        u = usage_take(r)
        if r.get('ok') and not u:
            r = {'ok': False, 'why': 'nolimits', 'msg': ''}
        row = usage_row(k, T.plan(k, (u or {}).get('subscription_type')), why=None if u else (r.get('why') or 'error'),
                        msg=r.get('msg') or '')
        if u:
            row.update(source='live', at=now, rl=u['rate_limits'])
            usage_save(k, u['rate_limits'], u.get('subscription_type'))
        elif row['why'] not in ('login', 'mismatch'):
            x = usage_cached(k)
            if x:
                row.update(source='cache', at=x['at'], rl=x['rl'])
                if x['rl'].get('plan'):
                    row['plan'] = T.plan(k, x['rl']['plan'])
        if row['why'] not in ('login', 'mismatch'):   # 没登录、登录的不是这个账号时不说
            row['outdated_login_plan'] = T.outdated_login_plan(k)
        rows.append(row)
    official = {k for k, v in t.items() if not is_api(v)}
    api = [k for k, v in t.items() if is_api(v)] if set(keys) == official else []
    if mode == 'json':
        print(json.dumps(usage_json(rows, now, api), ensure_ascii=False, indent=2))
    else:
        usage_table(rows, now, cols, color == '1', api)
    sys.exit(0 if any(r['source'] != 'none' for r in rows) else 1)


# 重置额度（cca codex reset）：查不了、重置不了的原因 → 说明，和图形界面的失败原因（fail 事件的 code，macos/PROTOCOL.md 4.5）
RESET_WHY = dict(USAGE_WHY, unsupported='这个版本的 {product} 不能重置额度（{update} 升级后再试）')
# 已经请求重置之后出的错：不知道用掉了没有
RESET_UNSURE = dict(RESET_WHY, timeout='没等到重置的结果，可能已经用掉了一次：刷新用量看看还剩几次',
                    error='重置出错了（{msg}），可能已经用掉了一次：刷新用量看看还剩几次')
RESET_FAIL = {'login': 'not_logged_in', 'mismatch': 'login_mismatch', 'route': 'local_unavailable', 'port': 'port_closed',
              'region': 'region_restricted', 'trace': 'no_exit_ip', 'unsupported': 'reset_unsupported', 'auth': 'not_logged_in'}
RESET_SAID = {'reset': '已重置 %s 的额度', 'already_redeemed': '%s 的这次重置已经完成过了',
              'nothing_to_reset': '%s 现在的用量还不需要重置，没有用掉重置机会'}


def reset_fail(key, r, table=RESET_WHY):
    """后台没成（usage_result 的 {ok: false, why, msg}）→ (fail 事件的 code, 说明)"""
    row = usage_row(key, '', why=r.get('why') or 'error', msg=r.get('msg') or '')
    return RESET_FAIL.get(row['why'], 'error'), usage_why(row, table)


def credit_label(c):
    """一次重置机会：名字（OpenAI 没给就叫完整重置）和什么时候过期（本地时间）"""
    lt = time.localtime(c['expires_epoch']) if is_num(c.get('expires_epoch')) else None
    when = '%d 月 %d 日 %02d:%02d 过期' % (lt.tm_mon, lt.tm_mday, lt.tm_hour, lt.tm_min) if lt else '不过期'
    return '%s，%s' % (str(c.get('title') or '').strip() or '完整重置', when)


def cmd_reset_plan(tmp, key):
    """cca codex reset 的第一步：后台经账号的出口查到的用量（tmp/0）存进 usage.json，给 bash：RC_CODE / RC_MSG（查不了时
    fail 事件的 code 和说明，查到了是空的）；RC_COUNT 还能重置几次；RC_ID 要用掉的那一次（最早过期的；没有明细时是空的，
    由 OpenAI 挑）、RC_NEXT 它的说明；RC_LIST 每一次的说明（一行一个，明细可能比次数少）"""
    def stop(code, msg):
        sh(RC_CODE=code, RC_MSG=msg, RC_COUNT='', RC_ID='', RC_NEXT='', RC_LIST='')
    r = usage_result(tmp, 0)
    u = usage_take(r)
    if not u:
        return stop(*reset_fail(key, r if not r.get('ok') else {'why': 'nolimits'}))
    usage_save(key, u['rate_limits'])
    n = reset_count(u['rate_limits'])
    if n is None:   # 旧版本的 codex：回应里没有重置次数
        return stop(*reset_fail(key, {'why': 'unsupported'}))
    opens = reset_credits_open(reset_credits_view(u['rate_limits'].get('reset_credits')))
    sh(RC_CODE='', RC_MSG='', RC_COUNT=n, RC_ID=opens[0]['id'] if opens else '',
       RC_NEXT=credit_label(opens[0]) if opens else '', RC_LIST='\n'.join(credit_label(c) for c in opens))


def cmd_reset_done(tmp, key, mode='', credit=''):
    """cca codex reset 的最后一步：用掉一次重置机会的结果（tmp/1）→ 重置后的用量存进 usage.json，给 bash RC_OUTCOME、
    RC_CODE（重置不了时 fail 事件的 code，否则是空的）、RC_MSG（说明）、RC_DOC（mode=json 时 kind=reset 的文档）"""
    now, name = time.time(), name_of(key)
    r = usage_result(tmp, 1)
    outcome = r.get('outcome') if r.get('ok') else None
    if outcome == 'no_credit':
        return sh(RC_OUTCOME=outcome, RC_CODE='no_reset_credit', RC_DOC='',
                  RC_MSG=('%s 的这次重置机会已经不能用了（可能刚在别处用掉了），刷新用量看看还剩几次' if credit
                          else '%s 没有能用的重置机会了') % name)
    if outcome not in RESET_SAID:   # 已经请求重置了，结果不知道（超时、出错）
        code, msg = reset_fail(key, r if not r.get('ok') else {'why': 'error', 'msg': '看不懂 codex 回的结果'}, RESET_UNSURE)
        return sh(RC_OUTCOME='', RC_CODE=code, RC_MSG=msg, RC_DOC='')
    u = usage_take(r)
    if u:
        usage_save(key, u['rate_limits'])
    msg = RESET_SAID[outcome] % name
    cell = usage_cell(key, now) if u and outcome != 'nothing_to_reset' else ''
    if cell:
        msg += '（现在 %s）' % cell
    row = usage_row(key, T.plan(key, u.get('subscription_type')), source='live', at=now, rl=u['rate_limits']) if u else None
    doc = {'version': 1, 'kind': 'reset', 'tool': T.name, 'generated_epoch': now, 'key': key, 'outcome': outcome,
           'message': msg, 'usage': usage_entry(row, now) if row else None}
    sh(RC_OUTCOME=outcome, RC_CODE='', RC_MSG=msg, RC_DOC=json.dumps(doc, ensure_ascii=False, indent=2) if mode == 'json' else '')


