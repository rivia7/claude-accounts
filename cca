		agy) TOOL_BIN="$AGY_BIN" INHERITED_RE="$AGY_INHERITED_RE" ;;
		*) TOOL_BIN="$CLAUDE_BIN" INHERITED_RE="$CLAUDE_INHERITED_RE" ;;
	esac
	eval "$(py tool-env)"
}
need_bin() {   # 要运行工具本身的命令：没装时，终端里问要不要现在用官方安装脚本装上（辅助安装，见 tool_install），别的时候说明怎么装
	[ -n "$TOOL_BIN" ] && return 0
	if interactive && [ -z "$PROMPT_GUI" ]; then
		if confirm "没找到 ${TOOL} 命令。现在用官方安装脚本装上吗？" y; then
			tool_install && return 0
			exit 1
		fi
	fi
	FAIL_CODE=tool_missing die "找不到 ${TOOL} 命令：运行 ${CMD} install-cli 用官方安装脚本装上（${INSTALL_URL}；直连不通时可以经内置代理装）"
}

