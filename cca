def gui_api_key(c, k, v):
    """_gui state 的 api_key（PROTOCOL 2.2）：存没存 key、掩码、在哪。照 config.json 里记的说（存的时候算好的掩码），不读钥匙串；
    第三方 API 账号换了服务商（域名和存的时候不一样）算没存——启动时也取不到它"""
    if is_api(v) and secret_ok(v.get('key')):
        return {'saved': True, 'hint': key_hint(v['key']), 'source': 'table'}
    aid, st = acct_id(k), T.state(c)
    h = kc_hints(st).get(aid)
    h = h if isinstance(h, dict) else {}
    host, ref = kc_slot(v)
    saved = aid in (st.get(kc_list(ref)) or []) and h.get('host', host) == host
    hint = h.get('hint') if saved and h.get('host') == host and isinstance(h.get('hint'), str) else ''
    return {'saved': saved, 'hint': hint if HINT_RE.match(hint) else '', 'source': 'keychain' if saved else ''}


def gui_account(c, k, v, procs, badges, pm, env, now, cli):
