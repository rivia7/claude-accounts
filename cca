# --- 第三方 API 账号的 key（下面叫 secret，免得和账号表的键混了）：存在钥匙串里，服务名 cca-api-账号目录名、
# 账户名是接口地址的域名——地址换成别的服务商，旧 key 就取不到，不会被发过去。账号表里写了 key 字段时用表里的。
# cca 存过 key 的账号记在 config.json 的 api_keys：删账号（包括在 cca edit 里删、直接改账号表删）后据此清掉钥匙串里的 key
def security(*args, data=None):
    """运行 security，返回 (退出码, stdout)；data 从 stdin 交给它（security -i）"""
    import subprocess
    try:
        r = subprocess.run(('security',) + args, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=30,
                           **({'input': data} if data is not None else {'stdin': subprocess.DEVNULL}))
    except (OSError, subprocess.SubprocessError):
        return 1, b''
    return r.returncode, r.stdout


def kc_svc(aid):
    return 'cca-api-' + aid


def kc_get(aid, host):
    """钥匙串里这个账号、这个服务商的 key；没有、读不了或不是可见的 ASCII 时返回空字符串"""
    rc, out = security('find-generic-password', '-a', host, '-s', kc_svc(aid), '-w')
    s = out.decode('utf-8', 'replace').strip()
    return s if rc == 0 and SECRET_RE.match(s) else ''


def kc_put(aid, host, s):
    """先删掉这个账号的旧 key（不管哪个服务商的），再存新的。命令和十六进制的 key 都从 stdin 交给 security -i，
    key 不出现在任何进程的命令行里；security -i 里的命令失败了它也返回 0，所以存完读回来比对"""
    if not host or re.search(r'\s', host):
        return False
    kc_del(aid)
    security('-i', data=('add-generic-password -U -a %s -s %s -X %s\n' % (host, kc_svc(aid), s.encode('ascii').hex())).encode('ascii'))
    if kc_get(aid, host) != s:
        return False
    c = cfg_load()
    c['api_keys'] = sorted(set(c.get('api_keys') or []) | {aid})
    cfg_save(c)
    return True


def kc_del(aid):
    """删掉这个账号在钥匙串里的 key（每次删一条，不管哪个服务商的，删到没有为止）"""
    for _ in range(20):
        if security('delete-generic-password', '-s', kc_svc(aid))[0] != 0:
            break
    c = cfg_load()
    if aid in (c.get('api_keys') or []):
        c['api_keys'] = [x for x in c['api_keys'] if x != aid]
        cfg_save(c)


