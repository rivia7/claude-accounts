CORE_SHA256_AMD64="eefe967b74312f70b64efa0dfa54929d00c7af8e94416e1b12df09863a40f35b"
CORE_SHA256_LINUX_ARM64="ba408b317080ee265c46cb923a50018c1b82cbd708551cdd46a1e3e307396187"
