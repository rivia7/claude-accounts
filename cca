pick_node() {   # pick_node [direct] [给图形界面的 k=v…]：从可选节点里选一个，打印节点名；标出已被当前工具的哪些账号使用、路由器上是否存在。
	                # direct 时第一项（默认）是"直连"，选它打印空字符串
	local onrouter="" def n=0 i node sel off=0 cols note
	local -a nodes rows opts
	if [ "${1:-}" = direct ]; then nodes[0]=""; rows[0]="直连（不经代理）"; n=1; off=1; shift; fi
	at_home && onrouter=$(rsh "$RDIR/cca-router.sh nodes" 2>/dev/null | py nodes-fill | awk -F '\t' '$1 != "C" { print $2 }')   # 参考节点同步时补上，不算"路由器上没有"
	while IFS= read -r node; do [ -n "$node" ] && { nodes[n]="$node"; n=$((n + 1)); }; done < <(py nodes-allowed | cut -f1)
	[ $n -gt 0 ] || { warn "config.json 里没有可选节点（nodes）"; return 1; }
	i=$off
	cols=$(term_cols); [ -z "$PROMPT_GUI" ] || cols=400   # 图形界面要完整的注记，不按终端宽度截断
	while IFS= read -r node; do rows[i]="$node"; i=$((i + 1)); done < <(py node-rows "$onrouter" "$cols")
	if [ $off = 1 ]; then def=0; else def=$(py node-default); fi
	if [ -n "$PROMPT_GUI" ]; then
		for ((i = 0; i < n; i++)); do
			note=${rows[i]#"${nodes[i]}"}
			[ -n "${nodes[i]}" ] || note=""
			note=${note#"${note%%[![:space:]]*}"}
			opts[i]="opt=$((i + 1))"$'\t'"${nodes[i]:-${rows[i]}}"$'\t'"$note"
		done
		sel=$(gui_ask choice "选择出口节点" "$((def + 1))" label=出口节点 "${opts[@]}" "$@") || return 1
		case "$sel" in ''|*[!0-9]*) return 1 ;; esac
		[ "$sel" -ge 1 ] && [ "$sel" -le $n ] || return 1
		printf '%s' "${nodes[sel - 1]}"
		return 0
	fi
	if fancy_ok; then
		arrow_menu "$def" "${rows[@]}"
		[ "$MENU_PICK" -ge 0 ] || return 1
		printf '%s' "${nodes[MENU_PICK]}"
		return 0
	fi
	for ((i = 0; i < n; i++)); do say "    $((i + 1)). ${rows[i]}"; done
	while :; do
		sel=$(ask "  选择节点编号 [$((def + 1))]：" "$((def + 1))")
		case "$sel" in
			*[!0-9]*) warn "请输入编号" ;;
			*) if [ "$sel" -ge 1 ] && [ "$sel" -le $n ]; then printf '%s' "${nodes[sel - 1]}"; return 0; fi
			   warn "没有编号 ${sel}" ;;
		esac
	done
}

cmd_add() {   # cca [codex] add [api]
	local email alias key node out hint
	[ "${1:-}" = api ] && { cmd_add_api; return; }
	need_tty
	# 没配置路由器：先配置。服务器上（从来没配置过路由器（没有地址），只配置了本机的代理，可选节点来自维护者的参考节点）有可选节点就不用；
	# 配置过、只是现在用不了（比如密钥没了）的，照样先重新配置
	if ! router_ready && { [ -n "$ROUTER_HOST" ] || [ -z "$LOCAL_SET" ] || [ -z "$(py nodes-allowed)" ]; }; then
		info "官方账号要经路由器的端口出去，先配置路由器（只用第三方 API 账号的话不需要路由器：按 Ctrl-C 退出，运行 ${CMD} add api）"
		ROUTER_FORM_WHY="官方账号要经路由器的端口出去，先配置路由器（只用第三方 API 账号的话不需要路由器）。"
		cmd_router_setup || return 1
	fi
	say ""
	if [ "$TOOL" = agy ]; then say "${C_B}添加 ${TOOL_LABEL} 账号${C_0}    ${C_D}Google 账号${C_0}"
	else say "${C_B}添加 ${TOOL_LABEL} 账号${C_0}    ${C_D}第三方 API 用 ${CMD} add api${C_0}"; fi
	say ""
	case "$TOOL" in
		codex) hint="第一次使用时在它专属的浏览器窗口里登录，登录后 cca 会核对是不是这个邮箱" ;;
		agy) hint="第一次使用时在它专属的浏览器窗口里登录 Google（登录页会选好这个邮箱），登录后 cca 会核对" ;;
		*) hint="第一次使用时在它专属的浏览器窗口里登录，登录页会预填这个邮箱" ;;
	esac
	ask_fields add.basic "添加 ${TOOL_LABEL} 账号" "" \
		"email|text|email|  登录邮箱：|登录邮箱|${hint}" \
		"alias|text?|alias|  别名（可选，回车跳过）：|别名（可选）|只用来认出这个账号" || return 1
	email=$F_email alias=$F_alias
	say ""
	node=$(py policy-node "$email")
	if [ -n "$node" ]; then
		info "${alias:-$email} 的出口按维护者的映射固定为 ${node}"
	else
		say "  给 ${alias:-$email} 选一个出口节点（每个账号最好用不同的节点）："
		say ""
		node=$(pick_node q=add.node "title=添加 ${TOOL_LABEL} 账号" "message=给 ${alias:-$email} 选一个出口节点（每个账号最好用不同的节点）") || return 1
	fi
	say ""
	key=$(py add "$email" "$alias" "$node") || return 1
	account_added "$key"
	case "$TOOL" in
		codex) info "第一次使用时会在它专属的浏览器窗口里登录 ChatGPT（用 ${ACC_EMAIL} 登录，登录后 cca 会核对）"
		       codex_alias_ensure "$ACC_NAME" ;;
		agy) info "第一次使用时会在它专属的浏览器窗口里登录 Google（用 ${ACC_EMAIL} 登录，登录后把页面上的授权码粘贴回终端）" ;;
		*) info "第一次使用时会在它专属的浏览器窗口里登录，登录页会预填 ${ACC_EMAIL}" ;;
	esac
	ADDED_KEY="$key"
	gui_done added "已添加 ${ACC_LABEL}，出口 ${node}" "$key"
}

account_added() {   # account_added 键：新加的官方账号接上路由器、初始化账号目录、建启动器（cmd_add、login-page 共用）
	eval "$(py env "$1")"
	router_sync_soon || fail_warn sync_failed "路由器同步没完成：修好后运行 cca router sync"
	py link "$1" && py sync "$1" || die "初始化账号目录失败"
	okay "已添加 ${ACC_LABEL}，出口 ${ACC_NODE}"
	launchers_sync
}

# 第三方 API 账号：Claude 是兼容 Anthropic 接口的地址 + key，Codex 是兼容 OpenAI Responses 接口的；在菜单里和
# 官方账号一样选用。直连时不需要路由器
cmd_add_api() {
	local alias url model secret node="" key title api url_hint url_q model_q env_hint
	[ "$TOOL" != agy ] || FAIL_CODE=unsupported die "${TOOL_LABEL} 没有第三方 API 账号：只能加 Google 账号（${CMD} add）"
	need_tty
	case "$TOOL" in
		codex) title="添加第三方 API 账号（Codex）" api="兼容 OpenAI Responses 接口的服务" env_hint=""
		       url_hint="base_url，例如 https://api.example.com/v1" model_q="服务商不认 codex 默认的模型名时请填上" ;;
		*) title="添加第三方 API 账号" api="兼容 Anthropic 接口的服务" env_hint="或加环境变量"
		   url_hint="ANTHROPIC_BASE_URL，例如 https://api.example.com/anthropic" model_q="填了会同时用作 opus / sonnet / haiku" ;;
	esac
	url_q="接口地址（${url_hint}）"
	say ""
	say "${C_B}${title}${C_0}    ${C_D}${api}：填地址和 key，模型可选${C_0}"
	say ""
	ask_fields api.basic "$title" "${api}：填地址和 key，模型可选" \
		"alias|text|alias|  别名（在菜单里显示，例如 kimi）：|别名|在菜单里显示，例如 kimi" \
		"url|text|url|  ${url_q}：|接口地址|${url_hint}" \
		"key|secret|secret|  API key（输入时不显示）：|API key|只存进${KEYSTORE_AT}" \
		"model|text?|model|  模型（可选，回车跳过；${model_q}）：|模型（可选）|${model_q}" || return 1
	alias=$F_alias url=$F_url secret=$F_key model=$F_model
	F_key=""
	if [ -n "$(py nodes-allowed)" ]; then
		say ""
		say "  ${alias} 走哪个出口？国内的服务一般直连；要经代理的选一个节点："
		say ""
		node=$(pick_node direct q=api.node "title=${title}" "message=${alias} 走哪个出口？国内的服务一般直连；要经代理的选一个节点") || return 1
		say ""
		if [ -n "$node" ] && ! router_ready; then
			info "走节点要先配置路由器"
			ROUTER_FORM_WHY="走节点要先配置路由器。"
			cmd_router_setup || return 1
		fi
	fi
	key=$(py add-api "$alias" "$url" "$model" "$node") || return 1
	if ! printf '%s' "$secret" | py secret-set "$key"; then
		py rm "$key"
		die "API key 没存进${KEYSTORE}，没有添加 ${alias}"
	fi
	secret=""
	eval "$(py env "$key")"
	[ -z "$ACC_PORT" ] || router_sync_soon || fail_warn sync_failed "路由器同步没完成：修好后运行 cca router sync"
	py link "$key" && py sync "$key" || die "初始化账号目录失败"
	okay "已添加第三方 API 账号 ${ACC_NAME}（${ACC_BASE_URL}，出口 ${ACC_NODE}），key 存在${KEYSTORE}里"
	info "用 ${CMD} @${ACC_NAME} 启动；改地址、模型${env_hint}用 ${CMD} edit，换 key 用 ${CMD} key ${ACC_NAME}"
	if [ "$TOOL" = codex ]; then codex_alias_ensure "$ACC_NAME"; fi
	gui_done added "已添加第三方 API 账号 ${ACC_NAME}（${ACC_BASE_URL}，出口 ${ACC_NODE}）" "$key"
}

# x=$(ask_valid 字段 提示 [optional])：问到 py check 通过为止，打印规范化后的值；
# 直接回车：optional 时打印空字符串，否则说"已取消"并返回 1
ask_valid() {
	local v out
	while :; do
		v=$(ask "$2" "")
		if [ -z "$v" ]; then
			[ "${3:-}" = optional ] && return 0
			say "  已取消"
			return 1
		fi
		if out=$(py check "$1" "$v"); then printf '%s' "$out"; return 0; fi
		warn "$out"
	done
}

api_key_ask() {   # api_key_ask 提示 [图形界面的页标题] [说明]：读一个合格的 API key 打到 stdout（不回显）；空输入返回 1
	local s out
	if [ -n "$PROMPT_GUI" ]; then
		ask_fields key.secret "${2:-API key}" "${3:-}" "s|secret|secret|$1|API key|输入时不显示，只存进${KEYSTORE_AT}" || return 1
		printf '%s' "$F_s"
		return 0
	fi
	while :; do
		s=$(ask_secret "$1")
		[ -n "$s" ] || return 1
		if out=$(printf '%s' "$s" | py secret-check); then printf '%s' "$s"; return 0; fi
		warn "$out"
	done
}

api_key_prompt() {   # api_key_prompt [图形界面的说明]：输入 key 存进钥匙串（需要先 eval "$(py env 名称)"）；官方账号的是记下备查的
	local s title="${ACC_NAME} 的 API key"
	[ "$ACC_KIND" = api ] || title="记录 ${ACC_NAME} 的 API key"
	s=$(api_key_ask "  ${ACC_NAME} 的 API key（输入时不显示）：" "$title" "${1:-}") || { say "  已取消"; return 1; }
	if ! printf '%s' "$s" | py secret-set "$ACC_KEY" 2>/dev/null; then   # key 已经检查过（api_key_ask），失败只会是钥匙串
		if keyfile_store; then fail_warn keychain_unavailable "API key 存进密钥文件失败：看看 ~/.cca/secrets 的权限和磁盘空间"
		else fail_warn keychain_unavailable "API key 存进钥匙串失败（钥匙串被锁住了？）：解锁后再试一次"; fi
		return 1
	fi
	okay "已把 ${ACC_NAME} 的 API key 存进${KEYSTORE}"
	gui_done key_saved "已把 ${ACC_NAME} 的 API key 存进${KEYSTORE}" "$ACC_KEY"
}

api_key_ready() {   # 启动前：key 在账号表里或钥匙串里（按现在的接口域名）；都没有时在终端里问
	[ -n "$(py secret-status "$ACC_KEY")" ] && return 0
	if ! interactive; then
		warn "${KEYSTORE}里没有 ${ACC_NAME} 的 API key（接口地址换了服务商时也要重新输入）：在终端里运行 ${CMD} key ${ACC_NAME}"
		gui_terminal api_key "${KEYSTORE}里没有 ${ACC_NAME} 的 API key：在终端里输入一次" key "$ACC_KEY"
		return 1
	fi
	warn "${KEYSTORE}里还没有 ${ACC_NAME} 的 API key（第一次用，或者接口地址换了服务商）"
	api_key_prompt
}

api_keys_ensure() {   # cca edit 之后：手写进账号表、换了服务商、还没有 key 的第三方 API 账号，现在输入
	local key
	while IFS= read -r key; do
		[ -n "$key" ] || continue
		eval "$(py env "$key")"
		info "第三方 API 账号 ${ACC_NAME} 还没有 key"
		api_key_prompt || warn "先跳过：启动 ${ACC_NAME} 时会再问"
	done < <(py secrets-missing)
}

cmd_key() {   # cca [codex] key <账号> [--show | --forget]：第三方 API 账号重新输入 key；官方账号记一把 API key 备查（比如控制台里建的，
              # cca 不拿它登录、启动）。--show 把 key 原样打到 stdout（App 的「显示」「复制」经管道读）；--forget 删掉官方账号记的 key
	local a op="" name="" key
	for a in "$@"; do
		case "$a" in
			--show|--forget) op=${a#--} ;;
			*) [ -n "$name" ] || name=$a ;;
		esac
	done
	key=$(py resolve "$name") || FAIL_CODE=account_missing die "用法: ${CMD} key <账号> [--show | --forget]"
	eval "$(py env "$key")"
	case "$op" in
		show) key_show ;;
		forget) key_forget ;;
		*) key_set ;;
	esac
}

key_set() {   # cca key 账号（需要先 eval "$(py env 名称)"）
	need_tty
	local note=""
	if [ "$ACC_KIND" != api ]; then
		note="只记在${KEYSTORE_AT}里备查（比如在控制台里建的 key）：cca 不会拿它登录或启动这个账号"
		[ -n "$PROMPT_GUI" ] || info "$note"
	elif [ "$(py secret-status "$ACC_KEY")" = table ]; then
		note="账号表里写了 ${ACC_NAME} 的 key 字段，会优先用它；要换那个请用 ${CMD} edit"
		warn "$note"
	fi
	api_key_prompt "$note"
}

key_show() {   # cca key 账号 --show：key 原样打到 stdout（不换行；终端里另起一行写到 stderr）。在 Claude Code 的会话里不给：会进对话记录
	if [ -n "${CLAUDECODE:-}" ] && [ -z "${CCA_EVENTS:-}" ]; then
		die "在 Claude Code 里不显示 API key（会进对话记录）：请在终端或 cca App 里看"
	fi
	py key-show "$ACC_KEY"
	case $? in
		0) [ ! -t 1 ] || echo >&2 ;;
		3) FAIL_CODE=key_missing die "${ACC_NAME} 还没有存 API key（${CMD} key ${ACC_NAME} 存一个）" ;;
		4) keyfile_store && FAIL_CODE=keychain_unavailable die "读不了 ~/.cca/secrets 里的密钥文件：看看它的权限"
		   FAIL_CODE=keychain_unavailable die "读不了钥匙串（被锁住了？）：解锁后再试" ;;
		*) die "没能读取 ${ACC_NAME} 的 API key" ;;
	esac
}

key_forget() {   # cca key 账号 --forget：删掉官方账号记下备查的 API key（先问）；第三方 API 账号的 key 启动要用，不在这里删
	[ "$ACC_KIND" != api ] || FAIL_CODE=api_account die "${ACC_NAME} 是第三方 API 账号：它的 key 启动时要用，要换就用 ${CMD} key ${ACC_NAME}"
	if [ "$(py secret-status "$ACC_KEY")" != ref ]; then
		info "${ACC_NAME} 没有记下 API key"
		gui_done key_forgotten "${ACC_NAME} 没有记下 API key" "$ACC_KEY"
		return 0
	fi
	consent key_forget "$ACC_ID" "删除 ${ACC_NAME} 的 API key" "删除记下的这把 API key 吗？" \
		"只删掉 cca 在${KEYSTORE_AT}里记的这一份，控制台里的 key 本身不受影响。" n
	case $? in
		0) ;;
		1) info "没有删除"; return 0 ;;
		*) die "要先同意：在终端里运行 ${CMD} key ${ACC_NAME} --forget（会先问你）" ;;
	esac
	py secret-del "$ACC_KEY"
	okay "已删除 ${ACC_NAME} 记下的 API key"
	gui_done key_forgotten "已删除 ${ACC_NAME} 记下的 API key" "$ACC_KEY"
}

# 账号表、端口池有变化时要不要同步路由器：配置过路由器，或者有走端口的账号（只有直连的第三方 API 账号时不用）
router_needed() { router_ready || [ -n "$(py ports)" ]; }

cmd_edit() {
	local before had
	need_tty
	if [ -n "$PROMPT_GUI" ]; then edit_form; return; fi
	before=$(digest)
	had=$(py policy-have)   # 映射里的账号：编辑时删掉的要记下来，不然 validate（经过 ctx）又会按映射把它加回来
	${EDITOR:-vi} "$TABLE" <&3 3<&-
	py policy-forget "$had"
	while ! py validate; do
		confirm "账号表有错误，重新编辑？" y || return 1
		${EDITOR:-vi} "$TABLE" <&3 3<&-
		py policy-forget "$had"
	done
	chmod 600 "$TABLE" 2>/dev/null   # 编辑器可能另存再改名（权限会变）；表里可能写着 key
	py secrets-forget   # 删掉的第三方 API 账号：钥匙串里的 key 一起删
	if [ "$(digest)" != "$before" ] || [ "$(digest)" != "$(py get synced)" ]; then
		router_needed && router_sync_soon
	else
		info "端口和节点没有变化，不用同步路由器"
	fi
	launchers_sync
	api_keys_ensure
}

edit_form() {   # 提问会话里的 cca [codex] edit：表单改常用项（节点、接口地址、模型、环境变量），cca 校验、写表；表单改不了的（账号表不是 JSON、键写错了）才去终端
	local spec sum seq id out rc answers="" left
	local -a ids
	while :; do
		rc=0
		spec=$(printf '%s' "$answers" | py edit-form) || rc=$?
		case $rc in
			0) ;;
			3) gui_terminal edit "账号表有表单改不了的问题：在终端里修一下（${spec}）" edit
			   FAIL_CODE=table_invalid die "账号表有表单改不了的问题：${spec}" ;;
			4) die "$spec" ;;
			5) FAIL_CODE=no_router die "$spec" ;;   # App 的补救按钮：配置路由器
			*) return 1 ;;
		esac
		sum=${spec%%$'\n'*}
		spec=${spec#*$'\n'}
		seq=$(printf '%s\n' "$spec" | py prompt-emit) || gui_abort
		ids=()
		while IFS= read -r id; do
			case "$id" in field=*) ids[${#ids[@]}]=${id#field=} ;; esac
		done <<< "$spec"
		answers=""
		for id in "${ids[@]}"; do
			gui_answer "$seq" "$id"
			answers="${answers}${id}"$'\t'"${ANSWER}"$'\n'
		done
		rc=0
		out=$(printf '%s' "$answers" | py edit-apply "$sum") || rc=$?
		[ $rc -eq 0 ] && break
		[ $rc -eq 3 ] || return 1
		answers="${answers}${out}"$'\n'   # 问题（!字段<TAB>原因）带回去，已填的也带回去
	done
	[ "$out" != same ] || [ "$(digest)" != "$(py get synced)" ] || return 0   # 什么都没改
	py secrets-forget   # 换了服务商、去掉了账号表里的 key：钥匙串里跟着清
	if router_needed; then router_sync_soon || fail_warn sync_failed "路由器同步没完成：修好后运行 cca router sync"; fi
	launchers_sync
	api_keys_ensure
	if ! left=$(py validate 2>&1); then gui_fail table_invalid "账号表还有问题：${left//$'\n'/；}"; fi
	[ "$out" = same ] || gui_done saved "${TOOL_LABEL} 的账号表已保存"
}

cmd_rename() {   # cca [codex] rename <账号> <新别名>：改别名（新别名写 - 去掉别名，只留邮箱）。只换账号表里的键：
	# 账号按邮箱（第三方 API 账号按 id）认，登录、浏览器资料、端口、“上次使用”都不变，路由器也不用同步；启动器跟着改名。
	# 不交互（图形界面的“改别名…”用它），stdout 只打印新的键
	local key new rc
	[ $# -eq 2 ] || die "用法: ${CMD} rename <账号> <新别名>（新别名写 - 去掉别名，只留邮箱）"
	key=$(py resolve "$1") || FAIL_CODE=account_missing die "没找到账号：$1"
	new=$(py rename "$key" "$2") && rc=0 || rc=$?
	case $rc in
		0) ;;
		3) FAIL_CODE=alias_invalid die "$new" ;;
		*) return 1 ;;
	esac
	if [ "$new" = "$key" ]; then
		info "别名没有变：${key}"
	else
		launchers_sync
		okay "已改名：${key} → ${new}（登录、资料、端口都不变）"
	fi
	printf '%s\n' "$new"
}

cmd_reorder() {   # cca [codex] reorder <账号>…：按这个顺序排账号表（没写到的账号接在后面）。菜单、编号都跟着变；端口、路由器、启动器都不动。
	# 不交互（图形界面调整账号顺序时用它），什么都不输出
	[ $# -gt 0 ] || die "用法: ${CMD} reorder <账号>…（按这个顺序排账号表，没写到的账号接在后面）"
	py reorder "$@"
}

# 继承来的、会盖掉账号自己的登录/接口/模型，或者把请求转去别的服务商的变量（和 PY_SRC 里的 CRED_ENV 对应）
INHERITED_RE='^(ANTHROPIC_.*|CLAUDE_(CONFIG_DIR|SECURESTORAGE_CONFIG_DIR)|CLAUDE_CODE_(OAUTH_TOKEN|[A-Z_]*_FILE_DESCRIPTOR)|CLAUDE_CODE_USE_(BEDROCK|VERTEX|FOUNDRY|GATEWAY|MANTLE|ANTHROPIC_AWS|ANTHROPIC_GOOGLE_CLOUD)|CLAUDE_CODE_PROVIDER_MANAGED_BY_HOST)$'
CLAUDE_INHERITED_RE="$INHERITED_RE"
# Codex：CODEX_ACCESS_TOKEN / CODEX_API_KEY 会直接顶替账号的登录，*_URL_OVERRIDE 会把 token 发到别处，OPENAI_* 会带上
# 别的组织、key；CODEX_HOME 等由 cca 设。只留 CODEX_CA_CERTIFICATE（公司网络的根证书，和账号无关）
CODEX_INHERITED_RE='^(CODEX_.*|OPENAI_.*)$'
# agy：AGY_ACCOUNT、AGY_ADC_AUTH、AGY_LLM_GATEWAY_* 会换掉账号的登录或把请求发到别处，ANTIGRAVITY_*、GEMINI_DIR 会换掉数据目录，
# GEMINI_API_KEY、GOOGLE_API_KEY、GOOGLE_APPLICATION_CREDENTIALS 会顶替登录，GOOGLE_CLOUD_PROJECT 这些会把请求记到别的项目上。
# 只留界面上的开关和公司网络的根证书（AGY_CA_CERT）
AGY_INHERITED_RE='^(AGY_.*|ANTIGRAVITY_.*|GEMINI_.*|GOOGLE_(API_KEY|APPLICATION_CREDENTIALS|CREDENTIALS|CLOUD_(PROJECT|LOCATION|QUOTA_PROJECT|REGION|UNIVERSE_DOMAIN)|GENAI_.*|API_USE_.*))$'
INHERITED_KEEP='^(CODEX_CA_CERTIFICATE|AGY_CA_CERT|AGY_CLI_(THEME|HIDE_LOGO|LOGO_STYLE|HIDE_ACCOUNT_INFO|MAC_OPTION_AS_ALT|FORCE_OSC|OSC|FAST_PROMPT_EDITOR|EXPERIMENTAL_RENDERING|DISABLE_[A-Z_]+))$'
child_env() {   # 需要先 eval "$(py env 名称)"；结果在 UNSETS / SETS 两个数组里，屏蔽掉的继承变量名在 DROPPED 里
	local v
	# 继承来的接口地址、凭证、模型一律不带进去：例如 shell 里 export 过 ANTHROPIC_BASE_URL，官方账号的登录 token
	# 就会被发到那个地址。第三方 API 账号自己的地址和模型经 --settings（Codex 经 -c）传，key 经回调 cca 现取
	UNSETS=(-u ALL_PROXY -u all_proxy -u CCA_EVENTS -u CCA_GRANT -u CCA_RO -u CCA_PROMPT)   # 图形界面给 cca 的变量不带给工具
	DROPPED=""
	for v in $(compgen -e | grep -E "$INHERITED_RE" | grep -vE "$INHERITED_KEEP"); do UNSETS+=(-u "$v"); DROPPED="${DROPPED:+${DROPPED} }${v}"; done
	tool env
	if [ -n "$ACC_PROXY" ]; then
		SETS+=(https_proxy="$ACC_PROXY" HTTPS_PROXY="$ACC_PROXY" http_proxy="$ACC_PROXY" HTTP_PROXY="$ACC_PROXY"
			no_proxy="$CCA_NO_PROXY" NO_PROXY="$CCA_NO_PROXY")
	else   # 直连：也不用 shell 里继承来的代理，出口不随环境变
		UNSETS+=(-u https_proxy -u HTTPS_PROXY -u http_proxy -u HTTP_PROXY -u no_proxy -u NO_PROXY)
	fi
}
claude_env() {
	# 新版凭证库可单独指定目录；固定为原 CLAUDE_CONFIG_DIR，保留已有钥匙串服务名。
	SETS=(CLAUDE_CONFIG_DIR="$ACC_HOME" CLAUDE_SECURESTORAGE_CONFIG_DIR="$ACC_HOME" CCA_ACCOUNT="$ACC_KEY" CCA_PROXY="$ACC_PROXY")
	[ "$ACC_KIND" = api ] || SETS+=(BROWSER="$CCA_HOME/bin/open-url")
}
codex_env() {   # 会话、记忆等数据库不靠链接共享：CODEX_SQLITE_HOME 指向 ~/.codex
	SETS=(CODEX_HOME="$ACC_HOME" CODEX_SQLITE_HOME="$ACC_MASTER" CCA_ACCOUNT="$ACC_KEY" CCA_PROXY="$ACC_PROXY")
	# 直连：codex 没有代理变量时会改用 macOS 的系统代理，NO_PROXY=* 才是真的直连
	[ -n "$ACC_PROXY" ] || SETS+=(no_proxy='*' NO_PROXY='*')
}
agy_env() {   # 数据目录经参数（--gemini_dir，见 AgyTool.run_args）。SSH_CONNECTION：agy 看到 SSH 会话就把登录存进数据目录里的文件、
	# 不用钥匙串（钥匙串里只有一份，所有账号会共用它；agy_guard 核对这个版本确实这样）。agy 和它跑的命令都会看到这个变量
	SETS=(SSH_CONNECTION="127.0.0.1 22 127.0.0.1 22" CCA_ACCOUNT="$ACC_KEY" CCA_PROXY="$ACC_PROXY")
	[ -n "$ACC_PROXY" ] || SETS+=(no_proxy='*' NO_PROXY='*')
}
pyenv() { env "${UNSETS[@]}" "${SETS[@]}" CCA_SELF="$SELF" CCA_TOOL="$TOOL" CCA_BIN="$TOOL_BIN" "${PYRUN[@]}" "$@"; }   # 在账号的环境里跑 py（先 child_env）

logout_account() {   # 需要先 eval "$(py env 名称)"；官方账号退出登录；钥匙串里 cca 存的 key（第三方 API 账号的、官方账号记下备查的）都删掉
	[ "$ACC_KIND" = api ] || tool logout
	py secret-del "$ACC_KEY"
	return 0
}
claude_logout() {
	if [ -d "$ACC_HOME" ] && [ -n "$CLAUDE_BIN" ]; then
		child_env
		with_timeout 30 env "${UNSETS[@]}" "${SETS[@]}" "$CLAUDE_BIN" auth logout </dev/null >/dev/null 2>&1
	fi
	if on_linux; then rm -f "$ACC_HOME/.credentials.json"   # Linux 上 Claude Code 的登录凭证是这个文件（没有钥匙串）
	else security delete-generic-password -s "$(py keychain "$ACC_KEY")" >/dev/null 2>&1; fi
}
codex_logout() {   # codex logout 会去服务器上注销（经账号的出口）；连不上也把本地的 auth.json 删掉
	if [ -f "$ACC_HOME/auth.json" ] && [ -n "$CODEX_BIN" ]; then
		child_env
		with_timeout 30 env "${UNSETS[@]}" "${SETS[@]}" "$CODEX_BIN" "${ACC_FLAGS[@]}" logout </dev/null >/dev/null 2>&1
	fi
	rm -f "$ACC_HOME/auth.json"
}
agy_logout() {   # agy 没有退出登录的命令：删掉账号目录里的登录 token 和 cca 登录时记下的邮箱
	rm -f "$ACC_HOME/antigravity-cli/antigravity-oauth-token" "$ACC_DIR/agy-login.json"
}

auth_email() { tool email; }   # 已登录的邮箱（没登录是空的）
claude_email() {   # 先读账号目录的 .claude.json，读不到再问 claude auth status
	local e
	e=$(py email "$ACC_KEY")
	if [ -z "$e" ]; then
		child_env
		e=$(env "${UNSETS[@]}" "${SETS[@]}" "$CLAUDE_BIN" auth status --json 2>/dev/null 3<&- </dev/null | "$PYTHON" -I -X utf8 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    d = {}
print((d.get("email") or "") if d.get("loggedIn") else "")')
	fi
	printf '%s' "$e"
}
codex_email() { py email "$ACC_KEY"; }   # auth.json 里 id_token 的邮箱（只读这一项）
agy_email() { py email "$ACC_KEY"; }   # 账号目录里登录 token 文件的 id_token_email（只读这一项和档位）

# 账号表里有邮箱时：没登录就用这个邮箱登录（Claude 的登录页预填它）；登录的不是它就拒绝（否则会让别的账号走这个出口）
ensure_login() {
	local e tries=0
	while :; do
		py device "$ACC_KEY" || return 1   # logout 可能清掉客户端配置，登录前恢复该账号的固定设备标识
		e=$(auth_email)
		LOGIN_EMAIL=$e   # 启动时的横幅接着用，不再问一次
		if [ -z "$e" ]; then
			if ! interactive; then
				fail_warn not_logged_in "${ACC_NAME} 还没登录，需要在终端里运行 ${CMD} @${ACC_NAME} 完成登录"
				gui_terminal login "${ACC_NAME} 还没登录：在终端里完成一次登录" login "$ACC_KEY"
				return 1
			fi
			[ $tries -lt 2 ] || return 1
			tries=$((tries + 1))
			[ $tries -gt 1 ] || [ -z "${LEAK_WEBRTC:-}" ] || login_remote || warn "$LEAK_WEBRTC"   # 登录页在账号的浏览器里打开（服务器上登录时在 Mac 上打开：那边的 login-page 自己测）
			tool login || { warn "登录没有完成"; return 1; }
			continue
		fi
		[ -z "$ACC_EMAIL" ] && return 0
		[ "$(lower "$e")" = "$(lower "$ACC_EMAIL")" ] && return 0
		warn "这个账号目录登录的是 ${e}，不是 ${ACC_EMAIL}（继续会让 ${e} 走 ${ACC_NAME} 的出口）"
		if ! interactive; then
			gui_fail login_mismatch "这个账号目录登录的是 ${e}，不是 ${ACC_EMAIL}"
			gui_terminal login "${ACC_NAME} 登录的不是这个账号：在终端里退出后改用 ${ACC_EMAIL} 登录" login "$ACC_KEY"
			return 1
		fi
		confirm "退出 ${e}，改用 ${ACC_EMAIL} 登录？" y || return 1
		tool wipe
	done
}
claude_login() {
	local -a em=()
	[ -n "$ACC_EMAIL" ] && em=(--email "$ACC_EMAIL")
	if ! login_remote; then
		has_chrome || { fail_warn no_chrome "登录需要 Google Chrome：已停止，避免使用系统浏览器的登录状态和出口"; return 1; }
		info "${ACC_NAME} 还没登录：正在它专属的浏览器窗口里打开登录页${ACC_EMAIL:+（已预填 ${ACC_EMAIL}）}，登录完成后会自动继续"
	fi
	py login-plan-forget "$ACC_KEY" || :   # 上次查用量时记下的“Claude Code 登录时的套餐”作废：登录后它按现在的套餐重新记
	child_env
	if login_remote; then
		remote_login env "${UNSETS[@]}" "${SETS[@]}" "$CLAUDE_BIN" auth login --claudeai "${em[@]}"
		return
	fi
	env "${UNSETS[@]}" "${SETS[@]}" "$CLAUDE_BIN" auth login --claudeai "${em[@]}" 3<&-
}
claude_wipe() {   # 退出登错的账号（Claude Code 自己记着的 oauthAccount 也去掉，免得还当它登录着）
	claude_logout
	"$PYTHON" -I -X utf8 -c 'import json,sys; p=sys.argv[1]; j=json.load(open(p)); j.pop("oauthAccount",None); json.dump(j,open(p,"w"),indent=2)' "$ACC_HOME/.claude.json" 2>/dev/null
}
codex_wipe() { codex_logout; }
agy_wipe() { agy_logout; }
agy_guard() {   # 这个版本的 agy 确实把登录存进账号目录的文件（不是钥匙串）才往下走：否则所有账号会共用钥匙串里的同一份登录
	need_bin
	py agy-probe "$AGY_BIN" && return 0
	FAIL_CODE=login_unsupported die "这个版本的 agy 不再把登录存进账号自己的目录（各账号会共用钥匙串里的同一份登录），已停止：等 cca 跟上新版本后再用"
}
# agy 登录：agy 自己打出 Google 的登录网址、从终端读授权码（登录后跳到 antigravity.google 的页面上显示授权码，不回本机）。
# 网址在账号专属的 Chrome 里打开（服务器上给出在 Mac 上运行的 login-page 那一行），授权码粘贴回这个终端
agy_login() {
	local mode=local
	agy_guard
	if login_remote; then mode=remote
	else
		has_chrome || { fail_warn no_chrome "登录需要 Google Chrome：已停止，避免使用系统浏览器的登录状态和出口"; return 1; }
		info "${ACC_NAME} 还没登录：正在它专属的浏览器窗口里打开 Google 的登录页${ACC_EMAIL:+（请用 ${ACC_EMAIL} 登录）}，登录后把页面上的授权码粘贴到这里"
	fi
	child_env
	pyenv agy-login "$AGY_BIN" "$mode"   # 授权码由它从 fd 3 问（和 ask 一样），再交给 agy；agy 自己拿不到 fd 3
}
# Codex 登录：经 codex 的 app-server 拿到登录网址，在这个账号专属的 Chrome 里打开（整个登录都走账号的出口），登录完成后
# codex 自己把凭证写进这个账号的 auth.json。
codex_login() {   # 前台运行（Ctrl-C 能取消登录，不会留下占着 1455 端口的登录服务）；登录页由它回调 cca _browser 打开
	local rc
	if ! login_remote; then
		has_chrome || { fail_warn no_chrome "登录需要 Google Chrome：已停止，避免使用系统浏览器的登录状态和出口"; return 1; }
		info "${ACC_NAME} 还没登录：正在它专属的浏览器窗口里打开 ChatGPT 的登录页${ACC_EMAIL:+（请用 ${ACC_EMAIL} 登录）}，登录完成后会自动继续"
	fi
	child_env
	if login_remote; then   # 和 pyenv 一样，只是要直接是一条命令：取消时 remote_login 停的是它本身
		remote_login env "${UNSETS[@]}" "${SETS[@]}" CCA_SELF="$SELF" CCA_TOOL="$TOOL" CCA_BIN="$TOOL_BIN" "${PYRUN[@]}" login-flow "$CODEX_BIN"; rc=$?
	else
		pyenv login-flow "$CODEX_BIN" 3<&- </dev/null; rc=$?
	fi
	[ $rc -eq 3 ] || return $rc
	fail_warn login_unsupported "这个版本的 codex 不支持由 cca 打开独立登录页，已停止登录。请升级 codex 后重试，避免登录页走系统默认浏览器"
	return 1
}
has_worktrees() { [ -n "$(ls -A "$ACC_HOME/worktrees" 2>/dev/null)" ]; }   # Codex 账号建过 git 工作树（删账号会一起删）

# 服务器上登录（Linux 上没有账号专属的 Chrome）：claude / codex 照常在服务器上跑登录、等本机的回调；它们要打开的登录网址经
# BROWSER（Codex 是 login-flow）回调 cca _browser，这时只写进 CCA_LOGIN_URL_FILE。cca 把它写成一行 cca login-page 命令，用户在
# Mac 上运行：Mac 上的 cca 用这个账号专属的 Chrome、经同一个节点打开登录页，接住登录后跳回 localhost 的那一下，把验证码
# （code#state）放进剪贴板；贴回服务器，cca 核对 state 后转给服务器上正在等的回调（py login-forward），换 token 照常经账号的出口
login_remote() { [ -n "${CCA_REMOTE_LOGIN:-}" ] || on_linux; }   # CCA_REMOTE_LOGIN=1：macOS 上也这样（测试用）
login_log_tail() {   # 登录命令输出的最后一句（去掉颜色、claude 的“粘贴验证码”提示和手动登录的网址）
	local esc
	esc=$(printf '\033')
	sed "s/${esc}\[[0-9;]*m//g; s/^Paste code here if prompted > //" "$1" 2>/dev/null |
		grep -v -e '^[[:space:]]*$' -e "^If the browser didn't open" -e '^Opening browser' | tail -n 1 | cut -c1-300
}
remote_login() {   # remote_login 登录命令…（先 child_env；要直接是一条命令，取消时停的是它本身）：退出码是登录命令的
(
	local dir pid="" rc line i code extra nid
	dir=$(mktemp -d "${TMPDIR:-/tmp}/cca-login.XXXXXX") || { warn "建不了临时目录，没法登录"; exit 1; }
	trap '[ -z "$pid" ] || kill -TERM "$pid" 2>/dev/null; rm -rf "$dir"' EXIT
	trap 'exit 130' INT TERM HUP
	CCA_LOGIN_URL_FILE="$dir/url" "$@" </dev/null >"$dir/log" 2>&1 3<&- &
	pid=$!
	for i in $(seq 1 120); do   # 最多等 30 秒
		[ -s "$dir/url" ] && break
		kill -0 "$pid" 2>/dev/null || break
		sleep 0.25
	done
	if [ ! -s "$dir/url" ]; then
		if ! kill -0 "$pid" 2>/dev/null; then
			wait "$pid"; rc=$?; pid=""
			[ $rc -eq 3 ] && exit 3   # Codex：这个版本不支持由 cca 打开登录页
		fi
		warn "没拿到登录网址${pid:+（等了 30 秒）}：$(login_log_tail "$dir/log")"
		exit 1
	fi
	# 官方账号一定有节点。--node-id 是节点的摘要：Mac 上按它认是不是同一个节点（叫法可以不同）；别名给 Mac 上还没有这个账号时加上它用
	extra=""
	[ -z "$ACC_ALIAS" ] || extra=" --alias $(shq "$ACC_ALIAS")"
	nid=$(py node-fp "$ACC_NODE")
	line="${CMD} login-page $(shq "${ACC_EMAIL:-$ACC_NAME}")${extra} --node $(shq "$ACC_NODE")${nid:+ --node-id $nid} $(shq "$(cat "$dir/url")")"
	say ""
	say "${C_B}${ACC_NAME} 要登录${C_0}：这台机器上没有它专属的浏览器，登录页在 Mac 上打开"
	say "1. 在 Mac 的终端里运行这一行（用 ${ACC_NAME} 专属的 Chrome、经同一个节点 ${ACC_NODE} 打开登录页；Mac 上还没有这个账号的话，会问要不要加上）："
	say ""
	say "  $line"
	say ""
	say "2. 在打开的页面上登录${ACC_EMAIL:+（用 ${ACC_EMAIL}）}。登录完，Mac 上的 cca 会把验证码复制到剪贴板"
	say "3. 回到这里粘贴验证码、回车"
	say ""
	while :; do
		code=$(ask "验证码（直接回车取消）： " "")
		if [ -z "$code" ]; then warn "已取消登录"; exit 1; fi
		kill -0 "$pid" 2>/dev/null || { warn "登录已经退出了：$(login_log_tail "$dir/log")"; exit 1; }
		printf '%s' "$code" | py login-forward "$dir/url"; rc=$?
		[ $rc -eq 2 ] && continue
		[ $rc -eq 0 ] || exit 1
		break
	done
	code=""
	wait "$pid"; rc=$?; pid=""
	[ $rc -eq 0 ] || warn "登录没有成功：$(login_log_tail "$dir/log")"
	exit $rc
)
}

cmd_login_page() {   # cca [codex|agy] login-page <账号> [--alias 别名] [--node 节点 [--node-id 摘要]] <登录网址>（在 Mac 上）：服务器上登录时
	# 它给出这一行。用这个账号专属的 Chrome、经同一个节点打开登录页，接住登录后跳回 localhost 的验证码（code#state），放进剪贴板、
	# 打到 stdout。节点按摘要认（两边叫法可以不同）；这台 Mac 上还没有这个账号时问要不要用同一个节点加上它。
	# agy 的登录页登录后跳到 antigravity.google 的页面上显示授权码（不回 localhost）：只打开登录页，用户自己把授权码抄回服务器
	local who="" node="" nid="" alias="" url="" key code rc plan LP_KEY LP_NODE LP_ALIAS
	local use="用法: ${CMD} login-page <账号> [--alias 别名] [--node 节点 [--node-id 摘要]] <登录网址>"
	while [ $# -gt 0 ]; do
		case "$1" in
			--node|--node-id|--alias) [ $# -ge 2 ] || die "$1 后面要写值"
				case "$1" in --node) node=$2 ;; --node-id) nid=$2 ;; *) alias=$2 ;; esac; shift 2 ;;
			--node=*) node=${1#--node=}; shift ;;
			http://*|https://*) url=$1; shift ;;
			*) [ -z "$who" ] || die "$use"; who=$1; shift ;;
		esac
	done
	[ -n "$who" ] && [ -n "$url" ] || die "${use}（服务器上的 cca 登录时会给出这一整行）"
	login_remote && die "这台机器上没有账号专属的浏览器：在 Mac 上运行这一行"
	py login-check "$url" || exit 1
	plan=$(py login-page-acct "$who" "$node" "$nid" "$alias") || exit 1
	eval "$plan"
	has_chrome || { fail_warn no_chrome "没装 Google Chrome：登录页要在账号专属的 Chrome 里打开"; exit 1; }
	key=$LP_KEY
	if [ -z "$key" ]; then   # 这台 Mac 上还没有这个账号：用服务器上的那个节点（这边的叫法）加上它
		need_tty
		confirm "这台 Mac 上还没有 ${LP_ALIAS:+${LP_ALIAS}（}${who}${LP_ALIAS:+）}：现在加上它吗（出口 ${LP_NODE}）？" y || { info "没有加上，也没打开登录页"; return 1; }
		key=$(py add "$who" "$LP_ALIAS" "$LP_NODE") || exit 1
		account_added "$key"
		[ "$TOOL" != codex ] || codex_alias_ensure "$ACC_NAME"
	fi
	eval "$(py env "$key")"
	sync_if_changed   # 账号表可能刚按维护者的映射改过：先让路由器跟上，免得经旧的节点出去
	preflight app || exit 1
	prepare_account "$ACC_KEY" || die "初始化账号目录失败"
	if [ "$TOOL" = agy ]; then
		info "正在 ${ACC_NAME} 专属的浏览器里打开 Google 的登录页（经 ${ACC_PROXY:-直连} → ${ACC_NODE}）${ACC_EMAIL:+，请用 ${ACC_EMAIL} 登录}"
		open_chrome "$(py login-url "$ACC_KEY" "$url" || printf '%s' "$url")" || exit 1   # 补上 login_hint（服务器上一般已经补过）
		okay "登录完页面上会显示授权码：复制它，回到服务器的终端粘贴、回车"
		return 0
	fi
	child_env
	info "正在 ${ACC_NAME} 专属的浏览器里打开登录页（经 ${ACC_PROXY:-直连} → ${ACC_NODE}）${ACC_EMAIL:+，请用 ${ACC_EMAIL} 登录}；登录完这里会拿到验证码"
	code=$(pyenv login-catch "$url" "${CCA_LOGIN_WAIT:-900}"); rc=$?   # 最多等 15 分钟（CCA_LOGIN_WAIT 秒：测试用）
	case $rc in
		0) okay "拿到验证码了，已经复制到剪贴板：回到服务器的终端粘贴、回车" ;;
		3) okay "拿到验证码了（没能放进剪贴板）：复制下面这一行，回到服务器的终端粘贴、回车" ;;
		4) warn "这台 Mac 上的端口 ${code} 被别的程序占着，接不住登录后跳回来的那一页：登录完浏览器会显示打不开或别的页面，把地址栏里的整个网址（http://localhost:${code}/… 开头）复制下来，贴回服务器"
		   return 0 ;;
		*) exit 1 ;;
	esac
	printf '%s\n' "$code"
}

cmd_login() {   # cca [codex] login <账号>：退出这个账号现在的登录，重新登录
	local key
	key=$(py resolve "${1:-}") || die "用法: ${CMD} login <账号>"
	need_tty
	need_bin
	eval "$(py env "$key")"
	[ "$ACC_KIND" = api ] && die "${ACC_NAME} 是第三方 API 账号，不用登录（换 key 用 ${CMD} key ${ACC_NAME}）"
	sync_if_changed
	preflight || exit 1
	prepare_account "$key" || die "初始化账号目录失败"
	[ -n "$(auth_email)" ] && tool wipe
	ensure_login || exit 1
	okay "${ACC_LABEL} 已重新登录"
}

cmd_rm() {
	local key pid rc msg wt="" refk=""
	key=$(py resolve "${1:-}") || die "用法: ${CMD} rm <账号>"
	need_tty
	eval "$(py env "$key")"
	pid=$(tool app_pid "$ACC_DESKTOP_DIR"); rc=$?
	[ "$rc" -le 1 ] || die "无法查询 ${APP_LABEL} 进程，已停止删除；请稍后重试"
	[ -z "$pid" ] || FAIL_CODE=app_running die "${ACC_LABEL} 的 ${APP_LABEL} 还开着：先退出它再删除"
	[ "$ACC_KIND" = api ] || [ "$(py secret-status "$ACC_KEY")" != ref ] || refk="、记下的 API key"
	if [ "$ACC_KIND" = api ]; then
		msg="删除第三方 API 账号 ${ACC_LABEL}？（删除${KEYSTORE}里它的 key 和账号目录；共享的记忆/会话不受影响）"
	elif [ "$TOOL" = codex ]; then
		if has_worktrees; then
			wt="${ACC_HOME}/worktrees 里有这个账号建的 git 工作树，会一起删掉（还没提交的改动先处理好）"
			warn "$wt"
		fi
		msg="删除账号 ${ACC_LABEL}？（退出登录，删除它的登录凭证${refk}、浏览器资料和 ChatGPT App 资料；共享的记忆/会话不受影响）"
	elif [ "$TOOL" = agy ]; then
		msg="删除账号 ${ACC_LABEL}？（退出登录，删除它的登录凭证${refk}和浏览器资料；共享的会话、记忆和设置不受影响）"
	else
		msg="删除账号 ${ACC_LABEL}？（退出登录、删除它的${KEYSTORE_CRED}${refk}、浏览器资料和 Claude App 资料；共享的记忆/会话不受影响）"
	fi
	confirm "$msg" n q=rm.confirm "title=删除账号" "detail=$wt" severity=warn || return 0
	py link "$key" >/dev/null 2>&1   # 先把会话里新产生的共享内容并回共享主目录（Codex 顺便把会话库里的路径改到 ~/.codex）
	py sync "$key" >/dev/null 2>&1
	logout_account
	rm -rf "${ACC_DIR:?}"
	py rm "$key"
	[ -z "$ACC_PORT" ] || router_sync_soon || gui_fail sync_failed "路由器同步没完成：修好后运行 cca router sync"   # 直连的第三方 API 账号不占端口，路由器那边没有要改的
	launchers_sync
	info "已删除账号 ${ACC_LABEL}"
	gui_done removed "已删除账号 ${ACC_LABEL}"
}

cmd_list() {
	local i=0 r
	[ -n "$(py keys)" ] || { info "还没有账号（${CMD} add）"; return 0; }
	say ""
	while IFS= read -r r; do i=$((i + 1)); say "  ${i}. ${r}"; done < <(py rows "$(term_cols)")
	say ""
	[ -n "$(py ports named)" ] || return 0   # 只有直连的第三方 API 账号：没有端口要看
	if ! want_local; then
		router_ready && verify_ports
	else
		load_local
		if local_ready; then verify_ports 127.0.0.1; else info "现在连不上路由器：在外面要先配置本机 Clash（cca local setup）"; fi
	fi
	return 0
}

menu() {   # 选中的账号别名打印到 stdout
	local last cur=0 n=0 i k choice add="＋ 添加新账号"
	[ "$TOOL" = claude ] || add="＋ 添加 ${TOOL_LABEL} 账号"
	local -a keys rows
	while IFS= read -r k; do [ -n "$k" ] && { keys[n]="$k"; n=$((n + 1)); }; done < <(py keys)
	i=0
	while IFS= read -r k; do rows[i]="$k"; i=$((i + 1)); done < <(py rows "$(term_cols)")
	last=$(py get last)
	for ((i = 0; i < n; i++)); do [ "${keys[i]}" = "$last" ] && cur=$i; done
	if fancy_ok; then
		say ""
		say "${C_B}选择 ${TOOL_LABEL} 账号${C_0}    ${C_D}↑↓ 移动 · 回车确认 · 数字键直接选 · q 退出${C_0}"
		say ""
		if [ "$TOOL" = agy ]; then arrow_menu "$cur" "${rows[@]}" "$add" "退出"   # agy 没有第三方 API 账号
		else arrow_menu "$cur" "${rows[@]}" "$add" "＋ 添加第三方 API 账号" "退出"; fi
		say ""
		[ "$MENU_PICK" -ge 0 ] || return 1
		if [ "$MENU_PICK" -lt "$n" ]; then echo "${keys[MENU_PICK]}"; return 0; fi
		case $((MENU_PICK - n)) in
			0) cmd_add >&2 && { py keys | tail -n 1; return 0; } ;;
			1) [ "$TOOL" = agy ] || { cmd_add_api >&2 && { py keys | tail -n 1; return 0; }; } ;;
		esac
		return 1
	fi
	while :; do   # 没有完整终端时：输入编号
		say ""
		say "${C_B}选择 ${TOOL_LABEL} 账号${C_0}"
		say ""
		for ((i = 0; i < n; i++)); do say "  $((i + 1)). ${rows[i]}"; done
		say ""
		[ -n "$last" ] && say "  回车   继续使用 $(py name "$last")"
		say "  编号   切换到对应账号"
		say "  a      添加新账号"
		[ "$TOOL" = agy ] || say "  p      添加第三方 API 账号"
		say "  q      退出"
		say ""
		choice=$(ask "请选择：" "")
		if [ -z "$choice" ]; then
			[ -n "$last" ] && { echo "$last"; return 0; }
			choice=1
		fi
		case "$choice" in
			q|Q) return 1 ;;
			a|A|n|N) cmd_add >&2 && { py keys | tail -n 1; return 0; } ;;
			p|P) [ "$TOOL" != agy ] || { warn "${TOOL_LABEL} 没有第三方 API 账号"; continue; }
			     cmd_add_api >&2 && { py keys | tail -n 1; return 0; } ;;
			*[!0-9]*) warn "没看懂「${choice}」：请输入编号、a、p 或 q" ;;
			*) if [ "$choice" -ge 1 ] && [ "$choice" -le "$n" ]; then echo "${keys[choice - 1]}"; return 0; fi
			   warn "没有编号 ${choice}" ;;
		esac
	done
}

pick_account() {   # 参数给了就解析参数，否则交互选择
	if [ -n "${1:-}" ]; then py resolve "$1"; return; fi
	[ -n "$(py keys)" ] || die "还没有账号（${CMD} add）"
	menu
}

# 这次走哪条路：在家走路由器的端口池；连不上路由器（出门在外）走本机 Clash 客户端的端口池（见下面"出门在外"一节）
probe() {   # probe 主机 端口…：任一端口 1 秒内连得上就返回 0（并行探测，在外面时最多等 1 秒）
	local h="$1" p ok=1
	local -a pids=()
	shift
	for p in "$@"; do
		if [ "$(uname)" = Darwin ]; then nc -z -G 1 "$h" "$p" >/dev/null 2>&1 & else nc -z -w 1 "$h" "$p" >/dev/null 2>&1 & fi
		pids+=($!)
	done
	for p in "${pids[@]}"; do wait "$p" && ok=0; done
	return $ok
}
at_home() {   # 连得上路由器（SSH 端口或端口池的第一个端口）就算在家；一次命令只探测一次
	if [ -z "${AT_HOME:-}" ]; then
		load_router
		AT_HOME=no
		[ -n "$ROUTER_HOST" ] && probe "$ROUTER_HOST" "$ROUTER_PORT" "$POOL_FIRST" && AT_HOME=yes
	fi
	[ "$AT_HOME" = yes ]
}
want_local() {   # 这次走本机 Clash 吗：按 config.json 的 route（CCA_ROUTE 可临时指定）；auto 时看连不连得上路由器
	load_router
	case "${CCA_ROUTE:-$ROUTE_PREF}" in router) return 1 ;; local) return 0 ;; esac
	! at_home
}
pick_route() {   # 需要先 eval "$(py env 名称)"；结果在 ROUTE（router|local）和 ACC_PROXY 里
	if want_local; then route_local; else route_router; fi
}
router_ensure() {   # 让路由器确认端口池在，并把各槽位切到账号的节点（API，无需重载；要重载时先问）
	local out rc attempt
	router_ready || { fail_warn no_router "无法核实路由器账号节点：还没配置路由器（cca router setup）"; return 1; }
	for attempt in 1 2; do
		out=$(rsh "$RDIR/cca-router.sh ensure-now" </dev/null 2>&1); rc=$?   # </dev/null：不让 ssh 读走调用方的 stdin
		[ -n "$out" ] && printf '%s\n' "$out" | LC_ALL=C sed 's/^/  │ /' >&2
		[ $rc -eq 0 ] && return 0
		[ $attempt -eq 1 ] || break
		# 节点改名后重新部署，或获准重载后，再核实一次实际选中节点。端口开放不能替代这一步。
		if [ $rc -ne 255 ] && nodes_follow; then
			router_push || break
			if [ -n "${ACC_KEY:-}" ]; then
				out=$(py env "$ACC_KEY") || break
				eval "$out"
			fi
		elif [ $rc -eq 3 ] && allow_reload "$out"; then
			router_reload || break
		else
			break
		fi
	done
	fail_warn sync_failed "路由器账号节点未能核实，已停止使用端口池（避免走错出口）。排查：cca router status / cca router sync"
	return 1
}
route_router() {   # 在家：经路由器的端口池
	[ -n "$ACC_PROXY" ] || { fail_warn no_router "还没配置路由器（cca router setup）"; TOOL=claude gui_terminal router_setup "还没配置路由器：在终端里配置一次" router setup; return 1; }
	load_router
	router_ensure || return 1
	port_open "$PROXY_HOST" "$ACC_PORT" || {
		fail_warn port_closed "端口 ${PROXY_HOST}:${ACC_PORT} 不通。为避免走错出口，已停止。排查：cca router status / cca router sync"
		return 1
	}
	core_nodes_hook   # 在外面会走内置代理的机器：节点定义旧了就在后台从路由器拷一份新的
	ROUTE=router
}
route_note() {   # 给提示用：走的是哪个端口
	case "${ROUTE:-}" in
		local) printf '本机 %s 端口 %s' "$LOCAL_NAME" "$ACC_PORT" ;;
		direct) printf '直连' ;;
		*) printf '端口 %s' "$ACC_PORT" ;;
	esac
}

# 第三方 API 账号：接口地址经账号的出口连得上（不带 key；收到任何 HTTP 响应都算连得上）。结果在 COFFEE_LINE
api_check() {
	local code i
	local -a via=(--noproxy '*')
	[ -n "$ACC_PROXY" ] && via=(--noproxy '' -x "$ACC_PROXY")
	for i in 1 2; do
		code=$(curl -q -s -o /dev/null -m 8 -w '%{http_code}' "${via[@]}" "$ACC_BASE_URL" 2>/dev/null)
		case "$code" in ''|000) ;; *) COFFEE_LINE="接口连得上"; health_note api_ok; return 0 ;; esac
	done
	COFFEE_LINE="连不上 ${ACC_BASE_URL}（$(route_note)）"
	health_note api_unreachable
	return 1
}
health_note() {   # health_note 结果：没有出口检测数据的结果（第三方 API 账号、端口不通）也记进 health.json，见 cmd_health_note
	local kind=exit
	[ "$ACC_KIND" = api ] && kind=api
	HEALTH_JSON=$(py health-note "$ACC_KEY" "${HEALTH_SOURCE:-launch}" "$kind" "$1" "${ROUTE:-}" "${ACC_PORT:+$ACC_NODE}" "$ACC_PORT" \
		"${COFFEE_LINE:-}" 2>/dev/null)
}
settings_warn() {
	gui_fail settings_conflict "共享的设置里有会盖掉账号自己的代理、接口地址或凭证的配置（${1}）"
	case "$TOOL" in
		codex) warn "共享的 ~/.codex 里有会把账号的登录发到别处、换掉账号或出口的配置（${1}）。删掉或改掉后再用 cca codex 启动（第三方 API 用 cca codex add api 加成账号）" ;;
		agy) warn "共享的 ~/.gemini 里有会让各账号用同一个 Google Cloud 项目、换掉账号或凭证的配置（${1}）。删掉后再用 cca agy 启动" ;;
		*) warn "共享的设置里有会盖掉每个账号自己的代理、接口地址或凭证的配置（${1}）。删掉后再用 cca 启动（第三方 API 用 cca add api 加成账号）" ;;
	esac
}

# 经账号端口检测出口：claude.ai（Codex 账号是 chatgpt.com）看到的 IP + ip.net.coffee 的风险数据（不上报会话）
coffee_check() {   # coffee_check [region | 开始时间]：region 时只看出口地区（不查 ip.net.coffee 的纯净度、不测泄露，查用量前用）；
	               # 别的时候同时在后台测 DNS / WebRTC 泄露（给了开始时间时 DNS 不用那之前的缓存：cca check），结果在 LEAK_*
	local trace ip loc risk="" out rc min="$CCA_MIN_TRUST"
	LEAK_LINE="" LEAK_DNS="" LEAK_WEBRTC="" LEAK_WEBRTC_NOTE="" LEAK_DNS_STATE="" LEAK_WEBRTC_STATE="" HEALTH_JSON=""
	[ "${1:-}" = region ] || leak_start "${1:-}"
	trace=$(curl -q --noproxy '' -s -m 8 -x "$ACC_PROXY" "https://${TRACE_HOST}/cdn-cgi/trace" 2>/dev/null)
	ip=$(printf '%s\n' "$trace" | sed -n 's/^ip=//p')
	loc=$(printf '%s\n' "$trace" | sed -n 's/^loc=//p')
	if [ "${1:-}" = region ]; then min=0
	elif [ -n "$ip" ]; then risk=$(curl -q --noproxy '' -s -m 12 -x "$ACC_PROXY" "https://ip.net.coffee/api/iprisk/$ip" 2>/dev/null); fi
	out=$(py coffee "$min" "$trace" "$risk")
	rc=$?
	COFFEE_IP="$ip"
	COFFEE_LINE=$(printf '%s\n' "$out" | head -n 1)
	COFFEE_NOTE=$(printf '%s\n' "$out" | sed -n '2,$p')
	case $rc in 0|1|4) leak_finish "$ip" "$loc" "${1:-}" ;; *) leak_finish ;; esac   # 出口本身就不对（受限地区、拿不到 IP）时不用等它
	# 记进账号目录的 health.json（图形界面不联网也能显示上次的出口）；cca check --json 用 HEALTH_JSON
	[ "${1:-}" = region ] || HEALTH_JSON=$(py health-save "$ACC_KEY" "${HEALTH_SOURCE:-launch}" "${ROUTE:-}" "$ACC_NODE" "$ACC_PORT" "$min" \
		"$trace" "$risk" "$LEAK_LINE" "$LEAK_DNS" "${LEAK_WEBRTC:-$LEAK_WEBRTC_NOTE}" "$LEAK_DNS_STATE" "$LEAK_WEBRTC_STATE" 2>/dev/null)
	return $rc
}
leak_start() {   # leak_start [cca check 开始的时间]：后台开始 DNS / WebRTC 泄露检测（py leak-probe，最多 5 秒左右）。服务器上（login_remote）
	              # 没有账号专属的浏览器和桌面 App，WebRTC 只在它们里面：不测、不说
	local rtc=1
	LEAK_PID="" LEAK_OUT=""
	login_remote && rtc=0
	# 模板写全：GNU、busybox 的 mktemp -t 要模板里有 X，没有就失败（Linux 上以前一直没测成）
	LEAK_OUT=$(mktemp "${TMPDIR:-/tmp}/cca-leak.XXXXXX" 2>/dev/null) || return 0
	py leak-probe "$ACC_PROXY" "${ROUTE}|${ACC_NODE}" "${1:-}" "$rtc" > "$LEAK_OUT" 2>/dev/null &
	LEAK_PID=$!
}
leak_finish() {   # leak_finish [出口IP 出口地区 [cca check 开始的时间]]：等后台的检测，汇总成 LEAK_LINE（横幅里的一句）、
	                # LEAK_DNS / LEAK_WEBRTC（泄露时的说明，要警告的）、LEAK_WEBRTC_NOTE（只作提醒的说明）。不给出口 IP 时不等它、不汇总（它自己几秒内就结束）
	local out kind tag msg
	[ -n "${LEAK_PID:-}" ] || return 0
	if [ -n "${1:-}" ]; then
		wait "$LEAK_PID" 2>/dev/null
		out=$(py leak-verdict "$LEAK_OUT" "${ROUTE}|${ACC_NODE}" "$1" "${2:-}" "${3:-}")
		LEAK_LINE=$(printf '%s\n' "$out" | head -n 1)
		while IFS=$'\t' read -r kind tag msg; do
			case "$kind" in
				W) case "$tag" in dns) LEAK_DNS="$msg" ;; webrtc) LEAK_WEBRTC="$msg" ;; esac ;;
				N) case "$tag" in webrtc) LEAK_WEBRTC_NOTE="$msg" ;; esac ;;
				S) case "$tag" in dns) LEAK_DNS_STATE="$msg" ;; webrtc) LEAK_WEBRTC_STATE="$msg" ;; esac ;;
			esac
		done <<< "$out"
	fi
	rm -f "$LEAK_OUT"
	LEAK_PID="" LEAK_OUT=""
}
leak_show() {   # leak_show 缩进：横幅（cca check 的每一行）下面那一句；有泄露时用黄色
	[ -n "$LEAK_LINE" ] || return 0
	if [ -n "$LEAK_DNS$LEAK_WEBRTC" ]; then say "${1}${C_Y}${LEAK_LINE}${C_0}"; else say "${1}${LEAK_LINE}"; fi
}

prepare_account() {   # 合并账号内原子保存的共享配置后，再校验实际将使用的配置。
	local bad
	py link "$1" && py sync "$1" || return 1
	if ! bad=$(py settings-check); then settings_warn "$bad"; return 1; fi
}

preflight() {   # preflight [app]：账号的出口必须可用且干净，否则不启动（避免走错出口）。顺带测 DNS / WebRTC 泄露（只提示，不拦）：
	             # DNS 泄露影响这个账号的一切；WebRTC 泄露在网页和 App 里，打开 App 时（app）、要在浏览器里登录时才另外说明
	local bad rc
	COFFEE_LINE=""
	if [ -n "$ACC_PORT" ]; then pick_route || return 1; else ROUTE=direct; fi   # 直连的第三方 API 账号不经端口
	if ! bad=$(py settings-check); then settings_warn "$bad"; return 1; fi
	[ -n "${CCA_SKIP_CHECK:-}" ] && return 0
	if [ "$ACC_KIND" = api ]; then   # claude.ai / chatgpt.com 的出口检测和第三方服务无关：只看接口连不连得上
		api_check && return 0
		fail_warn api_unreachable "${COFFEE_LINE}"
		warn "已停止启动：确认地址没写错、服务商没出问题（确定没问题可以加 CCA_SKIP_CHECK=1 跳过检测）"
		return 1
	fi
	coffee_check
	rc=$?
	[ -z "$LEAK_DNS" ] || warn "$LEAK_DNS"
	[ -z "$LEAK_WEBRTC" ] || [ "${1:-}" != app ] || warn "$LEAK_WEBRTC"
	case $rc in
		0) ;;
		4) warn "出口检测没拿到评分（${COFFEE_LINE}），先继续" ;;
		1)
			warn "出口纯净度偏低：${COFFEE_LINE}"
			consent low_purity "$COFFEE_IP" "出口纯净度偏低" "仍然用这个出口启动吗？" "${COFFEE_LINE}${COFFEE_NOTE:+（${COFFEE_NOTE}）}" n ||
				{ gui_fail low_purity "出口纯净度偏低：${COFFEE_LINE}"; return 1; } ;;
		*)
			if [ $rc -eq 2 ]; then gui_fail region_restricted "${COFFEE_LINE}${COFFEE_NOTE:+：${COFFEE_NOTE}}"; else gui_fail no_exit_ip "${COFFEE_LINE}"; fi
			warn "${COFFEE_LINE}"
			[ -n "$COFFEE_NOTE" ] && warn "$COFFEE_NOTE"
			warn "已停止启动。可以用 ${CMD} edit 给这个账号换个节点"
			return 1 ;;
	esac
	return 0
}

# 程序坞：cca 打开的 App 实例（账号的 Chrome、桌面 App）、终端交接用完退出的系统终端，退出以后去掉程序坞「最近使用的 App」里留下的图标
# （见 py 的程序坞一节）。等它退出、整理的进程经 open 当作一个后台小 App（DOCK_APP，LSBackgroundOnly：不在程序坞里出现）来跑：
# 直接从 cca 起的话，它算调用 cca 的那个 App（终端交接时是系统终端）的下属（setsid、disclaim、launchctl submit 都一样，实测），
# 那个 App 退出以后 LaunchServices 还留着它的记录，整理时重启的程序坞照着记录又把它加回去。
# 小 App 里是一个很小的 Python 等那个实例退出（kqueue，不轮询，十来 MB），退出了再换成 cca _dock-tidy App 去整理。
# 同一个实例只留一个在等（锁文件：账号的 Chrome 每次被 cca 用到都会来一次）
DOCK_DIR="${PYC_DIR:+${PYC_DIR%/cca-py}/cca-dock}"
[ -z "${CCA_DOCK_PREFS:-}" ] || DOCK_DIR="${CCA_DOCK_PREFS%/*}/cca-dock"   # 测试：程序坞的设置是沙箱里的文件，排队、等待的记录也放在它旁边
DOCK_APP="$CCA_HOME/dock/cca-dock.app"
DOCK_APP_SH='#!/bin/bash
# cca 生成的后台小 App：等 cca 打开的 App 实例退出，整理程序坞（cca _dock-wait）。经 open 启动，不算调用 cca 的那个 App 的下属
export PATH="${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin"
while [ "$#" -gt 0 ]; do case "$1" in -psn_*) shift ;; *) break ;; esac; done
[ "$#" -eq 4 ] || exit 0
export CCA_PYTHON="$2"   # 和起它的 cca 用同一个 python3（这里的 PATH 是 launchd 的，找到的不一定是那一个）
exec "$1" _dock-wait "$3" "$4" </dev/null >/dev/null 2>&1'
DOCK_APP_PLIST='<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key><string>cca-dock</string>
	<key>CFBundleIdentifier</key><string>local.cca.dock</string>
	<key>CFBundleName</key><string>cca-dock</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>1.0</string>
	<key>CFBundleVersion</key><string>1</string>
	<key>LSBackgroundOnly</key><true/>
</dict>
</plist>'
DOCK_WAIT='import fcntl, os, select, sys
pid, d, argv = int(sys.argv[1]), sys.argv[2], sys.argv[3:]
lock = None
if d:
    try:
        os.makedirs(d, 0o700, exist_ok=True)
        lock = open(os.path.join(d, "%d.wait" % pid), "a")
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        sys.exit(0)
    except OSError:
        lock = None
kq = select.kqueue()
try:
    kq.control([select.kevent(pid, select.KQ_FILTER_PROC, select.KQ_EV_ADD | select.KQ_EV_ONESHOT, select.KQ_NOTE_EXIT)], 0, 0)
    kq.control(None, 1)
except OSError:
    pass
if lock:
    try:
        os.unlink(lock.name)
    except OSError:
        pass
try:
    os.execv(argv[0], argv)
except OSError:
    pass'
dock_app() {   # 后台小 App 的路径（没有、内容不对就重写）
	local c="$DOCK_APP/Contents"
	if [ "$(cat "$c/MacOS/cca-dock" 2>/dev/null)" != "$DOCK_APP_SH" ] || [ "$(cat "$c/Info.plist" 2>/dev/null)" != "$DOCK_APP_PLIST" ]; then
		mkdir -p "$c/MacOS" || return 1
		printf '%s\n' "$DOCK_APP_PLIST" > "$c/Info.plist.tmp" && mv -f "$c/Info.plist.tmp" "$c/Info.plist" || return 1
		printf '%s\n' "$DOCK_APP_SH" > "$c/MacOS/cca-dock.tmp" && chmod 755 "$c/MacOS/cca-dock.tmp" && mv -f "$c/MacOS/cca-dock.tmp" "$c/MacOS/cca-dock" || return 1
	fi
	printf '%s\n' "$DOCK_APP"
}
dock_hand() {   # dock_hand 进程号 App：交给后台小 App 等这个实例退出、整理程序坞（已经退出了也交：小 App 马上整理）；不占这条命令的时间。
	# 锁（fd 9）、答案管道（fd 3）不带过去；config.json 里关掉了就不起（py 那边整理前还会再看）
	local a
	grep -Eq '"dock_tidy"[[:space:]]*:[[:space:]]*false' "$CFG" 2>/dev/null && return 0
	a=$(dock_app) || return 0
	( open -g -j -n -a "$a" --args "$SELF" "$PYTHON" "$1" "$2" </dev/null >/dev/null 2>&1 3<&- 4<&- 9>&- & )
	return 0
}
dock_watch() {   # dock_watch 进程号 App：cca 打开、用到的实例（还开着的）退出以后整理程序坞
	[ -n "${1:-}" ] && [ -n "${2:-}" ] || return 0
	kill -0 "$1" 2>/dev/null || return 0
	dock_hand "$1" "$2"
}
cmd_dock_tidy() {   # cca _dock-tidy App [进程号]：带进程号时交给后台小 App 等它退出（终端交接的脚本退出系统终端以后也这样调，PROTOCOL 6）
	case "${2:-}" in
		'') CCA_SELF="$SELF" exec "${PYRUN[@]}" dock-tidy "${1:-}" "$DOCK_DIR" ;;
		*[!0-9]*) die "用法: cca _dock-tidy App [进程号]" ;;
		*) [ -z "${1:-}" ] || dock_hand "$2" "$1" ;;
	esac
}
cmd_dock_wait() {   # cca _dock-wait 进程号 App：后台小 App 里跑的，等那个实例退出（已经没了就不等），再换成 cca _dock-tidy App
	case "${1:-}" in ''|*[!0-9]*) return 0 ;; esac
	exec "$PYTHON" -I -c "$DOCK_WAIT" "$1" "$DOCK_DIR" "$SELF" _dock-tidy "${2:-}"
}

chrome_app_path() {
	local app
	for app in /Applications/Google\ Chrome.app "$HOME/Applications/Google Chrome.app"; do
		[ -d "$app" ] && { printf '%s' "$app"; return 0; }
	done
	return 1
}
has_chrome() { chrome_app_path >/dev/null; }
mac_only() {   # mac_only 说明：要账号专属的 Chrome、桌面 App 或界面 App 的功能，Linux（服务器）上没有：说清楚、退出（不说"没装 Chrome"）
	on_linux || return 0
	die "${1}只在 macOS 上；这台 Linux 上用命令行：${CMD} @账号 启动，${CMD} help 看能用的命令"
}

chrome_pid() { app_pid 'Google Chrome' "$ACC_CHROME_DIR"; }

chrome_launch_lock() {
	exec 9>"$ACC_DIR/browser-launch.lock" || return 1
	"$PYTHON" -I -c 'import fcntl, sys
try:
    fcntl.flock(9, fcntl.LOCK_EX | fcntl.LOCK_NB)
except OSError:
    sys.exit(1)'
}

chrome_open_url() {
	open -n -a "$1" --args --user-data-dir="$ACC_CHROME_DIR" --no-first-run --no-default-browser-check \
		--proxy-server="$ACC_PROXY" --webrtc-ip-handling-policy=disable_non_proxied_udp "$2" 9>&-
}

open_chrome() {   # 子 shell 持有启动锁，所有返回路径自动释放；不终止已有浏览器窗口。
(
	local url="$1" app pid i rc ready=""
	case "$url" in
		http://*|https://*) ;;
		*) fail_warn invalid_url "浏览器地址必须以 http:// 或 https:// 开头"; return 1 ;;
	esac
	if ! has_chrome; then
		fail_warn no_chrome "没装 Google Chrome，已停止打开：系统默认浏览器不能保证使用这个账号的资料目录和出口"
		return 1
	fi
	app=$(chrome_app_path) || return 1
	ACC_CHROME_DIR=$(py private-profile "$ACC_KEY" browser) || return 1
	command -v lsof >/dev/null 2>&1 || { fail_warn open_failed "找不到 lsof，无法核验账号浏览器的资料目录"; return 1; }
	chrome_launch_lock || { fail_warn open_failed "账号浏览器正在启动，请稍后再试"; return 1; }
	pid=$(chrome_pid); rc=$?
	[ "$rc" -le 1 ] || { fail_warn open_failed "无法查询 Chrome 进程，已停止打开，未修改浏览器偏好"; return 1; }
	if [ -n "$pid" ]; then
		py runtime-record check "$ACC_KEY" browser "$pid" "$ACC_CHROME_DIR" "$app" "$ACC_PROXY" || {
			fail_warn open_failed "浏览器的启动条件无法核验或出口已变化：请退出这个账号的 Chrome，再用 cca 打开"
			return 1
		}
		app_profile_in_use "$pid" "$ACC_CHROME_DIR" || { fail_warn open_failed "无法核验已有 Chrome 的账号资料目录，请退出后重开"; return 1; }
		dock_watch "$pid" "$app"   # 以前的版本打开的也等（已经有一个在等就不再起）
	else
		py browser-profile prepare "$ACC_KEY" || return 1
		# 先启动空白页，核验后才主动交付目标网址；Chrome 自身仍可能恢复旧标签或发起后台请求。
		chrome_open_url "$app" about:blank || return $?
		for i in $(seq 1 40); do
			pid=$(chrome_pid); rc=$?
			[ "$rc" -le 1 ] || { fail_warn open_failed "无法查询本次 Chrome 进程，未打开目标网址；请退出空白窗口后重试"; return 1; }
			if [ -n "$pid" ] && app_profile_in_use "$pid" "$ACC_CHROME_DIR"; then ready=1; break; fi
			sleep 0.25
		done
		[ -n "$ready" ] || { fail_warn open_failed "无法核验 Chrome 使用账号自己的资料目录，未打开目标网址；请退出空白窗口后重试"; return 1; }
		py runtime-record write "$ACC_KEY" browser "$pid" "$ACC_CHROME_DIR" "$app" "$ACC_PROXY" || return 1
		dock_watch "$pid" "$app"   # 退出以后程序坞不留它的图标
	fi
	chrome_open_url "$app" "$url"
)
}

cmd_web() {   # cmd_web [账号] [网址] [给人看的叫法] [mail]：网页版：claude.ai，Codex 账号是 chatgpt.com（和出口检测是同一个网站），
	# Antigravity 账号是 antigravity.google（WEB_URL）。
	# mail 时打开后把账号的邮箱放进剪贴板：控制台这些登录页不认网址里的邮箱参数（实测），要登录时粘贴，免得在这个账号的浏览器里登错号
	local key site="${WEB_URL#https://}" what="${3:-}" note=""
	site="${site%%/*}"
	mac_only "${what:-网页版}要在账号专属的 Chrome 里打开，"
	key=$(pick_account "${1:-}") || return 0
	eval "$(py env "$key")"
	[ "$ACC_KIND" = api ] && FAIL_CODE=api_account die "${ACC_NAME} 是第三方 API 账号：${what:-网页版}只能用官方账号"
	has_chrome || { fail_warn no_chrome "没装 Google Chrome，已停止打开：请先安装 Chrome，再使用账号的独立浏览器"; return 1; }
	gui_step sync
	sync_if_changed   # 账号表可能刚按维护者的映射改过：先让路由器跟上，免得经旧的节点出去
	gui_step preflight
	preflight app || exit 1
	prepare_account "$ACC_KEY" || die "初始化账号目录失败"
	# 还没登录就先登录（同一个浏览器实例，登录一次两边都能用；Claude 的登录页预填邮箱）
	if [ -n "$ACC_EMAIL" ] && [ -n "$TOOL_BIN" ] && interactive; then
		ensure_login || exit 1
	fi
	gui_step open
	open_chrome "${2:-https://${site}/}" || { fail_warn open_failed "打开账号的独立浏览器失败"; return 1; }
	if [ "${4:-}" = mail ] && [ -n "$ACC_EMAIL" ] && printf '%s' "$ACC_EMAIL" | pbcopy 2>/dev/null; then
		note="；要登录的话，邮箱 ${ACC_EMAIL} 已经复制好，粘贴即可"
	fi
	what="${what:-${2:-$site}}"
	info "已用 ${ACC_NAME} 的浏览器实例打开 ${what}（经 ${ACC_PROXY} → ${ACC_NODE}）${note}"
	gui_result opened "已用 ${ACC_NAME} 的浏览器实例打开 ${what}（经 ${ACC_PROXY} → ${ACC_NODE}）${note}"
}

cmd_billing() {   # cca [codex] billing [账号]：控制台的账单页。订阅附带的每月 API 额度和余额只在这里显示（两家都没有用 API Key 查余额的接口），
	# 走网页版的全部检查，用账号自己的浏览器实例和出口打开
