class ConfigReadError(ValueError):
    pass


def config_text(path):
    """不存在的可选配置略过；坏链接、无权限、目录和非 UTF-8 都不能当成空配置。"""
    try:
        with open(path, encoding='utf-8') as f:
            return f.read()
    except FileNotFoundError:
        if not os.path.lexists(path):
            return None
        raise ConfigReadError('unreadable_config') from None
    except (OSError, UnicodeError):
        raise ConfigReadError('unreadable_config') from None


def claude_config_problems(data, source):
    if not isinstance(data, dict):
        return [source + ':invalid_config']
    env = data.get('env', {})
    if not isinstance(env, dict):
        return [source + ':env:invalid_config']
    bad = [source + ':' + k for k in env if SETTINGS_BAD.match(k)]
    if data.get('apiKeyHelper'):
        bad.append(source + ':apiKeyHelper')
    return bad


def claude_config_file_problems(path, source=None):
    source = source or path
    try:
        content = config_text(path)
        return [] if content is None else claude_config_problems(json.loads(content), source)
    except (ConfigReadError, ValueError, RecursionError):
        return [source + ':invalid_or_unreadable_config']


def claude_settings_problems():
    return [problem for name in ('settings.json', 'settings.local.json')
            for problem in claude_config_file_problems(os.path.join(CLAUDE.master, name), name)]


