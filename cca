def cmd_secrets_forget(scope=''):
    """清掉钥匙串里已经不在账号表里的账号的 key（第三方 API 账号的、官方账号记下备查的）；scope=all 时全部清掉（cca restore）。
    官方账号记下备查的删了找不回来（控制台只在建的时候给一次全文），平时清掉时说一声（多半是 cca edit 里删掉了这个账号）"""
    c, t, _ = ctx()
    st = T.state(c)
    for ref in (False, True):
        keep = set() if scope == 'all' else {acct_id(k) for k, v in t.items() if is_api(v) != ref}
        for aid in sorted(set(st.get(kc_list(ref)) or []) - keep):
            h = kc_hints(st).get(aid)
