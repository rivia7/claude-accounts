# ---------------------------------------------------------------------------
# 路由器侧：cca-router.sh（busybox ash）与 apply.rb（OpenClash 自带 ruby）
# ---------------------------------------------------------------------------
router_sh() {
	cat <<'SH'
#!/bin/sh
# cca-router：由 Mac 上的 cca 部署和管理，请勿手改（会被覆盖）。
# 在 OpenClash(mihomo) 里维护一个账号端口池：槽位 n = mixed 入站 cca-n（端口 base+n）+ select 策略组 CCA-n。
# 账号分到哪个槽位、用哪个节点，只靠 API 切换 CCA-n 的选中项，不需要重载；
# 只有槽位数量或可选节点变化（即"结构"变化）才需要重载，且必须由 Mac 端征得同意（CCA_ALLOW_RELOAD=1）。
# 重载期间（本机约 20 秒）内核只处理内部连接，局域网的新连接会失败，所以 cron 自愈从不自动重载。
R="${CCA_ROOT:-}"
D="$R/etc/cca"
ACC="$D/accounts.yaml"
PORTS="$D/ports"
SEL="$D/select"
OW="$R/etc/openclash/custom/openclash_custom_overwrite.sh"
CRON="$R/etc/crontabs/root"
SYSUP="$R/etc/sysupgrade.conf"
LOG="$R/tmp/cca-router.log"
CTLOUT="$R/tmp/cca.ctl.$$"
TAB=$(printf '\t')
MB='# >>> cca >>>'
ME='# <<< cca <<<'

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG"; }
rewrite() { cat "$2" > "$1" && rm -f "$2"; }   # 原地覆盖，保留属主和权限

runtime_config() {
	p=$(uci -q get openclash.config.config_path 2>/dev/null)
	if [ -n "$p" ]; then echo "$R/etc/openclash/${p##*/}"; return; fi
	ls -t "$R"/etc/openclash/*.yaml "$R"/etc/openclash/*.yml 2>/dev/null | head -n 1
}
core_bin() {   # 优先用 OpenClash 实际在跑的那份内核
	for c in "$R/etc/openclash/clash" "$R/etc/openclash/core/clash_meta" "$R/tmp/etc/openclash/core/clash_meta"; do
		[ -x "$c" ] && { echo "$c"; return 0; }
	done
	return 1
}
running() { pidof clash >/dev/null 2>&1; }
safe_paths() {   # 和 OpenClash 启动内核时的 SAFE_PATHS 保持一致，否则 -t 会拒绝 external-ui 等路径
	sp=$(tr '\0' '\n' < "/proc/$(pidof clash | awk '{print $1}')/environ" 2>/dev/null | sed -n 's/^SAFE_PATHS=//p')
	echo "${sp:-/usr/share/openclash:/etc/ssl}"
}
listening() { netstat -lnt 2>/dev/null | awk '{print $4}' | grep -q "[:.]$1\$"; }
missing_ports() {
	m=""
	if [ -s "$PORTS" ]; then
		while read -r p; do
			[ -n "$p" ] && ! listening "$p" && m="$m $p"
		done < "$PORTS"
	fi
	echo "$m"
}

# --- mihomo 控制接口 ---------------------------------------------------------
ctl_init() {
	[ -n "$CPORT" ] && return 0
	cf=$(runtime_config)
	out=$(ruby -ryaml -e 'c = YAML.load_file(ARGV[0]) || {}; puts c["external-controller"].to_s.split(":").last; puts c["secret"].to_s' "$cf" 2>/dev/null)
	CPORT=$(printf '%s\n' "$out" | sed -n 1p)
	CSEC=$(printf '%s\n' "$out" | sed -n 2p)
	CPORT="${CPORT:-9090}"
}
ctl() {   # ctl 方法 路径 [JSON]：响应体在 ${CTLOUT}，状态码在 $CODE
	ctl_init
	if [ -n "$3" ]; then
		CODE=$(curl -s -m "${CTL_TIMEOUT:-10}" -o "$CTLOUT" -w '%{http_code}' -X "$1" -H "Authorization: Bearer $CSEC" \
			-H 'Content-Type: application/json' --data "$3" "http://127.0.0.1:$CPORT$2")
	else
		CODE=$(curl -s -m "${CTL_TIMEOUT:-10}" -o "$CTLOUT" -w '%{http_code}' -X "$1" -H "Authorization: Bearer $CSEC" \
			"http://127.0.0.1:$CPORT$2")
	fi
}
json_str() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
now_of() { sed -n 's/.*"now":"\([^"]*\)".*/\1/p' "$CTLOUT" 2>/dev/null; }

# 按 ${SEL}（"CCA-n<TAB>节点"）把每个槽位切到账号的节点；节点不可用时切到 REJECT（宁可断开也不换出口）。
# 返回 0 全部就绪；2 有策略组不在运行中的内核里（需要重载）；1 其它失败
select_all() {
	[ -s "$SEL" ] || return 0
	rc=0
	while IFS="$TAB" read -r g node; do
		[ -n "$g" ] || continue
		ctl GET "/proxies/$g"
		if [ "$CODE" != 200 ]; then rc=2; continue; fi
		[ "$(now_of)" = "$node" ] && continue
		ctl PUT "/proxies/$g" "{\"name\":\"$(json_str "$node")\"}"
		case "$CODE" in
			2??) echo "${g} → ${node}" ;;
			*)
				echo "${g} 切换到 ${node} 失败（HTTP ${CODE}），改为 REJECT"
				ctl PUT "/proxies/$g" '{"name":"REJECT"}'
				[ $rc -eq 0 ] && rc=1 ;;
		esac
	done < "$SEL"
	rm -f "$CTLOUT"
	return $rc
}

install_hook() {
	if [ ! -f "$OW" ]; then
		mkdir -p "${OW%/*}"
		printf '#!/bin/sh\nCONFIG_FILE="$1"\n\nexit 0\n' > "$OW"
	fi
	grep -qxF "$MB" "$OW" && return 0
	b="$D/hook.block"
	{
		echo "$MB"
		echo "# 由 Mac 上的 cca 管理（Claude 多账号端口分流）；移除请运行 cca router uninstall 或 cca restore"
		echo "[ -x $D/cca-router.sh ] && $D/cca-router.sh hook \"\${CONFIG_FILE:-\$1}\""
		echo "$ME"
	} > "$b"
	n=$(grep -n -E '^[[:space:]]*exit[[:space:]]+0[[:space:]]*$' "$OW" | tail -n 1 | cut -d: -f1)
	t="$OW.cca.$$"
	if [ -n "$n" ]; then
		{ head -n $((n - 1)) "$OW"; cat "$b"; tail -n +"$n" "$OW"; } > "$t"
	else
		{ cat "$OW"; [ -n "$(tail -c 1 "$OW")" ] && echo; cat "$b"; } > "$t"
	fi
	rewrite "$OW" "$t"
	chmod 755 "$OW"
	log "已在 ${OW} 安装钩子"
}
remove_hook() {   # 用 head/tail 拼回，其余字节原样保留（包括文件末尾有没有换行）
	[ -f "$OW" ] || return 0
	s=$(grep -n -x -F "$MB" "$OW" | head -n 1 | cut -d: -f1)
	e=$(grep -n -x -F "$ME" "$OW" | head -n 1 | cut -d: -f1)
	[ -n "$s" ] && [ -n "$e" ] && [ "$e" -ge "$s" ] || return 0
	{ head -n $((s - 1)) "$OW"; tail -n +$((e + 1)) "$OW"; } > "$OW.cca.$$"
	rewrite "$OW" "$OW.cca.$$"
	log "已移除钩子"
}
install_cron() {
	mkdir -p "${CRON%/*}"
	touch "$CRON"
	grep -qF "$D/cca-router.sh ensure" "$CRON" && return 0
	echo "*/2 * * * * $D/cca-router.sh ensure >/dev/null 2>&1" >> "$CRON"
	"$R/etc/init.d/cron" restart >/dev/null 2>&1
	log "已安装自愈 cron"
}
remove_cron() {
	[ -f "$CRON" ] && grep -qF "$D/cca-router.sh ensure" "$CRON" || return 0
	grep -vF "$D/cca-router.sh ensure" "$CRON" > "$CRON.cca.$$"
	rewrite "$CRON" "$CRON.cca.$$"
	"$R/etc/init.d/cron" restart >/dev/null 2>&1
}
install_keep() {   # 刷固件(sysupgrade)时保留 /etc/cca
	touch "$SYSUP"
	grep -qxF /etc/cca/ "$SYSUP" || echo /etc/cca/ >> "$SYSUP"
}
remove_keep() {
	[ -f "$SYSUP" ] && grep -qxF /etc/cca/ "$SYSUP" || return 0
	grep -vxF /etc/cca/ "$SYSUP" > "$SYSUP.cca.$$"
	rewrite "$SYSUP" "$SYSUP.cca.$$"
}

# OpenClash 生成配置时调用（启动时本来就会加载配置，不额外重载）。任何失败都保留原配置
hook() {
	f="$1"
	[ -f "$f" ] && [ -s "$PORTS" ] || return 0   # 没有账号端口就完全不碰配置
	cp -f "$f" "$f.cca.bak"
	if ruby -E UTF-8 "$D/apply.rb" "$f" "$ACC" >> "$LOG" 2>&1; then
		rm -f "$f.cca.bak"
		echo "$(date '+%Y-%m-%d %H:%M:%S') 【cca】已注入 Claude 账号端口池: $(tr '\n' ' ' < "$PORTS")" >> "$R/tmp/openclash.log"
	else
		mv -f "$f.cca.bak" "$f"
		log "hook: apply.rb 失败，配置保持原样"
	fi
}

structure() {   # 端口池的"结构"：cca- 入站和 CCA- 策略组的成员（不含选中哪个），结构变了才需要重载
	ruby -E UTF-8 -ryaml -e '
		c = YAML.load_file(ARGV[0]) || {}
		(c["listeners"] || []).each { |l| puts "L|#{l["name"]}|#{l["port"]}|#{l["proxy"]}" if l.is_a?(Hash) && l["name"].to_s.start_with?("cca-") }
		(c["proxy-groups"] || []).each { |g| puts "G|#{g["name"]}|#{(g["proxies"] || []).map(&:to_s).sort.join(",")}" if g.is_a?(Hash) && g["name"].to_s.start_with?("CCA-") }' "$1" 2>/dev/null | sort
}
cca_ports() {
	ruby -E UTF-8 -ryaml -e 'puts((YAML.load_file(ARGV[0]) || {})["listeners"].to_a.select { |l| l.is_a?(Hash) && l["name"].to_s.start_with?("cca-") }.map { |l| l["port"].to_i })' "$1" 2>/dev/null
}

# 通过 mihomo API 重载配置（不带 force：只补丁 listeners，不重建 OpenClash 自己的 7890-7895 等入站）。
# 整套重载要二十多秒才返回，超时给足 90 秒；拿不到响应（000）时以端口实际状态为准。
reload() {
	ctl_init
	RELOAD_CODE=$(curl -s -m 90 -o /dev/null -w '%{http_code}' -X PUT -H "Authorization: Bearer $CSEC" \
		-H 'Content-Type: application/json' --data "{\"path\":\"$1\"}" "http://127.0.0.1:$CPORT/configs")
	case "$RELOAD_CODE" in 2??|000|"") return 0 ;; esac
	echo "mihomo 拒绝了新配置（HTTP ${RELOAD_CODE}）"
	return 1
}
reload_wait() {   # 拿到 2xx 时入站已经补丁完，只需确认一下；拿不到响应时多等一会
	case "$RELOAD_CODE" in 2??) wait_ports "$1" "$2" 4 ;; *) wait_ports "$1" "$2" ;; esac
}
wait_ports() {   # wait_ports "应监听的端口" "应关闭的端口" [最多等几秒，默认 CCA_WAIT 或 60]
	n=$(( ${3:-${CCA_WAIT:-60}} / 2 ))
	while :; do
		ok=1
		for p in $1; do listening "$p" || ok=0; done
		for p in $2; do listening "$p" && ok=0; done
		[ $ok = 1 ] && return 0
		[ $n -gt 0 ] || return 1
		n=$((n - 1))
		sleep 2
	done
}

# 把 accounts.yaml 落到正在运行的 OpenClash：结构没变只切节点；结构变了且获准才重载。
# 返回 0 成功；3 需要重载但没获准；1 失败
apply_now() {
	cf=$(runtime_config)
	if [ -z "$cf" ] || [ ! -f "$cf" ]; then
		echo "还没有 OpenClash 运行配置：端口池会在 OpenClash 启动时由钩子注入"
		return 0
	fi
	if ! running; then
		echo "OpenClash 未运行：端口池会在它下次启动时由钩子注入"
		return 0
	fi
	t="$R/tmp/cca.apply.$$.yaml"
	cp -f "$cf" "$t"
	if ! ruby -E UTF-8 "$D/apply.rb" "$t" "$ACC"; then
		rm -f "$t"
		echo "生成配置失败，运行配置未改动"
		return 1
	fi
	if [ "$(structure "$cf")" = "$(structure "$t")" ] && [ -z "$(missing_ports)" ]; then
		rewrite "$cf" "$t"   # 只有默认选中顺序可能不同，写回文件让下次启动一致
		select_all
		case $? in
			0) echo "账号端口已就绪（切换节点走 API，无需重载）"; return 0 ;;
			1) return 1 ;;
		esac
		echo "运行中的内核里缺少账号策略组"   # 文件和内核不一致，落到下面的重载
		cp -f "$cf" "$t"
	fi
	if [ "${CCA_ALLOW_RELOAD:-}" != 1 ]; then
		rm -f "$t"
		echo "需要让 OpenClash 重载一次配置，用来建立或调整账号端口池：约 20 秒，期间局域网的新连接会中断"
		return 3
	fi
	if c=$(core_bin); then
		if ! out=$(SAFE_PATHS="$(safe_paths)" "$c" -t -d "$R/etc/openclash" -f "$t" 2>&1); then
			rm -f "$t"
			echo "mihomo 校验未通过，运行配置未改动："
			echo "$out" | tail -n 3
			return 1
		fi
	fi
	newp=$(cca_ports "$t" | tr '\n' ' ')
	gonep=""
	for p in $(cca_ports "$cf"); do
		case " $newp " in *" $p "*) ;; *) gonep="$gonep $p" ;; esac
	done
	cp -f "$cf" "$D/runtime.bak.yaml"
	rewrite "$cf" "$t"
	echo "正在重载 OpenClash 配置（约 20 秒）…"
	if reload "$cf"; then
		ok=0
		if reload_wait "$newp" "$gonep"; then
			ok=1
		else
			# 端口还被名字不同的旧入站占着时，内核先起新入站（绑定失败）再关旧入站。端口此时已释放，再重载一次就能绑上
			echo "有端口刚被旧的入站释放，再重载一次（约 20 秒）…"
			reload "$cf" && reload_wait "$newp" "$gonep" && ok=1
		fi
		if [ $ok = 1 ]; then
			select_all >/dev/null
			echo "已重载并建立账号端口池（未重启 OpenClash）"
			return 0
		fi
	fi
	cp -f "$D/runtime.bak.yaml" "$cf"
	echo "重载后端口没有按预期变化，运行配置已还原。可以在 OpenClash 页面手动重启一次：钩子会在启动时注入端口池"
	return 1
}

ensure() {   # cron：补钩子、纠正被改掉的选中节点；端口池缺失时只记录，不自动重载（避免打断局域网）
	[ -s "$PORTS" ] || return 0
	install_hook
	running || return 0
	if [ -n "$(missing_ports)" ]; then
		[ -f "$R/tmp/cca.missing" ] || { log "账号端口池不在运行中的 OpenClash 里：等它下次启动由钩子注入，或在 Mac 上运行 cca router sync"; : > "$R/tmp/cca.missing"; }
		return 0
	fi
	rm -f "$R/tmp/cca.missing"
	out=$(select_all)
	[ -n "$out" ] && log "纠正选中节点：$(echo $out)"
	return 0
}
ensure_now() {   # Mac 启动前调用：端口池在就只纠正选中节点（快）；不在则交给 apply_now（需要重载时返回 3）
	install_hook
	if [ -z "$(missing_ports)" ]; then
		select_all
		case $? in 0) return 0 ;; 1) return 1 ;; esac
	fi
	apply_now
}

status() {
	if running; then echo "OpenClash：运行中"; else echo "OpenClash：未运行"; fi
	echo "运行配置：$(runtime_config)"
	if grep -qxF "$MB" "$OW" 2>/dev/null; then echo "钩子：已安装"; else echo "钩子：未安装"; fi
	if grep -qF "$D/cca-router.sh ensure" "$CRON" 2>/dev/null; then echo "自愈 cron：已安装"; else echo "自愈 cron：未安装"; fi
	if [ -s "$SEL" ] && running; then
		i=0
		while IFS="$TAB" read -r g node; do
			[ -n "$g" ] || continue
			i=$((i + 1))
			p=$(sed -n "${i}p" "$PORTS")
			ctl GET "/proxies/$g"
			now=$(now_of)
			if listening "$p"; then st="监听中"; else st="未监听"; fi
			if [ "$CODE" != 200 ]; then now="（内核里没有）"; fi
			echo "槽位 ${g} :${p} ${st} → ${now:-?}$([ "$now" != "$node" ] && echo "（应为 ${node}）")"
		done < "$SEL"
		rm -f "$CTLOUT"
	fi
	if [ -f "$LOG" ]; then echo "最近日志："; tail -n 5 "$LOG"; fi
	return 0
}
nodes() {
	cf=$(runtime_config)
	[ -n "$cf" ] && [ -f "$cf" ] || { echo "找不到 OpenClash 运行配置" >&2; return 1; }
	ruby -E UTF-8 -ryaml -e '
		c = YAML.load_file(ARGV[0]) || {}
		(c["proxies"] || []).each { |p| puts "P\t#{p["name"]}" if p.is_a?(Hash) }
		(c["proxy-groups"] || []).each { |g| puts "G\t#{g["name"]}\t#{g["type"]}" if g.is_a?(Hash) && !g["name"].to_s.start_with?("CCA-") }' "$cf"
}
uninstall() {   # stdin 可传入要删除的 SSH 公钥；CCA_ALLOW_RELOAD=1 时立即移除端口池，否则等 OpenClash 下次重启
	key=""
	[ -t 0 ] || key=$(cat)
	remove_hook
	remove_cron
	remove_keep
	if [ -f "$ACC" ]; then
		echo '{"base": 0, "slots": 0, "nodes": [], "accounts": []}' > "$ACC"
		: > "$PORTS"
		: > "$SEL"
		apply_now || echo "端口池会在 OpenClash 下次重启后消失（钩子已移除）"
	fi
	if [ -n "$key" ]; then
		for f in "$R/etc/dropbear/authorized_keys" "$HOME/.ssh/authorized_keys"; do
			[ -f "$f" ] && grep -qxF "$key" "$f" || continue
			grep -vxF "$key" "$f" > "$f.cca.$$"
			rewrite "$f" "$f.cca.$$"
		done
	fi
	rm -rf "$D" "$R/tmp/cca.missing"
	echo "路由器上的 cca 已移除"
}

case "$1" in
	hook) hook "$2"; exit 0 ;;
	install) install_hook && install_cron && install_keep ;;
	apply) apply_now ;;
	ensure) ensure ;;
	ensure-now) ensure_now ;;
	status) status ;;
	nodes) nodes ;;
	uninstall) uninstall ;;
	*) echo "用法: $0 hook <配置>|install|apply|ensure|ensure-now|status|nodes|uninstall" >&2; exit 2 ;;
esac
SH
}

router_rb() {
	cat <<'RB'
# cca：在 OpenClash 配置里生成账号端口池。槽位 n = mixed 入站 cca-n（端口 base+n，不认证）→ select 策略组 CCA-n，
# 组成员是可选节点 + REJECT；分到账号的槽位把它的节点排第一（OpenClash 启动后默认就选中它），空槽位默认 REJECT。
require 'yaml'
cfg_file, acc_file = ARGV
begin
  cfg = YAML.load_file(cfg_file) || {}
  acc = (File.exist?(acc_file) && YAML.load_file(acc_file)) || {}
rescue StandardError, Psych::SyntaxError => e
  $stderr.puts "cca: 读取配置失败：#{e.message.lines.first.strip}"
  exit 1
end
ours = lambda { |x, prefix| x.is_a?(Hash) && x['name'].to_s.start_with?(prefix) }
listeners = (cfg['listeners'] || []).reject { |l| ours.call(l, 'cca-') }
groups = (cfg['proxy-groups'] || []).reject { |g| ours.call(g, 'CCA-') }
known = { 'DIRECT' => true, 'REJECT' => true }
(cfg['proxies'] || []).each { |p| known[p['name'].to_s] = true if p.is_a?(Hash) }
groups.each { |g| known[g['name'].to_s] = true if g.is_a?(Hash) }
wanted = (acc['nodes'] || []).map(&:to_s)
members = wanted.select { |n| known[n] }
(wanted - members).each { |n| $stderr.puts "cca: 路由器上没有节点「#{n}」，已从可选列表里跳过" }
assign = {}
(acc['accounts'] || []).each { |a| assign[a['slot'].to_i] = a['node'].to_s }
port_of = lambda { |v| v.to_s.split(':').last.to_i }
used = %w[port socks-port mixed-port redir-port tproxy-port].map { |k| cfg[k].to_i }
used << port_of.call(cfg['external-controller']) << port_of.call((cfg['dns'] || {})['listen'])
listeners.each { |l| used << l['port'].to_i if l.is_a?(Hash) }
base = acc['base'].to_i
(1..acc['slots'].to_i).each do |k|
  port = base + k
  if used.include?(port)
    $stderr.puts "cca: 端口 #{port} 已被占用，槽位 #{k} 跳过"
    next
  end
  node = assign[k]
  if node && !members.include?(node)
    $stderr.puts "cca: 槽位 #{k} 的节点「#{node}」不可用，该端口改为 REJECT（宁可断开也不换出口）"
    node = nil
  end
  first = node || 'REJECT'
  order = [first] + (members - [first]) + (first == 'REJECT' ? [] : ['REJECT'])
  groups << { 'name' => "CCA-#{k}", 'type' => 'select', 'proxies' => order }
  listeners << { 'name' => "cca-#{k}", 'type' => 'mixed', 'port' => port.to_s,
                 'listen' => '0.0.0.0', 'users' => [], 'proxy' => "CCA-#{k}" }
  used << port
end
cfg['proxy-groups'] = groups unless groups.empty? && cfg['proxy-groups'].nil?
if listeners.empty? then cfg.delete('listeners') else cfg['listeners'] = listeners end
tmp = "#{cfg_file}.cca.tmp"
File.open(tmp, 'w') { |f| f.write(YAML.dump(cfg)) }
File.rename(tmp, cfg_file)
RB
}

# 一次 SSH 会话完成部署：写入脚本和账号表、装钩子/cron、热加载
router_bundle() {
	local acc
	acc=$(py accounts-json) || return 1
	echo 'set -e'
	echo 'R="${CCA_ROOT:-}"'
	echo 'for c in ruby uci netstat curl; do command -v "$c" >/dev/null 2>&1 || { echo "路由器缺少命令: $c"; exit 1; }; done'
	echo '[ -d "$R/etc/openclash" ] || { echo "路由器上没有 /etc/openclash（没装 OpenClash？）"; exit 1; }'
	echo 'mkdir -p "$R/etc/cca"'
	echo "cat > \"\$R/etc/cca/cca-router.sh.new\" <<'CCA_EOF_SH'"; router_sh; echo 'CCA_EOF_SH'
	echo 'chmod 755 "$R/etc/cca/cca-router.sh.new" && mv -f "$R/etc/cca/cca-router.sh.new" "$R/etc/cca/cca-router.sh"'
	echo "cat > \"\$R/etc/cca/apply.rb\" <<'CCA_EOF_RB'"; router_rb; echo 'CCA_EOF_RB'
	echo "cat > \"\$R/etc/cca/accounts.yaml\" <<'CCA_EOF_ACC'"; printf '%s\n' "$acc"; echo 'CCA_EOF_ACC'
	echo "cat > \"\$R/etc/cca/ports\" <<'CCA_EOF_PORTS'"; py ports; echo 'CCA_EOF_PORTS'
	echo "cat > \"\$R/etc/cca/select\" <<'CCA_EOF_SEL'"; py select-lines; echo 'CCA_EOF_SEL'
	echo '"$R/etc/cca/cca-router.sh" install'
	echo '"$R/etc/cca/cca-router.sh" apply'
}
digest() { { router_sh; router_rb; } | py digest; }   # 账号表 + 路由器端代码的摘要（见 cmd_digest）

# 路由器说"需要重载"（返回 3）时征求同意：重载期间局域网新连接会失败约 20 秒
allow_reload() {
	[ -n "${CCA_YES:-}" ] && return 0
	interactive || return 1
	confirm "现在重载吗？" y
}
router_reload() {   # 获准后在路由器上执行带重载的 apply
	local out rc
	out=$(rsh "CCA_ALLOW_RELOAD=1 $RDIR/cca-router.sh apply" 2>&1); rc=$?
	[ -n "$out" ] && printf '%s\n' "$out" | LC_ALL=C sed 's/^/  │ /' >&2
	return $rc
}

# ---------------------------------------------------------------------------
# 路由器 SSH
# ---------------------------------------------------------------------------
load_router() { eval "$(py router-env)"; }
router_ready() { load_router; [ -n "$ROUTER_HOST" ] && [ -f "$ROUTER_KEY" ]; }
SSH_COMMON=(-o StrictHostKeyChecking=accept-new -o LogLevel=ERROR -o ConnectTimeout=6)
rsh() {
	ssh -i "$ROUTER_KEY" -p "$ROUTER_PORT" "${SSH_COMMON[@]}" -o UserKnownHostsFile="$CCA_HOME/known_hosts" \
		-o IdentitiesOnly=yes -o BatchMode=yes -o ServerAliveInterval=15 \
		-o ControlMaster=auto -o ControlPath="$CCA_HOME/cm-%C" -o ControlPersist=60 \
		"$ROUTER_USER@$ROUTER_HOST" "$@"
}
rsh_close() {   # 关掉复用的 SSH 主连接
	ssh -O exit -o ControlPath="$CCA_HOME/cm-%C" -p "$ROUTER_PORT" "$ROUTER_USER@$ROUTER_HOST" >/dev/null 2>&1
}
port_open() {
	if [ "$(uname)" = Darwin ]; then nc -z -G 3 "$1" "$2" >/dev/null 2>&1; else nc -z -w 3 "$1" "$2" >/dev/null 2>&1; fi
}

# 首次用密码登录一次，把公钥写进 dropbear / OpenSSH 的 authorized_keys
REMOTE_ADD_KEY='k=$(cat); add() { mkdir -p "${1%/*}"; touch "$1"; chmod 600 "$1"; grep -qxF "$k" "$1" || echo "$k" >> "$1"; }; [ -d /etc/dropbear ] && add /etc/dropbear/authorized_keys; add "$HOME/.ssh/authorized_keys"; chmod 700 "$HOME/.ssh"; echo ok'

cmd_router_setup() {
	need_tty
	load_router
	local host="" user port key i list="" nd
	if [ -n "$ROUTER_HOST" ]; then
		host=$(ask "路由器地址 [${ROUTER_HOST}]: " "$ROUTER_HOST")
	else
		for i in 1 2 3; do
			host=$(ask "装了 OpenClash 的路由器地址（例如 192.168.1.2）: " "")
			[ -n "$host" ] && break
		done
		[ -n "$host" ] || die "需要路由器地址"
	fi
	user=$(ask "SSH 用户 [${ROUTER_USER:-root}]: " "${ROUTER_USER:-root}")
	port=$(ask "SSH 端口 [${ROUTER_PORT:-22}]: " "${ROUTER_PORT:-22}")
	key="$CCA_HOME/router_ed25519"
	[ -f "$key" ] || ssh-keygen -q -t ed25519 -N '' -C "cca@$(hostname -s)" -f "$key" || die "生成 SSH 密钥失败"
	py router-set "$host" "$port" "$user" "$key" || die "保存路由器配置失败"
	load_router
	if rsh true 2>/dev/null; then
		info "已能用密钥登录 $user@$host"
	else
		info "需要输入一次 $user@$host 的密码来安装 SSH 公钥（密码不会被保存）"
		ssh -p "$port" "${SSH_COMMON[@]}" -o UserKnownHostsFile="$CCA_HOME/known_hosts" \
			-o PubkeyAuthentication=no -o PreferredAuthentications=keyboard-interactive,password \
			"$user@$host" "$REMOTE_ADD_KEY" < "$key.pub" >/dev/null || die "安装公钥失败"
		rsh true || die "公钥已写入，但密钥登录仍然失败"
		info "密钥登录成功，之后免密"
	fi
	router_sync
	case $? in 0|3) ;; *) return 1 ;; esac
	while IFS= read -r nd; do list="${list:+${list}、}${nd}"; done < <(py nodes-allowed | cut -f1)
	if [ -z "$list" ]; then
		pick_allowed_nodes || return 1
	elif confirm "账号可选的出口节点：${list}。要重新选吗？" n; then
		pick_allowed_nodes || return 1
		[ -z "$(py keys)" ] || router_sync   # 可选节点变了要重建端口池（需要重载，会先问）
	fi
	return 0
}

pick_allowed_nodes() {   # 从路由器的节点里选出账号可以用的出口，存进 config.json 的 nodes
	local -a all picked
	local n=0 i nd sel w tries=0 list=""
	while IFS= read -r nd; do [ -n "$nd" ] && { all[n]="$nd"; n=$((n + 1)); }; done < <(rsh "$RDIR/cca-router.sh nodes" 2>/dev/null | awk -F '\t' '$1 == "P" { print $2 }')
	[ $n -gt 0 ] || { warn "没从路由器读到节点（OpenClash 在运行吗？）"; return 1; }
	say ""
	say "  选出允许账号使用的出口节点（之后每个账号从这些里面挑一个）："
	say ""
	for ((i = 0; i < n; i++)); do say "    $((i + 1)). ${all[i]}"; done
	say ""
	while [ $tries -lt 5 ]; do
		tries=$((tries + 1))
		sel=$(ask "  输入编号，用空格分隔（例如 1 3 4）：" "" | sed 's/,/ /g; s/，/ /g; s/、/ /g')
		picked=()
		for w in $sel; do
			case "$w" in *[!0-9]*) warn "「${w}」不是编号"; continue 2 ;; esac
			if [ "$w" -lt 1 ] || [ "$w" -gt $n ]; then warn "没有编号 ${w}"; continue 2; fi
			picked[${#picked[@]}]="${all[w - 1]}"
		done
		[ ${#picked[@]} -gt 0 ] || { warn "至少选一个"; continue; }
		py set-nodes "${picked[@]}" || return 1
		for nd in "${picked[@]}"; do list="${list:+${list}、}${nd}"; done
		okay "账号可选的出口节点：${list}"
		return 0
	done
	return 1
}

router_sync() {   # 0 成功；3 需要重载但没获同意（账号表已上传，端口池等下次）；1 失败
	local out rc bundle
	router_ready || { warn "还没配置路由器（cca router setup）"; return 1; }
	py validate || { warn "账号表有错误，先运行 cca edit 修正"; return 1; }
	bundle=$(router_bundle) || { warn "生成路由器部署内容失败"; return 1; }
	info "正在同步账号到路由器 ${ROUTER_HOST} …"
	out=$(printf '%s\n' "$bundle" | rsh 'sh -s' 2>&1); rc=$?
	[ -n "$out" ] && printf '%s\n' "$out" | LC_ALL=C sed 's/^/  │ /' >&2
	if [ $rc -eq 3 ]; then
		if allow_reload; then
			router_reload; rc=$?
		else
			warn "没有重载：新的端口池要等 OpenClash 下次重启（或再运行 cca router sync）才生效"
			return 3
		fi
	fi
	[ $rc -eq 0 ] || { warn "路由器端执行失败"; return 1; }
	py set synced "$(digest)"
	verify_ports
}

verify_ports() {   # verify_ports [127.0.0.1]：各账号的出口端口通不通（默认看路由器上的，给了 127.0.0.1 看本机 Clash 的）
	local k p rc=0 host="${1:-}" what="出口端口"
	if [ -n "$host" ]; then what="本机端口"; else load_router; host="$PROXY_HOST"; fi
	while IFS=$'\t' read -r k p; do
		[ -n "$p" ] || continue
		if port_open "$host" "$p"; then okay "${k} 的${what} ${p} 已就绪"; else warn "${k} 的${what} ${p} 不通"; rc=1; fi
	done < <(py ports named)
	return $rc
}

router_sync_soon() {   # 增删改账号后同步到路由器；在外面连不上路由器时，等回家后的下次启动（摘要对不上会自动补同步）
	if router_ready && ! at_home; then
		info "现在连不上路由器 ${ROUTER_HOST}：回到家里的网络后，下次启动 cca 时会自动同步"
		return 0
	fi
	router_sync
}

cmd_router() {
	case "${1:-status}" in
		setup) cmd_router_setup ;;
		sync) [ "${2:-}" = -y ] && CCA_YES=1; router_sync ;;
		status) router_ready || die "还没配置路由器（cca router setup）"; rsh "$RDIR/cca-router.sh status" ;;
		nodes) router_ready || die "还没配置路由器（cca router setup）"; rsh "$RDIR/cca-router.sh nodes" | cut -f2 ;;
		log) router_ready || die "还没配置路由器（cca router setup）"; rsh 'tail -n 50 "${CCA_ROOT:-}/tmp/cca-router.log"' ;;
		ssh)
			router_ready || die "还没配置路由器（cca router setup）"
			exec ssh -t -i "$ROUTER_KEY" -p "$ROUTER_PORT" "${SSH_COMMON[@]}" -o UserKnownHostsFile="$CCA_HOME/known_hosts" \
				-o IdentitiesOnly=yes "$ROUTER_USER@$ROUTER_HOST" ;;
		uninstall)
			router_ready || die "还没配置路由器（cca router setup）"
			need_tty
			confirm "从路由器移除 cca（钩子、cron、端口池、/etc/cca、SSH 公钥）？立即移除端口池要让 OpenClash 重载一次（约 20 秒）" n || return 0
			rsh "CCA_ALLOW_RELOAD=1 $RDIR/cca-router.sh uninstall" < "$ROUTER_KEY.pub" ;;
		*) die "用法: cca router setup|sync|status|nodes|log|ssh|uninstall" ;;
	esac
}

# ---------------------------------------------------------------------------
# 账号
# ---------------------------------------------------------------------------
pick_node() {   # pick_node [direct]：从可选节点里选一个，打印节点名；标出已被哪些账号使用、路由器上是否存在。
	                # direct 时第一项（默认）是"直连"，选它打印空字符串
	local onrouter="" def n=0 i node sel off=0
	local -a nodes rows
	if [ "${1:-}" = direct ]; then nodes[0]=""; rows[0]="直连（不经代理）"; n=1; off=1; fi
	at_home && onrouter=$(rsh "$RDIR/cca-router.sh nodes" 2>/dev/null | cut -f2)
	while IFS= read -r node; do [ -n "$node" ] && { nodes[n]="$node"; n=$((n + 1)); }; done < <(py nodes-allowed | cut -f1)
	[ $n -gt 0 ] || { warn "config.json 里没有可选节点（nodes）"; return 1; }
	i=$off
	while IFS= read -r node; do rows[i]="$node"; i=$((i + 1)); done < <(py node-rows "$onrouter" "$(term_cols)")
	if [ $off = 1 ]; then def=0; else def=$(py node-default); fi
	if fancy_ok; then
		arrow_menu "$def" "${rows[@]}"
		[ "$MENU_PICK" -ge 0 ] || return 1
		printf '%s' "${nodes[MENU_PICK]}"
		return 0
	fi
	for ((i = 0; i < n; i++)); do say "    $((i + 1)). ${rows[i]}"; done
	while :; do
		sel=$(ask "  选择节点编号 [$((def + 1))]：" "$((def + 1))")
		case "$sel" in
			*[!0-9]*) warn "请输入编号" ;;
			*) if [ "$sel" -ge 1 ] && [ "$sel" -le $n ]; then printf '%s' "${nodes[sel - 1]}"; return 0; fi
			   warn "没有编号 ${sel}" ;;
		esac
	done
}

cmd_add() {   # cca add [api]
	local email alias key node out
	[ "${1:-}" = api ] && { cmd_add_api; return; }
	need_tty
	if ! router_ready; then
		info "官方账号要经路由器的端口出去，先配置路由器（只用第三方 API 账号的话不需要路由器：按 Ctrl-C 退出，运行 cca add api）"
		cmd_router_setup || return 1
	fi
	say ""
	say "${C_B}添加 Claude 账号${C_0}    ${C_D}第三方 API 用 cca add api${C_0}"
	say ""
	email=$(ask_valid email "  登录邮箱：") || return 1   # 登录时自动填进登录页
	alias=$(ask_valid alias "  别名（可选，回车跳过）：" optional)   # 只用来在菜单里认出账号
	say ""
	say "  给 ${alias:-$email} 选一个出口节点（每个账号最好用不同的节点）："
	say ""
	node=$(pick_node) || return 1
	say ""
	key=$(py add "$email" "$alias" "$node") || return 1
	eval "$(py env "$key")"
	router_sync_soon || warn "路由器同步没完成：修好后运行 cca router sync"
	py link "$key" && py sync "$key" || die "初始化账号目录失败"
	okay "已添加 ${ACC_LABEL}，出口 ${node}"
	launchers_sync
	info "第一次使用时会在它专属的浏览器窗口里登录，登录页会预填 ${ACC_EMAIL}"
	ADDED_KEY="$key"
}

# 第三方 API 账号：兼容 Anthropic 接口的地址 + key，在菜单里和官方账号一样选用。直连时不需要路由器
cmd_add_api() {
	local alias url model secret node="" key
	need_tty
	say ""
	say "${C_B}添加第三方 API 账号${C_0}    ${C_D}兼容 Anthropic 接口的服务：填地址和 key，模型可选${C_0}"
	say ""
	alias=$(ask_valid alias "  别名（在菜单里显示，例如 kimi）：") || return 1
	url=$(ask_valid url "  接口地址（ANTHROPIC_BASE_URL，例如 https://api.example.com/anthropic）：") || return 1
	secret=$(api_key_ask "  API key（输入时不显示）：") || { say "  已取消"; return 1; }
	model=$(ask_valid model "  模型（可选，回车跳过；填了会同时用作 opus / sonnet / haiku）：" optional)
	if [ -n "$(py nodes-allowed)" ]; then
		say ""
		say "  ${alias} 走哪个出口？国内的服务一般直连；要经代理的选一个节点："
		say ""
		node=$(pick_node direct) || return 1
		say ""
		if [ -n "$node" ] && ! router_ready; then info "走节点要先配置路由器"; cmd_router_setup || return 1; fi
	fi
	key=$(py add-api "$alias" "$url" "$model" "$node") || return 1
	if ! printf '%s' "$secret" | py secret-set "$key"; then
		py rm "$key"
		die "API key 没存进钥匙串，没有添加 ${alias}"
	fi
	secret=""
	eval "$(py env "$key")"
	[ -z "$ACC_PORT" ] || router_sync_soon || warn "路由器同步没完成：修好后运行 cca router sync"
	py link "$key" && py sync "$key" || die "初始化账号目录失败"
	okay "已添加第三方 API 账号 ${ACC_NAME}（${ACC_BASE_URL}，出口 ${ACC_NODE}），key 存在钥匙串里"
	info "用 cca @${ACC_NAME} 启动；改地址、模型或加环境变量用 cca edit，换 key 用 cca key ${ACC_NAME}"
}

# x=$(ask_valid 字段 提示 [optional])：问到 py check 通过为止，打印规范化后的值；
# 直接回车：optional 时打印空字符串，否则说"已取消"并返回 1
ask_valid() {
	local v out
	while :; do
		v=$(ask "$2" "")
		if [ -z "$v" ]; then
			[ "${3:-}" = optional ] && return 0
			say "  已取消"
			return 1
		fi
		if out=$(py check "$1" "$v"); then printf '%s' "$out"; return 0; fi
		warn "$out"
	done
}

api_key_ask() {   # api_key_ask 提示：读一个合格的 API key 打到 stdout（不回显）；空输入返回 1
	local s out
	while :; do
		s=$(ask_secret "$1")
		[ -n "$s" ] || return 1
		if out=$(printf '%s' "$s" | py secret-check); then printf '%s' "$s"; return 0; fi
		warn "$out"
	done
}

api_key_prompt() {   # 输入 key 存进钥匙串（需要先 eval "$(py env 名称)"）
	local s
	s=$(api_key_ask "  ${ACC_NAME} 的 API key（输入时不显示）：") || { say "  已取消"; return 1; }
	printf '%s' "$s" | py secret-set "$ACC_KEY" || return 1
	okay "已把 ${ACC_NAME} 的 API key 存进钥匙串"
}

api_key_ready() {   # 启动前：key 在账号表里或钥匙串里（按现在的接口域名）；都没有时在终端里问
	[ -n "$(py secret-status "$ACC_KEY")" ] && return 0
	interactive || { warn "钥匙串里没有 ${ACC_NAME} 的 API key（接口地址换了服务商时也要重新输入）：在终端里运行 cca key ${ACC_NAME}"; return 1; }
	warn "钥匙串里还没有 ${ACC_NAME} 的 API key（第一次用，或者接口地址换了服务商）"
	api_key_prompt
}

api_keys_ensure() {   # cca edit 之后：手写进账号表、换了服务商、还没有 key 的第三方 API 账号，现在输入
	local key
	while IFS= read -r key; do
		[ -n "$key" ] || continue
		eval "$(py env "$key")"
		info "第三方 API 账号 ${ACC_NAME} 还没有 key"
		api_key_prompt || warn "先跳过：启动 ${ACC_NAME} 时会再问"
	done < <(py secrets-missing)
}

cmd_key() {   # cca key <账号>：重新输入第三方 API 账号的 key（存进钥匙串）
	local key
	key=$(py resolve "${1:-}") || die "用法: cca key <第三方 API 账号>"
	need_tty
	eval "$(py env "$key")"
	[ "$ACC_KIND" = api ] || die "${ACC_NAME} 是官方账号：登录凭证由 Claude Code 自己管（在 cca @${ACC_NAME} 里用 /login 重新登录）"
	[ "$(py secret-status "$ACC_KEY")" = table ] && warn "账号表里写了 ${ACC_NAME} 的 key 字段，会优先用它；要换那个请用 cca edit"
	api_key_prompt
}

# 账号表、端口池有变化时要不要同步路由器：配置过路由器，或者有走端口的账号（只有直连的第三方 API 账号时不用）
router_needed() { router_ready || [ -n "$(py ports)" ]; }

cmd_edit() {
	local before
	need_tty
	before=$(digest)
	${EDITOR:-vi} "$TABLE" <&3 3<&-
	while ! py validate; do
		confirm "账号表有错误，重新编辑？" y || return 1
		${EDITOR:-vi} "$TABLE" <&3 3<&-
	done
	chmod 600 "$TABLE" 2>/dev/null   # 编辑器可能另存再改名（权限会变）；表里可能写着 key
	py secrets-forget   # 删掉的第三方 API 账号：钥匙串里的 key 一起删
	if [ "$(digest)" != "$before" ] || [ "$(digest)" != "$(py get synced)" ]; then
		router_needed && router_sync_soon
	else
		info "端口和节点没有变化，不用同步路由器"
	fi
	launchers_sync
	api_keys_ensure
}

# 继承来的、会盖掉账号自己的登录/接口/模型，或者把请求转去别的服务商的变量（和 PY_SRC 里的 CRED_ENV 对应）
INHERITED_RE='^(ANTHROPIC_.*|CLAUDE_CODE_OAUTH_TOKEN|CLAUDE_CODE_USE_(BEDROCK|VERTEX|FOUNDRY|GATEWAY|MANTLE|ANTHROPIC_AWS|ANTHROPIC_GOOGLE_CLOUD)|CLAUDE_CODE_PROVIDER_MANAGED_BY_HOST)$'
child_env() {   # 需要先 eval "$(py env 名称)"；结果在 UNSETS / SETS 两个数组里，屏蔽掉的继承变量名在 DROPPED 里
	local v
	# 继承来的接口地址、凭证、模型一律不带进去：例如 shell 里 export 过 ANTHROPIC_BASE_URL，官方账号的登录 token
	# 就会被发到那个地址。第三方 API 账号自己的地址和模型经 --settings 传，key 经 apiKeyHelper 取
	UNSETS=(-u ALL_PROXY -u all_proxy)
	DROPPED=""
	for v in $(compgen -e | grep -E "$INHERITED_RE"); do UNSETS+=(-u "$v"); DROPPED="${DROPPED:+${DROPPED} }${v}"; done
	SETS=(CLAUDE_CONFIG_DIR="$ACC_CLAUDE_DIR" CCA_ACCOUNT="$ACC_KEY" CCA_PROXY="$ACC_PROXY")
	[ "$ACC_KIND" = api ] || SETS+=(BROWSER="$CCA_HOME/bin/open-url")
	if [ -n "$ACC_PROXY" ]; then
		SETS+=(https_proxy="$ACC_PROXY" HTTPS_PROXY="$ACC_PROXY" http_proxy="$ACC_PROXY" HTTP_PROXY="$ACC_PROXY"
			no_proxy="$CCA_NO_PROXY" NO_PROXY="$CCA_NO_PROXY")
	else   # 直连：也不用 shell 里继承来的代理，出口不随环境变
		UNSETS+=(-u https_proxy -u HTTPS_PROXY -u http_proxy -u HTTP_PROXY -u no_proxy -u NO_PROXY)
	fi
}

logout_account() {   # 需要先 eval "$(py env 名称)"；第三方 API 账号只删钥匙串里它的 key
	if [ "$ACC_KIND" = api ]; then py secret-del "$ACC_KEY"; return 0; fi
	if [ -d "$ACC_CLAUDE_DIR" ] && [ -n "$CLAUDE_BIN" ]; then
		child_env
		with_timeout 30 env "${UNSETS[@]}" "${SETS[@]}" "$CLAUDE_BIN" auth logout </dev/null >/dev/null 2>&1
	fi
	security delete-generic-password -s "$(py keychain "$ACC_KEY")" >/dev/null 2>&1
	return 0
}

auth_email() {   # 已登录的邮箱：先读账号目录的 .claude.json，读不到再问 claude auth status
	local e
	e=$(py email "$ACC_KEY")
	if [ -z "$e" ]; then
		child_env
		e=$(env "${UNSETS[@]}" "${SETS[@]}" "$CLAUDE_BIN" auth status --json 2>/dev/null 3<&- </dev/null | "$PYTHON" -I -X utf8 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    d = {}
print((d.get("email") or "") if d.get("loggedIn") else "")')
	fi
	printf '%s' "$e"
}

# 账号表里有邮箱时：没登录就用这个邮箱登录（登录页预填）；登录的不是它就拒绝（否则会让别的账号走这个出口）
ensure_login() {
	local e tries=0
	while :; do
		e=$(auth_email)
		if [ -z "$e" ]; then
			interactive || { warn "${ACC_NAME} 还没登录，需要在终端里运行 cca @${ACC_NAME} 完成登录"; return 1; }
			[ $tries -lt 2 ] || return 1
			tries=$((tries + 1))
			info "${ACC_NAME} 还没登录：正在它专属的浏览器窗口里打开登录页${ACC_EMAIL:+（已预填 ${ACC_EMAIL}）}，登录完成后会自动继续"
			local -a em=()
			[ -n "$ACC_EMAIL" ] && em=(--email "$ACC_EMAIL")
			child_env
			env "${UNSETS[@]}" "${SETS[@]}" "$CLAUDE_BIN" auth login --claudeai "${em[@]}" 3<&- || { warn "登录没有完成"; return 1; }
			continue
		fi
		[ -z "$ACC_EMAIL" ] && return 0
		[ "$(lower "$e")" = "$(lower "$ACC_EMAIL")" ] && return 0
		warn "这个账号目录登录的是 ${e}，不是 ${ACC_EMAIL}（继续会让 ${e} 走 ${ACC_NAME} 的出口）"
		interactive && confirm "退出 ${e}，改用 ${ACC_EMAIL} 登录？" y || return 1
		child_env
		env "${UNSETS[@]}" "${SETS[@]}" "$CLAUDE_BIN" auth logout </dev/null >/dev/null 2>&1
		security delete-generic-password -s "$(py keychain "$ACC_KEY")" >/dev/null 2>&1
		"$PYTHON" -I -X utf8 -c 'import json,sys; p=sys.argv[1]; j=json.load(open(p)); j.pop("oauthAccount",None); json.dump(j,open(p,"w"),indent=2)' "$ACC_CLAUDE_DIR/.claude.json" 2>/dev/null
	done
}

cmd_rm() {
	local key
	key=$(py resolve "${1:-}") || die "用法: cca rm <账号>"
	need_tty
	eval "$(py env "$key")"
	[ -z "$(app_pid "$ACC_DESKTOP_DIR")" ] || die "${ACC_LABEL} 的 Claude App 还开着：先退出它再删除"
	if [ "$ACC_KIND" = api ]; then
		confirm "删除第三方 API 账号 ${ACC_LABEL}？（删除钥匙串里它的 key 和账号目录；共享的记忆/会话不受影响）" n || return 0
	else
		confirm "删除账号 ${ACC_LABEL}？（退出登录、删除它的钥匙串凭证、浏览器资料和 Claude App 资料；共享的记忆/会话不受影响）" n || return 0
	fi
	py link "$key" >/dev/null 2>&1   # 先把会话里新产生的共享内容并回 ~/.claude
	py sync "$key" >/dev/null 2>&1
	logout_account
	rm -rf "${CCA_HOME:?}/accounts/${ACC_ID:?}"
	py rm "$key"
	[ -z "$ACC_PORT" ] || router_sync_soon   # 直连的第三方 API 账号不占端口，路由器那边没有要改的
	launchers_sync
	info "已删除账号 ${ACC_LABEL}"
}

cmd_list() {
	local i=0 r
	[ -n "$(py keys)" ] || { info "还没有账号（cca add）"; return 0; }
	say ""
	while IFS= read -r r; do i=$((i + 1)); say "  ${i}. ${r}"; done < <(py rows "$(term_cols)")
	say ""
	[ -n "$(py ports)" ] || return 0   # 只有直连的第三方 API 账号：没有端口要看
	if ! want_local; then
		router_ready && verify_ports
	else
		load_local
		if local_ready; then verify_ports 127.0.0.1; else info "现在连不上路由器：在外面要先配置本机 Clash（cca local setup）"; fi
	fi
	return 0
}

menu() {   # 选中的账号别名打印到 stdout
	local last cur=0 n=0 i k choice
	local -a keys rows
	while IFS= read -r k; do [ -n "$k" ] && { keys[n]="$k"; n=$((n + 1)); }; done < <(py keys)
	i=0
	while IFS= read -r k; do rows[i]="$k"; i=$((i + 1)); done < <(py rows "$(term_cols)")
	last=$(py get last)
	for ((i = 0; i < n; i++)); do [ "${keys[i]}" = "$last" ] && cur=$i; done
	if fancy_ok; then
		say ""
		say "${C_B}选择 Claude 账号${C_0}    ${C_D}↑↓ 移动 · 回车确认 · 数字键直接选 · q 退出${C_0}"
		say ""
		arrow_menu "$cur" "${rows[@]}" "＋ 添加新账号" "＋ 添加第三方 API 账号" "退出"
		say ""
		[ "$MENU_PICK" -ge 0 ] || return 1
		if [ "$MENU_PICK" -lt "$n" ]; then echo "${keys[MENU_PICK]}"; return 0; fi
		case $((MENU_PICK - n)) in
			0) cmd_add >&2 && { py keys | tail -n 1; return 0; } ;;
			1) cmd_add_api >&2 && { py keys | tail -n 1; return 0; } ;;
		esac
		return 1
	fi
	while :; do   # 没有完整终端时：输入编号
		say ""
		say "${C_B}选择 Claude 账号${C_0}"
		say ""
		for ((i = 0; i < n; i++)); do say "  $((i + 1)). ${rows[i]}"; done
		say ""
		[ -n "$last" ] && say "  回车   继续使用 $(py name "$last")"
		say "  编号   切换到对应账号"
		say "  a      添加新账号"
		say "  p      添加第三方 API 账号"
		say "  q      退出"
		say ""
		choice=$(ask "请选择：" "")
		if [ -z "$choice" ]; then
			[ -n "$last" ] && { echo "$last"; return 0; }
			choice=1
		fi
		case "$choice" in
			q|Q) return 1 ;;
			a|A|n|N) cmd_add >&2 && { py keys | tail -n 1; return 0; } ;;
			p|P) cmd_add_api >&2 && { py keys | tail -n 1; return 0; } ;;
			*[!0-9]*) warn "没看懂「${choice}」：请输入编号、a、p 或 q" ;;
			*) if [ "$choice" -ge 1 ] && [ "$choice" -le "$n" ]; then echo "${keys[choice - 1]}"; return 0; fi
			   warn "没有编号 ${choice}" ;;
		esac
	done
}

pick_account() {   # 参数给了就解析参数，否则交互选择
	if [ -n "${1:-}" ]; then py resolve "$1"; return; fi
	[ -n "$(py keys)" ] || die "还没有账号（cca add）"
	menu
}

# 这次走哪条路：在家走路由器的端口池；连不上路由器（出门在外）走本机 Clash 客户端的端口池（见下面"出门在外"一节）
probe() {   # probe 主机 端口…：任一端口 1 秒内连得上就返回 0（并行探测，在外面时最多等 1 秒）
	local h="$1" p ok=1
	local -a pids=()
	shift
	for p in "$@"; do
		if [ "$(uname)" = Darwin ]; then nc -z -G 1 "$h" "$p" >/dev/null 2>&1 & else nc -z -w 1 "$h" "$p" >/dev/null 2>&1 & fi
		pids+=($!)
	done
	for p in "${pids[@]}"; do wait "$p" && ok=0; done
	return $ok
}
at_home() {   # 连得上路由器（SSH 端口或端口池的第一个端口）就算在家；一次命令只探测一次
	if [ -z "${AT_HOME:-}" ]; then
		load_router
		AT_HOME=no
		[ -n "$ROUTER_HOST" ] && probe "$ROUTER_HOST" "$ROUTER_PORT" "$POOL_FIRST" && AT_HOME=yes
	fi
	[ "$AT_HOME" = yes ]
}
want_local() {   # 这次走本机 Clash 吗：按 config.json 的 route（CCA_ROUTE 可临时指定）；auto 时看连不连得上路由器
	load_router
	case "${CCA_ROUTE:-$ROUTE_PREF}" in router) return 1 ;; local) return 0 ;; esac
	! at_home
}
pick_route() {   # 需要先 eval "$(py env 名称)"；结果在 ROUTE（router|local）和 ACC_PROXY 里
	if want_local; then route_local; else route_router; fi
}
router_ensure() {   # 让路由器确认端口池在，并把各槽位切到账号的节点（API，无需重载；要重载时先问）
	local out rc
	router_ready || return 0
	out=$(rsh "$RDIR/cca-router.sh ensure-now" 2>&1); rc=$?
	[ -n "$out" ] && printf '%s\n' "$out" | LC_ALL=C sed 's/^/  │ /' >&2
	[ $rc -eq 3 ] && allow_reload && router_reload
	return 0
}
route_router() {   # 在家：经路由器的端口池
	[ -n "$ACC_PROXY" ] || { warn "还没配置路由器（cca router setup）"; return 1; }
	load_router
	router_ensure
	port_open "$PROXY_HOST" "$ACC_PORT" || {
		warn "端口 ${PROXY_HOST}:${ACC_PORT} 不通。为避免走错出口，已停止。排查：cca router status / cca router sync"
		return 1
	}
	ROUTE=router
}
route_note() {   # 给提示用：走的是哪个端口
	case "${ROUTE:-}" in
		local) printf '本机 %s 端口 %s' "$LOCAL_NAME" "$ACC_PORT" ;;
		direct) printf '直连' ;;
		*) printf '端口 %s' "$ACC_PORT" ;;
	esac
}

# 第三方 API 账号：接口地址经账号的出口连得上（不带 key；收到任何 HTTP 响应都算连得上）。结果在 COFFEE_LINE
api_check() {
	local code i
	local -a via=(--noproxy '*')
	[ -n "$ACC_PROXY" ] && via=(-x "$ACC_PROXY")
	for i in 1 2; do
		code=$(curl -s -o /dev/null -m 8 -w '%{http_code}' "${via[@]}" "$ACC_BASE_URL" 2>/dev/null)
		case "$code" in ''|000) ;; *) COFFEE_LINE="接口连得上"; return 0 ;; esac
	done
	COFFEE_LINE="连不上 ${ACC_BASE_URL}（$(route_note)）"
	return 1
}
settings_warn() { warn "共享的设置里有会盖掉每个账号自己的代理、接口地址或凭证的配置（${1}）。删掉后再用 cca 启动（第三方 API 用 cca add api 加成账号）"; }

# 经账号端口检测出口：claude.ai 看到的 IP + ip.net.coffee/claude 的风险数据（不上报会话）
coffee_check() {   # coffee_check [region]：region 时只看出口地区（不查 ip.net.coffee 的纯净度，查用量前用）
	local trace ip risk="" out rc min="$CCA_MIN_TRUST"
	trace=$(curl -s -m 8 -x "$ACC_PROXY" https://claude.ai/cdn-cgi/trace 2>/dev/null)
	ip=$(printf '%s\n' "$trace" | sed -n 's/^ip=//p')
	if [ "${1:-}" = region ]; then min=0
	elif [ -n "$ip" ]; then risk=$(curl -s -m 12 -x "$ACC_PROXY" "https://ip.net.coffee/api/iprisk/$ip" 2>/dev/null); fi
	out=$(py coffee "$min" "$trace" "$risk")
	rc=$?
	COFFEE_IP="$ip"
	COFFEE_LINE=$(printf '%s\n' "$out" | head -n 1)
	COFFEE_NOTE=$(printf '%s\n' "$out" | sed -n '2,$p')
	return $rc
}

preflight() {   # 账号的出口必须可用且干净，否则不启动（避免走错出口）
	local bad rc
	COFFEE_LINE=""
	if [ -n "$ACC_PORT" ]; then pick_route || return 1; else ROUTE=direct; fi   # 直连的第三方 API 账号不经端口
	if ! bad=$(py settings-check); then settings_warn "$bad"; return 1; fi
	[ -n "${CCA_SKIP_CHECK:-}" ] && return 0
	if [ "$ACC_KIND" = api ]; then   # claude.ai 的出口检测和第三方服务无关：只看接口连不连得上
		api_check && return 0
		warn "${COFFEE_LINE}"
		warn "已停止启动：确认地址没写错、服务商没出问题（确定没问题可以加 CCA_SKIP_CHECK=1 跳过检测）"
		return 1
	fi
	coffee_check
	rc=$?
	case $rc in
		0) ;;
		4) warn "出口检测没拿到评分（${COFFEE_LINE}），先继续" ;;
		1)
			warn "出口纯净度偏低：${COFFEE_LINE}"
			interactive && confirm "仍然用这个出口启动吗？" n || return 1 ;;
		*)
			warn "${COFFEE_LINE}"
			[ -n "$COFFEE_NOTE" ] && warn "$COFFEE_NOTE"
			warn "已停止启动。可以用 cca edit 给这个账号换个节点"
			return 1 ;;
	esac
	return 0
}

has_chrome() { [ -d "/Applications/Google Chrome.app" ] || [ -d "$HOME/Applications/Google Chrome.app" ]; }

open_chrome() {   # 需要先 eval "$(py env 名称)"
	local url="$1"
	if ! has_chrome; then
		warn "没装 Google Chrome，改用默认浏览器打开（不会走账号端口）"
		open "$url"
		return
	fi
	mkdir -p "$ACC_CHROME_DIR"
	open -na "Google Chrome" --args --user-data-dir="$ACC_CHROME_DIR" --no-first-run --no-default-browser-check \
		--proxy-server="$ACC_PROXY" "$url"
}

cmd_web() {
	local key
	key=$(pick_account "${1:-}") || return 0
	eval "$(py env "$key")"
	[ "$ACC_KIND" = api ] && die "${ACC_NAME} 是第三方 API 账号：网页版只能用官方账号"
	CCA_SKIP_CHECK=1 preflight || exit 1
	# 还没登录就先走 Claude Code 的登录（登录页预填邮箱）：网页版用同一个浏览器实例，登录一次两边都能用
	if [ -n "$ACC_EMAIL" ] && [ -n "$CLAUDE_BIN" ] && interactive && [ -z "$(auth_email)" ]; then
		py link "$ACC_KEY" && py sync "$ACC_KEY" || die "初始化账号目录失败"
		ensure_login || exit 1
	fi
	open_chrome "${2:-https://claude.ai/}"
	info "已用 ${ACC_NAME} 的浏览器实例打开 ${2:-claude.ai}（经 ${ACC_PROXY} → ${ACC_NODE}）"
}

cmd_browser() {   # Claude Code 登录时经 BROWSER 调用：在当前账号的浏览器实例里打开，登录地址没带邮箱时补上
	local key="${CCA_ACCOUNT:-$(py get last)}" url
	eval "$(py env "$key")" || exit 1
	[ -n "${CCA_PROXY:-}" ] && ACC_PROXY="$CCA_PROXY"   # 启动它的 cca 选好的出口（在外面时是本机 Clash 的端口）
	url=$(py login-url "$ACC_KEY" "$1") || url="$1"
	open_chrome "$url"
}

# ---------------------------------------------------------------------------
# Claude App（桌面版）多开：每个账号一份独立的资料目录（--user-data-dir），整个实例走账号的端口。
# Claude App 正常启动时不加单实例锁，同一个资料目录开两份会抢同一份数据库，所以先按进程查。
# ---------------------------------------------------------------------------
LAUNCHER_DIR="$HOME/Applications"
claude_app() {   # Claude App 装在哪（CCA_CLAUDE_APP 可指定）
	local d
	if [ -n "${CCA_CLAUDE_APP:-}" ]; then [ -d "$CCA_CLAUDE_APP" ] && printf '%s' "$CCA_CLAUDE_APP"; return; fi
	for d in /Applications/Claude.app "$HOME/Applications/Claude.app"; do
		[ -d "$d" ] && { printf '%s' "$d"; return 0; }
	done
	return 1
}
app_pid() { pgrep -f "Contents/MacOS/Claude .*--user-data-dir=$1( |\$)" | head -n 1; }   # 用这个资料目录的主进程
activate_pid() {   # 多开时 open -a 分不清是哪一个，按进程号切到前面
	osascript -l JavaScript -e "ObjC.import('AppKit'); var a = \$.NSRunningApplication.runningApplicationWithProcessIdentifier($1); a.unhide; a.activateWithOptions(\$.NSApplicationActivateAllWindows)" </dev/null >/dev/null 2>&1
}

launchers_sync() {   # 按账号表新建、改名、删除 ~/Applications 里的启动器；参数 remove-all 时全部删掉
	local app out op n
	app=$(claude_app) || app=""
	out=$(py launchers "$LAUNCHER_DIR" "$SELF" "$app" "${1:-}") || return 1
	while IFS=$'\t' read -r op n; do
		case "$op" in
			+) info "已生成启动器「${n}」：在聚焦搜索、启动台或 ${LAUNCHER_DIR} 里找" ;;
			-) info "已删除启动器「${n}」" ;;
			!) warn "${LAUNCHER_DIR}/${n}.app 已存在且不是 cca 生成的，没有覆盖" ;;
		esac
	done <<< "$out"
	return 0
}

cmd_app() {   # 用账号专属的资料目录和出口打开 Claude App；这个账号的已经开着就切到它
	local key app dir pid first="" i p
	[ "${1:-}" = --launchers ] && { launchers_sync; return; }
	app=$(claude_app) || die "没找到 Claude App：先从 https://claude.ai/download 下载安装"
	key=$(pick_account "${1:-}") || return 0
	eval "$(py env "$key")"
	[ "$ACC_KIND" = api ] && die "${ACC_NAME} 是第三方 API 账号：Claude App 只能用官方账号"
	key="$ACC_KEY" dir="$ACC_DESKTOP_DIR"
	pid=$(app_pid "$dir")
	if [ -n "$pid" ]; then
		activate_pid "$pid"
		info "${ACC_NAME} 的 Claude App 已经开着，已切到前面"
		return 0
	fi
	sync_if_changed
	launchers_sync
	preflight || exit 1
	py link "$key" && py sync "$key" || die "初始化账号目录失败"
	[ -e "$dir/Local State" ] || first=1
	mkdir -p "$dir" && chmod 700 "$dir"
	open -n -a "$app" --env CLAUDE_CONFIG_DIR="$ACC_CLAUDE_DIR" \
		--env HTTPS_PROXY="$ACC_PROXY" --env https_proxy="$ACC_PROXY" --env HTTP_PROXY="$ACC_PROXY" --env http_proxy="$ACC_PROXY" \
		--env NO_PROXY="$CCA_NO_PROXY" --env no_proxy="$CCA_NO_PROXY" \
		--args --user-data-dir="$dir" --proxy-server="$ACC_PROXY" --proxy-bypass-list="$CCA_PROXY_BYPASS" ||
		die "打开 Claude App 失败"
	for i in $(seq 1 40); do [ -e "$dir/Local State" ] && break; sleep 0.25; done
	if [ ! -e "$dir/Local State" ]; then   # 不认 --user-data-dir 的话，它会用默认资料（你主账号的登录）走这个账号的出口
		for p in $(pgrep -f -- "--user-data-dir=$dir( |\$)"); do kill "$p" 2>/dev/null; done
		die "Claude App 没有用 ${ACC_NAME} 自己的资料目录启动（可能是新版本不再支持多开），已经关掉，免得用错账号或出口"
	fi
	okay "已打开 ${ACC_LABEL} 的 Claude App，出口 ${ACC_NODE}（$(route_note)）"
	[ -n "$first" ] && info "第一次打开要登录 ${ACC_EMAIL:-这个账号}：用邮箱登录全程走这个账号的出口；用 Google 登录时，那一次会走系统网络"
	return 0
}

# ---------------------------------------------------------------------------
# 出门在外：连不上路由器时改走本机的 Clash 客户端。端口池和路由器上的一样：127.0.0.1 上的 mixed 入站 cca-n
# （端口 7900+n）→ select 策略组 CCA-n，启动账号前经客户端内核的控制接口把组切到账号的节点（不用重载）。
# Clash Verge 自动配置：在它的全局扩展脚本末尾加一段（它重新生成配置时带上端口池），再把端口池热加载进
# 正在运行的内核（PUT /configs，和它自己改完配置后的做法一样，不用重启）；其它基于 mihomo 的客户端由用户
# 手动加配置，cca 经它的外部控制接口切换节点。
# ---------------------------------------------------------------------------
VERGE_ID="io.github.clash-verge-rev.clash-verge-rev"
load_local() {
	eval "$(py local-env)"
	[ "$LOCAL_CTL" = unix: ] && LOCAL_CTL="unix:$(getconf DARWIN_USER_TEMP_DIR 2>/dev/null)verge-mihomo.sock"
	return 0
}
local_ready() { [ -n "$LOCAL_CLIENT" ]; }
json_esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
json_get() { printf '%s' "$LBODY" | sed -n 's/.*"'"$1"'":"\([^"]*\)".*/\1/p'; }   # 响应里的字符串字段
lctl() {   # lctl 方法 路径 [JSON 或 @文件]：本机 Clash 内核的控制接口；响应体在 ${LBODY}，HTTP 状态码在 ${LCODE}
	local out url nl=$'\n'
	local -a a=(-s -m "${LCTL_TIMEOUT:-8}" -X "$1" -w '\n%{http_code}')
	case "$LOCAL_CTL" in
		unix:*) a+=(--unix-socket "${LOCAL_CTL#unix:}"); url="http://localhost$2" ;;
		*) url="${LOCAL_CTL%/}$2"; [ -n "$LOCAL_SECRET" ] && a+=(-H "Authorization: Bearer $LOCAL_SECRET") ;;
	esac
	[ -n "${3:-}" ] && a+=(-H 'Content-Type: application/json' --data-binary "$3")
	out=$(curl "${a[@]}" "$url" 2>/dev/null)
	LCODE=${out##*$nl}
	LBODY=${out%$nl*}
	case "$LCODE" in [1-5][0-9][0-9]) ;; *) LCODE=000; LBODY="" ;; esac
}
local_up() {   # 本机 Clash 内核的控制接口能用；Clash Verge 没在运行时（交互）问要不要打开它
	local i
	lctl GET /version
	[ "$LCODE" = 200 ] && return 0
	if [ "$LOCAL_CLIENT" != clash-verge ]; then
		warn "连不上本机 Clash 的控制接口 ${LOCAL_CTL}：确认客户端在运行（地址或密钥变了就重新运行 cca local setup）"
		return 1
	fi
	warn "Clash Verge 没在运行"
	interactive && confirm "现在打开 Clash Verge 吗？" y || return 1
	open -g -b "$VERGE_ID" || return 1
	for i in $(seq 1 40); do
		sleep 0.5
		load_local
		lctl GET /version
		[ "$LCODE" = 200 ] && return 0
	done
	warn "等了 20 秒，Clash Verge 的内核还没就绪"
	return 1
}
local_ports_ok() {   # 端口池的每个端口都在本机监听
	local p
	for p in $(seq "$LOCAL_FIRST" "$LOCAL_LAST"); do port_open 127.0.0.1 "$p" || return 1; done
}
verge_script() {   # 全局扩展脚本里 cca 的那一段保持最新（内容变了才写；Clash Verge 下次重新生成配置时用上）
	py local-script "$VERGE_DIR/profiles/Script.js" install
	case $? in
		0) return 0 ;;
		3) warn "Clash Verge 全局扩展脚本里的 main 是用 const/let 定义的，cca 接不上：改成 function main(config, profileName) { … } 再试" ;;
		*) warn "写 Clash Verge 的全局扩展脚本失败" ;;
	esac
	return 1
}
verge_apply() {   # verge_apply [remove]：在 Clash Verge 当前的运行配置里加上（或去掉）端口池，交给内核重新加载
	local f="$CCA_HOME/local.put.$$" mode
	( umask 077; py local-patch "$VERGE_DIR/clash-verge.yaml" "${1:-install}" > "$f" ) ||   # 里面有节点的密钥，只给自己读
		{ rm -f "$f"; warn "读不懂 Clash Verge 的运行配置：退出再打开 Clash Verge，它会按全局扩展脚本重新生成"; return 1; }
	lctl GET /configs
	mode=$(json_get mode)
	lctl PUT '/configs?force=true' "@$f"
	rm -f "$f"
	case "$LCODE" in
		2??) [ -n "$mode" ] && lctl PATCH /configs "{\"mode\":\"$mode\"}"   # 运行配置文件里的模式可能比界面上切换过的旧
		     return 0 ;;
	esac
	warn "Clash Verge 的内核没接受新配置（HTTP ${LCODE}）：$(printf '%s' "$LBODY" | head -c 200)"
	return 1
}
local_apply() {   # 把端口池放进正在运行的本机 Clash 内核
	local i
	if [ "$LOCAL_CLIENT" != clash-verge ]; then
		warn "本机 Clash 里的端口池和账号表对不上（可选节点或账号数变了）：重新运行 cca local setup，按提示更新客户端的配置"
		return 1
	fi
	info "正在把 cca 的端口池加进 Clash Verge（127.0.0.1:${LOCAL_FIRST}–${LOCAL_LAST}），它会重新加载一次配置"
	verge_apply || return 1
	for i in $(seq 1 20); do local_ports_ok && break; sleep 0.25; done
	local_ports_ok || { warn "Clash Verge 重新加载了配置，但端口 ${LOCAL_FIRST}–${LOCAL_LAST} 没有全部监听（可能被别的程序占用了）"; return 1; }
	py local-set applied "$LOCAL_WANT"
}
local_select_all() {   # 每个槽位切到分给它的账号的节点，空槽位切到 REJECT。返回 2：有策略组不在运行中的内核里
	local g node
	while IFS=$'\t' read -r g node; do
		[ -n "$g" ] || continue
		lctl GET "/proxies/$g"
		[ "$LCODE" = 200 ] || return 2
		[ "$(json_get now)" = "$node" ] && continue
		lctl PUT "/proxies/$g" "{\"name\":\"$(json_esc "$node")\"}"
		case "$LCODE" in 2??) ;; *) lctl PUT "/proxies/$g" '{"name":"REJECT"}' ;; esac   # 客户端里没有这个节点：宁可断开也不换出口
	done < <(py select-lines)
	return 0
}
local_ensure() {   # 本机端口池可用：内核在跑、全局扩展脚本最新、端口池在运行中的内核里、每个槽位切到账号的节点
	load_local
	local_up || return 1
	if [ "$LOCAL_CLIENT" = clash-verge ]; then verge_script || return 1; fi
	if [ "$LOCAL_APPLIED" != "$LOCAL_WANT" ] || ! local_ports_ok; then local_apply || return 1; fi
	local_select_all && return 0
	local_apply && local_select_all   # 组不在运行中的内核里（客户端重新生成过配置，却没带上端口池）
}
local_offer() {   # 在外面、还没配置本机 Clash：说明情况；交互时接着配置
	warn "连不上路由器${ROUTER_HOST:+ ${ROUTER_HOST}}（可能不在家里的网络）"
	if ! interactive; then
		warn "在外面要改走本机的 Clash 客户端（例如 Clash Verge）：在终端里运行 cca local setup 配置一次"
		return 1
	fi
	say "  在外面可以改走本机的 Clash 客户端：每个账号在本机开一个端口，走它自己的节点。"
	cmd_local_setup
}
route_local() {   # 出门在外：经本机 Clash 的端口池（需要先 eval "$(py env 名称)"）
	load_local
	local_ready || local_offer || return 1
	local_ensure || return 1
	lctl GET "/proxies/CCA-${ACC_SLOT}"
	if [ "$(json_get now)" != "$ACC_NODE" ]; then
		warn "本机 ${LOCAL_NAME} 里没有节点「${ACC_NODE}」：${ACC_NAME} 在外面用不了，为避免走错出口已停止（可以用 cca edit 换一个两边都有的节点）"
		return 1
	fi
	port_open 127.0.0.1 "$ACC_PORT" || { warn "本机端口 127.0.0.1:${ACC_PORT} 不通。排查：cca local status"; return 1; }
	ACC_PROXY="http://127.0.0.1:${ACC_PORT}"
	ROUTE=local
}
cmd_local_setup() {   # Clash Verge 自动配置；其它基于 mihomo 的客户端按提示手动加配置
	local miss
	need_tty
	py validate || die "账号表有错误：运行 cca edit 修正"
	load_local
	[ "$LOCAL_SLOTS" -gt 0 ] || { warn "还没有账号（cca add）"; return 1; }
	[ "$VERGE_FOUND" = 1 ] || { manual_setup; return; }
	say ""
	say "  检测到 Clash Verge。cca 会在它的「全局扩展脚本」末尾加一段代码：在本机 127.0.0.1:${LOCAL_FIRST}–${LOCAL_LAST}"
	say "  开 ${LOCAL_SLOTS} 个端口，每个端口一个策略组 CCA-n，启动账号前 cca 把它切到账号的节点；然后让 Clash Verge 重新加载一次配置。"
	say "  原来的配置、规则和系统代理都不变；不想用了运行 cca local off 删掉。"
	confirm "现在配置 Clash Verge 吗？" y || return 1
	py local-set client clash-verge || return 1
	local_ensure || return 1
	miss=$(py local-missing "$VERGE_DIR/clash-verge.yaml")
	[ -n "$miss" ] && warn "Clash Verge 里没有这些节点：${miss}。用它们的账号在外面会被拒绝连接，直到 Clash Verge 里有同名节点"
	okay "本机端口池已就绪：Clash Verge 127.0.0.1:${LOCAL_FIRST}–${LOCAL_LAST}，连不上路由器时账号自动走这里"
}
manual_setup() {   # 其它基于 mihomo（Clash Meta 内核）的客户端：用户把配置加进去，cca 经它的外部控制接口切换节点
	local ctl secret
	say ""
	say "  没找到 Clash Verge。其它基于 mihomo（Clash Meta 内核）的客户端也可以，要手动做两件事："
	say "  1. 把下面 listeners 和 proxy-groups 的条目，分别追加到客户端配置（或覆写）里的同名列表，保存并重新加载："
	say ""
	py local-snippet | sed 's/^/       /' >&2
	say ""
	say "  2. 打开客户端的外部控制（external-controller），cca 用它切换各账号的节点"
	confirm "这两件都做好了吗？" y || return 1
	ctl=$(ask "  外部控制地址（例如 127.0.0.1:9090；Unix socket 写 unix:/路径）：" "")
	[ -n "$ctl" ] || return 1
	case "$ctl" in unix:*|http://*|https://*) ;; *) ctl="http://$ctl" ;; esac
	secret=$(ask "  密钥 secret（没有就直接回车）：" "")
	py local-set client manual controller "$ctl" secret "$secret" || return 1
	load_local
	lctl GET /version
	if [ "$LCODE" != 200 ]; then
		py local-set client ''
		warn "连不上 ${ctl}（HTTP ${LCODE}）：检查地址和密钥后重新运行 cca local setup"
		return 1
	fi
	py local-set applied "$LOCAL_WANT"
	local_ensure || return 1
	okay "本机端口池已就绪：127.0.0.1:${LOCAL_FIRST}–${LOCAL_LAST}，连不上路由器时账号自动走这里"
}
local_remove() {   # 删掉 Clash Verge 全局扩展脚本里 cca 的那一段，并从运行中的内核里移除端口池
	load_local
	if [ "$LOCAL_CLIENT" = clash-verge ]; then
		py local-script "$VERGE_DIR/profiles/Script.js" remove || warn "改 Clash Verge 的全局扩展脚本失败"
		lctl GET /version
		if [ "$LCODE" = 200 ]; then verge_apply remove || warn "端口池要等 Clash Verge 下次重新加载配置后才消失"; fi
	elif local_ready; then
		info "请自己从本机 Clash 客户端的配置里删掉 cca-1… 入站和 CCA-1… 策略组"
	fi
	py local-set client ''
}
cmd_local_status() {
	local g p node name st now
	load_local
	if at_home; then info "现在连得上路由器 ${ROUTER_HOST}：账号走路由器的端口"
	else info "现在连不上路由器${ROUTER_HOST:+ ${ROUTER_HOST}}：账号走本机 Clash 的端口"; fi
	if ! local_ready; then
		if [ "$VERGE_FOUND" = 1 ]; then info "检测到 Clash Verge，还没配置（cca local setup）"
		else info "还没配置本机 Clash 客户端（cca local setup）"; fi
		return 0
	fi
	lctl GET /version
	[ "$LCODE" = 200 ] || { warn "${LOCAL_NAME} 没在运行（控制接口 ${LOCAL_CTL}）"; return 0; }
	say ""
	say "  ${LOCAL_NAME}（控制接口 ${LOCAL_CTL}）"
	while IFS=$'\t' read -r g p node name; do
		if port_open 127.0.0.1 "$p"; then st="监听中"; else st="${C_R}不通${C_0}"; fi
		lctl GET "/proxies/$g"
		if [ "$LCODE" = 200 ]; then now=$(json_get now); else now="（不在内核里）"; fi
		say "  ${g}  127.0.0.1:${p}  ${st}  → ${now}${name:+   ${C_D}${name}${C_0}}"
	done < <(py slot-rows)
	say ""
}
cmd_local() {
	case "${1:-status}" in
		status) cmd_local_status ;;
		setup) cmd_local_setup ;;
		off)
			load_local
			local_ready || { info "还没配置本机 Clash"; return 0; }
			local_remove
			okay "已移除本机 Clash 的端口池（之后在外面连不上路由器时会再问）" ;;
		*) die "用法: cca local [status|setup|off]" ;;
	esac
}

cmd_check() {
	local keys key ips="" rc host="" route=""
	if [ -n "${1:-}" ]; then keys=$(py resolve "$1") || return 1; else keys=$(py keys); fi
	[ -n "$keys" ] || { info "还没有账号"; return 0; }
	while IFS= read -r key; do
		eval "$(py env "$key")" || continue
		if [ -n "$ACC_PORT" ] && [ -z "$route" ]; then   # 第一个走端口的账号：选好路
			load_router
			host="$PROXY_HOST" route=router
			if want_local; then   # 在外面：先让本机端口池就绪、切好节点
				load_local
				local_ready || die "连不上路由器，本机 Clash 也还没配置：运行 cca local setup"
				local_ensure || return 1
				host=127.0.0.1 route=local
			fi
		fi
		ROUTE=direct
		if [ -n "$ACC_PORT" ]; then
			ACC_PROXY="http://${host}:${ACC_PORT}" ROUTE="$route"
			if ! port_open "$host" "$ACC_PORT"; then
				say "  ${ACC_NAME}  ${ACC_NODE}  ${C_R}端口 ${ACC_PORT} 不通${C_0}"
				continue
			fi
		fi
		if [ "$ACC_KIND" = api ]; then   # 第三方 API：只看接口连不连得上
			api_check
			say "  ${ACC_NAME}  ${ACC_NODE}${ACC_PORT:+  :${ACC_PORT}}  ${COFFEE_LINE}"
			continue
		fi
		coffee_check
		rc=$?
		case $rc in 0) ;; *) COFFEE_LINE="$COFFEE_LINE ${C_Y}(${COFFEE_NOTE//$'\n'/; })${C_0}" ;; esac
		say "  ${ACC_NAME}  ${ACC_NODE}  :${ACC_PORT}  ${COFFEE_LINE}"
		[ -n "$COFFEE_IP" ] && ips="$ips$COFFEE_IP"$'\n'
	done <<< "$keys"
	local dup
	dup=$(printf '%s' "$ips" | sort | uniq -d)
	[ -n "$dup" ] && warn "有账号共用同一个出口 IP：$(echo $dup)"
	return 0
}

run_account() {
	local key="$1" rc e dropped
	local -a extra=()
	shift
	[ -n "$CLAUDE_BIN" ] || die "找不到 claude 命令"
	eval "$(py env "$key")" || die "读取账号失败: $key"
	key="$ACC_KEY"
	if [ "$ACC_KIND" = api ]; then   # 地址、模型和 apiKeyHelper 经 --settings 交给 claude；再传一个 --settings 会把它整个顶掉
		case " $* " in *" --settings "*|*" --settings="*) die "${ACC_NAME} 是第三方 API 账号：cca 用 --settings 传它的地址和 key，不能再加 --settings" ;; esac
		api_key_ready || exit 1
		extra=(--settings "$ACC_SETTINGS")
	fi
	preflight || exit 1
	py link "$key" || die "链接共享目录失败"
	py sync "$key" || die "同步 .claude.json 失败"
	[ "$ACC_KIND" = api ] || ensure_login || exit 1
	py set-last "$key"
	say ""
	if [ "$ACC_KIND" = api ]; then
		say "  ${C_B}${ACC_NAME}${C_0}   ${C_D}第三方 API · ${ACC_BASE_URL}${ACC_MODEL:+ · ${ACC_MODEL}}${C_0}"
		say "  ${C_D}出口${C_0}  ${ACC_NODE}$([ -n "$ACC_PORT" ] && printf '（%s）' "$(route_note)") · ${COFFEE_LINE:-未检测}"
	else
		e=$(py email "$key")
		if [ -n "$ACC_EMAIL" ]; then e="已登录"; else e="已登录 ${e}"; fi
		if [ -n "$ACC_ALIAS" ] && [ -n "$ACC_EMAIL" ]; then
			say "  ${C_B}${ACC_ALIAS}${C_0}  ${ACC_EMAIL}   ${C_D}${e} · $(route_note)${C_0}"
		else
			say "  ${C_B}${ACC_NAME}${C_0}   ${C_D}${e} · $(route_note)${C_0}"
		fi
		if [ -n "$COFFEE_LINE" ]; then say "  ${C_D}出口${C_0}  ${ACC_NODE} · ${COFFEE_LINE}"
		else say "  ${C_D}出口${C_0}  ${ACC_NODE}（未检测）"; fi
	fi
	say ""
	child_env
	if [ -n "$DROPPED" ]; then
		if [ "$ACC_KIND" = api ]; then warn "已为本次启动屏蔽环境里继承的 ${DROPPED}（这个账号的接口、key 和模型由 cca 设定）"
		else warn "已为本次启动屏蔽环境里继承的 ${DROPPED}（官方账号用它自己的登录；要换模型写进 ~/.claude/settings.json 或用 /model）"; fi
	fi
	trap ':' INT TERM HUP
	env "${UNSETS[@]}" "${SETS[@]}" "$CLAUDE_BIN" "${extra[@]}" "$@" 3<&-
	rc=$?
	trap - INT TERM HUP
	py link "$key" >/dev/null || warn "退出后链接共享目录失败"
	py sync "$key" >/dev/null || warn "退出后同步 .claude.json 失败"
	e=$(py email "$key")
	if [ -n "$ACC_EMAIL" ] && [ -n "$e" ] && [ "$(lower "$e")" != "$(lower "$ACC_EMAIL")" ]; then
		warn "会话里切换成了 ${e}，和账号表里的 ${ACC_EMAIL} 不符；下次启动会要求改回"
	fi
	return $rc
}

sync_if_changed() {   # 账号表或路由器端脚本变了：先同步到路由器（需要重载但没获同意时照常继续）；在外面就等回家
	py validate || die "账号表有错误：运行 cca edit 修正"
	py secrets-forget   # 直接改账号表删掉的第三方 API 账号：钥匙串里的 key 一起删
	if [ "$(digest)" != "$(py get synced)" ]; then
		router_needed || return 0   # 只有直连的第三方 API 账号、也没配置路由器：没有要同步的
		if router_ready && ! at_home; then
			info "账号表或路由器端脚本有变化：现在连不上路由器，回到家里的网络后再同步"
			return 0
		fi
		info "账号表或路由器端脚本有变化，先同步到路由器"
		router_sync
		case $? in 0|3) ;; *) die "同步失败，已停止（避免走错出口）" ;; esac
	fi
}

launch() {
	local sel=""
	if [ -z "$(py keys)" ]; then
		info "还没有账号，先新增一个"
		cmd_add || exit 1
		sel="$ADDED_KEY"
	fi
	sync_if_changed
	launchers_sync   # 只改别名时摘要不变，启动器的名字也要跟上
	if [ -n "${OPT_ACCOUNT:-}" ]; then
		sel=$(py resolve "$OPT_ACCOUNT") || exit 1
	elif [ -z "$sel" ]; then
		if interactive; then
			sel=$(menu) || exit 0
		else
			sel=$(py get last)
			[ -n "$sel" ] || sel=$(py keys | head -n 1)
		fi
	fi
	run_account "$sel" "$@"
}

# ---------------------------------------------------------------------------
# 订阅用量：每个官方账号经它自己的出口，让 Claude Code 自己查（get_usage 控制请求，token 由它读取和刷新，
# cca 不碰登录凭证）。几个账号并行查；查不到的显示上次的缓存（注明多久前）
# ---------------------------------------------------------------------------
usage_one() {   # 后台：查一个官方账号，结果写到 $1.json，跳过的原因写到 $1.skip；需要先 eval "$(py env 名称)" 并设好 ACC_PROXY
	local o="$1" e trace out rc
	e=$(py email "$ACC_KEY")
	if [ -z "$e" ]; then printf 'login\t\n' > "$o.skip"; return 0; fi
	if [ -n "$ACC_EMAIL" ] && [ "$(lower "$e")" != "$(lower "$ACC_EMAIL")" ]; then   # 登错号：不拿别的账号走这个出口
		printf 'mismatch\t%s\n' "$e" > "$o.skip"; return 0
	fi
	if [ -z "$ACC_PROXY" ]; then printf 'route\t\n' > "$o.skip"; return 0; fi
	if ! port_open "$USAGE_HOST" "$ACC_PORT"; then printf 'port\t%s\n' "$ACC_PORT" > "$o.skip"; return 0; fi
	if [ -z "${CCA_SKIP_CHECK:-}" ]; then   # 出口在受限地区时不拿账号去查（和启动前的检测一样，只是不看纯净度）
		coffee_check region
		case $? in
			2) printf 'region\t%s\n' "$COFFEE_NOTE" > "$o.skip"; return 0 ;;
			3) printf 'trace\t\n' > "$o.skip"; return 0 ;;
		esac
	fi
	child_env
	env "${UNSETS[@]}" -u CLAUDECODE -u CLAUDE_CODE_ENTRYPOINT -u CLAUDE_CODE_SSE_PORT "${SETS[@]}" \
		"${PYRUN[@]}" usage-query "$CLAUDE_BIN" "${CCA_USAGE_TIMEOUT:-25}" > "$o.json" 2>/dev/null
}

cmd_usage() {   # cca usage [账号] [--json]
	local json="" q="" key i tmp rc bad color=""
	local -a keys=() pids=()
	while [ $# -gt 0 ]; do
		case "$1" in
			--json) json=json ;;
			-h|--help) say "用法: cca usage [账号] [--json]"; return 0 ;;
			-*) die "用法: cca usage [账号] [--json]" ;;
			*) [ -z "$q" ] || die "用法: cca usage [账号] [--json]（写一个账号，或者不写查全部）"; q="$1" ;;
		esac
		shift
	done
	[ -n "$CLAUDE_BIN" ] || die "找不到 claude 命令"
	if [ -n "$q" ]; then
		key=$(py resolve "$q") || exit 1
		eval "$(py env "$key")"
		[ "$ACC_KIND" = api ] && die "${ACC_NAME} 是第三方 API 账号，没有订阅用量可查（用量看服务商的控制台）"
		keys=("$key")
	else
		while IFS= read -r key; do [ -n "$key" ] && keys+=("$key"); done < <(py keys official)
		[ ${#keys[@]} -gt 0 ] || { info "还没有官方账号（cca add）"; return 0; }
	fi
	sync_if_changed
	if ! bad=$(py settings-check); then settings_warn "$bad"; return 1; fi
	USAGE_HOST=""
	if want_local; then
		load_local
		if local_ready && local_ensure; then USAGE_HOST=127.0.0.1
		else warn "现在连不上路由器，本机 Clash 也用不了：只能显示上次的用量（cca local setup 配置本机 Clash）"; fi
	else
		router_ensure
		USAGE_HOST="$PROXY_HOST"
	fi
	tmp=$(mktemp -d "$CCA_HOME/usage.XXXXXX") || die "建临时目录失败"
	# Ctrl-C、关掉终端：后台的查询忽略 SIGINT，要自己停掉它们（连同它们起的 python、curl；claude 的 stdin 一断也就退出了）
	trap 'for i in "${pids[@]}"; do pkill -P "$i"; kill "$i"; done 2>/dev/null; rm -rf "$tmp"; exit 130' INT TERM HUP
	[ -n "$json" ] || info "正在经各账号自己的出口查询用量（${#keys[@]} 个账号）…"
	for ((i = 0; i < ${#keys[@]}; i++)); do   # 最多同时查 4 个
		eval "$(py env "${keys[i]}")"
		ACC_PROXY="${USAGE_HOST:+http://${USAGE_HOST}:${ACC_PORT}}"
		usage_one "$tmp/$i" </dev/null 3<&- &
		pids+=($!)
		if [ ${#pids[@]} -ge 4 ]; then wait "${pids[0]}"; pids=("${pids[@]:1}"); fi
	done
	wait
	trap - INT TERM HUP
	[ -t 1 ] && [ -z "${NO_COLOR:-}" ] && color=1
	py usage-render "$tmp" "${json:-table}" "$(term_cols)" "$color" "${keys[@]}"; rc=$?
	rm -rf "$tmp"
	return $rc
}

# ---------------------------------------------------------------------------
# 自动更新：GitHub Releases 上的 cca + cca.sig，只装签名有效、版本号更新的脚本
#   · 启动时：有已经下载校验好的新版本（cca.next）就换上，并用新版本重新执行这次命令
#   · 距上次检查超过一天：在脱离终端的新会话里后台检查和下载，不拖慢启动，Ctrl-C 也打断不了它
#   · cca 就在 git 仓库根目录里（开发用的工作区）时不自动更新，免得覆盖还没发布的改动
# ---------------------------------------------------------------------------
UPD="$CCA_HOME/update"

is_ver() { [[ "$1" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; }
ver_gt() {   # ver_gt 2.10.0 2.9.1 → 真
	local IFS=. i
	local -a a b
	a=($1)
	b=($2)
	for ((i = 0; i < 3; i++)); do
		[ "${a[i]}" -gt "${b[i]}" ] && return 0
		[ "${a[i]}" -lt "${b[i]}" ] && return 1
	done
	return 1
}
dev_mode() { [ -e "${SELF%/*}/.git" ]; }

verify_release() {   # verify_release 脚本 签名：签名有效、语法正确时打印脚本里的版本号
	local v
	mkdir -p "$UPD" && printf 'cca-release %s\n' "$RELEASE_KEY" > "$UPD/allowed_signers" || return 1
	ssh-keygen -Y verify -f "$UPD/allowed_signers" -I cca-release -n cca-release -s "$2" < "$1" >/dev/null 2>&1 || return 1
	"$BASH" -n "$1" 2>/dev/null || return 1
	v=$(sed -n 's/^VERSION="\([0-9.]*\)"$/\1/p' "$1" | head -n 1)
	is_ver "$v" && printf '%s' "$v"
}

retry3() { "$@" && return 0; sleep 2; "$@" && return 0; sleep 2; "$@"; }   # 有的网络偶尔会丢新连接

latest_version() {   # releases/latest 会 302 到 …/releases/tag/vX.Y.Z
	local u
	u=$(retry3 curl -fsS -o /dev/null -m 15 -w '%{redirect_url}' "$UPDATE_REPO/releases/latest" 2>/dev/null) || return 1
	u="${u##*/tag/v}"
	is_ver "$u" && printf '%s' "$u"
}

fetch_release() {   # fetch_release 版本：下载并校验，成功后放在 $UPD/cca.next；失败原因在 FETCH_ERR
	local v="$1" tmp got rc=1
	FETCH_ERR="下载失败（网络不通，或 GitHub 暂时不可用）"
	mkdir -p "$UPD" && tmp=$(mktemp -d "$UPD/dl.XXXXXX") || return 1
	if retry3 curl -fsSL -m 120 -o "$tmp/cca" "$UPDATE_REPO/releases/download/v$v/cca" 2>/dev/null &&
		retry3 curl -fsSL -m 30 -o "$tmp/cca.sig" "$UPDATE_REPO/releases/download/v$v/cca.sig" 2>/dev/null; then
		FETCH_ERR="签名校验没通过（文件可能被篡改或不完整），没有安装"
		if got=$(verify_release "$tmp/cca" "$tmp/cca.sig") && [ "$got" = "$v" ]; then
			mv -f "$tmp/cca.sig" "$UPD/cca.next.sig" && mv -f "$tmp/cca" "$UPD/cca.next" && rc=0
		fi
	fi
	rm -rf "$tmp"
	return $rc
}

# 再校验一次 cca.next，然后原子替换当前脚本。bash 是边读边执行脚本的，原地覆盖会让正在运行的 cca
# 读到半截新代码；mv 换上的是新文件，正在运行的 cca 还读着旧文件。旧版本留着，可以 cca update --rollback
install_next() {
	local v tmp="$SELF.new.$$"
	if ! v=$(verify_release "$UPD/cca.next" "$UPD/cca.next.sig") || ! ver_gt "$v" "$VERSION"; then
		rm -f "$UPD/cca.next" "$UPD/cca.next.sig"
		return 1
	fi
	if ! { cp -p "$SELF" "$UPD/cca.prev" && printf '%s\n' "$VERSION" > "$UPD/cca.prev.version" &&
		cp "$UPD/cca.next" "$tmp" && chmod 755 "$tmp" && mv -f "$tmp" "$SELF"; }; then
		rm -f "$tmp"
		warn "替换 $SELF 失败，没有更新"
		return 1
	fi
	rm -f "$UPD/cca.next" "$UPD/cca.next.sig"
	NEW_VERSION="$v"
}

update_hook() {   # 启动时调用，参数是这次命令的参数
	local mode v
	dev_mode && return 0
	mode=$(py get update)
	[ "$mode" = off ] && return 0
	if [ -f "$UPD/cca.next" ]; then
		if [ "$mode" = auto ]; then
			if install_next; then
				info "cca 已自动更新：${VERSION} → ${NEW_VERSION}（不想要这个版本：cca update --rollback）"
				exec "$SELF" "$@"
			fi
		else
			v=$(sed -n 's/^VERSION="\([0-9.]*\)"$/\1/p' "$UPD/cca.next" | head -n 1)
			info "cca 有新版本 ${v}（当前 ${VERSION}），运行 cca update 安装"
		fi
	fi
	if [ -z "$(find "$UPD/checked" -mmin -1440 2>/dev/null)" ]; then
		mkdir -p "$UPD" && touch "$UPD/checked"
		( perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' "$SELF" _update-fetch </dev/null >"$UPD/log" 2>&1 3<&- & )
	fi
	return 0
}

cmd_update_fetch() {   # 后台任务：有新版本就下载校验好，下次启动时换上
	local v
	mkdir -p "$UPD" || return 1
	[ -n "$(find "$UPD/lock" -maxdepth 0 -mmin +30 2>/dev/null)" ] && rmdir "$UPD/lock"   # 上次异常退出留下的锁
	mkdir "$UPD/lock" 2>/dev/null || return 0
	trap 'rmdir "$UPD/lock" 2>/dev/null' EXIT
	echo "$(date '+%F %T') 检查更新，当前 ${VERSION}"
	v=$(latest_version) || { echo "拿不到最新版本号"; return 1; }
	if ! ver_gt "$v" "$VERSION"; then echo "已是最新（${v}）"; return 0; fi
	if [ "$v" = "$(cat "$UPD/skip" 2>/dev/null)" ]; then echo "${v} 被回退过，不再自动安装"; return 0; fi
	if fetch_release "$v"; then echo "已下载并校验 ${v}，下次启动时安装"; else echo "${v}：${FETCH_ERR}"; return 1; fi
}

update_rollback() {
	local pv tmp="$SELF.new.$$"
	dev_mode && die "开发模式：用 git 切换版本"
	[ -f "$UPD/cca.prev" ] || die "没有可以退回的版本"
	pv=$(cat "$UPD/cca.prev.version" 2>/dev/null)
	"$BASH" -n "$UPD/cca.prev" 2>/dev/null || die "旧版本文件损坏，没有退回"
	cp "$UPD/cca.prev" "$tmp" && chmod 755 "$tmp" && mv -f "$tmp" "$SELF" || { rm -f "$tmp"; die "退回失败"; }
	printf '%s\n' "$VERSION" > "$UPD/skip"
	rm -f "$UPD/cca.prev" "$UPD/cca.prev.version" "$UPD/cca.next" "$UPD/cca.next.sig"
	okay "已退回 ${pv:-上一个版本}；${VERSION} 不会再自动安装，有更新的版本时照常更新"
}

cmd_update() {
	local v
	case "${1:-}" in
		auto|notify|off)
			py set update "$1" || return 1
			case "$1" in
				auto) okay "自动更新：每天检查，有新版本就在下次启动时安装" ;;
				notify) okay "自动更新：每天检查，有新版本只提示，运行 cca update 才安装" ;;
				off) okay "自动更新已关闭（cca update 仍可手动更新）" ;;
			esac
			return 0 ;;
		--rollback) update_rollback; return ;;
		''|--check) ;;
		*) die "用法: cca update [--check | --rollback | auto | notify | off]" ;;
	esac
	if dev_mode && [ "${1:-}" != --check ]; then
		info "开发模式：${SELF} 在 git 仓库里，用 git pull 更新"
		return 0
	fi
	info "正在检查最新版本（${UPDATE_REPO}）…"
	v=$(latest_version) || die "拿不到最新版本号（网络不通，或 GitHub 暂时不可用）"
	if ! ver_gt "$v" "$VERSION"; then okay "已是最新版本 ${VERSION}"; return 0; fi
	if [ "${1:-}" = --check ]; then info "有新版本 ${v}（当前 ${VERSION}），运行 cca update 安装"; return 0; fi
	fetch_release "$v" || die "${v}：${FETCH_ERR}"
	install_next || die "安装 ${v} 失败"
	rm -f "$UPD/skip"
	okay "已更新到 ${NEW_VERSION}（原来是 ${VERSION}）。更新说明：${UPDATE_REPO}/releases/tag/v${NEW_VERSION}"
	info "路由器端脚本如果有变化，下次启动时会自动同步"
}

# ---------------------------------------------------------------------------
# 安装 / 还原
# ---------------------------------------------------------------------------
need_deps() {
	local c miss=""
	for c in ssh ssh-keygen nc curl perl; do command -v "$c" >/dev/null 2>&1 || miss="$miss $c"; done
	[ -z "$miss" ] || die "缺少命令:$miss"
	# macOS 的 /usr/bin/python3 只是个占位，没装命令行工具时一运行就弹安装窗口
	if [ -z "$PYTHON" ] || { [ "$PYTHON" = /usr/bin/python3 ] && [ "$(uname)" = Darwin ] && ! xcode-select -p >/dev/null 2>&1; }; then
		die "需要 python3：先运行 xcode-select --install 装上苹果的命令行工具，装好后重新安装"
	fi
	[ -n "$CLAUDE_BIN" ] || die "没找到 Claude Code：先运行 curl -fsSL https://claude.ai/install.sh | bash 安装它，再重新安装 cca"
	[ "$(uname)" = Darwin ] || warn "本脚本按 macOS 编写（钥匙串、open、Chrome 路径），其它系统需自行调整"
}

path_hint() {   # ~/.local/bin 不在 PATH 里：征得同意后写进 shell 的启动文件
	local bin="$1" rc="$HOME/.zshrc"
	case "${SHELL:-}" in */bash) rc="$HOME/.bash_profile" ;; esac
	if grep -qs '\.local/bin' "$rc"; then
		warn "${bin} 已经写在 ${rc} 里，只是当前终端还没生效：打开一个新的终端标签再用 cca"
	elif confirm "把 ${bin} 加进 PATH（写入 ${rc}），以后直接输入 cca 就能用？" y; then
		printf '\n# cca（Claude Code 多账号）\nexport PATH="$HOME/.local/bin:$PATH"\n' >> "$rc" || return 1
		info "已写入 ${rc}"
		CCA_PATH_ADDED=1
	else
		warn "${bin} 不在 PATH 里：可以用 ${bin}/cca 运行，或者自己把它加进 PATH"
	fi
}

cmd_install() {
	need_deps
	need_tty
	mkdir -p "$CCA_HOME/accounts" "$CCA_HOME/bin" "$CCA_HOME/backup" || die "无法创建 $CCA_HOME"
	chmod 700 "$CCA_HOME"
	py init || die "初始化配置失败"
	if [ -f "$HOME/.claude.json" ] && [ -z "$(ls -A "$CCA_HOME/backup" 2>/dev/null)" ]; then
		cp -p "$HOME/.claude.json" "$CCA_HOME/backup/claude.json.$(date +%Y%m%d-%H%M%S)"
	fi
	local target="$SELF" bin="$HOME/.local/bin"
	if ! dev_mode && [ "$SELF" != "$CCA_HOME/bin/cca" ]; then   # 发布版复制到 ~/.cca/bin/cca，自动更新替换的是这一份
		{ cp "$SELF" "$CCA_HOME/bin/cca.new.$$" && chmod 755 "$CCA_HOME/bin/cca.new.$$" &&
			mv -f "$CCA_HOME/bin/cca.new.$$" "$CCA_HOME/bin/cca"; } || die "复制到 $CCA_HOME/bin/cca 失败"
		target="$CCA_HOME/bin/cca"
	fi
	printf '#!/bin/sh\nexec %q _browser "$@"\n' "$target" > "$CCA_HOME/bin/open-url"
	chmod 755 "$CCA_HOME/bin/open-url"
	mkdir -p "$bin"
	if [ "$(readlink "$bin/cca" 2>/dev/null)" != "$target" ]; then
		[ -e "$bin/cca" ] && [ ! -L "$bin/cca" ] && die "$bin/cca 已存在且不是本脚本，请先处理"
		ln -sf "$target" "$bin/cca"
	fi
	case ":$PATH:" in *":$bin:"*) ;; *) path_hint "$bin" ;; esac
	info "已安装：$bin/cca → $target"
	if dev_mode; then info "开发模式：直接用 git 仓库里的这份脚本，不自动更新"
	else info "自动更新已开启：每天检查一次，新版本在下次启动时安装（cca update off 可关闭）"; fi
	info "账号表：${TABLE}；可选节点、纯净度阈值在 ${CFG}（nodes / min_trust）"
	if ! router_ready && confirm "现在配置 OpenClash 路由器（SSH 免密 + 按端口分流）？" y; then
		cmd_router_setup || warn "路由器配置没完成，稍后可运行 cca router setup"
	fi
	if [ -z "$(py keys)" ] && confirm "现在新增第一个账号？" y; then
		cmd_add || true
	fi
	if [ -n "${CCA_PATH_ADDED:-}" ]; then info "完成。打开一个新的终端标签，输入 cca 就能用（cca help 查看全部命令）"
	else info "完成。以后输入 cca 启动 Claude Code（cca help 查看全部命令）"; fi
}

cmd_restore() {
	local key bk out rc running=""
	[ -d "$CCA_HOME" ] || { info "没有 ${CCA_HOME}，无需还原"; return 0; }
	need_tty
	while IFS= read -r key; do   # 账号的 Claude App 开着时删它的资料目录会出问题
		[ -n "$key" ] || continue
		eval "$(py env "$key")"
		[ -n "$(app_pid "$ACC_DESKTOP_DIR")" ] && running="${running:+${running}、}${ACC_NAME}"
	done < <(py keys)
	[ -z "$running" ] || die "这些账号的 Claude App 还开着：${running}。先退出它们再还原"
	say "${C_B}一键还原${C_0}：撤销 cca 做过的全部改动"
	say "  · 每个账号：把会话里新产生的共享内容并回 ~/.claude，然后退出登录、删除它的钥匙串凭证（第三方 API 账号删掉钥匙串里的 key）"
	say "  · 路由器：移除钩子、cron、端口池（要让 OpenClash 重载一次，约 20 秒，期间局域网新连接会失败）、/etc/cca 和 cca 的 SSH 公钥"
	say "  · 本机 Clash Verge（配置过的话）：删掉全局扩展脚本里 cca 的那一段，移除本机端口池"
	say "  · 本机：先打包备份配置（不含浏览器资料和私钥），再删除 ~/.local/bin/cca、${CCA_HOME} 和各账号的 Claude App 启动器"
	say "  · ~/.claude 与 ~/.claude.json 保持现状（共享主目录本来就是你的数据；安装前的备份在打包里）"
	[ "$(ask '确认请输入 restore: ' '')" = restore ] || { say "已取消"; return 0; }
	while IFS= read -r key; do
		[ -n "$key" ] || continue
		eval "$(py env "$key")"
		py link "$key" >/dev/null 2>&1
		py sync "$key" >/dev/null 2>&1
		logout_account
		info "已退出账号 ${ACC_LABEL}"
	done < <(py keys)
	py secrets-forget all   # 账号表里已经没有、钥匙串里还留着的第三方 API key 也删掉
	if router_ready; then
		out=$(rsh "CCA_ALLOW_RELOAD=1 $RDIR/cca-router.sh uninstall" < "$ROUTER_KEY.pub" 2>&1); rc=$?
		[ -n "$out" ] && printf '%s\n' "$out" | sed 's/^/  │ /' >&2
		if [ $rc -eq 0 ]; then
			info "路由器已还原"
		else
			warn "路由器还原失败（SSH 密钥还在，修好网络后可重新运行 cca restore）"
			confirm "仍然继续还原本机？之后需要 ssh 到路由器手动执行 /etc/cca/cca-router.sh uninstall </dev/null" n || return 1
		fi
		rsh_close
	fi
	load_local
	if local_ready; then local_remove; info "本机 ${LOCAL_NAME} 里 cca 的端口池已移除"; fi
	bk="$HOME/cca-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
	# 只给自己读：账号表里可能写着第三方 API 的 key，config.json 里有本机 Clash 的密钥
	( umask 077; tar -czf "$bk" -C "$CCA_HOME" --exclude '*/chrome' --exclude '*/desktop' --exclude 'cm-*' --exclude 'router_ed25519' --exclude '*.lock' . 2>/dev/null ) &&
		info "配置备份：$bk"
	case "$(readlink "$HOME/.local/bin/cca" 2>/dev/null)" in "$SELF"|"$CCA_HOME/bin/cca") rm -f "$HOME/.local/bin/cca" ;; esac
	launchers_sync remove-all
	rm -rf "${CCA_HOME:?}"
	info "已还原。原来的 claude 命令和 ~/.claude 不受影响"
}

usage() {
	cat >&2 <<EOF
cca $VERSION — Claude Code 多账号（账号独立登录，其余共享；每个账号走 OpenClash 的独立端口，在外面走本机 Clash）

启动
  cca [claude 参数]          弹出账号菜单：↑↓ 选择、回车确认、数字键直接选、q 退出；
                             光标默认停在上次用的账号，菜单里也能直接添加新账号
  cca @<账号> [claude 参数]   跳过选择；账号可写别名、邮箱、编号或唯一前缀
                             启动前经该账号端口检测出口（claude.ai 看到的 IP + ip.net.coffee 纯净度）

用量
  cca usage [账号] [--json]   查官方账号的订阅用量：5 小时、本周（含分模型）额度用了多少、什么时候重置；
                             经每个账号自己的出口、让 Claude Code 自己去查（不发消息、不耗额度），
                             查不到时显示上次的缓存。菜单和 cca ls 里也会附上最近一次的用量

账号表  $TABLE    {"别名(邮箱)": "节点"}，别名可省略（只写邮箱）；端口自动分配
  cca add                    新增账号：分两行填登录邮箱和别名（可选），再选出口节点；
                             登录时邮箱会预填在登录页里
  cca add api                新增第三方 API 账号（兼容 Anthropic 接口的地址 + key，模型可选）：
                             直连或走节点；key 存进钥匙串，经 apiKeyHelper 交给 Claude Code
                             表里写法：{"别名": {"base_url": "…", "model": "…", "node": "", "env": {…}}}
  cca key <账号>             重新输入第三方 API 账号的 key
  cca edit                   用编辑器改账号表，保存后校验并同步（只改别名不影响登录和端口）
  cca ls                     列出账号、登录状态和端口
  cca rm <账号>              删除账号（退出登录，删钥匙串凭证和浏览器资料）
  cca web [账号] [网址]      用该账号的浏览器实例打开 claude.ai（或指定网址，如 https://ip.net.coffee/claude/）；
                             只用于官方账号
  cca app [账号]             用该账号专属的资料目录和出口打开 Claude App（桌面版），已经开着就切到它；
                             每个账号在 ~/Applications 里有一个「Claude 别名」启动器（没有别名时用邮箱 @ 前面的
                             部分；cca app --launchers 重新生成）。只用于官方账号
  cca check [账号]           检测各账号出口 IP、地区、纯净度，提示共用出口；第三方 API 账号只检测接口连不连得上

路由器
  cca router setup           SSH 免密（只输一次密码）+ 部署分流
  cca router sync [-y]       同步账号到路由器：换节点、增删账号走 API 即时生效；只有端口池要扩容
                             或可选节点变了才需重载 OpenClash（约 20 秒），会先问你（-y 直接同意）
  cca router status|nodes|log|ssh|uninstall

出门在外（连不上路由器时改走本机的 Clash 客户端，例如 Clash Verge）
  cca local [status]         现在走哪条路；本机端口池各端口的监听状态和选中的节点
  cca local setup            配置本机 Clash：Clash Verge 自动配置（全局扩展脚本里加一段，不用重启它）；
                             其它基于 mihomo 的客户端按提示手动加配置。在外面第一次启动时也会问
  cca local off              删掉 Clash Verge 全局扩展脚本里 cca 的那一段，移除本机端口池
                             平时自动判断：连得上路由器走路由器，连不上走本机 Clash；
                             想固定一种，把 ${CFG} 的 route 改成 router 或 local

其它
  cca install                安装或修复（链接到 ~/.local/bin/cca）
  cca update                 立即更新到最新版本；平时每天自动检查一次，新版本在下次启动时自动安装
  cca update --check | --rollback | auto | notify | off
                             只检查 / 退回上一版 / 自动安装（默认）/ 只提示 / 关闭
  cca restore                一键还原 cca 的全部改动
  配置 ${CFG}：nodes（可选节点）、min_trust（纯净度低于它要确认，默认 50）
EOF
}

main() {
	[ -n "$PYTHON" ] || die "需要 python3"
	case "${1:-}" in
		install) cmd_install ;;
		help|-h|--help) usage ;;
		version|--cca-version) echo "$VERSION" ;;
		_browser) shift; cmd_browser "$@" ;;
		_api-key) shift; py api-key-out "${1:-}" ;;   # Claude Code 的 apiKeyHelper 回调：只打印 key
		_update-fetch) cmd_update_fetch ;;
		update) shift; cmd_update "$@" ;;
		restore) cmd_restore ;;
		*)
			if [ ! -f "$CFG" ]; then
				interactive || die "还没安装：请在终端里运行 $SELF install"
				info "第一次使用，先安装"
				cmd_install
				exit 0
			fi
			update_hook "$@"
			case "${1:-}" in
				add) shift; cmd_add "$@" ;;
				key) shift; cmd_key "$@" ;;
				usage) shift; cmd_usage "$@" ;;
				edit) cmd_edit ;;
				ls|list) cmd_list ;;
				rm|remove) shift; cmd_rm "$@" ;;
				web) shift; cmd_web "$@" ;;
				app) shift; cmd_app "$@" ;;
				check) shift; cmd_check "$@" ;;
				router) shift; cmd_router "$@" ;;
				local) shift; cmd_local "$@" ;;
				@*) OPT_ACCOUNT="${1#@}"; shift; [ "${1:-}" = "--" ] && shift; launch "$@" ;;
				--) shift; launch "$@" ;;
				*) launch "$@" ;;
			esac ;;
	esac
}

main "$@"
