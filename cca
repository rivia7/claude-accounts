def all_errors():
    """各工具账号表的问题（同步路由器、本机 Clash 之前看：端口池里有各工具的账号）。Claude 的照旧，别的注明是哪张表"""
    errs = []
    for tool in TOOLS:
        if tool.name not in TABS:
            errs.append('%s 不是正确的 JSON（用 %s edit 修正）' % (tool.table, tool.cmd))
        errs += [e if tool is CLAUDE else '%s 账号表：%s' % (tool.label, e) for e in ERRS.get(tool.name, [])]
    return errs


# --- 提问会话里的账号表表单（cca [codex] edit，PROTOCOL 4.6）：节点、接口地址、模型、环境变量。App 不碰账号表，也看不到 key ---
def edit_sum(t):
    """账号表的键和先后的摘要：表单按编号对应账号，表在中途变了（映射更新、别处改了别名）就重新出表单"""
    return hashlib.sha1(json.dumps(list(t), ensure_ascii=False).encode('utf-8')).hexdigest()[:12]


def env_text(env):
    """环境变量在表单里的写法：A=1 B=\x27带空格的值\x27"""
    return ' '.join('%s=%s' % (k, shlex.quote(str(v))) for k, v in env.items()) if isinstance(env, dict) else ''


def env_parse(s):
    """表单里的环境变量 → (字典, 问题)"""
    try:
        words = shlex.split(s)
    except ValueError:
        return {}, '引号没有配对'
    out = {}
    for w in words:
        k, sep, v = w.partition('=')
        if not sep:
            return {}, '写成 名字=值，多个用空格隔开（「%s」里没有 =）' % k[:40]
        out[k] = v
    return out, ''


def edit_unfixable(c, t, pm):
    """表单改不了的问题（键写错了、有不认识的字段、key 或 id 不对）：把表单能改的项换成合格的值，再校验一遍"""
    probe = {}
    for k, v in t.items():
        if is_api(v):
            probe[k] = {f: x for f, x in v.items() if f not in ('model', 'node', 'env')}
            probe[k]['base_url'] = 'https://api.example.com'
        else:
            probe[k] = 'x'
    return table_problems(dict(c, nodes=['x']), probe, T, pm)


def cmd_edit_form():
    """表单的一页：打印 edit_sum，后面是这一页的描述（k=v，一行一条，给 prompt-emit）。stdin：上次填的（字段<TAB>值）和问题（!字段<TAB>原因，
    字段空着是整页的）。退出码 3：表单改不了（stdout 是原因，去终端）；4：还没有账号；5：还没有可选节点（stdout 是原因）"""
    if not os.path.exists(T.table) or not isinstance(load_quiet(T.table), dict):
        if os.path.exists(T.table):
            print('%s 不是正确的 JSON' % T.table)
            sys.exit(3)
        print('还没有账号')
        sys.exit(4)
    c, t, _ = ctx()
    prev, ferr = {}, {}
    for line in sys.stdin.read().split('\n'):
        k, sep, v = line.partition('\t')
        if sep:
            (ferr if k.startswith('!') else prev)[k.lstrip('!')] = v
    if not t:
        print('还没有账号')
        sys.exit(4)
    pm = policy_map(T, c)
    bad = edit_unfixable(c, t, pm)
    if bad:
        print('；'.join(bad)[:500])
        sys.exit(3)
    nodes = c['nodes']
    if not nodes and any(not is_api(v) for v in t.values()):
        print('还没有可选节点：先配置路由器')
        sys.exit(5)
    used = {}
    for k, v in t.items():
        if node_of(v):
            used.setdefault(node_of(v), []).append(k)
    apis = any(is_api(v) for v in t.values())
    out = [edit_sum(t), 'q=edit.form', 'submit=保存',
           'message=' + (ferr.get('') or '改完点“保存”，cca 会检查，需要的话同步到路由器。')]

    def put(fid, kind, label, value, section, hint='', optional=False, style='', error=''):
        out.extend('%s=%s' % x for x in [('field', fid), ('kind', kind), ('label', label), ('value', value), ('section', section), ('hint', hint),
                                         ('style', style), ('error', error or ferr.get(fid, ''))] if x[1] or x[0] in ('field', 'value'))
        if optional:
            out.append('optional=1')

    def node_opts(k):
        for n in nodes:
            who = [name_of(x) for x in used.get(n, []) if x != k]
            out.append('opt=%s\t%s\t%s' % (n, n, '已被 %s 使用' % '、'.join(who) if who else ''))

    for i, (k, v) in enumerate(t.items()):
        nid = 'n%d' % i
        if not is_api(v):
            sec = '官方账号' if apis else ''
            want = pm.get(parse_key(k)[1].lower()) if parse_key(k)[1] else None
            if want:
                put(nid, 'choice', label_of(k), want, sec, '维护者固定了这个账号的节点', style='menu',
                    error='' if want in nodes else '维护者的映射要求它走「%s」，这个节点不在可选列表：先在“配置路由器”里选上它' % want)
                out.append('opt=%s\t%s\t' % (want, want))
                continue
            cur = prev.get(nid, v if isinstance(v, str) else '')
            put(nid, 'choice', label_of(k), cur if cur in nodes else '', sec, style='menu',
                error='' if cur in nodes else '节点「%s」不在可选列表，换一个' % cur)
            node_opts(k)
            continue
        sec = '第三方 API：%s' % name_of(k)
        fid = 'u%d' % i
        put(fid, 'text', '接口地址', prev.get(fid, api_url(v)), sec, '换了服务商（域名变了）要重新输入 key')
        fid = 'm%d' % i
        put(fid, 'text', '模型（可选）', prev.get(fid, v.get('model') or ''), sec,
            '填了会同时用作 opus / sonnet / haiku' if 'env' in T.api_fields else '服务商不认 codex 默认的模型名时请填上', optional=True)
        if nodes:
            cur = prev.get(nid, node_of(v))
            put(nid, 'choice', '出口', cur if cur in nodes else '', sec, optional=True, style='menu',
                error='' if not cur or cur in nodes else '节点「%s」不在可选列表，换一个' % cur)
            node_opts(k)
            out.append('skip=直连（不经代理）')
        if 'env' in T.api_fields:
            fid = 'e%d' % i
            put(fid, 'text', '环境变量（可选）', prev.get(fid, env_text(v.get('env'))), sec, '写成 名字=值，多个用空格隔开；密钥不要写在这里', optional=True)
    print('\n'.join(x.replace('\n', ' ') for x in out))


def cmd_edit_apply(digest):
    """表单的答案（stdin：字段<TAB>值）：合格就写进账号表，打印 changed / same；不合格退出 3，stdout 一行一个问题（!字段<TAB>原因）"""
    c, t, _ = ctx()
    if edit_sum(t) != digest:
        print('!\t账号表刚刚变了（维护者的映射更新了，或者在别处改过）：下面是最新的内容，再确认一次')
        sys.exit(3)
    ans = {}
    for line in sys.stdin.read().split('\n'):
        k, sep, v = line.partition('\t')
        if sep:
            ans[k] = v
    pm = policy_map(T, c)
    new, bad = {}, {}
    for i, (k, v) in enumerate(t.items()):
        nid = 'n%d' % i
        n = ans.get(nid)
        if not is_api(v):
            e = parse_key(k)[1]
            if n is None or (e and e.lower() in pm):   # 维护者固定的不看答案
                new[k] = v
            elif n not in c['nodes']:
                bad[nid] = '这个节点不在可选列表'
                new[k] = v
            else:
                new[k] = n
            continue
        w = dict(v)
        url = ans.get('u%d' % i, '').strip().rstrip('/')
        p = url_problem(url, T)
        if p:
            bad['u%d' % i] = p
        else:
            if api_host(dict(w, base_url=url)) != api_host(v):
                w.pop('key', None)   # 换了服务商：账号表里写的是旧服务商的 key，不能发给新的（和钥匙串按域名存一样），保存后问新的
            w['base_url'] = url
        m = ans.get('m%d' % i, '').strip()
        if m and not model_ok(m):
            bad['m%d' % i] = MODEL_MSG
        elif m:
            w['model'] = m
        else:
            w.pop('model', None)
        if n is not None:
            n = n.strip()
            if n and n not in c['nodes']:
                bad[nid] = '这个节点不在可选列表'
            elif n or w.get('node'):
                w['node'] = n
        eid = 'e%d' % i
        if 'env' in T.api_fields and eid in ans:
            env, p = env_parse(ans[eid])
            p = p or '；'.join(api_problems(c, k, {'base_url': 'https://api.example.com', 'env': env}))
            if p:
                bad[eid] = p
            elif env_text(env) != env_text(v.get('env')):
                if env:
                    w['env'] = env
                else:
                    w.pop('env', None)
        new[k] = w
    if bad:
        for f, why in bad.items():
            print('!%s\t%s' % (f, why))
        sys.exit(3)
    if new == t:
        print('same')
        return
    save_json(T.table, new, 0o600)
    ctx()   # 重新对账（直连改走节点时分配端口）
    print('changed')


