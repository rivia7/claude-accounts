			*) if [ "$choice" -ge 1 ] && [ "$choice" -le "$n" ]; then echo "${keys[choice - 1]}"; return 0; fi
			   warn "没有编号 ${choice}" ;;
		esac
	done
}

pick_account() {   # 参数给了就解析参数，否则交互选择
	if [ -n "${1:-}" ]; then py resolve "$1"; return; fi
	[ -n "$(py keys)" ] || die "还没有账号（${CMD} add）"
	menu
}

# 这次走哪条路：在家走路由器的端口池；连不上路由器（出门在外）走本机 Clash 客户端的端口池（见下面"出门在外"一节）
probe() {   # probe 主机 端口…：任一端口 1 秒内连得上就返回 0（并行探测，在外面时最多等 1 秒）。
	          # 设了 PROBE_IF（网卡名，只在 macOS 上）时绑定这块网卡探：照这块网卡自己的路由走，绕开虚拟网卡的路由
	local h="$1" p ok=1
	local -a pids=()
	shift
	for p in "$@"; do
		if [ "$(uname)" = Darwin ]; then nc -z -G 1 ${PROBE_IF:+-b "$PROBE_IF"} "$h" "$p" >/dev/null 2>&1 & else nc -z -w 1 "$h" "$p" >/dev/null 2>&1 & fi
		pids+=($!)
	done
	for p in "${pids[@]}"; do wait "$p" && ok=0; done
	return $ok
}
# 虚拟网卡：VPN、ZeroTier、Tailscale、WireGuard、Clash 客户端的 TUN 这类隧道和虚拟局域网（macOS 的 utun、ipsec、ppp、feth（ZeroTier），
# Linux 的 tun、tap、wg、zt、tailscale、Meta / Mihomo（Clash 的 TUN）……）。辅助程序的 VIRTUAL_IFACE_RE 是同一份名单，要一起改（回归里核对）
VIRTUAL_IFACE_RE='^(utun|ipsec|ppp|tun|tap|gif|stf|feth|zt|wg|tailscale|nebula|vti|gre|ipip|ip6|sit|Meta|Mihomo|singbox)'
virtual_iface() { [[ $1 =~ $VIRTUAL_IFACE_RE ]]; }
route_iface() {   # route_iface IP：连这个 IP 走哪块网卡（只查路由表，不发包）；查不到是空的。主机名不查（是空的）：macOS 的 route get
	                # 会解析它（IPv6 不带 -inet6 时也当主机名），开着 TUN 时解析出来的是它的假 IP
	local fam=""
	case "$1" in
		*:*) fam=-inet6 ;;
		''|*[!0-9.]*) return 0 ;;
	esac
	if on_linux; then ip route get "$1" 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -n 1
	else route -n get $fam "$1" 2>/dev/null | awk '$1 == "interface:" { print $2; exit }'; fi
}
phys_iface() {   # 物理网卡（macOS）：默认路由里第一块不是虚拟网卡的（netstat 也列着各网卡自己的默认路由）；没有是空的
	netstat -rn -f inet 2>/dev/null | awk -v re="$VIRTUAL_IFACE_RE" '$1 == "default" && $4 !~ re { print $4; exit }'
}
default_gateway() {   # 默认网关的 IP（初始化时探局域网里有没有路由器用）。设了 CCA_GATEWAY（含空值）就直接用它、不读路由表（测试、特殊网络）
	if [ -n "${CCA_GATEWAY+x}" ]; then printf '%s' "${CCA_GATEWAY}"; return; fi
	if on_linux; then
		ip route show default 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "via") { print $(i + 1); exit } }'
	else
		route -n get default 2>/dev/null | awk '/gateway:/ { print $2; exit }'
	fi
}
CLASH_PROBE_PORTS="9090 9999"   # OpenClash / ShellCrash 控制接口的常见端口
clash_api_probe() {   # clash_api_probe 地址 端口：这个地址像不像一个 Clash 控制接口（/version 回版本号；设了密钥的回 401/403 也算）。短超时、直连
	local out code
	out=$(curl -q -s --noproxy '*' --connect-timeout 1 -m 2 -w '\n%{http_code}' "http://$1:$2/version" 2>/dev/null) || return 1
	code=${out##*$'\n'}
	case "$out" in *'"version"'*|*'"meta"'*|*'"hello"'*) return 0 ;; esac
	case "$code" in 401|403) return 0 ;; esac
	return 1
}
detect_router() {   # 探一次局域网里有没有装了 Clash 的路由器：默认网关、同网段的 x.1 / x.2，常见控制端口。探到的地址写进 DETECTED_ROUTER（空=没探到）。
	                 # 只是信号：探到就把向导默认选成路由器、地址填好，SSH 配置照常走。并行、短超时，只在初始化时探，不做后台扫描
	if [ -n "${DETECTED_ROUTER+x}" ]; then printf '%s' "${DETECTED_ROUTER}"; return; fi
	DETECTED_ROUTER=""
	local gw pre a p dir i=0
	local -a cands=()
	gw=$(default_gateway)
	case "$gw" in
		[0-9]*.[0-9]*.[0-9]*.[0-9]*)   # 只探 IPv4 的 /24：网关本身（主路由可能就跑着 Clash），再加同网段的 .1 / .2（旁路由常在这）
			cands+=("$gw"); pre=${gw%.*}
			for a in "$pre.1" "$pre.2"; do [ "$a" = "$gw" ] || cands+=("$a"); done ;;
	esac
	[ ${#cands[@]} -gt 0 ] || { printf ''; return; }
	dir=$(mktemp -d "${TMPDIR:-/tmp}/cca-rdet.XXXXXX") || { printf ''; return; }
	local -a pids=()
	for a in "${cands[@]}"; do
		for p in $CLASH_PROBE_PORTS; do
			( clash_api_probe "$a" "$p" && printf 1 > "$dir/$i" ) &
			pids+=($!); i=$((i + 1))
		done
	done
	for p in "${pids[@]}"; do wait "$p"; done
	i=0
	for a in "${cands[@]}"; do   # 按候选顺序取第一个命中（网关优先，再 x.1 / x.2）
		for p in $CLASH_PROBE_PORTS; do
			[ -s "$dir/$i" ] && { DETECTED_ROUTER="$a"; break 2; }
			i=$((i + 1))
		done
	done
	rm -rf "$dir"
	printf '%s' "${DETECTED_ROUTER}"
}
at_home() {   # 连得上路由器（SSH 端口或端口池的第一个端口）就算在家；一次命令只探测一次。
	# 去路由器的路由走虚拟网卡（在外面经 ZeroTier、VPN 也连得到家里的路由器）时不算在家：macOS 上绑定物理网卡再探（在家开着 Clash
	# 客户端的 TUN、路由器不在本网段时照样认得出在家），Linux 上不算在家。ROUTER_VIA 是那块虚拟网卡，ROUTER_REACH 是不管经哪块
	# 网卡连不连得上（两个探测同时做，不多等）：只经虚拟网卡连得到时，提示照实说（away_what），界面 App 的实况照样看得到路由器
	if [ -z "${AT_HOME:-}" ]; then
		load_router
		AT_HOME=no ROUTER_REACH=no ROUTER_VIA=""
		if [ -n "$ROUTER_HOST" ]; then
			local via phys="" rp
			via=$(route_iface "$ROUTER_HOST")
			if virtual_iface "$via"; then
				ROUTER_VIA=$via
				probe "$ROUTER_HOST" "$ROUTER_PORT" "$POOL_FIRST" & rp=$!
				on_linux || phys=$(phys_iface)
				[ -n "$phys" ] && PROBE_IF="$phys" probe "$ROUTER_HOST" "$ROUTER_PORT" "$POOL_FIRST" && AT_HOME=yes
				wait "$rp" && ROUTER_REACH=yes
			elif probe "$ROUTER_HOST" "$ROUTER_PORT" "$POOL_FIRST"; then AT_HOME=yes; fi
			[ "$AT_HOME" = no ] || ROUTER_REACH=yes
		fi
	fi
	[ "$AT_HOME" = yes ]
}
away_what() {   # away_what [连不上时的补充]：不在家的说法（at_home 之后用）。只经虚拟网卡连得到路由器时照实说（免得以为路由器坏了）
	if [ "${ROUTER_REACH:-}" = yes ] && [ -n "${ROUTER_VIA:-}" ]; then
		printf '路由器 %s 只经虚拟网卡 %s（VPN、ZeroTier 这类）连得到，不算在家' "$ROUTER_HOST" "$ROUTER_VIA"
	else printf '连不上路由器%s%s' "${ROUTER_HOST:+ ${ROUTER_HOST}}" "${1:-}"; fi
}
want_local() {   # 这次走本机 Clash 吗：按 config.json 的 route（CCA_ROUTE 可临时指定）；auto 时看连不连得上路由器
	load_router
	case "${CCA_ROUTE:-$ROUTE_PREF}" in router) return 1 ;; local) return 0 ;; esac
	! at_home
}
pick_route() {   # 需要先 eval "$(py env 名称)"；结果在 ROUTE（router|local）和 ACC_PROXY 里
	if want_local; then route_local; else route_router; fi
}
router_ensure() {   # 让路由器确认端口池在，并把各槽位切到账号的节点（API，无需重载；要重载时先问）
	local out rc attempt
	router_ready || { fail_warn no_router "无法核实路由器账号节点：还没配置路由器（cca router setup）"; return 1; }
	for attempt in 1 2; do
		out=$(rsh "$RDIR/cca-router.sh ensure-now" </dev/null 2>&1); rc=$?   # </dev/null：不让 ssh 读走调用方的 stdin
		[ -n "$out" ] && printf '%s\n' "$out" | LC_ALL=C sed 's/^/  │ /' >&2
		[ $rc -eq 0 ] && return 0
		[ $attempt -eq 1 ] || break
		# 节点改名后重新部署，或获准重载后，再核实一次实际选中节点。端口开放不能替代这一步。
		if [ $rc -ne 255 ] && nodes_follow; then
			router_push || break
			if [ -n "${ACC_KEY:-}" ]; then
				out=$(py env "$ACC_KEY") || break
				eval "$out"
			fi
		elif [ $rc -eq 3 ] && allow_reload "$out"; then
			router_reload || break
		else
			break
		fi
	done
	fail_warn sync_failed "路由器账号节点未能核实，已停止使用端口池（避免走错出口）。排查：cca router status / cca router sync"
	return 1
}
router_slot_check() {   # 路由器上 ACC_SLOT 的账号就是我这个账号吗（按账号名认，和出口节点、改名无关）：多设备共用时，
	                      # 别的设备或旧版 cca 可能把这个槽位改走。对不上就重新同步一次，还对不上就停——宁可断开也不走错出口
	local got
	got=$(rsh "cat $RDIR/accounts.yaml 2>/dev/null" </dev/null 2>/dev/null | py slot-name "$ACC_SLOT")
	[ "$got" = "$ACC_POOLNAME" ] && return 0
	warn "路由器上端口 ${ACC_PORT} 现在的账号和这台 Mac 对不上（可能别的设备或旧版 cca 改过）：重新同步一次"
	router_sync || { fail_warn sync_failed "重新同步没成功，为避免走错出口已停止。排查：cca router status / cca router sync"; return 1; }
	eval "$(py env "$ACC_KEY")" || return 1   # 并集可能把我的账号排到别的槽位：重取 ACC_SLOT/ACC_PORT/ACC_POOLNAME/ACC_PROXY
	router_ensure || return 1
	port_open "$PROXY_HOST" "$ACC_PORT" || { fail_warn port_closed "端口 ${PROXY_HOST}:${ACC_PORT} 不通。为避免走错出口，已停止。排查：cca router status / cca router sync"; return 1; }
	got=$(rsh "cat $RDIR/accounts.yaml 2>/dev/null" </dev/null 2>/dev/null | py slot-name "$ACC_SLOT")
	[ "$got" = "$ACC_POOLNAME" ] && return 0
	fail_warn sync_failed "路由器上端口 ${ACC_PORT} 的账号仍和这台 Mac 对不上（可能别的设备在反复覆盖端口池），为避免走错出口已停止。排查：cca router status / cca router sync"
	return 1
}
route_router() {   # 在家：经路由器的端口池
	[ -n "$ACC_PROXY" ] || { fail_warn no_router "还没配置路由器（cca router setup）"; TOOL=claude gui_terminal router_setup "还没配置路由器：在终端里配置一次" router setup; return 1; }
	load_router
	router_ensure || return 1
	port_open "$PROXY_HOST" "$ACC_PORT" || {
		fail_warn port_closed "端口 ${PROXY_HOST}:${ACC_PORT} 不通。为避免走错出口，已停止。排查：cca router status / cca router sync"
		return 1
	}
	router_slot_check || return 1   # 多设备共用一个路由器：回读确认这个端口现在确实是我这个账号，不是才继续（杜绝悄悄走错出口）
	core_nodes_hook   # 在外面会走内置代理的机器：节点定义旧了就在后台从路由器拷一份新的
	ROUTE=router
}
route_note() {   # 给提示用：走的是哪个端口
	case "${ROUTE:-}" in
		local) printf '本机 %s 端口 %s' "$LOCAL_NAME" "$ACC_PORT" ;;
		direct) printf '直连' ;;
		*) printf '端口 %s' "$ACC_PORT" ;;
	esac
}

# 第三方 API 账号：接口地址经账号的出口连得上（不带 key；收到任何 HTTP 响应都算连得上）。结果在 COFFEE_LINE
api_check() {
	local code i
	local -a via=(--noproxy '*')
	[ -n "$ACC_PROXY" ] && via=(--noproxy '' -x "$ACC_PROXY")
	for i in 1 2; do
		code=$(curl -q -s -o /dev/null -m 8 -w '%{http_code}' "${via[@]}" "$ACC_BASE_URL" 2>/dev/null)
		case "$code" in ''|000) ;; *) COFFEE_LINE="接口连得上"; health_note api_ok; return 0 ;; esac
	done
	COFFEE_LINE="连不上 ${ACC_BASE_URL}（$(route_note)）"
	health_note api_unreachable
	return 1
}
health_note() {   # health_note 结果：没有出口检测数据的结果（第三方 API 账号、端口不通）也记进 health.json，见 cmd_health_note
	local kind=exit
	[ "$ACC_KIND" = api ] && kind=api
	HEALTH_JSON=$(py health-note "$ACC_KEY" "${HEALTH_SOURCE:-launch}" "$kind" "$1" "${ROUTE:-}" "${ACC_PORT:+$ACC_NODE}" "$ACC_PORT" \
		"${COFFEE_LINE:-}" 2>/dev/null)
}
settings_warn() {   # settings_warn 问题 [-- 启动参数…]：py settings-check（带 -- 时是 launch-check，同样的启动参数）查出的问题。
	                 # 由 py settings-explain 说清楚是哪份文件、哪几项、带着它启动会怎样、怎么办（只说路径和名字，不说值；三种工具都有，
	                 # Claude 的共享设置还能 cca settings fix）；说不出来时照下面的一句说
	local bad="$1" msg=""
	shift
	if [ "${1:-}" = -- ]; then shift; msg=$(py settings-explain launch "$@"); else msg=$(py settings-explain shared); fi
	if [ -n "$msg" ]; then
		gui_fail settings_conflict "$(printf '%s' "$msg" | tr -d '\n')"
		printf '%s\n' "$msg" | { IFS= read -r line; warn "$line"; while IFS= read -r line; do printf '%s\n' "  ${line}" >&2; done; }
		return 0
	fi
	gui_fail settings_conflict "共享的设置里有会盖掉账号自己的代理、接口地址或凭证的配置（${bad}）"
	case "$TOOL" in
		codex) warn "共享的 ~/.codex 里有会把账号的登录发到别处、换掉账号或出口的配置（${bad}）。删掉或改掉后再用 cca codex 启动（第三方 API 用 cca codex add api 加成账号）" ;;
		agy) warn "共享的 ~/.gemini 里有会让各账号用同一个 Google Cloud 项目、换掉账号或凭证的配置（${bad}）。删掉后再用 cca agy 启动" ;;
		*) warn "共享的设置里有会盖掉每个账号自己的代理、接口地址或凭证的配置（${bad}）。删掉后再用 cca 启动（第三方 API 用 cca add api 加成账号）" ;;
	esac
}

# ---- 共享设置（cca settings）----
cmd_settings() {   # cca [codex|agy] settings [check | fix]：查共享设置和这个目录的项目设置里会盖掉账号自己设置的配置（launch-check
	               # 那一套，说明见 settings_warn）。fix 只给 Claude：问过（consent settings_fix，范围是这次要改的摘要）后先把
	               # ~/.claude/settings.json（settings.local.json）整份备份在旁边，再只去掉这几项（py settings-fix）；项目设置、启动参数不改
	local bad out rc scope plan line
	case "${1:-check}" in
		check)
			if bad=$(py launch-check); then okay "没有发现会盖掉账号自己设置的配置"; return 0; fi
			settings_warn "$bad" --
			exit 1 ;;
		fix) ;;
		*) die "用法：${CMD} settings [check | fix]" ;;
	esac
	[ "$TOOL" = claude ] || FAIL_CODE=unsupported die "${CMD} settings fix 只修 Claude Code 的共享设置；${TOOL_LABEL} 的请照 ${CMD} settings 说的手动改"
	out=$(py settings-fix plan); rc=$?
	case $rc in
		0) ;;
		3)
			if bad=$(py launch-check); then okay "~/.claude 里的共享设置没有要修的"; return 0; fi
			settings_warn "$bad" --   # 剩下的是项目设置、启动参数这类：cca 不改，照实说
			exit 1 ;;
		4) die "$out" ;;
		*) die "没能读取 Claude Code 的共享设置" ;;
	esac
	scope=$(printf '%s\n' "$out" | head -n 1)
	plan=$(printf '%s\n' "$out" | tail -n +2)
	printf '%s\n' "$plan" | { IFS= read -r line; info "$line"; while IFS= read -r line; do printf '%s\n' "  ${line}" >&2; done; }
	consent settings_fix "$scope" "修复 Claude Code 的共享设置" "现在备份并去掉这几项吗？" "$(printf '%s' "$plan" | tr -d '\n')" y
	case $? in
		0) ;;
		1) info "没有改动"; return 0 ;;
		*) die "要先同意：在终端里运行 ${CMD} settings fix（会先问你）" ;;
	esac
	out=$(py settings-fix apply "$scope"); rc=$?
	case $rc in
		0) ;;
		2) die "这几份设置刚被改过，没有动它们：再运行一次 ${CMD} settings fix" ;;
		4) die "$out" ;;
		*) die "没能修复 Claude Code 的共享设置" ;;
	esac
	printf '%s\n' "$out" | { IFS= read -r line; okay "$line"; while IFS= read -r line; do printf '%s\n' "  ${line}" >&2; done; }
	bad=$(py launch-check) && return 0
	settings_warn "$bad" --   # 还剩项目设置这类 cca 不改的
	exit 1
}

# 经账号端口检测出口：claude.ai（Codex 账号是 chatgpt.com）看到的 IP + ip.net.coffee 的风险数据（不上报会话）
coffee_check() {   # coffee_check [region | 开始时间]：region 时只看出口地区（不查 ip.net.coffee 的纯净度、不测泄露，查用量前用）；
	               # 别的时候同时在后台测 DNS / WebRTC 泄露（给了开始时间时 DNS 不用那之前的缓存：cca check），结果在 LEAK_*
	local trace ip loc risk="" out rc min="$CCA_MIN_TRUST"
	LEAK_LINE="" LEAK_DNS="" LEAK_WEBRTC="" LEAK_WEBRTC_NOTE="" LEAK_DNS_STATE="" LEAK_WEBRTC_STATE="" HEALTH_JSON=""
	[ "${1:-}" = region ] || { leak_start "${1:-}"; udp_home_start; }
	trace=$(curl -q --noproxy '' -s -m 8 -x "$ACC_PROXY" "https://${TRACE_HOST}/cdn-cgi/trace" 2>/dev/null)
	ip=$(printf '%s\n' "$trace" | sed -n 's/^ip=//p')
	loc=$(printf '%s\n' "$trace" | sed -n 's/^loc=//p')
	if [ "${1:-}" = region ]; then min=0
	elif [ -n "$ip" ]; then risk=$(curl -q --noproxy '' -s -m 12 -x "$ACC_PROXY" "https://ip.net.coffee/api/iprisk/$ip" 2>/dev/null); fi
	out=$(py coffee "$min" "$trace" "$risk")
	rc=$?
	COFFEE_IP="$ip"
	COFFEE_LINE=$(printf '%s\n' "$out" | head -n 1)
	COFFEE_NOTE=$(printf '%s\n' "$out" | sed -n '2,$p')
	case $rc in 0|1|4) leak_finish "$ip" "$loc" "${1:-}" ;; *) leak_finish ;; esac   # 出口本身就不对（受限地区、拿不到 IP）时不用等它
	[ "${1:-}" = region ] || udp_home_finish
	# 记进账号目录的 health.json（图形界面不联网也能显示上次的出口）；cca check --json 用 HEALTH_JSON
	[ "${1:-}" = region ] || HEALTH_JSON=$(py health-save "$ACC_KEY" "${HEALTH_SOURCE:-launch}" "${ROUTE:-}" "$ACC_NODE" "$ACC_PORT" "$min" \
		"$trace" "$risk" "$LEAK_LINE" "$LEAK_DNS" "${LEAK_WEBRTC:-$LEAK_WEBRTC_NOTE}" "$LEAK_DNS_STATE" "$LEAK_WEBRTC_STATE" 2>/dev/null)
	return $rc
}
leak_start() {   # leak_start [cca check 开始的时间]：后台开始 DNS / WebRTC 泄露检测（py leak-probe，最多 5 秒左右）。服务器上（login_remote）
	              # 没有账号专属的浏览器和桌面 App，WebRTC 只在它们里面：不测、不说
	local rtc=1
	LEAK_PID="" LEAK_OUT=""
	login_remote && rtc=0
	# 模板写全：GNU、busybox 的 mktemp -t 要模板里有 X，没有就失败（Linux 上以前一直没测成）
	LEAK_OUT=$(mktemp "${TMPDIR:-/tmp}/cca-leak.XXXXXX" 2>/dev/null) || return 0
	py leak-probe "$ACC_PROXY" "${ROUTE}|${ACC_NODE}" "${1:-}" "$rtc" > "$LEAK_OUT" 2>/dev/null &
	LEAK_PID=$!
}
leak_finish() {   # leak_finish [出口IP 出口地区 [cca check 开始的时间]]：等后台的检测，汇总成 LEAK_LINE（横幅里的一句）、
	                # LEAK_DNS / LEAK_WEBRTC（泄露时的说明，要警告的）、LEAK_WEBRTC_NOTE（只作提醒的说明）。不给出口 IP 时不等它、不汇总（它自己几秒内就结束）
	local out kind tag msg
	[ -n "${LEAK_PID:-}" ] || return 0
	if [ -n "${1:-}" ]; then
		wait "$LEAK_PID" 2>/dev/null
		out=$(py leak-verdict "$LEAK_OUT" "${ROUTE}|${ACC_NODE}" "$1" "${2:-}" "${3:-}")
		LEAK_LINE=$(printf '%s\n' "$out" | head -n 1)
		while IFS=$'\t' read -r kind tag msg; do
			case "$kind" in
				W) case "$tag" in dns) LEAK_DNS="$msg" ;; webrtc) LEAK_WEBRTC="$msg" ;; esac ;;
				N) case "$tag" in webrtc) LEAK_WEBRTC_NOTE="$msg" ;; esac ;;
				S) case "$tag" in dns) LEAK_DNS_STATE="$msg" ;; webrtc) LEAK_WEBRTC_STATE="$msg" ;; esac ;;
			esac
		done <<< "$out"
	fi
	rm -f "$LEAK_OUT"
	LEAK_PID="" LEAK_OUT=""
}
leak_show() {   # leak_show 缩进：横幅（cca check 的每一行）下面那一句；有泄露时用黄色
	[ -n "$LEAK_LINE" ] || return 0
	if [ -n "$LEAK_DNS$LEAK_WEBRTC" ]; then say "${1}${C_Y}${LEAK_LINE}${C_0}"; else say "${1}${LEAK_LINE}"; fi
}

prepare_account() {   # 合并账号内原子保存的共享配置后，再校验实际将使用的配置。
	local bad
	py link "$1" && py sync "$1" || return 1
	if ! bad=$(py settings-check); then settings_warn "$bad"; return 1; fi
}

preflight() {   # preflight [app]：账号的出口必须可用且干净，否则不启动（避免走错出口）。顺带测 DNS / WebRTC 泄露（只提示，不拦）：
	             # DNS 泄露影响这个账号的一切；WebRTC 泄露在网页和 App 里，打开 App 时（app）、要在浏览器里登录时才另外说明
	local bad rc
	COFFEE_LINE=""
	if [ -n "$ACC_PORT" ]; then pick_route || return 1; else ROUTE=direct; fi   # 直连的第三方 API 账号不经端口
	if ! bad=$(py settings-check); then settings_warn "$bad"; return 1; fi
	[ -n "${CCA_SKIP_CHECK:-}" ] && return 0
	if [ "$ACC_KIND" = api ]; then   # claude.ai / chatgpt.com 的出口检测和第三方服务无关：只看接口连不连得上
		api_check && return 0
		fail_warn api_unreachable "${COFFEE_LINE}"
		warn "已停止启动：确认地址没写错、服务商没出问题（确定没问题可以加 CCA_SKIP_CHECK=1 跳过检测）"
		return 1
	fi
	coffee_check
	rc=$?
	[ -z "$LEAK_DNS" ] || warn "$LEAK_DNS"
	[ -z "$LEAK_WEBRTC" ] || [ "${1:-}" != app ] || warn "$LEAK_WEBRTC"
	case $rc in
		0) ;;
		4) warn "出口检测没拿到评分（${COFFEE_LINE}），先继续" ;;
		1)
			warn "出口纯净度偏低：${COFFEE_LINE}"
			consent low_purity "$COFFEE_IP" "出口纯净度偏低" "仍然用这个出口启动吗？" "${COFFEE_LINE}${COFFEE_NOTE:+（${COFFEE_NOTE}）}" n ||
				{ gui_fail low_purity "出口纯净度偏低：${COFFEE_LINE}"; return 1; } ;;
		*)
			if [ $rc -eq 2 ]; then gui_fail region_restricted "${COFFEE_LINE}${COFFEE_NOTE:+：${COFFEE_NOTE}}"; else gui_fail no_exit_ip "${COFFEE_LINE}"; fi
			warn "${COFFEE_LINE}"
			[ -n "$COFFEE_NOTE" ] && warn "$COFFEE_NOTE"
			warn "已停止启动。可以用 ${CMD} edit 给这个账号换个节点"
			return 1 ;;
	esac
	return 0
}

# 程序坞：cca 打开的 App 实例（账号的 Chrome、桌面 App）、终端交接用完退出的系统终端，退出以后去掉程序坞「最近使用的 App」里留下的图标
# （见 py 的程序坞一节）。等它退出、整理的进程经 open 当作一个后台小 App（DOCK_APP，LSBackgroundOnly：不在程序坞里出现）来跑：
# 直接从 cca 起的话，它算调用 cca 的那个 App（终端交接时是系统终端）的下属（setsid、disclaim、launchctl submit 都一样，实测），
# 那个 App 退出以后 LaunchServices 还留着它的记录，整理时重启的程序坞照着记录又把它加回去。
# 小 App 里是辅助程序等那个实例退出（kqueue，不轮询，1 MB 左右），退出了再换成 cca _dock-tidy App 去整理。
# 同一个实例只留一个在等（锁文件：账号的 Chrome 每次被 cca 用到都会来一次）
DOCK_DIR="${CACHE_DIR:+$CACHE_DIR/cca-dock}"
[ -z "${CCA_DOCK_PREFS:-}" ] || DOCK_DIR="${CCA_DOCK_PREFS%/*}/cca-dock"   # 测试：程序坞的设置是沙箱里的文件，排队、等待的记录也放在它旁边
DOCK_APP="$CCA_HOME/dock/cca-dock.app"
DOCK_APP_SH='#!/bin/bash
# cca 生成的后台小 App：等 cca 打开的 App 实例退出，整理程序坞（cca _dock-wait）。经 open 启动，不算调用 cca 的那个 App 的下属
export PATH="${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin"
while [ "$#" -gt 0 ]; do case "$1" in -psn_*) shift ;; *) break ;; esac; done
[ "$#" -eq 3 ] || exit 0
exec "$1" _dock-wait "$2" "$3" </dev/null >/dev/null 2>&1'
DOCK_APP_PLIST='<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key><string>cca-dock</string>
	<key>CFBundleIdentifier</key><string>local.cca.dock</string>
	<key>CFBundleName</key><string>cca-dock</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>1.0</string>
	<key>CFBundleVersion</key><string>1</string>
	<key>LSBackgroundOnly</key><true/>
</dict>
</plist>'
dock_app() {   # 后台小 App 的路径（没有、内容不对就重写）
	local c="$DOCK_APP/Contents"
	if [ "$(cat "$c/MacOS/cca-dock" 2>/dev/null)" != "$DOCK_APP_SH" ] || [ "$(cat "$c/Info.plist" 2>/dev/null)" != "$DOCK_APP_PLIST" ]; then
		mkdir -p "$c/MacOS" || return 1
		printf '%s\n' "$DOCK_APP_PLIST" > "$c/Info.plist.tmp" && mv -f "$c/Info.plist.tmp" "$c/Info.plist" || return 1
		printf '%s\n' "$DOCK_APP_SH" > "$c/MacOS/cca-dock.tmp" && chmod 755 "$c/MacOS/cca-dock.tmp" && mv -f "$c/MacOS/cca-dock.tmp" "$c/MacOS/cca-dock" || return 1
	fi
	printf '%s\n' "$DOCK_APP"
}
dock_hand() {   # dock_hand 进程号 App：交给后台小 App 等这个实例退出、整理程序坞（已经退出了也交：小 App 马上整理）；不占这条命令的时间。
	# 锁（fd 9）、答案管道（fd 3）不带过去；config.json 里关掉了就不起（py 那边整理前还会再看）
	local a
	grep -Eq '"dock_tidy"[[:space:]]*:[[:space:]]*false' "$CFG" 2>/dev/null && return 0
	a=$(dock_app) || return 0
	( open -g -j -n -a "$a" --args "$SELF" "$1" "$2" </dev/null >/dev/null 2>&1 3<&- 4<&- 9>&- & )
	return 0
}
dock_watch() {   # dock_watch 进程号 App：cca 打开、用到的实例（还开着的）退出以后整理程序坞
	[ -n "${1:-}" ] && [ -n "${2:-}" ] || return 0
	kill -0 "$1" 2>/dev/null || return 0
	dock_hand "$1" "$2"
}
cmd_dock_tidy() {   # cca _dock-tidy App [进程号]：带进程号时交给后台小 App 等它退出（终端交接的脚本退出系统终端以后也这样调，PROTOCOL 6）
	case "${2:-}" in
		'') CCA_SELF="$SELF" exec "$HELPER" dock-tidy "${1:-}" "$DOCK_DIR" ;;
		*[!0-9]*) die "用法: cca _dock-tidy App [进程号]" ;;
		*) [ -z "${1:-}" ] || dock_hand "$2" "$1" ;;
	esac
}
cmd_dock_wait() {   # cca _dock-wait 进程号 App：后台小 App 里跑的，等那个实例退出（已经没了就不等），再换成 cca _dock-tidy App
	case "${1:-}" in ''|*[!0-9]*) return 0 ;; esac
	exec "$HELPER" sh-dock-wait "$1" "$DOCK_DIR" "$SELF" _dock-tidy "${2:-}"
}

chrome_app_path() {
	local app
	for app in /Applications/Google\ Chrome.app "$HOME/Applications/Google Chrome.app"; do
		[ -d "$app" ] && { printf '%s' "$app"; return 0; }
	done
	return 1
}
has_chrome() { chrome_app_path >/dev/null; }
mac_only() {   # mac_only 说明：要账号专属的 Chrome、桌面 App 或界面 App 的功能，Linux（服务器）上没有：说清楚、退出（不说"没装 Chrome"）
	on_linux || return 0
	die "${1}只在 macOS 上；这台 Linux 上用命令行：${CMD} @账号 启动，${CMD} help 看能用的命令"
}

chrome_pid() { app_pid 'Google Chrome' "$ACC_CHROME_DIR"; }

chrome_launch_lock() {
	exec 9>"$ACC_DIR/browser-launch.lock" || return 1
	"$HELPER" sh-flock 9
}

chrome_open_url() {
	open -n -a "$1" --args --user-data-dir="$ACC_CHROME_DIR" --no-first-run --no-default-browser-check \
		--proxy-server="$ACC_PROXY" --webrtc-ip-handling-policy=disable_non_proxied_udp "$2" 9>&-
}

open_chrome() {   # 子 shell 持有启动锁，所有返回路径自动释放；不终止已有浏览器窗口。
(
	local url="$1" app pid i rc ready=""
	case "$url" in
		http://*|https://*) ;;
		*) fail_warn invalid_url "浏览器地址必须以 http:// 或 https:// 开头"; return 1 ;;
	esac
	if ! has_chrome; then
		fail_warn no_chrome "没装 Google Chrome，已停止打开：系统默认浏览器不能保证使用这个账号的资料目录和出口"
		return 1
	fi
	app=$(chrome_app_path) || return 1
	ACC_CHROME_DIR=$(py private-profile "$ACC_KEY" browser) || return 1
	command -v lsof >/dev/null 2>&1 || { fail_warn open_failed "找不到 lsof，无法核验账号浏览器的资料目录"; return 1; }
	chrome_launch_lock || { fail_warn open_failed "账号浏览器正在启动，请稍后再试"; return 1; }
	pid=$(chrome_pid); rc=$?
	[ "$rc" -le 1 ] || { fail_warn open_failed "无法查询 Chrome 进程，已停止打开，未修改浏览器偏好"; return 1; }
	if [ -n "$pid" ]; then
		py runtime-record check "$ACC_KEY" browser "$pid" "$ACC_CHROME_DIR" "$app" "$ACC_PROXY" || {
			fail_warn open_failed "浏览器的启动条件无法核验或出口已变化：请退出这个账号的 Chrome，再用 cca 打开"
			return 1
		}
		app_profile_in_use "$pid" "$ACC_CHROME_DIR" || { fail_warn open_failed "无法核验已有 Chrome 的账号资料目录，请退出后重开"; return 1; }
		dock_watch "$pid" "$app"   # 以前的版本打开的也等（已经有一个在等就不再起）
	else
		py browser-profile prepare "$ACC_KEY" || return 1
		# 先启动空白页，核验后才主动交付目标网址；Chrome 自身仍可能恢复旧标签或发起后台请求。
		chrome_open_url "$app" about:blank || return $?
		for i in $(seq 1 40); do
			pid=$(chrome_pid); rc=$?
			[ "$rc" -le 1 ] || { fail_warn open_failed "无法查询本次 Chrome 进程，未打开目标网址；请退出空白窗口后重试"; return 1; }
			if [ -n "$pid" ] && app_profile_in_use "$pid" "$ACC_CHROME_DIR"; then ready=1; break; fi
			sleep 0.25
		done
		[ -n "$ready" ] || { fail_warn open_failed "无法核验 Chrome 使用账号自己的资料目录，未打开目标网址；请退出空白窗口后重试"; return 1; }
		py runtime-record write "$ACC_KEY" browser "$pid" "$ACC_CHROME_DIR" "$app" "$ACC_PROXY" || return 1
		dock_watch "$pid" "$app"   # 退出以后程序坞不留它的图标
	fi
	chrome_open_url "$app" "$url"
)
}

cmd_web() {   # cmd_web [账号] [网址] [给人看的叫法] [mail]：网页版：claude.ai，Codex 账号是 chatgpt.com（和出口检测是同一个网站），
	# Antigravity 账号是 gemini.google.com（WEB_URL）。
	# mail 时打开后把账号的邮箱放进剪贴板：控制台这些登录页不认网址里的邮箱参数（实测），要登录时粘贴，免得在这个账号的浏览器里登错号
	local key site="${WEB_URL#https://}" what="${3:-}" note=""
	site="${site%%/*}"
	mac_only "${what:-网页版}要在账号专属的 Chrome 里打开，"
	key=$(pick_account "${1:-}") || return 0
	eval "$(py env "$key")"
	[ "$ACC_KIND" = api ] && FAIL_CODE=api_account die "${ACC_NAME} 是第三方 API 账号：${what:-网页版}只能用官方账号"
	has_chrome || { fail_warn no_chrome "没装 Google Chrome，已停止打开：请先安装 Chrome，再使用账号的独立浏览器"; return 1; }
	gui_step sync
	sync_if_changed   # 账号表可能刚按 Team 的配置改过：先让路由器跟上，免得经旧的节点出去
	gui_step preflight
	preflight app || exit 1
	prepare_account "$ACC_KEY" || die "初始化账号目录失败"
	# 还没登录就先登录（同一个浏览器实例，登录一次两边都能用；Claude 的登录页预填邮箱）
	if [ -n "$ACC_EMAIL" ] && [ -n "$TOOL_BIN" ] && interactive; then
		ensure_login || exit 1
	fi
	gui_step open
	open_chrome "${2:-https://${site}/}" || { fail_warn open_failed "打开账号的独立浏览器失败"; return 1; }
	if [ "${4:-}" = mail ] && [ -n "$ACC_EMAIL" ] && printf '%s' "$ACC_EMAIL" | pbcopy 2>/dev/null; then
		note="；要登录的话，邮箱 ${ACC_EMAIL} 已经复制好，粘贴即可"
	fi
	what="${what:-${2:-$site}}"
	info "已用 ${ACC_NAME} 的浏览器实例打开 ${what}（经 ${ACC_PROXY} → ${ACC_NODE}）${note}"
	gui_result opened "已用 ${ACC_NAME} 的浏览器实例打开 ${what}（经 ${ACC_PROXY} → ${ACC_NODE}）${note}"
}

cmd_billing() {   # cca [codex] billing [账号]：控制台的账单页。订阅附带的每月 API 额度和余额只在这里显示（两家都没有用 API Key 查余额的接口），
	# 走网页版的全部检查，用账号自己的浏览器实例和出口打开
	[ -n "$BILLING_URL" ] || FAIL_CODE=unsupported die "${TOOL_LABEL} 账号没有控制台的账单页"
	cmd_web "${1:-}" "$BILLING_URL" 控制台的账单页 mail
}

cmd_limit_resets() {   # cca limit-resets [账号]：claude.ai 的用量页。Claude 账号的重置次数和到期日只在这里显示（get_usage 不给，也不能拿登录凭证自己查）
	case "$TOOL" in
		codex) die "ChatGPT 账号的重置次数和到期日在 ${CMD} usage 里" ;;
		agy) FAIL_CODE=unsupported die "${TOOL_LABEL} 账号没有重置次数" ;;
	esac
	cmd_web "${1:-}" https://claude.ai/settings/usage 用量页 mail
}

cmd_browser() {   # Claude Code 登录时经 BROWSER 调用：在当前账号的浏览器实例里打开，登录地址没带邮箱时补上
	local key="${CCA_ACCOUNT:-$(py get last)}" url
	eval "$(py env "$key")" || exit 1
	[ -n "${CCA_PROXY:-}" ] && ACC_PROXY="$CCA_PROXY"   # 启动它的 cca 选好的出口（在外面时是本机 Clash 的端口）
	url=$(py login-url "$ACC_KEY" "$1") || url="$1"
	if [ -n "${CCA_LOGIN_URL_FILE:-}" ]; then   # 服务器上登录（remote_login）：只记下网址，交给 Mac 打开
		printf '%s\n' "$url" > "$CCA_LOGIN_URL_FILE.tmp" && mv -f "$CCA_LOGIN_URL_FILE.tmp" "$CCA_LOGIN_URL_FILE"
		return
	fi
	if login_remote; then
		warn "这台机器上没有 ${ACC_NAME} 专属的浏览器，没有打开：要登录的话退出后运行 ${CMD} login ${ACC_NAME}（登录页在 Mac 上打开）"
		exit 1
	fi
	open_chrome "$url"
}

# ---------------------------------------------------------------------------
# 桌面 App 多开：每个账号一份独立的资料目录（--user-data-dir），整个实例走账号的端口。Claude 账号开 Claude App；
# Codex 账号开 ChatGPT App（就是 Codex 的桌面版，bundle id com.openai.codex），它另外认 CODEX_HOME 和
# CODEX_ELECTRON_USER_DATA_PATH（它自己"再开一个实例"也是这么做的），和 cca codex @账号 用同一份登录。
# 两个 App 都按资料目录区分实例，同一个资料目录开两份会抢同一份数据库，所以先按进程查。
# ---------------------------------------------------------------------------
LAUNCHER_DIR="$HOME/Applications"
claude_app_path() {   # Claude App 装在哪（CCA_CLAUDE_APP 可指定）
	local d
	if [ -n "${CCA_CLAUDE_APP:-}" ]; then [ -d "$CCA_CLAUDE_APP" ] && printf '%s' "$CCA_CLAUDE_APP"; return; fi
	for d in /Applications/Claude.app "$HOME/Applications/Claude.app"; do
		[ -d "$d" ] && { printf '%s' "$d"; return 0; }
	done
	return 1
}
codex_app_path() {   # ChatGPT App 装在哪（CCA_CODEX_APP 可指定）：认 bundle id，同名的别的 App 不算
	local d
	if [ -n "${CCA_CODEX_APP:-}" ]; then [ -d "$CCA_CODEX_APP" ] && printf '%s' "$CCA_CODEX_APP"; return; fi
	for d in /Applications/ChatGPT.app "$HOME/Applications/ChatGPT.app" /Applications/Codex.app "$HOME/Applications/Codex.app"; do
		[ "$(plutil -extract CFBundleIdentifier raw "$d/Contents/Info.plist" 2>/dev/null)" = com.openai.codex ] && { printf '%s' "$d"; return 0; }
	done
	return 1
}
claude_app_missing() { printf '%s' "没找到 Claude App：先从 https://claude.ai/download 下载安装"; }
codex_app_missing() { printf '%s' "没找到 ChatGPT App（Codex 的桌面版）：先从 https://persistent.oaistatic.com/codex-app-prod/Codex.dmg 下载安装（codex app 没装 App 时下载的也是它）"; }
# agy 没有能按账号多开的桌面 App（Antigravity 编辑器不认资料目录参数）：cca agy app 说清楚，删账号、还原时当作没开着
agy_app_path() { return 1; }
agy_app_missing() { printf '%s' "Antigravity 账号没有桌面 App 可开：用 cca agy @账号 在终端里用"; }
agy_app_pid() { return 0; }
agy_app_prepare() { return 0; }
agy_app_open() { return 1; }
agy_app_first() { return 0; }
app_pid() {   # 资料目录按字面量匹配，路径里的点号等不能变成正则通配符
	local pattern matches rc
	# Linux 上没有桌面 App、账号专属的 Chrome：总是没开着。不跑 pgrep：没装 procps 的机器上没有它，127 会挡住 cca rm、restore
	on_linux && return 1
	pattern=$("$HELPER" sh-re-escape "$2") || return 2
	matches=$(pgrep -f "Contents/MacOS/$1 .*--user-data-dir(=| +)${pattern}/*( |\$)"); rc=$?
	[ "$rc" -le 1 ] || return "$rc"
	[ "$rc" -eq 0 ] || return 1
	[ -n "$matches" ] || return 2
	printf '%s\n' "$matches" | head -n 1
}
claude_app_pid() { app_pid Claude "$1"; }
codex_app_pid() { app_pid '(ChatGPT|Codex)' "$1"; }
activate_pid() {   # 多开时 open -a 分不清是哪一个，按进程号切到前面
	osascript -l JavaScript -e "ObjC.import('AppKit'); var a = \$.NSRunningApplication.runningApplicationWithProcessIdentifier($1); a.unhide; a.activateWithOptions(\$.NSApplicationActivateAllWindows)" </dev/null >/dev/null 2>&1
}

launchers_all() {   # Claude、Codex 的启动器都按各自的账号表改一遍（agy 没有）：打开、关掉共享时一下子加回来、收起好几个账号
	local t0="$TOOL" t
	for t in claude codex; do use_tool "$t"; launchers_sync; done
	use_tool "$t0"
}
launchers_sync() {   # 按账号表新建、改名、删除 ~/Applications 里当前工具的启动器；参数 remove-all 时全部删掉
	local app out op n
	[ "$TOOL" != agy ] || return 0   # agy 没有桌面 App，也就没有启动器
	app=$(tool app_path) || app=""
	out=$(py launchers "$LAUNCHER_DIR" "$SELF" "$app" "${1:-}") || return 1
	while IFS=$'\t' read -r op n; do
		case "$op" in
			+) info "已生成启动器「${n}」：在聚焦搜索、启动台或 ${LAUNCHER_DIR} 里找" ;;
			-) info "已删除启动器「${n}」" ;;
			!) warn "${LAUNCHER_DIR}/${n}.app 已存在且不是 cca 生成的，没有覆盖" ;;
		esac
	done <<< "$out"
	return 0
}

claude_app_prepare() { return 0; }
# ChatGPT App 自己启动 codex（cca 加不了参数）：共享的 config.toml 里要关掉 system_proxy_fallback（征得同意后用 codex 自己的
# 命令改）；还没登录就先在账号专属的 Chrome 里登录（App 用同一份登录，打开时就是登录状态）
codex_app_prepare() {
	need_bin
	if ! py codex-fallback-off; then
		if [[ " ${ACC_FLAGS[*]} " != *" system_proxy_fallback "* ]]; then   # 这个版本的 codex 不认识这个开关，没法替你关
			FAIL_CODE=settings_conflict die "这个版本的 codex 不认识 system_proxy_fallback，无法确认 ChatGPT App 的出口隔离；请升级 codex 后再打开 App"
		else
			local why="ChatGPT App 自己启动 codex，cca 加不了参数。Codex 的 system_proxy_fallback 开着时，账号的出口一断，部分请求会带着这个账号的登录改走 macOS 的系统代理，出口就换了"
			interactive && warn "$why"
			consent codex_fallback_off "" "关掉 Codex 的系统代理回退" "用 codex features disable system_proxy_fallback 在共享的 ~/.codex/config.toml 里关掉它吗？（直接用 codex 时也不再回退到系统代理）" "$why" y
			case $? in
				0)
					child_env
					env "${UNSETS[@]}" CODEX_HOME="$ACC_MASTER" "$CODEX_BIN" features disable system_proxy_fallback </dev/null >/dev/null 2>&1 3<&-
					py codex-fallback-off || die "没能关掉 system_proxy_fallback：手动在 ~/.codex/config.toml 的 [features] 里写上 system_proxy_fallback = false"
					okay "已在 ~/.codex/config.toml 里关掉 system_proxy_fallback"
					py link "$ACC_KEY" || die "链接共享目录失败" ;;   # config.toml 可能是刚建的：账号目录里还没有指向它的链接
				2) die "先在终端里运行一次 cca codex app ${ACC_NAME}：要先关掉 Codex 的 system_proxy_fallback（会说明原因）" ;;
				*) FAIL_CODE=settings_conflict die "没有关掉 system_proxy_fallback，已停止打开 ChatGPT App，避免账号的出口断开时改走系统代理" ;;
			esac
		fi
	fi
	ensure_login || exit 1
}

app_open() {   # app_open App 资料目录 [--env 工具自己的变量…]：整个实例走账号的端口（Chromium 的 --proxy-server，子进程的 *_PROXY）
	local app="$1" dir="$2"
	shift 2
	child_env
	env "${UNSETS[@]}" "${SETS[@]}" open -n -a "$app" "$@" \
		--env HTTPS_PROXY="$ACC_PROXY" --env https_proxy="$ACC_PROXY" --env HTTP_PROXY="$ACC_PROXY" --env http_proxy="$ACC_PROXY" \
		--env NO_PROXY="$CCA_NO_PROXY" --env no_proxy="$CCA_NO_PROXY" \
		--args --user-data-dir="$dir" --proxy-server="$ACC_PROXY" --proxy-bypass-list="$CCA_PROXY_BYPASS"
}
claude_app_open() { app_open "$1" "$2" --env CLAUDE_CONFIG_DIR="$ACC_HOME" --env CLAUDE_SECURESTORAGE_CONFIG_DIR="$ACC_HOME"; }
# 资料目录同时用 CODEX_ELECTRON_USER_DATA_PATH 和 --user-data-dir 指定（它自己再开一个实例时也这样）
codex_app_open() {   # Sparkle 的更新 installationId 存在共享 appData；该实例关闭更新，避免发送共享标识。
	app_open "$1" "$2" --env CODEX_HOME="$ACC_HOME" --env CODEX_SQLITE_HOME="$ACC_MASTER" --env CODEX_ELECTRON_USER_DATA_PATH="$2" --env CODEX_SPARKLE_ENABLED=false
}
claude_app_first() { info "第一次打开要登录 ${ACC_EMAIL:-这个账号}：用邮箱登录全程走这个账号的出口；用 Google 登录时，那一次会走系统网络"; }
codex_app_first() {
	info "它和 cca codex @${ACC_NAME} 用同一份登录。如果 App 里还要你登录，别在 App 里登（它的登录页会在系统默认浏览器里打开，不经账号的出口）："
	info "关掉 App，运行 cca codex login ${ACC_NAME}，再打开 App"
	info "这个账号实例已关闭 App 自动更新；请定期退出账号实例后手动更新 App"
}

# flock 锁留在当前 shell 的 fd 9；辅助程序退出后仍持有，进程退出自动释放，不留过期目录锁。
# 只在预检完成后持锁，打开 App 时关闭 fd 9，避免常驻 App 继承后一直占锁。
app_launch_lock() {
	exec 9>"$ACC_DIR/app-launch.lock" || return 1
	"$HELPER" sh-flock 9 && return 0
	exec 9>&-
	return 1
}
app_launch_unlock() { exec 9>&-; }

app_process_tree() {   # 输出主进程及其当前子孙的 PID；不读取进程环境或登录资料
	ps -axo pid=,ppid= | "$HELPER" sh-ps-tree "$1"
}

app_profile_in_use() {   # 本次活进程必须实际打开资料目录内的文件；旧 Local State 不能充当证据
	local pid="$1" dir pids
	[ -n "$pid" ] || return 1
	dir=$(cd "$2" && pwd -P) || return 1
	pids=$(app_process_tree "$pid") || return 1
	[ -n "$pids" ] || return 1
	lsof -n -P -a -p "$pids" -Fn 2>/dev/null | "$HELPER" sh-lsof-under "$dir"
}

app_runtime_record() {
	py runtime-record "$1" "$ACC_KEY" app "$2" "$3" "$4" "$ACC_PROXY" "${ROUTE:-}" "$CCA_PROXY_BYPASS" "$CCA_NO_PROXY"
}

app_activate_existing() {   # 不接管或终止已有实例；不能验证时要求用户自行退出再打开
	app_profile_in_use "$1" "$2" || FAIL_CODE=app_profile_unsupported die "无法确认已有的 ${APP_LABEL} 使用 ${ACC_NAME} 自己的资料目录；请先自行退出这个实例，再用 cca 打开"
	app_runtime_record check "$1" "$2" "$3" || FAIL_CODE=app_profile_unsupported die "已有的 ${APP_LABEL} 没有匹配的启动记录，或账号的出口、资料目录、启动配置已变化；请保存工作并自行退出这个实例，再用 cca 打开"
	if [ "$TOOL" = codex ]; then
		py codex-fallback-off || FAIL_CODE=settings_conflict die "已有的 ChatGPT App 无法确认已关闭系统代理回退；请保存工作并退出 App，再用 cca 打开"
	fi
	activate_pid "$1"
	dock_watch "$1" "$3"   # 以前的版本打开的也等（已经有一个在等就不再起）
	py presence-wake "$ACC_KEY" >/dev/null 2>&1   # Team 给的账号：确保在报告给 Team 的服务器（设备统计）
	info "${ACC_NAME} 的 ${APP_LABEL} 已经开着，已切到前面"
	gui_result activated "${ACC_NAME} 的 ${APP_LABEL} 已经开着，已切到前面"
}

app_launch_cleanup() {   # 只清理本次启动后出现、且仍匹配该资料目录的进程；从不终止启动前已有进程
	local pid p current
	[ "${APP_LAUNCH_ACTIVE:-}" = 1 ] || return 0
	APP_LAUNCH_ACTIVE=""
	pid="${APP_LAUNCH_NEW_PID:-}"
	current=$(tool app_pid "$APP_LAUNCH_DIR")
	[ -n "$pid" ] || pid="$current"   # 信号可能在 open 返回、记录 PID 之前到达
	if [ -n "$pid" ] && [ "$pid" = "$current" ]; then
		case " $APP_LAUNCH_BEFORE " in
			*" $pid "*) ;;   # PID 在启动前已经存在，无法认定是本次创建
			*) for p in $(app_process_tree "$pid" | tr ',' ' '); do
				case " $APP_LAUNCH_BEFORE " in *" $p "*) ;; *) kill "$p" 2>/dev/null ;; esac
			done ;;
		esac
	fi
	app_launch_unlock
	return 0
}

app_launch_restore_traps() {
	trap - EXIT INT TERM HUP
	[ -z "${APP_LAUNCH_TRAPS:-}" ] || eval "$APP_LAUNCH_TRAPS"
}
app_launch_abort() {
	app_launch_cleanup
	app_launch_restore_traps
	exit "$1"
}

cmd_app() {   # 用账号专属的资料目录和出口打开桌面 App（Claude 账号是 Claude App，Codex 账号是 ChatGPT App）；已经开着就切到它
	local key app dir pid first="" i p rc ready="" app_wait
	[ "$TOOL" != agy ] || FAIL_CODE=unsupported die "$(agy_app_missing)"
	mac_only "${APP_LABEL}（桌面版）"
	[ "${1:-}" = --launchers ] && { launchers_sync; return; }
	app=$(tool app_path) || FAIL_CODE=app_missing die "$(tool app_missing)"
	key=$(pick_account "${1:-}") || return 0
	eval "$(py env "$key")"
	[ "$ACC_KIND" = api ] && FAIL_CODE=api_account die "${ACC_NAME} 是第三方 API 账号：${APP_LABEL} 只能用官方账号"
	key="$ACC_KEY" dir="$ACC_DESKTOP_DIR"
	dir=$(py private-profile "$key" app) || FAIL_CODE=app_profile_unsupported die "${APP_LABEL} 的资料目录不是账号独立目录，已停止打开"
	gui_step sync
	sync_if_changed
	launchers_sync
	gui_step preflight
	preflight app || exit 1   # App 里的网页也会用 WebRTC：泄露时另外说明
	gui_step prepare
	prepare_account "$key" || die "初始化账号目录失败"
	pid=$(tool app_pid "$dir"); rc=$?
	[ "$rc" -le 1 ] || FAIL_CODE=open_failed die "无法查询 ${APP_LABEL} 进程，已停止打开；请稍后重试"
	if [ -n "$pid" ]; then
		app_activate_existing "$pid" "$dir" "$app"
		return 0
	fi
	tool app_prepare
	[ -e "$dir/Local State" ] || first=1
	mkdir -p "$dir" && chmod 700 "$dir"
	command -v lsof >/dev/null 2>&1 || FAIL_CODE=app_profile_unsupported die "找不到 lsof，无法核验 App 是否使用账号自己的资料目录，已停止打开"
	app_launch_lock || FAIL_CODE=open_failed die "${ACC_NAME} 的 ${APP_LABEL} 正在启动，请稍后再试"
	# 预检时另一条启动命令可能先开好了；拿到锁后再检查，防止同一资料目录开两份。
	pid=$(tool app_pid "$dir"); rc=$?
	[ "$rc" -le 1 ] || { app_launch_unlock; FAIL_CODE=open_failed die "无法查询 ${APP_LABEL} 进程，已停止打开；请稍后重试"; }
	if [ -n "$pid" ]; then
		app_launch_unlock
		app_activate_existing "$pid" "$dir" "$app"
		return 0
	fi
	APP_LAUNCH_DIR="$dir" APP_LAUNCH_NEW_PID=""
	APP_LAUNCH_BEFORE=$(ps -axo pid= | awk '{print $1}' | tr '\n' ' ')
	[ -n "${APP_LAUNCH_BEFORE// /}" ] || FAIL_CODE=open_failed die "无法记录启动前的进程，已停止打开 App"
	APP_LAUNCH_TRAPS=$(trap -p EXIT INT TERM HUP)
	APP_LAUNCH_ACTIVE=1
	trap app_launch_cleanup EXIT
	trap 'app_launch_abort 130' INT
	trap 'app_launch_abort 143' TERM
	trap 'app_launch_abort 129' HUP
	gui_step open
	tool app_open "$app" "$dir" 9>&- || FAIL_CODE=open_failed die "打开 ${APP_LABEL} 失败"
	app_wait=${CCA_APP_WAIT:-10}; case "$app_wait" in ''|*[!0-9]*) app_wait=10 ;; esac   # 最多等几秒（默认 10；测试里等不到的用例设成 1）
	for i in $(seq 1 $((app_wait * 4))); do
		pid=$(tool app_pid "$dir"); rc=$?
		[ "$rc" -le 1 ] || FAIL_CODE=open_failed die "无法查询本次 ${APP_LABEL} 进程，已停止启动；请确认已退出本次实例后再试"
		[ -z "$pid" ] || APP_LAUNCH_NEW_PID="$pid"
		if app_profile_in_use "$pid" "$dir"; then ready=1; break; fi
		sleep 0.25
	done
	if [ -z "$ready" ]; then
		FAIL_CODE=app_profile_unsupported die "无法确认 ${APP_LABEL} 本次正在使用 ${ACC_NAME} 自己的资料目录（可能是新版本不再支持多开）；已停止启动并关闭能识别的本次实例，免得用错账号或出口"
	fi
	case " $APP_LAUNCH_BEFORE " in
		*" $pid "*) FAIL_CODE=app_profile_unsupported die "无法确认 ${APP_LABEL} 是本次启动的新实例；请保存工作并自行退出已有实例，再用 cca 打开" ;;
	esac
	app_runtime_record write "$pid" "$dir" "$app" || FAIL_CODE=app_profile_unsupported die "无法保存 ${APP_LABEL} 的启动记录，已关闭能识别的本次实例；请检查账号目录后再试"
	APP_LAUNCH_ACTIVE=""
	app_launch_restore_traps
	app_launch_unlock
	dock_watch "$pid" "$app"   # 退出以后程序坞不留它的图标
	py presence-wake "$key" >/dev/null 2>&1   # Team 给的账号：报告给 Team 的服务器（设备统计）
	okay "已打开 ${ACC_LABEL} 的 ${APP_LABEL}，出口 ${ACC_NODE}（$(route_note)）"
	gui_result opened "已打开 ${ACC_LABEL} 的 ${APP_LABEL}，出口 ${ACC_NODE}（$(route_note)）"
	[ -n "$first" ] && tool app_first
	return 0
}

# ---------------------------------------------------------------------------
# 出门在外：连不上路由器时改走本机的 Clash，也就是 cca 内置代理的 mihomo 内核（3.3.0-beta.8 起只有它）。端口池和路由器上的
# 一样：127.0.0.1 上的 mixed 入站 cca-n（端口 7900+n）→ select 策略组 CCA-n，启动账号前经内核的控制接口把组切到账号的节点
# （不用重载）。端口池写进内核的配置，经控制接口热加载正在运行的内核（PUT /configs，和它自己改完配置后的做法一样，不用重启）。
# ---------------------------------------------------------------------------
load_local() {
	eval "$(py local-env)"
	[ "$LOCAL_CTL" = unix:@core ] && LOCAL_CTL="unix:$(core_sock)"   # 内置代理（见下面"内置代理"一节）
	return 0
}

local_ready() { [ -n "$LOCAL_CLIENT" ]; }
json_get() { printf '%s' "$LBODY" | sed -n 's/.*"'"$1"'":"\([^"]*\)".*/\1/p'; }   # 响应里的字符串字段
lctl() {   # lctl 方法 路径 [JSON 或 @文件]：本机 Clash 内核的控制接口；响应体在 ${LBODY}，HTTP 状态码在 ${LCODE}
	local out url nl=$'\n'
	local -a a=(-q --noproxy '*' -s -m "${LCTL_TIMEOUT:-8}" -X "$1" -w '\n%{http_code}')
	case "$LOCAL_CTL" in
		unix:*) a+=(--unix-socket "${LOCAL_CTL#unix:}"); url="http://localhost$2" ;;
		*) url="${LOCAL_CTL%/}$2"; [ -n "$LOCAL_SECRET" ] && a+=(-H "Authorization: Bearer $LOCAL_SECRET") ;;
	esac
	[ -n "${3:-}" ] && a+=(-H 'Content-Type: application/json' --data-binary "$3")
	out=$(curl "${a[@]}" "$url" 2>/dev/null)
	LCODE=${out##*$nl}
	LBODY=${out%$nl*}
	case "$LCODE" in [1-5][0-9][0-9]) ;; *) LCODE=000; LBODY="" ;; esac
}
local_ports_ok() {   # 端口池的每个端口都在本机监听（端口池是空的时候算是：还没有走节点的账号，BSD 的 seq 7901 7900 还会倒着数）
	local p
	[ "${LOCAL_SLOTS:-0}" != 0 ] || return 0
	for p in $(seq "$LOCAL_FIRST" "$LOCAL_LAST"); do port_open 127.0.0.1 "$p" || return 1; done
}
local_select_all() {   # 每个槽位切到分给它的账号的节点，空槽位切到 REJECT。返回 2：有策略组不在运行中的内核里
	local g node lines
	lines=$(py select-lines local) || return 1
	while IFS=$'\t' read -r g node; do
		[ -n "$g" ] || continue
		lctl GET "/proxies/$g"
		if [ "$LCODE" != 200 ]; then
			[ "$LCODE" = 404 ] && return 2
			warn "无法核实本机 ${g} 当前节点（HTTP ${LCODE}）"
			return 1
		fi
		[ "$(json_get now)" = "$node" ] && continue
		lctl PUT "/proxies/$g" "{\"name\":$(jstr "$node")}"
		case "$LCODE" in 2??) lctl GET "/proxies/$g" ;; esac
		if [ "$LCODE" != 200 ] || [ "$(json_get now)" != "$node" ]; then
			warn "本机 ${g} 切换到 ${node} 后未能核实（HTTP ${LCODE}），停止使用端口池"
			lctl PUT "/proxies/$g" '{"name":"REJECT"}'   # 宁可断开，也不能把切换失败当成就绪
			return 1
		fi
	done <<< "$lines"   # 节点名用内置代理里的叫法（同一个节点名字不同时按服务器地址换算）
	return 0
}
local_ensure() {   # 本机端口池可用：内置代理的内核在跑、配置最新、端口池在内核里、每个槽位切到账号的节点
	load_local
	core_ensure
}

local_offer() {   # 在外面、还没配置内置代理：交互时接着配置（core_setup）；界面 App 里问一句改用内置代理（同意后带授权重跑）；
	               # 其它非交互的（启动器、脚本）说清楚，交给终端
	warn "$(away_what '（可能不在家里的网络）')"
	if ! core_possible; then
		fail_warn local_unavailable "这台机器（$(uname -m)）没有内置代理的内核版本：在外面用不了内置代理，只能走路由器"
		return 1
	fi
	if ! interactive; then
		if [ -n "${CCA_EVENTS:-}" ] || consent_granted builtin_core; then core_offer; return; fi
		fail_warn local_unavailable "在外面要用 cca 内置的代理（$(core_runs_where)）：在终端里运行 cca local setup 配置一次"
		TOOL=claude gui_terminal local_setup "在外面要用 cca 内置的代理：在终端里配置一次" local setup
		return 1
	fi
	say "  在外面可以用 cca 内置的代理：cca 跑一个 mihomo 内核，每个账号在本机开一个端口走它自己的节点。"
	cmd_local_setup
}

route_local() {   # 出门在外：经本机 Clash 的端口池（需要先 eval "$(py env 名称)"）
	local ready=0
	load_local
	local_ready || local_offer || return 1
	local_ensure && ready=1
	lctl GET "/proxies/CCA-${ACC_SLOT}"
	[ "$LCODE" = 200 ] || { fail_warn local_unavailable "本机 ${LOCAL_NAME:-Clash} 的账号节点未能核实，已停止"; return 1; }
	if [ "$(json_get now)" != "$(py local-node "$ACC_NODE")" ]; then
		fail_warn node_missing "内置代理里没有节点「${ACC_NODE}」的定义：${ACC_NAME} 在外面用不了，为避免走错出口已停止（在家连上路由器时 cca 会拷一份节点定义；也可以用 ${CMD} node add 填一个，或 ${CMD} edit 换一个节点）"
		return 1
	fi
	[ $ready -eq 1 ] || { gui_fail local_unavailable "本机 ${LOCAL_NAME:-Clash} 的端口池没有就绪"; return 1; }
	port_open 127.0.0.1 "$ACC_PORT" || { fail_warn port_closed "本机端口 127.0.0.1:${ACC_PORT} 不通。排查：cca local status"; return 1; }
	ACC_PROXY="http://127.0.0.1:${ACC_PORT}"
	ROUTE=local
	[ -z "${LOCAL_UDP:-}" ] || udp_launch_check   # 设了本机 UDP 走节点：开关文件在不在、装着的旧没旧
}
cmd_local_setup() {   # 配置内置代理（cca 自带的 mihomo 内核）当本机出口：没有路由器、或在外面连不上路由器时，账号经它走各自的节点
	need_tty
	py validate all || FAIL_CODE=table_invalid die "账号表有错误：先修正（$(edit_hint)）"
	load_local
	core_possible || { FAIL_CODE=local_unavailable die "内置代理的内核没有这台机器（$(uname -m)）的版本"; }
	if [ "$LOCAL_CLIENT" != builtin ]; then
		confirm "用内置代理吗？（cca 跑一个 mihomo 内核，每个账号在本机开一个端口走它自己的节点）" y \
			q=local.builtin "title=配置本机出口" "detail=没有路由器、或在外面连不上路由器时，账号经 cca 内置的 mihomo 内核走各自的节点（$(core_runs_where)）。原来的配置不受影响；不想用了运行 cca local off。" || { gui_cancelled; return 1; }
	fi
	core_setup
}

local_remove() {   # cca local off：不再用内置代理，记下关掉过（在家不再拷节点定义），停掉内核、删掉配置和拷来的节点
	load_local
	py local-set client '' core_off 1
	core_retire
}

cmd_local_status() {
	local g p node name st now
	load_local
	if at_home; then info "现在连得上路由器 ${ROUTER_HOST}：账号走路由器的端口"
	else info "现在$(away_what)：账号走内置代理的端口"; fi
	if ! local_ready; then
		info "还没配置内置代理（cca local setup）"
		return 0
	fi
	lctl GET /version
	if [ "$LCODE" != 200 ]; then
		if core_headless; then info "内置代理的内核没在运行：在外面启动账号时 cca 会在后台起它"
		else info "内置代理的内核没在运行：它在界面 App 里运行，在外面启动账号时会自动在后台打开 App"; fi
		say "  $(py core-summary)"
		return 0
	fi
	say ""
	say "  内置代理（控制接口 ${LOCAL_CTL}）"
	[ -z "${LOCAL_BIND:-}" ] || say "  $(bind_note)"
	while IFS=$'\t' read -r g p node name; do
		if port_open 127.0.0.1 "$p"; then st="监听中"; else st="${C_R}不通${C_0}"; fi
		lctl GET "/proxies/$g"
		if [ "$LCODE" = 200 ]; then now=$(json_get now); else now="（不在内核里）"; fi
		say "  ${g}  127.0.0.1:${p}  ${st}  → ${now}${name:+   ${C_D}${name}${C_0}}"
	done < <(py slot-rows)
	say "  $(py core-summary)"
	say ""
}

# ===== cca Phase B bash: custom nodes for the builtin proxy =====
# 自定义节点：粘贴代理链接（分享链接、socks5://、http(s)://）或 Clash 节点块 → 内核 -t 校验 → 存进 core/custom-nodes.json，
# 名字加进可选节点（py node-save）。内置代理直接用；配置了路由器的，同步时照 Team 的节点那一套写进路由器的配置文件（fill_source）。
node_custom_ok() {   # 这台机器能加自定义节点吗：能用内置代理（拿它的内核先校验）。配置了路由器的，同步时也写进路由器的配置文件
	core_possible
}
node_taken() {   # 在家时路由器上全部节点和策略组的名字（一行一个）：自定义节点起名时避开（同名的写不进路由器的配置）
	router_ready && at_home || return 0
	router_sh | rsh 'sh -s nodes' 2>/dev/null | awk -F '\t' 'NF > 1 && ($1 == "P" || $1 == "G" || $1 == "C") { print $2 }'
}
CUSTOM_FORMATS="vmess:// vless:// ss:// trojan:// hysteria2:// tuic://、socks5://用户:密码@主机:端口、http(s)://用户:密码@主机:端口"

node_validate() {   # node_validate <节点 JSON>：拿一份只含它的最小配置让内核 -t 校验（不起内核、不联网）。认不出返回 1
	core_fetch || { warn "下载内置代理的内核失败，没法校验这个节点：${FETCH_ERR}"; return 1; }
	local dir cfg out
	dir=$(mktemp -d "${TMPDIR:-/tmp}/cca-nodet.XXXXXX") || { warn "建临时目录失败"; return 1; }
	cfg="$dir/config.yaml"
	if ! printf '%s' "$1" | py node-testconfig > "$cfg" 2>/dev/null; then rm -rf "$dir"; warn "生成校验配置失败"; return 1; fi
	chmod 600 "$cfg" 2>/dev/null
	if out=$("$(core_bin)" -t -d "$dir" -f "$cfg" 2>&1); then rm -rf "$dir"; return 0; fi
	rm -rf "$dir"
	warn "这个节点内核认不出、校验没通过：$(printf '%s' "$out" | tail -n 1)"
	return 1
}

node_read_block() {   # 终端：读一段多行粘贴（分享链接或 Clash 节点块），单独一行写 . 结束；读到头也结束。空的返回 1
	local line out="" got=""
	while IFS= read -r line <&3 2>/dev/null; do
		[ "$line" = "." ] && { got=1; break; }
		out="${out}${line}"$'\n'
	done
	[ -n "$got$out" ] || return 1
	printf '%s' "$out"
}

node_add() {   # node_add [分享链接]：解析 → 校验 → 存。成功后 ADDED_NODE 是节点名
	ADDED_NODE=""
	if ! node_custom_ok; then
		warn "自定义节点要用内置代理的内核校验，这台机器用不了（内置代理的内核没有 $(uname -m) 这个架构）"
		return 1
	fi
	local text proxy name n
	local -a taken=()
	if [ -n "${1:-}" ]; then
		text="$1"
	else
		say "  粘贴一条代理链接（${CUSTOM_FORMATS}），或一段 Clash 节点配置。"
		say "  贴完单独一行写一个点（.）回车结束："
		text=$(node_read_block) || { warn "没有输入"; return 1; }
	fi
	while IFS= read -r n; do [ -n "$n" ] && taken[${#taken[@]}]="$n"; done < <(node_taken)
	proxy=$(printf '%s' "$text" | py node-check "${taken[@]}") || return 1
	info "正在用内核校验这个节点…"
	node_validate "$proxy" || return 1
	name=$(printf '%s' "$proxy" | py node-save) || return 1
	ADDED_NODE="$name"
}

node_custom_form() {   # GUI：粘贴代理链接的表单（多行 Clash 配置请用终端 cca node add）。校验没过带着原因重问。成功后 ADDED_NODE 是节点名
	ADDED_NODE=""
	local link="" proxy err="" n msg
	local -a taken=()
	msg="粘贴一条代理链接（${CUSTOM_FORMATS}）；多行的 Clash 节点配置请在终端运行 ${CMD} node add。"
	router_ready && msg="${msg}配置了路由器：同步时写进路由器的配置文件（要重启一次 OpenClash / ShellCrash，先问你）。"
	while IFS= read -r n; do [ -n "$n" ] && taken[${#taken[@]}]="$n"; done < <(node_taken)
	while :; do
		ask_fields node.custom "自定义代理" "$msg" \
			"link|text|||代理链接|socks5://用户:密码@主机:端口 …|${link}|${err}" || return 1
		link="$F_link"
		[ -n "$link" ] || { err="粘贴一条代理链接"; continue; }
		if ! proxy=$(printf '%s' "$link" | py node-check "${taken[@]}" 2>&1); then err="$proxy"; continue; fi
		info "正在用内核校验这个节点…"
		if ! node_validate "$proxy"; then err="这个节点内核校验没通过，检查一下链接对不对"; continue; fi
		ADDED_NODE=$(printf '%s' "$proxy" | py node-save) || return 1
		return 0
	done
}

node_ls() {
	local name type addr users any=""
	while IFS=$'\t' read -r name type addr users; do
		any=1; say "    ${name}（${type} ${addr}）${users:+  ——  ${users} 在用}"
	done < <(py node-ls)
	if [ -n "$any" ]; then say ""; info "加账号时在选节点那步选它们（${CMD} add），已有的账号用 ${CMD} node use 账号 换过去；删一个用 ${CMD} node rm 节点名"
	else info "还没有自定义节点。${CMD} node add 粘贴一条代理链接（分享链接、socks5://、http://）或一段 Clash 节点配置就能加"; fi
}

node_rm() {
	local name="${1:-}" out rc
	[ -n "$name" ] || die "用法: ${CMD} node rm 节点"
	out=$(py node-rm "$name"); rc=$?
	case $rc in
		0) okay "删掉了自定义节点「${name}」" ;;
		2) die "还有账号在用「${name}」（${out}）：先给它们换别的节点、或删掉这些账号" ;;
		*) return 1 ;;
	esac
}

node_use() {   # node_use 账号 [链接]：给这个账号配自定义代理：粘贴（图形界面里是 node.custom 表单）→ 校验 → 存成自定义节点 →
	            # 账号改走它 → 同步路由器（配置文件里写进节点，要重启一次 OpenClash / ShellCrash，先问）。Team 固定了节点的账号不能换
	local key out rc name
	[ -n "${1:-}" ] || die "用法: ${CMD} node use <账号> [代理链接]"
	need_tty
	key=$(py resolve "$1") || FAIL_CODE=account_missing die "没找到账号：$1"
	out=$(py node-assign "$key") && rc=0 || rc=$?
	case $rc in
		0) ;;
		3) FAIL_CODE=node_pinned die "$out" ;;
		*) return 1 ;;
	esac
	if [ -n "$PROMPT_GUI" ] && [ -z "${2:-}" ]; then node_custom_form || return 1
	else node_add "${2:-}" || return 1; fi
	out=$(py node-assign "$key" "$ADDED_NODE") || return 1
	name=$(py name "$key")
	okay "${name} 改走自定义代理「${ADDED_NODE}」"
	if router_needed; then router_sync_soon || fail_warn sync_failed "路由器同步没完成：修好后运行 cca router sync"; fi
	gui_done saved "${name} 改走自定义代理「${ADDED_NODE}」" "$key"
}

cmd_node() {   # cca [codex|agy] node [ls | add [链接] | use 账号 [链接] | rm 节点]：管理自定义节点（内置代理用；配置了路由器的同步时也写进路由器）
	case "${1:-ls}" in
		ls|list) node_ls ;;
		add) shift
			node_add "$@" || return 1
			okay "加好了自定义节点「${ADDED_NODE}」：加账号时在选节点那步选它（${CMD} add），已有的账号用 ${CMD} node use 账号 换过去，或 ${CMD} node ls 查看"
			if router_needed; then router_sync_soon || fail_warn sync_failed "路由器同步没完成：修好后运行 cca router sync"; fi ;;
		use) shift; node_use "$@" ;;
		rm|remove|del) shift; node_rm "$@" ;;
		*) die "用法: ${CMD} node [ls | add [代理链接] | use 账号 [代理链接] | rm 节点]" ;;
	esac
}

cmd_local() {
	case "${1:-status}" in
		status) cmd_local_status ;;
		setup) cmd_local_setup ;;
		off)
			load_local
			if ! local_ready; then   # 没配置本机客户端：记下不用内置代理（在家不再拷节点定义），拷过的删掉
				py local-set client '' core_off 1
				rm -f "$CORE_DIR/config.yaml" "$CORE_DIR/nodes.json"
				info "还没配置本机 Clash；已关掉内置代理的准备（在家不再从路由器拷节点定义）"
				return 0
			fi
			local_remove
			if [ "$LOCAL_CLIENT" = builtin ]; then okay "已关掉内置代理，拷来的节点定义删掉了（之后在外面连不上路由器时会再问）"
			else okay "已移除本机 Clash 的端口池（之后在外面连不上路由器时会再问）"; fi ;;
		udp) shift; cmd_local_udp "$@" ;;
		*) die "用法: cca local [status|setup|off|udp]" ;;
	esac
}

# ---------------------------------------------------------------------------
# 内置代理：在外面、这台 Mac 上又没有 Clash 客户端时，用 cca 自己带的 mihomo 内核（config.json 的 local.client 是 builtin）。
# 端口池和本机 Clash 的一样（127.0.0.1:7901…，入站 cca-n 直通策略组 CCA-n），切换节点、端口检查、泄露检测都走上面那一套。
# - 内核由界面 App 托管：App 读到本机客户端是内置代理就运行 cca _core run（生成配置后 exec 内核），退出了就重启，App 退出时停掉。
#   App 没开着时 cca 在后台打开它（--core：不弹主窗口，只留菜单栏图标）
# - Linux（服务器）上没有界面 App：由 cca 自己的后台进程 cca _core-keep 照 App 的做法托管（py 的 cmd_core_keep），不用 root、不靠
#   systemd；机器重启后，下次在外面启动账号时再起
# - 内核文件第一次用时从 mihomo 官方 Release 下载，按开头写死的 SHA256 校验（cca 本身有签名，校验值可信）
# - 节点：在家时从路由器拷一份可选节点的完整定义（core/nodes.json，路由器端的 defs），再补上 Team 的配置里路由器上没有的节点；
#   两边都没有定义的节点在组里 REJECT 排第一（宁可断开也不换出口）
# - 配置 core/config.yaml 只有这些入站、组和节点：不开通用的代理端口、系统代理、TUN、DNS；控制接口只开 Unix socket
# ---------------------------------------------------------------------------
CORE_DIR="$CCA_HOME/core"
core_bin() { printf '%s' "$CORE_DIR/mihomo-v$CORE_VERSION"; }
core_sock() {   # 控制接口的 Unix socket：macOS 上放在系统给这个用户的临时目录（~/.cca 下的路径可能超过 macOS 的
	             # 104 字节上限），名字带上 ~/.cca 的摘要：两份 ~/.cca（比如测试的沙箱）不会用到同一个。Linux 上放在 core 目录里（只有自己能进，
	             # 不像 XDG_RUNTIME_DIR 退出登录后会被删掉）；路径长到放不下（108 字节）时才放进 XDG_RUNTIME_DIR
	local d h
	if on_linux; then
		d="$CORE_DIR/cca-core.sock"
		if [ "$(printf '%s' "$d" | wc -c)" -ge 100 ] && [ -n "${XDG_RUNTIME_DIR:-}" ]; then
			d="${XDG_RUNTIME_DIR%/}/cca-core-$(printf '%s' "$CCA_HOME" | md5sum | cut -c1-8).sock"
		fi
		printf '%s' "$d"
		return
	fi
	d=$(getconf DARWIN_USER_TEMP_DIR 2>/dev/null)
	h=$(md5 -qs "$CCA_HOME" 2>/dev/null | cut -c1-8)
	printf '%s' "${d:-$CORE_DIR/}cca-core-${h:-0}.sock"
}
core_possible() {   # 这台机器能用内置代理吗：有这个架构的内核就行（macOS 26 以上在界面 App 里跑，以下由 cca 在后台无头跑；Linux 也后台跑）
	core_asset >/dev/null
}
core_headless() {   # 内核由 cca 自己在后台托管（cca _core-keep），不靠界面 App：Linux，以及 macOS 26 以下（没有界面 App）
	on_linux || ! gui_os_ok
}
core_asset() {   # 用哪个内核文件（官方 Release 里的名字）和它的校验值。macOS：Apple 芯片（Rosetta 下运行的 cca 也算）用 arm64，Intel 用
	              # amd64-compatible；Linux：x86-64 也用 compatible（不挑 CPU），arm64 服务器用 arm64，别的架构没有
	if on_linux; then
		case "$(uname -m)" in
			x86_64|amd64) printf 'linux-amd64-compatible %s' "$CORE_SHA256_LINUX_AMD64" ;;
			aarch64|arm64) printf 'linux-arm64 %s' "$CORE_SHA256_LINUX_ARM64" ;;
			*) return 1 ;;
		esac
	elif [ "$(sysctl -n hw.optional.arm64 2>/dev/null)" = 1 ]; then printf 'darwin-arm64 %s' "$CORE_SHA256_ARM64"
	else printf 'darwin-amd64-compatible %s' "$CORE_SHA256_AMD64"; fi
}
core_runs_where() {   # 提示里说内核在哪儿跑
	if core_headless; then printf '由 cca 在后台运行'; else printf '在界面 App 里运行'; fi
}
sha256_of() { if on_linux; then sha256sum "$1"; else shasum -a 256 "$1"; fi 2>/dev/null | cut -d' ' -f1; }   # Linux 不一定有 shasum（perl 的）
core_fetch() {   # 内核文件不在就下载：mihomo 官方 Release 里固定的版本，.gz 的 SHA256 对上、能运行才换上（旧版本的删掉）；失败原因在 FETCH_ERR
	local arch sha url tmp got f
	[ -x "$(core_bin)" ] && return 0
	FETCH_ERR="内置代理的内核没有这个架构（$(uname -m)）的版本"
	read -r arch sha <<< "$(core_asset)" && [ -n "$sha" ] || return 1
	url="https://github.com/MetaCubeX/mihomo/releases/download/v${CORE_VERSION}/mihomo-${arch}-v${CORE_VERSION}.gz"
	FETCH_ERR=""
	if ! ( umask 077; mkdir -p "$CORE_DIR" ) || ! chmod 700 "$CORE_DIR" || ! tmp=$(mktemp -d "$CORE_DIR/dl.XXXXXX"); then
		FETCH_ERR="建不了 ${CORE_DIR}"
		return 1
	fi
	info "正在下载内置代理的内核 mihomo v${CORE_VERSION}（约 21MB，只有第一次）…"
	if ! retry3 curl -fsSL --connect-timeout 15 -m 300 -o "$tmp/m.gz" "$url" 2>/dev/null; then
		FETCH_ERR="下载失败（${url}）"
	elif got=$(sha256_of "$tmp/m.gz") && [ "$got" != "$sha" ]; then
		FETCH_ERR="下载的文件校验不对（应为 ${sha}，实际是 ${got}），没有用它"
	elif ! gunzip -c "$tmp/m.gz" > "$tmp/m" 2>/dev/null || ! chmod 755 "$tmp/m" || ! "$tmp/m" -v 2>/dev/null | grep -qF "v${CORE_VERSION}"; then
		FETCH_ERR="内核文件运行不了"
	elif mv -f "$tmp/m" "$(core_bin)"; then
		rm -rf "$tmp"
		for f in "$CORE_DIR"/mihomo-v*; do [ "$f" = "$(core_bin)" ] || rm -f "$f"; done
		return 0
	else
		FETCH_ERR="换上内核文件失败"
	fi
	rm -rf "$tmp"
	return 1
}
core_offer() {   # 界面 App 里、在外面：改用内置代理吗（同意框，同意后带着授权重跑；终端里走 cca local setup）
	consent builtin_core "" "改用内置代理" "没找到 Clash 客户端，改用 cca 内置的代理吗？" \
		"cca 在界面 App 里跑一个 mihomo 内核，每个账号照样走自己的节点（第一次要下载约 21MB；节点用在家时从路由器拷的那份）。用别的 Clash 客户端的话，在终端里运行 cca local setup" y ||
		{ gui_fail local_unavailable "没有启用内置代理"; return 1; }
	py local-set client builtin || return 1
	load_local
	okay "已改用内置代理（不想用了运行 cca local off）"
}
core_setup() {   # cca local setup 选了内置代理：在家时先从路由器拷节点定义，然后让它就绪
	local miss
	py local-set client builtin || return 1
	load_local
	if at_home; then
		info "正在从路由器拷节点定义…"
		core_nodes_fetch || warn "没能从路由器拷到节点定义：在家启动账号时会再试"
	fi
	miss=$(py core-missing)
	[ -z "$miss" ] || fail_warn node_missing "内置代理里没有这些节点的定义：${miss}。用它们的账号在外面会被拒绝连接，直到在家连上路由器、拷到它们"
	if [ "${LOCAL_SLOTS:-0}" = 0 ]; then   # 还没有走节点的账号：端口池是空的，内核先不用起（BSD 的 seq 7901 7900 还会倒着数）
		okay "已改用内置代理：加了走节点的账号之后，启动时 cca 自动起它"
		core_boot_offer
		gui_done local_ready "已改用内置代理"
		return 0
	fi
	local_ensure || { gui_fail local_unavailable "内置代理没有就绪（详情里有原因）"; return 1; }
	okay "本机端口池已就绪：内置代理 127.0.0.1:${LOCAL_FIRST}–${LOCAL_LAST}（$(core_runs_where)），连不上路由器时账号自动走这里"
	core_boot_offer
	gui_done local_ready "本机端口池已就绪：内置代理 127.0.0.1:${LOCAL_FIRST}–${LOCAL_LAST}"
}
core_ensure() {   # 内置代理可用：内核文件在、配置最新、界面 App（Linux 上是 cca _core-keep）在托管内核、端口都在监听、每个槽位切到账号的节点
	local rc
	if ! core_possible; then
		warn "内置代理的内核没有这台机器（$(uname -m)）的版本"
		return 1
	fi
	core_fetch || { warn "内置代理的内核没装上：${FETCH_ERR}"; return 1; }
	py core-config "$(core_sock)" || { warn "生成内置代理的配置失败"; return 1; }
	core_up || return 1
	if [ "$LOCAL_APPLIED" != "$LOCAL_WANT" ] || ! local_ports_ok; then
		core_reload || return 1
		[ -z "${LOCAL_BIND:-}" ] || info "$(bind_note)"
	fi
	local_select_all; rc=$?
	[ $rc -eq 0 ] && return 0
	[ $rc -eq 2 ] || return 1
	core_reload && local_select_all
}
bind_note() {   # 内置代理的出站绑定了物理网卡（别的程序开着 TUN，见辅助程序的 core_bind）时的说明
	printf '别的程序开着虚拟网卡 %s（Clash 客户端的 TUN、VPN 这类）：内置代理连节点时绑定物理网卡 %s，绕开它%s' "$LOCAL_BIND_VIA" "$LOCAL_BIND" \
		"${LOCAL_BIND_DNS:+；节点的域名经 ${LOCAL_BIND_DNS} 解析（系统的 DNS 经物理网卡到不了）}"
}
core_up() {   # 内核在跑（控制接口能用）；没在跑就让界面 App（Linux 上是 cca _core-keep）起它，最多等 20 秒
	local i
	lctl GET /version
	[ "$LCODE" = 200 ] && return 0
	core_launch || return 1
	for i in $(seq 1 80); do
		sleep 0.25
		lctl GET /version
		[ "$LCODE" = 200 ] && return 0
	done
	if core_headless; then
		warn "等了 20 秒，内置代理的内核还没就绪（日志：${CORE_DIR/#$HOME/~}/core.log）"
	elif ! dev_mode && gui_ours "$GUI_APP" && [ "$(gui_ver "$GUI_APP")" != "$VERSION" ]; then
		warn "等了 20 秒，内置代理的内核还没就绪：开着的界面 App（$(gui_ver "$GUI_APP")）和 cca（${VERSION}）版本不同，旧版不会运行内置代理。在 App 里点「更新并重新打开」，或者退出它再运行 cca gui"
	else
		warn "等了 20 秒，内置代理的内核还没就绪（界面 App 的日志：~/Library/Caches/local.cca.app/core.log）"
	fi
	return 1
}
core_launch() {   # 内核由界面 App 托管：App 没开就在后台打开它（--core：不弹主窗口，只留菜单栏图标），它读到本机客户端是内置代理就
	               # 运行 cca _core run；已经开着的 App 看到 core/config.yaml 变了会重新读 state、接着起内核（不再 open：会弹出主窗口）
	local app
	if core_headless; then   # 后台托管（Linux，以及 macOS 26 以下没有界面 App）：起 cca 自己的后台进程（已有一个在跑的新起的马上退出；碰一下配置文件，退避中的马上重启）
		touch "$CORE_DIR/config.yaml"
		( perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' "$SELF" _core-keep </dev/null >/dev/null 2>&1 3<&- & )
		return 0
	fi
	if dev_mode; then   # 开发模式：用 macos/ 编出来的 App（和 cca gui 一样）
		app=$(gui_dev_build) || return 1
		if pgrep -f "$app/Contents/MacOS/cca( |\$)" >/dev/null 2>&1; then touch "$CORE_DIR/config.yaml"; return 0; fi
		open -g --env CCA_GUI_CCA="$SELF" "$app" --args --core || { warn "打开 ${app} 失败"; return 1; }
		return 0
	fi
	if ! gui_ours "$GUI_APP"; then
		if ! interactive; then
			fail_warn local_unavailable "内置代理在 cca 的界面 App 里运行，这台 Mac 还没装：在终端里运行 cca local setup"
			TOOL=claude gui_terminal local_setup "内置代理要先装界面 App：在终端里配置一次" local setup
			return 1
		fi
		confirm "内置代理在 cca 的界面 App 里运行，现在安装界面 App 吗？" y || return 1
		( cmd_gui ) || return 1   # 装好后照常打开它（这次有窗口）
		return 0
	fi
	if gui_running; then   # 开着：碰一下配置文件提醒它（重新读 state；内核正在退避重启的话马上重启）
		touch "$CORE_DIR/config.yaml"
		return 0
	fi
	open -g "$GUI_APP" --args --core || { warn "打开 ${GUI_APP} 失败"; return 1; }
}
# 内核由 cca 在后台托管时（core_headless：Linux、macOS 26 以下），开机后起内置代理的内核：用户自己的 crontab 里一行 @reboot（不用
# root、不靠 systemd），运行 cca _core-keep（它看内置代理还在用、配置文件在才起内核）。只动带 # cca-core 记号的那一行，别的原样
# 留着。cca local setup 选内置代理时问一次，不再用内置代理（cca local off、cca restore）时删掉：加、删都看 core_headless
CORE_BOOT_TAG="# cca-core"
core_boot() {   # core_boot has|on|off；没有 crontab 命令、读不了用户的 crontab（不是"还没有"）、写不进去时返回 1
	local cur line err="$CCA_HOME/crontab.err.$$" nl=$'\n'
	command -v crontab >/dev/null 2>&1 || return 1
	if ! cur=$(LC_ALL=C crontab -l 2>"$err"); then   # 还没有 crontab 时 cron 说 no crontab for …，busybox 说 No such file
		grep -qiE 'no crontab|no such file' "$err" 2>/dev/null || { rm -f "$err"; return 1; }
		cur=""
	fi
	rm -f "$err"
	line="@reboot $(shq "$SELF") _core-keep >/dev/null 2>&1 $CORE_BOOT_TAG"
	case "$1" in
		has) printf '%s\n' "$cur" | grep -qxF "$line"; return ;;
		on) printf '%s\n' "$cur" | grep -qxF "$line" && return 0 ;;
		off) printf '%s\n' "$cur" | grep -qF "$CORE_BOOT_TAG" || return 0 ;;
	esac
	cur=$(printf '%s\n' "$cur" | grep -vF "$CORE_BOOT_TAG")
	[ "$1" = on ] && cur="${cur:+$cur$nl}$line"
	printf '%s\n' "$cur" | crontab -
}
core_boot_offer() {   # 后台托管内核时（Linux，macOS 26 以下）配置好内置代理之后：问要不要开机后自动起内核（已经加过就不问）
	core_headless || return 0
	if ! command -v crontab >/dev/null 2>&1; then
		info "这台机器上没有 crontab 命令：重启后内置代理的内核不会自己起来，下次启动账号时 cca 会起它"
		return 0
	fi
	core_boot has && return 0
	confirm "机器重启后自动起内置代理的内核吗？（在你的 crontab 里加一行 @reboot；cca local off 时删掉）" y || return 0
	if core_boot on; then okay "已加上：机器重启后内置代理的内核自己起来"
	else warn "没能改 crontab（读不了或写不进去）：重启后要等下次启动账号时 cca 才起内核"; fi
}
core_reload() {   # 照账号表重新生成配置，交给在跑的内核重新加载（PUT /configs），等端口都监听上
	local i
	py core-config "$(core_sock)" || { warn "生成内置代理的配置失败"; return 1; }
	lctl PUT '/configs?force=true' "{\"path\":$(jstr "$CORE_DIR/config.yaml")}"
	case "$LCODE" in
		2??) ;;
		*) warn "内置代理的内核没接受新配置（HTTP ${LCODE}）：$(printf '%s' "$LBODY" | head -c 200)"; return 1 ;;
	esac
	for i in $(seq 1 20); do local_ports_ok && break; sleep 0.25; done
	local_ports_ok || { warn "内置代理重新加载了配置，但端口 ${LOCAL_FIRST}–${LOCAL_LAST} 没有全部监听（可能被别的程序占用了）"; return 1; }
	py local-set applied "$LOCAL_WANT"
}
core_retire() {   # 不再用内置代理（cca local off；先改好 config.json 里的客户端）：删掉配置和拷来的节点（有密钥），等内核停下，
	              # 免得它还占着端口。界面 App（Linux 上是 cca _core-keep）看到配置没了会停掉它；没在托管（或者 10 秒还没停）就按 pid 文件停掉
	local i ctl="$LOCAL_CTL"
	rm -f "$CORE_DIR/config.yaml" "$CORE_DIR/nodes.json"
	if [ -e "$UDP_FLAG" ]; then   # 本机 UDP 走节点只给内置代理用：一起关掉（root 的内核看开关文件没了自己停下）
		rm -f "$UDP_FLAG"
		info "本机 UDP 走节点也关掉了（系统服务还装着、不在运行；删掉它运行 cca local udp uninstall）"
	fi
	rm -f "$UDP_HOME"
	core_headless && { core_boot off || warn "没能从 crontab 里删掉开机起内核的那一行（带 ${CORE_BOOT_TAG}）：自己删一下（crontab -e）"; }
	if on_linux || gui_running; then
		LOCAL_CTL="unix:$(core_sock)"
		for i in $(seq 1 40); do lctl GET /version; [ "$LCODE" = 200 ] || break; sleep 0.25; done
		LOCAL_CTL="$ctl"
	fi
	core_stop_stale
}
core_stop_stale() {   # 别的内核还占着端口（界面 App、cca _core-keep 崩溃后留下的：它在自己的会话里，没跟着退出）：按 pid 文件认出来停掉
	local pid i
	pid=$(cat "$CORE_DIR/mihomo.pid" 2>/dev/null)
	[[ "$pid" =~ ^[0-9]+$ ]] && [ "$pid" != "$$" ] || return 0
	proc_args "$pid" | grep -qF "$CORE_DIR/mihomo-v" || return 0
	kill "$pid" 2>/dev/null
	for i in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || return 0; sleep 0.25; done
	kill -9 "$pid" 2>/dev/null
	return 0
}
cmd_core() {   # cca _core run：界面 App（Linux 上是 cca _core-keep）托管的内置代理（前台运行）。照账号表生成配置后 exec 内核：托管它的进程的子进程就是内核本身
	[ "${1:-}" = run ] || die "用法: cca _core run"
	[ -f "$CFG" ] || die "还没安装：请在终端里运行 $SELF install"
	load_local
	[ "$LOCAL_CLIENT" = builtin ] || die "本机客户端不是内置代理（cca local setup 可以改用它）"
	core_fetch || die "内置代理的内核没装上：${FETCH_ERR}"
	core_stop_stale
	py core-config "$(core_sock)" || die "生成内置代理的配置失败"
	py local-set applied "$LOCAL_WANT"   # 内核照刚写好的配置起：端口池就是最新的（不然 App 刚起好内核时「节点分流」页也说本机的端口还没更新）
	rm -f "$(core_sock)"   # 上次没删掉的 socket 文件会让内核绑定失败
	printf '%s\n' "$$" > "$CORE_DIR/mihomo.pid"
	exec "$(core_bin)" -d "$CORE_DIR" -f "$CORE_DIR/config.yaml"
}
core_nodes_fetch() {   # 在家：路由器上节点的完整定义拷一份进 core/nodes.json（只留可选节点和它们经 dialer-proxy 用到的），在外面给内置代理用。
	                    # 全程走管道（有密钥，不落盘）：路由器端 defs 写好 JSON（路由器上本来就有 ruby，这台机器上不用）→ py 只在读到完整的
	                    # JSON（带着结束标记）时才写
	router_ready || return 1
	router_sh | rsh 'sh -s defs' 2>/dev/null | py core-nodes-save
}
core_nodes_hook() {   # 在家启动账号之后：会走内置代理的机器（本机客户端是它，或者没配置），节点定义的缓存不在、
	                   # 超过 12 小时、可选节点变了，就在后台从路由器拷一份新的；已经用内置代理的，内核文件不在（第一次、换了版本）也在家先下好
	                   # （在外面直连 GitHub 可能很慢），端口池旧了（在跑的内核加载的配置和现在要的对不上）让在跑的内核跟上（core_follow）。
	                   # 都在后台，不拖慢启动
	local st
	core_possible || return 0
	st=$(py core-stale "$([ -x "$(core_bin)" ] && echo 1)")
	[ -n "${st// /}" ] || return 0
	( unset CCA_EVENTS CCA_GRANT CCA_RO; "$SELF" _core-nodes $st </dev/null >/dev/null 2>&1 & )
}
cmd_core_nodes() {   # cca _core-nodes [nodes] [bin] [reload]（后台）：从路由器拷节点定义、下载内核文件，最后让在跑的内核跟上端口池；同一时间只跑一个
	local lk="$CCA_HOME/core-nodes.lock" a
	[ -f "$CFG" ] || return 0
	[ -n "$(find "$lk" -maxdepth 0 -mmin +10 2>/dev/null)" ] && rmdir "$lk"   # 上次异常退出留下的锁
	mkdir "$lk" 2>/dev/null || return 0
	[ $# -gt 0 ] || set -- nodes
	for a in "$@"; do
		case "$a" in
			nodes) core_nodes_fetch ;;
			bin) core_fetch >/dev/null 2>&1 ;;
		esac
	done
	core_follow >/dev/null 2>&1   # 拷来的节点定义、账号表变了（reload：core-stale 看出来的）：内核在跑就重新加载一次
	rmdir "$lk" 2>/dev/null
	return 0
}

# ---------------------------------------------------------------------------
# 本机 UDP 走节点（cca local udp，只在 macOS 上、只给内置代理；辅助程序的同名一节）：内置代理只在 127.0.0.1 上开账号的端口，这台 Mac 自己的
# UDP（浏览器的 WebRTC、QUIC 这些）照旧直连，STUN 看到的是本地网络的出口。macOS 上开 TUN 要 root：输一次管理员密码，装一个 root 的
# 系统服务（LaunchDaemon local.cca.udp）。~/.cca/udp/on 在时 launchd 起它（开机后也是）：一个只开 TUN 的 mihomo，UDP 交给选定的节点，
# TCP、DNS、局域网、ZeroTier / Tailscale、代理内核自己的流量照旧直连；开关文件没了它自己停下、退出（不留 root 进程）。开、关不用密码；
# root 那边的文件只在输密码的那一步从私有的临时目录拷过去，按摘要逐个核对、内核校验过配置才换上：普通用户的进程改不了它跑什么
# ---------------------------------------------------------------------------
UDP_FLAG="$CCA_HOME/udp/on"
UDP_HOME="$CCA_HOME/udp/home"   # 在家暂停的记号（udp_home_finish）：开关文件不在、它在时，是在家时路由器管着这台 Mac 的 UDP，本机的先停着
udp_env() { eval "$(py udp-env)"; }   # UDP_ROOT、UDP_PLIST、UDP_LOG、UDP_OWNER、UDP_LABEL、UDP_FLAG、TUN 的网卡名 UDP_TUN；设的节点 UDP_NODE、
                                      # 状态 UDP_STATE、装着的 UDP_INSTALLED；启动脚本给哪块网卡上的 VPN 让开了 UDP_OTHER（没让开是空的）
udp_running() {   # root 的内核在跑（普通用户的 ps 也看得到它的命令行）。先取下 ps 的输出再比：经管道交给 grep 时 grep 自己的命令行就带着
	               # 这一段，ps 总会列出它（以前一直当成在跑：停着也说在运行，udp_wait down 总要白等 6 秒）
	case "$(ps -axww -o command= 2>/dev/null)" in *"$UDP_ROOT/mihomo -d "*) return 0 ;; esac
	return 1
}
udp_yielded() {   # 启动脚本给别的 VPN 让开了：other-vpn 在、启动脚本在跑（和辅助程序的 udp_other 一样认；ps 的输出先取下来再比，不经 grep：
	              # 管道里 grep 自己的命令行也带着这个路径）
	local p
	[ -s "$UDP_ROOT/other-vpn" ] || return 1
	p=$(ps -axww -o command= 2>/dev/null)
	case "$p" in *"$UDP_ROOT/cca-udp"*) return 0 ;; esac
	return 1
}
udp_yield_note() {   # udp_yield_note 节点：给别的 VPN 让开了时的说明（UDP_OTHER：那块网卡）
	printf '另一个 VPN 或代理客户端的虚拟网卡（%s；比如 Shadowrocket、Clash 的 TUN 模式）接管了这台 Mac 的流量：本机 UDP 走节点先让给它，UDP 照它的规则出去；它关掉后自动接回节点 %s' \
		"$UDP_OTHER" "$1"
}
udp_loaded() { launchctl print "system/$UDP_LABEL" >/dev/null 2>&1; }
udp_present() { [ -e "$UDP_PLIST" ] || [ -e "$UDP_ROOT" ] || udp_loaded; }
udp_flag_on() { ( umask 077; mkdir -p "${UDP_FLAG%/*}" ) && touch "$UDP_FLAG" && rm -f "$UDP_HOME"; }
udp_run_sh() {   # root 那边的启动脚本 cca-udp（launchd 在开关文件在时起它）：开关文件没了就停内核、退出；内核自己退出了以退出码 1 结束，
	              # launchd 过 ThrottleInterval 再起。别的 VPN、代理客户端的 TUN 接管了这台 Mac 的流量时（路由表里经别的虚拟网卡、不限定网卡的
	              # 默认路由或者 1.0.0.0/8 … 128.0.0.0/1 这几大段：Shadowrocket、Clash 的 TUN 模式、系统设置里全局的 VPN……）停下内核让开，
	              # 网卡名写进 other-vpn（辅助程序的 udp_other 读它），那些路由没了再起：两个 TUN 一起开会抢路由，经 cca 的 TUN 的连接回包被
	              # 别的 TUN 截走、全断。每 2 秒看一次。日志超过 1MB 先清空。改了要把辅助程序的 UDP_HELPER（cli/src/cmd/corenet/udp.rs）加 1
	              # （装着的旧版会显示要重新装）
	printf '#!/bin/sh\n# cca local udp：这台 Mac 的 UDP 经节点出去（cca 生成；删掉它运行 cca local udp uninstall）\nD=%s\nFLAG=%s\nLOG=%s\nTUN=%s\n' \
		"$(shq "$UDP_ROOT")" "$(shq "$UDP_FLAG")" "$(shq "$UDP_LOG")" "$(shq "$UDP_TUN")"
	cat <<'EOF'
[ -e "$FLAG" ] || exit 0
[ -z "$(find "$LOG" -size +1024k 2>/dev/null)" ] || : > "$LOG"
AWAY="$D/other-vpn"
other() {
	netstat -rn -f inet 2>/dev/null | awk -v me="$TUN" '$4 != me && $3 !~ /I/ && $4 ~ /^(utun|ipsec|ppp|tun|tap)[0-9]/ &&
		$1 ~ /^(default|0\/1|128\.0\/1|1|2\/7|4\/6|8\/5|16\/4|32\/3|64\/2)$/ { print $4; exit }'
}
note() { echo "$(date '+%Y-%m-%d %H:%M:%S') cca-udp: $1" >> "$LOG"; }
pid=
stop() { [ -z "$pid" ] || { kill $pid 2>/dev/null; wait $pid 2>/dev/null; }; pid=; }
quit() { stop; rm -f "$AWAY"; exit $1; }
trap 'quit 0' TERM INT HUP
rm -f "$AWAY"
while [ -e "$FLAG" ]; do
	vpn=$(other)
	if [ -n "$vpn" ]; then
		if [ "$vpn" != "$(cat "$AWAY" 2>/dev/null)" ]; then
			stop
			echo "$vpn" > "$AWAY"
			note "另一个 VPN（${vpn}）接管了这台 Mac 的流量：先停下，等它关掉"
		fi
	elif [ -z "$pid" ]; then
		[ ! -e "$AWAY" ] || { rm -f "$AWAY"; note "另一个 VPN 关掉了：接着起"; }
		"$D/mihomo" -d "$D" -f "$D/config.yaml" >> "$LOG" 2>&1 &
		pid=$!
	elif ! kill -0 $pid 2>/dev/null; then
		pid=
		quit 1
	fi
	sleep 2 &
	wait $!
done
quit 0
EOF
}
udp_root_script() {   # udp_root_script install 临时目录 | uninstall：用管理员权限运行的脚本（经 osascript 的参数传过去：里面没有密钥，只有路径和摘要）。
	                   # install：从临时目录拷进旁边的新目录（只有 root 能进），按 py udp-build 给的摘要逐个核对，改属主和权限，内核校验过配置，
	                   # 才停掉旧的、换上、装 launchd 的配置（开关文件在的话 launchd 马上起它）；中途出错时旧的照跑
	printf 'set -e\numask 022\nD=%s\nP=%s\nL=%s\nO=%s\nLABEL=%s\n' "$(shq "$UDP_ROOT")" "$(shq "$UDP_PLIST")" "$(shq "$UDP_LOG")" "$(shq "$UDP_OWNER")" "$(shq "$UDP_LABEL")"
	cat <<'EOF'
case "$D" in /*/cca-udp) ;; *) echo "cca-udp: 目录不对：$D" >&2; exit 5 ;; esac
EOF
	if [ "$1" = uninstall ]; then
		printf 'launchctl bootout "system/$LABEL" 2>/dev/null || true\nrm -f "$P" "$L"\nrm -rf "$D" "$D.new"\n'
		return 0
	fi
	printf 'S=%s\nB=%s\nSUMS=%s\n' "$(shq "$2")" "$(shq "$(core_bin)")" "'mihomo:$B_BIN config.yaml:$B_CFG cca-udp:$B_RUN info.json:$B_INFO plist:$B_PLIST'"
	cat <<'EOF'
N="$D.new"
rm -rf "$N"
mkdir -p "${D%/*}" "${P%/*}"
mkdir -m 700 "$N"
cp "$B" "$N/mihomo"
for f in config.yaml cca-udp info.json plist; do cp "$S/$f" "$N/$f"; done
for x in $SUMS; do
	f=${x%%:*}
	[ "$(shasum -a 256 "$N/$f" | cut -d' ' -f1)" = "${x#*:}" ] || { echo "cca-udp: $f 和 cca 生成的不一样，没有换上" >&2; rm -rf "$N"; exit 3; }
done
chown "$O" "$N" "$N/mihomo" "$N/config.yaml" "$N/cca-udp" "$N/info.json" "$N/plist"
chmod 755 "$N" "$N/mihomo" "$N/cca-udp"
chmod 600 "$N/config.yaml"
chmod 644 "$N/info.json" "$N/plist"
"$N/mihomo" -t -d "$N" -f "$N/config.yaml" > "$N/test.log" 2>&1 || { echo "cca-udp: 内核校验配置没通过：$(tail -n 1 "$N/test.log")" >&2; rm -rf "$N"; exit 4; }
rm -f "$N/test.log"
launchctl bootout "system/$LABEL" 2>/dev/null || true
mv -f "$N/plist" "$P"
rm -rf "$D"
mv "$N" "$D"
touch "$L"
chown "$O" "$L"
chmod 644 "$L"
launchctl bootstrap system "$P"
EOF
}
udp_admin() {   # udp_admin 说明 脚本：用管理员权限运行脚本（系统的授权框，输这台 Mac 的登录密码：cca 碰不到密码）。脚本经 osascript 的参数
	             # 传过去（do shell script：root 的 /bin/sh）。返回 0 成功；2 取消了授权；1 失败（原因在 UDP_ERR）
	local out
	UDP_ERR=""
	out=$(osascript -e 'on run argv' -e 'do shell script (item 1 of argv) with prompt (item 2 of argv) with administrator privileges' \
		-e 'end run' "$2" "$1" 2>&1 </dev/null) && return 0
	case "$out" in *'(-128)'*) UDP_ERR="取消了授权"; return 2 ;; esac
	UDP_ERR=$(printf '%s\n' "$out" | tail -n 1 | sed 's/^.*execution error: //; s/ *([0-9-]*)$//')
	[ -n "$UDP_ERR" ] || UDP_ERR="osascript 运行失败"
	return 1
}
udp_pick() {   # udp_pick 能选的节点（一行一个）：这台 Mac 的 UDP 交给哪个节点；打印选中的，取消、选不了返回 1
	local n=0 sel name
	local -a names opts
	while IFS= read -r name; do [ -n "$name" ] && { names[n]="$name"; n=$((n + 1)); }; done <<< "$1"
	if [ $n = 0 ]; then
		warn "内置代理里还没有转发 UDP 的节点定义：在家启动一次账号（会从路由器拷可选节点），或者用 cca node add 加一个（有 Team 给你账号的话，加入那个 Team：它的配置带着节点，cca team join）"
		return 1
	fi
	interactive || { warn "要选一个节点：运行 cca local udp on 节点"; return 1; }
	if [ -n "$PROMPT_GUI" ]; then
		for ((sel = 0; sel < n; sel++)); do opts[sel]="opt=$((sel + 1))"$'\t'"${names[sel]}"$'\t'; done
		sel=$(gui_ask choice "这台 Mac 的 UDP 经哪个节点出去？" 1 q=local.udp label=节点 "title=本机 UDP 走节点" \
			"detail=浏览器的 WebRTC、QUIC 这些 UDP 经这个节点出去，TCP 照旧直连。要装一个系统服务，系统会弹出授权框问管理员密码。" "${opts[@]}") || return 1
	else
		say "  这台 Mac 的 UDP（浏览器的 WebRTC、QUIC 这些）经哪个节点出去？"
		if fancy_ok; then
			arrow_menu 0 "${names[@]}"
			[ "$MENU_PICK" -ge 0 ] || return 1
			sel=$((MENU_PICK + 1))
		else
			for ((sel = 0; sel < n; sel++)); do say "    $((sel + 1)). ${names[sel]}"; done
			sel=$(ask "  选择节点编号（回车取消）：" "")
		fi
	fi
	case "$sel" in ''|*[!0-9]*) return 1 ;; esac
	[ "$sel" -ge 1 ] && [ "$sel" -le $n ] || return 1
	printf '%s' "${names[sel - 1]}"
}
udp_install() {   # udp_install 节点：装上 root 那边的系统服务（装着的就是这一份、launchd 里也有它时不用再装）。返回 0 装好了；2 取消了授权；
	               # 1 失败（原因在 UDP_ERR）
	local node="$1" tmp rc
	UDP_ERR=""
	tmp=$(mktemp -d "${TMPDIR:-/tmp}/cca-udp.XXXXXX") || { UDP_ERR="建不了临时目录"; return 1; }
	chmod 700 "$tmp"
	udp_run_sh > "$tmp/cca-udp"
	B_CFG="" B_SAME=""
	eval "$(py udp-build "$node" "$tmp" "$(core_bin)" "$CORE_VERSION")"
	if [ -z "$B_CFG" ]; then rm -rf "$tmp"; UDP_ERR="生成配置失败"; return 1; fi
	if [ -n "$B_SAME" ] && [ -e "$UDP_PLIST" ] && udp_loaded; then rm -rf "$tmp"; return 0; fi
	info "要用管理员权限装一个系统服务（${UDP_LABEL}）：系统会弹出授权框，输入这台 Mac 的登录密码"
	udp_admin "cca 要安装系统服务「本机 UDP 走节点」：这台 Mac 的 UDP（浏览器的 WebRTC 等）经节点 ${node} 出去，TCP 照旧直连。" \
		"$(udp_root_script install "$tmp")"; rc=$?
	rm -rf "$tmp"
	return $rc
}
udp_wait() {   # udp_wait up|down：等 root 的内核起来（最多 15 秒；起来后再等一会儿，TUN 配好路由；启动脚本给别的 VPN 让开了也算）/ 停下（最多 6 秒）
	local i
	if [ "$1" = up ]; then
		for i in $(seq 1 60); do
			udp_running && { sleep "${CCA_UDP_SETTLE:-1}"; return 0; }
			udp_yielded && return 0
			sleep 0.25
		done
		return 1
	fi
	for i in $(seq 1 24); do udp_running || return 0; sleep 0.25; done
	return 1
}
udp_report() {   # 这台 Mac 的 UDP 现在从哪出去：STUN 看到的地址（归属地直连查）
	local ip cc where at any="" cn=""
	while IFS=$'\t' read -r ip cc where; do
		[ -n "$ip" ] || continue
		any=1
		[ "$where" = - ] && where=""
		at="${ip} "
		[ -z "$where" ] || at="${ip}（${where}）"
		[ "$cc" = cn ] && cn="${ip}${where:+（${where}）}"
		info "STUN 看到这台 Mac 的 UDP 从 ${at}出去"
	done < <(py udp-probe)
	[ -n "$any" ] || warn "STUN 没测到这台 Mac 的 UDP 从哪出去（网络不通，或者节点不转发 UDP）"
	if [ -z "$cn" ]; then :
	elif [ -n "${UDP_OTHER:-}" ]; then warn "STUN 看到的是中国大陆的地址 ${cn}：UDP 现在照另一个 VPN（${UDP_OTHER}）的规则出去"
	else fail_warn error "STUN 看到的是中国大陆的地址 ${cn}：这台 Mac 的 UDP 还在直连"; fi
	return 0
}
udp_why() {   # 系统服务没在运行的原因（接在提示后面）
	local l
	if [ ! -e "$UDP_FLAG" ]; then printf '：开关文件 %s 不在（cca local udp on 打开）' "$UDP_FLAG"
	elif ! udp_loaded; then printf '：launchd 里没有它（系统设置 › 通用 › 登录项与扩展 里要允许它在后台运行；或者 cca local udp on 重新装）'
	else
		l=$(tail -n 1 "$UDP_LOG" 2>/dev/null | cut -c1-200)
		[ -z "$l" ] || printf '（日志 %s 的最后一行：%s）' "$UDP_LOG" "$l"
	fi
}
core_follow() {   # 内置代理的端口池跟上现在的账号表、节点定义、路由（开着 TUN 时绑定的网卡）：内核在跑、它加载的配置旧了就重新加载一次，
	              # 再把每个槽位切到分给它的账号的节点（local_select_all）——只是账号换了节点（Team 的配置改了、cca edit）时端口池的结构不变，
	              # 不重新加载，只走控制接口切过去；以前这种改动要等在外面启动账号（core_ensure）才切，在跑的内核一直经旧的节点出去。
	              # 在家时账号走路由器、不经它，以前要等在外面启动账号才更新，「节点分流」页一直说本机的端口还没更新。内核没在跑的不用管：
	              # 起它时用的就是最新的配置（cmd_core 记下），启动账号时 core_ensure 再切。返回 0：重新加载了
	local rc=1 sel
	load_local
	[ "$LOCAL_CLIENT" = builtin ] || return 1
	lctl GET /version
	[ "$LCODE" = 200 ] || return 1
	if [ "$LOCAL_APPLIED" != "$LOCAL_WANT" ]; then core_reload || return 1; rc=0; fi
	local_select_all; sel=$?
	if [ $sel -eq 2 ] && [ $rc -ne 0 ]; then core_reload && local_select_all && rc=0; fi   # 有策略组不在在跑的内核里：配置旧了，重新加载再切
	return $rc
}
udp_core_follow() {   # 开关 TUN 之后：内置代理的内核在跑的话照现在的路由重新加载一次（开着 TUN 时它绑定物理网卡连节点，见 bind_note）
	core_follow && [ -n "${LOCAL_BIND:-}" ] && info "$(bind_note)"
	return 0
}
udp_on() {   # cca local udp on [节点] / pick：这台 Mac 的 UDP 经这个节点出去（不给时用设过的、装着的那个，都没有就问；pick 总是问）
	local want="${1:-}" pick="${2:-}" node rc msg
	load_local
	[ "$LOCAL_CLIENT" = builtin ] || FAIL_CODE=local_unavailable die "本机 UDP 走节点只给内置代理用：先配置内置代理（cca local setup）"
	udp_env
	[ -n "$want" ] || [ -n "$pick" ] || want="${UDP_NODE:-$UDP_INSTALLED}"
	node=$(py udp-node "$want"); rc=$?
	if [ $rc != 0 ]; then
		case "$rc:$want" in
			2:?*) warn "内置代理里没有节点「${want}」的定义（节点定义来自在家时从路由器拷的可选节点、Team 的配置带的节点和自定义节点）" ;;
			3:?*) warn "节点「${want}」不转发 UDP（它的定义里没有 udp: true）" ;;
		esac
		node=$(udp_pick "$node") || { gui_cancelled; return 1; }
	fi
	core_fetch || FAIL_CODE=local_unavailable die "内置代理的内核没装上：${FETCH_ERR}"
	udp_install "$node"; rc=$?
	[ $rc != 2 ] || { say "已取消：什么都没改"; gui_cancelled; return 1; }
	[ $rc = 0 ] || die "没装上本机 UDP 走节点的系统服务：${UDP_ERR}"
	py local-set udp "$node" || return 1
	udp_flag_on || die "建不了开关文件 ${UDP_FLAG}"
	msg="这台 Mac 的 UDP 经节点 ${node} 出去"
	if udp_wait up; then
		udp_env
		if [ -n "$UDP_OTHER" ]; then
			msg=$(udp_yield_note "$node")
			warn "$msg"
		else
			okay "这台 Mac 的 UDP 现在经节点 ${node} 出去（TCP 照旧直连；关掉：cca local udp off）"
		fi
	else
		fail_warn error "开关打开了，系统服务 ${UDP_LABEL} 却没起来$(udp_why)"
	fi
	udp_report
	udp_core_follow
	gui_done local_udp "$msg"
}
udp_off() {   # cca local udp off：关掉（删开关文件，root 的内核自己停下；系统服务留着，再开同一个节点不用密码）
	udp_env
	rm -f "$UDP_FLAG" "$UDP_HOME"
	py local-set udp '' || return 1
	udp_wait down || warn "系统服务 ${UDP_LABEL} 还没停下"
	if [ -n "$UDP_INSTALLED" ]; then okay "已关掉：这台 Mac 的 UDP 照旧直连（系统服务还装着、不在运行，再开同一个节点不用输密码；删掉它运行 cca local udp uninstall）"
	else okay "已关掉：这台 Mac 的 UDP 照旧直连"; fi
	udp_core_follow
	gui_done local_udp "已关掉本机 UDP 走节点"
}
udp_uninstall() {   # cca local udp uninstall：关掉，并删掉 root 的系统服务（要管理员密码）
	local rc
	udp_env
	rm -f "$UDP_FLAG" "$UDP_HOME"
	[ -z "$UDP_NODE" ] || py local-set udp ''
	if ! udp_present; then
		info "本机 UDP 走节点的系统服务没装"
		gui_done local_udp "本机 UDP 走节点的系统服务没装"
		return 0
	fi
	info "要用管理员权限删掉系统服务 ${UDP_LABEL}：系统会弹出授权框，输入这台 Mac 的登录密码"
	udp_admin "cca 要删掉系统服务「本机 UDP 走节点」（${UDP_LABEL}）。" "$(udp_root_script uninstall)"; rc=$?
	case $rc in
		0) okay "已删掉系统服务 ${UDP_LABEL}：这台 Mac 的 UDP 照旧直连" ;;
		2) warn "取消了：系统服务 ${UDP_LABEL} 还装着（不在运行）"; return 1 ;;
		*) warn "没删掉系统服务（${UDP_ERR}）。可以手动删：sudo launchctl bootout system/${UDP_LABEL}; sudo rm -rf $(shq "$UDP_ROOT") $(shq "$UDP_PLIST") $(shq "$UDP_LOG")"; return 1 ;;
	esac
	udp_core_follow
	gui_done local_udp "已删掉本机 UDP 走节点的系统服务"
}
udp_status() {   # cca local udp：设的节点、系统服务在不在跑、STUN 看到的出口
	load_local
	udp_env
	say ""
	if [ "$LOCAL_CLIENT" != builtin ]; then
		info "本机 UDP 走节点只给内置代理用（cca local setup 配置内置代理）"
		[ -z "$UDP_INSTALLED" ] || info "系统服务 ${UDP_LABEL} 还装着：删掉它运行 cca local udp uninstall"
	else
		case "$UDP_STATE" in
			off) info "没开：这台 Mac 的 UDP（浏览器的 WebRTC、QUIC 这些）直连出去。cca local udp on [节点] 让它经节点出去（要输一次管理员密码）" ;;
			ok) if [ -n "$UDP_OTHER" ]; then warn "$(udp_yield_note "$UDP_NODE")"
				elif udp_running; then okay "这台 Mac 的 UDP 经节点 ${UDP_NODE} 出去（系统服务 ${UDP_LABEL} 在运行；TCP 照旧直连）"
				elif [ ! -e "$UDP_FLAG" ] && [ -e "$UDP_HOME" ]; then
					info "在家暂停着：路由器已经让这台 Mac 的 UDP 经节点出去，本机 UDP 走节点（${UDP_NODE}）先停着；出门在外启动账号、检测出口时自动再打开（现在就要打开：cca local udp on）"
				else warn "设了经节点 ${UDP_NODE}，系统服务 ${UDP_LABEL} 却没在运行$(udp_why)"; fi ;;
			stale) warn "设了经节点 ${UDP_NODE}，装着的配置是旧的（节点的定义变了，或者 cca 更新了）：运行 cca local udp on 重新装（要输管理员密码）" ;;
			missing) warn "设了经节点 ${UDP_NODE}，系统服务却不在了：运行 cca local udp on 重新装（要输管理员密码）" ;;
			undefined) warn "设了经节点 ${UDP_NODE}，内置代理里已经没有它转发 UDP 的定义（装着的系统服务还用着以前那份）：在家启动一次账号拷节点定义，或者 cca local udp on 节点 换一个" ;;
		esac
	fi
	udp_report
	say ""
}
udp_launch_check() {   # 在外面启动账号、检测出口时（设了本机 UDP 走节点，LOCAL_UDP、LOCAL_UDP_STATE 来自 local-env）：开关文件不在就补上
	                    # （在家暂停过的说一声）；装着的旧了只提醒（要输密码，启动时不问）
	case "$LOCAL_UDP_STATE" in
		ok) if [ ! -e "$UDP_FLAG" ]; then
				[ ! -e "$UDP_HOME" ] || info "出门在外：本机 UDP 重新经节点 ${LOCAL_UDP} 出去（在家时路由器管着，先停着的）"
				udp_flag_on
			fi ;;
		stale|missing) warn "本机 UDP 走节点（${LOCAL_UDP}）要重新装一次：运行 cca local udp on（要输管理员密码）" ;;
		undefined) warn "本机 UDP 走节点：内置代理里已经没有节点「${LOCAL_UDP}」转发 UDP 的定义（cca local udp 查看）" ;;
	esac
	return 0
}
udp_home_start() {   # 在家（经路由器）测出口时（coffee_check）：开着本机 UDP 走节点的话，后台绑定物理网卡（绕开它的 TUN）问一次 STUN
	                  # （py udp-probe phys），看路由器自己能不能把这台 Mac 的 UDP 送出大陆。一条命令只测一次；开关文件只在 macOS 上有
	UDP_HOME_PID="" UDP_HOME_OUT=""
	[ "${ROUTE:-}" = router ] && [ -e "$UDP_FLAG" ] && [ -z "${UDP_HOME_DONE:-}" ] || return 0
	UDP_HOME_DONE=1
	UDP_HOME_OUT=$(mktemp "${TMPDIR:-/tmp}/cca-udp.XXXXXX" 2>/dev/null) || return 0
	py udp-probe phys > "$UDP_HOME_OUT" 2>/dev/null &
	UDP_HOME_PID=$!
}
udp_home_finish() {   # 测完出口以后（coffee_check）。udp_home_start 测到的都是大陆以外的地址（归属地都认得出）：路由器已经管着这台 Mac 的
	                   # UDP，删掉开关文件（root 的内核自己停下）、留下在家暂停的记号；设的节点留着，出门在外启动账号、检测出口时
	                   # （udp_launch_check）自动再打开。没测到、有大陆的地址、归属地认不出时不动（测不出来不能当作没问题）。
	                   # 在家暂停着、WebRTC 检测却看到大陆的地址（路由器不再让 UDP 经节点出去）时重新打开
	local ip cc where seen="" bad=""
	if [ -n "${UDP_HOME_PID:-}" ]; then
		wait "$UDP_HOME_PID" 2>/dev/null
		while IFS=$'\t' read -r ip cc where; do
			[ -n "$ip" ] || continue
			[ "$where" != - ] || where=""
			case "$cc" in cn|-|'') bad=1 ;; esac
			seen="${seen:+${seen}、}${ip}${where:+（${where}）}"
		done < "$UDP_HOME_OUT"
		rm -f "$UDP_HOME_OUT"
		UDP_HOME_PID="" UDP_HOME_OUT=""
		[ -n "$seen" ] && [ -z "$bad" ] || return 0
		rm -f "$UDP_FLAG"
		( umask 077; : > "$UDP_HOME" )
		info "在家：路由器已经让这台 Mac 的 UDP 从 ${seen} 出去，本机 UDP 走节点先停着（出门在外时自动再打开）"
	elif [ "${ROUTE:-}" = router ] && [ "${LEAK_WEBRTC_STATE:-}" = leak ] && [ -e "$UDP_HOME" ] && [ ! -e "$UDP_FLAG" ]; then
		udp_env
		[ "$UDP_STATE" = ok ] || return 0
		udp_flag_on
		warn "在家：WebRTC 检测看到中国大陆的地址，路由器没让这台 Mac 的 UDP 经节点出去：本机 UDP 走节点（${UDP_NODE}）重新打开"
	fi
	return 0
}
cmd_local_udp() {   # cca local udp [on [节点] | 节点 | pick | off | uninstall]
	mac_only "本机 UDP 走节点（cca local udp）"
	case "${1:-}" in
		''|status) udp_status ;;
		on) udp_on "${2:-}" ;;
		pick) udp_on "" pick ;;
		off) udp_off ;;
		uninstall) udp_uninstall ;;
		-*|help) die "用法: cca local udp [on [节点] | pick | off | uninstall]" ;;
		*) udp_on "$1" ;;
	esac
}

# ---------------------------------------------------------------------------
# 辅助安装（cca [codex|agy] install-cli；用到 claude / codex / agy 却没装时，终端里先问要不要装）：用它们的官方安装脚本，和官网上的
# curl -fsSL … | bash 一样（脚本自己下载、校验，装进 ~/.local/bin）。先直连；拿不到安装脚本、或者直连没装成时，问过再经内置代理装：
# 另起一个临时的内核（cca 的 mihomo，只在 127.0.0.1 上开一个端口、只走安装用的节点；不碰在跑的内置代理和路由器），
# 装完就停，它的配置（有节点密钥）放在只有自己能读的临时目录里、用完删掉。安装用的节点由 Team 的配置指定（install_node），
# 定义是内置代理拿得到的那些（在家时从路由器拷的、Team 的配置带的、自定义节点）；没指定、这台机器没有它的定义时在终端里现选
# 一个（不记下）。安装脚本在空环境里运行（不带账号、代理设置和 API key）：claude install 用一次性的配置目录（不往账号和 ~/.claude 的
# 配置里写，不带设备标识；安装脚本只把下载的文件临时放在 ~/.claude/downloads），codex 不问问题；PATH 里有 ~/.local/bin，安装脚本不去
# 改 shell 的配置文件。实测（2026-11-12，经临时内核和一个 REALITY 节点）：codex 0.167.2、Claude Code 2.1.322 都装上了
# ---------------------------------------------------------------------------
install_get() {   # install_get 目标文件 [代理]：下载当前工具的官方安装脚本（只走 https，跳转也是）；拿到的不是脚本（比如出错的网页）算没拿到
	local -a via=(--proxy '' --noproxy '*')
	[ -z "${2:-}" ] || via=(--noproxy '' -x "$2")
	curl -q -fsSL --proto '=https' --proto-redir '=https' --max-redirs 5 --connect-timeout 10 -m 120 "${via[@]}" -o "$1" "$INSTALL_URL" 2>/dev/null &&
		[ "$(head -c 2 "$1" 2>/dev/null)" = '#!' ]
}
install_run() {   # install_run 安装脚本 临时目录 [代理]：在空环境里运行官方安装脚本，输出照样给用户看（走 stderr），返回它的退出码
	local run=/bin/sh
	local -a e=(PATH="$HOME/.local/bin:$PATH" HOME="$HOME" TMPDIR="$2" LANG=en_US.UTF-8 TERM="${TERM:-dumb}" "${INSTALL_ENV[@]}")
	[ "$INSTALL_SHELL" = sh ] || run="${BASH:-/bin/bash}"   # claude、agy 的是 bash 脚本
	[ -z "${3:-}" ] || e+=(HTTPS_PROXY="$3" https_proxy="$3" HTTP_PROXY="$3" http_proxy="$3" ALL_PROXY="$3" all_proxy="$3"
		NO_PROXY=localhost,127.0.0.1,::1 no_proxy=localhost,127.0.0.1,::1)
	env -i "${e[@]}" "$run" "$1" </dev/null >&2
}
install_proxy_up() {   # install_proxy_up 节点 临时目录：起一个只走这个节点的临时内核（install_once 的子 shell 里调：进程号记在 pid，端口在 INSTALL_PORT）
	local i why
	core_fetch || { warn "内置代理的内核没装上：${FETCH_ERR}"; return 1; }
	mkdir -p "$2/core" && INSTALL_PORT=$(py install-node proxy "$1" "$2/proxy.json") || return 1
	"$(core_bin)" -d "$2/core" -f "$2/proxy.json" >"$2/core.log" 2>&1 </dev/null &
	pid=$!
	for ((i = 0; i < 80; i++)); do   # 最多等 20 秒
		port_open 127.0.0.1 "$INSTALL_PORT" && return 0
		kill -0 "$pid" 2>/dev/null || break
		sleep 0.25
	done
	why=$(tail -n 1 "$2/core.log" 2>/dev/null | cut -c1-200)
	warn "经 ${1} 的临时代理没起来${why:+：${why}}"
	return 1
}
install_once() {   # install_once [节点]：下载、运行一次官方安装脚本，给了节点就经它的临时代理。0 安装脚本跑完了，3 拿不到安装脚本，4 安装脚本失败，5 临时代理没起来
	(
		tmp="" pid="" px=""
		trap '[ -z "$pid" ] || { kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null; }; [ -z "$tmp" ] || rm -rf "$tmp"' EXIT
		trap 'exit 130' INT TERM HUP
		tmp=$(mktemp -d "${TMPDIR:-/tmp}/cca-cli.XXXXXX") || exit 5
		eval "$(py install-env "$tmp")" || exit 5
		if [ -n "${1:-}" ]; then
			install_proxy_up "$1" "$tmp" || exit 5
			px="http://127.0.0.1:${INSTALL_PORT}"
			info "经内置代理的 ${1} 下载安装脚本 ${INSTALL_URL} …"
			retry3 install_get "$tmp/install.sh" "$px" || exit 3
		else
			info "直连下载安装脚本 ${INSTALL_URL} …"
			install_get "$tmp/install.sh" || exit 3
		fi
		install_run "$tmp/install.sh" "$tmp" "$px" || exit 4
		exit 0
	)
}
install_node_pick() {   # 打印经内置代理安装用的节点：Team 的配置指定的（返回 0）；没指定、这台机器没有它的定义时在终端里现选一个（返回 2，
	                     # 选了就是同意，不记下）；选不了、取消时返回 1
	local node rc n=0 def=0 sel
	local -a names
	node=$(py install-node get); rc=$?
	[ $rc = 0 ] && { printf '%s' "$node"; return 0; }
	[ $rc = 4 ] && warn "Team 的配置指定的安装节点 ${node} 在这台机器上没有定义（内置代理的节点定义来自在家时从路由器拷的可选节点、Team 的配置带的节点和自定义节点）"
	while IFS= read -r node; do [ -n "$node" ] && { names[n]="$node"; n=$((n + 1)); }; done < <(py install-node choices)
	if [ $n = 0 ]; then
		warn "这台机器的内置代理还没有节点定义：在家启动一次账号（会从路由器拷可选节点），或者用 cca node add 加一个自己的代理（有 Team 给你账号的话，加入那个 Team：它的配置带着节点，cca team join）之后再装"
		return 1
	fi
	interactive || { warn "没有指定安装用的节点（Team 的配置里的 install_node），要在终端里选一个：运行 ${CMD} install-cli"; return 1; }
	say "  经内置代理的哪个节点安装 ${TOOL}？（只用这一次）"
	if [ -n "$PROMPT_GUI" ]; then
		local -a opts=()
		for ((sel = 0; sel < n; sel++)); do opts[sel]="opt=$((sel + 1))"$'\t'"${names[sel]}"$'\t'; done
		sel=$(gui_ask choice "经内置代理的哪个节点安装 ${TOOL}？" 1 q=install.node label=节点 "${opts[@]}") || return 1
	elif fancy_ok; then
		arrow_menu "$def" "${names[@]}"
		[ "$MENU_PICK" -ge 0 ] || return 1
		sel=$((MENU_PICK + 1))
	else
		for ((sel = 0; sel < n; sel++)); do say "    $((sel + 1)). ${names[sel]}"; done
		sel=$(ask "  选择节点编号（回车取消）：" "")
	fi
	case "$sel" in ''|*[!0-9]*) return 1 ;; esac
	[ "$sel" -ge 1 ] && [ "$sel" -le $n ] || return 1
	printf '%s' "${names[sel - 1]}"
	return 2
}
install_found() {   # 安装脚本跑完之后：重新找命令，找到了说一声
	find_bins
	[ -n "$TOOL_BIN" ] || return 1
	okay "装好了 ${TOOL}：${TOOL_BIN}"
	case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) info "~/.local/bin 不在 PATH 里：cca 照样找得到它；要在终端里直接运行 ${TOOL}，把它加进 PATH" ;; esac
	return 0
}
tool_install() {   # tool_install [proxy]：用官方安装脚本装当前工具的命令（先直连，不行时问过再经内置代理装）。装好了返回 0（TOOL_BIN 等换成新装的）。
	               # proxy：已经知道直连不通（服务器上安装时测过、用户也同意了经内置代理装）：不再直连试，Team 的配置指定的节点也不另外问
	local rc why node via="${1:-}"
	say "  用官方安装脚本安装 ${TOOL}：${INSTALL_URL}（脚本自己下载、校验，装进 ~/.local/bin）"
	if [ -z "$via" ]; then
		install_once; rc=$?
		case $rc in   # 安装脚本跑完了却没找到命令：换个出口再跑一次也一样，不再经内置代理试
			0) install_found && return 0; warn "安装脚本跑完了，却没找到 ${TOOL} 命令：看上面安装脚本的输出"; return 1 ;;
			3) why="直连拿不到安装脚本" ;;
			130) return 1 ;;
			*) why="直连没装成" ;;
		esac
		warn "$why"
	fi
	node=$(install_node_pick); rc=$?
	case $rc in
		0) [ -n "$via" ] || consent install_proxy "$node" "经内置代理安装" "${why}。经内置代理的节点 ${node} 安装 ${TOOL} 吗？" \
			"会在本机临时起一个只走 ${node} 的代理端口，装完就停；安装脚本照样从官方地址下载、自己校验，不带账号和登录信息。" y ||
			{ info "没有安装 ${TOOL}（以后可以运行 ${CMD} install-cli）"; return 1; } ;;
		2) ;;   # 现选的：选了就是同意
		*) info "没有安装 ${TOOL}（以后可以运行 ${CMD} install-cli）"; return 1 ;;
	esac
	install_once "$node"; rc=$?
	case $rc in
		0) install_found && return 0; warn "安装脚本跑完了，却没找到 ${TOOL} 命令：看上面安装脚本的输出" ;;
		3) warn "经 ${node} 也拿不到安装脚本（${INSTALL_URL}）" ;;
		4) warn "经 ${node} 也没装成：看上面安装脚本的输出" ;;
	esac
	return 1
}
cmd_install_cli() {   # cca [codex|agy] install-cli：用官方安装脚本装 claude / codex / agy 命令（已经装了只说一声）
	[ $# -eq 0 ] || die "用法: ${CMD} install-cli"
	if [ -n "$TOOL_BIN" ]; then okay "已经装了 ${TOOL}：${TOOL_BIN}"; return 0; fi
	tool_install || exit 1
}

cmd_check() {   # cca check [账号…] [--json]：各账号的出口、纯净度，和 DNS / WebRTC 泄露（DNS 这次重新测，同一个节点的账号只测一次）
	local keys="" key ips="" rc host="" route="" since webrtc="" json="" rows="" nl=$'\n'   # rows：--json 时每个账号一行「键<TAB>health 的 JSON」
	local HEALTH_SOURCE=check   # 结果照样记进各账号的 health.json（来源写 check）
	while [ $# -gt 0 ]; do
		case "$1" in
			--json) json=1 ;;   # stdout 输出 JSON（格式见 macos/PROTOCOL.md），给人看的照旧写 stderr
			-h|--help) say "用法: ${CMD} check [账号…] [--json]（不写账号查全部）"; return 0 ;;
			-*) die "用法: ${CMD} check [账号…] [--json]" ;;
			*) key=$(py resolve "$1") || return 1; keys="${keys:+$keys$nl}$key" ;;
		esac
		shift
	done
	since=$(date +%s)
	[ -n "$keys" ] || keys=$(py keys)
	[ -n "$keys" ] || { info "还没有账号"; [ -z "$json" ] || py check-render "" </dev/null; return 0; }
	sync_if_changed   # 账号表可能刚按 Team 的配置改过：先让路由器跟上，测到的才是账号现在的出口
	# 账号列表从 fd 4 读：循环里要连路由器（ssh 会把 stdin 读走）、要问用户（interactive 看 fd 0 是不是终端）
	while IFS= read -r key <&4; do
		eval "$(py env "$key")" || continue
		if [ -n "$ACC_PORT" ] && [ -z "$route" ]; then   # 第一个走端口的账号：选好路
			load_router
			host="$PROXY_HOST" route=router
			if want_local; then   # 在外面：先让本机端口池就绪、切好节点
				load_local
				local_ready || FAIL_CODE=local_unavailable die "$(away_what)，内置代理也还没配置：运行 cca local setup"
				local_ensure || return 1
				[ -z "${LOCAL_UDP:-}" ] || udp_launch_check   # 和启动时一样：设了本机 UDP 走节点就让它开着（在家暂停过的再打开）
				host=127.0.0.1 route=local
			else
				router_ensure || return 1   # 和启动前一样：必须核实各槽位当前节点，不能只看端口开放
			fi
		fi
		ROUTE=direct HEALTH_JSON=""
		if [ -n "$ACC_PORT" ]; then
			ACC_PROXY="http://${host}:${ACC_PORT}" ROUTE="$route"
			if ! port_open "$host" "$ACC_PORT"; then
				say "  ${ACC_NAME}  ${ACC_NODE}  ${C_R}端口 ${ACC_PORT} 不通${C_0}"
				COFFEE_LINE="端口 ${host}:${ACC_PORT} 不通"
				health_note port_closed
				rows="$rows$ACC_KEY"$'\t'"$HEALTH_JSON"$'\n'
				continue
			fi
		fi
		if [ "$ACC_KIND" = api ]; then   # 第三方 API：只看接口连不连得上
			api_check
			say "  ${ACC_NAME}  ${ACC_NODE}${ACC_PORT:+  :${ACC_PORT}}  ${COFFEE_LINE}"
			rows="$rows$ACC_KEY"$'\t'"$HEALTH_JSON"$'\n'
			continue
		fi
		coffee_check "$since"
		rc=$?
		rows="$rows$ACC_KEY"$'\t'"$HEALTH_JSON"$'\n'
		case $rc in 0) ;; *) COFFEE_LINE="$COFFEE_LINE ${C_Y}(${COFFEE_NOTE//$'\n'/; })${C_0}" ;; esac
		say "  ${ACC_NAME}  ${ACC_NODE}  :${ACC_PORT}  ${COFFEE_LINE}"
		leak_show "      "
		[ -z "$LEAK_DNS" ] || warn "$LEAK_DNS"
		[ -z "$LEAK_WEBRTC" ] || webrtc="$LEAK_WEBRTC"   # 这台 Mac 上都一样：最后说一次
		[ -n "$COFFEE_IP" ] && ips="$ips$COFFEE_IP"$'\n'
	done 4<<< "$keys"
	local dup
	dup=$(printf '%s' "$ips" | sort | uniq -d)
	[ -n "$dup" ] && warn "有账号共用同一个出口 IP：$(echo $dup)"
	[ -z "$webrtc" ] || warn "$webrtc"
	[ -z "$json" ] || printf '%s' "$rows" | py check-render "$route"
	return 0
}

# 命令行会话的登记（图形界面据此知道这个账号在工作，见 py session-open）：先 trap 再登记，工具一退出马上删（早于任何输出，
# 关了终端写不了 stderr 也漏不掉）。登记不上也照常启动。cca 被 kill -9 留下的登记由下一次 session-open 清掉
session_open() { py session-open "$ACC_KEY" "$$" >/dev/null 2>&1; return 0; }
session_close() { rm -f "$ACC_DIR/cli-$$.json"; }

# 远程会话（docs/dev/remote.md）：开关开着（cca remote on，或者这一次 CCA_REMOTE=1；CCA_REMOTE=0 这一次不用）、又是在终端里
# 启动的，客户端就放进会话宿主里运行（辅助程序的 remote-host）：启动它的终端关了会话照样运行，别的终端能接进来。
# 结果在 HOSTCMD 里（加在客户端前面的那几个参数）；空的就照原样直接运行，一个字都不变。先 eval "$(py env 名称)"（CFG_REMOTE）
remote_prepare() {
	HOSTCMD=()
	case "${CCA_REMOTE:-${CFG_REMOTE:-}}" in 1) ;; *) return 0 ;; esac
	[ -z "${CCA_GUI:-}" ] && [ -t 0 ] && [ -t 1 ] || return 0
	[ -x "$HELPER" ] || helper_find || return 0
	HOSTCMD=("$HELPER" remote-host "$TOOL" "$ACC_KEY" "$ACC_NAME" --)
}
# 两台机器之间：一台 cca remote pair 显示配对码，另一台 cca remote join 输入；之后输入的那台能经服务器（配对时选的那个 Team 的，
# relay.rs 的 session_hub、home_hub）接入显示的那台上的会话（两头之间端到端加密，服务器只转字节）。配对表、对方能做什么
# （allow）、取消（unpair）都在辅助程序里
remote_pair_spec() {   # remote_pair_spec 配对码 [给手机的链接]：提问会话里显示配对码的那一页（给 py prompt-emit）。只显示、不用回答：配好了 cca 自己收场，
	                     # 不想配了 App 关掉答案管道（「取消」）。给了链接是和手机配对（题号 remote.pair_web）：多一个 kind 是 qr 的字段，
	                     # App 把链接（cca-remote://…，里面有服务器的地址、证书指纹和配对码）画成二维码，iPhone 上的 cca App 扫了就配对
	if [ -n "${2:-}" ]; then
		gui_kv "q=remote.pair_web" "title=和手机配对" "message=在 iPhone 上打开 cca App，点「扫码配对」扫这个二维码。10 分钟内有效，只能用一次。"
		gui_kv field=url kind=qr "label=用 iPhone 上的 cca App 扫" "hint=二维码里有配对码，扫了就配好，不用再输入" "value=$2"
		gui_kv field=code kind=code "label=配对码" "hint=正在等手机，配好以后这里自动完成"
	else
		gui_kv "q=remote.pair" "title=和另一台机器配对" "message=在另一台机器上输入这个配对码：cca App 的「远程会话」里点「输入配对码…」，或者在终端里运行 cca remote join。10 分钟内有效，只能用一次。"
		gui_kv field=code kind=code "label=配对码" "hint=正在等另一台机器输入，配好以后这里自动完成"
	fi
	printf 'code=%s\n' "$1"
}
remote_hub_args() {   # remote_hub_args 参数…：cca remote pair|join 的参数。在哪台服务器上配对放进 REMOTE_HUB（给辅助程序 --hub 的值：Team 的名字或者编号，
	                    # 没说是空的），有 --web 时 REMOTE_WEB 是 web。写错了回 1。
	                    # 每个 Team 的会话走这个 Team 自己的服务器中转：配对记在哪台服务器上，对方经它看得到的就是走那台服务器的会话
	REMOTE_HUB=""; REMOTE_WEB=""
	while [ $# -gt 0 ]; do
		case "$1" in
			--web) [ -z "$REMOTE_WEB" ] || return 1; REMOTE_WEB=web ;;
			--team) [ $# -ge 2 ] && [ -n "$2" ] && [ -z "$REMOTE_HUB" ] || return 1; REMOTE_HUB="$2"; shift ;;
			*) return 1 ;;
		esac
		shift
	done
}
remote_hub_label() {   # 给人看的：REMOTE_HUB 是谁的服务器。写的是编号时问辅助程序它叫什么。没说在哪台上时：这台机器用得了好几台的话是
	                     # 默认的那一台（辅助程序标着 home 的：加入的第一个 Team 的），只有一台时是空的
	local name rows
	case "$REMOTE_HUB" in
		"")
			rows=$(py remote-hubs 2>/dev/null)
			[ "$(printf '%s\n' "$rows" | grep -c .)" -gt 1 ] || return 0
			printf '%s\n' "$rows" | awk -F '\t' '$3 == "home" { print $2; exit }' ;;
		*)
			name=$(py remote-hubs 2>/dev/null | awk -F '\t' -v w="$REMOTE_HUB" '$1 == w { print $2; exit }')
			printf '%s' "${name:-「${REMOTE_HUB}」的服务器}" ;;
	esac
}
remote_need_hub() {   # 配对要经 Team 的服务器中转（3.6.0 起没有维护者的那一台了）：这台设备一台都用不了时先说清楚，不先问同意。
	                    # 原因照辅助程序说（和配对时一样：不在哪个 Team 里、Team 还没接上服务器、配置还没同步下来……）
	local why
	why=$(py remote-hubs --need 2>&1) && return 0
	die "${why:-远程会话经 Team 的服务器中转，这台机器现在一台都用不了}"
}
remote_pair_run() {   # remote_pair_run web|"" [--hub 服务器]：出一个配对码、等另一台机器输入；配好了把对方的名字放进 REMOTE_PEER，没配成把原因放进 REMOTE_ERR。
	                    # web：这次配对开给手机（iOS 上的 cca App；辅助程序多给一行 cca-remote:// 链接，App 里画成二维码）。后面的参数原样交给辅助程序。辅助程序在后台跑
	                    # （直接起它、不经 py：要拿到它自己的进程号。它的 stdout 先是“code 配对码”、配好以后是“peer 名字”，接到临时目录里
	                    # 只有自己能读的文件），这边先把配对码显示出来：终端里打印，提问会话里是一页（PROTOCOL 4.6 的 remote.pair）。
	                    # 中途不做了（Ctrl-C、App 取消：读答案读到头）要把辅助程序停掉——不然它会在后台把配对做完
	local dir pid i line code="" page="" seq rc
	REMOTE_PEER=""; REMOTE_ERR=""
	[ -x "$HELPER" ] || helper_find || { REMOTE_ERR="找不到 cca 的辅助程序"; return 1; }
	dir=$(mktemp -d "${TMPDIR:-/tmp}/cca-pair.XXXXXX") || { REMOTE_ERR="建不了临时目录"; return 1; }
	CCA_SELF="$SELF" CCA_TOOL="$TOOL" CCA_BIN="$TOOL_BIN" "$HELPER" remote-pair-show ${1:+--web} "${@:2}" > "$dir/out" 2> "$dir/err" 3<&- & pid=$!
	trap "kill -TERM $pid 2>/dev/null; rm -rf $(printf %q "$dir")" EXIT   # 现在就展开：EXIT 时函数的局部变量已经不在了
	trap 'exit 130' INT TERM HUP
	for ((i = 0; i < 600; i++)); do   # 等它在服务器上开好这次配对、给出配对码（两次请求）
		line=""; IFS= read -r line < "$dir/out" 2>/dev/null || true
		case "$line" in "code "*) code=${line#code }; break ;; esac
		kill -0 "$pid" 2>/dev/null || break
		sleep 0.1
	done
	if [ -n "$code" ] && [ -n "${1:-}" ]; then   # 给手机的链接是紧跟着配对码写出来的第二行（两行一起写的）
		{ IFS= read -r line; IFS= read -r line; } < "$dir/out" 2>/dev/null || true
		case "$line" in "link cca-remote://"*) page=${line#link } ;; esac
	fi
	if [ -n "$code" ]; then
		if [ -n "$PROMPT_GUI" ]; then
			seq=$(remote_pair_spec "$code" "$page" | py prompt-emit) || gui_abort
			# 这一页没有要回答的：一圈圈地等只为了 App 取消时（读到头）马上停下。等 2 秒一圈：bash 3.2 分不清“到时间了”和“读到头”，
			# gui_answer_wait 按等了多久分（整秒），1 秒一圈有可能看成读到头
			while kill -0 "$pid" 2>/dev/null; do gui_answer_wait "$seq" none 2 || true; done
		elif [ -n "$page" ]; then
			say "给手机的配对链接（里面有配对码 ${C_B}${code}${C_0}）："
			printf '%s\n' "$page" >&2
			say "  复制这一行，在 iPhone 上的 cca App 里点「粘贴配对链接」（同一个 Apple 账号的设备之间复制粘贴是通的）；"
			say "  有 cca App（Mac）的话，在「远程会话」里点「和手机配对…」扫二维码更方便。10 分钟内有效，只能用一次。正在等手机…（Ctrl-C 取消）"
		else
			say "配对码：${C_B}${code}${C_0}"
			say "  在另一台机器上输入它：运行 cca remote join，或者在 cca App 的「远程会话」里点「输入配对码…」"
			say "  10 分钟内有效，只能用一次。正在等对方输入…（Ctrl-C 取消）"
		fi
	fi
	wait "$pid"; rc=$?
	while IFS= read -r line; do case "$line" in "peer "*) REMOTE_PEER=${line#peer } ;; esac; done < "$dir/out"
	REMOTE_ERR=$(cat "$dir/err" 2>/dev/null)
	trap - EXIT INT TERM HUP
	rm -rf "$dir"
	[ $rc -eq 0 ] && [ -n "$REMOTE_PEER" ]
}
cmd_remote() {
	local rows n out code rc web="" via=""
	[ -f "$CFG" ] || die "还没安装：请先运行 $SELF install"
	case "${1:-status}" in
		on)
			py remote-set on || exit 1
			info "已打开：之后在终端里启动的会话放进会话宿主里运行，终端关了会话照样运行"
			say "  接回去：${C_B}cca remote attach${C_0}；看有哪些：cca remote list；关掉：cca remote off（只这一次不用：CCA_REMOTE=0 cca …）"
			gui_done remote_updated "远程会话已打开：之后在终端里启动的会话可以接入" ;;
		off)
			py remote-set off || exit 1
			info "已关闭：之后启动的会话照原样直接运行（已经开着的不受影响）"
			gui_done remote_updated "远程会话已关闭：已经开着的会话不受影响" ;;
		status)
			if [ "$(py get remote)" = True ]; then info "远程会话：开着（之后在终端里启动的会话可以重新接入；关掉：cca remote off）"
			else info "远程会话：没开（打开：cca remote on；只这一次：CCA_REMOTE=1 cca …）"; fi
			rows=$(py remote-list --local) || exit 1
			if [ -n "$rows" ]; then
				n=$(printf '%s\n' "$rows" | grep -c .)
				say "  这台机器上有 ${n} 个可以接入的会话（接入：cca remote attach 编号；结束：cca remote end 编号）："
				printf '%s\n' "$rows" | sed 's/^/    /' >&2
			fi
			rows=$(py remote-peers) || exit 1
			if [ -n "$rows" ]; then
				n=$(printf '%s\n' "$rows" | grep -c .)
				say "  配对过 ${n} 台机器（cca remote peers 看是哪些；连同它们上面的会话一起列：cca remote list）"
			fi ;;
		ls|list) shift; py remote-list "$@" ;;   # --json 是给界面 App 的（PROTOCOL 9.1）
		pair)   # 这台机器显示配对码：输入它的那台机器之后能接入这台机器上的会话，所以先问。--web：和手机配对
			      # （手机没有 cca：iPhone 上的 cca App 扫二维码或者粘贴链接；同意的范围是 web，和两台机器配对分开问）。
			      # --team 名字：在哪个 Team 的服务器上配对（不写是加入的第一个 Team 的）
			shift
			remote_hub_args "$@" || die "用法：cca remote pair [--web] [--team 名字]（--web：和手机配对，在 iPhone 上的 cca App 里接入；--team：在哪个 Team 的服务器上配对，对方看得到的是这个 Team 的账号的会话）"
			web=$REMOTE_WEB
			need_tty
			remote_need_hub
			via=$(remote_hub_label)
			[ -z "$via" ] || via="。这次配对记在${via}上：对方经它看得到的，是走这台服务器的会话（哪个 Team 的服务器，就是那个 Team 的账号的会话）$([ -n "$REMOTE_HUB" ] || printf '；要在别的 Team 的服务器上配对：--team 名字')"
			if [ -n "$web" ]; then
				out="iPhone 上的 cca App 扫了二维码（或者粘贴了链接）以后，那台手机可以看和操作这台机器上开着远程会话的会话（之后能改成只看或者不让：cca remote allow；取消配对：cca remote unpair）。终端的内容在手机和这台机器之间加密，中转服务器看不到${via}"
				rows="和手机配对"
			else
				out="在另一台机器上输入配对码以后，那台机器可以看和操作这台机器上开着远程会话的会话（之后能改成只看或者不让：cca remote allow；取消配对：cca remote unpair）${via}"
				rows="和另一台机器配对"
			fi
			[ -n "$PROMPT_GUI" ] || say "$out"   # 终端里的确认只有一句问话，先把后果说出来（图形界面的对话框里有这段说明）
			consent remote_pair "$web" "$rows" "显示配对码吗？" "$out" y || { say "已取消"; gui_cancelled; return 1; }
			remote_pair_run "$web" ${REMOTE_HUB:+--hub "$REMOTE_HUB"} || die "${REMOTE_ERR:-没有配对成}"
			out=$REMOTE_PEER
			okay "已经和「${out}」配对：它可以接入这台机器上开着远程会话的会话（cca remote on 之后启动的）"
			say "  只让它看：cca remote allow $(shq "$out") view；取消配对：cca remote unpair $(shq "$out")"
			gui_done remote_paired "已经和「${out}」配对：它可以接入这台机器上开着远程会话的会话" ;;
		join)   # 输入另一台机器显示的配对码（从 stdin 交给辅助程序，不进命令行）。配对码是在哪台服务器上开的，辅助程序自己挨个试得出来；
			      # --team 名字 是只在那个 Team 的服务器上找
			shift
			remote_hub_args "$@" && [ -z "$REMOTE_WEB" ] || die "用法：cca remote join [--team 名字]"
			need_tty
			remote_need_hub
			code=$(ask "另一台机器上显示的配对码: " "" q=remote.code "title=输入配对码" "label=配对码" \
				"message=配对码在另一台机器上：那边运行 cca remote pair，或者在 cca App 的「远程会话」里点「显示配对码…」。配好以后这台机器可以接入那台机器上的会话。" \
				"hint=16 个字母和数字，大小写、横线随意")
			[ -n "$code" ] || { say "已取消"; gui_cancelled; return 1; }
			out=$(printf '%s\n' "$code" | py remote-pair-join ${REMOTE_HUB:+--hub "$REMOTE_HUB"} 2>&1) || die "${out:-没有配对成}"
			okay "已经和「${out}」配对：这台机器可以接入它上面的会话（cca remote list 看有哪些，cca remote attach 接入）"
			say "  它接不进这台机器；要让它也能接入：cca remote allow $(shq "$out") control"
			gui_done remote_paired "已经和「${out}」配对：这台机器可以接入它上面的会话" ;;
		peers)
			rows=$(py remote-peers --check) || exit 1
			if [ -n "$rows" ]; then printf '%s\n' "$rows"
			else info "还没有配对过的机器（在要被接入的那台上运行 cca remote pair，在另一台上运行 cca remote join）"; fi ;;
		allow)
			[ $# -eq 3 ] || die "用法：cca remote allow 名字 control|view|none"
			case "$3" in control|view|none) ;; *) die "用法：cca remote allow 名字 control|view|none（control 看和操作，view 只看，none 不让接入）" ;; esac
			out=$(py remote-allow "$2" "$3" 2>&1) || die "${out:-没有改成}"
			case "$3" in
				control) rows="「${out}」可以看和操作这台机器上的会话" ;;
				view) rows="「${out}」只能看这台机器上的会话（正在操作的那一处几秒钟内断开，再接入就是只看）" ;;
				none) rows="「${out}」不能接入这台机器了（正接着的几秒钟内断开）" ;;
			esac
			okay "$rows"; gui_done remote_updated "$rows" ;;
		unpair)
			[ $# -eq 2 ] || die "用法：cca remote unpair 名字"
			out=$(py remote-unpair "$2" 2>&1) || die "${out:-没有取消成}"
			rows=""; case "$out" in *$'\n'*) rows=${out#*$'\n'}; out=${out%%$'\n'*} ;; esac   # 第二行：这台机器上取消了、服务器上的记录却没删掉时的说明
			[ -z "$rows" ] || warn "$rows"
			okay "已经取消和「${out}」的配对"; gui_done remote_updated "已经取消和「${out}」的配对" ;;
		attach)   # 一个普通的终端程序：直接换成辅助程序，中间不留 bash
			shift
			[ -x "$HELPER" ] || helper_find || exit 127
			CCA_SELF="$SELF" exec "$HELPER" remote-attach "$@" 3<&- ;;
		notify)   # 会话里的钩子（Claude Code 做完一轮、等着回答时）推一条通知给接着这个会话的别的机器：那边的终端、cca App 弹出来。
			        # 不在哪个会话宿主里时退出码 65、什么都不说（钩子每次都调它）；直接换成辅助程序，钩子等的时间短
			shift
			[ -x "$HELPER" ] || helper_find || exit 65
			exec "$HELPER" remote-notify "$@" 3<&- ;;
		end)   # 结束这台机器上的一个会话：等于关掉它的终端（里面的程序收到 SIGHUP，几秒钟还不退出就被强行结束），没保存的会丢，所以先问。
			     # 先让辅助程序找出是哪一个（只有一个时不用写编号；退出码 64 / 65 照 attach 的），同意是对着这一个会话的完整编号给的
			[ $# -le 2 ] || die "用法：cca remote end [会话编号]"
			out=$(py remote-end --show ${2:+"$2"} 2>/dev/null); rc=$?   # stdout 只有那一行数据；没找到时再问一遍要它说的原因（stderr）
			[ $rc -eq 0 ] || { out=$(py remote-end --show ${2:+"$2"} 2>&1 >/dev/null); gui_fail error "${out%%$'\n'*}"; printf '%s\n' "$out" >&2; exit $rc; }
			code=${out%%$'\t'*}; rows=${out#*$'\t'}
			[ -n "$PROMPT_GUI" ] || say "  ${rows}"
			consent remote_end "$code" "结束会话" "结束这个会话吗？" "${rows}。结束等于关掉它的终端：里面的程序收到通知后自己退出，几秒钟还不退出就被强行结束；它正在做的那一步会中断，接着的各处都断开。" n
			case $? in
				0) ;;
				1) info "没有结束"; gui_cancelled; return 1 ;;
				*) die "要先同意：在终端里运行 cca remote end ${code:0:8}（会先问你）" ;;
			esac
			out=$(py remote-end "$code" 2>&1) || die "${out:-没有结束成}"
			okay "会话 ${code:0:8} 已经结束"; gui_done remote_updated "会话已经结束" ;;
		*) die "用法：cca remote [status|on|off|list|attach [-r] [会话编号]|end [会话编号]|notify [--title 标题] [--subtitle 副标题] 正文|pair [--web] [--team 名字]|join [--team 名字]|peers|allow 名字 control|view|none|unpair 名字]" ;;
	esac
}

run_account() {
	local key="$1" rc e dropped bad pn
	shift
	need_bin
	[ "$TOOL" != agy ] || agy_guard   # 这个版本的 agy 确实把登录存进账号目录的文件，才能让各账号分开登录
	eval "$(py env "$key")" || die "读取账号失败: $key"
	key="$ACC_KEY"
	if [ "$ACC_KIND" = api ]; then
		# Claude：地址、模型和 apiKeyHelper 经 --settings 交给 claude，再传一个 --settings 会把它整个顶掉
		if [ "$TOOL" = claude ]; then
			case " $* " in *" --settings "*|*" --settings="*) die "${ACC_NAME} 是第三方 API 账号：cca 用 --settings 传它的地址和 key，不能再加 --settings" ;; esac
		fi
		api_key_ready || exit 1
	fi
	if ! bad=$(py launch-check "$@"); then settings_warn "$bad" -- "$@"; return 1; fi
	preflight || exit 1
	prepare_account "$key" || die "初始化账号目录失败"
	if ! bad=$(py launch-check "$@"); then settings_warn "$bad" -- "$@"; return 1; fi
	[ "$ACC_KIND" = api ] || ensure_login || exit 1
	pn=$(py set-last "$key")   # 顺带拿到横幅里套餐那一句（Claude Code 记的套餐过时了才有）
	say ""
	if [ "$ACC_KIND" = api ]; then
		say "  ${C_B}${ACC_NAME}${C_0}   ${C_D}第三方 API · ${ACC_BASE_URL}${ACC_MODEL:+ · ${ACC_MODEL}}${C_0}"
		say "  ${C_D}出口${C_0}  ${ACC_NODE}$([ -n "$ACC_PORT" ] && printf '（%s）' "$(route_note)") · ${COFFEE_LINE:-未检测}"
	else
		e=$LOGIN_EMAIL   # ensure_login 刚问过
		if [ -n "$ACC_EMAIL" ]; then e="已登录"; else e="已登录 ${e}"; fi
		if [ -n "$ACC_ALIAS" ] && [ -n "$ACC_EMAIL" ]; then
			say "  ${C_B}${ACC_ALIAS}${C_0}  ${ACC_EMAIL}   ${C_D}${e} · $(route_note)${C_0}"
		else
			say "  ${C_B}${ACC_NAME}${C_0}   ${C_D}${e} · $(route_note)${C_0}"
		fi
		if [ -n "$COFFEE_LINE" ]; then say "  ${C_D}出口${C_0}  ${ACC_NODE} · ${COFFEE_LINE}"
		else say "  ${C_D}出口${C_0}  ${ACC_NODE}（未检测）"; fi
		leak_show "  ${C_D}泄露${C_0}  "
		[ -z "$pn" ] || say "  ${C_D}套餐${C_0}  ${C_Y}${pn}${C_0}"
	fi
	say ""
	child_env
	if [ -n "$DROPPED" ]; then
		if [ "$ACC_KIND" = api ]; then warn "已为本次启动屏蔽环境里继承的 ${DROPPED}（这个账号的接口、key 和模型由 cca 设定）"
		else warn "已为本次启动屏蔽环境里继承的 ${DROPPED}（官方账号用它自己的登录；要换模型写进 ${TOOL_SETTINGS} 或用 /model）"; fi
	fi
	remote_prepare
	trap ':' INT TERM HUP
	session_open
	if [ ${#HOSTCMD[@]} -gt 0 ]; then   # 远程会话的开关开着：客户端跑在会话宿主里（它的退出码就是客户端的），别的都一样
		env "${UNSETS[@]}" "${SETS[@]}" "${HOSTCMD[@]}" "$TOOL_BIN" "${ACC_ARGS[@]}" "$@" 3<&-
	else
		env "${UNSETS[@]}" "${SETS[@]}" "$TOOL_BIN" "${ACC_ARGS[@]}" "$@" 3<&-
	fi
	rc=$?
	[ "$TOOL" != agy ] || py agy-session-end "$key" "$$" >/dev/null 2>&1   # 折合金额：记下这次运行用过哪些会话（辅助程序的 cost/agy.rs）
	session_close
	trap - INT TERM HUP
	py link "$key" cost >/dev/null || warn "退出后链接共享目录失败"
	py sync "$key" >/dev/null || warn "退出后同步 .claude.json 失败"
	e=$(py email "$key")
	if [ -n "$ACC_EMAIL" ] && [ -n "$e" ] && [ "$(lower "$e")" != "$(lower "$ACC_EMAIL")" ]; then
		warn "会话里切换成了 ${e}，和账号表里的 ${ACC_EMAIL} 不符；下次启动会要求改回"
	fi
	return $rc
}

sync_if_changed() {   # 账号表或路由器端脚本变了：先同步到路由器（需要重载但没获同意时照常继续）；在外面就等回家
	# 校验账号表、清掉钥匙串里直接改账号表删掉的第三方 API 账号的 key、算摘要，一个 py sync-state 做完（"这次的摘要<TAB>上次同步的"）
	local st
	if ! st=$({ router_sh; router_rb; } | py sync-state quiet); then   # 可能是路由器上的节点改了名（比如 Team 的配置已经换成新名字）：先跟上再校验
		if router_ready && at_home; then nodes_follow; fi
		st=$({ router_sh; router_rb; } | py sync-state) || FAIL_CODE=table_invalid die "账号表有错误：运行 ${CMD} edit 修正"
	fi
	if [ "${st%%	*}" != "${st#*	}" ]; then
		core_follow   # 本机的端口池：内置代理的内核在跑就马上跟上（和 router_sync_soon 一样；直接改了账号表文件、后台同步没做完时）
		router_needed || return 0   # 只有直连的第三方 API 账号、也没配置路由器：没有要同步的
		# 从来没配置过路由器，或者只用本机的客户端（cca 内置的代理）：没有路由器要同步，本机的端口池启动时配好
		if ! router_ready && { [ -z "$ROUTER_HOST" ] || [ -n "$LOCAL_SET" ]; }; then return 0; fi
		if router_ready && ! at_home; then
			info "账号表或路由器端脚本有变化：现在$(away_what)，回到家里的网络后再同步"
			return 0
		fi
		info "账号表或路由器端脚本有变化，先同步到路由器"
		router_sync
		case $? in 0|3) ;; *) FAIL_CODE=sync_failed die "同步失败，已停止（避免走错出口）" ;; esac
	fi
}

launch() {
	local sel=""
	if [ -z "$(py keys)" ]; then
		info "还没有账号，先新增一个"
		cmd_add || exit 1
		sel="$ADDED_KEY"
	fi
	sync_if_changed
	launchers_sync   # 只改别名时摘要不变，启动器的名字也要跟上
	if [ -n "${OPT_ACCOUNT:-}" ]; then
		sel=$(py resolve "$OPT_ACCOUNT") || exit 1
	elif [ -z "$sel" ]; then
		if interactive; then
			sel=$(menu) || exit 0
		else
			sel=$(py get last)
			[ -n "$sel" ] || sel=$(py keys | head -n 1)
		fi
	fi
	run_account "$sel" "$@"
}

# ---------------------------------------------------------------------------
# 订阅用量：每个官方账号经它自己的出口，让 Claude Code 自己查（get_usage 控制请求，token 由它读取和刷新，
# cca 不碰登录凭证）。几个账号并行查；查不到的显示上次的缓存（注明多久前）
# ---------------------------------------------------------------------------
usage_one() {   # 后台：查一个官方账号，结果写到 $1.json，跳过的原因写到 $1.skip；需要先 eval "$(py env 名称)" 并设好 ACC_PROXY。
	# 后面的参数是在账号的环境里经它的出口跑的 py 子命令（默认查用量：usage-query 工具 超时；重置额度用 reset-consume）
	local o="$1" e trace out rc
	shift
	[ $# -gt 0 ] || set -- usage-query "$TOOL_BIN" "${CCA_USAGE_TIMEOUT:-25}"
	e=$(py email "$ACC_KEY")
	if [ -z "$e" ]; then printf 'login\t\n' > "$o.skip"; return 0; fi
	if [ -n "$ACC_EMAIL" ] && [ "$(lower "$e")" != "$(lower "$ACC_EMAIL")" ]; then   # 登错号：不拿别的账号走这个出口
		printf 'mismatch\t%s\n' "$e" > "$o.skip"; return 0
	fi
	if [ -z "$ACC_PROXY" ]; then
		# 路由核验失败时不能带账号查询；只探测预期端口，保留端口确实关闭这一具体诊断。
		if [ -n "${USAGE_EXPECTED_HOST:-}" ] && ! port_open "$USAGE_EXPECTED_HOST" "$ACC_PORT"; then
			printf 'port\t%s\n' "$ACC_PORT" > "$o.skip"
		else
			printf 'route\t\n' > "$o.skip"
		fi
		return 0
	fi
	if ! port_open "$USAGE_HOST" "$ACC_PORT"; then printf 'port\t%s\n' "$ACC_PORT" > "$o.skip"; return 0; fi
	if [ -z "${CCA_SKIP_CHECK:-}" ]; then   # 出口在受限地区时不拿账号去查（和启动前的检测一样，只是不看纯净度）
		coffee_check region
		case $? in
			2) printf 'region\t%s\n' "$COFFEE_NOTE" > "$o.skip"; return 0 ;;
			3) printf 'trace\t\n' > "$o.skip"; return 0 ;;
		esac
	fi
	py device "$ACC_KEY" || return 1
	child_env
	env "${UNSETS[@]}" -u CLAUDECODE -u CLAUDE_CODE_ENTRYPOINT -u CLAUDE_CODE_SSE_PORT "${SETS[@]}" CCA_TOOL="$TOOL" \
		"$HELPER" "$@" > "$o.json" 2>/dev/null
}

usage_route() {   # 查用量、重置额度经哪台机器上的账号端口（USAGE_HOST）：本机 Clash 是 127.0.0.1，路由器是它的代理地址；
	# 走本机 Clash 而它用不了时返回 1（USAGE_HOST 是空的，经出口的查询会说连不上）
	USAGE_HOST="" USAGE_EXPECTED_HOST=""
	if want_local; then
		load_local
		local_ready && USAGE_EXPECTED_HOST=127.0.0.1 && local_ensure && USAGE_HOST=127.0.0.1 && return 0
		return 1
	fi
	USAGE_EXPECTED_HOST="$PROXY_HOST"
	router_ensure || return 1
	USAGE_HOST="$PROXY_HOST"
}

cmd_usage() {   # cca [codex] usage [账号…] [--json]（CCA_USAGE_JOBS：最多同时查几个，默认 4；App 自动刷新时是 2）
	local json="" q key i tmp rc bad color=""
	local -a keys=() pids=() wanted=()
	while [ $# -gt 0 ]; do
		case "$1" in
			--json) json=json ;;
			-h|--help) say "用法: ${CMD} usage [账号…] [--json]"; return 0 ;;
			-*) die "用法: ${CMD} usage [账号…] [--json]" ;;
			*) wanted+=("$1") ;;
		esac
		shift
	done
	need_bin
	[ "$TOOL" != agy ] || agy_guard   # agy 的额度由 agy 自己查（打印模式的 /usage）：它读的登录要是账号自己目录里的那一份
	if [ ${#wanted[@]} -gt 0 ]; then
		for q in "${wanted[@]}"; do
			key=$(py resolve "$q") || exit 1
			eval "$(py env "$key")"
			[ "$ACC_KIND" = api ] && die "${ACC_NAME} 是第三方 API 账号，没有订阅用量可查（用量看服务商的控制台）"
			keys+=("$key")
		done
	else
		while IFS= read -r key; do [ -n "$key" ] && keys+=("$key"); done < <(py keys official)
		[ ${#keys[@]} -gt 0 ] || { info "还没有官方账号（${CMD} add）"; return 0; }
	fi
	sync_if_changed
	if ! bad=$(py settings-check); then settings_warn "$bad"; return 1; fi
	usage_route || warn "账号出口未能核实：不发起查询，只显示上次的用量（检查路由器或本机 Clash 的账号端口池）"
	tmp=$(mktemp -d "$CCA_HOME/usage.XXXXXX") || die "建临时目录失败"
	# Ctrl-C、关掉终端：后台的查询忽略 SIGINT，要自己停掉它们（连同它们起的辅助程序、curl；claude、codex 的 stdin 一断也就退出了）。
	# 先停子进程：查询先停的话，它们的子进程就归到 1 号进程名下，按父进程找不到了
	trap 'kill_kids "${pids[@]}" 2>/dev/null; kill "${pids[@]}" 2>/dev/null; rm -rf "$tmp"; exit 130' INT TERM HUP
	[ -n "$json" ] || info "正在经各账号自己的出口查询用量（${#keys[@]} 个账号）…"
	for ((i = 0; i < ${#keys[@]}; i++)); do   # 同时查的不超过 CCA_USAGE_JOBS 个
		eval "$(py env "${keys[i]}")"
		ACC_PROXY="${USAGE_HOST:+http://${USAGE_HOST}:${ACC_PORT}}"
		usage_one "$tmp/$i" </dev/null 3<&- &
		pids+=($!)
		if [ ${#pids[@]} -ge "${CCA_USAGE_JOBS:-4}" ]; then wait "${pids[0]}"; pids=("${pids[@]:1}"); fi
	done
	wait
	trap - INT TERM HUP
	[ -t 1 ] && [ -z "${NO_COLOR:-}" ] && color=1
	py usage-render "$tmp" "${json:-table}" "$(term_cols)" "$color" "${keys[@]}"; rc=$?
	rm -rf "$tmp"
	return $rc
}

# ---------------------------------------------------------------------------
# 重置额度（ChatGPT 账号；codex 里 /usage 的 Redeem reset）：OpenAI 有时会给几次重置机会，用掉一次就把 5 小时和每周的
# 用量清零。先经账号自己的出口查还能重置几次（顺便存下用量），问过之后用掉最早过期的那一次，重置后再读一次用量；
# 用量还不需要重置时 OpenAI 不扣次数。图形界面：同意是 reset_credit:<账号目录名>，--json 输出 kind=reset 的文档
# ---------------------------------------------------------------------------
cmd_reset() {   # cca codex reset 账号 [--json]
	local json="" q="" key tmp bad l use="用法: ${CMD} reset 账号 [--json]"
	while [ $# -gt 0 ]; do
		case "$1" in
			--json) json=json ;;
			-h|--help) say "$use"; return 0 ;;
			-*) die "$use" ;;
			*) [ -z "$q" ] || die "$use"; q="$1" ;;
		esac
		shift
	done
	[ "$TOOL" = codex ] || die "只有 ChatGPT 账号能重置额度：cca codex reset 账号"
	[ -n "$q" ] || die "${use}（还能重置几次，${CMD} usage 的备注里也有）"
	need_bin
	key=$(py resolve "$q") || exit 1
	eval "$(py env "$key")"
	[ "$ACC_KIND" = api ] && FAIL_CODE=api_account die "${ACC_NAME} 是第三方 API 账号，没有额度可以重置"
	sync_if_changed
	if ! bad=$(py settings-check); then settings_warn "$bad"; return 1; fi
	usage_route || true   # 用不了时下面经出口的查询会说连不上
	ACC_PROXY="${USAGE_HOST:+http://${USAGE_HOST}:${ACC_PORT}}"
	tmp=$(mktemp -d "$CCA_HOME/usage.XXXXXX") || die "建临时目录失败"
	trap "rm -rf $(printf %q "$tmp")" EXIT   # 路径现在就展开：EXIT 时函数的局部变量已经不在了（die 退出时也是）
	[ -n "$json" ] || info "正在经 ${ACC_NAME} 自己的出口查还能重置几次…"
	usage_one "$tmp/0" </dev/null 3<&-
	eval "$(py reset-plan "$tmp" "$key")"
	[ -z "$RC_CODE" ] || FAIL_CODE="$RC_CODE" die "$RC_MSG"
	[ "$RC_COUNT" -gt 0 ] || FAIL_CODE=no_reset_credit die "${ACC_NAME} 没有能用的重置机会"
	if [ -z "$json" ]; then
		info "${ACC_NAME} 还能重置 ${RC_COUNT} 次额度：用掉一次就把 5 小时和每周的用量清零（用量还不需要重置时不扣次数）"
		[ -z "$RC_LIST" ] || printf '%s\n' "$RC_LIST" | while IFS= read -r l; do say "    · $l"; done
	fi
	consent reset_credit "$ACC_ID" "重置 ${ACC_NAME} 的额度" "现在用掉一次重置机会吗？" \
		"会用掉${RC_NEXT:+「${RC_NEXT}」这}一次（现在还剩 ${RC_COUNT} 次），把 5 小时和每周的用量清零。用量还不需要重置时不扣次数。" n
	case $? in
		0) ;;
		1) info "没有重置（还能重置 ${RC_COUNT} 次）"; return 0 ;;
		*) die "要先同意：在终端里运行 ${CMD} reset ${ACC_NAME}（会先问你）" ;;
	esac
	[ -n "$json" ] || info "正在重置…"
	usage_one "$tmp/1" reset-consume "$TOOL_BIN" "$RC_ID" "${CCA_USAGE_TIMEOUT:-25}" </dev/null 3<&-
	eval "$(py reset-done "$tmp" "$key" "$json" "$RC_ID")"
	[ -z "$RC_CODE" ] || FAIL_CODE="$RC_CODE" die "$RC_MSG"
	if [ "$RC_OUTCOME" = nothing_to_reset ]; then info "$RC_MSG"; else okay "$RC_MSG"; fi
	[ -z "$json" ] || printf '%s\n' "$RC_DOC"
}

# ---------------------------------------------------------------------------
# 自动更新：GitHub Releases 上的 cca + cca.sig，只装签名有效、版本号更新的脚本
#   · 启动时：有已经下载校验好的新版本（cca.next）就换上，并用新版本重新执行这次命令
#   · 距上次检查超过一天：在脱离终端的新会话里后台检查和下载，不拖慢启动，Ctrl-C 也打断不了它
#   · cca 就在 git 仓库根目录里（开发用的工作区）时不自动更新，免得覆盖还没发布的改动
# ---------------------------------------------------------------------------
UPD="$CCA_HOME/update"

# 版本号：正式版 2.6.0；测试版 2.6.0-beta.1（GitHub 上是 pre-release：releases/latest 不指向它，所以自动更新、一键安装
# 都不会装它，只能 cca update 版本号 手动装）。同一个版本号的测试版比正式版旧，测试版之间比 beta 后面的数
is_ver() { [[ "$1" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-beta\.[0-9]+)?$ ]]; }
ver_of() { sed -n 's/^VERSION="\([0-9][0-9a-z.-]*\)"$/\1/p' "$1" | head -n 1; }   # 脚本文件里的版本号
ver_gt() {   # ver_gt 2.10.0 2.9.1 → 真；ver_gt 2.6.0 2.6.0-beta.2 → 真
	local IFS=. i x=999999 y=999999
	local -a a b
	a=(${1%%-*})
	b=(${2%%-*})
	for ((i = 0; i < 3; i++)); do
		[ "${a[i]}" -gt "${b[i]}" ] && return 0
		[ "${a[i]}" -lt "${b[i]}" ] && return 1
	done
	case "$1" in *-beta.*) x="${1##*-beta.}" ;; esac
	case "$2" in *-beta.*) y="${2##*-beta.}" ;; esac
	[ "$x" -gt "$y" ]
}
dev_mode() { [ -e "${SELF%/*}/.git" ]; }

verify_release() {   # verify_release 脚本 签名：签名有效、语法正确时打印脚本里的版本号
	local v
	mkdir -p "$UPD" && printf 'cca-release %s\n' "$RELEASE_KEY" > "$UPD/allowed_signers" || return 1
	ssh-keygen -Y verify -f "$UPD/allowed_signers" -I cca-release -n cca-release -s "$2" < "$1" >/dev/null 2>&1 || return 1
	"$BASH" -n "$1" 2>/dev/null || return 1
	v=$(ver_of "$1")
	is_ver "$v" && printf '%s' "$v"
}

retry3() { "$@" && return 0; sleep "${CCA_RETRY_WAIT:-2}"; "$@" && return 0; sleep "${CCA_RETRY_WAIT:-2}"; "$@"; }   # 有的网络偶尔会丢新连接（两次之间等 CCA_RETRY_WAIT 秒，默认 2；测试里是 0）

latest_version() {   # releases/latest 会 302 到 …/releases/tag/vX.Y.Z（只指向正式版，不指向测试版）
	local u
	u=$(retry3 curl -fsS -o /dev/null -m 15 -w '%{redirect_url}' "$UPDATE_REPO/releases/latest" 2>/dev/null) || return 1
	u="${u##*/tag/v}"
	is_ver "$u" && printf '%s' "$u"
}

fetch_release() {   # fetch_release 版本：下载并校验，成功后放在 $UPD/cca.next；失败原因在 FETCH_ERR
	local v="$1" tmp got rc=1
	FETCH_ERR="下载失败（网络不通、GitHub 暂时不可用，或者没有这个版本）"
	mkdir -p "$UPD" && tmp=$(mktemp -d "$UPD/dl.XXXXXX") || return 1
	if retry3 curl -fsSL -m 300 -o "$tmp/cca" "$UPDATE_REPO/releases/download/v$v/cca" 2>/dev/null &&
		retry3 curl -fsSL -m 30 -o "$tmp/cca.sig" "$UPDATE_REPO/releases/download/v$v/cca.sig" 2>/dev/null; then
		FETCH_ERR="签名校验没通过（文件可能被篡改或不完整），没有安装"
		if got=$(verify_release "$tmp/cca" "$tmp/cca.sig") && [ "$got" = "$v" ]; then
			mv -f "$tmp/cca.sig" "$UPD/cca.next.sig" && mv -f "$tmp/cca" "$UPD/cca.next" && rc=0
		fi
	fi
	rm -rf "$tmp"
	return $rc
}

# 再校验一次 cca.next，然后原子替换当前脚本。bash 是边读边执行脚本的，原地覆盖会让正在运行的 cca
# 读到半截新代码；mv 换上的是新文件，正在运行的 cca 还读着旧文件。旧版本留着，可以 cca update --rollback
install_next() {
	local v tmp="$SELF.new.$$"
	if ! v=$(verify_release "$UPD/cca.next" "$UPD/cca.next.sig") || ! ver_gt "$v" "$VERSION"; then
		rm -f "$UPD/cca.next" "$UPD/cca.next.sig"
		return 1
	fi
	if ! { cp -p "$SELF" "$UPD/cca.prev" && printf '%s\n' "$VERSION" > "$UPD/cca.prev.version" &&
		cp "$UPD/cca.next" "$tmp" && chmod 755 "$tmp" && mv -f "$tmp" "$SELF"; }; then
		rm -f "$tmp"
		warn "替换 $SELF 失败，没有更新"
		return 1
	fi
	rm -f "$UPD/cca.next" "$UPD/cca.next.sig"
	NEW_VERSION="$v"
}

update_hook() {   # 启动时调用，参数是这次命令的参数
	local mode v
	dev_mode && return 0
	mode=$(py get update)
	[ "$mode" = off ] && return 0
	if [ -f "$UPD/cca.next" ]; then
		if [ "$mode" = auto ]; then
			if install_next; then
				info "cca 已自动更新：${VERSION} → ${NEW_VERSION}（不想要这个版本：cca update --rollback）"
				exec "$SELF" "$@"
			fi
		else
			v=$(ver_of "$UPD/cca.next")
			info "cca 有新版本 ${v}（当前 ${VERSION}），运行 cca update 安装"
		fi
	fi
	if [ -z "$(find "$UPD/checked" -mmin -1440 2>/dev/null)" ]; then
		mkdir -p "$UPD" && touch "$UPD/checked"
		( perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' "$SELF" _update-fetch </dev/null >"$UPD/log" 2>&1 3<&- & )
	fi
	return 0
}

update_after() {   # 启动时（update_hook 之后、team_hook 之前）：换了版本以后的第一条命令，各个 Team 同步配置这次不等间隔（不然最长要等
	# 一个小时）——在 Team 里的马上在后台同步一次。
	# 自动更新、cca update、一键安装再装一次都留着上一个版本（update/cca.prev.version），全新安装的没有：不算换了版本。
	# update/ran 记着上一次运行的版本；开发模式不自动更新，也就没有「更新后」
	local ran=""
	dev_mode && return 0
	[ ! -f "$UPD/ran" ] || read -r ran < "$UPD/ran"
	[ "$ran" != "$VERSION" ] || return 0
	mkdir -p "$UPD" && printf '%s\n' "$VERSION" > "$UPD/ran" || return 0
	[ -n "$ran" ] || [ -f "$UPD/cca.prev.version" ] || return 0
	rm -f "$CCA_HOME/teams/checked"
}

cmd_update_fetch() {   # 后台任务：有新版本就下载校验好，下次启动时换上
	local v
	mkdir -p "$UPD" || return 1
	[ -n "$(find "$UPD/lock" -maxdepth 0 -mmin +30 2>/dev/null)" ] && rmdir "$UPD/lock"   # 上次异常退出留下的锁
	mkdir "$UPD/lock" 2>/dev/null || return 0
	trap 'rmdir "$UPD/lock" 2>/dev/null' EXIT
	echo "$(date '+%F %T') 检查更新，当前 ${VERSION}"
	v=$(latest_version) || { echo "拿不到最新版本号"; return 1; }
	if ! ver_gt "$v" "$VERSION"; then echo "已是最新（${v}）"; return 0; fi
	if [ "$v" = "$(cat "$UPD/skip" 2>/dev/null)" ]; then echo "${v} 被回退过，不再自动安装"; return 0; fi
	if fetch_release "$v"; then echo "已下载并校验 ${v}，下次启动时安装"; else echo "${v}：${FETCH_ERR}"; return 1; fi
}

update_rollback() {
	local pv tmp="$SELF.new.$$"
	dev_mode && die "开发模式：用 git 切换版本"
	[ -f "$UPD/cca.prev" ] || die "没有可以退回的版本"
	pv=$(cat "$UPD/cca.prev.version" 2>/dev/null)
	"$BASH" -n "$UPD/cca.prev" 2>/dev/null || die "旧版本文件损坏，没有退回"
	cp "$UPD/cca.prev" "$tmp" && chmod 755 "$tmp" && mv -f "$tmp" "$SELF" || { rm -f "$tmp"; die "退回失败"; }
	printf '%s\n' "$VERSION" > "$UPD/skip"
	rm -f "$UPD/cca.prev" "$UPD/cca.prev.version" "$UPD/cca.next" "$UPD/cca.next.sig"
	okay "已退回 ${pv:-上一个版本}；${VERSION} 不会再自动安装，有更新的版本时照常更新"
}

update_releases() {   # GitHub 上最近的发布（api.github.com 的列表，JSON，包括测试版）；拿不到（连不上、被限流）时什么都不输出
	local out
	out=$(retry3 curl -fsSL -m 15 -H 'Accept: application/vnd.github+json' \
		"https://api.github.com/repos/${UPDATE_REPO#https://github.com/}/releases?per_page=30" 2>/dev/null) || return 0
	case "$out" in '['*) printf '%s' "$out" ;; esac
}

update_check() {   # cca update --check [--json]：只检查不安装。按现在的版本挑：测试版上也看更新的测试版（只是告诉你，
	# 自动更新照旧只装正式版）。--json 给图形界面（macos/PROTOCOL.md 5.1），stdout 只有 JSON
	local json="${1:-}" fb out
	[ -n "$json" ] || info "正在检查最新版本（${UPDATE_REPO}）…"
	# 列表拿不到、里面没有能装的版本：退回 releases/latest（只看得到正式版、没有更新说明）
	out=$(update_releases | py update-check "$VERSION" "$json" "" "$UPDATE_REPO") ||
		{ fb=$(latest_version) && out=$(py update-check "$VERSION" "$json" "$fb" "$UPDATE_REPO" </dev/null); } ||
		die "拿不到最新版本号（网络不通，或 GitHub 暂时不可用）"
	if [ -n "$json" ]; then printf '%s\n' "$out"; return 0; fi
	eval "$out"
	if [ -z "$UP_AVAILABLE" ]; then okay "已是最新版本 ${VERSION}"; return 0; fi
	if [ -n "$UP_BETA" ]; then info "有新的测试版 ${UP_LATEST}（当前 ${VERSION}），运行 cca update ${UP_LATEST} 安装"
	else info "有新版本 ${UP_LATEST}（当前 ${VERSION}），运行 cca update 安装"; fi
	[ -z "$UP_NOTES" ] || printf '%s\n' "$UP_NOTES" | LC_ALL=C sed 's/^/  │ /' >&2
}

client_update_py() {   # 客户端更新独立于账号准备和 cca 自身更新；验签器只使用本机 cca GUI
	local verifier="" app="$GUI_APP"
	if [ "$1" = check ] || [ "$1" = install ]; then
		if dev_mode; then app="${SELF%/*}/macos/build/cca.app"; fi
		if gui_ours "$app" && [ "$(gui_plist "$app" CCAClientUpdateVerifier)" = 1 ] && [ -x "$app/Contents/MacOS/cca" ] &&
			codesign --verify --strict "$app" >/dev/null 2>&1; then
			verifier="$app/Contents/MacOS/cca"
		fi
	fi
	CCA_CLIENT_CLAUDE_APP="$(claude_app_path)" CCA_CLIENT_CODEX_APP="$(codex_app_path)" CCA_CLIENT_VERIFIER="$verifier" \
		CCA_CLI_CLAUDE="$CLAUDE_BIN" CCA_CLI_CODEX="$CODEX_BIN" CCA_CLI_AGY="$AGY_BIN" py client-updates "$@"
}

cmd_clients() {   # cca clients status|check [--force]|mode auto|off|auto-install on|off|install TOKEN [--json]
	# auto-install on：允许自动更新（检查完马上装，桌面客户端开着时等它退出；打开它就是同意，不再一个个问）
	local action="${1:-status}" arg="" json="" out rc plan CU_VERSION CU_INSTALLED CU_TARGET CU_LABEL CU_NOTE
	[ $# -eq 0 ] || shift
	case "$action" in
		status) ;;
		check) ;;
		mode|install|auto-install) arg="${1:-}"; [ $# -eq 0 ] || shift ;;
		*) die "用法: cca clients status|check [--force]|mode auto|off|auto-install on|off|install TOKEN [--json]" ;;
	esac
	while [ $# -gt 0 ]; do
		case "$1" in
			--json) json=1 ;;
			--force) [ "$action" = check ] || die "--force 只用于检查客户端更新"; arg=force ;;
			*) die "不认识的客户端更新参数: $1" ;;
		esac
		shift
	done
	case "$action" in
		mode) case "$arg" in auto|off) ;; *) die "用法: cca clients mode auto|off [--json]" ;; esac ;;
		auto-install) case "$arg" in on|off) ;; *) die "用法: cca clients auto-install on|off [--json]" ;; esac ;;
		install)
			[[ "$arg" =~ ^[0-9a-f]{64}$ ]] || die "安装凭据无效，请重新检查客户端更新"
			plan=$(client_update_py plan "$arg") || return 1
			eval "$plan"
			consent client_update "$arg" "安装 ${CU_LABEL} 更新" "将 ${CU_LABEL} 从 ${CU_INSTALLED} 更新到 ${CU_VERSION} 吗？" \
				"${CU_NOTE:-目标：${CU_TARGET}。请先退出所有 ${CU_LABEL} 实例；安装前会重新验证签名和当前版本，目标改变时停止。}" n ||
				{ rc=$?; [ "$rc" = 2 ] && fail_warn confirmation_required "安装客户端更新需要确认"; return "$rc"; } ;;
	esac
	out=$(client_update_py "$action" "$arg"); rc=$?
	if [ -n "$out" ]; then
		if [ -n "$json" ]; then printf '%s\n' "$out"
		else
			printf '%s\n' "$out" | "$HELPER" sh-clients-text
		fi
	fi
	return "$rc"
}

cmd_update() {   # cca update [版本号 | --check [--json] | --rollback | auto | notify | off]
	local v want=""
	case "${1:-}" in
		auto|notify|off)
			py set update "$1" || return 1
			case "$1" in
				auto) okay "自动更新：每天检查，有新版本就在下次启动时安装" ;;
				notify) okay "自动更新：每天检查，有新版本只提示，运行 cca update 才安装" ;;
				off) okay "自动更新已关闭（cca update 仍可手动更新）" ;;
			esac
			return 0 ;;
		--rollback) update_rollback; return ;;
		--check) update_check "$([ "${2:-}" = --json ] && echo json)"; return ;;   # 开发模式下也能查
		'') ;;
		*) want="${1#[vV]}"   # 手动装指定的版本，例如测试版 2.6.0-beta.1（照 GitHub 上 tag 的样子写成 v2.6.0-beta.1 也认）
		   is_ver "$want" || die "用法: cca update [版本号 | --check | --rollback | auto | notify | off]" ;;
	esac
	if dev_mode; then
		info "开发模式：${SELF} 在 git 仓库里，用 git pull 更新"
		return 0
	fi
	if [ -n "$want" ]; then
		ver_gt "$want" "$VERSION" || die "${want} 不比现在的 ${VERSION} 新（要退回上一个版本：cca update --rollback）"
		info "正在下载 ${want}（${UPDATE_REPO}）…"
		v="$want"
	else
		info "正在检查最新版本（${UPDATE_REPO}）…"
		v=$(latest_version) || die "拿不到最新版本号（网络不通，或 GitHub 暂时不可用）"
		if ! ver_gt "$v" "$VERSION"; then okay "已是最新版本 ${VERSION}"; return 0; fi
	fi
	fetch_release "$v" || die "${v}：${FETCH_ERR}"
	install_next || die "安装 ${v} 失败"
	rm -f "$UPD/skip"
	okay "已更新到 ${NEW_VERSION}（原来是 ${VERSION}）。更新说明：${UPDATE_REPO}/releases/tag/v${NEW_VERSION}"
	case "$NEW_VERSION" in
		*-beta.*) info "这是测试版：不会自动更新到别的测试版，出了更新的正式版时照常自动更新；退回原来的版本：cca update --rollback" ;;
	esac
	info "路由器端脚本如果有变化，下次启动时会自动同步"
}

# ---------------------------------------------------------------------------
# 图形界面（cca App，源码在 macos/）：cca _gui hello|state|live 是给它用的只读接口（JSON，格式见 macos/PROTOCOL.md），
# 会改东西的照旧用 cca app / web / check / usage / router sync / rename / codex reset / update，加上 CCA_EVENTS（事件）和 CCA_GRANT
# （用户在 App 里点过的同意）；检查更新是 cca update --check --json。添加账号、换 key、删除账号走提问会话（CCA_PROMPT=1，fd 3 是答案管道）。
# cca gui 安装、更新、打开它：App 和 cca 同一个版本号，每个版本的 Release 附带 cca-app.zip 和签名（命名空间 cca-app，
# 和 cca 本身的 cca-release 分开）。curl 下载的文件没有隔离标记，临时签名的 App 不会被 Gatekeeper 拦（用浏览器下载就会）
# ---------------------------------------------------------------------------
GUI_API=1   # 删字段、改含义时才加一（App 声明自己支持的范围）
GUI_PROMPT=1   # 提问会话的版本（macos/PROTOCOL.md 4.6）：ask 事件、答案格式改了才加一
GUI_ID=local.cca.app
GUI_APP="${CCA_GUI_APP:-$HOME/Applications/cca.app}"
GUI_DIR="$CCA_HOME/gui"   # next/cca.app：下载校验好、等 App 退出后再换上的版本；enabled：装过 App（自动更新时跟着更新）；lock
LSREGISTER=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
gui_plist() { plutil -extract "$2" raw "$1/Contents/Info.plist" 2>/dev/null; }   # gui_plist App 键
gui_ours() { [ "$(gui_plist "$1" CFBundleIdentifier)" = "$GUI_ID" ]; }
gui_ver() { gui_plist "$1" CFBundleShortVersionString; }
gui_staged() { [ "$(gui_ver "$GUI_DIR/next/cca.app")" = "$VERSION" ]; }   # 和 cca 同版本的已经下载好、放着了
gui_running() { pgrep -f "$GUI_APP/Contents/MacOS/cca( |\$)" >/dev/null 2>&1; }
gui_open() { open "$@" --args --window; }   # 打开 App 并显示主窗口（它平时在后台，只有菜单栏图标）；已经开着时 open 不传参数，App 收到“重新打开”，同样显示主窗口
gui_lock() {   # gui_lock [最多等几秒，默认 120]：前台的 cca gui 和后台的 _gui-fetch 不同时下载、换 App
	local i n=$(( ${1:-120} * 4 ))
	mkdir -p "$GUI_DIR" || return 1
	[ -n "$(find "$GUI_DIR/lock" -maxdepth 0 -mmin +30 2>/dev/null)" ] && rmdir "$GUI_DIR/lock"   # 上次异常退出留下的锁
	for ((i = 0; ; i++)); do
		mkdir "$GUI_DIR/lock" 2>/dev/null && return 0
		[ $i -lt $n ] || return 1
		sleep 0.25
	done
}
gui_unlock() { rmdir "$GUI_DIR/lock" 2>/dev/null; return 0; }
wait_pid() { local i; for i in $(seq 1 240); do kill -0 "$1" 2>/dev/null || return 0; sleep 0.25; done; return 1; }   # 最多等 60 秒

cmd_gui_api() {   # cca _gui hello|state|live|mail-list（不经过自动更新和 Team 的同步，不写文件）
	case "${1:-}" in
		hello) gui_hello ;;
		state) gui_state ;;
		live) gui_live ;;
		mail-list) shift; gui_mail_list "$@" ;;
		*) die "用法: cca _gui hello|state|live|mail-list" ;;
	esac
}
gui_mail_list() {   # 账号页的登录邮件列表（按需，像 _gui live 那样实时连 Gmail；只读，CCA_RO=1）：cca _gui mail-list [--account 键] [小时]
	local acct="" hours="24"
	while [ $# -gt 0 ]; do
		case "$1" in
			--account) acct="${2:-}"; shift 2 ;;
			--account=*) acct="${1#--account=}"; shift ;;
			*) hours="$1"; shift ;;
		esac
	done
	[ -f "$CFG" ] || die "还没安装：请在终端里运行 $SELF install"
	CCA_RO=1 py gui-mail-list "$acct" "$hours"
}
gui_hello() {
	local inst=false dev=false cx=false ag=false av="" sv=""
	[ -f "$CFG" ] && inst=true
	dev_mode && dev=true
	[ -f "$CCA_HOME/codex.json" ] && cx=true
	[ -f "$CCA_HOME/agy.json" ] && ag=true
	gui_ours "$GUI_APP" && av=$(gui_ver "$GUI_APP")
	sv=$(gui_ver "$GUI_DIR/next/cca.app")
	printf '{"version":1,"kind":"hello","api":%s,"prompt":%s,"reorder":1,"forms":1,"dock":1,"install_cli":1,"cost":1,"mail":1,"remote":1,"remote_end":1,"remote_web":1,"team":1,"team_config":1,"cca_version":%s,"dev_mode":%s,"installed":%s,"self":%s,"home":%s,' \
		"$GUI_API" "$GUI_PROMPT" "$(jstr "$VERSION")" "$dev" "$inst" "$(jstr "$SELF")" "$(jstr "$CCA_HOME")"
	printf '"tools":{"claude":{"enabled":true,"bin":%s},"codex":{"enabled":%s,"bin":%s},"agy":{"enabled":%s,"bin":%s}},' \
		"$(jopt "$CLAUDE_BIN")" "$cx" "$(jopt "$CODEX_BIN")" "$ag" "$(jopt "$AGY_BIN")"
	printf '"gui":{"app":%s,"app_version":%s,"staged_version":%s}}\n' "$(jstr "$GUI_APP")" "$(jopt "$av")" "$(jopt "$sv")"
}
gui_state() {   # bash 才知道的（找到的命令、App、Chrome）经环境变量交给 py gui-state；stdin 是路由器端代码（算同步摘要）
	[ -f "$CFG" ] || die "还没安装：请在终端里运行 $SELF install"
	{ router_sh; router_rb; } | CCA_RO=1 CCA_VERSION="$VERSION" CCA_GUI_CLAUDE_BIN="$CLAUDE_BIN" CCA_GUI_CODEX_BIN="$CODEX_BIN" \
		CCA_GUI_AGY_BIN="$AGY_BIN" CCA_GUI_CLAUDE_APP="$(claude_app_path)" CCA_GUI_CODEX_APP="$(codex_app_path)" \
		CCA_GUI_CHROME="$(has_chrome && echo 1)" py gui-state
}
gui_live() {   # 端口池的实况：在家看路由器（经 SSH 跑这一版 router_sh 的 status，不依赖路由器上部署的版本），在外面看内置代理
	local route=none out="" rc=0 host="" g p node who
	[ -f "$CFG" ] || die "还没安装：请在终端里运行 $SELF install"
	export CCA_RO=1
	load_router
	load_local
	[ -z "$ROUTER_HOST" ] || at_home   # 先探测一次（1 秒），结果在 AT_HOME
	if want_local; then
		if local_ready || core_possible; then route=local; elif [ -n "$ROUTER_HOST" ]; then route=router; fi   # 在外面默认看内置代理（没配置也显示，引导去配）；这台机器用不了内置代理时才退回看路由器
	elif [ -n "$ROUTER_HOST" ]; then
		route=router
	fi
	case "$route" in
		router)
			host="$PROXY_HOST"
			if [ "${ROUTER_REACH:-}" = yes ]; then   # 只经虚拟网卡连得到（不算在家）也照样看：设成只走路由器时账号就经它
				if router_ready; then
					out=$(router_sh | rsh 'sh -s status' 2>&1); rc=$?   # 脚本从管道进 ssh 的 stdin（别再接 /dev/null）
				else
					out="找不到连路由器用的 SSH 密钥 ${ROUTER_KEY}" rc=254
				fi
			fi ;;
		local)
			host=127.0.0.1
			lctl GET /version
			out="V"$'\t'"$LCODE"
			if [ "$LCODE" = 200 ]; then
				while IFS=$'\t' read -r g p node who; do
					lctl GET "/proxies/$g"
					out="$out"$'\n'"G"$'\t'"${g}"$'\t'"${LCODE}"$'\t'"$([ "$LCODE" = 200 ] && json_get now)"
				done < <(py slot-rows)
			fi ;;
	esac
	printf '%s\n' "$out" | py gui-live "$route" "$host" "$rc" "${AT_HOME:-no}" "${ROUTER_REACH:-no}"
}

gui_os_major() { local v; v=$(sw_vers -productVersion 2>/dev/null); printf '%s' "${CCA_GUI_OS:-${v%%.*}}"; }
gui_os_ok() { [ "$(gui_os_major)" -ge 26 ] 2>/dev/null; }   # 界面 App 要 macOS 26 或更新（Liquid Glass）
gui_supported() {
	local v
	gui_os_ok && return 0
	v=$(gui_os_major)
	warn "界面 App 要 macOS 26 或更新（这台 Mac 是 macOS ${v:-?}）"
	return 1
}
gui_fetch() {   # gui_fetch 版本 目录：下载和这个版本号相同的 App，校验签名和内容，解开在 目录/x/cca.app；失败原因在 FETCH_ERR
	local v="$1" d="$2" f url="$UPDATE_REPO/releases/download/v$1"
	FETCH_ERR="下载失败（网络不通、GitHub 暂时不可用，或者 ${v} 没有附带界面 App）"
	for f in cca-app.zip cca-app.zip.sig; do
		retry3 curl -fsSL -m 300 -o "$d/$f" "$url/$f" 2>/dev/null || return 1
	done
	printf 'cca-app %s\n' "$RELEASE_KEY" > "$d/allowed"
	FETCH_ERR="签名校验没通过（文件可能被篡改或不完整），没有安装"
	ssh-keygen -Y verify -f "$d/allowed" -I cca-app -n cca-app -s "$d/cca-app.zip.sig" < "$d/cca-app.zip" >/dev/null 2>&1 || return 1
	FETCH_ERR="解不开下载到的 App"
	ditto -x -k "$d/cca-app.zip" "$d/x" 2>/dev/null && [ -d "$d/x/cca.app" ] || return 1
	FETCH_ERR="下载到的不是 ${v} 版的 cca App，没有安装"
	gui_ours "$d/x/cca.app" && [ "$(gui_ver "$d/x/cca.app")" = "$v" ] || return 1
	FETCH_ERR="App 的代码签名不完整，没有安装"
	codesign --verify --strict "$d/x/cca.app" >/dev/null 2>&1 || return 1
	FETCH_ERR="这台 Mac 运行不了这个 App（要 macOS 26 或更新）"
	with_timeout 20 "$d/x/cca.app/Contents/MacOS/cca" --self-check </dev/null >/dev/null 2>&1
}
gui_stage() {   # 下载校验好和 cca 同版本的 App，放在 $GUI_DIR/next（已经放着了就不再下载）；调用方先 gui_lock
	local d rc
	gui_staged && return 0
	mkdir -p "$GUI_DIR" && chmod 700 "$GUI_DIR" && d=$(mktemp -d "$GUI_DIR/dl.XXXXXX") || { FETCH_ERR="建不了临时目录"; return 1; }
	gui_fetch "$VERSION" "$d" && rm -rf "$GUI_DIR/next" && mkdir -p "$GUI_DIR/next" && mv "$d/x/cca.app" "$GUI_DIR/next/cca.app"
	rc=$?
	rm -rf "$d"
	return $rc
}
gui_swap() {   # 换上放在 next 里的 App（调用方先确认 App 没开着、拿到 gui_lock）：旧的先挪开，换不上就挪回去
	local old="$GUI_APP.old.$$"
	[ -d "$GUI_DIR/next/cca.app" ] || return 1
	[ ! -e "$GUI_APP" ] || gui_ours "$GUI_APP" || { warn "${GUI_APP} 已经存在，但不是 cca 装的，没有覆盖"; return 1; }
	mkdir -p "$(dirname "$GUI_APP")" || return 1
	if [ -e "$GUI_APP" ]; then mv "$GUI_APP" "$old" || return 1; fi
	if ! mv "$GUI_DIR/next/cca.app" "$GUI_APP"; then
		[ ! -e "$old" ] || mv "$old" "$GUI_APP"
		return 1
	fi
	rm -rf "$old" "$GUI_DIR/next"
	touch "$GUI_DIR/enabled"
	"$LSREGISTER" -f "$GUI_APP" >/dev/null 2>&1
	return 0
}
gui_dev_build() {   # 开发模式：从 macos/ 的源码编译（源码比上次编出来的新、或者版本号变了才编），打印 .app 的路径
	local src="${CCA_GUI_SRC:-${SELF%/*}/macos}" app
	app="$src/build/cca.app"
	[ -f "$src/build.sh" ] || die "找不到 ${src}/build.sh"
	if [ ! -x "$app/Contents/MacOS/cca" ] || [ "$(gui_ver "$app")" != "$VERSION" ] ||
		[ -n "$(find "$src/Sources" "$src/tools" "$src/build.sh" -newer "$app/Contents/MacOS/cca" -print 2>/dev/null | head -n 1)" ]; then
		command -v swiftc >/dev/null 2>&1 || die "编译界面 App 要 swiftc：先运行 xcode-select --install 装上苹果的命令行工具"
		info "正在从源码编译界面 App（${src}）…"
		bash "$src/build.sh" --version "$VERSION" --arch native --out "$app" >&2 || die "编译界面 App 失败"
	fi
	printf '%s' "$app"
}
cmd_gui() {   # cca gui [update [--relaunch PID] | remove]
	local pid="" app
	mac_only "图形界面（cca App）"
	case "${1:-}" in
		''|open)
			gui_supported || return 1
			if dev_mode; then
				app=$(gui_dev_build) || return 1
				gui_open --env CCA_GUI_CCA="$SELF" "$app" || die "打开 ${app} 失败"
				return 0
			fi
			if ! gui_ours "$GUI_APP" || [ "$(gui_ver "$GUI_APP")" != "$VERSION" ]; then
				[ ! -e "$GUI_APP" ] || gui_ours "$GUI_APP" || die "${GUI_APP} 已经存在，但不是 cca 装的，没有覆盖"
				if gui_running; then
					warn "界面 App 开着，版本和 cca（${VERSION}）不一样：在 App 里点「更新并重新打开」，或者退出它后再运行 cca gui"
					open "$GUI_APP"
					return 0
				fi
				gui_lock || die "界面 App 正在下载或更换：稍后再试"
				trap gui_unlock EXIT
				info "正在下载 cca ${VERSION} 的界面 App…"
				gui_stage || die "没能装上界面 App：${FETCH_ERR}"
				gui_swap || die "换上界面 App 失败"
				okay "已装好界面 App：${GUI_APP}"
			fi
			gui_open "$GUI_APP" || die "打开 ${GUI_APP} 失败" ;;
		update)
			[ "${2:-}" != --relaunch ] || pid="${3:-}"
			[ -z "$pid" ] || [[ "$pid" =~ ^[0-9]+$ ]] || die "用法: cca gui update [--relaunch PID]"
			gui_supported || return 1
			if dev_mode; then   # 开发模式：重新编译，等旧的退出后打开编好的
				app=$(gui_dev_build) || return 1
				[ -z "$pid" ] || { wait_pid "$pid"; gui_open --env CCA_GUI_CCA="$SELF" "$app"; }
				return 0
			fi
			[ ! -e "$GUI_APP" ] || gui_ours "$GUI_APP" || die "${GUI_APP} 已经存在，但不是 cca 装的，没有覆盖"
			gui_lock || die "界面 App 正在下载或更换：稍后再试"
			trap gui_unlock EXIT
			gui_stage || die "没能下载界面 App：${FETCH_ERR}"
			[ -z "$pid" ] || wait_pid "$pid"
			if gui_running; then
				info "新版本的界面 App 已经下载好：退出 App 后会换上（或者在 App 里点「更新并重新打开」）"
				return 0
			fi
			gui_swap || die "换上界面 App 失败"
			okay "界面 App 已更新到 ${VERSION}"
			[ -z "$pid" ] || gui_open "$GUI_APP" ;;
		remove)
			gui_lock || die "界面 App 正在下载或更换：稍后再试"
			trap gui_unlock EXIT
			if [ -e "$GUI_APP" ]; then
				gui_ours "$GUI_APP" || die "${GUI_APP} 不是 cca 装的，没有删除"
				gui_running && die "界面 App 开着：先退出它"
				rm -rf "$GUI_APP" || die "删除 ${GUI_APP} 失败"
				okay "已删除 ${GUI_APP}"
			fi
			rm -rf "$GUI_DIR"
			gui_leftovers   # App 的设置，连同它留在 ~/Library 里的缓存、窗口状态
			return 0 ;;
		-h|--help) say "用法: cca gui [update | remove]" ;;
		*) die "用法: cca gui [update | remove]" ;;
	esac
}
gui_hook() {   # 每次启动：装过 App、cca 换了版本（自动更新、cca update）→ 后台下载对应版本的 App（App 开着就先放着，退出后再换）
	[ -f "$GUI_DIR/enabled" ] || return 0
	dev_mode && return 0
	gui_ours "$GUI_APP" || return 0   # 自己删掉了 App：不再装回来
	[ "$(gui_ver "$GUI_APP")" = "$VERSION" ] && return 0
	if gui_staged; then   # 已经下载好了：App 没开着、也没有别人正在换，就换上
		if ! gui_running && gui_lock 0; then gui_swap >/dev/null 2>&1; gui_unlock; fi
		return 0
	fi
	[ -n "$(find "$GUI_DIR/checked" -mmin -360 2>/dev/null)" ] && return 0   # 6 小时内试过
	touch "$GUI_DIR/checked"
	( perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' "$SELF" _gui-fetch </dev/null >"$GUI_DIR/log" 2>&1 3<&- & )
	return 0
}
cmd_gui_fetch() {   # 后台任务：下载校验好和 cca 同版本的 App；App 没开着就换上
	gui_lock 0 || return 0
	trap gui_unlock EXIT
	if gui_stage; then gui_running || gui_swap; else echo "$FETCH_ERR"; fi
	return 0
}

# ---------------------------------------------------------------------------
team_hook() {   # 启动时：这台设备在 Team 里、距上次同步配置超过一个小时，就在后台同步一次（team_bg_sync：拿到新的一版就马上照它改账号表、同步路由器、
                # 让内置代理跟上）。后台的那一个不带这条命令的提问会话、授权、只读（App 起的命令也会走到这里）
	[ -f "$CCA_HOME/teams/index.json" ] || return 0
	[ -z "$(find "$CCA_HOME/teams/checked" -mmin -60 2>/dev/null)" ] || return 0
	touch "$CCA_HOME/teams/checked"
	( unset CCA_EVENTS CCA_GRANT CCA_RO CCA_TTY; perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' "$SELF" _team-sync </dev/null >/dev/null 2>&1 3<&- & )
}

team_bg_sync() {   # cca _team-sync（team_hook 在后台起的）：各个 Team 同步一次配置。手里的那一份变了（新的一版、被移除、记录没了）就马上 team_settle：
	                 # 账号表照它改、同步路由器（在家时；要重载 OpenClash 的不问、不重载，等下次启动问）、内置代理的端口池跟上、改启动器。
	                 # 以前只换本机存的那一份，路由器和内置代理的分流要等下次启动账号才跟上（App 的「节点分流」页一直是旧的）
	local before after
	[ -f "$CFG" ] || { py team-sync >/dev/null 2>&1; return 0; }
	before=$(py team-list 2>/dev/null | cut -f1,5,6)
	py team-sync >/dev/null 2>&1 || return 0
	after=$(py team-list 2>/dev/null | cut -f1,5,6)
	[ "$after" != "$before" ] || return 0
	team_settle
	return 0
}

cmd_cost() {   # cca cost sync [--now] [--json]：统计折合金额（读新增的会话记录、和别的设备同步），两个工具一起；--json 给 App（PROTOCOL 3.5）。
	# cca cost hook [on|off]：Claude App 里的 Code 会话记下账号（cost_hook）
	local a out rc
	[ "${1:-}" = hook ] && { shift; cost_hook "$@"; return; }
	[ "${1:-}" = sync ] || die "用法: cca cost sync [--now] [--json] | cca cost hook [on | off]"
	shift
	for a in "$@"; do case "$a" in --now|--json) ;; *) die "不认识的参数: ${a}（用法: cca cost sync [--now] [--json]）" ;; esac; done
	[ -f "$CFG" ] || { fail_warn cost_off "还没安装：请在终端里运行 $SELF install"; return 2; }   # 没有可统计的账号（PROTOCOL 3.5 的退出码 2）
	out=$(py cost-sync "$@"); rc=$?
	case $rc in
		0) printf '%s\n' "$out" ;;
		2) fail_warn cost_off "$out"; return 2 ;;
		*) FAIL_CODE=cost_unavailable die "${out:-统计折合金额没成}" ;;
	esac
}

cost_hook() {   # cca cost hook [on|off]：Claude App 里的 Code 会话（会话记录里没有账号信息）开始时记下 App 登录的账号，折合金额按它算。
	# 在共享的 ~/.claude/settings.json 里加一条 SessionStart hook（py cost-hook；只在 App 里的会话回调 cca _session-start --desktop）。
	# 改的是 Claude Code 的全局设置：加之前问（consent cost_hook，范围为空）；关掉折合金额（cost-sync 时发现）、卸载时去掉
	local out rc
	mac_only "记下 Claude App 里 Code 会话的账号"
	case "${1:-}" in
		"")
			out=$(py cost-hook status) || die "没能读取 Claude Code 的共享设置"
			if [ "$out" = on ]; then
				okay "开着：Claude App 里的 Code 会话开始时记下它登录的账号，折合金额按它算（~/.claude/settings.json 里 cca 加的 SessionStart hook）"
			else
				info "关着：Claude App 里 Code 会话的折合金额认不出是哪个账号的。要记下：${CMD} cost hook on"
			fi ;;
		on)
			grep -Eq '"cost"[[:space:]]*:[[:space:]]*false' "$CFG" 2>/dev/null && FAIL_CODE=cost_off die "折合金额关掉了（config.json 里写着 \"cost\": false）：先打开它"
			if [ "$(py cost-hook status)" != on ]; then
				consent cost_hook "" "记下 Claude App 里 Code 会话的账号" "现在在 ~/.claude/settings.json 里加上这条 hook 吗？" \
					"Claude App 里的 Code 会话不在会话记录里写账号，折合金额认不出是哪个账号的。cca 会在共享的 ~/.claude/settings.json 里加一条 SessionStart hook：App 里的会话开始时运行 cca，记下会话 id 和 App 登录的账号（不读对话的内容），折合金额按它算进那个账号；只认这台设备上 cca 里的官方账号，别的照旧算「认不出账号」。命令行里的会话不受影响。不想要了：${CMD} cost hook off；关掉折合金额、卸载 cca 时会自动去掉。" y
				case $? in
					0) ;;
					1) info "没有改动"; gui_cancelled; return 1 ;;
					*) die "要先同意：在终端里运行 ${CMD} cost hook on（会先问你）" ;;
				esac
			fi
			out=$(py cost-hook on); rc=$?
			case $rc in
				0) ;;
				2) FAIL_CODE=cost_off die "$out" ;;
				4) die "$out" ;;
				*) die "没能改 Claude Code 的共享设置" ;;
			esac
			if [ "$out" = same ]; then out="已经开着"; else out="已在 ~/.claude/settings.json 里加上"; fi
			out="${out}：Claude App 里的 Code 会话开始时记下它登录的账号，折合金额按它算（加上以前的会话照旧认不出）"
			okay "$out"; gui_done cost_hook "$out" ;;
		off)
			out=$(py cost-hook off); rc=$?
			case $rc in
				0) ;;
				4) die "$out" ;;
				*) die "没能改 Claude Code 的共享设置" ;;
			esac
			if [ "$out" = same ]; then out="本来就没有：~/.claude/settings.json 里没有 cca 加的这条 hook"; else out="已从 ~/.claude/settings.json 里去掉：以后 Claude App 里的 Code 会话不再记下账号"; fi
			okay "$out"; gui_done cost_hook "$out" ;;
		*) die "用法: ${CMD} cost hook [on | off]" ;;
	esac
}

cmd_devices() {   # cca [codex] devices [账号…] [--json]：账号连着哪些设备（问它走的那台同步服务器：Team 给的问那个 Team 的；--json 给 App，PROTOCOL 3.4）
	local a json="" out rc
	for a in "$@"; do [ "$a" = --json ] && json=1; done
	out=$(py presence-view "$@"); rc=$?
	case $rc in
		0) if [ -n "$json" ]; then printf '%s\n' "$out"; else say "$out"; fi ;;
		2) FAIL_CODE=devices_off die "$out" ;;
		*) [ -z "$out" ] || fail_warn devices_unavailable "$out"; return 1 ;;   # 账号写错了时 py 自己说过了
	esac
}

