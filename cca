def api_env(v):
    """第三方 API 账号交给 Claude Code 的环境：接口地址、关掉发往 Anthropic 的遥测和更新检查、模型；
    表里 env 写的变量最后覆盖（地址和凭证除外，校验时已经拒绝）"""
    env = {'ANTHROPIC_BASE_URL': api_url(v), 'CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC': '1'}
    m = v.get('model')
    if model_ok(m):
        for n in ('ANTHROPIC_MODEL', 'ANTHROPIC_DEFAULT_OPUS_MODEL', 'ANTHROPIC_DEFAULT_SONNET_MODEL', 'ANTHROPIC_DEFAULT_HAIKU_MODEL'):
            env[n] = m
    x = v.get('env')
    for k, val in (x.items() if isinstance(x, dict) else []):
        if ENV_NAME_RE.match(k) and not ENV_RESERVED.match(k):
            env[k] = str(val)
    return env


def api_settings(key, v):
    """第三方 API 账号的 claude --settings：key 由 apiKeyHelper 现取（回调 cca _api-key，不进环境变量），
    地址、模型写在 env 里。--settings 的优先级高于共享的 settings.json 和进程环境，谁也盖不掉它们"""
    helper = '%s _api-key %s' % (shlex.quote(SELF_PATH), shlex.quote(acct_id(key)))
    return json.dumps({'apiKeyHelper': helper, 'env': api_env(v)}, ensure_ascii=False)


def bypass_list(no_proxy):
    """NO_PROXY 写法 → Chromium --proxy-bypass-list 写法（和 Claude App 自己的转换一致）"""
    out = []
    for e in (x.strip() for x in no_proxy.split(',')):
        if e:
            out.append('[%s]' % e if ':' in e else '*' + e if e.startswith('.') else e)
    return ';'.join(out)


