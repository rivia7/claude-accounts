def codex_claims(key):
    """Codex 账号登录的身份：auth.json 里 id_token 的声明，只取邮箱、套餐和工作空间（不验签名；不碰 access / refresh
    token，也不保存、不转发）。没登录、用 API key 登录、读不了都返回 {}"""
    import base64
    j = load_quiet(os.path.join(cdir(key), 'auth.json'))
    tok = j.get('tokens') if isinstance(j, dict) else None
    tok = tok.get('id_token') if isinstance(tok, dict) else None
    if not isinstance(tok, str) or tok.count('.') != 2:
        return {}
    try:
        p = tok.split('.')[1]
        d = json.loads(base64.urlsafe_b64decode(p + '=' * (-len(p) % 4)).decode('utf-8'))
    except (ValueError, UnicodeDecodeError):
        return {}
    if not isinstance(d, dict):
        return {}
    prof, auth = d.get('https://api.openai.com/profile'), d.get('https://api.openai.com/auth')
    prof, auth = (prof if isinstance(prof, dict) else {}), (auth if isinstance(auth, dict) else {})
    email = d.get('email') or prof.get('email')
    return {'email': email if isinstance(email, str) else '', 'plan': str(auth.get('chatgpt_plan_type') or ''),
            'account': str(auth.get('chatgpt_account_id') or '')}


