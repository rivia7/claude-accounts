def launcher_names(t):
    """启动器的名字："Claude 别名"（Codex 账号是 "ChatGPT 别名"）；没有别名用邮箱 @ 前面的部分，和别的账号重名时改用完整邮箱"""
    short = {}
    for k in t:
        a, e = parse_key(k)
        short[k] = a or e.split('@')[0] or k
    count = {}
    for n in short.values():
        count[n] = count.get(n, 0) + 1
    out = {}
    for k, n in short.items():
        if count[n] > 1 and not parse_key(k)[0]:
