def usage_cached(key):
    """最近一次的用量：cca 存的 usage.json 和 Claude Code 的 cachedUsageUtilization 取新的那份；
    登录的已经不是存它的那个账号时不算。返回 {at: 秒, rl: 用量窗口} 或 None"""
    uuid, best = T.who(key), None
    for x in T.usage_caches(key):
        if not isinstance(x, dict) or not isinstance(x.get('utilization'), dict):
            continue
        at = x.get('fetchedAtMs')
        if isinstance(at, bool) or not isinstance(at, (int, float)):
            continue
        if uuid and x.get('accountUuid') and x['accountUuid'] != uuid:
            continue
        if not best or at / 1000.0 > best['at']:
            best = {'at': at / 1000.0, 'rl': x['utilization']}
    return best


def usage_save(key, rl, sub=None):
