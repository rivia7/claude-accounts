def table_load(tool=None):
    tool = tool or T
    t = load_json(tool.table, {})
    if not isinstance(t, dict):
        die('%s 应该是 {"别名(邮箱)": "节点"} 形式的 JSON 对象' % tool.table)
    tool.set_ids(t)
    TABS[tool.name] = t
    return t


def tables_load():
    """当前工具的账号表（格式不对就报错退出），以及别的工具的账号表（格式不对就当它暂时不在：它记着的端口
    照样留着，不影响当前工具）"""
    for tool in TOOLS:
        if tool is T:
            table_load()
            continue
        t = load_quiet(tool.table) if os.path.exists(tool.table) else {}
        if isinstance(t, dict):
            tool.set_ids(t)
            TABS[tool.name] = t
        else:
            TABS.pop(tool.name, None)


def load_ids():
    """不读账号表的子命令（link、sync、email…）也要按 id 认第三方 API 账号；账号表读不了时当作没有"""
    for tool in TOOLS:
        t = load_quiet(tool.table)
        if isinstance(t, dict):
            tool.set_ids(t)


def is_api(v):
    return isinstance(v, dict)


def node_of(v):
    """账号走的出口节点；直连的第三方 API 账号是空字符串"""
    n = v.get('node') if is_api(v) else v
    return n if isinstance(n, str) else ''


def base_order(c, t, tool=None):
    """账号的先来后到（键的列表）：端口池、路由器的摘要、启动器的颜色都按它，调整账号表的顺序（cca reorder）不牵连它们，
    不用同步路由器、不用重新加载本机 Clash、头像和启动器的颜色也不变。没调整过时就是账号表的顺序（和以前逐字节一样）；
    调整过的话，调整之前的顺序记在 order_base（账号目录名），之后新加的账号排在后面"""
    base = (tool or T).state(c).get('order_base')
    if not base:
        return list(t)
    rank = {a: i for i, a in enumerate(base)}
    return sorted(t, key=lambda k: rank.get(acct_id(k, tool), len(base)))


def routed(c, t, tool=None):
    """走节点、有端口的账号 [(键, 值, 端口)]；直连的第三方 API 账号没有端口"""
    ports = (tool or T).state(c).get('ports') or {}
    return [(k, t[k], ports[k]) for k in base_order(c, t, tool) if k in ports]


def pool(c):
    """端口池里的全部账号 [(工具, 键, 值, 端口)]：先 Claude 后 Codex，各按 base_order。路由器和本机 Clash
    上的端口池都按它来；只有 Claude 账号时和以前一样"""
    return [(tool, k, v, p) for tool in TOOLS for k, v, p in routed(c, TABS.get(tool.name) or {}, tool)]


