def ver_key(v):
    """版本号的先后，和 bash 的 ver_gt 一样：同号的测试版比正式版旧，测试版之间比 beta 后面的数；认不出是 None"""
    m = re.match(r'^(\d+)\.(\d+)\.(\d+)(?:-beta\.(\d+))?$', v if isinstance(v, str) else '')
    if not m:
        return None
    x, y, z, b = m.groups()
    return (int(x), int(y), int(z), int(b) if b is not None else float('inf'))


def cmd_update_check(current, mode='', fallback='', repo=''):
    """cca update --check [--json]：stdin 是 GitHub 上最近的发布（api.github.com 的 releases 列表，拿不到时是空的），
    fallback 是 releases/latest 指向的正式版（列表拿不到时 bash 才去取，只有版本号）。按现在的版本挑：测试版上看更新的
    测试版和正式版，正式版上只看正式版（自动更新、不带版本号的 cca update 不变，只看正式版）。
    mode=json：stdout 输出 kind=update 的文档（macos/PROTOCOL.md 5.1）；否则给 bash UP_LATEST / UP_AVAILABLE / UP_BETA /
    UP_NOTES（更新说明的前几行）。一个版本都没拿到时退出码 1"""
    beta = '-beta.' in current
    try:
        rels = json.loads(sys.stdin.read() or 'null')
    except ValueError:
        rels = None
    found = []
    for x in rels if isinstance(rels, list) else []:
        tag = str(x.get('tag_name') or '') if isinstance(x, dict) and not x.get('draft') else ''
        v = tag[1:] if tag[:1] in ('v', 'V') else tag
        if ver_key(v) is None or ('-beta.' in v and not beta):
            continue
        found.append({'version': v, 'notes': x.get('body') if isinstance(x.get('body'), str) else None,
                      'url': x.get('html_url') if isinstance(x.get('html_url'), str) else '%s/releases/tag/%s' % (repo, tag),
                      'published_epoch': parse_ts(x.get('published_at'))})
    source = 'releases'
    if not found and ver_key(fallback):
        found, source = [{'version': fallback, 'notes': None, 'url': '%s/releases/tag/v%s' % (repo, fallback), 'published_epoch': None}], 'latest'
    if not found:
        sys.exit(1)
    best = max(found, key=lambda f: ver_key(f['version']))
    available = ver_key(current) is None or ver_key(best['version']) > ver_key(current)
    if mode == 'json':
        print(json.dumps({'version': 1, 'kind': 'update', 'generated_epoch': time.time(), 'cca_version': current,
                          'channel': 'beta' if beta else 'stable', 'source': source,
                          'latest': best['version'], 'available': available, 'notes': best['notes'] or None, 'url': best['url'],
                          'published_epoch': best['published_epoch']}, ensure_ascii=False, indent=2))
        return
    lines = [s.strip() for s in (best['notes'] or '').splitlines() if s.strip()]
    sh(UP_LATEST=best['version'], UP_AVAILABLE='1' if available else '', UP_BETA='1' if '-beta.' in best['version'] else '',
       UP_NOTES='\n'.join(lines[:3]))


