def aside(src, key):
    import shutil
    d = os.path.join(T.sroot, 'conflicts', acct_id(key))
    os.makedirs(d, exist_ok=True)
    dst = os.path.join(d, '%s.%d' % (os.path.basename(src), int(time.time())))
    shutil.move(src, dst)
    sys.stderr.write('cca: %s 与 %s 中的同名条目类型不同，已移到 %s\n' % (os.path.basename(src), T.master.replace(HOME, '~', 1), dst))


def copy_over(src, dst):
    import shutil
    real = os.path.realpath(dst)
    tmp = '%s.cca-%d.tmp' % (real, os.getpid())
    shutil.copy2(src, tmp)
    os.replace(tmp, real)


def merge_lines(src, dst):
    with open(dst, 'rb') as f:
        have = f.read()
    seen = set(have.splitlines())
    with open(src, 'rb') as f:
        extra = [l for l in f.read().splitlines() if l not in seen]
    if extra:
        with open(os.path.realpath(dst), 'ab') as f:
            f.write((b'\n' if have and not have.endswith(b'\n') else b'') + b'\n'.join(extra) + b'\n')


def merge_file(src, dst):
    import filecmp
    if src.endswith('.jsonl'):
        merge_lines(src, dst)
    elif not filecmp.cmp(src, dst, shallow=False) and os.path.getmtime(src) > os.path.getmtime(dst):
        copy_over(src, dst)


def merge_tree(src, dst):
    import shutil
    for root, dirs, files in os.walk(src):
        rel = os.path.relpath(root, src)
        troot = dst if rel == '.' else os.path.join(dst, rel)
        os.makedirs(troot, exist_ok=True)
        for n in [d for d in dirs if os.path.islink(os.path.join(root, d))] + files:
            sp, tp = os.path.join(root, n), os.path.join(troot, n)
            if os.path.islink(sp):
                if not os.path.lexists(tp):
                    os.symlink(os.readlink(sp), tp)
            elif not os.path.lexists(tp):
                shutil.copy2(sp, tp)
            elif os.path.isfile(tp):
                merge_file(sp, tp)
        dirs[:] = [d for d in dirs if not os.path.islink(os.path.join(root, d))]


def adopt(src, dst, key):
    """会话里新建的、或被原子写替换掉链接的真实条目：并回共享主目录（~/.claude、~/.codex）后改回链接。"""
    import shutil
    if not os.path.lexists(dst):
        shutil.move(src, dst)
    elif os.path.isdir(src):
        if not os.path.isdir(dst):
            return aside(src, key)
        merge_tree(src, dst)
        shutil.rmtree(src)
    elif os.path.isdir(dst):
        return aside(src, key)
    else:
        merge_file(src, dst)
        os.unlink(src)


def detach_legacy_shared(path, shared):
    """只拆旧版 cca 指向共享主目录同名项的链接，用户自己建的外部链接不动。"""
    import shutil
    if not os.path.islink(path):
        return
    target = os.readlink(path)
    if os.path.abspath(os.path.join(os.path.dirname(path), target)) != os.path.abspath(shared):
        return
    if not os.path.exists(path):
        os.unlink(path)
        return
    if os.path.isdir(path):
        for root, dirs, files in os.walk(path):
            if any(os.path.islink(os.path.join(root, n)) for n in dirs + files):
                die('旧共享目录包含内部符号链接，无法自动拆分，原目录未改动：%s' % path)
    import tempfile
    with tempfile.TemporaryDirectory(prefix='.cca-unshare-', dir=os.path.dirname(path)) as work:
        copied = os.path.join(work, 'copy')
        if os.path.isdir(path):
            shutil.copytree(path, copied, symlinks=True)
        else:
            shutil.copy2(path, copied)
        # 目录不能直接 rename 覆盖符号链接；复制成功后再移走旧链接，失败则恢复。
        old = os.path.join(work, 'link')
        os.replace(path, old)
        try:
            os.replace(copied, path)
        except OSError:
            os.replace(old, path)
            raise


def shared_text(path):
    try:
        with open(path, encoding='utf-8') as f:
            return f.read()
    except FileNotFoundError:
        return None


def config_conflict(src, key):
    """冲突副本完整保存；文件可能包含用户私有配置，不输出内容。"""
    import shutil, uuid
    directory = os.path.join(T.sroot, 'conflicts', acct_id(key))
    os.makedirs(directory, mode=0o700, exist_ok=True)
    dst = os.path.join(directory, '%s.%s' % (os.path.basename(src), uuid.uuid4().hex))
    shutil.copy2(src, dst)
    os.chmod(dst, 0o600)
    sys.stderr.write('cca: 共享配置 %s 有冲突或无法合并，冲突部分保留共享版本，账号副本已保存到 %s\n' % (os.path.basename(src), dst))


def merge_config_json(base, ours, theirs):
    """按基线逐字段合并；双方对同一字段作不同修改时保留共享值并报告冲突。"""
    if eq(ours, theirs) or eq(ours, base):
        return theirs, False
    if eq(theirs, base):
        return ours, False
    if isinstance(ours, dict) and isinstance(theirs, dict):
        before = base if isinstance(base, dict) else {}
        merged, conflict = {}, False
        for name in list(theirs) + [n for n in ours if n not in theirs]:
            value, changed = merge_config_json(before.get(name, MISSING), ours.get(name, MISSING), theirs.get(name, MISSING))
            if value is not MISSING:
                merged[name] = value
            conflict |= changed
        return merged, conflict
    return theirs, True


def merge_shared_config(src, dst, key, base):
    ours, theirs = shared_text(src), shared_text(dst)
    if ours == theirs or ours == base:
        return
    if src.endswith('.json'):
        try:
            parsed = json.loads(ours)
        except ValueError:
            config_conflict(src, key)
            return
    if theirs == base or (base is MISSING and theirs is None):
        copy_over(src, dst)
        return
    if base is not MISSING and src.endswith('.json'):
        try:
            merged, conflict = merge_config_json(json.loads(base) if base is not None else MISSING,
                                                 parsed, json.loads(theirs) if theirs is not None else MISSING)
        except ValueError:
            pass   # 无法解析的配置保留原文，不能拿不完整 JSON 覆盖共享版本。
        else:
            if conflict:
                config_conflict(src, key)
            if merged is not MISSING:
                save_json(dst, merged)
            return
    # TOML/普通文本不按行拼接，避免合成重复的 key/table；无基线也不猜哪份更新。
    config_conflict(src, key)


def link_levels(cd, master):
    """要链接的各层：顶层（''）和 T.nests 里的子目录，[(相对路径, 账号目录里的, 主目录里的)]。子目录在账号目录里建成真目录
    （里面放指向主目录同一位置的链接）；账号目录里那一层是链接（不是 cca 建的）时这一层不动，免得经它写到别处"""
    out = []
    for lvl in ('',) + tuple(T.nests):
        lcd, lm = os.path.join(cd, lvl), os.path.join(master, lvl)
        if lvl:
            if os.path.islink(lcd) or (os.path.lexists(lcd) and not os.path.isdir(lcd)):
                continue
            os.makedirs(lcd, exist_ok=True)
        out.append((lvl, lcd, lm))
    return out


def cmd_link(key):
    cd, master = cdir(key), T.master
    os.makedirs(cd, exist_ok=True)
    os.makedirs(master, exist_ok=True)
    for d in T.precreate:
        os.makedirs(os.path.join(master, d), exist_ok=True)
    with Lock():
        prepare_device(key)
        snapshot = os.path.join(cd, '.cca-shared-base.json')
        base = load_json(snapshot, {})
        if not isinstance(base, dict) or any(v is not None and not isinstance(v, str) for v in base.values()):
            die('共享配置基线格式错误：%s' % snapshot)
        levels = link_levels(cd, master)
        for lvl, lcd, lm in levels:
            for name in sorted(os.listdir(lcd)):
                n = os.path.join(lvl, name) if lvl else name   # 名单、基线里的写法（子目录里的写成相对路径）
                p, t = os.path.join(lcd, name), os.path.join(lm, name)
                if not T.shares(n):
                    if T is CLAUDE:
                        detach_legacy_shared(p, t)
                    continue
                if os.path.islink(p):
                    if os.readlink(p) != t:
                        os.unlink(p)
                    continue
                os.makedirs(lm, exist_ok=True)
                if T.shared_config(n) and os.path.isfile(p) and (not os.path.lexists(t) or os.path.isfile(t)):
                    merge_shared_config(p, t, key, base.get(n, MISSING))
                    os.unlink(p)
                else:
                    adopt(p, t, key)
        listed = []
        for lvl, lcd, lm in levels:
            for name in (sorted(os.listdir(lm)) if os.path.isdir(lm) else []):
                n = os.path.join(lvl, name) if lvl else name
                listed.append(n)
                p = os.path.join(lcd, name)
                if T.shares(n) and not os.path.lexists(p):
                    os.symlink(os.path.join(lm, name), p)
        names = set(T.config_names)
        names.update(n for n in list(base) + listed if T.shared_config(n))
        saved = {n: shared_text(os.path.join(master, n)) for n in sorted(names) if not os.path.isdir(os.path.join(master, n))}
        if saved != base or not os.path.exists(snapshot):
            save_json(snapshot, saved, 0o600, follow_symlinks=False)
    T.after_link(key)


