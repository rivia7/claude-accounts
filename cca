proc_args() {   # 进程的命令行（看它是不是自己起的那个）：Linux 读 /proc（busybox 的 ps 不认 -p），macOS 问 ps
	if [ -r "/proc/$1/cmdline" ]; then tr '\0' ' ' < "/proc/$1/cmdline"; else ps -p "$1" -o command= 2>/dev/null; fi
}
kill_kids() {   # kill_kids 进程号…：停掉这些进程的子进程（pkill -P）。没装 procps 的 Linux（Debian、Fedora、Rocky、Amazon Linux 的容器镜像这类最小安装）没有 pkill：读 /proc
	local p f s
	if command -v pkill >/dev/null 2>&1; then
		for p in "$@"; do pkill -P "$p"; done
		return 0
	fi
	for f in /proc/[0-9]*/stat; do
		{ read -r s < "$f"; } 2>/dev/null || continue   # 读的时候进程刚好退出了
		s=${s##*") "}; s=${s#* }; s=${s%% *}   # 「进程号 (程序名) 状态 父进程号 …」：程序名里可能有空格和括号，从最后一个 ") " 往后数
		for p in "$@"; do
			[ "$s" = "$p" ] || continue
			f=${f%/stat}; kill "${f#/proc/}"; break
		done
	done
	return 0
}
