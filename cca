class ClientUpdateError(Exception):
    def __init__(self, status, message):
        self.status, self.message = status, message
        super().__init__(message)


def cu_error(status, message):
    raise ClientUpdateError(status, message)


def cu_private(path, directory=False, create=False):
    """更新器自己的路径只容许当前用户的普通文件/目录，不跟随链接。"""
    import stat
    if create and not os.path.lexists(path):
        if directory:
            os.mkdir(path, 0o700)
        else:
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
            os.close(fd)
    try:
        s = os.lstat(path)
    except OSError:
        cu_error('blocked', '无法读取更新器的私有文件')
    valid = stat.S_ISDIR(s.st_mode) if directory else stat.S_ISREG(s.st_mode) and s.st_nlink == 1
    if not valid or s.st_uid != os.getuid() or s.st_mode & 0o077:
        cu_error('blocked', '更新器目录或文件权限不安全')
    return path


def cu_base(create=False):
    """client-updates 目录（manager.lock 在这里）；各客户端的状态、软件包在它下面各一个目录"""
    root = os.path.join(CCA_HOME, 'client-updates')
    if create:
        if not os.path.exists(CCA_HOME):
            os.makedirs(CCA_HOME, mode=0o700)
        import stat
        s = os.lstat(CCA_HOME)
        if not stat.S_ISDIR(s.st_mode) or s.st_uid != os.getuid() or s.st_mode & 0o022:
            cu_error('blocked', 'cca 配置目录不能用于安全暂存更新')
    if create or os.path.lexists(root):
        cu_private(root, True, create)
    return root


def cu_root(create=False):
    root = os.path.join(cu_base(create), CU.id)
    if create or os.path.lexists(root):
        cu_private(root, True, create)
    return root


class ClientUpdateLock:
    def __init__(self, path):
        self.path, self.fd = path, None

    def __enter__(self):
        import stat
        cu_private(self.path, create=True)
        self.fd = os.open(self.path, os.O_RDWR | os.O_NOFOLLOW)
        s = os.fstat(self.fd)
        if not stat.S_ISREG(s.st_mode) or s.st_nlink != 1 or s.st_uid != os.getuid() or s.st_mode & 0o077:
            os.close(self.fd)
            self.fd = None
            cu_error('blocked', '客户端更新锁不安全')
        try:
            fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            os.close(self.fd)
            self.fd = None
            cu_error('busy', '另一项客户端更新正在进行')
        return self

    def __exit__(self, *exc):
        if self.fd is not None:
            os.close(self.fd)


def cu_read_state():
    path = os.path.join(cu_root(), 'state.json')
    if not os.path.lexists(path):
        return {}
    cu_private(path)
    data = load_quiet(path)
    if not isinstance(data, dict) or data.get('v') != 1:
        cu_error('blocked', '更新缓存格式无法识别，请重新检查')
    return data


def cu_save_state(state):
    path = os.path.join(cu_root(True), 'state.json')
    if os.path.lexists(path):
        cu_private(path)
    save_json(path, dict(state, v=1), 0o600, follow_symlinks=False)


def cu_mode():
    c = load_quiet(CFG)
    value = c.get('client_updates', 'auto') if isinstance(c, dict) else 'auto'
    return 'off' if value == 'off' else 'auto'


def cu_target():
    """空的显式路径代表 shell 没找到客户端，不绕过它另找一个程序。"""
    if CU.env in os.environ:
        return os.environ[CU.env]
    if os.environ.get(CU.app_env):
        return os.environ[CU.app_env]
    import plistlib
    for base in ('/Applications', os.path.join(HOME, 'Applications')):
        for name in CU.names:
            path = os.path.join(base, name)
            try:
                with open(os.path.join(path, 'Contents', 'Info.plist'), 'rb') as f:
                    if plistlib.load(f).get('CFBundleIdentifier') == CU.bundle:
                        return path
            except (OSError, ValueError, TypeError, AttributeError):
                pass
    return ''


def cu_hash(path):
    import stat
    before = os.lstat(path)
    if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1:
        cu_error('blocked', '程序或安装包不是独立的普通文件')
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        opened = os.fstat(f.fileno())
        if (opened.st_dev, opened.st_ino) != (before.st_dev, before.st_ino):
            cu_error('needs_recheck', '程序或安装包正在变化，请重新检查')
        for block in iter(lambda: f.read(1024 * 1024), b''):
            h.update(block)
        after = os.fstat(f.fileno())
    fields = lambda s: (s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns)
    if fields(before) != fields(after) or fields(after) != fields(os.lstat(path)):
        cu_error('needs_recheck', '程序或安装包正在变化，请重新检查')
    return h.hexdigest()


def cu_file_id(path):
    s = os.lstat(path)
    return [s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns]


def cu_snapshot(path, full=True):
    import plistlib, stat
    if not path or not os.path.isdir(path):
        cu_error('missing', '未找到当前 %s 桌面客户端' % CU.label)
    if not os.path.isabs(path) or os.path.islink(path):
        cu_error('blocked', '客户端路径必须是实际的绝对目录')
    path = os.path.realpath(path)
    before = os.stat(path)
    plist_path = os.path.join(path, 'Contents', 'Info.plist')
    plist_identity = cu_file_id(plist_path)
    with open(plist_path, 'rb') as f:
        info = plistlib.load(f)
    executable = info.get('CFBundleExecutable')
    version, build = info.get('CFBundleShortVersionString'), info.get('CFBundleVersion')
    if (info.get('CFBundleIdentifier') != CU.bundle or not isinstance(executable, str)
            or not executable or os.path.basename(executable) != executable or executable in ('.', '..')
            or not isinstance(version, str) or not re.fullmatch(r'\d+(?:\.\d+){1,5}', version)
            or not isinstance(build, str) or not re.fullmatch(CU.build_re, build)):
        cu_error('blocked', '客户端标识、版本或程序布局无法识别')
    names = ['Contents/Info.plist', 'Contents/MacOS/' + executable,
             'Contents/Resources/app.asar', 'Contents/_CodeSignature/CodeResources']
    hashes, identities = {}, {}
    for name in names:
        full_path = os.path.join(path, name)
        if os.path.realpath(full_path) != full_path:
            cu_error('blocked', '客户端关键程序文件不能通过链接替换')
        identities[name] = cu_file_id(full_path)
        if full:
            hashes[name] = cu_hash(full_path)
    if (identities['Contents/Info.plist'] != plist_identity
            or any(cu_file_id(os.path.join(path, name)) != identity for name, identity in identities.items())):
        cu_error('needs_recheck', '客户端在检查期间发生变化，请重新检查')
    after = os.stat(path)
    if (before.st_dev, before.st_ino, before.st_mtime_ns, before.st_ctime_ns) != (
            after.st_dev, after.st_ino, after.st_mtime_ns, after.st_ctime_ns):
        cu_error('needs_recheck', '客户端正在被其他更新器修改，请稍后重新检查')
    return {'path': path, 'version': version, 'build': build, 'hashes': hashes, 'files': identities,
            'device': after.st_dev, 'inode': after.st_ino,
            'modified_ns': after.st_mtime_ns, 'changed_ns': after.st_ctime_ns}


def cu_environment(folder):
    """从空环境构建：不携带账号 ID、代理、Cookie、证书覆盖或 shell 注入配置。"""
    return {'PATH': '/usr/bin:/bin:/usr/sbin:/sbin', 'HOME': folder, 'CURL_HOME': folder,
            'TMPDIR': folder, 'LANG': 'C', 'LC_ALL': 'C'}


def cu_run(args, folder, timeout=30, env=None):
    import subprocess
    try:
        return subprocess.run(args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                              stderr=subprocess.PIPE, env=env or cu_environment(folder), close_fds=True,
                              timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        cu_error('error', '更新校验命令失败或超时')


def cu_url(url, package=False):
    from urllib.parse import urlsplit
    if not isinstance(url, str) or re.search(r'[\x00-\x20\x7f\\]', url):
        cu_error('blocked', '更新地址不符合官方来源规则')
    try:
        p = urlsplit(url)
        valid = (p.scheme == 'https' and p.port in (None, 443) and not p.username and not p.password
                 and not p.fragment and CU.url_ok(p, package))
    except ValueError:
        valid = False
    if not valid:
        cu_error('blocked', '更新地址不符合官方来源规则')
    return url


def cu_time(seconds):
    """一次下载最多用多久：不超过这次 check 剩下的时间"""
    if CU_BUDGET is None:
        return seconds
    left = int(CU_BUDGET - time.time())
    if left < 20:
        cu_error('error', '这次检查的时间用完了，稍后会重新检查')
    return min(seconds, left)


def cu_download(url, destination, folder, package=False, expected_size=None, empty=()):
    """curl 不自动跳转；每一跳先验证，三次重试不复用半包或持久 Cookie。empty 里的状态码（没有更新）原样返回"""
    from urllib.parse import urljoin
    header = os.path.join(folder, 'response.headers')
    initial = cu_url(url, package)
    limit = CU_MAX_PACKAGE if package else 2 * 1024 * 1024
    for attempt in range(3):
        current = initial
        for hop in range(6):
            seconds = cu_time(300 if package else 30)
            args = ['/usr/bin/curl', '-q', '--silent', '--show-error', '--proto', '=https',
                    '--proto-redir', '=https', '--proxy', '', '--noproxy', '*',
                    '--no-netrc', '--no-netrc-optional', '--netrc-file', '/dev/null',
                    '--connect-timeout', '15', '--max-time', str(seconds),
                    '--max-filesize', str(limit), '--max-redirs', '0',
                    '--dump-header', header, '--output', destination, '--write-out', '%{http_code}', current]
            try:
                result = cu_run(args, folder, seconds + 10)
            except ClientUpdateError as e:
                if e.status != 'error':
                    raise
                break
            if result.returncode:
                break
            code = result.stdout.decode('ascii', 'replace').strip()
            if code in empty:
                return code
            if code in ('301', '302', '303', '307', '308'):
                with open(header, encoding='iso-8859-1') as f:
                    locations = [line.split(':', 1)[1].strip() for line in f if line.lower().startswith('location:')]
                if len(locations) != 1:
                    cu_error('blocked', '官方更新地址返回了无法识别的跳转')
                current = cu_url(urljoin(current, locations[0]), package)
                continue
            if code != '200':
                break
            size = os.path.getsize(destination)
            if not 0 < size <= limit or expected_size is not None and size != expected_size:
                cu_error('error', '下载大小与官方元数据不符')
            os.chmod(destination, 0o600)
            return
        if attempt < 2:
            time.sleep(attempt + 1)
    cu_error('error', '无法从官方来源下载更新，请稍后重试')


def cu_host():
    import platform
    arch = platform.machine()
    try:
        result = cu_run(['/usr/sbin/sysctl', '-n', 'hw.optional.arm64'], '/private/tmp', 10)
        if result.returncode == 0 and result.stdout.strip() == b'1':
            arch = 'arm64'
    except ClientUpdateError:
        pass
    if arch not in ('arm64', 'x86_64') or not platform.mac_ver()[0]:
        cu_error('blocked', '仅支持 macOS 上经过识别的处理器架构')
    return ('x64' if arch == 'x86_64' else arch), platform.mac_ver()[0]


def cu_version(value):
    if not isinstance(value, str) or not re.fullmatch(r'\d+(?:\.\d+){0,5}', value):
        cu_error('blocked', '官方版本元数据无法识别')
    return tuple(int(x) for x in value.split('.')) + (0,) * (6 - len(value.split('.')))


def cu_build(value):
    """构建号比大小：ChatGPT 是整数，Claude 和版本号一样是点分的"""
    return cu_version(value) if '.' in value else (int(value),)


def cu_parse_feed(data, arch, system):
    import base64, xml.etree.ElementTree as ET
    if len(data) > 2 * 1024 * 1024 or b'<!DOCTYPE' in data.upper() or b'<!ENTITY' in data.upper():
        cu_error('blocked', '官方版本列表格式不安全')
    try:
        root = ET.fromstring(data)
    except ET.ParseError:
        cu_error('error', '无法读取官方版本列表')
    if root.tag != 'rss':
        cu_error('blocked', '官方版本列表格式无法识别')
    candidates = []
    for item in root.findall('./channel/item'):
        version = item.findtext(CU_NS + 'shortVersionString') or ''
        build = item.findtext(CU_NS + 'version') or ''
        minimum = item.findtext(CU_NS + 'minimumSystemVersion') or ''
        hardware = item.findtext(CU_NS + 'hardwareRequirements') or ''
        if hardware != arch or item.find(CU_NS + 'channel') is not None:
            continue
        if not re.fullmatch(r'\d{1,12}', build) or not re.fullmatch(r'\d+(?:\.\d+){1,5}', version):
            continue
        if not minimum or cu_version(minimum) > cu_version(system):
            continue
        enclosures = item.findall('enclosure')
        if len(enclosures) != 1:
            continue
        enclosure = enclosures[0]
        if enclosure.get(CU_NS + 'deltaFrom') is not None:
            continue
        url = cu_url(enclosure.get('url', ''), True)
        expected = '/ChatGPT-darwin-%s-%s.zip' % (arch, version)
        if not url.endswith(expected):
            cu_error('blocked', '官方包地址和版本元数据不一致')
        try:
            length = int(enclosure.get('length', ''))
            signature = enclosure.get(CU_NS + 'edSignature', '')
            if not 0 < length <= CU_MAX_PACKAGE or len(base64.b64decode(signature, validate=True)) != 64:
                raise ValueError()
        except (ValueError, TypeError):
            cu_error('blocked', '官方包缺少有效长度或签名')
        candidates.append({'version': version, 'build': build, 'minimum_system': minimum,
                           'arch': arch, 'url': url, 'length': length, 'signature': signature})
    if not candidates:
        cu_error('unsupported', '官方列表没有适合此 Mac 的完整安装包')
    return max(candidates, key=lambda x: int(x['build']))


def cu_parse_squirrel(data, arch):
    """Claude 的更新源（Squirrel 的 json 格式）：currentRelease 那一版的完整 zip，增量包不用"""
    if len(data) > 2 * 1024 * 1024:
        cu_error('blocked', '官方版本列表格式不安全')
    try:
        doc = json.loads(data)
    except (ValueError, UnicodeError):
        cu_error('error', '无法读取官方版本列表')
    version = doc.get('currentRelease') if isinstance(doc, dict) else None
    releases = doc.get('releases') if isinstance(doc, dict) else None
    if not isinstance(version, str) or not re.fullmatch(r'\d+(?:\.\d+){1,5}', version) or not isinstance(releases, list):
        cu_error('blocked', '官方版本列表格式无法识别')
    rows = [r.get('updateTo') for r in releases if isinstance(r, dict) and r.get('version') == version]
    if len(rows) != 1 or not isinstance(rows[0], dict) or rows[0].get('version') != version:
        cu_error('blocked', '官方版本列表格式无法识别')
    url, digest, size = rows[0].get('url', ''), rows[0].get('sha256'), rows[0].get('size')
    cu_url(url, True)
    if '/releases/darwin/%s/%s/' % (arch, version) not in url:
        cu_error('blocked', '官方包地址和版本元数据不一致')
    if (not isinstance(digest, str) or not re.fullmatch(r'[0-9a-f]{64}', digest)
            or type(size) is not int or not 0 < size <= CU_MAX_PACKAGE):
        cu_error('blocked', '官方包缺少有效长度或校验值')
    return {'version': version, 'build': version, 'minimum_system': '', 'arch': arch, 'url': url,
            'length': size, 'sha256': digest}


def cu_metadata(target, folder):
    """官方最新版本的元数据；None 表示更新源说没有新版本"""
    arch, system = cu_host()
    feed = os.path.join(folder, 'feed')
    if CU is CU_CODEX:
        cu_download(CU_FEED, feed, folder)
        with open(feed, 'rb') as f:
            return cu_parse_feed(f.read(), arch, system)
    # device_id 是必填的：每次现生成一个，不用也不存任何账号实例的标识（Claude 的 ant-did 在各账号的资料目录里）
    import uuid
    for a in (arch, 'universal'):
        query = 'device_id=%s&version=%s&os_version=%s' % (uuid.uuid4(), target['version'], system)
        code = cu_download('https://api.anthropic.com/api/desktop/darwin/%s/squirrel/update?%s' % (a, query),
                           feed, folder, empty=('204', '404'))
        if code == '204':
            return None
        if code is None:
            with open(feed, 'rb') as f:
                return cu_parse_squirrel(f.read(), a)
    cu_error('unsupported', '官方列表没有适合此 Mac 的完整安装包')


def cu_verifier():
    verifier = os.environ.get('CCA_CLIENT_VERIFIER', '')
    if not verifier or not os.path.isabs(verifier) or not os.path.isfile(verifier):
        cu_error('blocked', '需要已验证的 cca 图形界面来校验官方安装包签名')
    return verifier


def cu_verify_archive(path, metadata, folder):
    """ChatGPT 的包验 Ed25519（固定公钥在 cca.app 里）；Claude 的更新源带 SHA-256，解压后还要过代码签名和 Gatekeeper"""
    if metadata.get('sha256'):
        if os.path.getsize(path) != metadata['length']:
            cu_error('blocked', '暂存安装包大小已变化，请重新检查')
        digest = cu_hash(path)
        if digest != metadata['sha256']:
            cu_error('blocked', '官方安装包校验值不一致，未解压或安装')
        return digest
    verifier = cu_verifier()
    if os.path.getsize(path) != metadata['length']:
        cu_error('blocked', '暂存安装包大小已变化，请重新检查')
    identity, digest = cu_file_id(path), cu_hash(path)
    result = cu_run([verifier, '--verify-client-update', path, metadata['signature']], folder, 120)
    if result.returncode:
        cu_error('blocked', '官方安装包签名校验失败，未解压或安装')
    if cu_file_id(path) != identity or cu_hash(path) != digest:
        cu_error('needs_recheck', '安装包在验签期间发生变化，请重新检查')
    return digest


def cu_token(stage):
    import secrets
    payload = {'nonce': secrets.token_hex(32), 'package_sha256': stage['package_sha256'],
               'target': stage['target'], 'metadata': stage['metadata']}
    return hashlib.sha256(json.dumps(payload, sort_keys=True, separators=(',', ':')).encode()).hexdigest()


def cu_bundle(path, folder, metadata=None):
    """签名、产品、版本和架构核验，不声称验证了未来版本的全部隔离行为。"""
    import plistlib
    snapshot = cu_snapshot(path)
    for command in (['/usr/bin/codesign', '--verify', '--deep', '--strict', path],
                    ['/usr/sbin/spctl', '--assess', '--type', 'execute', path]):
        if cu_run(command, folder, 120).returncode:
            cu_error('blocked', '客户端代码签名或系统安全评估未通过')
    identity = cu_run(['/usr/bin/codesign', '--display', '--verbose=4', path], folder)
    text = (identity.stdout + identity.stderr).decode('utf-8', 'replace')
    if (identity.returncode or not re.search(r'^TeamIdentifier=' + CU.team + r'$', text, re.M)
            or not re.search(r'^Identifier=' + re.escape(CU.bundle) + r'$', text, re.M)):
        cu_error('blocked', '客户端签名团队或产品标识与官方程序不符')
    with open(os.path.join(path, 'Contents', 'Info.plist'), 'rb') as f:
        info = plistlib.load(f)
    arch, system = cu_host()
    binary = os.path.join(path, 'Contents', 'MacOS', info['CFBundleExecutable'])
    result = cu_run(['/usr/bin/lipo', '-archs', binary], folder)
    arches = result.stdout.decode('ascii', 'replace').split()
    native = 'x86_64' if arch == 'x64' else arch
    if result.returncode or native not in arches or cu_version(info.get('LSMinimumSystemVersion', '')) > cu_version(system):
        cu_error('unsupported', '客户端不支持当前 macOS 版本或处理器')
    if metadata and (snapshot['version'] != metadata['version'] or snapshot['build'] != metadata['build']
                     or metadata['arch'] not in (arch, 'universal')
                     or metadata['minimum_system'] and cu_version(info.get('LSMinimumSystemVersion', ''))
                     != cu_version(metadata['minimum_system'])):
        cu_error('blocked', '安装包内的产品版本或系统要求与官方列表不符')
    if cu_snapshot(path) != snapshot:
        cu_error('needs_recheck', '客户端在签名检查期间发生变化，请重新检查')
    return snapshot


def cu_content(snapshot):
    return {key: snapshot[key] for key in ('version', 'build', 'hashes')}


def cu_extract(archive, folder):
    """只接受实证的单根 ZIP（根目录是这个客户端的 .app）；先验证整张目录表，再写普通文件，最后建内部链接。"""
    import posixpath, shutil, stat, unicodedata, zipfile
    try:
        with zipfile.ZipFile(archive) as z:
            entries = z.infolist()
            if not entries or len(entries) > 100000 or sum(x.file_size for x in entries) > 8 * 1024 ** 3:
                cu_error('blocked', '官方安装包条目数量或解压大小超出限制')
            seen, paths, links = set(), [], {}
            for item in entries:
                name = item.filename.rstrip('/')
                parts = name.split('/')
                mode = item.external_attr >> 16
                kind = stat.S_IFMT(mode)
                normalized = unicodedata.normalize('NFD', name).casefold()
                if (not name or parts[0] != CU.app or any(x in ('', '.', '..') for x in parts)
                        or re.search(r'[\x00-\x1f\x7f\\:]', name) or normalized in seen
                        or item.flag_bits & 1 or kind not in (0, stat.S_IFREG, stat.S_IFDIR, stat.S_IFLNK)
                        or item.file_size > CU_MAX_PACKAGE):
                    cu_error('blocked', '官方安装包包含不支持的路径或重复条目')
                seen.add(normalized)
                paths.append((item, name, mode))
                if kind == stat.S_IFLNK:
                    if item.file_size > 4096:
                        cu_error('blocked', '安装包链接长度不安全')
                    target = z.read(item).decode('utf-8')
                    resolved = posixpath.normpath(posixpath.join(posixpath.dirname(name), target))
                    if (not target or target.startswith('/') or re.search(r'[\x00-\x1f\x7f\\:]', target)
                            or not resolved.startswith(CU.app + '/')):
                        cu_error('blocked', '安装包包含指向程序外的链接')
                    links[normalized] = target
            for item, name, mode in paths:
                parts = name.split('/')
                if any(unicodedata.normalize('NFD', '/'.join(parts[:n])).casefold() in links
                       for n in range(1, len(parts))):
                    cu_error('blocked', '安装包不能通过链接写入其他目录')
            for item, name, mode in paths:
                target = os.path.join(folder, *name.split('/'))
                if stat.S_ISLNK(mode):
                    continue
                if item.is_dir() or stat.S_ISDIR(mode):
                    os.makedirs(target, mode=0o755, exist_ok=True)
                else:
                    os.makedirs(os.path.dirname(target), mode=0o755, exist_ok=True)
                    with z.open(item) as source, open(target, 'xb') as destination:
                        shutil.copyfileobj(source, destination, 1024 * 1024)
                    os.chmod(target, 0o755 if mode & 0o111 else 0o644)
            for item, name, mode in paths:
                if stat.S_ISLNK(mode):
                    target = os.path.join(folder, *name.split('/'))
                    os.makedirs(os.path.dirname(target), mode=0o755, exist_ok=True)
                    os.symlink(links[unicodedata.normalize('NFD', name).casefold()], target)
            app = os.path.join(folder, CU.app)
            from pathlib import Path
            for _, name, mode in paths:
                if stat.S_ISLNK(mode):
                    resolved = str(Path(os.path.join(folder, name)).resolve(strict=True))
                    if not resolved.startswith(app + os.sep):
                        cu_error('blocked', '安装包链接未留在程序目录内')
            return app
    except (zipfile.BadZipFile, UnicodeError, OSError, RuntimeError, ValueError):
        cu_error('blocked', '无法安全解压官方安装包')


def cu_prepare_package(archive, folder, metadata):
    app = cu_extract(archive, folder)
    return cu_content(cu_bundle(app, folder, metadata))


def cu_validate_plan(state, token):
    import hmac
    stage = state.get('stage')
    if (not re.fullmatch(r'[0-9a-f]{64}', token or '') or not isinstance(stage, dict)
            or not hmac.compare_digest(token, stage.get('token', ''))):
        cu_error('needs_recheck', '安装确认已失效，请重新检查更新')
    if CU.cli:
        return cu_cli_validate(stage)
    target = cu_snapshot(cu_target())
    if target != stage.get('target'):
        cu_error('needs_recheck', '客户端已被其他更新器修改，请重新检查')
    if cu_build(stage['metadata']['build']) <= cu_build(target['build']):
        cu_error('needs_recheck', '不会覆盖相同或更新的客户端版本')
    archive = os.path.join(cu_root(), 'package.zip')
    cu_private(archive)
    if cu_hash(archive) != stage.get('package_sha256'):
        cu_error('needs_recheck', '暂存安装包已变化，请重新检查')
    return stage


def cu_light(snapshot):
    return {k: v for k, v in snapshot.items() if k != 'hashes'}


def cu_view(state=None, problem=None):
    state = state if isinstance(state, dict) else {}
    if CU.cli:
        return cu_cli_view(state, problem)
    row = {'id': CU.id, 'label': CU.label, 'kind': 'desktop', 'path': cu_target() or None,
           'installed_version': None, 'available_version': None, 'staged_version': None,
           'package_version': None, 'package_build': None, 'install_token': None, 'can_install': False,
           'status': state.get('status', 'unchecked'), 'message': state.get('message', '尚未检查官方更新'),
           'checked_epoch': state.get('checked_epoch')}
    try:
        snapshot = cu_snapshot(cu_target(), False)
        row['installed_version'] = snapshot['version']
        metadata = state.get('metadata')
        if isinstance(metadata, dict):
            row['available_version'] = metadata.get('version')
        stage = state.get('stage')
        if isinstance(stage, dict):
            row.update(staged_version=stage['metadata']['version'], package_version=stage['metadata']['version'],
                       package_build=stage['metadata']['build'])
            archive = os.path.join(cu_root(), 'package.zip')
            cu_private(archive)
            if (cu_light(snapshot) != cu_light(stage.get('target', {}))
                    or cu_file_id(archive) != stage.get('archive_identity')):
                row.update(status='needs_recheck', message='客户端版本或程序内容已变化，请重新检查更新')
            elif (state.get('status') in ('staged', 'running')
                  and cu_build(stage['metadata']['build']) > cu_build(snapshot['build'])):
                row.update(install_token=stage['token'], can_install=True)
    except (ClientUpdateError, OSError, ValueError, TypeError, KeyError) as e:
        row.update(status=getattr(e, 'status', 'blocked'), message=getattr(e, 'message', '无法安全读取客户端状态'))
    if os.path.lexists(os.path.join(CCA_HOME, 'client-updates', CU.id, 'transaction.json')):
        row.update(status='needs_recheck', message='上次安装尚未完成，请运行检查以安全恢复',
                   install_token=None, can_install=False)
    if problem:
        row.update(status=problem.status, message=problem.message, install_token=None, can_install=False)
    return row


def cu_next_check(rows):
    """下次该后台检查的时间：App 睡到这时候再来问，不用隔一会儿起一个进程。关了自动检查、一个客户端都没装时是 None"""
    times = [r.get('checked_epoch') or 0 for r in rows if r.get('status') != 'missing']
    return min(times) + CU_CHECK_INTERVAL if times and cu_mode() != 'off' else None


def cu_doc(problems=None):
    """所有客户端的状态文档；problems 是 {客户端 id: 这次操作遇到的问题}"""
    global CU
    rows, current = [], CU
    for client in CU_CLIENTS:
        CU = client
        problem = (problems or {}).get(client.id)
        try:
            state = cu_read_state()
        except ClientUpdateError as e:
            state, problem = {}, problem or e
        rows.append(cu_view(state, problem))
    CU = current
    return {'version': 1, 'kind': 'client_updates', 'generated_epoch': time.time(),
            'mode': cu_mode(), 'next_check_epoch': cu_next_check(rows), 'clients': rows}


def cu_check(state, force=False):
    import tempfile
    root = cu_root(True)
    if not force and (cu_mode() == 'off' or time.time() - state.get('checked_epoch', 0) < CU_CHECK_INTERVAL):
        return state
    if CU.cli:
        return cu_cli_check(state, root)
    target = cu_snapshot(cu_target())
    state['checked_epoch'] = time.time()
    try:
        cu_save_state(state)   # 先记下检查时间：中途被杀掉时，下一轮不会马上从头再下载一遍
        with tempfile.TemporaryDirectory(prefix='check-', dir=root) as folder:
            if cu_bundle(target['path'], folder) != target:
                cu_error('needs_recheck', '客户端正在被其他更新器修改，请重新检查')
            metadata = cu_metadata(target, folder)
            if metadata is None:
                state.pop('stage', None)
                state.pop('metadata', None)
                state.update(status='current', message='当前客户端已是最新版本')
                return state
            state['metadata'] = metadata
            if cu_build(metadata['build']) <= cu_build(target['build']):
                state.pop('stage', None)
                state.update(status='current', message='当前客户端已是相同或更新版本')
                return state
            stage = state.get('stage')
            if CU is CU_CODEX:
                cu_verifier()
            if isinstance(stage, dict) and stage.get('metadata') == metadata:
                archive = os.path.join(root, 'package.zip')
                cu_private(archive)
                if cu_hash(archive) == stage.get('package_sha256'):
                    cu_verify_archive(archive, metadata, folder)
                    if target != stage.get('target'):
                        stage['target'] = target
                        stage['token'] = cu_token(stage)
                    stage['archive_identity'] = cu_file_id(archive)
                    state.update(status='staged', message='官方更新已暂存，等待确认安装')
                    return state
            archive = os.path.join(folder, 'package.zip')
            cu_download(metadata['url'], archive, folder, True, metadata['length'])
            digest = cu_verify_archive(archive, metadata, folder)
            package = cu_prepare_package(archive, folder, metadata)
            if cu_snapshot(cu_target()) != target:
                cu_error('needs_recheck', '下载期间客户端发生变化，请重新检查')
            stage = {'metadata': metadata, 'target': target, 'package_sha256': digest, 'package': package}
            stage['token'] = cu_token(stage)
            destination = os.path.join(root, 'package.zip')
            if os.path.lexists(destination):
                cu_private(destination)
            os.replace(archive, destination)
            stage['archive_identity'] = cu_file_id(destination)
            state.update(stage=stage, status='staged', message='官方更新已暂存，等待确认安装')
    except ClientUpdateError as e:
        state.update(status=e.status, message=e.message)
        state.pop('stage', None)
        raise
    finally:
        cu_save_state(state)
    return state


def cu_no_processes(*paths):
    executables = cu_run(['/bin/ps', '-axww', '-o', 'pid=,comm='], '/private/tmp', 20)
    result = cu_run(['/bin/ps', '-axww', '-o', 'pid=,command='], '/private/tmp', 20)
    if executables.returncode or not executables.stdout.strip() or result.returncode or not result.stdout.strip():
        cu_error('blocked', '无法核验客户端进程，未替换程序')
    commands = {}
    for line in executables.stdout.decode('utf-8', 'replace').splitlines():
        match = re.match(r'^\s*(\d+)\s+(.+)$', line)
        if not match:
            cu_error('blocked', '客户端进程列表无法完整解析，未替换程序')
        commands[match.group(1)] = match.group(2)
    for line in result.stdout.decode('utf-8', 'replace').splitlines():
        match = re.match(r'^\s*(\d+)\s+(.+)$', line)
        if not match:
            cu_error('blocked', '客户端进程列表无法完整解析，未替换程序')
        command = match.group(2)
        target_match = any(re.search(r'(?:^|[\s=\x22\x27])' + re.escape(path) + r'(?:[/\s\x22\x27]|$)', command)
                           for path in paths)
        executable = commands.get(match.group(1), '')
        updater = CU.bundle in executable and re.search(CU.updater, executable)
        if target_match or updater:
            cu_error('running', '请先退出所有 %s 窗口及后台进程，再确认安装' % CU.label)


def cu_rename_exclusive(source, destination):
    """Darwin 的无覆盖原子 rename；检查后突然出现的目标也不能被覆盖。"""
    import ctypes, errno
    libc = ctypes.CDLL(None, use_errno=True)
    function = getattr(libc, 'renameatx_np', None)
    if function is None:
        cu_error('blocked', '系统缺少安全的无覆盖安装接口')
    function.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
    function.restype = ctypes.c_int
    if function(-2, os.fsencode(source), -2, os.fsencode(destination), 4) != 0:
        code = ctypes.get_errno()
        if code in (errno.EEXIST, errno.ENOTEMPTY):
            cu_error('needs_recheck', '安装目标已由其他更新器创建，未覆盖它')
        if code in (errno.EACCES, errno.EPERM, errno.EROFS):
            cu_error('blocked', '没有替换此客户端的权限；未请求管理员权限')
        cu_error('blocked', '无法安全移动客户端程序')


def cu_sync_directory(path):
    fd = os.open(path, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def cu_journal(data):
    path = os.path.join(cu_root(True), 'transaction.json')
    if os.path.lexists(path):
        cu_private(path)
    save_json(path, data, 0o600, follow_symlinks=False)
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)
    cu_sync_directory(os.path.dirname(path))


def cu_moved_matches(current, before):
    # rename 改变根目录的路径/ctime；程序内容、文件身份和目录 inode 必须保持原样。
    return all(current.get(k) == before.get(k) for k in (
        'version', 'build', 'hashes', 'files', 'device', 'inode', 'modified_ns'))


def cu_cleanup_work(work, state):
    import shutil
    try:
        shutil.rmtree(work)
    except OSError:
        state['retained_recovery_path'] = work
        cu_save_state(state)


def cu_recover(state):
    """只在 manager/install 锁内调用；status 仅显示待恢复，不触碰事务现场。"""
    root = cu_root(True)
    journal = os.path.join(root, 'transaction.json')
    if not os.path.lexists(journal):
        return state
    cu_private(journal)
    data = load_quiet(journal)
    if not isinstance(data, dict) or data.get('v') != 1:
        cu_error('blocked', '安装恢复记录无法识别，已保留现场')
    target = data.get('target', {}).get('path', '')
    work = data.get('work', '')
    if (not os.path.isabs(target) or target != os.path.realpath(target)
            or not work or os.path.dirname(work) != os.path.dirname(target)
            or not re.fullmatch(r'\.cca-client-install-[a-z0-9_]+', os.path.basename(work))
            or data.get('backup') != os.path.join(work, 'previous.app')
            or data.get('incoming') != os.path.join(work, CU.app)):
        cu_error('blocked', '安装恢复路径无法核验，已保留现场')
    cu_private(work, True)
    backup, incoming = data['backup'], data['incoming']
    cleanup_work = False
    cu_no_processes(target, backup, incoming)
    if os.path.lexists(target):
        current = cu_snapshot(target)
        if cu_content(current) == data.get('candidate') and os.path.lexists(backup):
            cu_bundle(target, root, data['metadata'])
            # 崩溃可能发生在新程序到位后、状态保存前；不再移动已完成的目标。
            state.pop('stage', None)
            state.update(status='updated', message='官方客户端更新已安装')
            cleanup_work = True
        elif current == data['target'] and not os.path.lexists(backup):
            # 移走旧程序前中断：当前原程序未变化，可以清除仅属于本事务的候选目录。
            state.update(status='needs_recheck', message='上次安装未开始替换，请重新检查更新')
            cleanup_work = True
        else:
            current = cu_bundle(target, root)
            if cu_build(current['build']) < cu_build(data['target']['build']):
                cu_error('needs_recheck', '目标版本异常，已保留安装现场且未覆盖程序')
            state.pop('stage', None)
            state.update(status='needs_recheck', message='已保留原生更新器安装的客户端，请重新检查')
            if os.path.lexists(backup):
                state['retained_recovery_path'] = work  # 竞态现场不自动删除。
            else:
                cleanup_work = True
    elif os.path.lexists(backup):
        original = cu_bundle(backup, root)
        if not cu_moved_matches(original, data['target']) and cu_build(original['build']) < cu_build(data['target']['build']):
            cu_error('needs_recheck', '备份版本异常，已保留现场且未自动恢复')
        cu_no_processes(target, backup, incoming)
        cu_rename_exclusive(backup, target)
        cu_sync_directory(os.path.dirname(target))
        cu_sync_directory(work)
        state.pop('stage', None)
        state.update(status='needs_recheck', message='已恢复可核验的官方客户端，请重新检查更新')
        cleanup_work = True
    else:
        cu_error('blocked', '未找到可核验的客户端或备份，已保留安装恢复记录')
    cu_save_state(state)
    os.unlink(journal)
    cu_sync_directory(root)
    if cleanup_work:
        cu_cleanup_work(work, state)
    return state


def cu_install(state, token):
    import tempfile
    root = cu_root(True)
    if CU.cli:
        return cu_cli_install(state, token, root)
    with ClientUpdateLock(os.path.join(root, 'install.lock')):
        cu_recover(state)
        stage = cu_validate_plan(state, token)
        target = stage['target']['path']
        cu_no_processes(target)
        if not os.access(os.path.dirname(target), os.W_OK):
            cu_error('blocked', '客户端所在目录不可写；请使用原版安装器更新')
        # 同一文件系统内准备候选程序，整个准备阶段尚未移动目标。
        work = tempfile.mkdtemp(prefix='.cca-client-install-', dir=os.path.dirname(target))
        journal_written = False
        try:
            archive = os.path.join(root, 'package.zip')
            if cu_verify_archive(archive, stage['metadata'], work) != stage['package_sha256']:
                cu_error('needs_recheck', '暂存安装包已变化，请重新检查')
            incoming = cu_extract(archive, work)
            candidate = cu_bundle(incoming, work, stage['metadata'])
            if cu_content(candidate) != stage['package']:
                cu_error('needs_recheck', '解压程序与此前确认的安装包不一致')
            if cu_bundle(target, work) != stage['target']:
                cu_error('needs_recheck', '原生更新器已改变客户端，未覆盖它')
            cu_validate_plan(state, token)
            cu_no_processes(target, incoming)
            backup = os.path.join(work, 'previous.app')
            transaction = {'v': 1, 'target': stage['target'], 'candidate': cu_content(candidate),
                           'metadata': stage['metadata'], 'incoming': incoming, 'backup': backup, 'work': work}
            cu_journal(transaction)
            journal_written = True
            # 日志已持久化；再核验目标，移动之后也检查被移走的正是刚才核验的版本。
            if cu_snapshot(target) != stage['target']:
                cu_error('needs_recheck', '客户端在提交前发生变化，未覆盖它')
            cu_no_processes(target, incoming)
            cu_rename_exclusive(target, backup)
            cu_sync_directory(os.path.dirname(target))
            cu_sync_directory(work)
            if not cu_moved_matches(cu_snapshot(backup), stage['target']):
                cu_error('needs_recheck', '原生更新器在替换时改变了客户端，已保留现场')
            cu_no_processes(target, backup, incoming)
            cu_rename_exclusive(incoming, target)
            cu_sync_directory(os.path.dirname(target))
            cu_sync_directory(work)
            if cu_content(cu_snapshot(target)) != transaction['candidate']:
                cu_error('needs_recheck', '客户端在安装后被其他更新器改变，已保留现场')
            state.pop('stage', None)
            state.update(status='updated', message='官方客户端更新已安装')
            cu_save_state(state)
            os.unlink(os.path.join(root, 'transaction.json'))
            cu_sync_directory(root)
            cu_cleanup_work(work, state)  # 提交完成才清理，不累积每版约 2 GB 的程序副本。
            return state
        except Exception:
            if journal_written:
                try:
                    cu_recover(state)
                except (ClientUpdateError, OSError, ValueError, TypeError, KeyError):
                    pass   # 无法证明安全就保留 journal；下次 check 再恢复，不覆盖新目标。
            raise
        finally:
            if not journal_written:
                import shutil
                shutil.rmtree(work)


def cu_cli_run(args, folder, timeout=20):
    """运行 claude / codex：也从空环境开始（不带账号、代理、API key）。HOME 是真的：官方更新命令要往 ~/.local、~/.codex 里装；
    PATH 里要有 ~/.local/bin：codex 的安装脚本发现它不在 PATH 里，会去改用户的 shell 配置文件"""
    env = {'PATH': os.path.join(HOME, '.local', 'bin') + ':' + os.environ.get('PATH', '/usr/bin:/bin:/usr/sbin:/sbin'),
           'HOME': HOME, 'TMPDIR': folder, 'LANG': 'en_US.UTF-8', 'NO_COLOR': '1', 'TERM': 'dumb'}
    env.update(CU.run_env(folder))
    return cu_run(args, folder, timeout, env)


def cu_cli_installed(path, folder):
    """现在装的版本"""
    r = cu_cli_run([path, '--version'], folder)
    m = re.search(r'(?<![\d.])\d+\.\d+\.\d+(?![\d.])', r.stdout.decode('utf-8', 'replace')) if r.returncode == 0 else None
    if not m:
        cu_error('blocked', '读不出 %s 的版本' % CU.command)
    return m.group(0)


def cu_cli_method(path):
    """怎么装的：self（官方安装器，它的 update 命令自己换）、brew、npm，认不出的是 other；brew 时带上 cask 的名字"""
    real = os.path.realpath(path)
    cask = re.search(r'/Caskroom/([^/]+)/', real)
    if cask:
        return 'brew', cask.group(1)
    if '/node_modules/' in real:
        return 'npm', ''
    return ('self' if real.startswith(os.path.join(HOME, CU.own_dir) + os.sep) else 'other'), ''


def cu_cli_latest(data):
    """官方的最新版本：纯文本（Claude Code 的发布通道）或 JSON（npm、Homebrew 的 version，GitHub 的 tag_name）"""
    text = data.decode('utf-8', 'replace').strip()
    if text.startswith('{'):
        try:
            j = json.loads(text)
        except ValueError:
            cu_error('error', '官方版本信息无法识别')
        text = str(j.get('version') or j.get('tag_name') or '') if isinstance(j, dict) else ''
    m = re.fullmatch(r'(?:rust-v|v)?(\d+\.\d+\.\d+)', text)
    if not m:
        cu_error('error', '官方版本信息无法识别')
    return m.group(1)


def cu_cli_check(state, root):
    import secrets, tempfile
    path = cu_target()
    state['checked_epoch'] = time.time()
    try:
        cu_save_state(state)
        with tempfile.TemporaryDirectory(prefix='check-', dir=root) as folder:
            installed = cu_cli_installed(path, folder)
            method, cask = cu_cli_method(path)
            url = 'https://formulae.brew.sh/api/cask/%s.json' % cask if method == 'brew' else CU.npm_url() if method == 'npm' else CU.latest()
            latest_file = os.path.join(folder, 'latest')
            cu_download(url, latest_file, folder)
            with open(latest_file, 'rb') as f:
                latest = cu_cli_latest(f.read())
        state['metadata'] = {'version': latest}
        if cu_version(latest) <= cu_version(installed):
            state.pop('stage', None)
            state.update(status='current', message='已是最新版本')
            return state
        state['stage'] = {'token': secrets.token_hex(32), 'method': method, 'metadata': {'version': latest},
                          'target': {'path': path, 'version': installed}}
        state.update(status='available', message='可以直接更新到 %s' % latest if method == 'self'
                     else '有新版本 %s：在终端里运行 %s' % (latest, CU.advice(method, cask)))
    except ClientUpdateError as e:
        state.update(status=e.status, message=e.message)
        state.pop('stage', None)
        raise
    finally:
        cu_save_state(state)
    return state


def cu_cli_view(state, problem):
    """status 用：现在的版本是现跑的（claude 平时会自己更新，缓存的结论可能已经过时了），别的来自上次检查"""
    import tempfile
    path = cu_target()
    row = {'id': CU.id, 'label': CU.label, 'kind': 'cli', 'path': path or None,
           'installed_version': None, 'available_version': None, 'staged_version': None,
           'package_version': None, 'package_build': None, 'install_token': None, 'can_install': False,
           'status': state.get('status', 'unchecked'), 'message': state.get('message', '尚未检查官方更新'),
           'checked_epoch': state.get('checked_epoch')}
    if not path:
        row.update(status='missing', message='没有找到 %s 命令' % CU.command)
        return row
    try:
        with tempfile.TemporaryDirectory(prefix='cca-cli-') as folder:
            row['installed_version'] = installed = cu_cli_installed(path, folder)
        metadata, stage = state.get('metadata'), state.get('stage')
        latest = metadata.get('version') if isinstance(metadata, dict) else None
        row['available_version'] = latest
        if latest and cu_version(latest) <= cu_version(installed):
            if state.get('status') != 'updated':   # 刚更新过的留着“已更新到 X”那句话
                row.update(status='current', message='已是最新版本')
        elif isinstance(stage, dict) and stage.get('method') == 'self' and stage['target']['path'] == path:
            row.update(install_token=stage['token'], can_install=True)
    except (ClientUpdateError, OSError, ValueError, TypeError, KeyError) as e:
        row.update(status=getattr(e, 'status', 'blocked'), message=getattr(e, 'message', '读不出这个命令的状态'))
    if problem:
        row.update(status=problem.status, message=problem.message, install_token=None, can_install=False)
    return row


def cu_cli_validate(stage):
    """确认和安装之前：还是这个命令、用官方安装器装的、确实比现在的新。返回的 target 带着现在的版本（确认框里写）"""
    import tempfile
    path = cu_target()
    if not path or path != stage['target']['path'] or stage.get('method') != 'self':
        cu_error('needs_recheck', '%s 的安装位置变了，请重新检查' % CU.command)
    with tempfile.TemporaryDirectory(prefix='cca-cli-') as folder:
        installed = cu_cli_installed(path, folder)
    if cu_version(stage['metadata']['version']) <= cu_version(installed):
        cu_error('needs_recheck', '%s 已经是这个版本或者更新的了' % CU.command)
    return dict(stage, target=dict(stage['target'], version=installed))


def cu_cli_install(state, token, root):
    """用户同意之后运行官方的 update 命令。官方安装器把版本装在各自的目录里再换链接：开着的会话继续用旧版本"""
    import tempfile
    with ClientUpdateLock(os.path.join(root, 'install.lock')):
        stage = cu_validate_plan(state, token)
        path, want = stage['target']['path'], stage['metadata']['version']
        with tempfile.TemporaryDirectory(prefix='update-', dir=root) as folder:
            try:
                r = cu_cli_run([path, 'update'], folder, 600)
            except ClientUpdateError:
                cu_error('error', '%s update 运行失败或超时，稍后再试' % CU.command)
            installed = cu_cli_installed(path, folder)
        if cu_version(installed) < cu_version(want):
            lines = (r.stderr or r.stdout).decode('utf-8', 'replace').strip().splitlines()
            cu_error('error', '%s update 没有更新成功%s' % (CU.command, '：' + lines[-1][:200] if lines else ''))
        state.pop('stage', None)
        state['metadata'] = {'version': installed}
        state.update(status='updated', message='已更新到 %s，下次启动时用新版本' % installed)
        cu_save_state(state)
    return state


def cu_token_client(token):
    """安装凭据是哪个客户端的；都对不上时停在第一个，由 cu_validate_plan 说凭据失效"""
    global CU
    import hmac
    if re.fullmatch(r'[0-9a-f]{64}', token or ''):
        for client in CU_CLIENTS:
            CU = client
            try:
                stage = cu_read_state().get('stage')
            except ClientUpdateError:
                continue
            if isinstance(stage, dict) and hmac.compare_digest(token, str(stage.get('token', ''))):
                return
    CU = CU_CLIENTS[0]


def cu_problem(e):
    return e if isinstance(e, ClientUpdateError) else ClientUpdateError('blocked', '无法安全处理客户端更新状态')


def cu_drop_package():
    """没有待安装的更新时不留着安装包（一个几百 MB）；删不掉也不影响这次操作"""
    try:
        path = os.path.join(cu_root(), 'package.zip')
        if os.path.lexists(path):
            cu_private(path)
            os.unlink(path)
    except (ClientUpdateError, OSError):
        pass


def cu_check_all(force, problems):
    """一个一个检查（只在 manager 锁内调用）：一个客户端出问题不影响另一个；没装的不算问题"""
    global CU, CU_BUDGET
    CU_BUDGET = time.time() + CU_CHECK_SECONDS
    for client in sorted(CU_CLIENTS, key=lambda c: not c.cli):   # 终端工具先查：只是一个小请求，不被桌面客户端的大下载占完时间
        CU = client
        if not cu_target() and not os.path.lexists(os.path.join(cu_base(), client.id, 'transaction.json')):
            continue
        try:
            root = cu_root(True)
            state = cu_read_state()
            with ClientUpdateLock(os.path.join(root, 'install.lock')):
                state = cu_recover(state)
            if not cu_check(state, force).get('stage'):
                cu_drop_package()
        except (ClientUpdateError, OSError, ValueError, TypeError, KeyError) as e:
            problems[client.id] = cu_problem(e)


def cmd_client_updates(action='status', arg=''):
    if action not in ('status', 'check', 'mode', 'plan', 'install'):
        die('未知客户端更新操作')
    problems = {}
    try:
        if action == 'mode':
            if arg not in ('auto', 'off'):
                cu_error('blocked', '客户端更新模式只能是 auto 或 off')
            with Lock():
                c = load_json(CFG, {})
                c['client_updates'] = arg
                save_json(CFG, c)
        elif action == 'plan':
            cu_token_client(arg)
            stage = cu_validate_plan(cu_read_state(), arg)
            sh(CU_VERSION=stage['metadata']['version'], CU_INSTALLED=stage['target']['version'],
               CU_TARGET=stage['target']['path'], CU_LABEL=CU.label,
               CU_NOTE='用 %s update 更新（它自己校验和替换）。开着的会话不受影响，下次启动时用新版本。' % CU.command if CU.cli else '')
            return
        elif action in ('check', 'install'):
            if action == 'check' and arg not in ('', 'force'):
                cu_error('blocked', '检查更新的参数无法识别')
            with ClientUpdateLock(os.path.join(cu_base(True), 'manager.lock')):
                if action == 'check':
                    cu_check_all(arg == 'force', problems)
                else:
                    cu_token_client(arg)
                    cu_root(True)
                    cu_install(cu_read_state(), arg)
                    cu_drop_package()
    except (ClientUpdateError, OSError, ValueError, TypeError, KeyError) as e:
        if action == 'plan':
            die(cu_problem(e).message)
        problems[CU.id] = cu_problem(e)
    print(json.dumps(cu_doc(problems), ensure_ascii=False))
    if problems and action != 'status':
        sys.stderr.write('\n'.join(p.message for p in problems.values()) + '\n')
        sys.exit(1)


