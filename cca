def cmd_coffee(min_trust, trace, risk):
    """解析 claude.ai trace 与 ip.net.coffee /api/iprisk 结果。
    退出码：0 正常，1 纯净度偏低，2 受限地区，3 拿不到出口 IP，4 没有评分数据"""
    kv = dict(l.split('=', 1) for l in trace.splitlines() if '=' in l)
    ip, loc = kv.get('ip', ''), kv.get('loc', '').upper()
    if not ip:
        print('拿不到 claude.ai 看到的出口 IP（端口或节点不通）')
        sys.exit(3)
    try:
        d = json.loads(risk) if risk else {}
    except ValueError:
        d = {}
    if not isinstance(d, dict):
        d = {}
    cc = (d.get('countryCode') or loc or '').upper()
    score = d.get('trust_score') if isinstance(d.get('trust_score'), (int, float)) else None
    tags = []
    if d.get('isResidential') is True:
        tags.append('住宅IP')
    elif d.get('is_datacenter') is True:
        tags.append('机房IP')
    for f, name in (('is_vpn', 'VPN'), ('is_proxy', '代理'), ('is_tor', 'Tor'), ('is_abuser', '有滥用记录')):
        if d.get(f) is True:
            tags.append(name)
    if cc in RESTRICTED:
        score = 0
    if score is None:
        level = '纯净度 无数据'
    else:
        label = ('极度纯净' if score >= 95 else '纯净' if score >= 80 else '良好' if score >= 50
                 else '中性' if score >= 25 else '可疑')
        level = '纯净度 %s（%s）' % (score, label)
    print(' · '.join(x for x in [ip, cc or '?', d.get('asOrganization') or d.get('company_name') or '', level] + tags if x))
    if cc in RESTRICTED:
        print('出口在%s：Claude 不可用地区，会被严格风控' % RESTRICTED[cc])
        sys.exit(2)
    if score is None:
        print('ip.net.coffee 没有返回评分（检测服务可能暂时不可用）')
        sys.exit(4)
    if score < int(min_trust):
        print('纯净度低于设定的 %s' % min_trust)
        sys.exit(1)


