                             别处的缓存、设置。先把配置打包备份到主目录（--no-backup 不留）。cca restore 是同一条命令
  配置 ${CFG}：nodes（可选节点）、min_trust（纯净度低于它要确认，默认 50）、
                             claude_add_dir（设成 false：cca 启动的 Claude Code 不再能直接读写账号自己在 ~/.cca/accounts 里的目录，
                             和它链到 ~/.claude 里共享的目录）、
                             leak_check（设成 false：启动前不测 ${leaks}）、
                             cost（设成 false：不统计按 API 标价折算的金额，App 里也不显示）、
                             presence（设成 false：${host}不向 Team 的同步服务器报告、也不查设备统计、不同步）${mac:+、}
EOF
	[ -z "$mac" ] || cat >&2 <<EOF
                             dock_tidy（设成 false：cca 打开的 Chrome、桌面 App、终端退出后，不去掉程序坞「最近使用的 App」里留下的图标）、
                             mail（cca mail setup 写的；auto 设成 false：登录时不再自动打开登录邮件里的链接）
EOF
}

main() {
	# 用 cxa、aga 调用：换成 cca codex …、cca agy …。参数里带着工具，自动更新后用新版本重新执行（exec "$SELF" "$@"）才不会变成 cca …
	case "${0##*/}" in "$CODEX_ALIAS") set -- codex "$@" ;; "$AGY_ALIAS") set -- agy "$@" ;; esac
	# 后台任务不往图形界面的事件文件里写（它们是从带着 CCA_EVENTS 的命令里分出来的，跑完时那个命令早就结束了）
	case "${1:-}" in _update-fetch|_policy-fetch|_team-sync|_gui-fetch|_core|_core-keep|_core-nodes|_presence-agent|_key-sync|_cost-sync|_session-start|_remote-hook|_dock-tidy|_dock-wait|_mail-open) unset CCA_EVENTS CCA_GRANT CCA_RO CCA_PROMPT; PROMPT_GUI="" ;; esac
	[ "${1:-}" = _browser ] || unset CCA_LOGIN_URL_FILE   # 只给服务器上登录时 claude / codex 回调的 cca _browser
	case "${1:-}" in
		install) shift; cmd_install "$@" ;;
		help|-h|--help) usage ;;
		version|--cca-version) echo "$VERSION" ;;
		_browser)   # 登录页的浏览器：Claude Code 经 BROWSER 调；Codex、agy 账号登录时 cca 自己调（带着 CCA_TOOL）
			shift
			case "${CCA_TOOL:-}" in codex|agy) use_tool "$CCA_TOOL" ;; esac
			cmd_browser "$@" ;;
		_mail-open) shift; cmd_mail_open_link "$@" ;;   # 邮箱助手找到的登录链接（经 stdin）：在账号专属的 Chrome 里打开（py 的 mail-watch、mail-open 调用）
		_api-key)   # 第三方 API 账号的 key：Claude Code 的 apiKeyHelper、codex 的 auth.command 回调，只打印 key
			shift
			if [ "${1:-}" = codex ]; then shift; use_tool codex; fi
			py api-key-out "${1:-}" ;;
		_session-start)   # Claude Code 的 SessionStart hook（启动时经 --settings 带上的；--desktop：cca cost hook 加在共享设置里的，Claude App 里的会话）：会话 id 记进账号目录（--desktop 带着 App 登录的账号记进 cost/），折合金额按它认账号。stdout 会进 Claude 的上下文：什么都不说，总是成功
			shift
			py session-start "${1:-}" >/dev/null 2>&1 || : ;;
		_remote-hook)   # cca 自己带的 Claude Code 钩子（远程会话开着时经 --settings 带上的 Stop、PermissionRequest、Notification）：做完了、在等你时推一条通知给接着这个会话的各处（辅助程序的 remote-hook，stdin 是钩子的输入）。Stop 的退出码 2 会拦着 Claude Code 不让停：什么都不说，总是成功
			py remote-hook >/dev/null 2>&1 || : ;;
		_update-fetch) cmd_update_fetch ;;
		_policy-fetch) ;;   # 3.6.0 去掉了维护者的映射：以前的版本在后台起的（起的时候还是旧版、跑到这里已经换成新版）什么都不做
		_team-sync) team_bg_sync ;;   # 后台：各个 Team 同步一次配置，变了马上照它改账号表、同步路由器和内置代理（team_hook 起的）
		_policy-check|_fill-check|_policy-lock|_team-handoff) die "这条命令 3.6.0 起去掉了：维护者的映射（连同 policy.sh）改用 Team" ;;   # 以前 policy.sh 调的
		_gui) shift; cmd_gui_api "$@" ;;   # 图形界面的只读接口（macos/PROTOCOL.md）
		_gui-fetch) cmd_gui_fetch ;;
		_core) shift; cmd_core "$@" ;;   # 界面 App 托管的内置代理（cca _core run，见"内置代理"一节）
		_core-nodes) shift; cmd_core_nodes "$@" ;;   # 后台：从路由器拷节点定义、下载内核给内置代理
		_core-keep) CCA_SELF="$SELF" exec "$HELPER" core-keep ;;   # 后台（Linux）：没有界面 App 时托管内置代理的内核（见 py 的 cmd_core_keep）
		_presence-agent) CCA_SELF="$SELF" exec "$HELPER" presence-agent ;;   # 后台：这台 Mac 的设备统计上报进程（见 py 的 presence 一节）
		_key-sync) shift; CCA_SELF="$SELF" exec "$HELPER" key-sync "$@" ;;   # 后台：记下备查的 API key 经设备统计的服务器加密同步（见 py 的 keyshare 一节）
		_cost-sync) shift; CCA_SELF="$SELF" CCA_VERSION="$VERSION" exec "$HELPER" cost-worker "$@" ;;   # 后台：统计折合金额、和别的设备同步（见 py 的折合金额一节）
		_dock-tidy) shift; cmd_dock_tidy "$@" ;;   # 后台：cca 打开的 App 实例退出后整理程序坞（见 py 的程序坞一节；终端交接的脚本也调，PROTOCOL 6）
		_dock-wait) shift; cmd_dock_wait "$@" ;;   # 后台小 App 里：等 cca 打开的实例退出，再整理程序坞
		gui) shift; cmd_gui "$@" ;;
		clients) shift; cmd_clients "$@" ;;
		cost) shift; cmd_cost "$@" ;;   # 统计折合金额（App 定时运行，PROTOCOL 3.5；不经过自动更新、Team 的同步）
		remote) shift; cmd_remote "$@" ;;   # 远程会话：开关、这台机器上可以接入的会话、接入（和工具无关；不经过自动更新、Team 的同步）
		team) shift; cmd_team "$@" ;;   # Team（和工具无关；不经过自动更新、Team 的同步）
		update) shift; cmd_update "$@" ;;
		restore|uninstall) cmd_restore "$@" ;;   # 同一条命令的两个名字
		*)
			if [ ! -f "$CFG" ]; then
				interactive || die "还没安装：请在终端里运行 $SELF install"
				info "第一次使用，先安装"
				cmd_install
				exit 0
			fi
			update_hook "$@"
			update_after   # 换了版本以后的第一条命令：各个 Team 马上在后台同步一次配置（team_hook），不等间隔
			[ ! -d "$CCA_HOME/policy" ] || policy_leftovers   # 3.6.0 去掉了维护者的映射：升级上来的设备上留下的，第一条命令时清掉
			team_hook
			gui_hook
			[ ! -d "$CCA_HOME/hub" ] && [ ! -e "$CCA_HOME/hub-hosted.json" ] && [ ! -e "$CCA_HOME/hub-removed.json" ] || hub_leftovers
			# 用着 Codex / agy（有它的账号表，或者这次就是 cca codex|agy …）而 cxa / aga 不见了（以前装的 cca 升级上来、被删掉了）：补上
			if [ "${1:-}" = codex ] || [ -f "$CCA_HOME/codex.json" ]; then tool_alias_ensure codex "" quiet; fi
			if [ "${1:-}" = agy ] || [ -f "$CCA_HOME/agy.json" ]; then tool_alias_ensure agy "" quiet; fi
			if [ "${1:-}" = codex ] || [ "${1:-}" = agy ]; then   # cca codex|agy …：后面的子命令都作用于 Codex / agy 的账号
				use_tool "$1"
				shift
				[ -f "$TABLE" ] || [ "${1:-}" = install-cli ] || [ "${1:-}" = settings ] || py init   # 只装命令、查设置不算用起这个工具（不建账号表，Team 给的账号不加进来）
			fi
			dispatch "$@" ;;
	esac
}

dispatch() {   # 各工具共用的子命令（当前工具由 use_tool 选定，默认 Claude）
	case "${1:-}" in
		help|-h|--help) usage ;;
		add) shift; cmd_add "$@" ;;
		key) shift; cmd_key "$@" ;;
		login) shift; cmd_login "$@" ;;
		login-page) shift; cmd_login_page "$@" ;;
		usage) shift; cmd_usage "$@" ;;
		reset) shift; cmd_reset "$@" ;;
		edit) cmd_edit ;;
		rename) shift; cmd_rename "$@" ;;
		reorder) shift; cmd_reorder "$@" ;;
		ls|list) cmd_list ;;
		rm|remove) shift; cmd_rm "$@" ;;
		web) shift; cmd_web "$@" ;;
		billing) shift; cmd_billing "$@" ;;
		limit-resets) shift; cmd_limit_resets "$@" ;;
		mail) shift; cmd_mail "$@" ;;
		app) shift; cmd_app "$@" ;;
		check) shift; cmd_check "$@" ;;
		settings) shift; cmd_settings "$@" ;;
		router) shift; cmd_router "$@" ;;
		local) shift; cmd_local "$@" ;;
		node) shift; cmd_node "$@" ;;
		policy) shift; cmd_policy "$@" ;;
		devices) shift; cmd_devices "$@" ;;
		install-cli) shift; cmd_install_cli "$@" ;;
		_onboard) shift; cmd_onboard "$@" ;;   # 图形界面的配置向导（提问会话，App 首次运行启动；走和 add 一样的派发路径）
		@*) OPT_ACCOUNT="${1#@}"; shift; [ "${1:-}" = "--" ] && shift; launch "$@" ;;
		--) shift; launch "$@" ;;
		*) launch "$@" ;;
	esac
}

main "$@"
exit
