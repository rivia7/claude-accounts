# 方向键菜单：arrow_menu 默认项(从 0 起) 选项...
#   ↑↓（或 k/j）移动，回车确认，数字键直接选，q / Esc 退出；结果放在 MENU_PICK（-1 = 退出）
arrow_menu() {
	local cur="$1" n i key rest drawn=0
	shift
	local -a items=("$@")
	n=${#items[@]}
	MENU_PICK=-1
	printf '\033[?25l' >&2
	trap 'printf "\033[?25h" >&2; exit 130' INT TERM
	while :; do
		[ $drawn = 1 ] && printf '\033[%dA' "$n" >&2
		drawn=1
		for ((i = 0; i < n; i++)); do
			if [ $i -eq "$cur" ]; then printf '\r\033[2K  %s❯ %s%s\n' "$C_G$C_B" "${items[i]}" "$C_0" >&2
			else printf '\r\033[2K    %s\n' "${items[i]}" >&2; fi
		done
		key=""
		IFS= read -rsn1 key <&3 || break
		case "$key" in
			$'\033')
				rest=""
				IFS= read -rsn2 -t 1 rest <&3
				case "$rest" in
					'[A'|'OA') cur=$(( (cur + n - 1) % n )) ;;
					'[B'|'OB') cur=$(( (cur + 1) % n )) ;;
					'') break ;;
				esac ;;
			'') MENU_PICK=$cur; break ;;
			k|K) cur=$(( (cur + n - 1) % n )) ;;
			j|J) cur=$(( (cur + 1) % n )) ;;
			q|Q) break ;;
			[1-9]) if [ "$key" -le "$n" ]; then cur=$((key - 1)); MENU_PICK=$cur; break; fi ;;
		esac
	done
	printf '\033[%dA' "$n" >&2   # 收尾重画：选中项打勾，其余变暗
	for ((i = 0; i < n; i++)); do
		if [ $i -eq "$MENU_PICK" ]; then printf '\r\033[2K  %s✓ %s%s\n' "$C_G" "${items[i]}" "$C_0" >&2
		else printf '\r\033[2K    %s%s%s\n' "$C_D" "${items[i]}" "$C_0" >&2; fi
	done
	printf '\033[?25h' >&2
	trap - INT TERM
}

