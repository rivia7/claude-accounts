            try:
                data = render_icon(icon, *badge)
            except Exception:   # 画不出来就用原图标，启动器照常能用
                data = src
            if put(icns, data):
                os.utime(b)   # 让 Finder、启动台换掉缓存里的旧图标
                subprocess_quiet(LSREGISTER, '-f', b)
    except (OSError, ValueError):
        pass
    put(mark_path, json.dumps(mark, ensure_ascii=False).encode('utf-8'))


def launcher_tool(p):
    """这个 .app 是哪个工具的 cca 启动器（没有 cca 标记的返回 None；旧的标记没写 tool，是 Claude 的）"""
    mark = os.path.join(p, 'Contents', 'Resources', LAUNCHER_MARK)
    if not os.path.isfile(mark):
        return None
    m = load_quiet(mark)
    return (m.get('tool') if isinstance(m, dict) else None) or 'claude'


def cmd_launchers(ldir, cca, app='', mode=''):
    """~/Applications 里每个账号一个"Claude 别名"（Codex 账号是"ChatGPT 别名"）启动器：按账号表新建、改名、删除。
    只动带 cca 标记、并且是当前工具的 .app；没装对应的 App（app 为空）或 mode=remove-all 时只删不建。
    输出：+ 新建、- 删除、! 同名但不是 cca 生成的（跳过）。第三方 API 账号用不了 App，没有启动器"""
    import shutil
    t = {k: v for k, v in table_load().items() if not is_api(v)}
    names = launcher_names(t)
    badges = launcher_badges(load_quiet(CFG) or {}, t, names)
    want = {} if mode == 'remove-all' or not app else {os.path.join(ldir, names[k] + '.app'): k for k in t}
    if os.path.isdir(ldir):
        for n in sorted(os.listdir(ldir)):
            p = os.path.join(ldir, n)
            if n.endswith('.app') and p not in want and launcher_tool(p) == T.name:
                shutil.rmtree(p)
                print('-\t' + n[:-4])
    for p, k in want.items():
        new = not os.path.exists(p)
        if not new and not os.path.isfile(os.path.join(p, 'Contents', 'Resources', LAUNCHER_MARK)):
            print('!\t' + os.path.basename(p)[:-4])
            continue
        os.makedirs(ldir, exist_ok=True)
        write_launcher(p, k, cca, app, names[k], badges[k])
        if new:
            print('+\t' + os.path.basename(p)[:-4])


def cmd_keychain(key):
    import unicodedata
    p = unicodedata.normalize('NFC', cdir(key))
    print('Claude Code-credentials-' + hashlib.sha256(p.encode('utf-8')).hexdigest()[:8])


