<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 通知扩展只进和 App 共用的那个分组：那里只有通知密钥（App 的身份、配对的密钥在 App 自己的分组里，这里读不到） -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.cca.remote.shared</string>
	</array>
</dict>
</plist>
